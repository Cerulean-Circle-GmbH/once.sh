odocker.start()
{
  source this
  # The default needs the kernel (private.this.script.load), so it is resolved
  # here, not at file scope — and only when neither env nor config set it.
  : ${ODOCKER_WORKSPACES:=$(private.odocker.workspaces.default.get)}
  # Started (not sourced — Tab completion and the tests source this file) for
  # a method that runs docker: install what odocker needs first. The usage,
  # help and the workspace methods need no docker (T-ODOCKER-PREREQ-START).
  # OOSH_NO_INSTALL (every test run): install nothing, change no group or
  # config on the machine the tests run on (T-ODOCKER-START-NO-INSTALL).
  if [ "${0##*/}" = "odocker" ] && [ -z "$OOSH_NO_INSTALL" ]; then
    case "${1:-}" in
      ""|usage|help*|completion.discover|workspace|workspace.*) ;;
      *) # Missing is a warning: a method that needs no docker (the picker of
         # `odocker up`) still runs; a docker call fails on its own.
         private.odocker.prereqs.ensure || warn.log "$RESULT"
         # The mounted socket belongs to the host's group: join a group with its
         # GID. A membership this shell does not know yet takes effect for this
         # very call through `sg`, once (ODOCKER_SG guards against a loop).
         private.odocker.socket.access.ensure
         case "$RESULT" in
           sg:*) if [ -z "$ODOCKER_SG" ] && command -v sg >/dev/null 2>&1; then
                   exec env ODOCKER_SG=1 sg "${RESULT#sg:}" -c "$(printf '%q ' "$0" "$@")"
                 elif [ -z "$ODOCKER_SG" ]; then
                   # No sg (Alpine's BusyBox, and no package has one): the
                   # membership counts from the next login (T-ODOCKER-NO-SG-NEXT-LOGIN).
                   important.log "odocker: $(id -un) is now in group ${RESULT#sg:} — that takes effect at the next login (no sg here to use it at once): log out and back in"
                 fi ;;
         esac
         # A container named by its ID because no docker program was there to
         # tell its name (started by plain `docker run`): now there is one.
         if [[ "${OOSH_SSH_CONFIG_HOST:-}" =~ ^[0-9a-f]{12}$ ]]; then
           private.this.script.load config private.config.host.name.refresh \
             && private.config.host.name.refresh >/dev/null
         fi ;;
    esac
  fi
  this.start "$@"
}

odocker.start "$@"
