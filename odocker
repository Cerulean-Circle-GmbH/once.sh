#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

#echo "starting: $0 <LOG_LEVEL=$1>"

# ============================================================================
# odocker - Docker wrapper for oosh
# No flags, positional params only. Following: tmux→otmux, ssh→ossh, docker→odocker
# ============================================================================

# Docker workspaces root. Resolution order:
#   1. already-set env (odocker.env is sourced from user.env on shell startup)
#   2. legacy ODOCKER_WORKSPACES= in user.env (pre-migration installs)
#   3. private.odocker.workspaces.default.get — DockerWorkspaces beside the
#      Once.sh components base (oo mode.base.get), resolved in odocker.start
# Update via: odocker workspace.set <?path>   (no path → falls back to the default)
#          or odocker workspace.init <?path>  (creates it first — `set` refuses a
#                                              directory that is not there)
#          or odocker workspace.seed <from>   (creates it and copies <from> in)
: ${ODOCKER_WORKSPACES:=$(config get ODOCKER_WORKSPACES 2>/dev/null)}

odocker.workspace.init()     # <?path:$(oo mode.base.get)/../DockerWorkspaces> # create the Docker workspaces directory if it is absent, then set it; idempotent #
{
  # The verb that is allowed to CREATE. `workspace.set` deliberately rejects a
  # missing directory (below) so a typo cannot silently persist a path that is
  # not there; this one makes the directory first and then hands over to it —
  # wholesale, so the canonicalisation and the persistence trio have exactly
  # one definition.
  #
  # Shape follows the .init family: config.init.user, claudeCode.init,
  # claudeFlow.init — an optional path, create, delegate, idempotent.
  local path="$1"
  if [ -z "$path" ]; then
    if ! path=$(private.odocker.workspaces.default.get); then
      error.log "odocker.workspace.init: no Once.sh components base (oo mode.base.get) — give the path explicitly"
      create.result 4 "no default path" "$1"
      return $(result)
    fi
    info.log "No path given — using default: $path"
  fi
  [ -n "$1" ] && shift

  if [ -e "$path" ] && [ ! -d "$path" ]; then
    error.log "odocker.workspace.init: $path exists and is not a directory"
    create.result 2 "not a directory: $path" "$1"
    return $(result)
  fi

  # mkdir -p is idempotent, so a second call on an existing root is a no-op —
  # which is what makes this method safe to re-run. Its status IS checked: an
  # unwritable parent has to fail here, loudly, rather than fall through to
  # workspace.set and be reported as "Directory not found".
  if ! mkdir -p "$path" 2>/dev/null; then
    error.log "odocker.workspace.init: cannot create $path — is its parent writable?"
    create.result 1 "cannot create $path" "$1"
    return $(result)
  fi

  # Everything else — this.absolutePath, config save odocker ODOCKER,
  # config add odocker, config unset ODOCKER_WORKSPACES — belongs to
  # workspace.set and stays there.
  odocker.workspace.set "$path"
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result "$rc" "created $path but could not set it" "$1"
    return $(result)
  fi
  create.result 0 "workspace directory set to: $ODOCKER_WORKSPACES" "$1"
  return $(result)
}

odocker.workspace.init.completion.path() { compgen -d "$1"; }


private.odocker.workspaces.default.get()     #  # the Docker workspaces root beside the Once.sh components base: <parent of oo mode.base.get>/DockerWorkspaces, else beside the Once.sh folder that holds ~/oosh; rc 1 when neither is detectable #
{
 # A getter consumed as $(…): no create.result (same exemption as
 # private.oo.method.stubs.get). The Once.sh components base is the one
 # documented root (docs/oo.md, oo mode.base.get); DockerWorkspaces sits beside
 # it. oo is loaded the documented way (docs/ogit.md): script.load, then call.
 # oo mode.base.get fails on a layout without main/ (a fresh clone): then the
 # root is derived from where ~/oosh really is — here, so workspace.init,
 # workspace.seed and the install agree (T-WS-DEFAULT-NO-MAIN).
 local base="" real
 if private.this.script.load oo oo.mode.base.get; then
   base=$(oo.mode.base.get 2>/dev/null) || base=""
 fi
 if [ -z "$base" ]; then
   real=$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null)
   case "$real" in */Once.sh/*) base="${real%/Once.sh/*}/Once.sh" ;; *) return 1 ;; esac
 fi
 echo "${base%/*}/DockerWorkspaces"
}


odocker.workspace.seed()     # <from> <?path:$(oo mode.base.get)/../DockerWorkspaces> # fill a NEW Docker workspaces root from an existing one (<from> must hold Dockerfiles), share it with group dev, then set it; never overwrites a populated root; idempotent #
{
 # The verb that FILLS a new root. workspace.init creates and sets it (reused
 # wholesale); the copy and the group sharing are the kernel's
 # private.this.folder.entries.copy / private.this.folder.share — one
 # definition each, shared with ogit. A root that already lists a workspace is
 # never written to, so a rerun is a no-op; <from> is only ever read.
 local from="$1" path
 if [ -z "$from" ] || [ ! -d "$from" ]; then
   error.log "odocker.workspace.seed: <from> is not a directory: ${from:-<none>}"
   create.result 2 "no such folder: ${from:-<none>}"
   return $(result)
 fi
 shift
 if [ -z "$(ODOCKER_WORKSPACES="$from" private.odocker.workspace.list)" ]; then
   error.log "odocker.workspace.seed: $from holds no Dockerfile workspace — it is not a Docker workspaces root"
   create.result 3 "no Dockerfile workspace in $from"
   return $(result)
 fi
 path="$1"
 if [ -z "$path" ]; then
   if ! path=$(private.odocker.workspaces.default.get); then
     error.log "odocker.workspace.seed: no Once.sh components base (oo mode.base.get) — give <path> explicitly"
     create.result 4 "no default path"
     return $(result)
   fi
 else
   shift
 fi
 odocker.workspace.init "$path" >/dev/null || return $(result)
 path="$ODOCKER_WORKSPACES"
 if [ -n "$(private.odocker.workspace.list)" ]; then
   info.log "$path already holds workspaces — not seeded"
 elif ! private.this.folder.entries.copy "$from" "$path" >/dev/null; then
   error.log "odocker.workspace.seed: $RESULT"
   create.result 1 "could not seed $path: $RESULT"
   return $(result)
 fi
 private.this.folder.share "$path" >/dev/null || warn.log "odocker.workspace.seed: $RESULT"
 success.log "Docker workspaces root: $path (seeded from $from)"
 create.result 0 "seeded $path from $from" "$1"
 return $(result)
}


odocker.workspace.seed.completion.from() { compgen -d "$1"; }
odocker.workspace.seed.completion.path() { compgen -d "$1"; }
private.odocker.prereq.package.get()     # <cmd> <?mode:client> # echo the package that provides <cmd> (docker or column) for the package manager in OOSH_PM — for docker the client, or with mode engine the Docker engine of a bare computer (colima on macOS); the command name itself when none is known #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # oo.cmd has no per-platform package names (a package called `docker` is not
 # Docker on Ubuntu). The one table: a started odocker, odocker prereqs.install
 # and the raw path of odocker install (a container without oosh) ask it.
 # mode engine: a bare computer runs Docker itself — the engine (macOS: colima,
 # the Docker VM, plus the client).
 if [ "$1" = "docker" ] && [ "${2:-client}" = "engine" ]; then
   case "${OOSH_PM%% *}" in
     apt-get|dpkg) echo "docker.io" ;;
     apk)          echo "docker" ;;
     dnf|yum)      echo "docker-ce docker-ce-cli containerd.io" ;;
     brew)         echo "colima docker" ;;
     *)            echo "docker" ;;
   esac
   return 0
 fi
 case "$1:${OOSH_PM%% *}" in
   docker:apt-get|docker:dpkg) echo "docker-ce-cli" ;;
   docker:apk)                 echo "docker-cli" ;;
   docker:dnf|docker:yum)      echo "docker-ce-cli" ;;
   column:apt-get|column:dpkg) echo "bsdextrautils" ;;
   column:apk)                 echo "util-linux-misc" ;;
   column:dnf|column:yum)      echo "util-linux" ;;
   *)                          echo "$1" ;;
 esac
}


private.odocker.prereqs.ensure()     #  # install what odocker needs and the system lacks — docker and column — through oo cmd with the package of this package manager; rc 1 naming what is still missing #
{
 # odocker runs docker and pipes its tables through column. A minimal system
 # — a platform container — has neither: `odocker list` died with
 # `docker: command not found`, `odocker status` printed empty tables
 # (2026-10-05). A present command costs one `command -v`.
 # Two cases: a container whose host's socket is mounted needs only the
 # client; a bare computer (no socket) needs the engine, installed and started
 # on this computer.
 local cmd pkg missing="" mode="client" reason=""
 [ -e "$(private.odocker.socket.get)" ] || mode="engine"
 # A container without the host's socket is no bare computer: no engine can
 # start there. The client, and RESULT says the socket is missing
 # (T-ODOCKER-PREREQ-CONTAINER-NO-SOCKET).
 if [ "$mode" = "engine" ] && private.this.container.is; then
   mode="client"; missing=" docker-socket"
   private.odocker.engine.supported || reason="$RESULT"
 fi
 for cmd in docker column; do
   command -v "$cmd" >/dev/null 2>&1 && continue
   # No engine can run here (a Mac VM): installing one only leaves it behind.
   if [ "$cmd" = "docker" ] && [ "$mode" = "engine" ] && ! private.odocker.engine.supported; then
     missing="$missing docker"; reason="$RESULT"; continue
   fi
   if ! private.this.script.load oo oo.cmd; then missing="$missing $cmd"; continue; fi
   # The package name depends on the package manager, so it is known first.
   [ -n "$OOSH_PM" ] || oo.pm.discover >/dev/null 2>&1
   pkg=$(private.odocker.prereq.package.get "$cmd" "$mode")
   # docker-ce-cli / docker-ce come from Docker's own repository (apt, dnf/yum).
   case "$pkg" in
     docker-ce*) private.odocker.docker.repo.add >/dev/null || warn.log "$RESULT" ;;
   esac
   console.log "odocker needs $cmd — installing $pkg"
   oo.cmd "$cmd" "$pkg" >/dev/null || missing="$missing $cmd"
 done
 # A bare computer: installed is not running. It starts on docker alone — a
 # column whose install failed (BusyBox has none; util-linux-misc brings it on
 # Alpine) only spoils the tables (2026-10-06).
 if [ "$mode" = "engine" ] && command -v docker >/dev/null 2>&1 \
    && ! docker info >/dev/null 2>&1 && private.odocker.engine.supported; then
   console.log "odocker: starting the Docker engine of this computer"
   private.odocker.engine.start || missing="$missing docker-engine"
 fi
 # No log here: odocker.start reports it — as a warning, the method still runs.
 if [ -n "$reason" ]; then
   create.result 1 "odocker needs:$missing — $reason"
   return $(result)
 fi
 if [ -n "$missing" ]; then
   create.result 1 "odocker needs:$missing — the install failed; try: oo cmd <command> <package>"
   return $(result)
 fi
 create.result 0 "docker and column present"
 return $(result)
}


private.odocker.socket.access.ensure()     # <?socket:/var/run/docker.sock> # make the mounted docker socket usable for this user: a group with its GID, created when missing, with this user in it; rc 0, and RESULT sg:<group> when the membership is new to this shell; rc 1 when it cannot #
{
 # In a platform container the host's socket is mounted with the HOST's group
 # number: bash-user got `permission denied` right after the automatic docker
 # install (2026-10-05). The socket itself is never changed — odocker.install:
 # never chgrp the host's socket. A group with its GID is created when there is
 # none (as odocker.install does from the host), and the user joins it.
 local socket="${1:-$(private.odocker.socket.get)}" group user
 if [ ! -e "$socket" ] || docker info >/dev/null 2>&1 || [ "$(id -u)" = "0" ]; then
   create.result 0 "the docker socket needs nothing"
   return $(result)
 fi
 private.odocker.socket.group.ensure "$socket" || return $(result)
 group="$RESULT"
 # This process has the group already: docker fails for another reason, and
 # neither sg nor a new login changes that (T-ODOCKER-SOCKET-ACCESS).
 case " $(id -nG 2>/dev/null) " in
   *" $group "*)
     create.result 0 "already in group $group, which owns the docker socket — docker fails for another reason"
     return $(result) ;;
 esac
 # No $USER: under `docker exec` there may be none.
 user=$(id -un 2>/dev/null)
 private.this.script.load user private.user.group.member.pending
 if ! private.user.group.member.pending "$group" "$user"; then
   console.log "odocker: adding $user to group $group, which owns the docker socket"
   user.group.add "$group" "$user" >/dev/null 2>&1
 fi
 # A membership this process does not have yet: RESULT asks the caller for an
 # `sg` re-run — with rc 0, because oosh's error trap reports every non-zero
 # rc ("EXIT 2 Misuse of shell builtins" on every call, 2026-10-05).
 if private.user.group.member.pending "$group" "$user"; then
   create.result 0 "sg:$group"
 else
   create.result 1 "could not add $user to group $group"; error.log "$RESULT"
 fi
 return $(result)
}


private.odocker.workspaces.install()     # <?path> # give this host its Docker workspaces root and the shared odocker.env that names it: keep an existing value, else create <path> (default beside the Once.sh base), share it with group dev and set it; idempotent #
{
 # Every install writes odocker.env (2026-10-05): only `odocker workspace.set`
 # did, so a fresh install had no odocker.env and no chain in user.env while
 # the host had both. workspace.init creates and sets (the default, also
 # without a main/ folder, is private.odocker.workspaces.default.get's); its
 # own failure is the answer (T-ODOCKER-WORKSPACES-INSTALL).
 local path="$1"
 if [ -z "$path" ] && grep -q '^export ODOCKER_WORKSPACES=' "$CONFIG_PATH/odocker.env" 2>/dev/null; then
   grep -q 'odocker\.env' "$CONFIG_PATH/user.env" 2>/dev/null || config add odocker
   create.result 0 "kept: $CONFIG_PATH/odocker.env"
   return $(result)
 fi
 odocker.workspace.init "$path" >/dev/null || return $(result)
 private.this.folder.share "$ODOCKER_WORKSPACES" >/dev/null || warn.log "$RESULT"
 create.result 0 "$ODOCKER_WORKSPACES"
 return $(result)
}


private.odocker.socket.get()     #  # echo the docker socket of this host: $ODOCKER_SOCKET, else /var/run/docker.sock — mounted from the host in a container, the engine's own on a computer that runs Docker #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. One name
 # for the socket, so the tests can point odocker at a fixture — a started
 # odocker through ODOCKER_SOCKET (T-ODOCKER-SOCKET-ENV).
 echo "${ODOCKER_SOCKET:-/var/run/docker.sock}"
}


private.odocker.engine.start()     #  # start the Docker engine of this computer the way it starts services: colima on macOS, else systemd, OpenRC or a SysV service; rc 1 when it does not come up #
{
 # A bare computer gets the engine installed (2026-10-05) — installed is not
 # running. Linux: systemd, else OpenRC (Alpine), else SysV `service`, the
 # fallback style of ossh's fail2ban/ssh restarts. macOS: colima, the Docker
 # VM (its socket lives under ~/.colima, owned by the user).
 # A SysV / OpenRC start returns before dockerd has made its socket: up to
 # five seconds for it, one loop (T-ODOCKER-ENGINE-START-WAIT).
 local os="${OOSH_OS:-$(uname -s)}" socket waited=0
 case "$os" in
   darwin*|Darwin)
     colima start >/dev/null 2>&1
     colima status >/dev/null 2>&1 ;;
   *)
     $SUDO systemctl enable --now docker >/dev/null 2>&1 \
       || { $SUDO rc-update add docker default >/dev/null 2>&1; $SUDO rc-service docker start >/dev/null 2>&1; } \
       || $SUDO service docker start >/dev/null 2>&1
     socket=$(private.odocker.socket.get)
     while [ ! -e "$socket" ] && [ "$waited" -lt 5 ]; do
       sleep 1; waited=$((waited + 1))
     done
     [ -e "$socket" ] ;;
 esac
 if [ "$?" = 0 ]; then
   create.result 0 "the Docker engine of this computer runs"
 else
   create.result 1 "the Docker engine of this computer did not start"; error.log "$RESULT"
 fi
 return $(result)
}


private.odocker.container.name.new()     # <image> # echo Docker's own random name for a new container of <image>, known before it starts: an empty `docker create` names it, the entry is removed again; nothing when create fails #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # A container odocker starts without a name gets this one, as its name AND
 # host name: Docker's random name (xenodochial_brown) was unknown inside the
 # container until a docker program was there, so the install named the
 # computer by its ID (platform test, 2026-10-05). Docker picks names only on
 # create, the host name is fixed then too — so a created, never started entry
 # lends its name and goes.
 local cid name
 cid=$(docker create "$1" 2>/dev/null) || return 1
 [ -n "$cid" ] || return 1
 name=$(docker container inspect -f '{{.Name}}' "$cid" 2>/dev/null)
 docker rm "$cid" >/dev/null 2>&1
 name="${name#/}"
 [ -n "$name" ] || return 1
 echo "$name"
}


private.odocker.engine.supported()     #  # rc 0 when this computer can run the Docker engine: Linux outside a container, a Mac only with virtualization (kern.hv_support 1); rc 1 naming why not #
{
 # colima runs the engine in a VM. A Mac that is itself a VM (a tart VM:
 # "Apple M1 Max (Virtual)", no kern.hv_support) cannot run one — odocker
 # installed colima, docker and lima there and could not start them
 # (2026-10-06).
 # A container has no init system to start one: it uses its host's Docker,
 # through the socket it is started with (T-ODOCKER-ENGINE-SUPPORTED).
 if private.this.container.is; then
   create.result 1 "no docker socket is mounted in this container, and no Docker engine can run in it — start the container with the docker option (as odocker reset <image> <port> docker does)"
   return $(result)
 fi
 case "${OOSH_OS:-$(uname -s)}" in
   darwin*|Darwin)
     if [ "$(sysctl -n kern.hv_support 2>/dev/null)" != "1" ]; then
       create.result 1 "this Mac cannot run a VM (no virtualization — is it a VM itself?), so no Docker engine can run here"
       return $(result)
     fi ;;
 esac
 create.result 0 "the Docker engine can run here"
 return $(result)
}


private.odocker.socket.group.ensure()     # <?socket:$(private.odocker.socket.get)> # find the group that owns the docker socket's number, or create one for it — docker, or dockerhost when docker has another number; RESULT is its name, rc 1 when it cannot #
{
 # The socket of a platform container keeps the HOST's group number. One
 # helper for the socket access of a started odocker and for the install,
 # which adds every user to this group (Alpine has no sg to apply a new
 # membership at once, 2026-10-06). The socket itself is never changed.
 # Only kernel methods: a started odocker has sourced nothing but this — the
 # os.check.env and $OS_CMD_GROUP_ADD it used ran `sudo -g <gid> docker`
 # (T-ODOCKER-SOCKET-GROUP-ENSURE).
 local socket="${1:-$(private.odocker.socket.get)}" gid group
 gid=$(stat -c %g "$socket" 2>/dev/null || stat -f %g "$socket" 2>/dev/null)
 if [ -z "$gid" ]; then
   create.result 1 "cannot read the group of $socket"; error.log "$RESULT"; return $(result)
 fi
 group=$(private.this.group.name.get "$gid")
 if [ -z "$group" ]; then
   group="docker"
   private.this.group.exists docker && group="dockerhost"
   console.log "odocker: the docker socket belongs to group number $gid — creating group $group for it"
   if ! private.this.group.create "$group" "$gid" || [ "$(private.this.group.name.get "$gid")" != "$group" ]; then
     create.result 1 "could not create group $group ($gid) for $socket"; error.log "$RESULT"; return $(result)
   fi
 fi
 create.result 0 "$group"
 return $(result)
}


private.odocker.docker.repo.add()     # <?root:/> # add the own package repository of Docker for this package manager — apt (Debian, Ubuntu) and dnf/yum — where docker-ce-cli and docker-ce come from; nothing when it is there; <root> lets a test use a fixture; rc 1 naming what is missing #
{
 # Debian 12's docker.io is Docker 20.10 (API 1.41); a host's Docker 29
 # accepts 1.44 and up — "client version 1.41 is too old" (2026-10-06).
 # Docker's repository has the current docker-ce-cli, on apt as on dnf/yum.
 # Once there it is left alone, and a download that fails or is empty leaves
 # nothing behind: an empty key broke every later apt-get update — curl's rc
 # was lost in a pipe (T-ODOCKER-DOCKER-REPO-APT).
 # The data is private.odocker.docker.repo.get's, the download
 # private.odocker.docker.repo.download's — shared with the add into a
 # container without oosh (private.odocker.container.repo.add).
 local root="${1:-/}" pm="${OOSH_PM%% *}" marker file url line arch tmp rc
 root="${root%/}"
 if ! marker=$(private.odocker.docker.repo.get marker "$pm"); then
   create.result 1 "Docker has no package repository for ${pm:-this package manager} — its own docker package is used"
   return $(result)
 fi
 if [ -e "$root$marker" ]; then
   create.result 0 "Docker's repository is there: $root$marker"
   return $(result)
 fi
 private.this.script.load oo oo.cmd
 oo.cmd curl >/dev/null 2>&1
 # <root>'s own os-release; the architecture of this computer (apt only).
 arch=$(dpkg --print-architecture 2>/dev/null)
 if ! url=$(private.odocker.docker.repo.get url "$pm" "$root/etc/os-release" "$arch"); then
   create.result 1 "Docker's apt repository needs ID and VERSION_CODENAME of $root/etc/os-release and the architecture (arch: ${arch:-?})"
   return $(result)
 fi
 file=$(private.odocker.docker.repo.get file "$pm" "$root/etc/os-release" "$arch")
 line=$(private.odocker.docker.repo.get line "$pm" "$root/etc/os-release" "$arch")
 [ -n "$line" ] && oo.cmd update-ca-certificates ca-certificates >/dev/null 2>&1
 private.odocker.docker.repo.download "$url" || return $(result)
 tmp="$RESULT"
 # The download goes to <file>; apt: then the list (the marker) names it, and
 # apt reads its sources again.
 $SUDO install -m 0755 -d "$root${file%/*}" "$root${marker%/*}" \
   && $SUDO install -m 0644 "$tmp" "$root$file" \
   && { [ -z "$line" ] || { printf '%s\n' "$line" > "$tmp" \
          && $SUDO install -m 0644 "$tmp" "$root$marker" \
          && $SUDO apt-get update >/dev/null 2>&1; }; }
 rc=$?
 rm -f "$tmp"
 if [ "$rc" != 0 ]; then
   $SUDO rm -f "$root$marker" "$root$file"
   create.result 1 "could not add Docker's repository at $root$marker"; return $(result)
 fi
 create.result 0 "Docker's repository added for $pm: $root$marker"
 return $(result)
}


odocker.prereqs.install()     # <?user> # install what odocker needs here and join the group of the docker socket: <user>, else every user (uid 1000 and up) when run as root, else this user; nothing under OOSH_NO_INSTALL; idempotent #
{
 # The one install of a container: odocker install runs this in a container
 # with oosh (through the prelude), a user can type it there too. The same
 # methods a started odocker uses — no second package table, no second group
 # rule (T-ODOCKER-PREREQS-INSTALL, T-ODOCKER-INSTALL-OOSH).
 local user="$1" group users u missing="" rc=0
 [ -n "$1" ] && shift
 if [ -n "$OOSH_NO_INSTALL" ]; then
   create.result 0 "OOSH_NO_INSTALL is set: nothing installed, no group changed"
   return $(result)
 fi
 private.odocker.prereqs.ensure || { rc=1; missing="$RESULT"; warn.log "$RESULT"; }
 if [ ! -e "$(private.odocker.socket.get)" ]; then
   create.result "$rc" "${missing:-odocker prerequisites here}; no docker socket, so no group to join"
   return $(result)
 fi
 private.odocker.socket.group.ensure || return $(result)
 group="$RESULT"
 if [ -n "$user" ]; then
   users="$user"
 elif [ "$(id -u)" = "0" ]; then
   users=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' /etc/passwd 2>/dev/null)
 else
   users=$(id -un 2>/dev/null)
 fi
 private.this.script.load user user.group.add
 for u in $users; do
   case " $(id -nG "$u" 2>/dev/null) " in *" $group "*) continue ;; esac
   console.log "odocker: adding $u to group $group, which owns the docker socket"
   user.group.add "$group" "$u" >/dev/null 2>&1 || warn.log "odocker: could not add $u to group $group"
 done
 create.result "$rc" "${missing:-odocker prerequisites here}; group $group:${users:+ $users}"
 return $(result)
}


odocker.prereqs.install.completion.user() {
  # one candidate per line on stdout; $1 is the word being completed
  compgen -u "$1"
}
private.odocker.container.prereqs.install()     # <container> # install the Docker client and column in a running <container> that has no oosh, with the package names of private.odocker.prereq.package.get, and add its users to the group of the docker socket without renumbering a group; rc 1 naming what failed #
{
 # The raw path of odocker install: a container WITHOUT oosh, so none of its
 # methods run there. The package names are the table's
 # (private.odocker.prereq.package.get), asked on this host with the
 # container's package manager; the group rule is socket.group.ensure's: the
 # group of the socket's number, else docker, else dockerhost — an existing
 # group is never renumbered (T-ODOCKER-INSTALL-RAW).
 local container="$1" pm cmd pkgs gid group u
 [ -n "$1" ] && shift
 pm=$(docker exec "$container" sh -c 'for pm in apk apt-get dnf yum; do if command -v "$pm" >/dev/null 2>&1; then echo "$pm"; break; fi; done' 2>/dev/null)
 case "$pm" in
   apk)     cmd="apk add --no-cache" ;;
   apt-get) private.this.script.load oo private.oo.pm.env.get
            cmd="apt-get update && $(private.oo.pm.env.get apt-get) apt-get -y install" ;;
   dnf|yum) cmd="$pm -y install" ;;
   *) create.result 1 "no known package manager in $container (apk, apt-get, dnf, yum)"; error.log "$RESULT"
      return $(result) ;;
 esac
 pkgs="$(OOSH_PM="$pm" private.odocker.prereq.package.get docker) $(OOSH_PM="$pm" private.odocker.prereq.package.get column)"
 # docker-ce-cli (apt, dnf/yum) comes from Docker's repository: added from
 # this host, as prereqs.ensure adds it on a computer with oosh.
 case "$pkgs" in
   docker-ce*) if ! private.odocker.container.repo.add "$container" "$pm"; then
                 error.log "$RESULT"; return $(result)
               fi ;;
 esac
 console.log "Installing $pkgs in $container ($pm; no oosh there)"
 if ! docker exec "$container" sh -c "$cmd $pkgs"; then
   create.result 1 "the install of $pkgs failed in $container"; error.log "$RESULT"
   return $(result)
 fi
 gid=$(docker exec "$container" stat -c %g /var/run/docker.sock 2>/dev/null)
 if [ -z "$gid" ]; then
   create.result 0 "installed $pkgs in $container; no docker socket there, so no group"
   return $(result)
 fi
 group=$(docker exec "$container" sh -c "getent group $gid 2>/dev/null || grep '^[^:]*:[^:]*:$gid:' /etc/group" 2>/dev/null | cut -d: -f1)
 if [ -z "$group" ]; then
   group="docker"
   [ -n "$(docker exec "$container" sh -c "getent group docker 2>/dev/null || grep '^docker:' /etc/group" 2>/dev/null)" ] && group="dockerhost"
   console.log "odocker: the docker socket in $container belongs to group number $gid — creating group $group for it"
   docker exec "$container" sh -c "groupadd -g $gid $group 2>/dev/null || addgroup -g $gid $group"
 fi
 for u in $(docker exec "$container" awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' /etc/passwd 2>/dev/null); do
   docker exec "$container" sh -c "usermod -aG $group $u 2>/dev/null || addgroup $u $group 2>/dev/null"
 done
 create.result 0 "installed $pkgs in $container; group $group owns its docker socket"
 return $(result)
}


private.odocker.docker.repo.get()     # <field> <pm> <?osRelease:/etc/os-release> <?arch> # echo one field of the package repository of Docker for package manager <pm>: marker (the file that marks it present), url (what is downloaded), file (where the download goes), line (apt: the source line from ID, VERSION_CODENAME of <osRelease> and <arch>); rc 1 and nothing when <pm> has none or apt lacks a value #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. The one
 # source of the data of Docker's repository: the local add
 # (private.odocker.docker.repo.add) and the add into a container without oosh
 # (private.odocker.container.repo.add) ask it (T-ODOCKER-DOCKER-REPO-GET).
 # apt: the key is the download, the list (written last) the marker; dnf/yum:
 # the .repo file is both — what config-manager --add-repo would fetch.
 local field="$1" pm="${2%% *}" osRelease="${3:-/etc/os-release}" arch="$4" key="/etc/apt/keyrings/docker.asc" id codename
 case "$pm:$field" in
   apt-get:marker|dpkg:marker) echo "/etc/apt/sources.list.d/docker.list" ;;
   apt-get:file|dpkg:file)     echo "$key" ;;
   apt-get:url|dpkg:url|apt-get:line|dpkg:line)
     private.this.script.load os private.os.release.get || return 1
     id=$(private.os.release.get ID "$osRelease")
     codename=$(private.os.release.get VERSION_CODENAME "$osRelease")
     [ -n "$id" ] && [ -n "$codename" ] && [ -n "$arch" ] || return 1
     if [ "$field" = url ]; then
       echo "https://download.docker.com/linux/$id/gpg"
     else
       echo "deb [arch=$arch signed-by=$key] https://download.docker.com/linux/$id $codename stable"
     fi ;;
   dnf:marker|yum:marker|dnf:file|yum:file) echo "/etc/yum.repos.d/docker-ce.repo" ;;
   dnf:url|yum:url)   echo "https://download.docker.com/linux/centos/docker-ce.repo" ;;
   dnf:line|yum:line) ;;
   *) return 1 ;;
 esac
}


private.odocker.docker.repo.download()     # <url> # download <url> to a temporary file of this host: rc 0 and RESULT the file; rc 1 naming why when curl fails or the download is empty, and no file left #
{
 # Only a complete, non-empty download counts: an empty key broke every later
 # apt-get update — curl's rc was lost in a pipe (T-ODOCKER-DOCKER-REPO-APT).
 # On this host for a container too: a naked image may have no curl.
 local url="$1" tmp
 [ -n "$1" ] && shift
 if ! tmp=$(mktemp 2>/dev/null); then
   create.result 1 "no temporary file for the download of $url"
 elif ! curl -fsSL "$url" > "$tmp" 2>/dev/null; then
   rm -f "$tmp"; create.result 1 "could not download $url"
 elif [ ! -s "$tmp" ]; then
   rm -f "$tmp"; create.result 1 "the download of $url is empty"
 else
   create.result 0 "$tmp"
 fi
 return $(result)
}


private.odocker.container.repo.add()     # <container> <pm> # add the package repository of Docker to a running <container> without oosh: the data of private.odocker.docker.repo.get from the os-release and architecture of the container, downloaded on this host, written into the container; nothing when its marker is there; rc 1 naming why #
{
 # A naked image (ubuntu, debian, almalinux) has no oosh, maybe no curl and no
 # ca-certificates: the same data and the same download as the local add, done
 # here, then written into the container. Its ID, VERSION_CODENAME and
 # architecture are the container's, never this host's (T-ODOCKER-INSTALL-RAW).
 local container="$1" pm="$2" marker file url line arch osRelease tmp rc
 [ -n "$1" ] && shift
 [ -n "$1" ] && shift
 if ! marker=$(private.odocker.docker.repo.get marker "$pm"); then
   create.result 1 "Docker has no package repository for ${pm:-this package manager}"
   return $(result)
 fi
 if docker exec "$container" test -e "$marker" 2>/dev/null; then
   create.result 0 "Docker's repository is there in $container: $marker"
   return $(result)
 fi
 if ! osRelease=$(mktemp 2>/dev/null); then
   create.result 1 "no temporary file for the os-release of $container"; return $(result)
 fi
 docker exec "$container" cat /etc/os-release > "$osRelease" 2>/dev/null
 arch=$(docker exec "$container" dpkg --print-architecture 2>/dev/null)
 url=$(private.odocker.docker.repo.get url "$pm" "$osRelease" "$arch")
 file=$(private.odocker.docker.repo.get file "$pm" "$osRelease" "$arch")
 line=$(private.odocker.docker.repo.get line "$pm" "$osRelease" "$arch")
 rm -f "$osRelease"
 if [ -z "$url" ]; then
   create.result 1 "Docker's repository for $container needs ID and VERSION_CODENAME of its /etc/os-release and its architecture (arch: ${arch:-?})"
   return $(result)
 fi
 if ! private.odocker.docker.repo.download "$url"; then
   create.result 1 "$RESULT — nothing was written into $container; check the network of this host, or install oosh in $container and run odocker install again"
   return $(result)
 fi
 tmp="$RESULT"
 # apt fetches the repository over https: the container needs the CA list.
 if [ -n "$line" ]; then
   private.this.script.load oo private.oo.pm.env.get
   docker exec "$container" sh -c "command -v update-ca-certificates >/dev/null 2>&1 || { apt-get update && $(private.oo.pm.env.get apt-get) apt-get -y install ca-certificates; }" >/dev/null 2>&1
 fi
 docker exec "$container" mkdir -p "${file%/*}" "${marker%/*}" \
   && docker exec -i "$container" sh -c "cat > $file" < "$tmp" \
   && { [ -z "$line" ] || printf '%s\n' "$line" | docker exec -i "$container" sh -c "cat > $marker"; }
 rc=$?
 rm -f "$tmp"
 if [ "$rc" != 0 ]; then
   docker exec "$container" rm -f "$marker" "$file" >/dev/null 2>&1
   create.result 1 "could not write Docker's repository into $container"; return $(result)
 fi
 create.result 0 "Docker's repository added in $container: $marker"
 return $(result)
}


