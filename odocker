odocker.usage()
{
  local this=${0##*/}
  echo "You started"
  echo "$0

  Usage:
  $this: command   Parameter and Description"
  this.help
  echo "

  Examples
    $this ps
    $this build nakedUbuntu/20.04.sshd
    $this run.sshd naked_ubuntu_20_04_sshd
    $this exec fervent_ritchie
    $this file.find fervent_ritchie
    $this stop fervent_ritchie
    $this log fervent_ritchie
    $this workspace.list
    $this status
    $this disk
    $this prune
    ----------
  "
}

private.odocker.isInsideDocker() # # return 0 if running inside a Docker container
{
  [ -f /.dockerenv ] && return 0
  grep -q 'docker\|containerd' /proc/1/cgroup 2>/dev/null && return 0
  return 1
}

odocker.install() # <?container> # install Docker CLI (inside container) or engine (on host). Auto-detects.
{
  local container="$1"

  if [ -n "$container" ]; then
    # Install CLI into a named container via docker exec
    console.log "Installing Docker CLI into container: $container"
    docker exec "$container" bash -c '
      apt-get update -qq && apt-get install -y -qq docker.io 2>/dev/null || \
      apt-get install -y -qq docker-ce-cli 2>/dev/null || \
      { echo "ERROR: could not install Docker CLI"; exit 1; }
    '
    return $?
  fi

  if private.odocker.isInsideDocker; then
    # Inside a container: install CLI only (engine runs on host)
    console.log "Detected: running inside Docker container"
    console.log "Installing Docker CLI only (engine runs on host)..."
    oo cmd docker.io 2>/dev/null || oo cmd docker-ce-cli 2>/dev/null || {
      # Manual install if oo cmd fails
      if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq && apt-get install -y -qq docker.io
      elif command -v apk >/dev/null 2>&1; then
        apk add docker-cli
      else
        error.log "Cannot install Docker CLI — unknown package manager"
        return 1
      fi
    }
    if command -v docker >/dev/null 2>&1; then
      success.log "Docker CLI installed: $(docker --version 2>/dev/null)"
    else
      error.log "Docker CLI installation failed"
      return 1
    fi
  else
    # On host: install full Docker engine
    console.log "Detected: running on host (not inside Docker)"
    console.log "Installing Docker engine..."
    if command -v docker >/dev/null 2>&1; then
      console.log "Docker already installed: $(docker --version)"
      return 0
    fi
    curl -fsSL https://get.docker.com | bash
    if command -v docker >/dev/null 2>&1; then
      success.log "Docker engine installed: $(docker --version)"
    else
      error.log "Docker engine installation failed"
      return 1
    fi
  fi
}
odocker.install.completion.container() {
  private.odocker.running.containers
}

# ── Hypervisor self-care (constructor must yield a reachable docker engine) ───
# `odocker.start` is the constructor: a fully-operational odocker means the docker
# daemon answers. Detect a dead daemon and bring the hypervisor up — idempotent
# (already-up → no-op), context/endpoint read from `docker context` (never a
# guessed path), fail-loud (never rc0 on a dead daemon).

private.odocker.activeContext() # # echo the active docker context name
{
  docker context show 2>/dev/null
}

private.odocker.engineReachable() # # 0 if the docker daemon answers on the active context
{
  docker info >/dev/null 2>&1
}

private.odocker.waitReachable() # <?timeout:90> # poll docker info until reachable or timeout; 0 on success
{
  local timeout="${1:-90}" waited=0
  while [ "$waited" -lt "$timeout" ]; do
    private.odocker.engineReachable && return 0
    sleep 2; waited=$((waited + 2))
  done
  private.odocker.engineReachable
}

private.odocker.ensureEngine() # # self-heal: ensure the docker engine is reachable, bringing the hypervisor up; fail loud
{
  # Idempotent — already reachable → no-op.
  if private.odocker.engineReachable; then
    debug.log "odocker: docker engine reachable — no-op"
    return 0
  fi
  local ctx; ctx="$(private.odocker.activeContext)"
  important.log "odocker.start: docker engine not reachable (context '${ctx:-?}') — bringing the hypervisor up"
  case "$ctx" in
    desktop-linux)
      command -v systemctl >/dev/null 2>&1 || { error.log "odocker.start: systemctl unavailable — cannot start the docker-desktop hypervisor"; return 1; }
      systemctl --user start docker-desktop 2>/dev/null \
        || { error.log "odocker.start: 'systemctl --user start docker-desktop' failed — check 'systemctl --user status docker-desktop'"; return 1; }
      if private.odocker.waitReachable 90; then
        console.log "odocker.start: hypervisor up — docker engine reachable"; return 0
      fi
      error.log "odocker.start: started docker-desktop but the engine is still unreachable after 90s — check 'systemctl --user status docker-desktop'"
      return 1
      ;;
    default)
      # System dockerd path — root/sudo-gated; degrade gracefully if not permitted.
      local sudo=""; [ "$(id -u)" -ne 0 ] && sudo="sudo"
      if $sudo systemctl start docker 2>/dev/null && private.odocker.waitReachable 60; then
        console.log "odocker.start: system dockerd up — docker engine reachable"; return 0
      fi
      error.log "odocker.start: engine unreachable on context 'default' and could not start docker.service (needs privileges?) — start it manually"
      return 1
      ;;
    *)
      error.log "odocker.start: engine unreachable on context '${ctx:-?}' — no known hypervisor start path; start the daemon manually"
      return 1
      ;;
  esac
}

odocker.start() # # constructor: bootstrap kernel + ensure the docker hypervisor is reachable (self-heal), then dispatch
{
  source this
  # Constructor must yield a fully-operational object → the docker engine must be
  # reachable. Self-heal on real construction only; skip when sourced (completion)
  # and for introspection verbs so the tool stays usable when docker is down.
  if ! this.isSourced; then
    case "$1" in
      ''|help|help*|usage|completion*) : ;;
      *) private.odocker.ensureEngine || return $? ;;
    esac
  fi
  this.start "$@"
}

odocker.start "$@"
