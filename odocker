      ports=$(private.odocker.container.ports "$name")
      printf "%s\t%s\t%s\t%s\t%s\n" "$id" "$name" "$image" "$status" "$ports"
    done < <(docker ps -a --format '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}' 2>/dev/null)
  } | column -t -s $'\t'
}

