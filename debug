#   fi
} 2>/dev/null

private.debug.errno() { # <exitCode> <?command> # describe an exit status WITHOUT inventing a cause; echoes e.g. "EXIT 2" or "ENOENT 127 Command not found"
  local code=$1 cmd="$2"
  # $code is the command's EXIT STATUS — nothing more. Only the SHELL assigns
  # meaning to particular values, and only when IT could not run the command:
  # 127 "not found", 126 "found but not executable". Any program is free to
  # return those, or 2, as its own status:
  #   env -i sh -c 'exit 127'  -> env ran fine and PROPAGATED its child's 127
  #   grep <unreadable file>   -> 2 means "an error occurred", not a builtin misuse
  # Glossing those as "Command not found" / "Misuse of shell builtins" invents
  # a diagnosis, so every interpretation below is CHECKED before it is offered.
  case $code in
    0) echo "EXIT $code Success" ; return ;;
    1) echo "EXIT $code General failure" ; return ;;
  esac
  # 126/127 — only if the shell really could not run it.
  if [ -n "$cmd" ]; then
    local resolved
    resolved=$(command -v "$cmd" 2>/dev/null)
    if [ "$code" = "127" ] && [ -z "$resolved" ]; then
      echo "ENOENT $code Command not found" ; return
    fi
    if [ "$code" = "126" ] && [ -n "$resolved" ] && [ ! -x "$resolved" ]; then
      echo "EACCES $code Command not executable" ; return
    fi
  fi
  # Signal-killed processes: 128+N. This one IS a reliable shell convention —
  # the shell, not the command, sets it.
  if [ "$code" -gt 128 ] && [ "$code" -le 192 ] 2>/dev/null; then
    local sig=$((code - 128))
    echo "SIGNAL $code Killed by signal $sig" ; return
  fi
  # Deliberately NO errno lookup here. An exit status is not an errno — they
  # are unrelated numbering systems (errno 2 is ENOENT, exit 2 is just 2), so
  # the old python3 translation produced a third wrong answer. Dropping it
  # also takes python3 out of an ERR-trap path, where a nested trap or a
  # sudo prompt could hang the shell.
  echo "EXIT $code"
}

function onError() {
  #echo -e "\e[1;31m   line: ${BASH_LINENO[2]} '${BASH_COMMAND[2]}'\e[0m"

  if [ -n "$1" ]; then
    RETURN_VALUE=$1
  fi

  if [ "$RETURN_VALUE" = "$EXPECTED_RETURN_VALUE" ]; then

    if [ -n "$RETURN_VALUE" ] && [ -n "$ERROR_CODE_RECONFIG" ] && [ "$RETURN_VALUE" -eq "$ERROR_CODE_RECONFIG" ] 2>/dev/null; then
      unset STARTED_OOSH
      export STARTED_OOSH
      echo -e "${CYAN}applying new configuration - from debug $RETURN_VALUE ${NORMAL}" >/dev/tty
      export RETURN_VALUE
      $OOSH_DIR/this restart 
      #echo -e "${CYAN}exited onError ${ERROR_CODE_RECONFIG}${NORMAL}"
      exit $ERROR_CODE_RECONFIG
    fi

    if [ ! "$RETURN_VALUE" = "1" ]; then
      warn.log "GOT EXPECTED ERROR in function ${FUNCNAME[1]} in line: ${BASH_LINENO[1]} from ${BASH_SOURCE[2]} returned with ERROR code: $RETURN_VALUE"
    fi
    EXPECTED_RETURN_VALUE=1
    return 0
  fi

  debug.log "source stack: ${BASH_SOURCE[@]##*/}"
  info.log "EXPECTED_RETURN_VALUE=$EXPECTED_RETURN_VALUE ? RETURN_VALUE=$RETURN_VALUE "
  error.log         "line ${BASH_LINENO[0]}: \"$2\" from ${BASH_SOURCE[1]} returned with ERROR code: $( private.debug.errno "$RETURN_VALUE" "$2" )"
  if [ "$LOG_LEVEL" -gt 3 ]; then
    check.debug.level 3
    stackTrace
    check.debug.level reset
  fi   
}

expect.error()
{
  if (this.isNumber "$1"); then
    export EXPECTED_RETURN_VALUE=$1
  else
    warn.log "ignoring expect error, because \"$1\" is not a number."
  fi
}

function onExit() {
  debug.log "exiting"
}


function setTrap() {
  #echo "trap DEBUG set to step"

  #export PS4='\e[90m+${LINENO}: '


  #set -e
  trap 'onError ${?} ${BASH_COMMAND}' ERR
  trap 'onReturn ${?}' RETURN
  trap 'onExit  ${?}' EXIT 
  
  trap step DEBUG 2>/dev/null
}

if [ $LOG_LEVEL -lt 5 ]; then
  info.log "debug setTrap"
  setTrap
fi

