private.check.remote.install.started() {
  if [ -n "$SSH_CONFIG_FROM_REMOTE" ]; then
    success.log "
    
    Remote installation started from  : $SSH_CONFIG_FROM_REMOTE
    Remote name used for this machine±: $SSH_CONFIG_NAME_USED_FOR_LOCAL
    "
    create.result 0 12 $1
  else
    warn.log "SSH_CONFIG_FROM_REMOTE not set. No remote installation detected"
    success.log "remote.install.started: continue with local install"
    create.result 0 12 $1
  fi
  return $(result)
}

private.check.local.install.started() {
  if [ -f "$OOSH_DIR/this" ]; then
    create.result 0 "$OOSH_DIR/this exists"
  else
    create.result 1 "$OOSH_DIR/this does not exist"
  fi
}

private.check.priviledges.checked() # # RESULT will be the follow up state
{
  if [ "$USER" = "root" ]; then
    create.result 0 "30"
  else
    create.result 1 "user privilidges"
    if private.test.sudo.priviledges; then
      # RESULT will be the follow up state: [30]="root.rights""
      create.result 0 "30"
    else
      # RESULT will be the follow up state: [20]="user.rights.only"
      create.result 1 "20"
    fi
  fi

}

private.test.sudo.priviledges() {
  # F2: NON-INTERACTIVE sudo-capability probe. A naked P1 self-bootstrap must NEVER
  # block on `[sudo] password for …` (constructor-contract). The old probe ran
  # `$SUDO touch ~/.sudo_as_admin_successful` which prompts on a box with no cached
  # creds → unattended-install hang. Mirrors init/oosh `oosh_can_escalate` (DRY,
  # `sudo -n`): a failed non-interactive escalation = "no sudo → user band" (defer
  # with a warning), NOT a prompt. No escalation is attempted for the marker itself
  # (it lives in the user's HOME — never touch it as root).
  if [ "$(id -u 2>/dev/null)" = "0" ] || [ "$HOME" = "/root" ]; then
    create.result 0 "root — no sudo required"
    return $(result)
  fi
  # Fast path: Ubuntu sets ~/.sudo_as_admin_successful after a prior successful sudo.
  if [ -f ~/.sudo_as_admin_successful ]; then
    create.result 0 "sudo privilidges (marker present)"
    return $(result)
  fi
  # Authoritative test — non-interactive, never prompts (fails fast if a password
  # would be required).
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    create.result 0 "sudo privilidges (non-interactive)"
    return $(result)
  fi
  # No non-interactive escalation available → defer to the USER band (warning, not a
  # hang; privileged steps are skipped/deferred per Tron's defer-privilege principle).
  warn.log "no non-interactive sudo — deferring to user-mode install (no password prompt)"
  create.result 1 "no sudo privilidges (deferred to user band)"
  return $(result)
}

private.check.user.rights.only() {
  # C.1: single OOSH_MODE derivation seam. [20] user.rights.only is the entry of the
  # user mode band — the ONE place a mode default is established before the
  # release⊕dev XOR (D2). P2 (ossh install / `oo mode.dev`) has already exported
  # OOSH_MODE=dev by the time we reach here; a naked P1 self-bootstrap arrives with
  # it empty → default released. No scattered defaults, no state-engine edit.
  [ -z "$OOSH_MODE" ] && export OOSH_MODE="released"
  source state
  state.check SETUP_SERVER priviledges.checked oo
  if [ "$RESULT" = "20" ]; then
    create.result 0 "20"
    return $(result)
  fi
  if [ "$RESULT" = "30" ]; then
    create.result 0 "30"
    return $(result)
  fi
  create.result 1 "Something went wrong! \n$RESULT"
  return $(result)
}

private.check.user.installation.done() {
  if [ -d $HOME/oosh ]; then
    create.result 0 "$HOME/oosh exists"
  else
    create.result 1 "$HOME/oosh does not exist"
  fi
}

private.check.user.mode.release() # # XOR arm: accept on released, redirect-forward to dev on dev
{
  # D2: ALWAYS succeed (return 0) and steer via numeric RESULT so `state next`
  # crosses the release⊕dev XOR (returning 1 here would HOLD the machine — the old
  # stall). Target index resolved dynamically via state.find (NO hardcoded 21/22/23
  # — DRY + survives the D1 reorder). matching mode → accept own index (non-numeric
  # RESULT); non-matching → redirect forward to the dev arm.
  source state
  if [ "$OOSH_MODE" = "released" ]; then
    create.result 0 "OOSH_MODE=$OOSH_MODE"
  else
    create.result 0 "$(state.find SETUP_SERVER user.mode.dev id)"
  fi
  return $(result)
}

private.check.user.mode.dev() # # XOR arm: accept on dev, redirect-forward past dev to done on released
{
  # D2 (mirror of release arm): accept when dev is active; otherwise redirect
  # FORWARD past this arm to user.installation.done so both OOSH_MODE values
  # converge on the single terminal. state.find keeps indices dynamic.
  source state
  if [ "$OOSH_MODE" = "dev" ]; then
    create.result 0 "OOSH_MODE=$OOSH_MODE"
  else
    create.result 0 "$(state.find SETUP_SERVER user.installation.done id)"
  fi
  return $(result)
}

private.check.root.rights() {
  source state
  state.check SETUP_SERVER priviledges.checked oo
  if [ "$RESULT" = "20" ]; then
    create.result 1 "21"
    return $(result)
  fi
  if [ "$RESULT" = "30" ]; then
    create.result 0 "30"
    return $(result)
  fi
  create.result 1 "Something went wrong! \n$RESULT"
  return $(result)
}


