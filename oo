oo.method.delete()     # <script.method> # removes a method and its completion functions from the script; reports the test cases that still reference it #
{
  # The counterpart of oo.method.new, and the reason it exists: a method is a
  # BLOCK — its docstring, its body and one completion function per parameter.
  # Deleting it by hand removes the body and leaves the rest orphaned, which
  # is how `path` came to carry completion functions for verbs it no longer
  # had. Built on `replace block`, so the .bak/.new transaction and the
  # exactly-one-match refusal come for free.
  #
  # It deliberately does NOT delete the test case. A test case has no
  # delimiters — it is a `test.case` line, a call and one or more `expect`s,
  # freely interleaved with fixtures — so guessing its extent would silently
  # eat assertions. The references are REPORTED instead, for a human to remove.
  #
  # It addresses a method as <script>.<method>, so it cannot reach a LEGACY
  # private helper whose name carries no script segment — `private.update.config`
  # lived in `path`, but nothing in the name said so. Remove one of those with
  # the command this is built on: `replace block <file> "<its first line>" "}"
  # by ""`. Modern privates (private.oo.cmd.verify) are named after their
  # script and need no special case.
  local name="$1"
  if [ -z "$name" ]; then
    error.log "oo.method.delete: no method given — expected <script>.<method>, e.g. path.status"
    create.result 1 "no method given"
    return $(result)
  fi
  # The script is resolved by the same rule oo method.new uses: private.<script>.x
  # belongs to <script>, and a dotted script name (test.suite) is one script.
  local script method
  read -r script method <<< "$(private.oo.method.name.resolve "$name")"
  if [ -z "$method" ]; then
    error.log "oo.method.delete: no method name in '$name' — expected <script>.<method>, e.g. path.status"
    create.result 2 "no method name in '$name'"
    return $(result)
  fi

  # The REAL file: a script may be a symlink (top-level c2 -> ng/c2), and
  # replace commit refuses a link rather than turn it into a copy.
  local file
  file=$(private.this.path.canonical "$OOSH_DIR/$script")
  if ! check file "$file" exists fix error.log "$file does not exist"; then
    create.result 3 "$file does not exist"
    return $(result)
  fi

  # The method itself, then every completion function that belongs to it:
  # <script>.<method>.completion and <script>.<method>.completion.<param>.
  # A `private.` sibling is NOT swept — nothing can prove it had only this
  # one caller — so it is reported like the tests are.
  local escaped="$(private.oo.regex.escape.get "$name")"
  local targets removed=0 target startLine
  # `[[:space:]]*` before the parens: a handful of legacy methods are written
  # `name ()` with a space (path.file.global.use was one), and the tool has to
  # find those too or it reports a method that plainly exists as missing.
  targets=$(grep -E "^${escaped}(\.completion(\.[A-Za-z0-9_]+)?)?[[:space:]]*\(\)" "$file" 2>/dev/null)

  if [ -z "$targets" ]; then
    error.log "oo.method.delete: $name is not defined in $file"
    create.result 4 "$name not found in $file"
    return $(result)
  fi

  # Where each definition ENDS is private.oo.method.end.get's: a one-liner, a
  # signature with a `{ …; }` body, or a block closed by a `}` line. The block
  # form alone ran a `{ …; }` body on into the next method and deleted it
  # (T-METHOD-DELETE-ONE-LINE). An end it cannot tell is refused, not guessed.
  local endLine
  while IFS= read -r startLine; do
    [ -z "$startLine" ] && continue
    endLine=$(private.oo.method.end.get "$file" "$startLine")
    if [ -z "$endLine" ]; then
      error.log "oo.method.delete: cannot tell where the definition ends before the next one — left as it is: $startLine"
    elif [ "$endLine" = "$startLine" ]; then
      if replace line "$file" "$startLine" by "" && replace commit "$file"; then
        removed=$((removed + 1))
      else
        error.log "oo.method.delete: could not remove the one-line definition: $startLine"
      fi
    elif replace block "$file" "$startLine" "$endLine" by "" && replace commit "$file"; then
      removed=$((removed + 1))
    else
      error.log "oo.method.delete: could not remove the block starting: $startLine"
    fi
    replace cleanup "$file"
  done <<< "$targets"

  # What is left behind for a human: test cases, and any private helper named
  # after the method.
  local refs refCount
  refs=$(grep -rn -F -- "$name" "$OOSH_DIR/test" 2>/dev/null)
  refCount=$(printf '%s' "$refs" | grep -c . )
  if [ "${refCount:-0}" -gt 0 ]; then
    important.log "oo.method.delete: $refCount test reference(s) to $name remain — remove them deliberately:"
    important.log "$refs"
  fi
  local helpers
  helpers=$(grep -E "^private\.${escaped}" "$file" 2>/dev/null)
  if [ -n "$helpers" ]; then
    important.log "oo.method.delete: private helper(s) named after $name are still in $file — check their callers before removing:"
    important.log "$helpers"
  fi

  success.log "removed $removed definition(s) of $name from $file"
  create.result 0 "$name removed from $script — $removed definition(s), $refCount test reference(s) remain"
  return $(result)
}

private.oo.regex.escape.get() # <text> # <text> with every ERE metacharacter backslash-escaped; answers on stdout
{
  # NO create.result — a getter consumed as $(...) runs in a subshell, so
  # RESULT would never reach the caller. Same reasoning as
  # private.oo.method.stubs.get.
  printf '%s' "$1" | sed 's/[][\.*^$(){}?+|/]/\\&/g'
}

oo.method.delete.completion.script() {
  # Hand-written rather than generated, and the reason belongs here:
  # private.oo.method.stubs.get skips any parameter whose name is not purely
  # alphanumeric, and this one is `<script.method>`.
  #
  # NO create.result, and nothing that calls it — a completion function that
  # does corrupts c2 (docs/completion-system.md).
  local word="$1"
  case "$word" in
    *.*)
      local script="${word%%.*}"
      [ -f "$OOSH_DIR/$script" ] || return 0
      grep -oE "^${script}\.[A-Za-z0-9_.]+\(\)" "$OOSH_DIR/$script" 2>/dev/null | sed 's/()$//'
      ;;
    *)
      # Extensionless files in $OOSH_DIR are the method-scripts.
      ls -1 "$OOSH_DIR" 2>/dev/null | grep -vE '[.]'
      ;;
  esac
}


oo.test.platform.new()     # <scope> <aspect> # generate test/test.platform.<scope>.<aspect>.invariant from templates/code/newPlatformInvariantTest; refuses an existing file #
{
 local scope="$1" aspect="$2"
 if [ -z "$scope" ] || [ -z "$aspect" ]; then
   create.result 1 "oo test.platform.new requires <scope> <aspect>"; error.log "$RESULT"; return $(result)
 fi
 # camelCase words only: the name becomes a file name and a sed replacement.
 case "$scope$aspect" in
   *[!A-Za-z0-9]*) create.result 1 "oo test.platform.new: <scope> and <aspect> are camelCase words, got '$scope' '$aspect'"; error.log "$RESULT"; return $(result) ;;
 esac
 local template="$OOSH_DIR/templates/code/newPlatformInvariantTest"
 local target="$OOSH_DIR/test/test.platform.$scope.$aspect.invariant"
 if [ ! -f "$template" ]; then create.result 1 "oo test.platform.new: template missing: $template"; error.log "$RESULT"; return $(result); fi
 if [ -e "$target" ]; then create.result 1 "oo test.platform.new: refusing to overwrite $target"; error.log "$RESULT"; return $(result); fi
 if sed -e "s/<scope>/$scope/g" -e "s/<aspect>/$aspect/g" "$template" > "$target" && chmod +x "$target"; then
   success.log "created test/test.platform.$scope.$aspect.invariant — replace its INVARIANT blocks, then: ./test.suite run platform.$scope.$aspect.invariant 1"
   create.result 0 "created test/test.platform.$scope.$aspect.invariant"
 else
   # Only reachable after the existence refusal above: this removes what this call wrote.
   rm -f "$target"
   create.result 1 "oo test.platform.new: could not write $target"; error.log "$RESULT"
 fi
 return $(result)
}


oo.test.platform.new.completion.scope() {
  # one candidate per line on stdout; $1 is the word being completed
  echo shared
}
oo.test.platform.new.completion.aspect() {
  # one candidate per line on stdout; $1 is the word being completed
  echo config
  echo oosh
  echo layout
