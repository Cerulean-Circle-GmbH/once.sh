oo.parameter.completion.baseBranch() {
  # Direct git enumeration — see comment on oo.mode.completion.branch.
  # Inline dir-iteration matching oo.branch.list local (oo:391-404).
  # Not a call to oo.branch.list because that uses create.result, which
  # corrupts c2's completion-subprocess output on macOS (see 7e54c91 +
  # 70009fa for the same fix on sibling completion functions). And not
  # `git worktree list` because the test fixture (and any future
  # independent-init-style sibling layout) doesn't share a .git — see
  # T-MODE-5 in test/test.oo.
  local base
  base=$(oo.mode.base.get 2>/dev/null)
  [ $? -eq 0 ] && [ -d "$base" ] || return 0
  local dir
  for dir in "$base"/*/; do
    [ -L "${dir%/}" ] && continue
    [ -d "$dir/.git" ] || [ -f "$dir/.git" ] || continue
    local dirName
    dirName=$(basename "$dir")
    [[ "$dirName" == .* ]] && continue
    echo "$dirName"
  done | sort -u
}

