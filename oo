private.check.root.installation.done() {
  # IN-CHAIN state step: wire root's ~/.bashrc with the OOSH bootstrap
  # (templates/user/bashrcTemplate). A DIRECT-root install never wires it
  # otherwise (user.oosh.install only runs for SUDO_USER≠root), so a fresh
  # `env -i bash` would not become an OOSH shell (empty OOSH_MODE/DIR, no oo).
  # Deterministic + idempotent: install only if not already the OOSH bashrc.
  local tmpl="$OOSH_DIR/templates/user/bashrcTemplate"
  if [ -f "$tmpl" ]; then
    if ! grep -q 'CONFIG=~/config/user.env' "$HOME/.bashrc" 2>/dev/null; then
      [ -f "$HOME/.bashrc" ] && cp "$HOME/.bashrc" "$HOME/.bashrc.pre-oosh" 2>/dev/null
      cp "$tmpl" "$HOME/.bashrc"
      success.log "root.installation.done: wired $HOME/.bashrc with OOSH bootstrap (bashrcTemplate)"
    else
      info.log "root.installation.done: $HOME/.bashrc already OOSH-wired"
    fi
  else
    warn.log "root.installation.done: bashrcTemplate not found at $tmpl"
  fi
  return 0
}

