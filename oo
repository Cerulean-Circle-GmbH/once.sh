# ogit-exception: docstring text, not an invocation
oo.prereqs.install() # # install the oosh install-time prereqs locally — git and curl — plus bash 4+ if the running shell is older
{
  # Ensure we know the PM. Idempotent — `oo cmd` also calls this if needed.
  [ -z "$OOSH_PM" ] && oo pm.discover

  # Delegate to the existing `oo cmd <pkg>` primitive — it already handles
  # "already installed" (command -v check), calls $SUDO $OOSH_PM <pkg>, and
  # knows per-distro package-name quirks. No new package-install logic here.
  local pkg rc=0
  for pkg in curl git; do
    if ! oo cmd "$pkg"; then
      error.log "oo.prereqs.install: failed to install $pkg"
      rc=1
    fi
  done

  # bash 4+ case is subtle: `oo cmd bash` short-circuits when bash is
  # already in PATH (oo.cmd's `command -v` check), and macOS ships bash 3.2
  # at /bin/bash — so oo cmd bash would NO-OP and the upgrade never fires.
  # Bypass the existence check by dispatching directly to the PM — with the
  # prefix oo cmd uses, private.oo.pm.install.prefix.get: bypassing oo cmd
  # must not bypass the sudo decision (brew refuses root) or the
  # non-interactive env (apt: tzdata's debconf prompt; brew: ask mode).
  if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    [ -z "$OOSH_PM" ] && oo pm.discover
    $(private.oo.pm.install.prefix.get) $OOSH_PM bash || rc=1
    important.log "bash 4+ installed — re-exec the installer from a fresh shell to pick it up"
  fi
  return $rc
}

oo.pm() # # checks if the pm is well configured
{
  if [ -n "$OOSH_PM" ]; then
    console.log "package manager is set:"
    console.log "for OOSH: $OOSH_PM"
    console.log "for ONCE: $ONCE_PM"
    if [ "$OOSH_PM" = "$ONCE_PM" ]; then
      success.log "package manager well configured"
      return 0
    else
      warn.log "package manager differ!
      use
      
        oo pm.discover
      
      to fix that
      "
      return 1
    fi
  fi
  OOSH_PM=
  private.check.all.pm
  console.log "PM: $OOSH_PM"

  RETURN=$1
}

oo.pm.discover() # # finds out OS and corresponding package manager (pm)
{
  OOSH_PM=
  private.check.all.pm
  console.log "OOSH_PM: $OOSH_PM"
  config save

  RETURN=$1
}

private.check.pm()             # checks for a package manager
{

    local packageManager=$1
    local packageManagerCommand=$2


    if [ -z "$packageManagerCommand" ]; then
        package=$packageManager
    fi   
    if ! [ -x "$(command -v $packageManager)" ]; then
        debug.log "no $packageManager"
    else
        if [ -z "$OOSH_PM" ]; then
            export OOSH_PM=$packageManagerCommand
            # Only write what we were GIVEN. These two exports were
            # unconditional, so a call site that passes no group/user command —
            # `brew`, the macOS one (see private.check.all.pm), and dpkg/pkg/pacman — set both to
            # the EMPTY STRING and then persisted them with the
            # `config save os.commands` below. A clean Sequoia install therefore
            # carried OS_CMD_GROUP_ADD="" and OS_CMD_USER_ADD="" for good, while
            # every Linux install carried real values.
            #
            # NOT fixed by adding darwin's commands here: private.user.init
            # already knows them (in user —`dseditgroup -o create -q`,
            # `sysadminctl -addUser`) and heals whichever are empty. Writing
            # them here too would put the same knowledge in two places. Leaving
            # them UNSET is what lets that heal run — and the heal is what makes
            # the cache go healthy, which is what stops private.user.init
            # invoking `oo pm.discover` on every single call.
            # See docs/research/2026-09-17-shared-tier-leak-macos.md.
            if [ -n "$3" ]; then
                export OS_CMD_GROUP_ADD="$3"
            fi
            if [ -n "$4" ]; then
                export OS_CMD_USER_ADD="$4"
            fi
            echo "Package Manager found: using $OOSH_PM somePackage"
            # Discovery only RECORDS. It ran "$SUDO apt-get update" here, and
            # private.user.init discovers whenever os.commands.env is
            # incomplete: sourcing user asked for a sudo password on an apt
            # host (T-OO-PM-DISCOVER-RECORDS, T-USER-SOURCE-NO-SUDO). The
            # refresh is oo.cmd's, once, before its first real install
            # (T-OO-CMD-REFRESH-ONCE).
            config save os.commands "OS_CMD"
        fi
    fi
}

private.check.all.pm()         # adds tools and configurations to package manager (brew, apt-get, addgroup, adduser, dpkg, pkg)
{

    private.check.pm brew "brew install"    
    #once.check.pm apt "apt add"
    private.check.pm apt-get "apt-get -y install" "groupadd -f" "useradd -g dev"
    private.check.pm dnf "dnf -y install" "groupadd -f" "useradd -g dev"
    private.check.pm yum "yum -y install" "groupadd -f" "useradd -g dev"
    private.check.pm apk "apk add" "addgroup" "adduser -g dev"
    private.check.pm dpkg "dpkg install"
    private.check.pm pkg "pkg install -y"
    # -y / --noconfirm are NOT optional. `oo cmd <tool>` runs these during an
    # install; without them pacman and pkg stop on a confirmation prompt and the
    # install hangs with no output explaining why. oosh_pm_detect in init/oosh and
    # ossh.pm.discover have always carried the flags — oo was the odd one out, and
    # nothing compared the four copies until T-PM-TABLES-AGREE.
    private.check.pm pacman "pacman -S --noconfirm"

 
}

oo.install() { # <scriptClass> <path> # installs an external oo script from <path> into oosh/external as a link
  local class="$1"
  shift
  local path="$1"
  shift

  if [ -z "$path" ]; then
    this.absolutePath .
    path=$RESULT
  fi

  this.absolutePath $path
  path=$RESULT

  debug.log "path: $path"
  if [ -L "$OOSH_DIR/external/$class" ]; then
    console.log "updating links: $OOSH_DIR/external/$class -> $path/$class"
    rm $OOSH_DIR/external/$class
    ln -s $path/$class $OOSH_DIR/external/$class
  fi

  if [ -f "$path/$class" ]; then
    console.log "installing link: $class -> $path/$class"
    rm $OOSH_DIR/external/$class
    ln -s "$path/$class" "$OOSH_DIR/external/$class"
  fi

  if [ -f "$OOSH_DIR/$class" ]; then
    console.log "installing: $class -> $path/$class"
    mv "$OOSH_DIR/$class" "$path/$class"
    ln -s "$path/$class" "$OOSH_DIR/external/$class"
  fi

}

