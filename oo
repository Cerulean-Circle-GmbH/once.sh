oo.deinstall()     # <?confirm> # deinstall oosh from this home after the word deinstall is typed (or --yes): the ~/oosh, ~/config and ~/init links are removed, real entries, ~/.once, ~/.bashrc and an older ~/install.oosh kept with a timestamped .orig suffix, ~/oosh last, ~/.bashrc.pre-oosh restored; nothing is deleted #
{
 # It printed "are you sure?", did not wait, and ran rm -Rf ~/oosh ~/config,
 # rm ~/.once ~/.bashrc (D6). It asks now, on the terminal, and keeps
 # everything (T-OO-DEINSTALL-CONFIRM).
 local confirm="$1" answer ts name kept=""
 if [ "$confirm" != --yes ]; then
   answer=$(private.oo.answer.get "oo deinstall removes the ~/oosh, ~/config and ~/init links and keeps real entries, ~/.once and ~/.bashrc as .orig.<ts>; type the word deinstall to continue:")
   if [ "$answer" != deinstall ]; then
     create.result 1 "oo deinstall refused — nothing changed (type the word deinstall, or run: oo deinstall --yes)"
     warn.log "$RESULT"; return $(result)
   fi
 fi
 ts=$(private.this.orig.stamp.get "$HOME" install.oosh oosh config init .once .bashrc)
 # The installer stays reachable after ~/oosh is gone; an older copy is kept.
 if [ -f "$OOSH_DIR/init/oosh" ]; then
   private.this.entry.aside "$HOME/install.oosh" "$ts" >/dev/null || return $(result)
   case "$RESULT" in */*) kept="$kept $RESULT" ;; esac
   cp "$OOSH_DIR/init/oosh" "$HOME/install.oosh" || warn.log "could not copy the installer to $HOME/install.oosh"
 fi
 # The kernel's one move-aside: a link removed, a real entry kept as
 # .orig.<ts>, nothing deleted. ~/oosh LAST: the scripts this still needs
 # come through it (T-OO-DEINSTALL-OOSH-LAST).
 for name in config init .once .bashrc oosh; do
   private.this.entry.aside "$HOME/$name" "$ts" >/dev/null || return $(result)
   case "$RESULT" in */*) kept="$kept $RESULT" ;; esac
 done
 # The .bashrc from before oosh (private.user.bashrc.install keeps it), else
 # the one init/once kept before it added completion — with its own mode.
 for name in .bashrc.pre-oosh .bashrc.bak.without.completion; do
   if [ -f "$HOME/$name" ]; then
     cp -p "$HOME/$name" "$HOME/.bashrc" && important.log "restored $HOME/.bashrc from $name"
     break
   fi
 done
 create.result 0 "oosh deinstalled; kept:${kept:- nothing} — reinstall with: $HOME/install.oosh"
 important.log "$RESULT"
 return $(result)
}
oo.deinstall.completion.confirm() { echo --yes; }

oo.new() # <newClassName> # creates a new script that acts as a oo class with completion
{
  if [ -n "$1" ]; then
    info.log "oosh in $OOSH_DIR"
    cd $OOSH_DIR
    cat ./templates/code/newScript | sed 's/newScript/'"$1"'/' >./$1
    chmod +x ./$1
    success.log "created oo script $1"
    console.log "to enable completion on the new command, type

    reconfigure"

    private.oo.new.test "$1"

  else
    warn.log "usage: oo new filename
    
    please specify a filename"
    return 1
  fi
}

oo.test.new() # <newClassName> # creates a new test script for the class newClassName
{ private.oo.new.test "$@"; }

private.oo.new.test() # <newClassName> # creates a new test script for the class newClassName
{
  if [ -n "$1" ]; then
    info.log "oosh in $OOSH_DIR"

    cd $OOSH_DIR/test
    cat ./../templates/code/newScriptTest | sed 's/newScript/'"$1"'/' > test.$1
    chmod +x ./test.$1
    success.log "created test script test.$1"

  else
    warn.log "usage: oo test.new filename

    please specify a filename"
    return 1
  fi
}

oo.method.new() # <newScript.newMethod> # creates a new method in a script; a private.someScript.someVerb name goes into someScript
{ private.oo.new.method "$@"; }

private.oo.new.method()   # <newScript.newMethod> # creates a new method in a script; a private.someScript.someVerb name goes into someScript
# this is an higly interactive command
{
  local name="$1"
  if [ -z "$name" ]; then
    error.log "No parameter provided."
    return 1
  fi
  # EVERY segment after the first is the method name. `cut -d. -f2` took only
  # the second, so `config.env.init` generated `config.env()` and dropped
  # `.init` silently. Deep hierarchy is explicitly blessed — see
  # docs/oosh-architecture.md, `hiveMind.team.context.status()`.
  #
  # A PRIVATE method is named `private.<script>.<verb>`, so the SCRIPT it
  # belongs to is the SECOND segment. Splitting on the first sent
  # `oo method.new private.config.variables.list` at a file called `private`
  # and refused with rc 3 — measured. The comment this replaces already knew
  # ("`private.oo.cmd.verify` aimed at a file called `private`") and fixed
  # only the deep-hierarchy half. Private methods are a large share of every
  # script in the tree, so until now the tool the project MANDATES could not
  # create a single one of them and every private method was hand-written.
  #
  # Two names, because they are two things and conflating them is the bug:
  #   functionName — the DOTTED NAME the function gets: private.config.x.y
  #   newScript    — the FILE it is written into: config
  # They differ only for private methods.
  local functionName="$name" newScript newMethod
  read -r newScript newMethod <<< "$(private.oo.method.name.resolve "$name")"

  if [ -z "$newMethod" ]; then
    error.log "no method name in '$name' — expected <script>.<method>, e.g. config.env.init"
    return 2
  fi
  console.log "
  command: $newScript
  method : $functionName
  "

  if check file $OOSH_DIR/$newScript exists fix error.log "$OOSH_DIR/$newScript does not exist"
  then
    # Ask BEFORE touching the file, and put the answers in the DOCSTRING.
    # The docstring is the single source: this.help renders it and c2
    # completes from it (docs/first-principles.md — "defined only once, in the
    # code itself"). The tool used to ship the template's placeholder
    # unchanged and write the typed text into the usage TABLE instead, so
    # every generated method was born with no metadata at all.
    local methodParameter methodDescription
    echo "Parameters for $functionName — e.g. <branch> <?force:no> — empty for none:"
    read methodParameter
    echo "One-line description of $functionName:"
    read methodDescription

    local tweakedMethod=$(cat $OOSH_DIR/templates/code/newMethod | sed 's/newScript\.newMethod/'"$functionName"'/')

    # The pattern MUST be quoted inside ${var/pattern/replacement}: unquoted,
    # a leading '#' is not matched literally and the substitution silently
    # does nothing.
    local placeholder="# parameters # method description # an example"
    local docstring="# ${methodParameter} # ${methodDescription} #"
    tweakedMethod="${tweakedMethod/"$placeholder"/"$docstring"}"

    # A method without its completion function is broken by the project's own
    # definition (docs/oosh-architecture.md, Method Structure Standard): it
    # will not tab-complete. The template emits none, so the tool must.
    # Inserted BEFORE the trailing marker, which the template carries so the
    # next insertion has somewhere to go.
    #
    # EXCEPT for a private method. It is never dispatched from the command
    # line, so a completion function for it is dead code that nothing will
    # ever call — and test/test.completion.audit skips `private*` for exactly
    # that reason. Generating one would only invite it to be hand-deleted.
    local stubs=""
    case "$functionName" in
      private.*) ;;
      *) stubs=$(private.oo.method.stubs.get "$functionName" "$methodParameter") ;;
    esac
    tweakedMethod="${tweakedMethod/"### new.method"/"$stubs
### new.method"}"

    # `replace line`, not `replace within`: the marker must match a WHOLE line
    # and exactly one of them. `replace within` matches a substring on every
    # line, and the marker text also appears in this very function's source a
    # few lines above — running the tool against `oo` itself corrupted it.
    # Edit the REAL file: a script may be a symlink (top-level c2 -> ng/c2),
    # and replace commit refuses a link rather than turn it into a copy.
    local scriptFile
    scriptFile=$(private.this.path.canonical "$OOSH_DIR/$newScript")
    if replace line "$scriptFile" "### new.method" by "$tweakedMethod" \
       && replace commit "$scriptFile"; then
      replace cleanup "$scriptFile"
      success.log "created method $functionName in $scriptFile"
    else
      # Deliberately no `replace commit` on this path. It used to run
      # unconditionally, and committing with no working copy left the script
      # with no file under its own name.
      error.log "could not insert $functionName — $scriptFile is unchanged"
      replace cleanup "$scriptFile"
      return 3
    fi
  fi

  if check file $OOSH_DIR/test/test.$newScript exists fix error.log "$OOSH_DIR/test/test.$newScript does not exist"
  then
    # Same shape as the method half: ask first, substitute in the VARIABLE,
    # insert once. The three answers used to be sed'd into the file after
    # insertion, first-match-in-the-whole-file — so a second run against the
    # same test file rewrote the FIRST test case's text instead of the new one.
    local testDescription testParameter testExpect
    echo "One-line description of the test for $functionName:"
    read testDescription
    echo "Arguments to call $functionName with in the test:"
    read testParameter
    echo "Expected \$RESULT for that call:"
    read testExpect

    local tweakedTestMethod=$(cat $OOSH_DIR/templates/code/newMethodTest | sed 's/newScript\.newMethod/'"$functionName"'/')
    tweakedTestMethod="${tweakedTestMethod/"testDescription"/"$testDescription"}"
    tweakedTestMethod="${tweakedTestMethod/"newArguments"/"$testParameter"}"
    tweakedTestMethod="${tweakedTestMethod/"new_expect"/"$testExpect"}"

    if replace line "$OOSH_DIR/test/test.$newScript" "### test.method" by "$tweakedTestMethod" \
       && replace commit "$OOSH_DIR/test/test.$newScript"; then
      replace cleanup "$OOSH_DIR/test/test.$newScript"
      success.log "created the test case for $functionName in $OOSH_DIR/test/test.$newScript"
    else
      error.log "could not insert the test case — $OOSH_DIR/test/test.$newScript is unchanged"
      replace cleanup "$OOSH_DIR/test/test.$newScript"
      return 4
    fi
  fi

  create.result 0 "$functionName created in $newScript and test/test.$newScript"
  return $(result)
}

private.oo.method.stubs.get() # <script.method> <parameters> # the completion functions a generated method must carry, one per parameter; answers on stdout
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell,
  # so RESULT would never reach the caller. Same reasoning as
  # private.oo.path.sudo.get.
  #
  # The name deliberately avoids the segment `.completion.`: c2 scans for
  # `*.completion.*` to build its candidate lists, and a helper matching that
  # shape would be offered as if it completed a parameter called `stub`.
  local fullName="$1" params="$2" token pname
  if [ -z "$params" ]; then
    # The documented empty form for a method that takes no parameters.
    printf '\n%s\n' "$fullName.completion() { :; }"
    return 0
  fi
  printf '\n'
  for token in $params; do
    pname="${token#<}"; pname="${pname%>}"; pname="${pname#\?}"; pname="${pname%%:*}"
    case "$pname" in ''|*[!A-Za-z0-9]*) continue ;; esac
    printf '%s\n' "$fullName.completion.$pname() {"
    printf '%s\n' "  # one candidate per line on stdout; \$1 is the word being completed"
    printf '%s\n' "  echo \"\""
    printf '%s\n' "}"
  done
}



oo.commit() # <?mode:force> # commits latest changes to the oosh environment and publishes them.
{
  private.this.script.load ogit ogit.branch.get
  cd $OOSH_DIR

  local branch=$( ogit.branch.get "$OOSH_DIR" )
  # ogit-exception: printed text, not an invocation
  console.log "git branch is: $branch"
  if [ "$branch" = "dev" ] || [ "$1" = "force" ]; then
    rm *\:
    # The top-level glob, not `ogit.index.add all` (-A): `*` never matches the
    # top-level dotfiles (.claude/, .cursor/, .github/, .gitignore, …) nor
    # stages top-level deletions, and -A would. Same pathspecs, same git add.
    ogit.index.add all "$OOSH_DIR" *
    ogit.commit.create "" "" "" "$OOSH_DIR"
    # ogit.remote.push keeps git's stderr quiet; say why it was refused.
    ogit.remote.push "" no "$OOSH_DIR" || error.log "$RESULT"
  else
    error.log "not on the dev branch"
    console.log "switch branch with
   
    oo mode.dev
    
    "
  fi
}

oo.update() # # updates oosh environment: pulls the latest changes through a gate (fetch + fast-forward), then heals; rc 1 when the pull was refused, RESULT names the one command to run
{
  private.this.script.load ogit ogit.branch.get
  cd "$OOSH_DIR" || return 1
  # The pull goes through private.oo.update.pull (gate, fetch, fast-forward —
  # never a merge, D5). Refused or not, every step below runs: they are the
  # heal a broken computer needs most (T-OO-UPDATE-HEALS-WHEN-REFUSED).
  local pullRc pullResult loadScripts=yes
  private.oo.update.pull "$OOSH_DIR"; pullRc=$?
  pullResult="$RESULT"
  if [ "$pullRc" -ne 0 ]; then
    error.log "oo update: not pulled — $pullResult"
  fi
  # Committed conflict markers are in the tree's own scripts: loading config,
  # user or odocker from it gives syntax errors. The steps below that load a
  # script are skipped then; oo's own steps run (T-OO-UPDATE-MARKERS-NO-LOAD).
  case "$pullResult" in
    "conflict markers"*) loadScripts=no
      warn.log "oo update: the steps that load config, user and odocker are skipped — the tree has conflict markers; run: oo heal" ;;
  esac
  # Self-heal: rewire ~/config + ~/oosh symlinks via config.init.user.
  # Catches the case where init/oosh was re-run out of band and clobbered
  # them (the macstudio-root regression). Also runs during the normal
  # install pipeline: ossh.install.continue.local calls `oo update`
  # before the state machine, so a re-install at SETUP_SERVER
  # state 99 still heals here even though the state machine no-ops.
  # Idempotent — config.init.user no-ops when symlinks are
  # already canonical. Explicit user action (NOT shell startup), so it
  # stays on the safe side of the May-8 sudo-chain anti-pattern.
  [ "$loadScripts" = yes ] && private.oo.update.heal.symlinks
  # The shell step oo heal runs for every user (owner decision 8): trust of
  # every folder under the base, the .bashrc and session files, the retired
  # drop-in, the launcher, ~/.once — private.oo.heal.shell.
  private.oo.heal.shell "$HOME" "" "$loadScripts"
  # As root: the shared odocker.env every install writes (existing hosts heal).
  # Only on an installed computer — its ~/config links to the shared config:
  # the install's own first oo update runs before the shared folders and
  # config exist (the install writes it later). A user.env is no sign: loading
  # oosh writes a starter one.
  if [ "$loadScripts" = yes ] && [ "$(id -u)" = "0" ] && [ -L "$HOME/config" ]; then
    private.this.script.load odocker private.odocker.workspaces.install \
      && private.odocker.workspaces.install >/dev/null
  fi
  # The computer's name: a guessed one that is wrong now — a container's ID, a
  # cloned image's old name — is corrected; a chosen one is kept.
  [ "$loadScripts" = yes ] && private.this.script.load config private.config.host.name.refresh \
    && private.config.host.name.refresh >/dev/null
  create.result "$pullRc" "$pullResult"
  return $(result)
}

private.oo.update.heal.symlinks() # # heal current user's ~/config + ~/oosh symlinks via config.init.user; idempotent
{
  private.this.script.load config config.init.user || return 0
  # Skip silently when developking doesn't exist yet — this is the
  # pre-install state (oo update fires very early in
  # ossh.install.continue.local, BEFORE state 31 creates
  # developking + the shared tree). The state machine will link
  # everything correctly when it gets there; healing post-install
  # drift is the heal's job, not pre-install bootstrap.
  if private.this.script.load user user.get; then
    local _devHome
    _devHome=$(user.get home developking 2>/dev/null)
    [ -z "$_devHome" ] && return 0
  fi
  config.init.user "$USER" >/dev/null \
    || warn.log "oo update: \`config init.user $USER\` reported an issue — run \`oo user.fix\` for details"
}



oo.user.fix() # <?username:$USER> # repair the ~/config + ~/oosh symlinks of this user to the canonical shared tree; idempotent
{
  # Discoverable user-facing alias for config.init.user — the canonical
  # OOSH explicit-repair primitive (config.init.user). Handles real-dir →
  # symlink conversion (preserves originals as oosh.orig.<ts> /
  # config.orig.<ts>), ownership, branch detection, dev-group membership.
  # Naming follows the OOSH `noun.verb` convention and the per-scope
  # `ossh.rights.fix` / `ossh.folder.fix` pattern.
  if ! private.this.script.load config config.init.user; then
    create.result 1 "oo user.fix: config is not loadable from $OOSH_DIR"; error.log "$RESULT"; return $(result)
  fi
  # Only <username>: config.init.user's second parameter (<sharedOosh>) is the
  # heal's, not this command's (T-OO-USER-FIX-ONE-ARG).
  config.init.user "$1"
  local userFixRc=$?
  # The launcher an empty shell finds `this` through (`env -i sh`, then `this`).
  private.oo.install.launcher >/dev/null
  return $userFixRc
}
oo.user.fix.completion.username() {
  # Source `user` on demand so completion works in fresh-shell contexts
  # where the dispatcher hasn't yet auto-loaded the script. Mirrors the
  # loader in private.oo.update.heal.symlinks and oo.user.fix.
  private.this.script.load user user.list && user.list
}

