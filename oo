private.oo.cmd.verify() # <cmd> # predicate: is <cmd> on PATH after an install attempt; the reason, including the macOS installed-but-not-on-PATH diagnostic, is in $RESULT for the caller to log
{
  # The post-condition oo.cmd's own comment used to defer to
  # ossh.prereqs.install for. Moved here from private.ossh.prereqs.verify so
  # oo.cmd can enforce it itself.
  #
  # A predicate, so NO logging in here: each caller decides the severity
  # (oo.cmd: error, ossh.prereqs.install: warn) and logs $RESULT once. That is
  # what lets the callers drop their >/dev/null 2>&1 — which was swallowing
  # the very diagnostic this function exists to deliver whenever LOG_DEVICE
  # is not a tty — and stops the reason being logged twice when it is.
  local cmd="$1"
  if [ -z "$cmd" ]; then
    create.result 1 "private.oo.cmd.verify requires <cmd>"
    return $(result)
  fi

  if command -v "$cmd" >/dev/null 2>&1; then
    create.result 0 "$cmd is on PATH"
    return $(result)
  fi

  local reason="$cmd is still not on PATH after install (OOSH_PM='${OOSH_PM:-<unset>}' OSTYPE='$OSTYPE' brew=$(command -v brew 2>/dev/null || echo none))"
  case "$OSTYPE" in
    darwin*)
      # The failure mode this diagnostic exists for: brew installed it into a
      # prefix that is not on this shell's PATH.
      local brewPath
      for brewPath in /opt/homebrew/bin /usr/local/bin; do
        [ -x "$brewPath/$cmd" ] && reason="$reason; $brewPath/$cmd exists but is not on PATH"
      done
      ;;
  esac
  create.result 1 "$reason"
  return $(result)
}

oo.cmd() # <cmd> <?packageName> # checks if <cmd> is installed and installs it with: $pmPrefix $OOSH_PM <?packageName>, then verifies it landed
{
    # Argument order is the chaining protocol: consume our own arguments, then
    # hand the token the NEXT command starts at to create.result's third
    # parameter. This used to be a bare `RETURN=$1` as the function's LAST
    # statement, which pinned the exit status at 0 (a variable assignment
    # always succeeds) and set RETURN="" — which never matches, so this.start
    # shifted through every remaining argument, hit "force stop" and exited,
    # silently swallowing the rest of a chained line.
    local current="$1"
    shift
    local package="$1"
    if [ -n "$package" ]; then
      shift
    else
      # One-argument form: the command IS the package name.
      package="$current"
    fi

    if [ -z "$current" ]; then
      create.result 1 "oo.cmd requires <cmd>" "$1"
      error.log "$RESULT"
      return $(result)
    fi

    # Non-interactive prefix for the apt family. Debian's debconf defaults to
    # the Dialog frontend: `apt-get -y install vim` pulls tzdata, tzdata's
    # postinst asks "Geographic area:" over the debconf pipe, and in an
    # unattended install nobody is there to answer — it blocks in
    # anon_pipe_read forever, with no output and no timeout. Observed
    # 2026-09-21 in a naked ubuntu:24.04: SETUP_SERVER -> test.suite core 1 ->
    # test.ossh.certificates.update -> state.machine.delete -> oo cmd vim ->
    # wedged, last line printed "no vim".
    #
    # `-y` does NOT cover this: -y answers apt's own "Do you want to
    # continue?", while debconf is a separate questioner running inside the
    # maintainer script. needrestart (default on Ubuntu 22.04+ servers) is a
    # third one again, with its own whiptail UI that ignores DEBIAN_FRONTEND;
    # SUSPEND=1 skips it, where MODE=a would auto-restart the user's daemons.
    #
    # It MUST be `env` and not a shell-assignment prefix: $SUDO is "sudo ",
    # and sudo's env_reset drops whatever the CALLING shell exported, so
    # `DEBIAN_FRONTEND=x $SUDO apt-get ...` would never reach apt. `sudo -E`
    # and `sudo VAR=val cmd` are both refused by default sudoers (no SETENV
    # tag); `sudo env VAR=val cmd` is just a command with arguments, so it
    # always works.
    #
    # brew has its own questioner: Homebrew 6 made ask mode the default for
    # `brew install`, which prints "Do you want to proceed? [y/n]" on a TTY
    # whenever the plan pulls in dependencies. A virgin Sequoia VM waited on it
    # forever at `brew install bash`. HOMEBREW_NO_ASK=1 is the opt-out;
    # NONINTERACTIVE=1 is not — only Homebrew's bootstrap install.sh reads it.
    # The same `env` rule applies: the root branch below hops through
    # `sudo -u $SUDO_USER`, whose env_reset would strip a plain prefix.
    #
    # Gated on the PM string the same way ossh.cmd gates its apt-get
    # update preflight — each PM's variables mean nothing to the others.
    # Deliberately NOT folded into $OOSH_PM: that table exists four times
    # (private.check.all.pm in oo, oosh_pm_detect in init/oosh, private.config.pm.command.get in config, ossh.pm.discover in ossh), T-PM-TABLES-AGREE pins
    # them equal, and `config save` persists $OOSH_PM verbatim into
    # ~/config/oosh.env where a change would outlive this file. The prefix
    # table itself is private.oo.pm.env.get; the whole prefix — sudo decision
    # plus env — is private.oo.pm.install.prefix.get, shared with
    # oo.prereqs.install. Asked where an install happens: a tool that is there
    # needs no package manager, not even its discovery (T-OO-CMD-REFRESH-ONCE).
    local pmPrefix

    # Already present — the idempotency every caller relies on. The package
    # manager must NOT be invoked here. One exception, an UPGRADE: BusyBox
    # ships a wget stub with too few options for our use. It is an install
    # like any other — it goes through the refusal and the package-manager
    # check below (T-CMD-NO-INSTALL-BUSYBOX), and since the stub works it is
    # advisory: rc 0 when it cannot be upgraded.
    local missing="missing" missingRc=1
    if command -v "$current" >/dev/null 2>&1; then
      if [ "$current" = wget ] && wget --help 2>&1 | grep -q "BusyBox"; then
        console.log "BusyBox wget detected — full wget is wanted"
        missing="is the BusyBox stub, not upgraded" missingRc=0
      else
        create.result 0 "$current already present" "$1"
        return $(result)
      fi
    fi

    # A test run installs nothing: test.suite exports OOSH_NO_INSTALL for every
    # test file, and this is the one door every install goes through — state
    # (oo cmd vim), config and ossh.prereqs.install ran the package manager
    # and sudo on the machine the tests ran on (T-CMD-NO-INSTALL). A test
    # that IS about installing lifts it with `env -u OOSH_NO_INSTALL`.
    if [ -n "$OOSH_NO_INSTALL" ]; then
      create.result "$missingRc" "$current $missing — a test run installs nothing" "$1"
      warn.log "$RESULT"
      return $(result)
    fi

    if [ -z "$OOSH_PM" ]; then
      console.log "no PM found...checking"
      oo.pm.discover
    fi
    if [ -z "$OOSH_PM" ]; then
      create.result "$missingRc" "$current $missing — no package manager found to install it" "$1"
      [ "$missingRc" = 0 ] && warn.log "$RESULT" || error.log "$RESULT"
      return $(result)
    fi

    pmPrefix=$(private.oo.pm.install.prefix.get)
    local rc=0
    case $current in
      eamd|oosh|once)
        # These delegate to `once`, which is not part of this tree. Fail
        # loudly naming what is missing rather than emitting "command not
        # found" and reporting success.
        if ! command -v once >/dev/null 2>&1; then
          create.result 1 "$current needs \`once\`, which is not installed in this tree" "$1"
          error.log "$RESULT"
          return $(result)
        fi
        case $current in
          eamd)
            once load $current tla/EAMD/UcpComponentSupport/1.0.0/src/sh/eamd || rc=$?
            # path-exception: session scope — `once load` puts the loaded class
            # in $ONCE_LOAD_DIR and it has to be callable in this shell.
            export PATH="$PATH:$ONCE_LOAD_DIR"
            hash -d eamd    #clears the command cache for eamd
            ;;
          oosh)
            once load $current com/ceruleanCircle/EAM/1_infrastructure/OOSH/1.0.0/src/sh/oosh || rc=$?
            ;;
          once)
            once load once.sh tla/EAM/layer1/Thinglish/Once/latestServer/src/sh/once.sh || rc=$?
            ;;
        esac
        ;;
      brew)
        case "$OSTYPE" in
          darwin*)
            console.log "Installing Homebrew..."
            NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || rc=$?
            local brewPath
            for brewPath in /opt/homebrew/bin /usr/local/bin; do
              if [ -x "$brewPath/brew" ]; then
                # path-exception: Homebrew has just been installed in this
                # process; brew must be callable before the shell restarts.
                export PATH="$brewPath:$PATH"
                break
              fi
            done
            oo.pm.discover
            ;;
          *)
            create.result 1 "brew is only available on macOS (OSTYPE='$OSTYPE')" "$1"
            warn.log "$RESULT"
            return $(result)
            ;;
        esac
        ;;
      mkcert)
        # Delegates to once.su.mkcert.install, a function defined nowhere in
        # this tree.
        if ! this.functionExists once.su.mkcert.install; then
          create.result 1 "$current needs the function once.su.mkcert.install, which is not defined in this tree" "$1"
          error.log "$RESULT"
          return $(result)
        fi
        once.su.mkcert.install || rc=$?
        ;;
      update)
        # Refreshes the PM cache; there is no command to verify afterwards.
        # Once per process chain, for apt: OOSH_APT_UPDATED, the gate init/oosh
        # exports after its own refresh and this exports after one here — only
        # AFTER it worked, so a failed refresh is retried — and the `oo cmd`
        # children of an install do not refresh again. config's exclusion list
        # never persists it. There is no second marker: OOSH_PM_UPDATED was a
        # plain global set BEFORE the refresh ran, and `config save` (every
        # OOSH_* of the saving shell) wrote it into the shared oosh.env, so
        # every later shell answered "already updated" for good
        # (T-OO-CMD-REFRESH-MARKER). dnf and yum are refreshed here only on an
        # explicit `oo cmd update` — they fetch metadata on install — so each
        # such request runs.
        local refresh
        if command -v apt-get >/dev/null 2>&1; then
          if [ -n "$OOSH_APT_UPDATED" ]; then
            create.result 0 "package lists already refreshed in this process chain (OOSH_APT_UPDATED)" "$1"
            return $(result)
          fi
          refresh="$SUDO apt-get update"
        elif command -v dnf >/dev/null 2>&1; then
          refresh="$SUDO dnf makecache"
        elif command -v yum >/dev/null 2>&1; then
          refresh="$SUDO yum makecache"
        else
          create.result 1 "no known package manager found for update" "$1"
          warn.log "$RESULT"
          return $(result)
        fi
        console.log "refreshing the package lists: $refresh"
        if $refresh; then
          case "$refresh" in (*apt-get*) export OOSH_APT_UPDATED=1 ;; esac
          create.result 0 "package manager cache refreshed with: $refresh" "$1"
        else
          create.result 1 "package manager cache refresh failed: $refresh" "$1"
          error.log "$RESULT"
        fi
        return $(result)
        ;;
      errno)
        oo cmd python3 python3 || rc=$?
        ;;
      *)
        # Sudo or not — none for brew (Homebrew refuses root; root under sudo
        # hops back to $SUDO_USER), none for root, else $SUDO — and the
        # non-interactive env: private.oo.pm.install.prefix.get, the one
        # answer oo.prereqs.install uses too (T-OO-PM-INSTALL-PREFIX-GET).
        # A fresh apt image has empty package lists: the first real install
        # refreshes them, through the update arm above, once. dnf, yum and
        # apk fetch their metadata on install; they never got a refresh here.
        case "$OOSH_PM" in
          apt-get*)
            oo.cmd update >/dev/null 2>&1 || warn.log "the package lists were not refreshed: $RESULT"
            ;;
        esac
        $pmPrefix $OOSH_PM $package || rc=$?
        ;;
    esac

    if [ "$rc" -ne 0 ]; then
      create.result 1 "installing $package for $current failed (package manager exit $rc)" "$1"
      error.log "$RESULT"
      return $(result)
    fi

    # Post-condition: the package manager reporting success is not the same as
    # the command being usable. Verify, and fail loudly if it did not land.
    if private.oo.cmd.verify "$current"; then
      create.result 0 "$current installed from $package" "$1"
    else
      # $RESULT is the predicate's reason; it names the tool and the PM.
      create.result 1 "$package installed without error but $RESULT" "$1"
      error.log "$RESULT"
    fi
    return $(result)
}

oo.cmd.completion.packageName() {
