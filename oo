oo.mode.base.get() # # returns the OOSH components base directory
{
  private.this.script.load ogit ogit.branch.get
  # Strategy 1: Explicit config (set by oo mode.base.set or oo mode.setup)
  if [ -n "$OOSH_COMPONENTS_DIR" ] && [ -d "$OOSH_COMPONENTS_DIR" ]; then
    echo "$OOSH_COMPONENTS_DIR"
    return 0
  fi

  # OOSH_DIR is the ~/oosh symlink (docs/config.md § The anchor rule). Strategies 3 and 4 do path
  # arithmetic (dirname/basename) on it, which needs the PHYSICAL worktree —
  # `dirname ~/oosh` is just $HOME. Resolve once, here.
  local ooshDir
  ooshDir=$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null || echo "$OOSH_DIR")

  # Strategy 2: Use git worktree list to find main worktree, derive base as its parent
  if [ -d "$ooshDir/.git" ] || [ -f "$ooshDir/.git" ]; then
    local mainWt
    mainWt=$(ogit.worktree.list "$ooshDir" | head -1 | sed 's/^worktree //')
    if [ -n "$mainWt" ]; then
      local mainBase
      mainBase=$(basename "$mainWt")
      if [ "$mainBase" = "main" ]; then
        echo "$(dirname "$mainWt")"
        return 0
      fi
    fi
  fi

  # Strategy 3: Check if the worktree is inside a worktree (.git file with gitdir: pointer)
  if [ -f "$ooshDir/.git" ]; then
    local parent
    parent=$(dirname "$ooshDir")
    if [ -d "$parent/main" ]; then
      echo "$parent"
      return 0
    fi
  fi

  # Strategy 4: Fall back to dirname if sibling "main" directory exists
  if [ -n "$ooshDir" ]; then
    local parent
    parent=$(dirname "$ooshDir")
    local selfName
    selfName=$(basename "$ooshDir")
    if [ "$selfName" = "main" ] && [ -d "$ooshDir/.git" ]; then
      echo "$parent"
      return 0
    fi
    if [ -d "$parent/main" ] && [ "$parent/main" != "$ooshDir" ]; then
      echo "$parent"
      return 0
    fi
  fi

  # No worktree structure detected
  return 1
}

oo.mode.base.set() # <path> # set the OOSH components base directory FOR THIS PROCESS ONLY — it is not persisted; see `oo mode.setup` for a durable layout
{
  local path="$1"
  if [ -z "$path" ]; then
    error.log "Usage: oo mode.base.set <path>"
    return 1
  fi
  if [ ! -d "$path" ]; then
    error.log "Directory not found: $path"
    return 1
  fi
  export OOSH_COMPONENTS_DIR="$path"
  # `config save oosh OOSH` persists it with the other OOSH_* values:
  # private.config.variable.export.line writes a value under $HOME as
  # "$HOME/…", so oo.mode.base.get strategy 1 finds it in the next shell too.
  # (config used to leave this one variable out of every save; it does not now.)
  #
  # A base that needs no variable at all is the canonical layout —
  # `oo mode.setup` — which oo.mode.base.get resolves through strategies 2/3/4.
  config save oosh OOSH
  console.log "Base set to: $path (this process only — see oo mode.setup)"
}

# ogit-exception: docstring text, not an invocation
oo.mode.list() # # list available branches with git status
{
  private.this.script.load ogit ogit.branch.get
  local base
  base=$(oo.mode.base.get) || {
    error.log "No worktree structure detected. Run 'oo mode.setup' to convert your install."
    return 1
  }
  # The folders are private.ogit.base.folders.list's: repositories only, no
  # symlinks, no dot-names (T-BASE-FOLDERS-ONE-LOOP).
  # READ-ONLY: this method MUST NOT mutate global git config.
  # safe.directory setup belongs in explicit repair primitives
  # (oo.user.fix → config.init.user) per docs/repair-toolkit.md.
  local dir
  while IFS= read -r dir; do
    local statusOut="" statusErr=""
    statusOut=$(ogit.status.show short "$dir" | head -1)
    if [ -z "$statusOut" ]; then
      # ogit.raw, not ogit.status.show: the probe needs git's STDERR (the
      # "dubious ownership" refusal text), which ogit.status.show discards.
      statusErr=$(ogit.raw "$dir" status --short --branch 2>&1 >/dev/null)
      if echo "$statusErr" | grep -q "dubious ownership"; then
        statusOut="(unsafe ownership — run 'oo user.fix')"
      fi
    fi
    printf "  %-20s %s\n" "${dir##*/}" "$statusOut"
  done < <(private.ogit.base.folders.list "$base")
}

oo.branch.list() # <?source:all> # list available branches from worktrees, local git, and/or remote
{
  private.this.script.load ogit ogit.branch.get
  local source="${1:-all}"

  # Validate source parameter
  case "$source" in
    all|local|remote) ;;
    *)
      error.log "Invalid source: '$source' (use: all, local, remote)"
      create.result 1 "invalid source"
      return $(result)
      ;;
  esac

  local branches=""

  # Worktree directories (if worktree structure exists)
  if [ "$source" = "all" ] || [ "$source" = "local" ]; then
    local base
    base=$(oo.mode.base.get 2>/dev/null)
    if [ $? -eq 0 ] && [ -d "$base" ]; then
      # The folder names, by the one loop that owns the rules.
      local folders
      folders=$(private.ogit.base.folders.list "$base" | sed 's|.*/||')
      [ -n "$folders" ] && branches="${branches}${folders}"$'\n'
    fi

    # Local git branches
    local localBranches
    localBranches=$(ogit.branch.list local "${OOSH_DIR:-$HOME/oosh}")
    if [ -n "$localBranches" ]; then
      branches="${branches}${localBranches}"$'\n'
    fi
  fi

  # Remote branches (with fetch)
  if [ "$source" = "all" ] || [ "$source" = "remote" ]; then
    ogit.remote.fetch no "${OOSH_DIR:-$HOME/oosh}"
    local remoteBranches
    remoteBranches=$(ogit.branch.list remote "${OOSH_DIR:-$HOME/oosh}")
    if [ -n "$remoteBranches" ]; then
      branches="${branches}${remoteBranches}"$'\n'
    fi
  fi

  # Deduplicate and sort
  local branchResult
  branchResult=$(echo "$branches" | grep -v '^$' | sort -u)

  if [ -n "$branchResult" ]; then
    echo "$branchResult"
    create.result 0 "$branchResult"
  else
    create.result 1 "no branches found"
  fi

  return $(result)
}
oo.branch.list.completion.source() {
  echo "all"
  echo "local"
  echo "remote"
}

oo.mode() # <?branch> # switch oosh to a branch folder under the base (cloned when missing), or show current mode
{
  private.this.script.load ogit ogit.branch.get
  # The components base (…/Once.sh) — whatever the layout (clones since the
  # 2026-09-23 design, linked worktrees on hosts not yet converted).
  local componentsBase
  componentsBase=$(oo.mode.base.get)
  local hasBase=$?
  local OOSH_LINK="$HOME/oosh"
  local branch="$1"

  local current_target
  current_target=$(readlink "$OOSH_LINK" 2>/dev/null)

  if [ -z "$branch" ]; then
    # No argument: show the current mode
    # Resolve from symlink to show the actual target, not a stale OOSH_DIR.
    # `private.this.path.canonical` is the portable resolver —
    # macOS BSD readlink predating 12.3 lacks `-f`, on those systems plain
    # `readlink -f` silently returns nothing and we'd report the symlink
    # path verbatim instead of its target.
    local actualPath
    actualPath=$(private.this.path.canonical "$OOSH_LINK" 2>/dev/null || echo "$OOSH_DIR")
    local currentName
    currentName=$(basename "$actualPath")
    echo "Mode: $currentName"
    echo "Path: $actualPath"
    if [ -n "$componentsBase" ]; then
      echo "Base: $componentsBase"
    else
      echo "Base: (none — run 'oo mode.setup' to enable branch switching)"
    fi
    if [ -d "$actualPath" ]; then
      ogit.status.show short "$actualPath"
    fi
    # Consistency check: git branch vs folder name (only under a components base)
    if [ -n "$componentsBase" ]; then
      local gitBranch
      gitBranch=$(ogit.branch.get "$actualPath")
      if [ -n "$gitBranch" ] && [ "$gitBranch" != "$currentName" ]; then
        echo "Git branch is '$gitBranch' but the branch folder is '$currentName'"
        echo "  To fix: oo mode.align"
      fi
    fi
    return 0
  fi

  # Same-branch fast-path: if the requested branch matches the currently
  # resolved symlink target, just show the current state and return. Saves
  # the symlink-rm/shim-install/ln/config-save cascade further down in this method and
  # side-steps any downstream `oo update` / git-hook chain that might
  # prompt for HTTPS credentials in unattended contexts (containers, CI
  # runners). Observed live in platform-test ubuntu container where
  # `oo mode dev` (already on dev) hung on `Username for 'https://github.com':`.
  local currentName=""
  if [ -n "$current_target" ]; then
    currentName=$(basename "$current_target")
  fi
  if [ -n "$currentName" ] && [ "$branch" = "$currentName" ]; then
    echo "Mode: $currentName (already current)"
    echo "Path: $(private.this.path.canonical "$OOSH_LINK" 2>/dev/null || echo "$OOSH_DIR")"
    return 0
  fi

  # Switching needs a components base (branch folders side by side)
  if [ $hasBase -ne 0 ] || [ -z "$componentsBase" ]; then
    error.log "No components base detected. Run 'oo mode.setup' to convert your install."
    return 1
  fi

  local target_dir="$componentsBase/$branch"

  if [ ! -d "$target_dir" ]; then
    console.log "Directory '$branch' not found. Checking remote branches..."
    # Strict match: exact branch name (origin/<branch>), not regex/substring.
    # The previous `grep -i "${branch//\./.*}"` matched partial names —
    # `oo mode test` would silently select `origin/test/ish` (alphabetical
    # first) and try to wedge a worktree at <base>/test for a
    # branch actually named `test/ish`. Worse, when that worktree-add
    # silently failed but the rest of oo.mode ran anyway, OOSH_DIR was
    # exported to a non-existent path, breaking every subsequent c2
    # completion lookup (c2:296 `script="$OOSH_DIR/ng/c2"` → EPERM).
    # `grep -Fx` = fixed-string, full-line match; the user gets a clean
    # error and can retype the full name (e.g. `oo mode test/ish`).
    local remote_branch
    # ogit.branch.list remote answers bare names (origin/ stripped, HEAD
    # dropped); put the prefix back so the match stays the anchored one.
    remote_branch=$(ogit.branch.list remote "$current_target" \
      | sed 's|^|origin/|' \
      | grep -Fx "origin/$branch" | head -1)
    if [ -z "$remote_branch" ]; then
      error.log "No remote branch named '$branch' found (use full name, e.g. \`oo mode test/macos\`)"
      create.result 1 "branch not found"
      return $(result)
    fi
    # The clone layout (2026-09-23 design): every folder under the base is
    # its own repository. private.oo.branch.clone.ensure owns the decision
    # (the helper install state 31 uses; never clones over a folder it did
    # not make). Cloned from origin's URL, then group-shared and trusted.
    console.log "Cloning $remote_branch into $target_dir..."
    local originUrl
    originUrl=$(ogit.remote.url.get origin "$current_target")
    if [ -z "$originUrl" ]; then
      error.log "clone failed for $remote_branch → $target_dir — no origin URL in ${current_target:-$OOSH_DIR}"
      create.result 1 "clone failed"
      return $(result)
    fi
    if ! private.oo.branch.clone.ensure "$originUrl" "${remote_branch#origin/}" "$target_dir" >/dev/null; then
      error.log "clone failed for $remote_branch → $target_dir — $RESULT"
      create.result 1 "clone failed"
      return $(result)
    fi
    # Post-condition: target_dir MUST exist before we touch any symlink.
    # Even when the clone reports success, defensive check.
    if [ ! -d "$target_dir" ]; then
      error.log "Clone reported success but $target_dir is missing"
      create.result 1 "clone post-condition violated"
      return $(result)
    fi
    # Shared (.git and the working tree) and trusted — ogit folder.finish.
    ogit.folder.finish "$target_dir" >/dev/null || warn.log "oo mode: $RESULT"
  fi

  # Switch symlink
  if [ -L "$OOSH_LINK" ]; then
    rm "$OOSH_LINK"
  elif [ -d "$OOSH_LINK" ]; then
    error.log "$OOSH_LINK is a real directory, not a symlink. Run 'oo mode.setup' first."
    return 1
  fi
  # Check if oo() shim is loaded BEFORE installing (install sources it in subprocess)
  local wasShimFunction=false
  declare -F oo >/dev/null 2>&1 && wasShimFunction=true

  # Install shim BEFORE updating OOSH_DIR — the template lives in the current branch
  private.oo.install.shim 2>/dev/null

  ln -s "$target_dir" "$OOSH_LINK"

  # Replace old branch name in ALL PATH entries (handles /root/<branch>, /home/shared/.../<branch>, etc.)
  # The old branch name comes from what ~/oosh POINTED AT before the ln -s above
  # ($current_target, captured at the top of this method) — NOT from $OOSH_DIR,
  # which is the constant ~/oosh and would yield the literal name "oosh". That
  # would rewrite every "/oosh:" segment of PATH into "/<branch>:" and break it.
  # A PATH that already holds ~/oosh has no branch name in it, so this is then
  # correctly a no-op; it still repairs a PATH holding a physical worktree path
  # (a legacy shell, or install state 31 which puts one there on purpose).
  # path-exception: a REPAIR of a PATH that already holds a branch worktree
  # path, not a build — `oo mode` moves the ~/oosh symlink, and a legacy shell
  # (or install state 31) can be holding the physical path of the old branch.
  local oldBranchName=""
  [ -n "$current_target" ] && oldBranchName=$(basename "$current_target")
  if [ -n "$oldBranchName" ] && [ "$oldBranchName" != "$branch" ]; then
    # path-exception: a REPAIR, see the note above this if.
    PATH=$(echo "$PATH" | sed "s|/${oldBranchName}:|/${branch}:|g;s|/${oldBranchName}$|/${branch}|")
  fi
  hash -r  # Clear command hash table so bash finds commands in new path

  # OOSH_DIR is NOT reassigned: it is the constant ~/oosh, and the `ln -s`
  # above already repointed it at $target_dir. Only OOSH_MODE changes.
  export OOSH_MODE="$branch"
  config save oosh OOSH 2>/dev/null
  # OOSH_MODE is per user: it lives in this user's own user.session.env.
  config session.save 2>/dev/null

  # Write env pickup file so the shim can update the parent shell next time:
  # the same PATH repair, emitted only when the old branch differs
  # (private.oo.mode.env.write; oo heal writes it without one).
  private.oo.mode.env.write "$branch" "$oldBranchName" >/dev/null

  echo "Switched to: $branch ($target_dir)"

  # If running as a script (not the oo() function), OOSH_DIR won't propagate
  if [ "$wasShimFunction" = "false" ]; then
    echo ""
    echo "Note: To update your current shell, run:"
    echo "  source ~/.config/oosh/oo-func.bash"
  fi
}

# ogit-exception: docstring text, not an invocation
oo.mode.align() # # align git branch to match the current worktree directory name
{
  private.this.script.load ogit ogit.branch.get
  local OOSH_LINK="$HOME/oosh"
  local actualPath
  # private.this.path.canonical — portable resolver; see comment
  # at oo.mode for the macOS BSD-readlink rationale.
  actualPath=$(private.this.path.canonical "$OOSH_LINK" 2>/dev/null || echo "$OOSH_DIR")
  local currentName
  currentName=$(basename "$actualPath")

  local gitBranch
  gitBranch=$(ogit.branch.get "$actualPath")

  if [ -z "$gitBranch" ]; then
    # ogit-exception: printed text, not an invocation
    error.log "Cannot determine current git branch in $actualPath"
    create.result 1 "no git branch"
    return $(result)
  fi

  if [ "$gitBranch" = "$currentName" ]; then
    # ogit-exception: printed text, not an invocation
    console.log "Already aligned: git branch '$gitBranch' matches directory '$currentName'"
    create.result 0 "already aligned"
    return $(result)
  fi

  warn.log "Git branch is '$gitBranch' but directory is '$currentName'"
  console.log "Checking out '$currentName'..."

  if ogit.branch.checkout "$currentName" "$actualPath"; then
    # ogit-exception: printed text, not an invocation
    success.log "Aligned: git branch now matches directory '$currentName'"
    create.result 0 "$currentName"
  else
    error.log "Failed to checkout '$currentName' — branch may not exist locally"
    console.log "  Try: oo checkout $currentName"
    create.result 1 "checkout failed"
  fi

  return $(result)
}

private.oo.install.shim() {
  local sourceDir="${1:-$OOSH_DIR}"
  local shimSrc="$sourceDir/templates/user/ooShim"
  local shimDst="$HOME/.config/oosh/oo-func.bash"

  if [ ! -f "$shimSrc" ]; then
    return 0  # shim template not available, skip silently
  fi

  mkdir -p "$HOME/.config/oosh"
  cp "$shimSrc" "$shimDst"

  # Source it now so oo() function is available immediately
  source "$shimDst"

  # No .bashrc line here: templates/user/bashrcTemplate sources the shim, and
  # private.user.bashrc.install is the one .bashrc writer. An appended line made
  # the next oo update overwrite the .bashrc, and the next oo mode append again.

  echo "  Shim:    $shimDst (oo function loaded — mode/use update current shell)"
}

oo.mode.setup() # <?worktree_base> # convert a plain clone to the canonical main/ + <branch>/ clone layout and point ~/oosh at it
{
  # It builds ONE layout, and it is not this function's own. The layout half is
  # private.oo.shared.tree.from.local — validated, idempotent, git-fallback'd,
  # and the same builder install state 31 uses, so there is exactly one
  # definition of "canonical" in the tree.
  #
  # What this used to do instead: build <base>/dev with NO main/, which defeats
  # oo.mode.base.get strategies 2, 3 and 4 (they all key on a directory named
  # `main`), and bridge the gap by exporting OOSH_COMPONENTS_DIR for strategy 1
  # — a variable that config did not save when this was written (it does now,
  # as a $HOME-relative value). So the layout worked in this process and was
  # undetectable in the next shell: the command whose own failure message tells
  # you to run it produced a layout that re-created that failure. Measured in
  # docs/research/2026-09-16-item7-oo-mode-setup.md § 3.
  #
  # And it moved the live tree with four unguarded `mv`s. Those are gone: the
  # helper copies, verifies, and only then consumes the source.
  local OOSH_LINK="$HOME/oosh"
  local currentDir
  # private.this.path.canonical — portable resolver.
  currentDir=$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null || echo "$OOSH_DIR")

  # 1. Validate the argument. Nothing did, so a typo'd base silently became the
  #    place the live tree was moved to.
  local base
  if [ -n "$1" ]; then
    base="$1"
    shift
    if [ ! -d "$base" ]; then
      error.log "oo.mode.setup: <worktree_base> is not a directory: $base"
      create.result 2 "no such directory: $base" "$1"
      return $(result)
    fi
    if [ ! -w "$base" ]; then
      error.log "oo.mode.setup: <worktree_base> is not writable: $base"
      create.result 2 "not writable: $base" "$1"
      return $(result)
    fi
  else
    base="$(dirname "$currentDir")"
  fi
  local targetDir

  # 2. Already set up. This comes BEFORE branch detection on purpose: if the
  #    layout is canonical there is nothing to do, and demanding a detectable
  #    branch first would turn a no-op into a refusal.
  #    The old guard accepted ANY subdirectory holding a .git, so a
  #    half-converted tree read as done. The canonical shape is main/ with a
  #    real .git DIRECTORY — main/ is a repository, and so is every branch
  #    directory beside it (the clone layout; older installs: linked worktrees).
  #    Done is a property of the LAYOUT, not of the branch checked out in
  #    ~/oosh's folder: keyed on the branch, a finished layout with hotfix
  #    checked out in prod/ cloned hotfix/ and then consumed prod/ — rm -rf
  #    with its work (T-SETUP-LAYOUT-EXISTS). The one folder beside main/ that
  #    is NOT done is the plain source tree a failed run left (T-SETUP-SAFE-SWAP):
  #    that falls through and finishes the layout.
  private.this.script.load ogit ogit.branch.get
  if private.oo.layout.folder.check "$currentDir" "$base" >/dev/null; then
    echo "Worktree structure already exists at: $base"
    create.result 0 "already set up at $base" "$1"
    return $(result)
  fi

  # 3. A main/ that is not a repository is a refusal, not something to copy over.
  if [ -e "$base/main" ] && { [ "$(private.ogit.folder.shape "$base/main")" = missing ] || ! ogit.repo.check "$base/main"; }; then
    # ogit-exception: printed text, not an invocation
    error.log "oo.mode.setup: $base/main exists but is not a git repository — move it aside first"
    create.result 3 "$base/main is not a repository" "$1"
    return $(result)
  fi

  # 4. The branch this clone is on names the worktree directory.
  local currentBranch
  currentBranch=$(ogit.branch.get "$currentDir")
  if [ -z "$currentBranch" ]; then
    # ogit-exception: printed text, not an invocation
    error.log "oo.mode.setup: cannot detect a branch in $currentDir — is it a git clone?"
    create.result 1 "no branch detected in $currentDir" "$1"
    return $(result)
  fi
  targetDir="$base/$currentBranch"

  # 4b. The source is consumed at the end: it must pass ogit's gate FIRST, so a
  #     refusal leaves everything as it was — nothing built, ~/oosh unchanged
  #     (T-SETUP-SOURCE-GATE). Its tags are measured against main/ when a
  #     half-made run left one, else against itself (main/ will be its copy).
  local gateMain="$currentDir"
  [ -e "$base/main" ] && gateMain="$base/main"
  if [ "$targetDir" != "$currentDir" ] && ! private.oo.source.consume.gate "$currentDir" "$gateMain" >/dev/null; then
    error.log "oo.mode.setup: $RESULT — nothing was changed"
    create.result 7 "$RESULT" "$1"
    return $(result)
  fi

  echo "Setting up worktree structure..."
  echo "  Source: $currentDir (branch: $currentBranch)"
  echo "  Base:   $base"

  # 5. Build it. `yes` consumes the source LAST, once main/ and the branch
  #    folder stand (a source that IS the branch folder is kept as its clone):
  #    a failed branch clone leaves the source — and ~/oosh — as they were.
  if ! ( cd "$base" && private.oo.shared.tree.from.local "$currentDir" "$currentBranch" yes ); then
    error.log "oo.mode.setup: could not build the canonical layout in $base — $currentDir is untouched unless the log above says otherwise"
    create.result 4 "layout build failed in $base" "$1"
    return $(result)
  fi

  # 6. THE acceptance criterion, and nothing checked it before: can
  #    oo.mode.base.get find this base in a shell that has no
  #    OOSH_COMPONENTS_DIR? That is every shell but this one. Checked BEFORE
  #    the symlink moves, so a failure leaves a canonical tree and a working
  #    ~/oosh rather than a broken pair.
  local verifiedBase
  verifiedBase=$( unset OOSH_COMPONENTS_DIR; OOSH_DIR="$targetDir"; oo.mode.base.get 2>/dev/null )
  if [ "$verifiedBase" != "$base" ]; then
    error.log "oo.mode.setup: the layout in $base is not detectable without OOSH_COMPONENTS_DIR (got '${verifiedBase:-nothing}') — ~/oosh left where it was"
    create.result 5 "layout not detectable: ${verifiedBase:-nothing}" "$1"
    return $(result)
  fi

  # 7. Repoint ~/oosh. The source is gone by now, so the path is free when it
  #    WAS the source. A real directory that was not the source is a refusal —
  #    the old code skipped its own `rm` in that case and let `ln -s` create
  #    the link INSIDE the directory.
  if [ -L "$OOSH_LINK" ]; then
    rm "$OOSH_LINK" || {
      error.log "oo.mode.setup: could not remove the old $OOSH_LINK symlink"
      create.result 6 "could not remove $OOSH_LINK" "$1"
      return $(result)
    }
  elif [ -e "$OOSH_LINK" ]; then
    error.log "oo.mode.setup: $OOSH_LINK exists and is not a symlink — move it aside, then re-run. The canonical layout is already in $base"
    create.result 6 "$OOSH_LINK is not a symlink" "$1"
    return $(result)
  fi
  if ! ln -s "$targetDir" "$OOSH_LINK"; then
    error.log "oo.mode.setup: could not link $OOSH_LINK -> $targetDir. The canonical layout is in $base"
    create.result 6 "could not create $OOSH_LINK" "$1"
    return $(result)
  fi

  # OOSH_DIR stays the constant ~/oosh — the `ln -s` above made it valid again.
  # OOSH_MODE means the branch this host is on (T7).
  export OOSH_MODE="$currentBranch"
  # Exported for this process; this method does not save it. A later
  # `config save oosh OOSH` would write it ($HOME-relative), but with a
  # canonical layout it is not needed: oo.mode.base.get resolves through
  # strategies 2/3/4, which is what step 6 just proved.
  export OOSH_COMPONENTS_DIR="$base"

  # Install ooShim so 'oo mode' always works regardless of active branch
  private.oo.install.shim "$targetDir"

  echo ""
  echo "Worktree structure created:"
  echo "  Base:    $base"
  echo "  Repo:    $base/main"
  echo "  Branch:  $targetDir"
  echo "  Symlink: $OOSH_LINK → $targetDir"
  echo ""
  echo "Use 'oo mode <branch>' to switch branches."
  create.result 0 "worktree structure at $base" "$1"
  return $(result)
}

private.oo.completion.worktree.branches() # # echo branch names whose worktree dirs sit under oo.mode.base.get; safe inside c2 completion subprocesses (no create.result side-effects)
{
  # Single source of truth for the four `*.completion.branch` /
  # `*.completion.baseBranch` functions below.
  #
  # Why a private helper instead of calling oo.branch.list directly: that
  # function uses create.result (oo.branch.list), which corrupts c2's completion
  # subprocess output on macOS — root never sees branches; admin sees them
  # only on the 3rd TAB via a c2 menu quirk. Same regression class as
  # 7e54c91 fixed for oo.checkout.completion.version, and 70009fa /
  # 8b14c78 fixed for the four call sites below. Memory:
  # [project-create-result-breaks-c2-completion].
  #
  # Why filesystem iteration instead of `git worktree list --porcelain`:
  # the T-MODE-5 fixture (and any future independent-`git init` sibling
  # layout) doesn't share a .git, so `git worktree list` would return
  # only the current dir — see T-MODE-5 commentary in test/test.oo.
  local base
  base=$(oo.mode.base.get 2>/dev/null)
  [ $? -eq 0 ] && [ -d "$base" ] || return 0
  # The folder names, by the one loop that owns the rules (T-BASE-FOLDERS-ONE-LOOP).
  private.this.script.load ogit ogit.branch.get
  private.ogit.base.folders.list "$base" | sed 's|.*/||' | sort -u
}

oo.mode.completion.branch() {
  # Delegates to private.oo.completion.worktree.branches (single source
  # of truth for worktree-branch enumeration across the four completion
  # functions; safe inside c2 completion subprocesses).
  private.oo.completion.worktree.branches
}

oo.checkout() # <version> # clone a remote branch as its own folder under the components base (prefix stripped, slashes as dots); an existing folder is aligned, never pulled
{
  private.this.script.load ogit ogit.branch.get
  local version="$1"

  if [ -z "$version" ]; then
    error.log "Usage: oo checkout <version>"
    create.result 1 "missing version"
    return $(result)
  fi

  # Derive directory name: strip prefixes, convert slashes to dots
  local dirName="$version"
  dirName="${dirName#test/}"
  dirName="${dirName#feature/}"
  dirName="${dirName#bugfix/}"
  dirName=$(echo "$dirName" | tr '/' '.')

  # ONE layout (2026-09-23 design): every branch is its own clone under the
  # components base. No base means no layout to add to — fail loud with the
  # fix instead of dropping a clone beside whatever $OOSH_DIR happens to be
  # (the old plain-clone mode).
  local base
  base=$(oo.mode.base.get 2>/dev/null)
  if [ -z "$base" ] || [ ! -d "$base" ]; then
    create.result 1 "no components base — run oo mode.setup"
    error.log "$RESULT"
    return $(result)
  fi
  local oosh="${OOSH_DIR:-$HOME/oosh}"
  local targetDir="$base/$dirName"

  if [ -d "$targetDir" ]; then
    # Already exists — check if git branch matches directory name
    local currentGitBranch
    currentGitBranch=$(ogit.branch.get "$targetDir")

    if [ -n "$currentGitBranch" ] && [ "$currentGitBranch" != "$dirName" ]; then
      # Misaligned: git branch doesn't match directory name — fix it
      # ogit-exception: printed text, not an invocation
      info.log "Aligning git branch to directory name: $dirName"
      if ogit.branch.checkout "$dirName" "$targetDir"; then
        success.log "Aligned branch to '$dirName' in $targetDir"
        create.result 0 "$targetDir"
        return $(result)
      else
        error.log "Failed to checkout branch '$dirName' in $targetDir"
        create.result 1 "checkout failed"
        return $(result)
      fi
    fi

    # Already aligned and present — nothing to do. Pulling latest is NOT
    # `oo.checkout`'s job; merging branches lives in `promote` /
    # `oo stage` (the canonical promotion pipeline) and pulling lives
    # in `oo update` (the explicit user-invoked refresh). Conflating
    # them here meant `oo checkout dev` (with dev/ already present)
    # silently fetched + merged origin/dev — surprising for a command
    # whose name says "checkout", not "pull".
    success.log "Folder '$dirName' already present at $targetDir — run \`oo update\` to refresh"
    create.result 0 "$targetDir"
    return $(result)
  fi

  local repoUrl
  repoUrl=$(ogit.remote.url.get origin "$oosh")
  if [ -z "$repoUrl" ]; then
    # ogit-exception: printed text, not an invocation
    error.log "Cannot determine git remote URL from $oosh"
    create.result 1 "no remote URL"
    return $(result)
  fi

  # Fetch first: a branch pushed since the last fetch becomes known here, and
  # the local fallback of oo.checkout.completion.version sees it next time.
  ogit.remote.fetch no "$oosh" >/dev/null || warn.log "oo checkout: $RESULT"
  info.log "Cloning $version into $targetDir"
  # private.oo.branch.clone.ensure: the clone decision install state 31 and
  # oo mode use — ogit repo.clone removes only a half-made dir it created
  # itself, so no rm -rf here.
  if ! private.oo.branch.clone.ensure "$repoUrl" "$version" "$targetDir" >/dev/null; then
    error.log "clone failed for '$version' — $RESULT"
    create.result 1 "clone failed"
    return $(result)
  fi
  # Each folder is its own repository: group-shared — .git AND the working
  # tree — and trusted by the caller (T-CHECKOUT-WORKTREE-SHARED).
  ogit.folder.finish "$targetDir" >/dev/null || warn.log "oo checkout: $RESULT"
  success.log "Cloned $version to $targetDir"
  console.log "  Use 'oo mode $dirName' to switch to it"
  create.result 0 "$targetDir"
  return $(result)
}
oo.checkout.completion.version() {
  # Try the canonical source first — `git ls-remote` reflects branches that
  # may have been pushed since the last fetch. When origin is unreachable
  # (offline laptop, VM without the 2cuGitHub SSH alias configured, expired
  # token, no network), ls-remote fails silently with `2>/dev/null` and the
  # caller would see no completions — c2's fallback then leaks the literal
  # `addDefaultValue` placeholder from PARAM_version. Fall back to the
  # locally-cached remote-tracking refs (`refs/remotes/origin/*`) so the user
  # at least sees the branches they last fetched. Linux with a reachable
  # origin gets the same output as before (out is non-empty → printed
  # directly). Pure-additive change for the unreachable case.
  private.this.script.load ogit ogit.branch.get
  local oosh="${OOSH_DIR:-$HOME/oosh}"
  local out
  out=$(ogit.remote.branch.list origin "$oosh")
  if [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    ogit.branch.list remote "$oosh"
  fi
}

oo.use() # <branch> <command> # run a command from a specific branch without switching
{
  local branch="$1"
  shift
  local command="$1"
  shift

  if [ -z "$branch" ] || [ -z "$command" ]; then
    error.log "Usage: oo use <branch> <command> [args...]"
    create.result 1 "missing branch or command"
    return $(result)
  fi

  # Try worktree base first, fall back to sibling directories
  local branchDir
  local base
  base=$(oo.mode.base.get 2>/dev/null)
  if [ $? -eq 0 ] && [ -d "$base/$branch" ]; then
    branchDir="$base/$branch"
  elif [ -d "$(dirname "${OOSH_DIR:-$HOME/oosh}")/$branch" ]; then
    branchDir="$(dirname "${OOSH_DIR:-$HOME/oosh}")/$branch"
  else
    error.log "Branch directory '$branch' not found"
    create.result 1 "branch not found"
    return $(result)
  fi

  if [ ! -f "$branchDir/$command" ]; then
    error.log "Command '$command' not found in branch '$branch'"
    create.result 1 "command not found"
    return $(result)
  fi

  # Export logging stubs so target branch bootstrap can call them.
  # Older branches call important.log/console.log during this.init before
  # log is fully loaded — without these exports, "command not found" errors occur.
  # IMPORTANT: Do NOT export info.log — it's used as bootstrap guard at the top of log.
  # If info.log exists, log skips sourcing this, which breaks the target branch.
  { export -f console.log important.log warn.log error.log \
             debug.log success.log silent.log stop.log seq.puml.log; } 2>/dev/null

  # Execute from target branch with overridden OOSH_DIR
  # oosh-dir-exception: oo.use runs ONE command from another branch WITHOUT
  # switching — a scoped child-process override; there is no symlink alternative
  # by design (the symlink is what `oo mode` moves, and `use` must not move it).
  OOSH_DIR="$branchDir" "$branchDir/$command" "$@"
}
oo.use.completion.branch() {
  # Delegates to private.oo.completion.worktree.branches — see its
  # docstring for the create.result / worktree-list rationale.
  private.oo.completion.worktree.branches
}
oo.use.completion.command() {
  # In completion context, $1 is $cur (word being completed), not the branch.
  # The branch value was already parsed into PARAM_branch in current.method.env.
  source "$CONFIG_PATH/current.method.env" 2>/dev/null
  local branch="$PARAM_branch"
  local branchDir="$(oo.mode.base.get)/$branch"
  if [ -d "$branchDir" ]; then
    ls "$branchDir" 2>/dev/null | grep -v '^\.' | grep -v '\.md$'
  fi
}

oo.branches.check() # <featureBranchPrefix> <baseBranch> <startCommit> # show state of branches
{
  private.this.script.load ogit ogit.branch.get
  local featureBranchPrefix=$1
  shift
  local R=remotes/origin
  local baseBranch=$R/$1
  shift
  local startCommit=$1

  if [ -z $featureBranchPrefix ]; then
    error.log "No featureBranchPrefix given"
    exit 1
  fi
  if [ -z $baseBranch ]; then
    error.log "No baseBranch given"
    exit 1
  fi
  if [ -z $startCommit ]; then
    error.log "No startCommit given"
    exit 1
  fi

  # config
  padding1=".............................................................................."
  padding2="                                          "

  console.log
  console.log "==========================================================================="
  console.log "Update local repository (fetch --prune to remove all deleted branches)"
  # This method works on the repository of the CURRENT directory (it always
  # did: bare git), so every ogit call below names "$PWD".
  ogit.remote.fetch yes "$PWD"
  console.log "First commit for branches:"
  console.log `ogit.commit.show $startCommit "$PWD"`

  console.log
  console.log "==========================================================================="
  console.log "Check all relevant branches:"
  # ogit.branch.find answers short names (origin/x); `git branch -a` said
  # remotes/origin/x, which is what $R and the loop below expect.
  branches=`ogit.branch.find $startCommit "$PWD" | sed 's;^;remotes/;' | grep "^$R/" | grep -v $R/HEAD`
  for bl in $branches
  do
      b=`echo $bl | sed "s;$R/;;"`
      case "$b" in
      dev/neom|test/neom|master|dev|main|prod/WODA)
          ;;
      N1-104-embed-viewport-in-woda-metaverse-app|N1-356-create-persistent-structr-implementation-of-all-persistent-classes|feature/N1-424-cavrnus-component-styling|feature/neom/broken-startup-good-structrObjectLoad)
          console.log
          console.log ONHOLD: $b
          ;;
      *)
          NAME=`ogit.commit.log.show $bl 1 "%cn <%ce>" "$PWD"`
          AGO=`ogit.commit.log.show $bl 1 "%cr" "$PWD"`
          console.log
          console.log $b
          console.log "--> https://bitbucket.org/donges/eamd.ucp/branch/$b"
          console.log "    "`printf "%s%s - %s\n" "$NAME" "${padding2:${#NAME}}" "${AGO}"`

          # old, not deleted
          LONGAGO=`echo $AGO | grep -v day | grep -v hour | grep -v minute | grep -v second`
          if [[ -n "$LONGAGO" ]]; then
              error.log "Branch is old (Last commit ${LONGAGO})."
          fi

          # check name: ${featureBranchPrefix}
          BRANCH_START=${b::`echo -n ${featureBranchPrefix} | wc -c`}
          if [[ "${BRANCH_START}" != ${featureBranchPrefix} ]]; then
              error.log "Branch name must start with ${featureBranchPrefix} (not: ${BRANCH_START}...)."
          fi

          # check name: N1-<no>
          JIRA_NUMBER=`echo -n $b | grep -e "N1-[0-9][0-9][0-9]"`
          if [[ -z ${JIRA_NUMBER} ]]; then
              error.log "Branch name must contain a JIRA issue number."
          fi

          # merged and not deleted?
          MY_COMMIT=`ogit.commit.log.show $bl 1 "%H" "$PWD"`
          COMMON_COMMIT=`ogit.merge.base.get $bl $baseBranch "$PWD"`
          if [[ "$MY_COMMIT" == "$COMMON_COMMIT" ]]; then
              error.log "Branch is merged but not deleted."
          else
              console.log "Here are the changes compared to branch: $R/dev/neom"
              console.log "$(ogit.diff.show $R/dev/neom $bl stat "$PWD")"
          fi

          ;;
      esac
  done
}

oo.state() # # initializes the state machine or shows the current state if already initialized
{
  local machine=SETUP_SERVER

  if state machine.exists ${machine}; then
    state of ${machine} list all
    source $CONFIG_PATH/current.state.machine.env
    if [ $state -lt 4 ]; then
      state machine.start - oo
    fi
  else
    debug.log "initalize ${machine}"
    private.init.state.machine ${machine}
  fi

  # Advance state machine to completion (handles both first-install and re-runs)
  # Each state.next invokes the corresponding private.check.* guard function
  source $CONFIG_PATH/current.state.machine.env
  local maxIterations=30
  local i=0
  while [ $state -lt 99 ] && [ $i -lt $maxIterations ]; do
    local prevState=$state
    state next SETUP_SERVER
    source $CONFIG_PATH/current.state.machine.env
    if [ $state -le $prevState ]; then
      error.log "State machine stuck at [$state] — aborting advancement"
      # Propagate non-zero so init/oosh's `[ $rc -eq 0 ]` gate sees the
      # failure and the post-state-machine non-root invoker block at
      # init/oosh correctly skips. Previously this `break` left
      # the function returning 0, so init/oosh ran post-machine work on top
      # of a broken install.
      return 1
    fi
    ((i++))
  done

  if [ $state -ge 99 ] && [ -n "$LOG_INSTALL" ]; then
    log.install.finish
  fi
}

private.init.state.machine() # <machine> # creates the state machine
{
  local machine=$1
  console.log "initialising state machine: ${machine}"
  
  source $OOSH_DIR/state

  # The states of the install lane, in one place (oo heal creates the machine too).
  private.oo.state.machine.create "${machine}"

  state.next
  state.machine.start oo
  state.next # remote.install.started
  state.next # root.rights
  state.list

  state next # root.shared.dev.folder.created
  # Full advancement to [99] is handled by oo.state()'s advancement loop
}

private.check.remote.install.started() {
  if [ -n "$SSH_CONFIG_FROM_REMOTE" ]; then
    success.log "
    
    Remote installation started from  : $SSH_CONFIG_FROM_REMOTE
    Remote name used for this machine±: $SSH_CONFIG_NAME_USED_FOR_LOCAL
    "
    create.result 0 12 $1
  else
    warn.log "SSH_CONFIG_FROM_REMOTE not set. No remote installation detected"
    success.log "remote.install.started: continue with local install"
    create.result 0 12 $1
  fi
  return $(result)
}

private.check.local.install.started() {
  if [ -f "$OOSH_DIR/this" ]; then
    create.result 0 "$OOSH_DIR/this exists"
  else
    create.result 1 "$OOSH_DIR/this does not exist"
  fi
}

private.check.priviledges.checked() # # RESULT will be the follow up state
{
  if [ "$USER" = "root" ]; then
    create.result 0 "30"
  else
    create.result 1 "user privilidges"
    if private.test.sudo.priviledges; then
      # RESULT will be the follow up state: [30]="root.rights""
      create.result 0 "30"
    else
      # RESULT will be the follow up state: [20]="user.rights.only"
      create.result 0 "20"
    fi
  fi

}

private.test.sudo.priviledges() {
  if [ -f ~/.sudo_as_admin_successful ]; then
    create.result 0 "sudo privilidges active"
    return $(result)
  else
    if [ -n "$SUDO" ]; then
      $SUDO touch ~/.sudo_as_admin_successful
      if [ -f ~/.sudo_as_admin_successful ]; then
          rm ~/.sudo_as_admin_successful
          create.result 0 "sudo privilidges by password"
          return $(result)
      fi
    fi
  fi

  if [ "$HOME" = "/root" ];then
          create.result 0 "sudo privilidges not required because USER is ROOT"
          return $(result)
  fi
  
  create.result 1 "no sudo privilidges"
  return $(result)
}

private.check.user.rights.only() {
  source state
  state.check SETUP_SERVER priviledges.checked oo
  if [ "$RESULT" = "20" ]; then
    create.result 0 "20"
    return $(result)
  fi
  if [ "$RESULT" = "30" ]; then
    create.result 0 "30"
    return $(result)
  fi
  create.result 1 "Something went wrong! \n$RESULT"
  return $(result)
}

private.check.user.installation.done() {
  if [ -d $HOME/oosh ]; then
    create.result 0 "$HOME/oosh exists"
  else
    create.result 1 "$HOME/oosh does not exist"
  fi
}

private.check.user.mode.release() {
  # A released install is one sitting on the PROD branch. This used to compare
  # against the literal "released", a mode word that only ever appeared because
  # promote stamped it in — one line after checking the tree back out to dev.
  # So it described a developer-box event, not this host, and on a genuinely
  # released box (where `oo mode prod` had set the branch name) the check failed
  # anyway. OOSH_MODE is the branch a host is ON; see docs/config.md § T7.
  if [ "$OOSH_MODE" = "prod" ]; then
    create.result 0 "OOSH_MODE=$OOSH_MODE"
  else
    create.result 1 "not on the prod branch — a released install runs prod. OOSH_MODE=$OOSH_MODE"
  fi
  return $(result)
}

private.check.user.mode.dev() {
  if [ "$OOSH_MODE" = "dev" ]; then
    create.result 0 "OOSH_MODE=$OOSH_MODE"
  else
    create.result 1 "not in mode: dev!   OOSH_MODE=$OOSH_MODE"
    console.log "
    
    you can switch there manualy with
    
    oo mode.dev
    "
  fi
  return $(result)
}

private.check.root.rights() {
  source state
  state.check SETUP_SERVER priviledges.checked oo
  if [ "$RESULT" = "20" ]; then
    create.result 1 "21"
    return $(result)
  fi
  if [ "$RESULT" = "30" ]; then
    create.result 0 "30"
    return $(result)
  fi
  create.result 1 "Something went wrong! \n$RESULT"
  return $(result)
}


private.oo.shared.tree.from.local() # <sourceDir> <branchName> <?consumeSource:no> # produce the canonical `main/ + <branchName>/` clone layout in $(pwd) from a local clone: <branchName>/ is an independent clone of main/ (origin re-pointed at main/'s origin, group-shared). Idempotent — skips when main/ and <branchName>/ exist; a main/ alone gets its branch folder. With <consumeSource> = yes the source is removed last, once main/ and <branchName>/ stand — never when it IS the branch folder (kept as the clone); what `oo mode.setup` needs. Used by state-31's fallback path when the GitHub SSH clone fails so the resulting layout matches what a successful network clone would have produced (oo.mode.base.get strategy 4 then succeeds and `oo mode <branch>` works).
{
  private.this.script.load ogit ogit.branch.get
  local src="$1"
  local branch="$2"
  local consume="${3:-no}"
  if [ -z "$src" ] || [ -z "$branch" ]; then
    error.log "private.oo.shared.tree.from.local: usage <sourceDir> <branchName>"
    return 1
  fi
  if [ ! -d "$src" ]; then
    error.log "private.oo.shared.tree.from.local: source dir not found: $src"
    return 1
  fi

  # Idempotent fast-path: main/ and the branch folder present → nothing to do.
  # main/ alone is a run whose branch clone failed: go on and make it.
  if [ -d "main" ] && { [ "$branch" = "main" ] || [ -d "$branch/.git" ]; }; then
    important.log "private.oo.shared.tree.from.local: main/ and $branch/ already present in $(pwd) — skipping"
    return 0
  fi

  # 1. Copy source → main/ (kept when a half-made run left it). The .git/
  #    from the source comes along, so main/ is a self-contained clone.
  [ -d "main" ] || cp -a "$src" "main" \
    || { error.log "private.oo.shared.tree.from.local: copy $src → main/ failed"; return 1; }

  # 2. Make sure main/'s active branch is 'main'. Local sources are typically
  #    cloned with `-b dev` so their HEAD points at dev. Create local 'main'
  #    from origin/main if available. If origin/main isn't fetched either,
  #    warn but proceed — oo.mode.base.get strategy 4 just checks dir
  #    existence so the layout is still usable.
  if ! ogit.branch.check main main; then
    if ogit.branch.check origin/main main; then
      ogit.branch.reset main origin/main main \
        || warn.log "private.oo.shared.tree.from.local: could not create local main from origin/main"
    else
      warn.log "private.oo.shared.tree.from.local: no origin/main ref in source — main/ stays on '$branch' branch (oo.mode.base.get sibling-dir check still satisfied)"
    fi
  else
    ogit.branch.checkout main main >/dev/null \
      || warn.log "private.oo.shared.tree.from.local: could not checkout main in main/"
  fi

  # 3. The active branch as an INDEPENDENT CLONE beside main/ (clone layout,
  #    2026-09-23 design). Skip when the active branch IS main — main/ already
  #    serves that role. Cloned from main/ (offline-safe), so main/ must hold
  #    a LOCAL <branch>: a clone from a local path sees only its local heads.
  #    When only origin/<branch> exists (the source was a clone of another
  #    branch), create it from there first — the fallback the old
  #    `worktree add … "$branch" || … "origin/$branch"` pair had — and put
  #    main/ back on main. Then origin is re-pointed at main/'s origin so the
  #    clone pulls from GitHub like every folder, and the clone is shared.
  if [ "$branch" != "main" ]; then
    local here originUrl
    here=$(private.this.path.canonical "$PWD")
    if ! ogit.branch.check "refs/heads/$branch" main; then
      ogit.branch.reset "$branch" "origin/$branch" main >/dev/null \
        || { error.log "private.oo.shared.tree.from.local: neither $branch nor origin/$branch exists in main/ — $RESULT"; return 1; }
      ogit.branch.checkout main main >/dev/null \
        || warn.log "private.oo.shared.tree.from.local: could not put main/ back on main (no local main — see step 2)"
    fi
    originUrl=$(ogit.remote.url.get origin main)
    private.oo.branch.clone.ensure "$here/main" "$branch" "$here/$branch" >/dev/null \
      || { error.log "private.oo.shared.tree.from.local: clone of $branch from main/ failed — $RESULT"; return 1; }
    if [ -n "$originUrl" ]; then
      ogit.remote.url.set "$originUrl" origin "$here/$branch" >/dev/null \
        || { error.log "private.oo.shared.tree.from.local: $RESULT"; return 1; }
    fi
    # Not fatal: state 31 finishes every folder right after (fail-loud there),
    # and oo mode.setup's user owns the clone it just made.
    ogit.folder.finish "$here/$branch" >/dev/null \
      || warn.log "private.oo.shared.tree.from.local: $RESULT"
  fi

  # 4. Optionally consume the source (`oo mode.setup`) — LAST, once main/ and
  #    <branch>/ both stand: it is the tree ~/oosh points at. Removing it
  #    before the branch clone left ~/oosh dangling when that clone failed
  #    (T-SETUP-SAFE-SWAP). A source that IS the branch folder was kept by
  #    private.oo.branch.clone.ensure as the clone: nothing to remove.
  #    Never a folder of the layout itself (a prod/ with another branch
  #    checked out is one — private.oo.layout.folder.check), and never a tree
  #    that fails ogit's gate: a stash, an unpushed commit, a branch or tag of
  #    its own would go with it.
  if [ "$consume" = "yes" ] \
     && [ "$(private.this.path.canonical "$src")" != "$(private.this.path.canonical "$PWD")/$branch" ]; then
    if [ ! -d "main/.git" ] || ! ogit.repo.check main; then
      error.log "private.oo.shared.tree.from.local: refusing to remove $src — main/ is not a usable repository"
      return 1
    fi
    if private.oo.layout.folder.check "$src" "$PWD" no >/dev/null; then
      error.log "private.oo.shared.tree.from.local: refusing to remove $src — it is a folder of the layout in $PWD"
      return 1
    fi
    if ! private.oo.source.consume.gate "$src" main >/dev/null; then
      error.log "private.oo.shared.tree.from.local: $RESULT — the layout stands, the source is kept"
      return 1
    fi
    rm -rf "$src" \
      || { error.log "private.oo.shared.tree.from.local: could not remove the consumed source $src"; return 1; }
    important.log "private.oo.shared.tree.from.local: source consumed: $src"
  fi

  important.log "private.oo.shared.tree.from.local: canonical clone layout produced in $(pwd) (main/ + ${branch}/)"
  return 0
}


private.oo.user.shared.symlinks.ensure() # <userHome> <sharedConfigPath> <onceShBase> <ooshBranch> # ensure $userHome/config and $userHome/oosh are symlinks to the shared tree; idempotent; preserves originals as .orig.<ts>
{
  local userHome="$1"
  local sharedConfigPath="$2"
  local onceShBase="$3"
  local ooshBranch="$4"
  if [ -z "$userHome" ] || [ -z "$sharedConfigPath" ] \
     || [ -z "$onceShBase" ] || [ -z "$ooshBranch" ]; then
    create.result 1 "private.oo.user.shared.symlinks.ensure requires <userHome> <sharedConfigPath> <onceShBase> <ooshBranch>"
    error.log "$RESULT"
    return $(result)
  fi

  # Delegate the actual symlink-with-backup work to the shared primitive
  # private.this.symlink.with.backup. Same `.orig.<timestamp>`
  # collision-proof convention as config.init.user,
  # now driven by one canonical implementation. Each call fails loud on
  # any mv/ln failure — see the primitive's docstring.
  local _ts
  _ts=$(private.this.orig.stamp.get "$userHome" config oosh)
  private.this.symlink.with.backup "$userHome/config" "$sharedConfigPath"       "$_ts" || return $(result)
  private.this.symlink.with.backup "$userHome/oosh"   "$onceShBase/$ooshBranch" "$_ts" || return $(result)

  # Verify post-condition for fail-loud testing.
  if [ -L "$userHome/config" ] && [ -L "$userHome/oosh" ]; then
    create.result 0 "symlinks ensured for $userHome"
  else
    create.result 1 "failed to ensure symlinks at $userHome (config=$([ -L "$userHome/config" ] && echo L || echo D), oosh=$([ -L "$userHome/oosh" ] && echo L || echo D))"
    error.log "$RESULT"
  fi
  return $(result)
}

private.oo.install.branch.get() # # print the install branch: $OOSH_BRANCH, else the branch $HOME/oosh is on, else main — the one rule behind install state 31
{
  local branch="${OOSH_BRANCH}"
  if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
    # Detect from the initial $HOME/oosh clone before it gets symlinked.
    private.this.script.load ogit ogit.branch.get
    branch=$(ogit.branch.get "$HOME/oosh")
  fi
  if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
    branch=main
  fi
  echo "$branch"
}


private.oo.path.sudo.get() # <path> <?mode:interactive> # print the sudo prefix needed to write <path> (its nearest existing parent while it does not exist yet), or nothing when the caller can already write there or is root; mode quiet prints sudo -n, which never asks for a password — the one privilege rule behind private.oo.dropin.remove and private.oo.install.launcher
{
  # Builds on the framework contract: `this` sets $SUDO to "" for root and
  # "sudo " otherwise, so root never gets a prefix and a fixture under $HOME
  # never needs one. Builtins only (no `id`, no `dirname`), so it still
  # answers correctly when PATH is unusable. quiet: `oo update` must never
  # stop at a password prompt — the drop-in cleanup used plain `sudo ` and
  # the launcher a writability walk of its own (T-OO-PRIVILEGE-QUIET).
  local path="$1" mode="${2:-interactive}"
  private.oo.path.writable.is "$path" && return 0
  [ -n "$SUDO" ] || return 0
  case "$mode" in
    quiet) printf '%s' "sudo -n " ;;
    *)     printf '%s' "$SUDO" ;;
  esac
}



private.check.root.shared.dev.folder.created() {
  private.this.script.load ogit ogit.branch.get
  #check.debug.level 6
  #source user
  user get home
  if [ -z "$USER" ]; then
    warn.log "no user set"
    USER=$(user get name)
    console.log "fixed user: $USER"
  fi
  
  if [ ! "$USER" = "root" ]; then
    # Non-root user: check if shared infrastructure was already created by root
    local dir="$( user get basehome $USER )"
    console.log "dir=$dir"

    if [ -d "$dir/shared/EAMD.ucp" ]; then
      success.log "Shared infrastructure already created by root at $dir/shared"
      create.result 0 "root.shared.dev.folder.created" "$1"
      return $(result)
    else
      error.log "Shared infrastructure not found at $dir/shared — run root install first (ossh install <host>)"
      create.result 1 "shared folder not found at $dir/shared"
      return $(result)
    fi
  fi
  
  #set -x


  # ─── state 31 [1/5: developking.created] ────────────────────────────────
  # Ensure the `dev` group exists BEFORE any user.group.add invocation.
  # On minimal images (RHEL-family / busybox-based) the group is not
  # auto-created by `user.group.add` — without this explicit ensure, all
  # subsequent group memberships silently fail and private.ensure.sharedTree
  # (in this) early-returns ("dev group not present — skipping").
  # private.this.group.create handles cross-platform: tries groupadd first
  # (Alma/Debian/etc), falls back to addgroup (Alpine/busybox), then to a
  # last-resort /etc/group append. Idempotent — no-op when group exists.
  private.this.group.create dev

  # Create developking and put them in the dev group. user.create
  # auto-invokes user.oosh.install, which (after f515903 + 4069475) gives
  # developking the same OOSH experience as any other user — bashrc with
  # completion, ~/oosh + ~/config symlinks, ed25519 keypair, WODA aliases.
  local devHome="$( user get home developking )"
  if [ -z "$devHome" ]; then
    user create developking
    user group.add dev developking
    devHome="$( user get home developking )"
  fi
  if [ -z "$devHome" ] || [ ! -d "$devHome" ]; then
    error.log "state 31 [1/5: developking.created]: 'user create developking' failed — $devHome (basehome) does not exist"
    create.result 1 "state 31 step 1/5 failed: developking not created"
    return $(result)
  fi
  # echo  "absolutePath of \"$devHome\..\"..."
  # this.absolutePath "$devHome/.."
  # debug.log "absolutePath of \"$devHome\..\": $RESULT"
  local dir="$( user get basehome developking )"
  console.log "dir=$dir"
  
  #return 2
  
  OOSH_BRANCH=$(private.oo.install.branch.get)

  local onceShBase="$dir/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"

  # Idempotent fast-path: succeed silently only if the FULL state-31
  # invariant holds — shared dev tree exists AND developking has working
  # OOSH symlinks. Without the developking check, a previous install that
  # halted between the shared-tree mkdir and the user.oosh.install retry
  # below would short-circuit on the next pass and never finalize
  # developking — leaving the boss-as-developking experience broken.
  if [ -d "$onceShBase/${OOSH_BRANCH}" ] \
     && [ -L "$devHome/oosh" ] \
     && [ -L "$devHome/config" ] \
     && [ -L "$HOME/config" ] \
     && [ -L "$HOME/oosh" ]; then
    success.log "$onceShBase/${OOSH_BRANCH} exists; developking AND root have config+oosh symlinks"
    create.result 0 "root.shared.dev.folder.created" $1
  else
    console.log "creating shared infrastructure"

    # ─── state 31 [2/5: shared.tree.created] ──────────────────────────────
    $SUDO user group.add dev $USER
    if ! private.oo.shared.base.ensure "$dir" developking >/dev/null; then
      error.log "state 31 [2/5: shared.tree.created]: $RESULT"
      create.result 1 "state 31 step 2/5 failed: shared tree not created"
      return $(result)
    fi

    cd "$dir/developking/"
    oo.cmd wget
    oo.cmd tree
    #tree -a -L 2 /root/

    # Note: keypair + WODA Host entries + ~/.ssh structure are owned by
    # ossh.install.continue.local's user.init which runs
    # before this state-31 check. No fallback needed here — modern pipeline
    # guarantees ~/.ssh exists by the time we get here.

    # ─── state 31 [3/5: dev.keys.deployed] ────────────────────────────────
    # Try web download first; fall back to runner-bundled template. Step
    # fails loud if neither produces ~developking/.ssh/id_rsa.
    export DEVELOPKING_SOURCE_SERVER=test.wo-da.de

    wget -r -np --cut-dirs=9 -R "index.html*" "https://${DEVELOPKING_SOURCE_SERVER}/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/NewUserStuff/scripts/templates/developking.ssh"
    RETURN_VALUE=$?
    if ! [ "$RETURN_VALUE" = "0" ]; then
      warn.log "Could not download from ${DEVELOPKING_SOURCE_SERVER} — using local templates"
      if [ -d "$OOSH_DIR/templates/user/developking.ssh" ]; then
        cp -r "$OOSH_DIR/templates/user/developking.ssh" "$dir/developking/.ssh"
        chown -R developking:dev "$dir/developking/.ssh" # recursive-exception: the developking .ssh tree oosh just copied from its template
      else
        warn.log "developking.ssh templates not found — continuing without them"
      fi
    else
      chown -R developking:dev "$dir/developking/${DEVELOPKING_SOURCE_SERVER}/developking.ssh" # recursive-exception: the developking .ssh tree oosh just downloaded
      mv "$dir/developking/${DEVELOPKING_SOURCE_SERVER}/developking.ssh" "$dir/developking/.ssh"
      rm -rf "$dir/developking/${DEVELOPKING_SOURCE_SERVER}"
    fi
    if [ ! -f "$dir/developking/.ssh/id_rsa" ]; then
      error.log "state 31 [3/5: dev.keys.deployed]: $dir/developking/.ssh/id_rsa missing after wget+template fallback"
      create.result 1 "state 31 step 3/5 failed: developking deploy keys not deployed"
      return $(result)
    fi

    # ─── state 31 [4/5: shared.config.seeded] ─────────────────────────────
    # SNAPSHOT FIRST. Everything below this line writes to the installing
    # user's ~/.ssh — the mkdir, the Host github.com block, the ssh-keyscan
    # into known_hosts, and the developking copy into ids/. That is why the
    # backup ossh.install.continue.local used to take AFTER `oo state` and
    # call "ssh.original" was nothing of the kind: by then this state had
    # already run. The state that does the work owns the snapshot.
    #
    # Guarded on the directory existing: a fresh machine has nothing to
    # protect, and `user ssh.backup` correctly refuses an absent ~/.ssh.
    # Where it DOES exist, a failure halts state 31 — a backup that silently
    # did not happen is worse than a stopped install.
    if [ -d "$HOME/.ssh" ]; then
      if ! user ssh.backup pre-install >/dev/null; then
        error.log "state 31 [4/5]: could not archive $HOME/.ssh before writing to it"
        create.result 1 "state 31 step 4/5 failed: pre-install ssh snapshot"
        return $(result)
      fi
    fi

    # Ensure root's ~/.ssh exists before any write. On Alpine 3.19's
    # naked_alpine_3_19 image the sshd config permits root login without
    # an authorized_keys file, so /root/.ssh is never auto-created on
    # first SSH session. private.install.dev.configs (and the heredoc
    # fallback below) then fail with "No such file or directory" on every
    # >> redirect to ~/.ssh/config. Also touched by ossh.config.save.last
    # (~/.ssh/known_hosts in the same flow). Idempotent on
    # Alma/Ubuntu where /root/.ssh already exists from authorized_keys.
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"

    # private.install.dev.configs writes Host github.com to root's
    # ~/.ssh/config via the canonical ossh.config.create + ossh.config.save.last
    # primitive (Phase A.8). On some platforms (verified on Alma 9 post-install)
    # that path historically silently failed to land the block — the function
    # reported success but the block didn't appear in the file. Below:
    # invoke the helper, then verify the post-condition; if missing, fall
    # through to a direct-write heredoc as a different-mechanism fail-safe
    # (ossh.config.create writes via $CONFIG_PATH/result.txt + cat — this
    # heredoc writes straight to ~/.ssh/config, bypassing any result.txt
    # permission/disk issue that might have caused the silent failure).
    # IdentityFile uses the portable `~` form (Phase A.5 onward).
    private.install.dev.configs
    touch "$HOME/.ssh/config"
    if ! ossh config.get github.com "$HOME/.ssh/config" >/dev/null 2>&1; then
      warn.log "state 31 [4/5]: private.install.dev.configs did not land Host github.com in $HOME/.ssh/config — falling through to direct-write heredoc"
      cat >>"$HOME/.ssh/config" <<'EOF'

Host github.com
 HostName github.com
 User git
 Port 22
 IdentityFile ~/.ssh/ids/ssh.developking/id_rsa
 IdentitiesOnly yes
EOF
    fi
    if ! ossh config.get github.com "$HOME/.ssh/config" >/dev/null 2>&1; then
      error.log "state 31 [4/5: shared.config.seeded]: Host github.com still missing from $HOME/.ssh/config after both private.install.dev.configs and heredoc fallback — write permissions on $HOME/.ssh/config?"
      ls -la "$HOME/.ssh/" >&2 2>/dev/null || true
      create.result 1 "state 31 step 4/5 failed: Host github.com alias not written"
      return $(result)
    fi


    cd "$dir/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"
    # ─── state 31 [5/5: dev.repo.cloned] — main/ and the branch as their OWN
    # clones (clone layout, 2026-09-23 design). Defence in depth: an older
    # (unpatched) caller may send a polluted $OOSH_BRANCH like
    # "heads/origin/dev" — strip it before it names a branch and a folder.
    OOSH_BRANCH="${OOSH_BRANCH#refs/heads/}"
    OOSH_BRANCH="${OOSH_BRANCH#refs/remotes/origin/}"
    OOSH_BRANCH="${OOSH_BRANCH#heads/origin/}"
    OOSH_BRANCH="${OOSH_BRANCH#origin/}"
    # With an install source only main/ is cloned; the branch folder is a
    # copy of the source.
    local treeBranch="${OOSH_BRANCH}" installSource=""
    if [ -n "${OOSH_INSTALL_SOURCE}" ] && [ -d "${OOSH_INSTALL_SOURCE}" ]; then
      installSource="${OOSH_INSTALL_SOURCE}"; treeBranch=main
    fi
    important.log "state 31 [5/5: dev.repo.cloned]: main/ and ${treeBranch}/ as clones in $onceShBase"
    # Re-runs: an existing clone is kept and a missing folder is made, so a
    # half-made first run heals; the local copy of ~/oosh runs only when main/
    # could not be cloned — see private.oo.shared.tree.ensure.
    if ! private.oo.shared.tree.ensure git@github.com:Cerulean-Circle-GmbH/once.sh.git "$onceShBase" "$treeBranch"; then
      error.log "state 31 [5/5: dev.repo.cloned]: $RESULT"
      create.result 1 "state 31 step 5/5 failed: $RESULT"
      return $(result)
    fi
    if [ -n "$installSource" ]; then
      important.log "<oo> Install oosh from $installSource"
      mkdir -p "$onceShBase/${OOSH_BRANCH}"
      rsync -a "$installSource/" "$onceShBase/${OOSH_BRANCH}/"
    fi



    # ln -s "$dir/shared/dev/oosh"
    # chown -h developking:dev "oosh"


    console.log "before config copy:
    SSH_CONFIG_NAME_USED_FOR_LOCAL
    $SSH_CONFIG_NAME_USED_FOR_LOCAL"

    local paramerUser="${SSH_CONFIG_NAME_USED_FOR_LOCAL#user.}"
    local currentHome
    if [ -n "$paramerUser" ] && [ "$paramerUser" != "root" ]; then
      currentHome="$dir/$paramerUser"
    else
      currentHome="$HOME"
    fi
    info.log "paramerUser=$paramerUser currentHome=$currentHome"

    local currentConfig="$currentHome/config"
    info.log "currentConfig=$currentConfig"

    mkdir -p "$currentHome/.ssh/ids/"
    cp -r "$devHome/.ssh" "$currentHome/.ssh/ids/ssh.developking"

  set -x
    # sharedConfig: seeded from root's config once, never copied into when it
    # is there; the user config kept as config.orig.<ts> and linked to it.
    if ! private.oo.shared.config.ensure "$dir/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig" "$HOME/config" "$currentConfig" >/dev/null; then
      error.log "state 31 [5/5: dev.repo.cloned]: $RESULT"
      create.result 1 "state 31 step 5/5 failed: sharedConfig not linked — $RESULT"
      set +x; return $(result)   # leave the xtrace block of state 31 before returning
    fi
    chown -h $paramerUser:dev "$currentConfig"
    # No chown -R / chmod -R over "$dir/shared": on macOS that is /Users/Shared,
    # the whole workspace of the computer (D1). What oosh creates there gets
    # group dev and 2775 when it is created (private.oo.shared.base.ensure); the
    # clones are shared per folder (ogit.folder.finish below); sharedConfig by
    # private.ensure.sharedTree below.

    # Always link ROOT's config AND oosh to the shared tree. State 31
    # runs as root regardless of which paramerUser is being set up —
    # without these symlinks, root's OOSH_DIR (always ~/oosh, see
    # docs/config.md § The anchor rule) resolves at point of use to root's private clone, and
    # root can't see the shared worktrees (the macstudio-root regression).
    #
    # Previous guard `[ "$paramerUser" != "root" ]` was wrong: when
    # paramerUser is empty (SSH_CONFIG_NAME_USED_FOR_LOCAL isn't set
    # until `config ssh.host.set` in ossh.install.continue.local, which runs AFTER `oo state` has
    # already advanced through state 31) OR explicitly "root", the
    # guard skipped the helper and left root's ~/oosh as a real dir.
    # Install log from the recurring macstudio bug confirmed the empty
    # case: `paramerUser= currentHome=/var/root`.
    #
    # The helper is idempotent — config already linked above will be
    # detected as a symlink and left alone. Delegates to the testable
    # helper private.oo.user.shared.symlinks.ensure (covered by
    # T-MODE-COMPLETION-LAZY-USERENV-ENSURE + T-SYMLINKS-ENSURE-COLLISION
    # in test/test.oo).
    private.oo.user.shared.symlinks.ensure \
      "$HOME" \
      "$dir/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig" \
      "$onceShBase" \
      "${OOSH_BRANCH}"

    # Each folder is its own repository now (clone layout, 2026-09-23 design):
    # shared mode, setgid, g+w and the caller's trust PER FOLDER (ogit
    # folder.finish: .git and working tree), not on main/.git only. Shared mode is
    # what keeps root's git ops (`git pull` on re-install, init/oosh) from
    # writing FETCH_HEAD/ORIG_HEAD/objects as root:root 644 and locking the
    # dev group out. safe.directory: the clones belong to the installing user
    # (root) with group dev and g+w, so without an entry per folder every other
    # user hits dubious-ownership on `oo mode <folder>`.
    # The BASE gets group dev + setgid (a live host had root:dev WITHOUT
    # setgid), so a folder added later by oo checkout / oo mode inherits the
    # group. No recursive chown (T-STATE-31-CHOWN-NOT-RECURSIVE). A folder
    # left as an old-install worktree shares main/.git, which main/'s own
    # pass covers. Re-runs are idempotent.
    if ! private.oo.shared.base.share "$onceShBase" >/dev/null; then
      error.log "state 31 [5/5: dev.repo.cloned]: cannot set group dev + setgid on $onceShBase"
      create.result 1 "state 31 step 5/5 failed: base $onceShBase is not group dev + setgid"
      set +x; return $(result)   # leave the xtrace block of state 31 before returning
    fi
    local _wt
    while IFS= read -r _wt; do
      # .git and the working tree shared, trusted by root and — under sudo —
      # by the person who typed the command (ogit folds the letter case).
      if ! ogit.folder.finish "$_wt" >/dev/null; then
        error.log "state 31 [5/5: dev.repo.cloned]: ogit folder.finish $_wt failed — $RESULT"
        create.result 1 "state 31 step 5/5 failed: $_wt is not shared and trusted"
        set +x; return $(result)   # leave the xtrace block of state 31 before returning
      fi
    done < <(private.ogit.base.folders.list "$onceShBase")

    # path-exception: install-time, and already marked for removal below.
    # TODO: This should be removed to only use $HOME/oosh in the PATH
    export PATH="$( echo $PATH | line replace.sedquoted "$HOME/oosh" "$onceShBase/${OOSH_BRANCH}" )"

  set +x



    export CONFIG="$dir/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig/user.env"
    export CONFIG_FILE="user.env"
    # config-path-exception: install state 31 builds the shared tree BEFORE
    # ~/config is a symlink to it, so it must name the target directly.
    export CONFIG_PATH="$dir/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
    # OOSH_DIR is the constant ~/oosh — private.oo.user.shared.symlinks.ensure
    # above just pointed it at $onceShBase/${OOSH_BRANCH}. Nothing to export.
    export OOSH_MODE="${OOSH_BRANCH}"

    console.log "PATH=$PATH"   # path-exception: a diagnostic, not an assignment
    console.log "CONFIG=$CONFIG"
    config save

    # Migrate install.log to /home/shared/sharedConfig (dev-group writable)
    # so non-root install-time processes (target-user user.oosh.install,
    # finish.local user-remote setup, runuser-spawned developking shells,
    # etc.) can append to the SAME file. Without this, child shells inherit
    # LOG_INSTALL=/root/config/install.log and their writes silently fail
    # (post-f2ceed3 [ -w ] guard) — leaving install.log incomplete. After
    # migration, install.log captures the full install lifecycle from all
    # actors. ossh.install.continue.local unsets LOG_INSTALL/INSTALL_LOG at end of install
    # so user.env stays clean and routine user shells don't append.
    local _bootstrapInstallLog="$HOME/config/install.log"
    local _sharedInstallLog="$CONFIG_PATH/install.log"
    if [ -f "$_bootstrapInstallLog" ] && [ ! -f "$_sharedInstallLog" ]; then
      cp "$_bootstrapInstallLog" "$_sharedInstallLog"
    fi
    touch "$_sharedInstallLog" 2>/dev/null
    chgrp dev "$_sharedInstallLog" 2>/dev/null
    chmod 664 "$_sharedInstallLog" 2>/dev/null
    export INSTALL_LOG="$_sharedInstallLog"
    export LOG_INSTALL="$INSTALL_LOG"

    # F3 absorption: template root-home paths in the just-saved shared
    # config so non-root users can source it without hitting /root paths
    # they can't read. Was in ossh.install.continue.local
    # (post-state-machine fixup); moved here so the state machine owns it.
    if [ -f "$CONFIG" ]; then
      local _rootHome="$HOME"
      local _sedFlag="-i"
      if [ "$(uname -s)" = "Darwin" ]; then _sedFlag="-i ''"; fi
      eval sed $_sedFlag "'s|${_rootHome}/config|\$HOME/config|g'" "'$CONFIG'"
      eval sed $_sedFlag "'s|${_rootHome}/oosh|\$HOME/oosh|g'" "'$CONFIG'"
      if [ -n "$OOSH_BRANCH" ] && [ "$OOSH_BRANCH" != "dev" ]; then
        eval sed $_sedFlag "'s|${_rootHome}/${OOSH_BRANCH}|\$HOME/oosh|g'" "'$CONFIG'"
      fi
      local _configDir
      _configDir="$(dirname "$CONFIG")"
      for _f in "$_configDir"/oosh.env "$_configDir"/log.env; do
        if [ -f "$_f" ]; then
          eval sed $_sedFlag "'s|${_rootHome}/config|\$HOME/config|g'" "'$_f'"
          eval sed $_sedFlag "'s|${_rootHome}/oosh|\$HOME/oosh|g'" "'$_f'"
          if [ -n "$OOSH_BRANCH" ] && [ "$OOSH_BRANCH" != "dev" ]; then
            eval sed $_sedFlag "'s|${_rootHome}/${OOSH_BRANCH}|\$HOME/oosh|g'" "'$_f'"
          fi
        fi
      done
    fi


    # sharedConfig ownership: re-chown the TOP-LEVEL dir to developking:dev
    # (the dev-group canonical layout wants sharedConfig owned by developking,
    # not the installing user). NOT recursive: existing files keep their
    # writer's ownership (all group=dev via the setgid bit below), and new
    # files written by any dev-group user inherit group=dev — that's the
    # canonical Unix shared-dir model.
    #
    # The previous `chown -R developking:dev` was too aggressive: when
    # `ossh install <host> <user>` re-runs state 31 on a host where some
    # OTHER user (e.g. GHA's `runner`) had already written to sharedConfig
    # via `~/config` symlink during a prior install, the -R stomped on
    # those files' ownership. Subsequent writes from the original writer
    # failed with `Permission denied` because they were no longer the
    # owner, and on existing shells they didn't have the dev group in
    # their effective group list either (group adds only take effect on
    # next login). Bisected on the 2026-05-19 macOS CI run 26095749022,
    # Phase A.4 where `/Users/runner/config/setup.color.env: Permission
    # denied` blocked bash-user's install — runner-written files from
    # bootstrap got re-chowned to developking:dev by state 31 during
    # Phase A.1b's `ossh install macos test`.
    chown developking:dev "$CONFIG_PATH"
    chmod g+s "$CONFIG_PATH"
    # Group dev and g+w on sharedConfig's entries — the tree oosh created; root's
    # copy of ~/config came with root's group. The kernel's sharedConfig repair
    # (config init.shared) is the same call.
    private.ensure.sharedTree "$CONFIG_PATH"

    # Add the installing user to the dev group (so they can write to
    # sharedConfig). Skip when paramerUser is empty/root — `user
    # group.add` would error on an empty username, and root is already
    # member of every group on macOS / unnecessary on Linux.
    if [ -n "$paramerUser" ] && [ "$paramerUser" != "root" ]; then
      user group.add dev "$paramerUser"
    fi

    # `init` symlink — convenience pointer so `~/init/oosh` resolves
    # to the cloned init script. Absolute paths (the old relative
    # `cd /root` + `ln -s oosh/init init` block was Linux-only and
    # left `init` in whatever cwd happened to be when `cd /root`
    # failed on macOS). Idempotent.
    if [ ! -L "$HOME/init" ]; then
      [ -e "$HOME/init" ] && rm -rf "$HOME/init"
      ln -s "$HOME/oosh/init" "$HOME/init"
    fi

    # Diagnostic listing — portable (no Linux-specific `/home/shared`,
    # no `tree` dependency, no `/root` listing).
    ls -la "$onceShBase/${OOSH_BRANCH}"

    # `~/config` and `~/oosh` are already symlinks — set up above by
    # private.oo.user.shared.symlinks.ensure, which is the
    # single source of truth for that pair. The previous duplicate
    # `cd /root; ln -s … config; rm -rf oosh; ln -s … oosh` here was
    # leftover from before that helper was extracted; it tried to do
    # the same work via relative paths after `cd /root`, which on
    # macOS landed in the wrong directory (no /root on macOS — root's
    # home is /var/root). Removed.
    # ─── state 31 [5/5: dev.repo.cloned] ─────────────────────────────────
    # Post-body verification: without this, a silent failure in a clone
    # leaves the state machine thinking state 31 succeeded while
    # $sharedOosh never materialized, causing downstream user.oosh.install to
    # time out polling for a dir that's never going to appear.
    if [ ! -d "$onceShBase/${OOSH_BRANCH}" ]; then
      error.log "state 31 [5/5: dev.repo.cloned]: $onceShBase/${OOSH_BRANCH} missing — check the ogit repo.clone log above"
      create.result 1 "state 31 step 5/5 failed: dev folder not created at $onceShBase/${OOSH_BRANCH}"
      return $(result)
    fi

    # Seed /<basehome>/shared/.ssh/ via the same primitive the caller-side
    # install path uses (single source of truth). Idempotent. Was followed
    # by a defensive re-invocation in ossh.install.continue.local (F4) — that's gone now;
    # this call is fail-loud so any silent failure halts state 31.
    ossh config.shared.github.create 2>&1
    if ! ossh config.get github.com "$dir/shared/.ssh/config" >/dev/null 2>&1; then
      error.log "state 31 [5/5: dev.repo.cloned]: Host github.com missing from $dir/shared/.ssh/config after ossh config.shared.github.create"
      create.result 1 "state 31 step 5/5 failed: shared SSH not seeded"
      return $(result)
    fi

    # Retry user.oosh.install for developking now that $sharedOosh exists.
    # Step 1's `user create developking` auto-invoked user.oosh.install but
    # it early-returned (user.oosh.install) because $sharedOosh isn't created until
    # step 5's git clone. Without this retry, developking has no
    # ~/oosh + ~/config symlinks and no bashrcTemplate — boss-as-developking
    # logs in to a plain bash shell with no OOSH completion. With this
    # retry, developking gets the same OOSH login experience as any other
    # user. Boss-experience invariant verified below.
    #
    # Use the dispatched form `user oosh.install` (not the dotted
    # `user.oosh.install` function name) — state 31's check function runs
    # in a context where the user script's functions aren't directly in
    # scope, but the `user` dispatcher is. Same pattern as step 1's
    # `user create developking`.
    user oosh.install developking 2>&1
    if [ ! -L "$devHome/oosh" ] || [ ! -L "$devHome/config" ]; then
      error.log "state 31 [5/5: dev.repo.cloned]: developking missing OOSH symlinks after retry — boss-as-developking will get plain bash on login"
      create.result 1 "state 31 step 5/5 failed: developking OOSH home not finalized"
      return $(result)
    fi

    create.result 0 "root.shared.dev.folder.created" $1
  fi

  

  #check.debug.level 3
  return $(result)
}

private.check.root.dev.keys.installed() {
  return 0
}
private.check.root.installation.done() {
  # The launcher an empty shell finds `this` through (`env -i sh`, then `this`).
  private.oo.install.launcher "$OOSH_DIR" >/dev/null
  # Every install writes the shared odocker.env (ODOCKER_WORKSPACES) and its
  # chain in user.env, as a host that ran `odocker workspace.set` has them.
  private.this.script.load odocker private.odocker.workspaces.install \
    && private.odocker.workspaces.install >/dev/null
  # root's .bashrc and per-user session file, through the one writers.
  private.this.script.load user private.user.bashrc.install \
    && private.user.bashrc.install "$HOME" "$OOSH_DIR" >/dev/null
  private.this.script.load config private.config.session.file.ensure \
    && private.config.session.file.ensure "$HOME" >/dev/null

  # Ensure login shell is bash (Alpine defaults to ash)
  local currentShell bashPath
  if [ -z "$OOSH_OS" ]; then
    case "$OSTYPE" in
      darwin*) OOSH_OS="darwin" ;;
      linux*)  OOSH_OS="linux-gnu" ;;
    esac
  fi
  if [ "$OOSH_OS" = "darwin" ]; then
    currentShell=$(dscl . -read /Users/root UserShell 2>/dev/null | awk '{print $2}')
  else
    currentShell=$(getent passwd root 2>/dev/null | cut -d: -f7)
  fi
  bashPath=$(command -v bash 2>/dev/null)
  if [ -n "$bashPath" ] && [ "$currentShell" != "$bashPath" ]; then
    if command -v chsh >/dev/null 2>&1; then
      chsh -s "$bashPath" root
    elif [ -w /etc/passwd ]; then
      sed -i 's|^root\(.*\):[^:]*$|root\1:'"$bashPath"'|' /etc/passwd
    fi
  fi

  # Ensure shared log config has normal log level for interactive sessions
  # (install may have persisted a low level from the install process)
  export LOG_LEVEL=3
  export LOG_LEVEL_RESET=3
  config save log LOG

  return 0
}

