private.oo.method.name.resolve()     # <name> # echo "<script> <method>" for a <script.method> name: private.<script>.<verb> belongs to <script>; the script is the longest leading prefix that names a file in $OOSH_DIR; <method> is empty when the name has none #
{
 # A getter consumed as $(...): no create.result. The ONE rule for oo
 # method.new and oo method.delete — method.delete split on the first dot, so
 # `private.oo.x` looked for a file called `private` and `test.suite.x` for
 # `test` (T-METHOD-DELETE-PRIVATE).
 #
 # A PRIVATE method is named `private.<script>.<verb>`: its script is the
 # SECOND segment. And the boundary between SCRIPT and METHOD is not "the
 # first dot" either: `test.suite` is a script whose own NAME contains one.
 # Take the LONGEST leading prefix that names a file which EXISTS — the only
 # rule that separates `test.suite.x` from `config.x` without a list of
 # special cases. Nothing on disk matched (a brand-new script, or a typo):
 # fall back to the first-segment split, so errors name what the caller typed.
 local name="$1" nameBody="$1"
 case "$name" in
   private.*) nameBody="${name#private.}" ;;
 esac
 local script="" method="" candidate="$nameBody"
 while [ "$candidate" != "${candidate%.*}" ]; do
   candidate="${candidate%.*}"
   if [ -f "$OOSH_DIR/$candidate" ]; then
     script="$candidate"
     method="${nameBody#$candidate.}"
     break
   fi
 done
 if [ -z "$script" ]; then
   script="${nameBody%%.*}"
   method="${nameBody#*.}"
 fi
 [ "$method" = "$nameBody" ] && method=""
 echo "$script $method"
}


private.oo.dropin.remove()     # <?systemPath:/etc/oosh> <?profileDir:/etc/profile.d> # remove the retired login drop-in: <profileDir>/oosh.sh when it is oosh's (it names <systemPath>/boot, or is the later managed template), the <systemPath>/boot link, and <systemPath> when empty; idempotent #
{
 # boot is gone: a shell starts from ~/config/user.env (.bashrc, `source
 # this`, ossh.remote.prelude.get). Hosts installed earlier still carry the
 # host-wide drop-in. Two versions are oosh's: the first names
 # <systemPath>/boot; the later one (2fbcf1b, templates/user/profile.d.oosh.sh)
 # sources ~/config/user.env itself and is known by its first line
 # (T-OO-DROPIN-REMOVE-MANAGED). A foreign file of that name stays. Removing
 # needs write access to the DIRECTORY: private.oo.path.sudo.get on the
 # directory, the same privilege rule the installer used — quiet (`sudo -n`):
 # oo update runs this and must never stop at a password prompt.
 local systemPath="${1:-/etc/oosh}"
 local profileDir="${2:-/etc/profile.d}"
 local dropIn="$profileDir/oosh.sh"
 local managedMark='# oosh — host-wide login-shell bootstrap. MANAGED FILE:'
 local firstLine=""
 [ -f "$dropIn" ] && IFS= read -r firstLine < "$dropIn"
 if [ -f "$dropIn" ] && { grep -Fq "$systemPath/boot" "$dropIn" 2>/dev/null || [ "${firstLine#"$managedMark"}" != "$firstLine" ]; }; then
   $(private.oo.path.sudo.get "$profileDir" quiet) rm -f "$dropIn"
 fi
 if [ -L "$systemPath/boot" ] || [ -e "$systemPath/boot" ]; then
   $(private.oo.path.sudo.get "$systemPath" quiet) rm -f "$systemPath/boot"
 fi
 if [ -d "$systemPath" ] && [ -z "$(ls -A "$systemPath" 2>/dev/null)" ]; then
   $(private.oo.path.sudo.get "${systemPath%/*}" quiet) rmdir "$systemPath"
 fi
 firstLine=""
 [ -f "$dropIn" ] && IFS= read -r firstLine < "$dropIn"
 if { [ -f "$dropIn" ] && { grep -Fq "$systemPath/boot" "$dropIn" 2>/dev/null || [ "${firstLine#"$managedMark"}" != "$firstLine" ]; }; } || [ -L "$systemPath/boot" ]; then
   create.result 1 "could not remove the retired login drop-in ($dropIn / $systemPath/boot)"
   error.log "$RESULT"
 else
   create.result 0 "no login drop-in (boot is gone; shells start from ~/config/user.env)"
 fi
 return $(result)
}


private.oo.pm.env.get()     # <?pm:$OOSH_PM> # echo the env prefix that makes a package-manager install non-interactive (apt: DEBIAN_FRONTEND, brew: HOMEBREW_NO_ASK), or nothing; the one table behind oo.cmd and oo.prereqs.install #
{
 # NO create.result, no logging — a getter consumed as $(...). The why of
 # each prefix is the long comment in oo.cmd; init/oosh carries a POSIX twin,
 # oosh_pm_env (it runs before oo exists), pinned equal by test.install
 # T-INIT-PM-ENV-AGREES. ossh.cmd / ossh.harden.packages consume this one.
 case "${1-$OOSH_PM}" in
   # LC_ALL / DEBCONF_NOWARNINGS: a login's LANG the system lacks made perl
   # warn on every install, and debconf noted the missing apt-utils (Debian
   # 12, 2026-10-06). C.UTF-8 exists on every Debian and Ubuntu.
   apt-get*|dpkg*) echo "env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes" ;;
   brew*)          echo "env HOMEBREW_NO_ASK=1" ;;
 esac
}


private.oo.branch.clone.ensure()     # <url> <branch> <targetDir> # ensure <targetDir> is an independent clone of <branch>: clone <url> when it is absent or empty; an existing clone on <branch> is kept; a linked worktree from an older install is left alone (convert with ogit worktree.remove); anything else refuses #
{
 private.this.script.load ogit ogit.branch.get
 local url="$1" branch="$2" target="$3"
 if [ -z "$url" ] || [ -z "$branch" ] || [ -z "$target" ]; then
   create.result 1 "private.oo.branch.clone.ensure requires <url> <branch> <targetDir>"; error.log "$RESULT"; return $(result)
 fi
 # Re-runs of install state 31 arrive here with the folder already present.
 # ogit repo.clone refuses a non-empty target — right for it, wrong as the
 # answer to "is the layout there?". Decide here, and never delete: a folder
 # this call did not make is somebody's work.
 if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
   local have
   have=$(ogit.branch.get "$target")
   case "$(private.ogit.folder.shape "$target")" in
     clone)
       if [ "$have" = "$branch" ]; then
         create.result 0 "kept: $target is already a clone of $branch"
       else
         create.result 1 "$target is a clone of '${have:-detached}', not $branch — refusing to touch it"; error.log "$RESULT"
       fi
       ;;
     worktree)
       # An install from before the clone layout. Converting it is gated work
       # (clean + pushed, ignored files carried) that ogit owns — not the install.
       create.result 0 "left alone: $target is a linked worktree from an older install — convert it with: ogit worktree.remove"
       warn.log "$RESULT"
       ;;
     *)
       create.result 1 "$target exists, is not empty and is not a repository — refusing to clone over it"; error.log "$RESULT"
       ;;
   esac
   return $(result)
 fi
 ogit.repo.clone "$url" "$branch" "$target"
 return $(result)
}


private.oo.install.launcher()     # <?sourceDir:$OOSH_DIR> <?target:/usr/local/bin/this> <?mode:quiet> # install the oosh launcher, so an empty shell finds this on the system PATH; only when it differs; as a user through sudo -n (quiet, never a password prompt) or sudo (interactive, oo heal) #
{
  # `env -i sh` leaves only the system PATH, and nothing of oosh was on it:
  # `this` was "not found". templates/user/thisLauncher, installed as
  # /usr/local/bin/this (on the default PATH of Linux and macOS), starts the
  # caller's own ~/oosh/this. One host-wide command, not a login file.
  # mode interactive: oo heal, which the person started, may ask for the sudo
  # password once; oo update stays quiet.
  local sourceDir="${1:-$OOSH_DIR}" target="${2:-/usr/local/bin/this}" mode="${3:-quiet}"
  local src="$sourceDir/templates/user/thisLauncher" asRoot=""
  if [ ! -f "$src" ]; then
    create.result 1 "no launcher template at $src"
    return $(result)
  fi
  if private.this.file.same "$src" "$target"; then
    create.result 0 "$target is up to date"
    return $(result)
  fi
  # Root, or a caller who may write the target (its nearest existing parent
  # while it is not there), needs nothing; a user goes through `sudo -n` —
  # oo update must never stop at a password prompt. The one privilege rule.
  asRoot=$(private.oo.path.sudo.get "$target" "$mode")
  if ${asRoot}mkdir -p "${target%/*}" 2>/dev/null \
     && ${asRoot}cp "$src" "$target" 2>/dev/null \
     && ${asRoot}chmod 0755 "$target" 2>/dev/null; then
    create.result 0 "$target installed"
  else
    warn.log "the launcher $target is missing or old — install it with: sudo cp $src $target && sudo chmod 755 $target"
    create.result 1 "$target not installed"
  fi
  return $(result)
}


private.oo.once.path.migrate()     # <?home:$HOME> # remove the frozen PATH line from the ~/.once of <home>, in place; ONCE's own lines stay; idempotent, silent #
{
 # once.hibernate (init/once) used to append a frozen PATH line — the
 # installing shell's PATH — to ~/.once, and the .bashrc sources ~/.once last: it
 # overwrote the user's own PATH (~/.config/oosh/user.session.env). ONCE no
 # longer writes it; this takes it out of a ~/.once written before. Rewritten
 # in place (`>` keeps owner and mode). No create.result: oo update's RESULT
 # must stand. T-OO-ONCE-PATH-MIGRATE.
 local f="${1:-$HOME}/.once" line out=""
 [ -f "$f" ] || return 0
 # path-exception: the grep and the case match the frozen line being removed, not assignments.
 grep -qE '^[[:space:]]*(export[[:space:]]+)?PATH=' "$f" 2>/dev/null || return 0
 while IFS= read -r line || [ -n "$line" ]; do
   case "$line" in "PATH="*|"export PATH="*) continue ;; esac
   out="$out$line"$'\n'
 done < "$f"
 printf '%s' "$out" > "$f" 2>/dev/null
 return 0
}


private.oo.shared.tree.ensure()     # <url> <base> <branch> <?localSource:$HOME/oosh> # ensure <base>/main is a clone of main (from <url>, else a local copy of <localSource>) and <base>/<branch> a clone of <branch> beside it; an existing clone is kept, so a re-run heals a half-made first run #
{
 # Install state 31 cloned main with ogit repo.clone, which refuses a
 # non-empty target: on a re-run main/ "failed", the log blamed SSH, the local
 # fallback returned at its main/-present fast path and the branch folder was
 # never made (T-SHARED-TREE-ENSURE). private.oo.branch.clone.ensure keeps an
 # existing clone — the decision the branch folder already used — so the local
 # copy runs only when main/ could really not be cloned, and the branch folder
 # is made in every case where main/ is there.
 # <localSource>: oo heal names its own tree — $HOME/oosh can be the broken
 # one it heals (T-SHARED-TREE-ENSURE case 5).
 local url="$1" base="$2" branch="$3" localSource="${4:-$HOME/oosh}"
 if [ -z "$url" ] || [ -z "$base" ] || [ -z "$branch" ] || [ ! -d "$base" ]; then
   create.result 1 "private.oo.shared.tree.ensure requires <url> <base> <branch> and an existing <base>, got '$url' '$base' '$branch'"; error.log "$RESULT"; return $(result)
 fi
 if ! private.oo.branch.clone.ensure "$url" main "$base/main" >/dev/null; then
   warn.log "clone of main from $url failed ($RESULT) — falling back to a local copy from $localSource"
   if [ ! -d "$localSource" ]; then
     create.result 1 "no main/ in $base and no $localSource to copy from"; error.log "$RESULT"; return $(result)
   fi
   # The local builder works in $(pwd): a subshell, so the caller's stays.
   if ! ( cd "$base" && private.oo.shared.tree.from.local "$(private.this.path.canonical "$localSource")" "$branch" ); then
     create.result 1 "the local copy from $localSource into $base failed"; error.log "$RESULT"; return $(result)
   fi
 fi
 if [ "$branch" != main ] && ! private.oo.branch.clone.ensure "$url" "$branch" "$base/$branch" >/dev/null; then
   create.result 1 "clone of $branch into $base failed — $RESULT"; error.log "$RESULT"; return $(result)
 fi
 create.result 0 "$base/main and $base/$branch are clones"
 return $(result)
}


private.oo.method.end.get()     # <file> <startLine> # echoes the line that closes the definition starting at <startLine> in <file>; empty when another definition or the marker comes first #
{
 # A getter consumed as $(...): no create.result. The one place that knows
 # where a definition ENDS, for oo method.delete. Three shapes:
 #   name() { …; }                     — <startLine> itself
 #   name() # doc  /  { …; }           — the body line under the signature
 #   name() # doc  /  {  /  …  /  }    — the first `}` line
 # "The first `}` line" alone was the bug: a signature with a `{ …; }` body
 # has no `}` LINE, so the block ran on into the NEXT method and deleted it
 # (private.oo.safeDirectory.add took oo.remote.update, T-METHOD-DELETE-ONE-LINE).
 # Reaching another definition or the `### new.method` marker before the end
 # means the shape is not one of the three: echo nothing, the caller refuses.
 local file="$1" startLine="$2"
 START_LINE="$startLine" awk '
   BEGIN { s = ENVIRON["START_LINE"] }
   !found && $0 == s {
     found = 1
     if ($0 ~ /}[[:space:]]*$/) { print; exit }
     next
   }
   found && !body && $0 ~ /^[[:space:]]*$/ { next }
   found && !body && $0 ~ /^\{.*}[[:space:]]*$/ { print; exit }
   found { body = 1 }
   found && $0 == "}" { print; exit }
   found && ($0 ~ /^[A-Za-z_][A-Za-z0-9_.:-]*[[:space:]]*\(\)/ || $0 == "### new.method") { exit }
 ' "$file" 2>/dev/null
}


private.oo.path.writable.is()     # <path> # rc 0 when this user may write <path>, or its nearest existing parent directory while it does not exist yet #
{
 # A predicate: rc only, no create.result (its caller private.oo.path.sudo.get
 # is a getter). The probe of the one privilege rule, on its own so a test can
 # answer "cannot write" for root too (T-OO-PATH-SUDO-GET). Builtins only: it
 # still answers when PATH is unusable.
 local probe="${1:-.}"
 while [ ! -e "$probe" ]; do
   case "$probe" in
     */*) probe="${probe%/*}"; [ -z "$probe" ] && probe="/" ;;
     *)   probe="." ;;
   esac
 done
 [ -w "$probe" ]
}


private.oo.pm.install.prefix.get()     # <?pmCmd:$OOSH_PM> # echo what goes in front of the package-manager command: the sudo decision (none for brew, none for root, else $SUDO; brew under sudo hops back to SUDO_USER) and the non-interactive env of private.oo.pm.env.get #
{
 # A getter consumed as $(...): no create.result, no logging. "How to call a
 # package manager" lived in oo.cmd, again in oo.prereqs.install and a third
 # time in ossh.cmd (T-OO-PM-INSTALL-PREFIX-GET). Root or not is $SUDO — ""
 # for root, "sudo " for a user (`this`) — the variable oo.cmd always used.
 # Homebrew refuses to run as root ("extremely dangerous and no longer
 # supported"): never sudo in front of it; root reached through sudo (init/oosh
 # re-execs that way) hops back to $SUDO_USER, -H so brew finds its own
 # config and cache. The env goes after the sudo — sudo's env_reset would drop
 # a shell-assignment prefix (the long comment in oo.cmd).
 local pmCmd="${1:-$OOSH_PM}" asRoot=""
 case "$pmCmd" in
   brew*) if [ -z "$SUDO" ] && [ -n "$SUDO_USER" ]; then asRoot="sudo -u $SUDO_USER -H"; fi ;;
   *)     asRoot="$SUDO" ;;
 esac
 set -- $asRoot $(private.oo.pm.env.get "$pmCmd")
 echo "$*"
}


private.oo.layout.folder.check()     # <folder> <base> <?byBranch:yes> # rc 0 when <folder> is a folder of a finished clone/worktree layout under <base>: <base>/main is a repository and <folder> is main, carries the name of a branch main knows, or — byBranch yes — its branch has its own folder beside it; RESULT says which #
{
 # "Set up" is a property of the LAYOUT, not of what is checked out: a folder
 # named prod with hotfix checked out, a detached HEAD, a linked worktree from
 # an older install (.git is a FILE) are all folders of a finished layout. The
 # one thing that is NOT is the plain source tree oo mode.setup converts — a
 # clone beside main/ whose name is no branch and whose branch has no folder.
 private.this.script.load ogit ogit.branch.get
 local folder base name branch
 folder=$(private.this.path.canonical "$1" 2>/dev/null)
 base=$(private.this.path.canonical "$2" 2>/dev/null)
 if [ -z "$folder" ] || [ -z "$base" ]; then
   create.result 1 "private.oo.layout.folder.check requires <folder> <base>"; return $(result)
 fi
 if [ "$(private.ogit.folder.shape "$base/main")" = missing ] || ! ogit.repo.check "$base/main"; then
   create.result 1 "no layout: $base/main is not a repository"; return $(result)
 fi
 if [ "$(dirname "$folder")" != "$base" ] || [ "$(private.ogit.folder.shape "$folder")" = missing ]; then
   create.result 1 "$folder is not a repository directly under $base"; return $(result)
 fi
 name="${folder##*/}"
 if [ "$name" = main ]; then
   create.result 0 "main is the main folder of the layout"; return $(result)
 fi
 if ogit.branch.check "refs/heads/$name" "$base/main" || ogit.branch.check "refs/remotes/origin/$name" "$base/main"; then
   create.result 0 "$name is a folder of the layout"; return $(result)
 fi
 # byBranch no: the consume step, where the branch folder it just cloned stands
 # beside the source by design.
 branch=$(ogit.branch.get "$folder")
 if [ "${3:-yes}" = yes ] && [ -n "$branch" ] && [ "$base/$branch" != "$folder" ] && [ "$(private.ogit.folder.shape "$base/$branch")" != missing ]; then
   create.result 0 "$name is beside the folder of its branch $branch — a layout folder"; return $(result)
 fi
 create.result 1 "$name is a plain source tree beside main/, not a folder of the layout"
 return $(result)
}


private.oo.source.consume.gate()     # <sourceDir> <mainDir> # rc 0 when removing the source tree <sourceDir> loses nothing: clean, has an upstream, nothing unpushed (private.ogit.folder.gate), no stash, no other unpushed local branch, no tag <mainDir> lacks (private.ogit.clone.gate); RESULT names the folder and what would be lost otherwise #
{
 # ogit owns both gates (worktree.remove / worktree.restore use them before
 # they delete a folder); this only runs them in order and names the folder.
 private.this.script.load ogit ogit.branch.get
 local src="$1" main="$2"
 if [ -z "$src" ] || [ -z "$main" ]; then
   create.result 1 "private.oo.source.consume.gate requires <sourceDir> <mainDir>"; return $(result)
 fi
 if ! private.ogit.folder.gate "$src" >/dev/null || ! private.ogit.clone.gate "$src" "$main" >/dev/null; then
   create.result 1 "$src is not removed — $RESULT"; return $(result)
 fi
 return $(result)
}


private.oo.shared.base.ensure()     # <basehome> <?owner:developking> # create the shared base directories install state 31 needs under <basehome>/shared: dev/Workspaces and the Once.sh folders of Scenarios and Components; RESULT names what was created; rc 1 when the EAMD tree is missing afterwards #
{
 # The shared base of install state 31 (private.check.root.shared.dev.folder.created),
 # in its own method so the state and the heal call one thing and a test drives
 # it on a fixture basehome (T-OO-SHARED-BASE-ENSURE). Every directory comes
 # from private.oo.shared.dir.ensure: only the segments created here get group
 # dev, 2775 and <owner>; a shared/ that is there keeps its owner, group and
 # modes (T-STATE-31-SHARED-NOT-RECURSIVE, D1).
 local basehome="$1" owner="${2:-developking}"
 if [ -z "$basehome" ]; then
   create.result 1 "private.oo.shared.base.ensure requires <basehome>"
   error.log "$RESULT"; return $(result)
 fi
 local shared="$basehome/shared"
 local scenarios="$shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh"
 local components="$shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"
 local d created=""
 for d in "$shared/dev/Workspaces" "$scenarios" "$components"; do
   private.oo.shared.dir.ensure "$d" "$owner" >/dev/null || return $(result)
   [ "$RESULT" = exists ] || created="${created:+$created }$RESULT"
 done
 if [ ! -d "$shared/EAMD.ucp" ] || [ ! -d "$components" ]; then
   create.result 1 "$shared/EAMD.ucp tree missing after it was ensured"
   error.log "$RESULT"; return $(result)
 fi
 create.result 0 "${created:-exists}"
 return $(result)
}


private.oo.shared.dir.ensure()     # <dir> <?owner> # create the missing segments of a shared directory through private.this.dir.ensure with the dev-group policy: group dev and mode 2775 (setgid) when a dev group exists, <owner> when given; a directory that existed is never changed; RESULT = the created segments or exists #
{
 # The one dev-group policy for a directory of the shared tree (install state
 # 31, the heal): private.this.dir.ensure creates only the missing segments and
 # gives only those the group, the mode and the owner. A directory that was
 # there keeps everything — state 31 changed owner and mode of the whole shared
 # folder recursively, on macOS /Users/Shared (D1). Without a dev group (a
 # single-user computer) the segments are created as they come.
 local dir="$1" owner="$2"
 if [ -z "$dir" ]; then
   create.result 1 "private.oo.shared.dir.ensure requires <dir>"
   error.log "$RESULT"; return $(result)
 fi
 if private.this.group.exists dev; then
   private.this.dir.ensure "$dir" dev 2775 "$owner"
 else
   private.this.dir.ensure "$dir" "" "" "$owner"
 fi
 return $(result)
}


private.oo.shared.config.ensure()     # <sharedConfig> <rootConfig> <?userConfig:rootConfig> # seed the shared config of install state 31 once and link the user config to it: a missing <sharedConfig> is created (private.oo.shared.dir.ensure) and filled from <rootConfig>; an existing one is never copied into, but on every run the installing state machine (stateMachines and current.state.machine.env of <userConfig>, else <rootConfig>) is carried in, the old one kept as .orig.<ts>; a real <userConfig> is kept as <userConfig>.orig.<ts> through private.this.symlink.with.backup, never nested #
{
 # Install state 31 ran `cp -r ~/config sharedConfig`: on an existing
 # sharedConfig that copies INTO it (sharedConfig/config), then it removed the
 # shared stateMachines and moved a real user config to config.initial — a
 # second run nested the second config inside the first (D7). Seeded once, from
 # the entries (private.this.folder.entries.copy, never <rootConfig>/. itself);
 # an existing sharedConfig is kept as it is; the user config goes through the
 # symlink primitive, which stamps .orig.<ts> and never nests
 # (T-OO-SHARED-CONFIG-ENSURE, T-STATE-31-CONFIG-ORIG-TIMESTAMPED).
 local sharedConfig="$1" rootConfig="$2" userConfig="${3:-$2}"
 if [ -z "$sharedConfig" ] || [ -z "$rootConfig" ]; then
   create.result 1 "private.oo.shared.config.ensure requires <sharedConfig> <rootConfig>"
   error.log "$RESULT"; return $(result)
 fi
 # No owner here: state 31 gives the sharedConfig folder to developking itself.
 private.oo.shared.dir.ensure "$sharedConfig" >/dev/null || return $(result)
 if [ "$RESULT" = exists ]; then
   info.log "$sharedConfig exists — kept as it is"
 else
   private.this.folder.entries.copy "$rootConfig" "$sharedConfig" >/dev/null || { error.log "$RESULT"; return $(result); }
   important.log "$sharedConfig seeded from $rootConfig"
 fi
 private.oo.shared.config.state.carry "$sharedConfig" "$rootConfig" "$userConfig" >/dev/null || return $(result)
 private.this.symlink.with.backup "$userConfig" "$sharedConfig" || return $(result)
 create.result 0 "$userConfig links to $sharedConfig"
 return $(result)
}


private.oo.shared.config.state.carry()     # <sharedConfig> <rootConfig> <?userConfig:rootConfig> # carry the installing state machine into <sharedConfig>: stateMachines and current.state.machine.env of <userConfig> when it has them, else of <rootConfig>; what <sharedConfig> held is kept as .orig.<ts> (private.this.entry.aside), the folder re-made through private.this.dir.ensure and filled by private.this.folder.entries.copy; nothing when the source is <sharedConfig> itself; RESULT carried: <source> | nothing to carry #
{
 # oo.state reads $CONFIG_PATH/current.state.machine.env and the stateMachines
 # right after state 31 switches CONFIG_PATH to the sharedConfig. A
 # sharedConfig that was there kept its own — an old version's, or one at
 # state 99 — and the install at 31 jumped to it (T-OO-SHARED-CONFIG-STATE-CARRY).
 # The source is the installing user's config when it differs and has a state
 # machine (a fresh sharedConfig used the same rule), else the root config.
 local sharedConfig="$1" rootConfig="$2" userConfig="${3:-$2}" src="" ts
 if [ -z "$sharedConfig" ] || [ -z "$rootConfig" ]; then
   create.result 1 "private.oo.shared.config.state.carry requires <sharedConfig> <rootConfig>"
   error.log "$RESULT"; return $(result)
 fi
 if [ "$userConfig" != "$rootConfig" ] && [ -d "$userConfig/stateMachines" ]; then
   src="$userConfig"
 elif [ -d "$rootConfig/stateMachines" ] || [ -f "$rootConfig/current.state.machine.env" ]; then
   src="$rootConfig"
 fi
 # A re-run whose config already links to the sharedConfig: nothing to carry.
 if [ -z "$src" ] || [ "$(private.this.path.canonical "$src")" = "$(private.this.path.canonical "$sharedConfig")" ]; then
   create.result 0 "nothing to carry"; return $(result)
 fi
 ts=$(private.this.orig.stamp.get "$sharedConfig" stateMachines current.state.machine.env)
 if [ -d "$src/stateMachines" ]; then
   private.this.entry.aside "$sharedConfig/stateMachines" "$ts" >/dev/null || return $(result)
   private.this.dir.ensure "$sharedConfig/stateMachines" >/dev/null || { error.log "$RESULT"; return $(result); }
   private.this.folder.entries.copy "$src/stateMachines" "$sharedConfig/stateMachines" >/dev/null || { error.log "$RESULT"; return $(result); }
 fi
 if [ -f "$src/current.state.machine.env" ]; then
   private.this.entry.aside "$sharedConfig/current.state.machine.env" "$ts" >/dev/null || return $(result)
   if ! cp "$src/current.state.machine.env" "$sharedConfig/current.state.machine.env"; then
     create.result 1 "could not carry $src/current.state.machine.env into $sharedConfig"; error.log "$RESULT"; return $(result)
   fi
 fi
 info.log "the state machine of $src carried into $sharedConfig"
 create.result 0 "carried: $src"
 return $(result)
}


private.oo.update.pull.gate()     # <?dir:$OOSH_DIR> # rc 0 when <dir> may be pulled; rc 1 and a RESULT naming the one command to run when a merge, rebase or pick is in progress, conflict markers are committed, the tree is dirty, HEAD is detached or the branch has diverged from origin #
{
 # oo update pulled with a plain `git pull`: on a Mac whose tree had diverged
 # it MERGED origin into it (D5). The pull is a fetch and a fast-forward now,
 # and it runs only when nothing is in the way. Each refusal names the ONE
 # command to run, so the user (or oo heal) knows the next step
 # (T-OO-UPDATE-PULL-GATE). Read-only: nothing here changes <dir>.
 private.this.script.load ogit ogit.branch.get
 local dir="${1:-$OOSH_DIR}" kind markers branch verdict
 ogit.merge.check "$dir" >/dev/null
 case $? in
   0) ;;
   2) create.result 1 "$dir is not a repository — run: oo heal"; return $(result) ;;
   *)
     kind="$RESULT"
     case "$kind" in
       merge) create.result 1 "a merge is in progress in $dir — run: ogit merge.abort $dir" ;;
       pick)  create.result 1 "a cherry-pick is in progress in $dir — run: ogit commit.pick.abort $dir" ;;
       # ogit-exception: printed text, not an invocation — ogit has no rebase abort
       *)     create.result 1 "a rebase is in progress in $dir — run: git -C $dir rebase --abort" ;;
     esac
     return $(result) ;;
 esac
 markers=$(private.oo.update.markers.get "$dir")
 if [ -n "$markers" ]; then
   create.result 1 "conflict markers are committed in $dir (${markers% }) — run: oo heal"; return $(result)
 fi
 if ! ogit.status.check "$dir"; then
   create.result 1 "$dir has uncommitted changes — run: ogit status.show short $dir"; return $(result)
 fi
 branch=$(ogit.branch.get "$dir")
 if [ -z "$branch" ]; then
   # The branch to go back to: one that holds this commit, a local one first.
   branch=$(ogit.branch.find HEAD "$dir" | grep -v '^(' | grep -vx 'HEAD\|origin/HEAD' | sort -t/ -k2 | sed 's|^origin/||' | head -1)
   create.result 1 "$dir is on a detached HEAD — run: ogit branch.checkout ${branch:-dev} $dir"; return $(result)
 fi
 # No cached origin/<branch> yet: nothing to compare — the pull fetches and
 # says it when origin has no such branch (T-OO-UPDATE-NO-ORIGIN-BRANCH).
 if ! ogit.branch.check "refs/remotes/origin/$branch" "$dir"; then
   create.result 0 "ready: $dir on $branch, origin/$branch not fetched yet"; return $(result)
 fi
 ogit.branch.compare "origin/$branch" HEAD "$dir" >/dev/null
 verdict="$RESULT"
 case "$verdict" in
   diverged*) create.result 1 "$dir has $verdict — run: oo heal"; return $(result) ;;
 esac
 create.result 0 "ready: $dir on $branch, $verdict"
 return $(result)
}


private.oo.update.markers.get()     # <?dir:$OOSH_DIR> # echo file:line of the first committed conflicts in <dir>, space-separated: files that hold all three marker kinds (<<<<<<< , =======, >>>>>>> ); nothing when there is none; silent getter #
{
 # NO create.result — a getter consumed as $(...). One kind alone is no
 # conflict: a document that shows a `<<<<<<< ` line refused every update
 # (T-OO-UPDATE-MARKERS-ALL-THREE).
 private.this.script.load ogit ogit.branch.get
 local dir="${1:-$OOSH_DIR}" file line found=""
 while IFS= read -r line; do
   file="${line%%:*}"
   case " $found" in *" $file:"*) continue ;; esac
   ogit.repo.grep '^=======$' "$dir" "$file" >/dev/null || continue
   ogit.repo.grep '^>>>>>>> ' "$dir" "$file" >/dev/null || continue
   found="$found ${line%%:*}:$(printf '%s' "${line#*:}" | cut -d: -f1)"
   [ "$(printf '%s' "$found" | wc -w)" -ge 3 ] && break
 done < <(ogit.repo.grep '^<<<<<<< ' "$dir")
 printf '%s' "${found# }"
}


private.oo.update.pull()     # <?dir:$OOSH_DIR> # pull <dir> through private.oo.update.pull.gate: fetch origin (the HTTPS fallback of OOSH_REPO when it fails) and fast-forward; rc 1 and the one command to run when refused or diverged #
{
 # Fetch, then fast-forward — never a merge (D5). The gate first; on a refusal
 # its RESULT (the one command to run) stands. The shared clone made in state
 # 31 fetches over the 2cuGitHub SSH alias, which a user without the alias in
 # ~/.ssh/config cannot resolve: then the branch is fetched from the HTTPS URL
 # init/oosh clones from (read-only, no auth for a public repo) into
 # FETCH_HEAD; the configured remote is not changed.
 private.this.script.load ogit ogit.branch.get
 local dir="${1:-$OOSH_DIR}" branch ref fallbackUrl
 private.oo.update.pull.gate "$dir" >/dev/null || return $(result)
 branch=$(ogit.branch.get "$dir")
 ref="origin/$branch"
 if ! ogit.remote.fetch no "$dir" >/dev/null; then
   fallbackUrl="${OOSH_REPO:-https://github.com/Cerulean-Circle-GmbH/once.sh.git}"
   warn.log "fetch (SSH remote) failed; trying HTTPS fallback: $fallbackUrl $branch"
   if ! ogit.remote.fetch.url "$fallbackUrl" "$branch" "$dir" >/dev/null; then
     create.result 1 "oo update could not fetch $branch via the SSH remote nor $fallbackUrl — $RESULT"
     error.log "$RESULT"; return $(result)
   fi
   ref=FETCH_HEAD
 elif ! ogit.branch.check "refs/remotes/origin/$branch" "$dir"; then
   create.result 1 "origin has no branch $branch — $dir is not pulled"
   error.log "$RESULT"; return $(result)
 fi
 if ! ogit.branch.fastForward "$ref" "$dir" >/dev/null; then
   create.result 1 "$dir has diverged from $ref — run: oo heal"
   return $(result)
 fi
 create.result 0 "pulled: $dir fast-forwarded to $ref"
 return $(result)
}


private.oo.answer.get()     # <prompt> <?device:/dev/tty> # write <prompt> to <device> when it is a terminal and echo the one line the person types there; nothing and rc 1 on end of input or when <device> cannot be opened; silent getter #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The terminal, not stdin: a piped `yes` must not answer a destructive
 # question (oo.deinstall). The prompt goes to the same terminal — stdout is
 # the $(...) and important.log is invisible at LOG_LEVEL 1 — so a raw printf
 # to that device is the one way the person sees the question. A file read as
 # the device (T-OO-ANSWER-GET) gets no prompt written into it, and a device
 # that is not there is not created (<> would create it).
 local prompt="$1" device="${2:-/dev/tty}" answer
 [ -e "$device" ] || return 1
 { [ -t 3 ] && [ -n "$prompt" ] && printf '%s ' "$prompt" >&3; read -r answer <&3; } 3<>"$device" 2>/dev/null || return 1
 echo "$answer"
}


oo.tmp.cleanup.testing()     #  # retired: it removed oosh, the SSH keys and developking with sudo rm -rf; it refuses now and points at oo deinstall #
{
 # Public and Tab-completed, it ran sudo deinstall.oosh, sudo rm -rf of
 # ~/ssh.root.u* and .ssh, userdel -r developking and mv config.initial config
 # (nothing makes config.initial any more). docs/oo.md still names it, so it
 # stays a verb that refuses (T-OO-TMP-CLEANUP-REFUSES).
 create.result 1 "oo tmp.cleanup.testing is retired — it deleted oosh, the SSH keys and developking; to leave oosh run: oo deinstall (it keeps everything as .orig.<ts>)"
 error.log "$RESULT"
 return $(result)
}


oo.tmp.cleanup.testing.completion() { :; }
# ─── oo heal ────────────────────────────────────────────────────────────────
# One command brings any computer from any prior state to the standard dev
# model so `oo mode <branch>` works (plan "oo heal", owner decisions
# 2026-10-07): the canonical EAMD base built from origin, developking, the
# sharedConfig, the launcher, and ~/oosh + ~/config of every healed user
# pointing into it. Foreign folders are never touched, only reported; a broken
# canonical folder is moved aside to <base>.aside, never deleted; a real
# ~/config is kept as config.orig.<ts>. It runs ONLY when invoked (May-8 rule).
# Order: diagnose (read-only, printed first) → system → code → config →
# user(s) → env → verify → summary. rc 0 healed and every invariant PASS, 1
# something is left for the user, 2 cannot heal. Three forms: `oo heal`, the
# curl form (init/oosh healArm runs a fresh clone's `oo heal`), `ossh heal`.

oo.heal()     # <?branch> <?who:$USER> # heal this computer to the standard dev model: the canonical base, developking, sharedConfig, the launcher, ~/oosh and ~/config of <who> (a user, or all = every user, root only); diagnosis first; rc 0 healed and verified, 1 something is left for you, 2 cannot heal #
{
 # Every form ends in ONE clean process (private.oo.heal.env.clean): an old
 # ~/config/user.env (the Mac's exports PATH with `.`, HOME, LOG_DEVICE) is
 # never read. oo.start re-runs a started `oo heal` before `source this`; a
 # shell that has oo loaded as functions arrives here.
 if [ -z "$OOSH_HEAL_CLEAN" ]; then
   private.oo.heal.env.clean "$1" "$2"
   return $?
 fi
 private.this.script.load ogit ogit.branch.get
 private.this.script.load user user.get
 local branch="$1" who="$2" basehome base sharedConfig r u home users keep=no
 # Read by private.oo.heal.note / private.oo.heal.summary (dynamic scope).
 local healNotes="" healRc=0
 if [ "$branch" = all ]; then branch=""; who=all; fi
 [ -n "$branch" ] || branch=$(private.oo.heal.branch.get)
 [ -n "$who" ] || who=$(id -un)
 if { [ "$who" = all ] || [ "$who" != "$(id -un)" ]; } && [ "$(id -u)" != 0 ]; then
   create.result 2 "oo heal $branch $who heals other users — run it as root: sudo -H oo heal $branch $who"
   error.log "$RESULT"; return $(result)
 fi
 basehome=$(private.oo.heal.basehome.get)
 base=$(private.oo.heal.path.get "$basehome" base)
 important.log "oo heal $branch $who — what is not canonical (nothing changed yet):"
 oo.heal.status "$branch" "$who"

 private.oo.heal.system "$branch"; r=$?
 private.oo.heal.note "$r" system "$RESULT"
 [ "$r" -ge 2 ] && { private.oo.heal.summary; return $(result); }
 # developking may be new: its home names the base from here on.
 basehome=$(private.oo.heal.basehome.get)
 base=$(private.oo.heal.path.get "$basehome" base)
 sharedConfig=$(private.oo.heal.path.get "$basehome" sharedConfig)
 # oo.mode.base.get answers this base, never a guess from the tree running the heal.
 export OOSH_COMPONENTS_DIR="$base"

 private.oo.heal.code "$base" "$branch"; r=$?
 private.oo.heal.note "$r" code "$RESULT"
 [ "$r" -ge 2 ] && { private.oo.heal.summary; return $(result); }

 private.oo.heal.config "$sharedConfig"; r=$?
 private.oo.heal.note "$r" config "$RESULT"
 [ "$r" -ge 2 ] && { private.oo.heal.summary; return $(result); }

 if [ "$who" = all ]; then users=$(private.oo.heal.users.list); keep=yes; else users="$who"; fi
 for u in $users; do
   private.oo.heal.user "$u" "$base" "$branch" "$sharedConfig" "$keep"; r=$?
   private.oo.heal.note "$r" "user $u" "$RESULT"
 done

 private.oo.heal.env "$HOME"; r=$?
 private.oo.heal.note "$r" env "$RESULT"

 for u in $users; do
   home=$(user.get home "$u" 2>/dev/null)
   private.oo.heal.verify "$u" "$home"; r=$?
   private.oo.heal.note "$r" "verify $u" "$RESULT"
 done
 private.oo.heal.summary
 return $(result)
}
oo.heal.completion.branch() {
  private.this.script.load ogit ogit.branch.list && ogit.branch.list remote
}
oo.heal.completion.who() {
  private.this.script.load user user.list && user.list
  echo all
}

oo.heal.status()     # <?branch> <?who:$USER> # read-only diagnosis of what oo heal would do; rc 1 when anything is not canonical #
{
 # The recovery command the platform invariants' FAIL lines can name: it
 # reads, it never writes. Each line is [ok] (canonical), [heal] (oo heal
 # changes it), [left] (oo heal reports it, the user acts) or [keep] (an old
 # backup, kept). The status-output idiom: plain echo, at any LOG_LEVEL.
 private.this.script.load ogit ogit.branch.get
 private.this.script.load user user.get
 local branch="$1" who="$2" basehome base rc=0 u home users
 if [ "$branch" = all ]; then branch=""; who=all; fi
 [ -n "$branch" ] || branch=$(private.oo.heal.branch.get)
 [ -n "$who" ] || who=$(id -un)
 basehome=$(private.oo.heal.basehome.get)
 base=$(private.oo.heal.path.get "$basehome" base)
 echo "oo heal $branch $who — the standard model is $base/$branch"
 private.oo.heal.system.diagnose "$base" "$branch" || rc=1
 if [ "$who" = all ]; then users=$(private.oo.heal.users.list); else users="$who"; fi
 for u in $users; do
   home=$(user.get home "$u" 2>/dev/null)
   if [ -z "$home" ] || [ ! -d "$home" ]; then
     echo "  [left] $u: no home known — not healed"; rc=1; continue
   fi
   private.oo.heal.user.diagnose "$u" "$home" "$base" "$branch" || rc=1
 done
 if [ "$rc" = 0 ]; then
   create.result 0 "canonical: $base/$branch"
 else
   create.result 1 "not canonical — run: oo heal $branch $who"
 fi
 return $(result)
}
oo.heal.status.completion.branch() {
  private.this.script.load ogit ogit.branch.list && ogit.branch.list remote
}
oo.heal.status.completion.who() {
  private.this.script.load user user.list && user.list
  echo all
}

private.oo.heal.env.clean()     # <?branch> <?who> <?tree> # run oo heal of <tree> (the folder this oo is in) again in ONE clean process: env -i keeping HOME USER LOGNAME TERM LANG LC_ALL LOG_LEVEL OOSH_REPO SSH_AUTH_SOCK, with OOSH_HEAL_CLEAN=1, OOSH_DIR=<tree>, CONFIG naming a file that is not there and PATH = <tree> and the system PATH; rc of that process #
{
 # Called by oo.start BEFORE `source this` (a fresh computer has no `this` on
 # PATH, an old one the wrong one), so nothing of oosh is used here: plain
 # bash only. CONFIG names <tree>/.heal.noconfig, a file that is not there,
 # so the cold start of `this` never sources an old ~/config/user.env; an
 # OOSH_DIR set from outside survives `this` (T-OO-HEAL-NO-USERENV-READ).
 # "$BASH": the bash running now — under env -i on macOS `bash` would be the
 # system's 3.2.
 local branch="$1" who="$2" tree="$3" args=()
 if [ -z "$tree" ]; then
   # The physical folder of this file: plain bash, `this` is not loaded yet.
   tree=$(cd "${BASH_SOURCE[0]%/*}" 2>/dev/null && pwd -P)
 fi
 [ -n "$branch" ] && args+=("$branch")
 [ -n "$who" ] && args+=("$who")
 # oosh-dir-exception: the heal runs from the tree it was started from (a temp clone in the curl form); ~/oosh is what it repairs
 # path-exception: the one clean PATH of the heal process — <tree>, the bash it runs under and the system directories
 env -i HOME="$HOME" USER="${USER:-$(id -un)}" LOGNAME="${LOGNAME:-$(id -un)}" TERM="${TERM:-dumb}" LANG="$LANG" LC_ALL="$LC_ALL" LOG_LEVEL="${LOG_LEVEL:-3}" OOSH_REPO="$OOSH_REPO" SSH_AUTH_SOCK="$SSH_AUTH_SOCK" OOSH_HEAL_CLEAN=1 OOSH_DIR="$tree" CONFIG="$tree/.heal.noconfig" PATH="$tree:${BASH%/*}:$(private.oo.heal.path.system.get)" "$BASH" "$tree/oo" heal "${args[@]}"
}

private.oo.heal.path.system.get()     #  # echo the system PATH of a clean process: /usr/local, /usr and / bin and sbin, and on macOS Homebrew's /opt/homebrew; silent getter #
{
 # NO create.result — a getter consumed as $(...), and plain bash: env.clean
 # calls it before `this` is loaded. /usr/local/bin is where the launcher and
 # an Intel Homebrew bash live, /opt/homebrew/bin an Apple-silicon one.
 case "$OSTYPE" in
   darwin*) echo "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin" ;;
   *)       echo "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" ;;
 esac
}

private.oo.heal.branch.get()     #  # echo the branch oo heal heals to by default: the branch of the tree it runs from, else $OOSH_BRANCH, else dev; silent getter #
{
 # Owner decision 3: the branch of the tree that runs the heal — in the curl
 # form a fresh clone of the branch asked for.
 private.this.script.load ogit ogit.branch.get
 local branch
 branch=$(ogit.branch.get "$OOSH_DIR" 2>/dev/null)
 [ -n "$branch" ] || branch="$OOSH_BRANCH"
 [ -n "$branch" ] || branch=dev
 echo "$branch"
}

private.oo.heal.basehome.get()     #  # echo the folder the homes of this computer live in: the parent of the home of developking, else /Users on macOS and /home elsewhere; silent getter #
{
 # The base of the standard model hangs under it (<basehome>/shared/EAMD.ucp),
 # the rule config.init.user and install state 31 use (user get basehome).
 # Before developking exists (a computer the heal sets up) the platform's
 # home folder stands in.
 private.this.script.load user user.get
 local devHome
 devHome=$(user.get home developking 2>/dev/null)
 if [ -n "$devHome" ]; then
   echo "${devHome%/*}"
   return 0
 fi
 case "$OSTYPE" in darwin*) echo /Users ;; *) echo /home ;; esac
}

private.oo.heal.path.get()     # <basehome> <which> # echo a path of the standard model under <basehome>: base (the components base, Once.sh) or sharedConfig; silent getter #
{
 # The two paths install state 31 and config.init.user spell out; one place
 # for the heal (the tests replace it with a fixture).
 local basehome="${1%/}"
 case "$2" in
   base)         echo "$basehome/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh" ;;
   sharedConfig) echo "$basehome/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig" ;;
   *)            return 1 ;;
 esac
}

private.oo.heal.root.check()     #  # rc 0 when this process may act as root: it is root, or sudo works — without a password, or after asking for it once on a terminal #
{
 # A predicate: rc only. $SUDO is the framework's prefix ("" for root,
 # "sudo " for a user); the tests replace it with a recorder, never a prompt.
 [ "$(id -u)" = 0 ] && return 0
 [ -n "$SUDO" ] || return 1
 $SUDO -n true 2>/dev/null && return 0
 [ -t 0 ] || return 1
 $SUDO -v
}

private.oo.heal.system.diagnose()     # <base> <branch> # print, read-only, what of the system part is not canonical: group dev, developking and its home, the base with group dev and setgid, main and <branch> under it (private.oo.heal.folder.gate), linked worktrees, the launcher, the retired drop-in, the install state; rc 1 when anything is not canonical #
{
 private.this.script.load ogit ogit.branch.get
 private.this.script.load user user.get
 local base="$1" branch="$2" rc=0 devHome folder verdict d state machine folders=main reason
 [ "$branch" = main ] || folders="main $branch"
 if private.this.group.exists dev; then echo "  [ok]   group dev"; else echo "  [heal] group dev missing — created"; rc=1; fi
 devHome=$(user.get home developking 2>/dev/null)
 if [ -z "$devHome" ]; then
   echo "  [heal] developking missing — created, in group dev"; rc=1
 elif [ ! -d "$devHome" ]; then
   echo "  [heal] developking has no home ($devHome) — created"; rc=1
 else
   echo "  [ok]   developking ($devHome)"
 fi
 if [ ! -d "$base" ]; then
   echo "  [heal] base $base missing — created"; rc=1
 elif private.this.group.exists dev && { [ "$(private.this.path.stat.get "$base" group)" != dev ] || [ ! -g "$base" ]; }; then
   echo "  [heal] base $base is not group dev with setgid — set"; rc=1
 else
   echo "  [ok]   base $base"
 fi
 for folder in $folders; do
   verdict=$(private.oo.heal.folder.gate "$base/$folder" "$folder")
   case "$verdict" in
     keep)        echo "  [ok]   $folder: a clean clone of $folder" ;;
     missing)     echo "  [heal] $folder: missing — cloned"; rc=1 ;;
     fastforward) echo "  [heal] $folder: behind origin/$folder — fast-forwarded"; rc=1 ;;
     aside)
       # The reason, from the same probes the gate used.
       if [ -L "$base/$folder" ]; then reason="a link"
       elif ! private.oo.update.pull.gate "$base/$folder" >/dev/null 2>&1; then reason="${RESULT%% — run:*}"
       else reason="on $(ogit.branch.get "$base/$folder"), not $folder"; fi
       echo "  [heal] $folder: $reason — moved to $base.aside, cloned again"; rc=1 ;;
     worktree)    echo "  [heal] $folder: a linked worktree — converted with ogit worktree.remove when its gate lets it"; rc=1 ;;
     *)           echo "  [left] $folder: $base/$folder is not a repository and not empty — oo heal stops there"; rc=1 ;;
   esac
 done
 if [ -d "$base" ]; then
   while IFS= read -r d; do
     case "${d##*/}" in main|"$branch") continue ;; esac
     [ "$(private.ogit.folder.shape "$d")" = worktree ] && { echo "  [heal] ${d##*/}: a linked worktree — converted with ogit worktree.remove"; rc=1; }
   done < <(private.ogit.base.folders.list "$base")
 fi
 if private.this.file.same "$OOSH_DIR/templates/user/thisLauncher" /usr/local/bin/this; then
   echo "  [ok]   launcher /usr/local/bin/this"
 else
   echo "  [heal] launcher /usr/local/bin/this missing or old — installed"; rc=1
 fi
 if [ -e /etc/oosh/boot ] || [ -L /etc/oosh/boot ] || grep -q 'oosh' /etc/profile.d/oosh.sh 2>/dev/null; then
   echo "  [heal] the retired login drop-in (/etc/profile.d/oosh.sh, /etc/oosh/boot) — removed"; rc=1
 fi
 machine=$(sed -n 's/^machine=//p' "$HOME/config/current.state.machine.env" 2>/dev/null)
 state=$(sed -n 's/^state=//p' "$HOME/config/current.state.machine.env" 2>/dev/null)
 if [ "$machine" = SETUP_SERVER ] && [ "$state" = 99 ]; then
   echo "  [ok]   install state 99"
 else
   echo "  [heal] install state ${machine:-none} ${state:-?} — SETUP_SERVER 99 after a green verify"; rc=1
 fi
 return "$rc"
}

# ogit-exception: docstring text, not an invocation
private.oo.heal.user.diagnose()     # <user> <home> <base> <branch> # print, read-only, what is not canonical in <home>: ~/oosh (canonical, foreign, worktree, plain-clone, plain-dir or none) and the git state of its tree, ~/config, old env formats in a real one, the .bashrc, a PATH line in ~/.once, legacy ssh.* folders, dead safe.directory entries, mode-env.bash, self-links of old installs, old backups; rc 1 when anything is not canonical #
{
 private.this.script.load ogit ogit.branch.get
 private.this.script.load user user.ssh.backup.status
 local user="$1" home="$2" base="$3" branch="$4" rc=0 kind target="" baseReal sharedConfig link cfg f found entry dead=0 name
 baseReal=$(private.this.path.canonical "$base" 2>/dev/null || echo "$base")
 # <base> is <basehome>/shared/EAMD.ucp/Components/…: its sharedConfig is beside it.
 sharedConfig=$(private.oo.heal.path.get "${base%%/shared/EAMD.ucp/*}" sharedConfig)
 # ~/oosh
 if [ -L "$home/oosh" ]; then
   target=$(private.this.path.canonical "$home/oosh" 2>/dev/null)
   if [ -z "$target" ] || [ ! -d "$target" ]; then kind=none
   elif [ "${target%/*}" = "$baseReal" ]; then kind=canonical
   else kind=foreign; fi
 elif [ -d "$home/oosh" ]; then
   target=$(private.this.path.canonical "$home/oosh" 2>/dev/null)
   case "$(private.ogit.folder.shape "$home/oosh")" in
     worktree) kind=worktree ;;
     clone)    kind=plain-clone ;;
     *)        kind=plain-dir ;;
   esac
 else
   kind=none
 fi
 case "$kind" in
   canonical)
     if [ "${target##*/}" = "$branch" ]; then
       echo "  [ok]   $user ~/oosh: canonical → $target"
     else
       echo "  [heal] $user ~/oosh: canonical → $target — linked to $branch (oo heal all keeps it)"; rc=1
     fi ;;
   foreign)
     echo "  [heal] $user ~/oosh: foreign → $target — linked to $base/$branch; $target is left untouched"; rc=1 ;;
   none)
     echo "  [heal] $user ~/oosh: none${target:+ (dangling)} — linked to $base/$branch"; rc=1 ;;
   *)
     echo "  [heal] $user ~/oosh: $kind — kept as ~/oosh.orig.<ts>, linked to $base/$branch"; rc=1 ;;
 esac
 # The git state of a tree outside the base (the base's own folders are the
 # system part's).
 if [ -n "$target" ] && [ -d "$target" ] && [ "$kind" != canonical ] && [ "$(private.ogit.folder.shape "$target")" != missing ]; then
   if private.oo.update.pull.gate "$target" >/dev/null; then
     echo "  [left] $user tree $target: $RESULT — untouched"
   else
     echo "  [left] $user tree $target: ${RESULT%% — run:*} — untouched"
   fi
 fi
 # ~/config
 if [ -L "$home/config" ]; then
   link=$(readlink "$home/config")
   if [ ! -d "$home/config" ]; then
     echo "  [heal] $user ~/config: dangling → $link — linked to $sharedConfig"; rc=1
   elif [ "$(private.this.path.canonical "$home/config")" = "$(private.this.path.canonical "$sharedConfig" 2>/dev/null)" ]; then
     echo "  [ok]   $user ~/config → sharedConfig"
   else
     echo "  [heal] $user ~/config → $link, not the sharedConfig — linked to $sharedConfig"; rc=1
   fi
 elif [ -d "$home/config" ]; then
   echo "  [heal] $user ~/config: a real folder — kept as config.orig.<ts>, an allow-listed few values imported, linked to $sharedConfig"; rc=1
 else
   echo "  [heal] $user ~/config: missing — linked to $sharedConfig"; rc=1
 fi
 # Old formats in a config that is not the sharedConfig: read as data.
 cfg="$home/config"
 if [ -d "$cfg" ] && [ "$(private.this.path.canonical "$cfg")" != "$(private.this.path.canonical "$sharedConfig" 2>/dev/null)" ]; then
   for f in user.env oosh.env log.env; do
     [ -f "$cfg/$f" ] || continue
     found=""
     # path-exception: the grep matches old PATH lines in a file read as data, not an assignment
     grep -Eq '^[[:space:]]*(export[[:space:]]+)?PATH=' "$cfg/$f" && found="$found PATH"
     grep -Eq '^[[:space:]]*(export[[:space:]]+)?HOME=' "$cfg/$f" && found="$found HOME"
     grep -Eq 'LOG_DEVICE="?/dev/stdout' "$cfg/$f" && found="$found LOG_DEVICE=/dev/stdout"
     grep -Eq 'CONFIG_CHAIN_' "$cfg/$f" && found="$found CONFIG_CHAIN_*"
     [ -n "$found" ] && echo "  [left] $user ~/config/$f: old format ($found ) — never carried over"
   done
 fi
 # .bashrc
 if ! private.this.file.same "$home/.bashrc" "$OOSH_DIR/templates/user/bashrcTemplate"; then
   echo "  [heal] $user ~/.bashrc is not the oosh template — installed, the old one kept"; rc=1
 fi
 # path-exception: matches the frozen PATH line of an old ~/.once, read as data
 if grep -Eq '^[[:space:]]*(export[[:space:]]+)?PATH=' "$home/.once" 2>/dev/null; then
   echo "  [heal] $user ~/.once freezes a PATH line — removed"; rc=1
 fi
 # Its verdict goes to the log too: a subshell with the log silenced, only the rc counts.
 if ! ( LOG_DEVICE=/dev/null; user.ssh.backup.status "$home" ) >/dev/null 2>&1; then
   echo "  [left] $user legacy ssh.* backup folders in $home — run: user ssh.backup.migrate"; rc=1
 fi
 if [ -f "$home/.gitconfig" ]; then
   while IFS= read -r entry; do
     [ -n "$entry" ] && [ "$entry" != '*' ] && [ ! -e "$entry" ] && dead=$((dead + 1))
   done < <(GIT_CONFIG_GLOBAL="$home/.gitconfig" ogit.safeDirectory.list 2>/dev/null)
   [ "$dead" -gt 0 ] && { echo "  [heal] $user $dead safe.directory entries point nowhere — pruned"; rc=1; }
 fi
 # path-exception: matches the PATH rewrite of an old mode-env.bash, read as data
 if grep -q 'PATH=' "$home/.config/oosh/mode-env.bash" 2>/dev/null; then
   echo "  [heal] $user ~/.config/oosh/mode-env.bash rewrites PATH — written again without it"; rc=1
 fi
 if [ -n "$target" ] && [ -d "$target" ]; then
   for name in oosh "${target##*/}"; do
     [ -L "$target/$name" ] && { echo "  [heal] $user self-link $target/$name from an old install — removed"; rc=1; }
   done
 fi
 for name in config.initial config.orig oosh.orig; do
   [ -e "$home/$name" ] && echo "  [keep] $user ~/$name: an old backup — kept"
 done
 return "$rc"
}

private.oo.heal.folder.gate()     # <dir> <branch> # echo what oo heal does with a canonical folder: missing (absent or empty), keep (a clean clone of <branch>, up to date or ahead), fastforward (clean and behind origin/<branch>), aside (merge in progress, committed conflict markers, dirty, detached, diverged, another branch, or a link), worktree (a linked worktree), occupied (not a repository and not empty); read-only, silent getter #
{
 # NO create.result — a getter consumed as $(...). The probes are oo update's
 # (private.oo.update.pull.gate): one gate for the pull and the heal. It
 # compares with the origin refs the folder has; oo heal fetches first.
 private.this.script.load ogit ogit.branch.get
 local dir="${1%/}" branch="$2" verdict
 if [ -L "$dir" ]; then echo aside; return 0; fi
 if [ ! -e "$dir" ] || { [ -d "$dir" ] && [ -z "$(ls -A "$dir" 2>/dev/null)" ]; }; then echo missing; return 0; fi
 case "$(private.ogit.folder.shape "$dir")" in
   worktree) echo worktree; return 0 ;;
   missing)  echo occupied; return 0 ;;
 esac
 if ! private.oo.update.pull.gate "$dir" >/dev/null 2>&1; then echo aside; return 0; fi
 verdict="$RESULT"
 if [ "$(ogit.branch.get "$dir")" != "$branch" ]; then echo aside; return 0; fi
 case "$verdict" in
   *"commits behind"*) echo fastforward ;;
   *)                  echo keep ;;
 esac
}

private.oo.heal.folder.aside()     # <dir> # move a canonical folder, whole, out of the base to <base>.aside/<name>.<ts> — a sibling of the base, never a branch folder — and never delete it; refuses the tree oo heal runs from; RESULT = the new path #
{
 # Owner decision 6: a broken canonical folder (merge in progress, committed
 # markers, detached, diverged, dirty) is moved aside and cloned again; the
 # move is reported, nothing is deleted (T-OO-HEAL-ASIDE-NEVER-DELETES). The
 # tree the heal runs from is never moved (T-OO-HEAL-NOT-OWN-TREE): the curl
 # form runs from a fresh clone.
 local dir="${1%/}" base name aside stamp ts n=0 here target
 if [ -z "$dir" ]; then
   create.result 1 "private.oo.heal.folder.aside requires <dir>"; error.log "$RESULT"; return $(result)
 fi
 if [ ! -e "$dir" ] && [ ! -L "$dir" ]; then
   create.result 0 "nothing"; return $(result)
 fi
 here=$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null)
 target=$(private.this.path.canonical "$dir" 2>/dev/null)
 if [ -n "$here" ] && [ -n "$target" ] && { [ "$here" = "$target" ] || [ "${here#"$target"/}" != "$here" ]; }; then
   create.result 1 "$dir is the tree oo heal runs from — not moved; use the curl form: curl -fsSL https://raw.githubusercontent.com/Cerulean-Circle-GmbH/once.sh/dev/init/oosh | sh -s -- heal"
   error.log "$RESULT"; return $(result)
 fi
 base="${dir%/*}"; name="${dir##*/}"; aside="$base.aside"
 private.oo.shared.dir.ensure "$aside" >/dev/null || { error.log "$RESULT"; return $(result); }
 stamp=$(private.this.orig.stamp.get "$aside" "$name"); ts="$stamp"
 while [ -e "$aside/$name.$ts" ] || [ -L "$aside/$name.$ts" ]; do
   n=$((n + 1)); ts="$stamp-$n"
 done
 # The one mv of the heal: private.this.entry.aside keeps an entry BESIDE
 # itself (<path>.orig.<ts>), and the owner decided a canonical folder goes
 # to a sibling of the base, so it is never taken for a branch folder.
 if ! mv "$dir" "$aside/$name.$ts"; then
   create.result 1 "could not move $dir to $aside/$name.$ts"; error.log "$RESULT"; return $(result)
 fi
 warn.log "moved aside: $dir → $aside/$name.$ts (nothing deleted)"
 create.result 0 "$aside/$name.$ts"
 return $(result)
}

private.oo.heal.system()     # <branch> # the system part of the standard model: group dev, developking with a home, the shared base with group dev and setgid, the launcher (may ask for the sudo password once), no retired drop-in; rc 2 when a step needs root and there is neither root nor a working sudo #
{
 # As install state 31 does it, through the same methods; every step is
 # idempotent. A user heals their own account without sudo when the system
 # part is there already (the B3 heal arm runs before any sudo check).
 private.this.script.load user user.get
 local branch="$1" need="" devHome basehome base rc=0 left=""
 private.this.group.exists dev || need="$need group-dev"
 devHome=$(user.get home developking 2>/dev/null)
 [ -n "$devHome" ] || need="$need developking"
 [ -n "$devHome" ] && [ ! -d "$devHome" ] && need="$need developking-home"
 basehome=$(private.oo.heal.basehome.get)
 base=$(private.oo.heal.path.get "$basehome" base)
 [ -d "$base" ] || need="$need base"
 if [ -n "$need" ] && ! private.oo.heal.root.check; then
   create.result 2 "the system part needs root (${need# }) — run: sudo -H oo heal $branch"
   error.log "$RESULT"; return $(result)
 fi
 if ! private.this.group.create dev >/dev/null; then
   create.result 2 "could not create the group dev"; error.log "$RESULT"; return $(result)
 fi
 if [ -z "$devHome" ]; then
   user.create developking >/dev/null 2>&1
   user.group.add dev developking >/dev/null 2>&1
   devHome=$(user.get home developking 2>/dev/null)
   if [ -z "$devHome" ]; then
     create.result 2 "could not create developking"; error.log "$RESULT"; return $(result)
   fi
 fi
 if ! private.user.home.ensure developking >/dev/null; then
   create.result 2 "developking has no home — $RESULT"; error.log "$RESULT"; return $(result)
 fi
 basehome=$(private.oo.heal.basehome.get)
 base=$(private.oo.heal.path.get "$basehome" base)
 if ! private.oo.shared.base.ensure "$basehome" developking >/dev/null; then
   create.result 2 "the base $base could not be made — $RESULT"; error.log "$RESULT"; return $(result)
 fi
 private.oo.shared.base.share "$base" >/dev/null || { rc=1; left="$left; $RESULT"; }
 private.oo.install.launcher "$OOSH_DIR" /usr/local/bin/this interactive >/dev/null || { rc=1; left="$left; $RESULT"; }
 private.oo.dropin.remove >/dev/null || { rc=1; left="$left; $RESULT"; }
 if [ "$rc" = 0 ]; then
   create.result 0 "group dev, developking, the base $base, the launcher"
 else
   create.result 1 "system part made, left for you:${left#;}"
 fi
 return $(result)
}

private.oo.shared.base.share()     # <base> # give the components base group dev and the setgid bit, so a folder added later inherits the group; only when a dev group exists; $SUDO only when the caller does not own it; RESULT shared or exists; rc 1 when it cannot #
{
 # Install state 31 did it inline (chgrp dev + chmod g+ws on the base): one
 # place now, for the state and the heal. The base only — never recursive.
 local base="$1" asRoot=""
 if [ -z "$base" ] || [ ! -d "$base" ]; then
   create.result 1 "private.oo.shared.base.share requires an existing <base>, got '$base'"; error.log "$RESULT"; return $(result)
 fi
 if ! private.this.group.exists dev; then
   create.result 0 "no dev group — $base left as it is"; return $(result)
 fi
 if [ "$(private.this.path.stat.get "$base" group)" = dev ] && [ -g "$base" ]; then
   create.result 0 "exists"; return $(result)
 fi
 [ "$(private.this.path.stat.get "$base" owner)" = "$(id -un)" ] || asRoot="$SUDO"
 if ! { ${asRoot}chgrp dev "$base" && ${asRoot}chmod g+ws "$base"; }; then
   create.result 1 "cannot set group dev + setgid on $base — run: sudo chgrp dev $base && sudo chmod g+ws $base"
   error.log "$RESULT"; return $(result)
 fi
 create.result 0 "shared"
 return $(result)
}

private.oo.heal.code()     # <base> <branch> # the code part: <base>/main and <base>/<branch> as clean clones of origin — a folder the gate refuses is moved to <base>.aside and cloned again, a behind one fast-forwarded, linked worktrees converted (ogit worktree.remove) when their gate lets them; offline the tree running the heal is the source; every folder finished (shared, trusted), a path or bundle origin re-pointed at the canonical URL; rc 1 when something is left for you, 2 when there is no source #
{
 private.this.script.load ogit ogit.branch.get
 local base="$1" branch="$2" url="${OOSH_REPO:-https://github.com/Cerulean-Circle-GmbH/once.sh.git}"
 local rc=0 left="" folder d verdict worktreesLeft=no origin folders="main"
 if [ -z "$base" ] || [ -z "$branch" ] || [ ! -d "$base" ]; then
   create.result 2 "private.oo.heal.code requires an existing <base> and a <branch>, got '$base' '$branch'"; error.log "$RESULT"; return $(result)
 fi
 [ "$branch" = main ] || folders="main $branch"
 # Linked worktrees first: they live in main/.git — moving main aside would
 # orphan them.
 while IFS= read -r d; do
   [ "$(private.ogit.folder.shape "$d")" = worktree ] || continue
   if ! ogit.worktree.remove "$base" >/dev/null; then
     worktreesLeft=yes; rc=1; left="$left; linked worktrees under $base not converted — $RESULT"
   fi
   break
 done < <(private.ogit.base.folders.list "$base")
 for folder in $folders; do
   d="$base/$folder"
   # The gate compares with origin's refs: fetch them first (offline: the cached ones).
   [ "$(private.ogit.folder.shape "$d")" = clone ] && ogit.remote.fetch no "$d" >/dev/null 2>&1
   verdict=$(private.oo.heal.folder.gate "$d" "$folder")
   case "$verdict" in
     missing|keep) ;;
     fastforward)
       ogit.branch.fastForward "origin/$folder" "$d" >/dev/null \
         || { rc=1; left="$left; $d could not be fast-forwarded — $RESULT"; } ;;
     aside)
       if [ "$folder" = main ] && [ "$worktreesLeft" = yes ]; then
         rc=1; left="$left; $d is not clean and holds linked worktrees — not moved"
       elif private.oo.heal.folder.aside "$d" >/dev/null; then
         rc=1; left="$left; $d moved to $RESULT (look at it, then remove it yourself)"
       else
         rc=1; left="$left; $RESULT"
       fi ;;
     worktree)
       rc=1; left="$left; $d is a linked worktree — convert it: ogit worktree.remove $base" ;;
     *)
       create.result 2 "$d is not a repository and not empty — move it away, then run oo heal again"
       error.log "$RESULT"; return $(result) ;;
   esac
 done
 # Offline, the tree running the heal is the source — never ~/oosh, which
 # can be the broken tree (T-OO-HEAL-CODE-LOCAL-SOURCE).
 if ! private.oo.shared.tree.ensure "$url" "$base" "$branch" "$OOSH_DIR" >/dev/null; then
   create.result 2 "no source for $base: $RESULT"; error.log "$RESULT"; return $(result)
 fi
 for folder in $folders; do
   d="$base/$folder"
   [ "$(private.ogit.folder.shape "$d")" = clone ] || continue
   origin=$(ogit.remote.url.get origin "$d")
   case "$origin" in
     /*|./*|../*|file://*|*.bundle)
       [ "$origin" = "$url" ] || ogit.remote.url.set "$url" origin "$d" >/dev/null \
         || { rc=1; left="$left; the origin of $d stays $origin — $RESULT"; } ;;
   esac
   ogit.folder.finish "$d" >/dev/null || { rc=1; left="$left; $RESULT"; }
 done
 if [ "$rc" = 0 ]; then
   create.result 0 "$base/main and $base/$branch are clean clones"
 else
   create.result 1 "clones stand, left for you:${left#;}"
 fi
 return $(result)
}

private.oo.heal.config()     # <sharedConfig> # the shared config: made (private.oo.shared.dir.ensure, owner developking) when it is missing — config init.env fills it later — then config init.shared (2775, group dev, no self-loops); rc 2 when it cannot be made #
{
 # A missing sharedConfig is NOT seeded from a real ~/config: that is the old
 # format the owner keeps aside (config.orig.<ts>) and imports from by an
 # allow-list (private.config.orig.import, the user step).
 local sharedConfig="$1" made=""
 if [ -z "$sharedConfig" ]; then
   create.result 2 "private.oo.heal.config requires <sharedConfig>"; error.log "$RESULT"; return $(result)
 fi
 if [ ! -d "$sharedConfig" ]; then
   if ! private.oo.shared.dir.ensure "$sharedConfig" developking >/dev/null; then
     create.result 2 "the sharedConfig $sharedConfig could not be made — $RESULT"; error.log "$RESULT"; return $(result)
   fi
   made=" (made empty — config init.env fills it)"
 fi
 private.this.script.load config config.init.shared
 if ! config.init.shared >/dev/null 2>&1; then
   create.result 1 "config init.shared reported a problem with $sharedConfig — run: config init.shared"
   return $(result)
 fi
 create.result 0 "$sharedConfig$made"
 return $(result)
}

private.oo.heal.user()     # <user> <base> <branch> <sharedConfig> <?keep:no> # heal one user: ~/oosh → <base>/<branch> and ~/config → <sharedConfig> (config.init.user), a real ~/config kept as config.orig.<ts> with an allow-listed import, then as the user their session files with OOSH_MODE=<branch>, mode-env.bash and the shell step; self-links of old installs removed; keep yes leaves a canonical ~/oosh on its branch #
{
 private.this.script.load user user.get
 private.this.script.load config config.init.user
 local user="$1" base="$2" branch="$3" sharedConfig="$4" keep="${5:-no}" home link wasReal=no orig rc=0 left="" tree name
 home=$(user.get home "$user" 2>/dev/null)
 if [ -z "$home" ] || [ ! -d "$home" ]; then
   create.result 1 "$user has no home — not healed"; warn.log "$RESULT"; return $(result)
 fi
 # Under all, a user who is canonical already keeps their branch.
 if [ "$keep" = yes ] && [ -L "$home/oosh" ]; then
   link=$(readlink "$home/oosh")
   [ "${link%/*}" = "$base" ] && [ -d "$link" ] && branch="${link##*/}"
 fi
 [ -d "$home/config" ] && [ ! -L "$home/config" ] && wasReal=yes
 if ! config.init.user "$user" "$base/$branch" >/dev/null 2>&1; then
   create.result 1 "config init.user $user $base/$branch failed — run it to see why"; error.log "$RESULT"; return $(result)
 fi
 if [ "$wasReal" = yes ]; then
   # The stamp config.init.user's move used: the newest config.orig.<ts>.
   orig=$(ls -1d "$home"/config.orig.* 2>/dev/null | sort | tail -1)
   if [ -n "$orig" ]; then
     private.config.orig.import "$orig" "$sharedConfig" >/dev/null \
       || { rc=1; left="$left; the import from $orig failed — $RESULT"; }
     important.log "$user: the real ~/config is kept as $orig"
   fi
 fi
 # As the user, in their own environment from the shared tree: their PATH
 # and OOSH_MODE (config session.save), mode-env.bash as oo mode writes it,
 # and the shell step oo update runs. The functions come from the tree that
 # runs the heal (the branch folder may be an older version without them).
 # path-exception: a string executed AS THE USER: their PATH from the branch folder and the system, never the heal's temp tree
 if ! private.as.user "$user" "$BASH" -c "$(private.this.as.user.preamble.get "$user" "$home" "$base/$branch")
export PATH=\"$base/$branch:$base/$branch/ng:$(private.oo.heal.path.system.get)\"
source '$OOSH_DIR/oo' >/dev/null 2>&1 || exit 1
private.this.script.load config config.session.save || exit 1
export OOSH_MODE='$branch'
config.session.save >/dev/null || exit 1
private.oo.mode.env.write '$branch' >/dev/null || exit 1
private.oo.heal.shell \"\$HOME\" '$base'" >/dev/null 2>&1; then
   rc=1; left="$left; the session files, mode-env.bash or the shell step of $user failed — run as $user: config session.save"
 fi
 # Self-links an old non-root install left in the tree (<branch>/<branch>,
 # ~/oosh/oosh): links only, and only when git does not track them.
 tree="$base/$branch"
 for name in oosh "$branch"; do
   [ -L "$tree/$name" ] || continue
   ogit.repo.files.list "$tree" | grep -qx "$name" && continue
   if rm -f "$tree/$name"; then
     important.log "removed the self-link $tree/$name of an old install"
   else
     rc=1; left="$left; could not remove the self-link $tree/$name"
   fi
 done
 if [ "$rc" = 0 ]; then
   create.result 0 "~/oosh → $base/$branch, ~/config → sharedConfig, OOSH_MODE=$branch"
 else
   create.result 1 "$user linked, left for you:${left#;}"
 fi
 return $(result)
}

private.oo.mode.env.write()     # <branch> <?oldBranch> # write ~/.config/oosh/mode-env.bash, which the oo shim sources into the parent shell: hash -r and OOSH_MODE=<branch>, and only when <oldBranch> is given and differs the PATH repair from <oldBranch> to <branch>; rc 1 when it cannot write #
{
 # oo mode and oo heal write it alike; the heal gives no old branch, so the
 # PATH rewrite an old file carried is not written again.
 local branch="$1" oldBranch="$2" f="$HOME/.config/oosh/mode-env.bash"
 if [ -z "$branch" ]; then
   create.result 1 "private.oo.mode.env.write requires <branch>"; error.log "$RESULT"; return $(result)
 fi
 mkdir -p "${f%/*}" 2>/dev/null
 if ! {
   if [ -n "$oldBranch" ] && [ "$oldBranch" != "$branch" ]; then
     # path-exception: a PATH repair EMITTED for the shim to source into the parent shell
     echo "PATH=\$(echo \"\$PATH\" | sed \"s|/${oldBranch}:|/${branch}:|g;s|/${oldBranch}\\\$|/${branch}|\")"
   fi
   echo "hash -r"
   echo "export OOSH_MODE=\"$branch\""
 } > "$f" 2>/dev/null; then
   create.result 1 "cannot write $f"; return $(result)
 fi
 create.result 0 "$f"
 return $(result)
}

# ogit-exception: docstring text, not an invocation
private.oo.heal.shell()     # <?home:$HOME> <?base> <?load:yes> # the shell step oo update and oo heal share: git trust of every folder under <base> (else oo mode.base.get) and no dead safe.directory entry, the oosh .bashrc and the session files of <home> (load yes), no retired drop-in, the launcher (quiet), no frozen PATH in ~/.once; load no skips the steps that load config or user (a tree with conflict markers) #
{
 # Owner decision 8: one shell step for oo update and oo heal (T-OO-HEAL-
 # SHELL-SHARED-WITH-UPDATE). No create.result of its own at the end: oo
 # update's RESULT is the pull's.
 private.this.script.load ogit ogit.branch.get
 local home="${1:-$HOME}" base="$2" load="${3:-yes}" rc=0
 # Trust: in the clone layout every folder under the base is its own
 # repository and needs its own safe.directory entry (spec § 4). No base yet
 # (the installer's first pass, before state 31): nothing to trust.
 [ -n "$base" ] || base=$(oo.mode.base.get 2>/dev/null)
 if [ -n "$base" ]; then
   ogit.safeDirectory.ensure "$base" >/dev/null || { warn.log "could not ensure safe.directory — $RESULT"; rc=1; }
 else
   info.log "no components base yet — safe.directory ensure skipped"
 fi
 ogit.safeDirectory.prune >/dev/null 2>&1
 if [ "$load" = yes ]; then
   if private.this.script.load user private.user.bashrc.install; then
     private.user.bashrc.install "$home" "$OOSH_DIR" >/dev/null || { warn.log "the oosh .bashrc of $home — $RESULT"; rc=1; }
   fi
   if private.this.script.load config private.config.session.file.ensure; then
     private.config.session.file.ensure "$home" >/dev/null || { warn.log "the session files of $home — $RESULT"; rc=1; }
   fi
 fi
 # boot is gone: the host-wide login drop-in it needed goes too.
 private.oo.dropin.remove >/dev/null
 # The launcher an empty shell finds `this` through (`env -i sh`, then `this`).
 private.oo.install.launcher >/dev/null
 # An old ~/.once froze a PATH that overwrote the user's own at shell start.
 private.oo.once.path.migrate "$home"
 return "$rc"
}

private.oo.heal.env()     # <?home:$HOME> # once, in a fresh process of this user (env -i, ~/oosh/this, the shared config): config init.env writes the env files again, config validate required checks them; rc 1 naming what is missing #
{
 local home="${1:-$HOME}" out rc
 # path-exception: the PATH of a fresh process of this user, from ~/oosh and the system
 out=$(env -i HOME="$home" USER="$(id -un)" LOGNAME="$(id -un)" TERM="${TERM:-dumb}" LOG_LEVEL=1 PATH="$home/oosh:$home/oosh/ng:$(private.oo.heal.path.system.get)" \
   "$BASH" -c 'source "$HOME/oosh/this" >/dev/null 2>&1 || exit 2; config init.env >/dev/null 2>&1; config validate required' 2>&1); rc=$?
 if [ "$rc" = 0 ]; then
   create.result 0 "env files written again, every required variable present"
 else
   create.result 1 "config validate required (rc $rc): $(printf '%s\n' "$out" | tr -d '\033' | sed 's/\[[0-9;]*m//g' | grep -v '^[[:space:]]*$' | tail -3 | tr '\n' ' ')— run: config init.env"
 fi
 return $(result)
}

private.oo.heal.users.list()     #  # echo the users oo heal all heals, one per line: root, developking, and every user.list entry whose home holds ~/oosh or ~/config (a link, even a dangling one, or a real entry); silent getter #
{
 # NO create.result — a getter consumed as $(...).
 private.this.script.load user user.list
 local u home seen=" "
 for u in root developking $(user.list); do
   case "$seen" in *" $u "*) continue ;; esac
   seen="$seen$u "
   case "$u" in
     root|developking) echo "$u"; continue ;;
   esac
   home=$(user.get home "$u" 2>/dev/null)
   [ -n "$home" ] || continue
   if [ -e "$home/oosh" ] || [ -L "$home/oosh" ] || [ -e "$home/config" ] || [ -L "$home/config" ]; then
     echo "$u"
   fi
 done
}

private.oo.heal.verify()     # <user> <home> # run the platform invariants configLayout, layout, boot and oosh as <user> in a fresh process; one line each: PASS <inv> <user> | FAIL <inv> <user>: <its recovery> | NOT CHECKED <inv> <user>: <why>; rc 1 on a FAIL #
{
 # Status idiom: the lines are plain echo. An invariant that cannot run here
 # is NOT CHECKED, with the reason, and does not fail the heal.
 local user="$1" home="$2" inv f out r fail rc=0 checked=0 failed=0
 for inv in configLayout layout boot oosh; do
   f="$home/oosh/test/test.platform.shared.$inv.invariant"
   if [ "$user" != "$(id -un)" ] && [ "$(id -u)" != 0 ]; then
     echo "  NOT CHECKED $inv $user: only root runs another user's invariants"; continue
   fi
   if [ ! -f "$f" ]; then
     echo "  NOT CHECKED $inv $user: $f is not in this branch"; continue
   fi
   # path-exception: the PATH of a fresh process of <user>, from their ~/oosh and the system
   out=$(private.as.user "$user" env -i HOME="$home" USER="$user" LOGNAME="$user" TERM="${TERM:-dumb}" \
     PATH="$home/oosh:$home/oosh/ng:$(private.oo.heal.path.system.get)" "$BASH" -c \
     "cd \"\$HOME/oosh\" && ./test.suite run platform.shared.$inv.invariant 1" 2>&1); r=$?
   checked=$((checked + 1))
   if [ "$r" = 0 ]; then
     echo "  PASS $inv $user"
   else
     fail=$(printf '%s\n' "$out" | tr -d '\033' | sed 's/\[[0-9;]*m//g' | grep -a 'FAIL:' | head -1 | sed 's/.*FAIL:[[:space:]]*//')
     echo "  FAIL $inv $user: ${fail:-rc $r}"
     rc=1; failed=$((failed + 1))
   fi
 done
 if [ "$rc" = 0 ]; then
   create.result 0 "$checked invariant(s) PASS for $user"
 else
   create.result 1 "$failed of $checked invariant(s) FAIL for $user — the FAIL lines above name the recovery"
 fi
 return $(result)
}

private.oo.heal.note()     # <rc> <step> <text> # add one line to the summary of oo heal and raise its rc to <rc> when that is higher #
{
 # healNotes and healRc are oo.heal's locals (dynamic scope).
 local r="${1:-1}" step="$2" text="$3"
 healNotes="${healNotes}$r|$step|$text"$'\n'
 [ "$r" -gt "${healRc:-0}" ] && healRc="$r"
 return 0
}

private.oo.heal.summary()     #  # print the summary of oo heal, one line per step (healed, left, cannot), and its rc; on rc 0 the install state SETUP_SERVER is set to 99 #
{
 # Owner decision 10: after a green verify the install state is 99, so
 # `ossh install` skips the computer and `oo state` agrees.
 local r step text mark
 echo "oo heal — summary"
 while IFS='|' read -r r step text; do
   [ -n "$step" ] || continue
   case "$r" in 0) mark="healed" ;; 1) mark="left  " ;; *) mark="cannot" ;; esac
   echo "  $mark  $step: $text"
 done <<< "$healNotes"
 case "${healRc:-0}" in
   0)
     if private.oo.heal.state.finish >/dev/null; then
       create.result 0 "healed — every invariant PASS, install state 99; oo mode <branch> works"
     else
       create.result 1 "healed, but the install state could not be set to 99 — $RESULT"
     fi ;;
   1) create.result 1 "something is left for you — the lines marked left above" ;;
   *) create.result 2 "cannot heal — the line marked cannot above" ;;
 esac
 echo "rc $(result): $RESULT"
 return $(result)
}

private.oo.heal.state.finish()     #  # set the install state machine SETUP_SERVER of this computer to 99, creating it first when it is missing, so ossh install skips it and oo state agrees; rc 1 when it cannot #
{
 private.this.script.load state state.set || { create.result 1 "state is not loadable from $OOSH_DIR"; return $(result); }
 if ! state.machine.exists SETUP_SERVER >/dev/null 2>&1; then
   private.oo.state.machine.create SETUP_SERVER >/dev/null 2>&1
 fi
 state.set SETUP_SERVER 99 >/dev/null 2>&1
 if [ "$(sed -n 's/^state=//p' "$CONFIG_PATH/current.state.machine.env" 2>/dev/null)" = 99 ]; then
   create.result 0 "SETUP_SERVER at 99"
 else
   create.result 1 "SETUP_SERVER could not be set to 99 in $CONFIG_PATH"
 fi
 return $(result)
}

private.oo.state.machine.create()     # <?machine:SETUP_SERVER> # create the install state machine with every state of the install lane, standing at setup; nothing is advanced #
{
 # The state list of the install, in one place: private.init.state.machine
 # creates it and advances; oo heal creates it and sets 99. The order and the
 # numbers are pinned by T-OO-STATE-34.
 local machine="${1:-SETUP_SERVER}"
 private.this.script.load state state.add || { create.result 1 "state is not loadable from $OOSH_DIR"; return $(result); }
 state.machine.create "${machine}" oo
 state.add remote.install.started               silent
 state.add local.install.started                silent
 state.add priviledges.checked                  silent
 state.add 20                                   silent
 state.add user.rights.only                     silent
 state.add user.installation.done               silent
 state.add user.mode.release                    silent
 state.add user.mode.dev                        silent
 state.add 30                                   silent
 state.add root.rights                          silent
 state.add root.shared.dev.folder.created       silent
 state.add root.dev.keys.installed              silent
 state.add root.installation.done               silent
 # State 34 — once the fixed host-wide boot path (T9), now the removal of that
 # retired login drop-in (private.oo.dropin.remove). Inserted HERE, after
 # the last named 30-lane state and before the `40` transition marker, so it
 # lands at 34 and pushes only the marker to 35: state.add treats a numeric
 # argument as a jump, so no existing state NUMBER moves (many are hard-coded
 # in comments across oo and ossh). Pinned by T-OO-STATE-34 in test/test.oo.
 state.add root.boot.path.installed             silent
 state.add 40                                   silent
 state.add user.shared.dev.folder.linked        silent
 state.add user.state.machine.synced.with.root  silent
 state.add 50                                   silent
 state.add headless.setup.started               silent
 state.add headless.setup.finished              silent
 state.add 60                                   silent
 state.add once.setup.started                   silent
 state.add once.setup.finished                  silent
 create.result 0 "${machine} created"
 return $(result)
}

