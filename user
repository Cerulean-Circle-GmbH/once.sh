private.user.ssh.tree.handover()     # <username> <targetHome> # hand the whole ~/.ssh of <targetHome> over to <username> and their login group, recursively, as dev did after the shared-file copy and the osshLayout build; nothing when there is no ~/.ssh; rc 1 when the chown fails #
{
 # dev's hand-over, in one place: after the shared-file copy and after the
 # root-run osshLayout build, the whole ~/.ssh goes to <user> and their login
 # group (`chown <user>:` — a platform.test container has "test" with gid 0
 # and no group "test"). Mandate 1 keeps dev's behaviour: what was there
 # before — a root-owned ids/ of an earlier run, developking's template tree —
 # is handed over too (T-USER-OOSH-INSTALL-SSH-HANDOVER). chown -R follows no
 # link inside: ids/ holds real-file copies (test.osshLayout).
 local username="$1" targetHome="$2"
 if [ -z "$username" ] || [ -z "$targetHome" ]; then
   create.result 1 "private.user.ssh.tree.handover requires <username> <targetHome>"
   return $(result)
 fi
 # Asked through $SUDO: the caller of user create (test, in a platform
 # container) cannot traverse the new user's 750 home, and a plain [ -d ]
 # answered no ~/.ssh — nothing was handed over (T-USER-SSH-HANDOVER-UNREADABLE-HOME).
 if ! $SUDO test -d "$targetHome/.ssh"; then
   create.result 0 "no ~/.ssh under $targetHome"; return $(result)
 fi
 if $SUDO chown -R "$username:" "$targetHome/.ssh" 2>/dev/null; then # recursive-exception: the user's own .ssh tree, handed over as on dev # kernel-exception: hand-over of a pre-existing tree to its user, dev behaviour
   create.result 0 "$targetHome/.ssh handed over to $username"
 else
   create.result 1 "could not hand $targetHome/.ssh over to $username"
 fi
 return $(result)
}


