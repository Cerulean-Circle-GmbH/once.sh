user.login() # <userName> # switch to userName via login shell — cd to target home and reset env; only TERM is kept #
{
  # `su -` (login shell) — without it, su keeps the caller's cwd and PATH,
  # so e.g. `user login alice` from /home/bob lands alice in /home/bob
  # which she can't even read (drwxr-x--- bob:bob). A login shell runs
  # alice's .profile/.bashrc, cds to ~alice, and resets HOME/USER/etc.
  # `env -i`: the target gets a CLEAN environment — none of the caller's PATH,
  # HOME or anchors. TERM is the one exception, passed explicitly: it describes
  # the TERMINAL, not the caller. Without it su sets TERM=dumb, and the shell
  # loses colour (git prints `## dev...origin/dev` plain) and less, vi, clear
  # and tmux degrade — seen in the ubuntu_24_04 platform container, 2026-09-29.
  env -i TERM="$(private.user.login.term.get)" su - "$1"
}

user.group.add() # <groupName> <?toUsername> # adds <toUsername> to group <groupName> if both exist
{

  local groupName="$1"
  if [ -n "$1" ]; then
    groupName="$1"
    shift
  else
    error.log "no ${YELLOW}groupName${RED} was specified"
    return 1
  fi 

  local toUsername="$1"
  if [ -n "$1" ]; then
    toUsername="$1"
    shift
  else
    console.log "no ${YELLOW}toUsername${NORMAL} was specified"
  fi 

  os.check.env
  # Idempotent: an existing group is not created again and an existing member
  # is not added again — no $SUDO at all then. config.init.user runs this for
  # dev on every oo update; a user without passwordless sudo was asked for a
  # password each time, for nothing (T-USER-GROUP-ADD-IDEMPOTENT).
  if private.this.group.exists "$groupName"; then
    info.log "groupName already exists: $groupName"
  else
    console.log "creating groupName: $groupName"
    if ! private.this.group.create "$groupName"; then
      create.result 1 "could not create group $groupName"
      error.log "$RESULT"
      return $(result)
    fi
  fi

  if [ -n "$toUsername" ] && private.user.group.member.is "$groupName" "$toUsername"; then
    info.log "$toUsername is a member of $groupName already"
  elif [ -n "$toUsername" ]; then
    if [ "$OOSH_OS" = "darwin" ]; then
      # macOS: use dseditgroup for group membership
      $SUDO dseditgroup -o edit -a "$toUsername" -t user "$groupName" 2>/dev/null
    elif [ "$OS_CMD_USER_MOD" = "addgroup" ]; then
      # Alpine: addgroup <user> <group> (reversed order)
      $SUDO $OS_CMD_USER_MOD "$toUsername" "$groupName"
    else
      $SUDO $OS_CMD_USER_MOD "$groupName" "$toUsername"
    fi
    create.result $? "$toUsername added to $groupName"
    return $(result)
  fi
  create.result 0 "group $groupName is there${toUsername:+, $toUsername is a member}"
  return $(result)
}

user.group.add.completion.groupName() {
  user.list.groups "$@"
