user.login() # <userName> # switch to userName via login shell — cd to target home and reset env; only TERM is kept #
{
  # `su -` (login shell) — without it, su keeps the caller's cwd and PATH,
  # so e.g. `user login alice` from /home/bob lands alice in /home/bob
  # which she can't even read (drwxr-x--- bob:bob). A login shell runs
  # alice's .profile/.bashrc, cds to ~alice, and resets HOME/USER/etc.
  # `env -i`: the target gets a CLEAN environment — none of the caller's PATH,
  # HOME or anchors. TERM is the one exception, passed explicitly: it describes
  # the TERMINAL, not the caller. Without it su sets TERM=dumb, and the shell
  # loses colour (git prints `## dev...origin/dev` plain) and less, vi, clear
  # and tmux degrade — seen in the ubuntu_24_04 platform container, 2026-09-29.
  env -i TERM="$(private.user.login.term.get)" su - "$1"
}

user.group.add() # <groupName> <?toUsername> # adds <toUsername> to group <groupName> if both exist
{

  local groupName="$1"
  if [ -n "$1" ]; then
    groupName="$1"
    shift
  else
    error.log "no ${YELLOW}groupName${RED} was specified"
    return 1
  fi 

  local toUsername="$1"
  if [ -n "$1" ]; then
    toUsername="$1"
    shift
  else
    console.log "no ${YELLOW}toUsername${NORMAL} was specified"
  fi 

  os.check.env
  # Idempotent: an existing group is not created again and an existing member
  # is not added again — no $SUDO at all then. config.init.user runs this for
  # dev on every oo update; a user without passwordless sudo was asked for a
  # password each time, for nothing (T-USER-GROUP-ADD-IDEMPOTENT).
  if private.this.group.exists "$groupName"; then
    info.log "groupName already exists: $groupName"
  else
    console.log "creating groupName: $groupName"
    if ! private.this.group.create "$groupName"; then
      create.result 1 "could not create group $groupName"
      error.log "$RESULT"
      return $(result)
    fi
  fi

  if [ -n "$toUsername" ] && private.user.group.member.is "$groupName" "$toUsername"; then
    info.log "$toUsername is a member of $groupName already"
  elif [ -n "$toUsername" ]; then
    if [ "$OOSH_OS" = "darwin" ]; then
      # macOS: use dseditgroup for group membership
      $SUDO dseditgroup -o edit -a "$toUsername" -t user "$groupName" 2>/dev/null
    elif [ "$OS_CMD_USER_MOD" = "addgroup" ]; then
      # Alpine: addgroup <user> <group> (reversed order)
      $SUDO $OS_CMD_USER_MOD "$toUsername" "$groupName"
    else
      $SUDO $OS_CMD_USER_MOD "$groupName" "$toUsername"
    fi
    create.result $? "$toUsername added to $groupName"
    return $(result)
  fi
  create.result 0 "group $groupName is there${toUsername:+, $toUsername is a member}"
  return $(result)
}

user.group.add.completion.groupName() {
  user.list.groups "$@"
}
user.group.add.completion.toUsername() {
  user.parameter.completion.username "$@"
}

user.group.check() # <groupName> # checks if a group exists
{
  private.user.check.group "$@"
}

private.user.check.group() # <groupName> # checks if a group exists
{
  # The lookup is the kernel's private.this.group.exists (dscl on macOS,
  # getent or /etc/group on Linux); this method adds the log lines. Its own
  # dscl/compgen pair was a second copy of the same platform fork.
  if private.this.group.exists "$1"; then
    success.log "group exists: $1"
    return 0
  fi
  warn.log "group does ${RED}NOT${YELLOW} exist: ${RED}$1${NORMAL}"
  return 1
}

user.ssh.backup() # <?label:manual> <?sshDir:~/.ssh> # archives <sshDir> into $HOME/.ssh.backups/ under a UTC-timestamped name; never writes to the current directory
{
  # $HOME-ANCHORED, and that anchor IS the fix. The old body was
  # `cp -R $sshDir ssh.$name` — a CWD-RELATIVE destination — while both of its
  # callers guarded on the ABSOLUTE `$HOME/ssh.<name>`. Three consequences,
  # all of them observed:
  #   - the guard could never become true, so the backup ran on EVERY install;
  #   - `cp -R src dst` copies INTO an existing dst, so every re-run nested one
  #     level deeper — ssh.X/.ssh/.ssh/…, each layer a full copy of the keys;
  #   - it landed wherever the operator happened to be. Three root-owned 0700
  #     copies of ROOT's ~/.ssh are sitting in a normal user's home on the dev
  #     box for exactly that reason.
  # During a root install $HOME is /root, so the keys now land in root's own
  # home whatever directory the installer was started from.
  #
  # Timestamped, so the name cannot collide and therefore cannot nest, and no
  # caller needs a guard any more. A DIRECTORY, not a tarball: there is no
  # `tar` anywhere in the tracked tree, and the install path is the wrong
  # place to introduce a new cross-platform dependency for this.
  local label="${1:-manual}"
  [ -n "$1" ] && shift
  private.user.get.sshDir "$1"
  [ -n "$1" ] && shift
  local sshDir="$RESULT"

  # A label reaches this from a call site, so it must not be able to escape
  # the archive root.
  label="$( printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '-' )"

  if [ ! -d "$sshDir" ]; then
    error.log "user.ssh.backup: nothing to archive — $sshDir does not exist"
    create.result 1 "no such directory: $sshDir" "$1"
    return $(result)
  fi

  local root="$HOME/.ssh.backups"
  if ! mkdir -p "$root"; then
    error.log "user.ssh.backup: cannot create $root"
    create.result 2 "cannot create $root" "$1"
    return $(result)
  fi
  chmod 700 "$root" 2>/dev/null

  local stamp archive
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  archive="$root/$stamp-$label"
  # Two archives inside the same second are possible during install, where two
  # labels fire close together. Never overwrite one.
  local n=1
  while [ -e "$archive" ]; do
    archive="$root/$stamp-$label.$n"
    n=$((n + 1))
  done

  # `cp -R "$src/." "$dst/"` — the idiom osshLayout already uses. Copying
  # the CONTENTS into a directory we created ourselves is what makes nesting
  # impossible even if the name ever did repeat.
  if ! mkdir -p "$archive" || ! cp -R "$sshDir/." "$archive/"; then
    error.log "user.ssh.backup: could not archive $sshDir to $archive"
    create.result 3 "could not archive $sshDir" "$1"
    return $(result)
  fi
  chmod 700 "$archive" 2>/dev/null

  # echo, not console.log: a path the caller may need survives any LOG_LEVEL.
  echo "$archive"
  create.result 0 "$archive" "$1"
  return $(result)
}
user.ssh.backup.completion.label() {
  # The labels the install path uses, plus the interactive default.
  echo "manual"
  echo "pre-install"
  echo "pre-user-init"
  echo "pre-restore"
}

user.ssh.restore() # <?archive:latest> <?sshDir:~/.ssh> # restores an archive from $HOME/.ssh.backups over <sshDir>; archives the current <sshDir> first and swaps only after the copy succeeded
{
  # THE OLD BODY WAS `rm -Rf $sshDir` FOLLOWED BY a cwd-relative
  # `cp -R ssh.$name $sshDir`. Run from the wrong directory it destroyed
  # ~/.ssh and then failed to replace it. It has never had a caller anywhere
  # in the tree, which is the only reason that never happened to anyone.
  #
  # Now: resolve first, stage second, and only then swap. Every failure path
  # returns with <sshDir> untouched.
  local wanted="${1:-latest}"
  [ -n "$1" ] && shift
  private.user.get.sshDir "$1"
  [ -n "$1" ] && shift
  local sshDir="$RESULT"

  local root="$HOME/.ssh.backups"
  local archive=""
  if [ "$wanted" = "latest" ]; then
    # Names start with a UTC timestamp, so lexical order IS chronological.
    archive="$( ls -1d "$root"/*/ 2>/dev/null | sed 's:/$::' | tail -1 )"
  else
    case "$wanted" in
      /*) archive="$wanted" ;;
      *)  archive="$root/$wanted" ;;
    esac
  fi

  if [ -z "$archive" ] || [ ! -d "$archive" ]; then
    error.log "user.ssh.restore: no such archive: ${archive:-<none under $root>} — $sshDir is untouched"
    create.result 1 "no such archive: ${archive:-none}" "$1"
    return $(result)
  fi

  # Stage NEXT TO the target, so the swap is a rename on the same filesystem
  # rather than a second copy.
  local staging="$sshDir.restoring.$$"
  rm -rf "$staging" 2>/dev/null
  if ! mkdir -p "$staging" || ! cp -R "$archive/." "$staging/"; then
    rm -rf "$staging" 2>/dev/null
    error.log "user.ssh.restore: could not stage $archive — $sshDir is untouched"
    create.result 2 "could not stage $archive" "$1"
    return $(result)
  fi

  # Only now is anything at risk, and the thing being replaced is archived
  # before it goes.
  if [ -d "$sshDir" ]; then
    user.ssh.backup pre-restore "$sshDir" >/dev/null || {
      rm -rf "$staging" 2>/dev/null
      error.log "user.ssh.restore: refusing to swap — could not archive the current $sshDir first"
      create.result 3 "could not archive current $sshDir" "$1"
      return $(result)
    }
    rm -rf "$sshDir"
  fi
  if ! mv "$staging" "$sshDir"; then
    error.log "user.ssh.restore: the swap failed; the staged copy is at $staging"
    create.result 4 "swap failed, staged copy at $staging" "$1"
    return $(result)
  fi
  chmod 700 "$sshDir" 2>/dev/null

  echo "$sshDir restored from $archive"
  create.result 0 "restored from $archive" "$1"
  return $(result)
}
user.ssh.restore.completion.archive() {
  # NO create.result in a completion function — it corrupts c2.
  echo "latest"
  ls -1d "$HOME/.ssh.backups"/*/ 2>/dev/null | sed 's:/$::' | xargs -r -n1 basename
}

user.ssh.backup.list() # # lists the ssh archives under $HOME/.ssh.backups, oldest first
{
  local root="$HOME/.ssh.backups"
  if [ ! -d "$root" ]; then
    echo "no archives: $root does not exist"
    create.result 0 "no archives" "$1"
    return $(result)
  fi
  local found
  found="$( ls -1d "$root"/*/ 2>/dev/null | sed 's:/$::' )"
  if [ -z "$found" ]; then
    echo "no archives under $root"
    create.result 0 "no archives" "$1"
    return $(result)
  fi
  # echo, not console.log: this method exists to be READ.
  printf '%s\n' "$found"
  create.result 0 "$( printf '%s\n' "$found" | grep -c . ) archive(s)" "$1"
  return $(result)
}

user.usage()
{
  local this=${0##*/}
  echo "You started 
$0
  
  Usage:
  $this: command   description and Parameter

      usage                   prints this dialog while it will print the status when there are no parameters          
      v                       print version information

      in 
  
      list  
      create                  <username> [keyword args: password, uid, gid]  — creates a new user with home dir, sets the password, and auto-installs oosh from the creator's branch.
      password.set            <username> <password>  — sets/resets a user's password cross-platform
      oosh.install            <username> [<branch>]  — installs oosh for an existing local user from <branch> (defaults to creator's \$OOSH_MODE)
      authorized.keys.update  <?sshDir:\"~/.ssh\">
  
      ssh.status log          logs if ther is an ssh config
      ssh.init                creates a new ssh config
  
      ssh.rename.files        <newName> <?sshDir:\"~/.ssh\">
      ssh.get.key.name      
      ssh.get.file.name       <?sshDir:\"~/.ssh\">

      ssh.backup              <?label:manual> <?sshDir:\"~/.ssh\"> archives sshDir to ~/.ssh.backups/<timestamp>-<label>/
      ssh.backup.list         lists the archives under ~/.ssh.backups
      ssh.backup.status       <?home:\"$HOME\"> reports legacy ssh.* backup dirs left by the pre-item-6 code; rc 1 if any
      ssh.backup.migrate      <?home:\"$HOME\"> moves those under ~/.ssh.backups/legacy/ (moves, never deletes)
      ssh.restore             <?archive:latest> <?sshDir:\"~/.ssh\"> restores an archive; archives the current sshDir first

      ssh.rootkey.file.revoke <sshConfigName> <publicKeyFile>      revokes access for the public key file
      ssh.rootkey.file.push   <sshConfigName> <publicKeyFile>      pushes the public key file        to the root of the specified ssh server and makes it authorized
      ssh.rootkey.push        <sshConfigName> <?sshDir:\"~/.ssh\"> pushes the public key from sshDir to the root of the specified ssh server and makes it authorized
      ssh.rootkey.pull        <sshConfigName> gets the root public key of the specified ssh server
      ----      --------------------------"
  this.help
  echo "
  ${NO_COLOR}
  Examples
    user init
    
    user in ./KPP/ssh.developer ssh.get.file.name
    user ssh.get.file.name ./KPP/ssh.developer

  OS details:
      OS_CMD_USER_ADD=$OS_CMD_USER_ADD
      OS_CMD_USER_MDO=$OS_CMD_USER_MOD  
      OS_CMD_USER_DEL=$OS_CMD_USER_DEL
      OS_CMD_GROUP_ADD=$OS_CMD_GROUP_ADD
  "
}

private.user.init() {
  if [ -z "$USER" ]; then
    USER=$(id -u -n)
  fi
  ONCE_SUDO=sudo

  # Load the cached OS_CMD_* vars if we have them. We source unconditionally
  # when the file exists, then self-heal below if any are missing — this
  # survives an incomplete cache (e.g. private.check.pm in oo saves
  # os.commands.env during install before private.user.init has computed
  # OS_CMD_USER_MOD / OS_CMD_USER_DEL, leaving the cache with only 2 of 4
  # vars; without the self-heal, user.group.add silently
  # degraded to `sudo "" <group> <user>` → "bash: <group>: command not
  # found", and new users never joined the `dev` group).
  if [ -f $CONFIG_PATH/os.commands.env ]; then
    source $CONFIG_PATH/os.commands.env
  fi

  if [ -z "$OS_CMD_USER_ADD" ] || [ -z "$OS_CMD_USER_DEL" ] \
     || [ -z "$OS_CMD_USER_MOD" ] || [ -z "$OS_CMD_GROUP_ADD" ]; then
    os.check.env
    if [ "$OOSH_OS" = "darwin" ]; then
      [ -z "$OS_CMD_USER_ADD"  ] && export OS_CMD_USER_ADD="sysadminctl -addUser"
      [ -z "$OS_CMD_USER_DEL"  ] && export OS_CMD_USER_DEL="sysadminctl -deleteUser"
      [ -z "$OS_CMD_USER_MOD"  ] && export OS_CMD_USER_MOD="dseditgroup -o edit -a"
      [ -z "$OS_CMD_GROUP_ADD" ] && export OS_CMD_GROUP_ADD="dseditgroup -o create -q"
    else
      # Linux: discover sbin tools (may not be in PATH on Debian). Only
      # set vars that weren't already loaded from the cache.
      if [ -z "$OS_CMD_USER_ADD" ]; then
        if [ -x "$(command -v adduser 2>/dev/null)" ]; then
          export OS_CMD_USER_ADD="adduser"
        fi
        local _useradd
        _useradd=$(command -v useradd 2>/dev/null || echo /usr/sbin/useradd)
        if [ -x "$_useradd" ]; then
          export OS_CMD_USER_ADD="$_useradd"
        fi
      fi
      if [ -z "$OS_CMD_USER_DEL" ]; then
        # private.user.delete.command.get knows about busybox; this used to
        # probe `userdel` alone, so on alpine the cache could never go complete
        # and this whole heal re-ran on every invocation.
        export OS_CMD_USER_DEL="$(private.user.delete.command.get)"
        [ -z "$OS_CMD_USER_DEL" ] && unset OS_CMD_USER_DEL
      fi
      if [ -z "$OS_CMD_USER_MOD" ]; then
        local _usermod
        _usermod=$(command -v usermod 2>/dev/null || echo /usr/sbin/usermod)
        if [ -x "$_usermod" ]; then
          export OS_CMD_USER_MOD="$_usermod -a -G"
        elif [ -x "$(command -v addgroup 2>/dev/null)" ]; then
          export OS_CMD_USER_MOD="addgroup"
        fi
      fi
      if [ -z "$OS_CMD_GROUP_ADD" ]; then
        if [ -x "$(command -v addgroup 2>/dev/null)" ]; then
          export OS_CMD_GROUP_ADD="addgroup"
        fi
        local _groupadd
        _groupadd=$(command -v groupadd 2>/dev/null || echo /usr/sbin/groupadd)
        if [ -x "$_groupadd" ]; then
          export OS_CMD_GROUP_ADD="$_groupadd"
        fi
      fi
    fi
    # Persist the complete set so future sessions hit a healthy cache.
    # Silence chatter twice:
    #   (a) stdout and stderr via `>/dev/null 2>&1` — needed for $(user get
    #       basehome) and similar captured contexts during state 31's
    #       private.install.dev.configs: whatever `config save` or
    #       `oo pm.discover` prints on a stream, the INVALID line config.save
    #       writes to stderr among them, would land in the captured value.
    #   (b) log device — `console.log` / `important.log` write to
    #       $LOG_DEVICE (typically a tty), bypassing the `>/dev/null`
    #       on the function call. config.save logs "config.save (CONFIG=…)"
    #       and "generating …" that way, and oo.pm.discover's own
    #       `config save` (no args) does the same. (The log.device call that
    #       once sat inside config.save, and its recursive save, are gone.)
    #       The swap does not leak into the saved env files: LOG_DEVICE is on
    #       config's never-persisted list (private.config.variables.list).
    local _origLogDevice="${LOG_DEVICE:-/dev/tty}"
    export LOG_DEVICE=/dev/null
    config save os.commands "OS_CMD" >/dev/null 2>&1
    oo pm.discover                   >/dev/null 2>&1
    export LOG_DEVICE="$_origLogDevice"
  fi
}

user.start()
{
  #echo "sourcing init"
  source this
  source ossh
  source os
  private.user.init

  # if [ -z "$1" ]; then
