private.user.init() {
  if [ -z "$USER" ]; then
    USER=$(id -u -n)
  fi
  ONCE_SUDO=sudo

  # Load the cached OS_CMD_* vars if we have them. We source unconditionally
  # when the file exists, then self-heal below if any are missing — this
  # survives an incomplete cache (e.g. private.check.pm in oo saves
  # os.commands.env during install before private.user.init has computed
  # OS_CMD_USER_MOD / OS_CMD_USER_DEL, leaving the cache with only 2 of 4
  # vars; without the self-heal, user.group.add silently
  # degraded to `sudo "" <group> <user>` → "bash: <group>: command not
  # found", and new users never joined the `dev` group).
  if [ -f $CONFIG_PATH/os.commands.env ]; then
    source $CONFIG_PATH/os.commands.env
  fi

  if [ -z "$OS_CMD_USER_ADD" ] || [ -z "$OS_CMD_USER_DEL" ] \
     || [ -z "$OS_CMD_USER_MOD" ] || [ -z "$OS_CMD_GROUP_ADD" ]; then
    os.check.env
    if [ "$OOSH_OS" = "darwin" ]; then
      [ -z "$OS_CMD_USER_ADD"  ] && export OS_CMD_USER_ADD="sysadminctl -addUser"
      [ -z "$OS_CMD_USER_DEL"  ] && export OS_CMD_USER_DEL="sysadminctl -deleteUser"
      [ -z "$OS_CMD_USER_MOD"  ] && export OS_CMD_USER_MOD="dseditgroup -o edit -a"
      [ -z "$OS_CMD_GROUP_ADD" ] && export OS_CMD_GROUP_ADD="dseditgroup -o create -q"
    else
      # Linux: discover sbin tools (may not be in PATH on Debian). Only
      # set vars that weren't already loaded from the cache.
      if [ -z "$OS_CMD_USER_ADD" ]; then
        if [ -x "$(command -v adduser 2>/dev/null)" ]; then
          export OS_CMD_USER_ADD="adduser"
        fi
        local userAddCommand
        userAddCommand=$(command -v useradd 2>/dev/null || echo /usr/sbin/useradd)
        if [ -x "$userAddCommand" ]; then
          export OS_CMD_USER_ADD="$userAddCommand"
        fi
      fi
      if [ -z "$OS_CMD_USER_DEL" ]; then
        # private.user.delete.command.get knows about busybox; this used to
        # probe `userdel` alone, so on alpine the cache could never go complete
        # and this whole heal re-ran on every invocation.
        export OS_CMD_USER_DEL="$(private.user.delete.command.get)"
        [ -z "$OS_CMD_USER_DEL" ] && unset OS_CMD_USER_DEL
      fi
      if [ -z "$OS_CMD_USER_MOD" ]; then
        local userModCommand
        userModCommand=$(command -v usermod 2>/dev/null || echo /usr/sbin/usermod)
        if [ -x "$userModCommand" ]; then
          export OS_CMD_USER_MOD="$userModCommand -a -G"
        elif [ -x "$(command -v addgroup 2>/dev/null)" ]; then
          export OS_CMD_USER_MOD="addgroup"
        fi
      fi
      if [ -z "$OS_CMD_GROUP_ADD" ]; then
        if [ -x "$(command -v addgroup 2>/dev/null)" ]; then
          export OS_CMD_GROUP_ADD="addgroup"
        fi
        local groupAddCommand
        groupAddCommand=$(command -v groupadd 2>/dev/null || echo /usr/sbin/groupadd)
        if [ -x "$groupAddCommand" ]; then
          export OS_CMD_GROUP_ADD="$groupAddCommand"
        fi
      fi
    fi
    # Persist the complete set so future sessions hit a healthy cache.
    # Silence chatter twice:
    #   (a) stdout and stderr via `>/dev/null 2>&1` — needed for $(user get
    #       basehome) and similar captured contexts during state 31's
    #       private.install.dev.configs: whatever `config save` or
    #       `oo pm.discover` prints on a stream, the INVALID line config.save
    #       writes to stderr among them, would land in the captured value.
    #   (b) log device — `console.log` / `important.log` write to
    #       $LOG_DEVICE (typically a tty), bypassing the `>/dev/null`
    #       on the function call. config.save logs "config.save (CONFIG=…)"
    #       and "generating …" that way, and oo.pm.discover's own
    #       `config save` (no args) does the same. (The log.device call that
    #       once sat inside config.save, and its recursive save, are gone.)
    #       The swap does not leak into the saved env files: LOG_DEVICE is on
    #       config's never-persisted list (private.config.variables.list).
    local origLogDevice="${LOG_DEVICE:-/dev/tty}"
    export LOG_DEVICE=/dev/null
    config save os.commands "OS_CMD" >/dev/null 2>&1
    oo pm.discover                   >/dev/null 2>&1
    export LOG_DEVICE="$origLogDevice"
  fi
}

