private.user.delete.linux() { # <username> # removes the user and all its files
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  os.check.env
  if [ "$OOSH_OS" = "darwin" ]; then
    $SUDO sysadminctl -deleteUser "$username"
