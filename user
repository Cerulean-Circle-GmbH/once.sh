private.user.delete.command.get()     # <?sbinDir:/usr/sbin> # echo this system's user-delete command WITH its remove-home flag, or nothing if it has none #
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell, so
  # RESULT could never reach the caller. Same exemption as the other getters.
  #
  # ONE definition, called from both places that need it: private.user.init's
  # OS_CMD heal and private.user.delete.linux. They used to probe separately and
  # BOTH probed only `userdel`, which alpine does not have — it ships busybox
  # `deluser`. So on alpine the cache stayed empty (two red assertions in every
  # alpine run since the heal was written on 2026-04-24) and every delete ran
  # `/usr/sbin/userdel -rf` and died with ENOENT 127.
  #
  # The flag is PART OF THE VALUE, as it is for darwin's
  # `sysadminctl -deleteUser`, because the two spellings differ and a caller
  # appending its own would have to know which command it got:
  #
  #   shadow    userdel -rf USER            (shadow-utils)
  #   busybox   deluser --remove-home USER  (measured: BusyBox v1.36.1, alpine 3.19)
  #
  # <sbinDir> is a real parameter, not a test hook: these binaries live in
  # /usr/sbin, which is NOT on a non-root PATH on Debian, so the directory to
  # fall back to has to be nameable. It is also the only way to exercise the
  # busybox branch on a shadow host — without it the absolute path wins and the
  # test passes for the wrong reason, which is how this stayed hidden.
  local sbinDir="${1:-/usr/sbin}"
  local name candidate
  for name in userdel deluser; do
    candidate=$(command -v "$name" 2>/dev/null || echo "$sbinDir/$name")
    if [ -x "$candidate" ]; then
      case "$name" in
        userdel) echo "$candidate -rf" ;;
        deluser) echo "$candidate --remove-home" ;;
      esac
      return 0
    fi
  done
  return 1
}
private.user.delete.command.get.completion.sbinDir() { echo "/usr/sbin"; }


private.user.bashrc.install()     # <targetHome> <?ooshDir:$OOSH_DIR> # install <ooshDir>/templates/user/bashrcTemplate as <targetHome>/.bashrc when it differs; the first original is kept as .bashrc.pre-oosh, a later hand edit as .bashrc.orig.<ts>; a .bash_profile that sources .bashrc is created #
{
 # The ONE .bashrc writer. user.oosh.install, config.init.user and oo's root
 # installation each had a hand copy with its own condition — and the "only
 # if the bashrc has no oosh section" one left boot-sourcing bashrcs behind.
 # Runs as the user who owns <targetHome>: the callers hop with
 # private.as.user. Personal additions belong in ~/.bash_aliases, which the
 # template sources.
 local targetHome="$1"
 local ooshDir="${2:-$OOSH_DIR}"
 local template="$ooshDir/templates/user/bashrcTemplate"
 if [ -z "$targetHome" ] || [ ! -d "$targetHome" ]; then
   create.result 1 "private.user.bashrc.install requires an existing <targetHome>, got '$targetHome'"; error.log "$RESULT"; return $(result)
 fi
 if [ ! -f "$template" ]; then
   create.result 1 "private.user.bashrc.install: no template at $template"; error.log "$RESULT"; return $(result)
 fi
 if private.this.file.same "$template" "$targetHome/.bashrc"; then
   create.result 0 "$targetHome/.bashrc is the oosh template"
 else
   if [ -f "$targetHome/.bashrc" ]; then
     if [ ! -e "$targetHome/.bashrc.pre-oosh" ]; then
       cp "$targetHome/.bashrc" "$targetHome/.bashrc.pre-oosh"
     elif ! private.this.file.same "$targetHome/.bashrc" "$targetHome/.bashrc.pre-oosh"; then
       # A later hand edit: keep it as .bashrc.orig.<ts> unless it is the
       # newest one already kept (timestamps sort, so the last glob match).
       local _newest="" _f
       for _f in "$targetHome"/.bashrc.orig.*; do [ -f "$_f" ] && _newest="$_f"; done
       if [ -z "$_newest" ] || ! private.this.file.same "$targetHome/.bashrc" "$_newest"; then
         local _ts
         _ts=$(private.user.orig.ts.get "$targetHome" .bashrc)
         cp "$targetHome/.bashrc" "$targetHome/.bashrc.orig.$_ts" || { create.result 1 "could not keep $targetHome/.bashrc as .bashrc.orig.$_ts"; error.log "$RESULT"; return $(result); }
       fi
     fi
   fi
   cp "$template" "$targetHome/.bashrc"
   create.result $? "$targetHome/.bashrc installed from $template"
 fi
 [ -f "$targetHome/.bash_profile" ] || printf '%s\n' '[ -f ~/.bashrc ] && source ~/.bashrc' > "$targetHome/.bash_profile"
 return $(result)
}


private.user.login.term.get()     #  # echo the TERM user login hands to the new shell: the caller's TERM, or xterm-256color when it is empty or dumb #
{
 # A getter consumed as $(...): no create.result. TERM describes the TERMINAL,
 # so it is the one variable `env -i` lets through (T-USER-LOGIN-KEEPS-TERM).
 # "dumb" is what an `env -i sh` leaves behind — the boss's clean-boot flow is
 # `env -i sh`, then `user login` — not a terminal anyone uses for oosh, so it
 # counts as unset: the new shell gets colour, less, vi, clear and tmux back.
 case "$TERM" in
   ""|dumb) echo xterm-256color ;;
   *)       echo "$TERM" ;;
 esac
}


private.user.group.member.pending()     # <group> <?user> # rc 0 when <user> (default: id -un) is in <group> per the group database while this process does not have the group yet: a membership that counts from the next login or sg #
{
 # A predicate (rc only, no create.result). `id -nG <user>` reads the group
 # database, `id -nG` the groups of this process: a membership in the first and
 # not the second counts from the next login, or at once through sg. odocker
 # asked only the database and re-ran every call under sg — also when docker
 # failed for another reason (2026-10-06, T-USER-GROUP-MEMBER-PENDING). No
 # $USER: under `docker exec` there may be none.
 local group="$1" user="${2:-$(id -un 2>/dev/null)}"
 [ -n "$group" ] && [ -n "$user" ] || return 1
 private.user.group.member.is "$group" "$user" || return 1
 case " $(id -nG 2>/dev/null) " in *" $group "*) return 1 ;; esac
 return 0
}


private.user.group.member.is()     # <group> <?user> # rc 0 when <user> (default: id -un) is in <group> per the group database: the membership a new login gets #
{
 # A predicate (rc only, no create.result). `id -nG <user>` reads the group
 # database on GNU, busybox (Alpine) and BSD (macOS) alike. user.group.add asks
 # it first: an existing member needs no sudo and no usermod — config.init.user
 # adds every user to dev on every oo update (T-USER-GROUP-ADD-IDEMPOTENT). No
 # $USER: under `docker exec` there may be none.
 local group="$1" user="${2:-$(id -un 2>/dev/null)}"
 [ -n "$group" ] && [ -n "$user" ] || return 1
 case " $(id -nG "$user" 2>/dev/null) " in *" $group "*) return 0 ;; esac
 return 1
}


private.user.oosh.install.links()     # <targetHome> <sharedConfig> <sharedOosh> # link <targetHome>/config and <targetHome>/oosh to the shared trees; a real entry is kept as .orig.<ts> #
{
 # The per-user step user.oosh.install hops into as the target user
 # (private.as.user): a real ~/config or ~/oosh moves to <name>.orig.<ts> and
 # the link is made in the same primitive, private.this.symlink.with.backup.
 # One <ts> for both (private.user.orig.ts.get).
 local targetHome="$1" sharedConfig="$2" sharedOosh="$3" ts
 if [ -z "$targetHome" ] || [ ! -d "$targetHome" ] || [ -z "$sharedConfig" ] || [ -z "$sharedOosh" ]; then
   create.result 1 "private.user.oosh.install.links requires an existing <targetHome> <sharedConfig> <sharedOosh>, got '$targetHome' '$sharedConfig' '$sharedOosh'"; error.log "$RESULT"; return $(result)
 fi
 ts=$(private.user.orig.ts.get "$targetHome" config oosh)
 private.this.symlink.with.backup "$targetHome/config" "$sharedConfig" "$ts" || return $(result)
 private.this.symlink.with.backup "$targetHome/oosh" "$sharedOosh" "$ts" || return $(result)
 create.result 0 "$targetHome/config -> $sharedConfig, $targetHome/oosh -> $sharedOosh"
 return $(result)
}


private.user.home.ensure()     # <username> <?home> # create a missing home directory for a passwd entry: owner and primary group of the user, mode 0750; RESULT created or exists #
{
 # A passwd entry can outlive its home (once_dev: developking without
 # /home/developking). 0750 is what useradd gives on Debian and Ubuntu
 # (user.create runs useradd -m). The home comes from the user database
 # (user.get home) unless <home> names it. Elevated only when the caller is
 # not the user or cannot write the parent — the caller's own home needs no sudo.
 local username="$1" home="$2" grp parent _sudo="$SUDO"
 if [ -z "$username" ]; then
   create.result 1 "private.user.home.ensure requires a <username>"; error.log "$RESULT"; return $(result)
 fi
 [ -z "$home" ] && home=$(user.get home "$username")
 if [ -z "$home" ]; then
   create.result 1 "private.user.home.ensure: no home known for '$username'"; error.log "$RESULT"; return $(result)
 fi
 if [ -d "$home" ]; then
   create.result 0 "exists: $home"
   return $(result)
 fi
 grp=$(user.id -gn "$username" 2>/dev/null)
 if [ -z "$grp" ]; then
   create.result 1 "private.user.home.ensure: no primary group for '$username'"; error.log "$RESULT"; return $(result)
 fi
 parent=$(dirname "$home")
 if [ "$(user.id -un)" = "$username" ] && [ -d "$parent" ] && [ -w "$parent" ]; then
   _sudo=""
 fi
 # raw on purpose: no kernel method creates a directory with owner and mode; this IS the one for a home
 if ! $_sudo mkdir -p "$home" || ! $_sudo chown "$username:$grp" "$home" || ! $_sudo chmod 0750 "$home"; then
   create.result 1 "private.user.home.ensure: could not create $home as $username:$grp"; error.log "$RESULT"; return $(result)
 fi
 create.result 0 "created: $home ($username:$grp 0750)"
 return $(result)
}


private.user.orig.ts.get()     # <dir> <names...> # echo a YYYYmmdd-HHMMSS stamp for which <dir>/<name>.orig.<stamp> is free for every name, bumped with -<n> #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The one stamp behind every "keep it as <name>.orig.<ts>": private.this.symlink.with.backup
 # moves a real directory INTO an existing <name>.orig.<ts> (nesting it), so
 # a second run inside the same second must get a new stamp.
 local dir="$1" base ts n=0 name taken
 shift
 [ -n "$dir" ] && [ $# -gt 0 ] || return 1
 base=$(date +%Y%m%d-%H%M%S)  # oosh-exception: no stamp getter exists in the kernel; date is the one source
 ts="$base"
 while :; do
   taken=0
   for name in "$@"; do
     { [ -e "$dir/$name.orig.$ts" ] || [ -L "$dir/$name.orig.$ts" ]; } && taken=1
   done
   [ "$taken" = 0 ] && break
   n=$((n+1)); ts="$base-$n"
 done
 echo "$ts"
}


