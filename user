# ---------------------------------------------------------------------------
# user.oosh.install — install oosh for a local user from <branch>
#
# Runs the per-user portion of the "shared folder model" introduced by
# ossh.install.user.remote, but LOCALLY (no SSH). Used by user.create so a
# newly-created user inherits the creator's current oosh branch automatically.
#
# Requires the system-level (root) install to have completed already — i.e.
# developking and the shared/ tree must exist. When that's not the case the
# method soft-fails and user.create continues (the user account is still
# created, just without the oosh symlinks).
# ---------------------------------------------------------------------------

private.as.user() # <username> <command...> # run command as <username> — prefers runuser (no sudo needed when root), falls back to sudo -H -u, then su -
{
  # The caller's OWN user is no switch at all: the command runs directly.
  # Through sudo it asked for a password for nothing — `config init.user` for
  # yourself (T-PRIVATE-AS-USER-SELF).
  #
  # Dispatch order matters — runuser FIRST, sudo SECOND, su THIRD:
  #   1. runuser  — only path that doesn't need sudo at all (root + util-linux).
  #                 Preferred on minimal containers where sudo isn't installed
  #                 yet (e.g. naked Alpine before `apk add sudo`).
  #   2. sudo -H -u — most distros; requires the caller to be a sudoer.
  #                   -H resets HOME so the inner shell uses the target's home.
  #   3. su -s /bin/bash - <user> -c <cmd> — last resort; root-only fallback
  #                   for environments without runuser AND without sudo.
  # Reversing this order would silently break sudo-less containers (sudo
  # branch fails, su needs root, runuser would have worked) and any
  # non-root-but-sudo caller switching to another user.
  # Verified by T-PRIVATE-AS-USER-DISPATCH in test/test.user.
  local username="$1"; shift
  if [ "$username" = "$(id -un)" ]; then
    "$@"
  elif [ "$(id -u)" = "0" ] && command -v runuser >/dev/null 2>&1; then
    runuser -u "$username" -- "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo -H -u "$username" "$@"
  elif [ "$(id -u)" = "0" ] && command -v su >/dev/null 2>&1; then
    # su -c takes a single string. Re-quote args so they survive the join.
    local quotedCommand=""
    local argumentWord
    for argumentWord in "$@"; do
      quotedCommand+="${quotedCommand:+ }$(printf '%q' "$argumentWord")"
    done
    su -s /bin/bash - "$username" -c "$quotedCommand"
  else
    error.log "private.as.user: cannot switch to '$username' — need runuser, sudo, or root+su"
    return 127
  fi
}

user.oosh.install() # <username> <?branch:$OOSH_MODE> # installs oosh for a local user from <branch> (defaults to the current oosh branch of the creator)
{
  local username="$1"
  if [ -n "$1" ]; then
    shift
  else
    create.result 1 "user.oosh.install: no username was specified"
    error.log "$RESULT"; return $(result)
  fi

  local branch="$1"
  [ -n "$branch" ] && shift
  [ -z "$branch" ] && branch="$OOSH_MODE"
  if [ -z "$branch" ]; then
    private.this.script.load ogit ogit.branch.get
    branch=$(ogit.branch.get "$OOSH_DIR")
  fi
  if [ -z "$branch" ]; then
    create.result 1 "user.oosh.install: cannot determine current oosh branch"
    error.log "$RESULT"; return $(result)
  fi

  local targetHome devHome baseDir sharedConfig sharedOosh
  targetHome=$(user.get home "$username")
  devHome=$(user.get home developking)
  if [ -z "$targetHome" ]; then
    create.result 1 "user.oosh.install: cannot resolve home for $username"
    error.log "$RESULT"; return $(result)
  fi
  if [ -z "$devHome" ]; then
    create.result 1 "user.oosh.install: developking not found — run ossh install (root) first"
    error.log "$RESULT"; return $(result)
  fi

  baseDir=$(dirname "$devHome")
  # The shared paths from their one owner, in the letter case of the file
  # system (/Users/Shared on macOS) — a literal lowercase `shared` linked
  # ~/config to a spelling every later run found wrong (G1).
  if ! private.this.script.load config private.config.shared.config.get; then
    create.result 1 "user.oosh.install: cannot load config from $OOSH_DIR/config"
    error.log "$RESULT"; return $(result)
  fi
  sharedConfig=$(private.config.shared.config.get)
  sharedOosh="$(private.config.shared.oosh.base.get)/$branch"

  # Single-shot existence check — do NOT poll here. user.create
  # auto-invokes user.oosh.install for the newly-created user, and state
  # 31's body (private.check.root.shared.dev.folder.created in oo) runs `user create developking` mid-body BEFORE it
  # creates $sharedOosh (via the shared-tree step later in that body). Polling here
  # deadlocks that path: state 31 can't progress until user.create returns,
  # and user.create can't return until user.oosh.install gives up waiting
  # for state 31's own output. user.create soft-fails on our non-zero
  # exit (see the `|| warn.log` in user.create), so the proper-order call from
  # install.finish.local finishes the symlink setup after state 31 has
  # completed.
  if [ ! -d "$sharedOosh" ]; then
    create.result 1 "user.oosh.install: $sharedOosh not yet available — skipping symlink setup for $username (will be retried once shared oosh exists)"
    info.log "$RESULT"; return $(result)
  fi

  important.log "Installing oosh for '$username' from branch '$branch' (shared folder model)"
  info.log "  sharedConfig: $sharedConfig"
  info.log "  sharedOosh:   $sharedOosh"

  # Symlink ~/config and ~/oosh in the target user's home. private.as.user
  # dispatches runuser (root + no sudo needed) / sudo / su, so this works
  # whether the caller is a sudoer, already root on a minimal container
  # without sudo installed, or anything in between.
  # The hop loads only `this` (the shared preamble) and links through
  # private.this.symlink.with.backup, one stamp for both, as config init.user
  # does: a real ~/config or ~/oosh is kept as .orig.<ts>. It sourced the
  # shared `user` before, whose load writes os.commands.env into ~/config — a
  # real directory then, kept as config.orig.<ts> on every fresh install
  # (T-USER-OOSH-INSTALL-HOP-NO-CONFIG).
  local linkRc=0 ts
  ts=$(private.this.orig.stamp.get "$targetHome" config oosh)
  private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")
    cd \"$targetHome\" || exit 1
    private.this.symlink.with.backup config '$sharedConfig' '$ts' || exit 1
    private.this.symlink.with.backup oosh   '$sharedOosh'   '$ts' || exit 1
  " || linkRc=$?
  # Verify actual state — macOS sshd + -tt ControlMaster sometimes drops the
  # SSH connection right after the inner commands complete, giving a non-zero
  # client-side exit even when the ln -s commands succeeded on the remote.
  # Check as the target user (same elevation as the creation step): caller
  # may be a non-root sudoer (e.g. bob creating alice) whose traversal of
  # the target's 750-mode home is blocked, which would falsely fail a
  # plain `[ -L /home/alice/config ]` test even when the symlinks exist.
  if private.as.user "$username" test -L "$targetHome/config" \
     && private.as.user "$username" test -L "$targetHome/oosh"; then
    [ "$linkRc" -ne 0 ] && info.log "user.oosh.install: symlinks for $username are in place (inner shell exited $linkRc — likely SSH transport hiccup)"
  else
    create.result 1 "user.oosh.install: failed to create ~/config and ~/oosh symlinks for $username"
    error.log "$RESULT"; return $(result)
  fi

  # Copy shared SSH dotfiles (user-owned, correct perms).
  # ~/.ssh itself must be 700 and owned by the target user — sshd's
  # StrictModes (default on) refuses authorized_keys under group-writable
  # or wrong-owner .ssh directories. Running via $SUDO means the default
  # umask can be 002 (group-writable), so we tighten perms explicitly.
  # A missing ~/.ssh is created through private.this.dir.ensure (the user,
  # their login group, 700); then the whole tree is handed over, as on dev
  # (private.user.ssh.tree.handover).
  local sharedSsh="$baseDir/shared/.ssh" userGroup
  userGroup=$(id -gn "$username" 2>/dev/null)
  if $SUDO test -f "$sharedSsh/config"; then
    private.this.dir.ensure "$targetHome/.ssh" "$userGroup" 700 "$username" >/dev/null \
      || warn.log "user.oosh.install: $RESULT"
    $SUDO bash -c "
      for f in config known_hosts; do
        [ -f '$sharedSsh/'\"\$f\" ] && cp '$sharedSsh/'\"\$f\" '$targetHome/.ssh/' 2>/dev/null
      done
      chmod 700 '$targetHome/.ssh' # kernel-exception: pre-existing on dev, out of the heal scope
      [ -f '$targetHome/.ssh/config' ]      && chmod 600 '$targetHome/.ssh/config' # kernel-exception: pre-existing on dev, out of the heal scope
      [ -f '$targetHome/.ssh/known_hosts' ] && chmod 644 '$targetHome/.ssh/known_hosts' # kernel-exception: pre-existing on dev, out of the heal scope
    " 2>/dev/null
    private.user.ssh.tree.handover "$username" "$targetHome" >/dev/null \
      || warn.log "user.oosh.install: $RESULT"
  fi

  # Mark every folder under the shared base as safe for the new user (owned by
  # root/developking, read by them). Clone layout (spec § 4): each folder is
  # its own repository with its own safe.directory entry, so ogit
  # safeDirectory.ensure walks the base. git's safe.directory is a string match
  # and macOS spells /Users/Shared where a caller may say /Users/shared — ogit
  # safeDirectory.add stores every entry in the file system's own case, so
  # nothing is folded here. Run AS the user through the shared preamble, calling
  # ogit as a command (their --global config; only missing entries are added).
  private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")"$'\n'"'$sharedOosh/ogit' safeDirectory.ensure '$(dirname "$sharedOosh")'" 2>/dev/null

  # The oosh .bashrc and the per-user session files the shared env files
  # chain, through the one writers, AS the new user so all are <user>:<user>.
  # The shared preamble stands the TARGET up (their HOME, no leaked anchors or
  # OOSH_MODE, `this` from the shared tree — the caller's may be /root/oosh),
  # so user.session.env gets THEIR real PATH and THEIR branch.
  private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")
    private.this.script.load user private.user.bashrc.install || exit 1
    private.this.script.load config private.config.session.file.ensure || exit 1
    private.user.bashrc.install \"$targetHome\" \"$sharedOosh\" >/dev/null || exit 1
    private.config.session.file.ensure \"$targetHome\" >/dev/null || exit 1
  " || error.log "user.oosh.install: could not install the .bashrc / session files for ${RED}$username${NORMAL}"

  # Ensure the user is in the shared-folder 'dev' group — the sharedConfig
  # tree is drwxrwsr-x developking:dev, so anything oosh writes there
  # (log.live.out, state files, etc.) needs dev-group write access.
  # user.create adds this already; this second call is idempotent and covers
  # users who came in via ossh.install.user.remote without user.create
  # (e.g. raw-created with sysadminctl).
  if private.user.check.group dev; then
    user.group.add dev "$username"
  fi

  # Write the WODA Host aliases into the target user's ~/.ssh/config.
  # user.init is the canonical writer of WODA Host aliases for non-developking
  # users (append-if-missing per Host header). Without this
  # invocation here, test/oosh-user/bash-user only ever get the 2cuGitHub
  # alias propagated by private.ossh.shared.ssh.copy.to.all — never WODA.
  # test/test.ssh.config.woda fails for those users without this block.
  #
  # Why the shared preamble instead of `bash -lc 'user init'`:
  # bashrcTemplate (templates/user/bashrcTemplate) early-returns for
  # non-interactive shells before its PATH/OOSH setup, so `user` isn't on
  # PATH inside `bash -lc`. private.this.as.user.preamble.get stands the
  # target up like the hops above: their HOME and USER (runuser keeps the
  # caller's — c2's staging file landed in /root/config/result.txt), no
  # leaked CONFIG*/OOSH_DIR/OOSH_MODE, umask 022, `this` from $sharedOosh
  # and the PATH prepend that puts `user`/`ossh` in scope.
  #
  # IMPORTANT — does NOT damage sharedConfig (post-c10def5): the chown -h
  # in private.ossh.push.config preserves sharedConfig ownership; this
  # `user init` only writes to $sshDir/config (~/.ssh/config), not to
  # ~/config. c2 dispatch may write through ~/config to sharedConfig but
  # only as the target user via dev-group writes (mode g+w preserved).
  private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")"$'\n'"user init" \
    || warn.log "user.oosh.install: 'user init' for $username did not complete cleanly — WODA aliases may be missing from $targetHome/.ssh/config"

  # Materialize the canonical ~/.ssh layout for this user — `ids/` subtree
  # with ssh.developking + ssh.<installer-id> + ssh.outeruser, plus the
  # private_key/<id>-> ../id_ed25519 and public_keys/<id>->../id_ed25519.pub
  # symlinks. Without this, non-root users (test, oosh-user, bash-user in
  # os.platform.test) only get a bare keypair + 2cuGitHub — root has the
  # full layout (osshLayout build is invoked for root in ossh.install.continue.local, but the
  # per-user invocation was dropped by d9adb27 alongside band-aids).
  # test/test.platform.ssh.layout.invariant pins the invariant.
  #
  # $SUDO bash -c so writes succeed even when the caller can't write into
  # the target user's $HOME (e.g. test creating oosh-user via the platform
  # test pipeline). osshLayout creates files as root because it runs under
  # $SUDO, then the entire .ssh tree is handed over to the target user
  # (private.user.ssh.tree.handover). Safe because Phase 2 of the .ssh/
  # correctness plan replaced all symlinks under ids/ with real-file copies
  # (verified by test.osshLayout's no-symlink assertions and
  # test.platform.ssh.layout.invariant). Without the hand-over, ~/.ssh/ids/ is
  # owned by root with mode 700 and the user can't even read their own
  # developking key for github auth. A missing ~/.ssh is created first through
  # private.this.dir.ensure.
  local ownerEmail
  ownerEmail=$(private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")"$'\n'"'$sharedOosh/ogit' config.email.get" 2>/dev/null) || true
  [ -z "$ownerEmail" ] && ownerEmail="${username}@$(private.this.host.name.get)"
  private.this.dir.ensure "$targetHome/.ssh" "$userGroup" 700 "$username" >/dev/null \
    || warn.log "user.oosh.install: $RESULT"
  # oosh-dir-exception: installs ANOTHER user before their ~/oosh symlink exists
  # path-exception: same string, same reason — no user.env has been read there.
  $SUDO bash -c "
    export OOSH_DIR='$sharedOosh'
    export PATH=\"\$OOSH_DIR:\$PATH\"
    USER_EMAIL='$ownerEmail' '$sharedOosh/osshLayout' build '' '' '$targetHome/.ssh'
  " || warn.log "osshLayout build for '$username' did not complete cleanly — ~/.ssh/ids/ may be incomplete"
  private.user.ssh.tree.handover "$username" "$targetHome" >/dev/null \
    || warn.log "user.oosh.install: $RESULT"

  # The login shell: bash, through the one method state 32 and the heal call
  # (owner decision 3); the SSH/docker group memberships, dispatched via os.check.
  private.user.login.shell.bash.ensure "$username" >/dev/null \
    || warn.log "user.oosh.install: $RESULT"
  if os.check private.user.oosh.install.groups; then
    $RESULT "$username"
  fi

  # Defensive sweep: a symlink inside $sharedOosh whose name matches a sibling
  # worktree (or this worktree itself) turns `git log <branch>` into
  # "ambiguous argument: both revision and filename" because git treats the
  # bare branch name as a pathspec. Nothing in oosh references
  # $sharedOosh/<branchname>; remove any such link regardless of who made it.
  # (Observed intermittently; root creator not yet traced after multiple runs.)
  local worktreeBase
  worktreeBase=$(dirname "$sharedOosh")
  if [ -d "$worktreeBase" ]; then
    local wtName
    for wtName in "$worktreeBase"/*/; do
      wtName=$(basename "${wtName%/}")
      [ -L "$sharedOosh/$wtName" ] || continue
      warn.log "Removing stray symlink '$sharedOosh/$wtName' (shadows branch name)"
      sudo rm -f "$sharedOosh/$wtName"
    done
  fi

  create.result 0 "oosh installed for $username from branch $branch"
  important.log "✓ $RESULT"
  return $(result)
}

user.oosh.install.completion.username() { user.list; }
user.oosh.install.completion.branch() {
  # OOSH_DIR is the ~/oosh symlink (docs/config.md § The anchor rule), so `dirname` on it yields
  # $HOME. Resolve to the physical worktree first, then list its siblings.
  # private.this.path.canonical is a pure echo — safe inside a completion
  # function, unlike anything that calls create.result.
  local wtBase
  wtBase=$(dirname "$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null || echo "$OOSH_DIR")")
  [ -d "$wtBase" ] && ls "$wtBase" 2>/dev/null
}

private.user.oosh.install.shell.darwin() # <username> <targetHome> # ensures bash is the login shell on macOS via dscl (chsh silently fails for sysadminctl/OD-managed users)
{
  local username="$1"
  local targetHome="$2"
  local bashPath currentShell
  bashPath=$(private.user.login.shell.bash.path.get.darwin "$username")
  currentShell=$(dscl . -read "/Users/$username" UserShell 2>/dev/null | awk '{print $2}')

  if [ -z "$bashPath" ] || [ "$currentShell" = "$bashPath" ]; then
    return 0
  fi

  # macOS-native: `dscl . -change /Users/<user> UserShell <old> <new>` writes
  # the Open Directory record directly. `chsh -s` is the historical Unix way
  # but on macOS it requires (a) the target shell listed in /etc/shells —
  # /opt/homebrew/bin/bash typically isn't there — and (b) the user's own
  # password OR full superuser context, which sudo+chsh doesn't always
  # provide for sysadminctl-created users. dscl skips both gates.
  if $SUDO dscl . -change "/Users/$username" UserShell "$currentShell" "$bashPath" 2>/dev/null; then
    success.log "user shell for $username switched: $currentShell → $bashPath (dscl)"
    return 0
  fi

  # Fallback for the rare environment where dscl isn't usable as root —
  # e.g. some hardened MDM-managed Macs reject -change without GUI auth.
  # Try chsh; if /etc/shells doesn't list bashPath yet, append first.
  if [ -w /etc/shells ] || $SUDO test -w /etc/shells 2>/dev/null; then
    grep -qxF "$bashPath" /etc/shells 2>/dev/null \
      || $SUDO bash -c "echo '$bashPath' >> /etc/shells" 2>/dev/null
  fi
  if $SUDO chsh -s "$bashPath" "$username" 2>/dev/null; then
    success.log "user shell for $username switched: $currentShell → $bashPath (chsh)"
    return 0
  fi

  warn.log "Could not change $username's login shell to bash — neither dscl nor chsh succeeded; ssh-cat oosh commands may fail in zsh"
  return 1
}

private.user.oosh.install.shell.linux() # <username> <targetHome> # ensures bash is the login shell on Linux (incl. BusyBox/Alpine)
{
  local username="$1"
  local bashPath currentShell
  bashPath=$(private.user.login.shell.bash.path.get.linux "$username")
  currentShell=$(getent passwd "$username" 2>/dev/null | cut -d: -f7)
  if [ -n "$bashPath" ] && [ "$currentShell" != "$bashPath" ]; then
    if command -v chsh >/dev/null 2>&1; then
      $SUDO chsh -s "$bashPath" "$username" 2>/dev/null
    else
      $SUDO sed -i "s|^$username:\(.*\):[^:]*\$|$username:\1:$bashPath|" /etc/passwd
    fi
  fi
}

private.user.oosh.install.groups.darwin() # <username> # macOS group memberships needed for SSH login and docker
{
  local username="$1"
  # com.apple.access_ssh is a restriction group: once it EXISTS on macOS, only
  # its members can SSH in. Creating it from scratch with only one member
  # locks every other user out. So: only add <username> if the group already
  # exists. If it doesn't exist yet, SSH is open — leave that policy alone.
  if dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1; then
    $SUDO dseditgroup -o edit -a "$username" -t user com.apple.access_ssh 2>/dev/null
  fi
  if command -v docker >/dev/null 2>&1; then
    $SUDO dseditgroup -o edit -a "$username" -t user docker 2>/dev/null
  fi
}

private.user.oosh.install.groups.linux() # <username> # Linux group memberships: the group of a mounted docker socket, else docker when docker is installed
{
  local username="$1"
  # A platform container has the host's socket: its group now, so the first
  # odocker call needs no new membership — Alpine has no sg to apply one
  # (2026-10-06, T-USER-INSTALL-SOCKET-GROUP). The socket's group also when
  # the image ships a docker program: the local docker group does not own the
  # host's socket (T-USER-INSTALL-SOCKET-GROUP-OVER-DOCKER).
  if private.this.script.load odocker private.odocker.socket.group.ensure \
     && [ -e "$(private.odocker.socket.get)" ]; then
    private.odocker.socket.group.ensure >/dev/null 2>&1 \
      && user.group.add "$RESULT" "$username" 2>/dev/null
  elif command -v docker >/dev/null 2>&1; then
    user.group.add docker "$username" 2>/dev/null
  fi
}

user.linux.delete() { # <username> # removes the user and all its files
  private.user.delete.linux "$@"
}

private.user.delete.linux() { # <username> # removes the user and all its files
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  os.check.env
  if [ "$OOSH_OS" = "darwin" ]; then
    $SUDO sysadminctl -deleteUser "$username"
  else
    # THE SHARED ACCESSOR, not a second probe. This function hardcoded
    # `userdel -rf` and alpine has no userdel, so every call died ENOENT 127 —
    # and OS_CMD_USER_DEL, which private.user.init caches for exactly this, was
    # never read by anybody. It is read now.
    local userDel="${OS_CMD_USER_DEL:-$(private.user.delete.command.get)}"
    if [ -z "$userDel" ]; then
      create.result 1 "no user-delete command on this system — tried userdel and deluser"
      error.log "$RESULT"
      return $(result)
    fi
    # Unquoted on purpose: the value carries its flag, exactly as
    # OS_CMD_USER_MOD does where it is consumed the same way (user.group.add).
    $SUDO $userDel "$username"
  fi
}

