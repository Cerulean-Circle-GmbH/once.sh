user.ssh.backup.status()     # <?home:$HOME> # reports legacy ssh.* backup directories left in <home> by the old cwd-relative backup; rc 1 if any are found #
{
  # REPORT BEFORE DESTROY, the shape `path validate` and `this anchor.validate`
  # use: echo the verdict so it survives any LOG_LEVEL, rc 1 on findings, and
  # leave the acting to a separate verb.
  #
  # The artefacts this finds are what `cp -R $sshDir ssh.$name` left behind
  # when it ran with the operator's cwd rather than $HOME: `ssh.original` and
  # `ssh.<user>.<host>.for.<host>`. On the dev box they are root-owned and
  # mode 0700, so this must work WITHOUT being able to read them — `[ -d ]`
  # on the path succeeds because the parent directory belongs to the user.
  #
  # $HOME/.ssh.backups (the new archive root) and $HOME/.ssh/ids/ssh.* (which
  # osshLayout owns, same prefix, different meaning) are never touched: the
  # glob is $home/ssh.* — no leading dot, and one level deep.
  local home="${1:-$HOME}"
  [ -n "$1" ] && shift

  if [ ! -d "$home" ]; then
    error.log "user.ssh.backup.status: no such directory: $home"
    echo "INVALID: no such directory: $home"
    create.result 2 "no such directory: $home" "$1"
    return $(result)
  fi

  local found="" entry count=0
  for entry in "$home"/ssh.*; do
    [ -e "$entry" ] || continue
    [ -d "$entry" ] || continue
    found="${found}${entry}	owner=$(private.user.path.owner.get "$entry")
"
    count=$((count + 1))
  done

  if [ "$count" -eq 0 ]; then
    echo "OK: no legacy ssh.* backup directories in $home"
    create.result 0 "0 legacy artefact(s)" "$1"
    return $(result)
  fi

  error.log "user.ssh.backup.status: $count legacy ssh.* director(ies) in $home — these are pre-item-6 backups written relative to the operator's cwd. Move them with 'user ssh.backup.migrate'"
  printf '%s' "$found"
  echo "INVALID: $count legacy ssh.* backup director(ies) in $home"
  create.result 1 "$count legacy artefact(s)" "$1"
  return $(result)
}

private.user.path.owner.get() # <path> # the owning user of <path>, or "?" when it cannot be read; answers on stdout
{
  # NO create.result — a getter consumed as $(...) runs in a subshell, so
  # RESULT would never reach the caller. The GNU/BSD stat pair is the
  # kernel's private.this.path.stat.get; the "?" is this getter's own.
  private.this.path.stat.get "$1" owner || echo "?"
}


user.ssh.backup.status.completion.home() { echo "$HOME"; }
user.ssh.backup.migrate()     # <?home:$HOME> # moves the legacy ssh.* backup directories in <home> under <home>/.ssh.backups/legacy/ #
{
  # The acting half of user.ssh.backup.status. It MOVES rather than deletes:
  # these directories hold private keys, and nothing in this ticket has the
  # standing to destroy them. Once they are under .ssh.backups/legacy/ the
  # user can look at them and decide.
  #
  # It refuses rather than half-moving. On the dev box the artefacts are
  # root-owned, and a `mv` of a root-owned directory succeeds only because the
  # PARENT belongs to the user — which is true in a home directory and false
  # in general, so the failure path has to be real and has to name $SUDO.
  local home="${1:-$HOME}"
  [ -n "$1" ] && shift

  if [ ! -d "$home" ]; then
    error.log "user.ssh.backup.migrate: no such directory: $home"
    create.result 2 "no such directory: $home" "$1"
    return $(result)
  fi

  local legacy="$home/.ssh.backups/legacy"
  local entry moved=0 failed=0
  for entry in "$home"/ssh.*; do
    [ -e "$entry" ] || continue
    [ -d "$entry" ] || continue
    if ! mkdir -p "$legacy"; then # kernel-exception: pre-existing on dev, out of the heal scope
      error.log "user.ssh.backup.migrate: cannot create $legacy"
      create.result 3 "cannot create $legacy" "$1"
      return $(result)
    fi
    chmod 700 "$home/.ssh.backups" "$legacy" 2>/dev/null # kernel-exception: pre-existing on dev, out of the heal scope
    local target="$legacy/$(basename "$entry")"
    if [ -e "$target" ]; then
      error.log "user.ssh.backup.migrate: $target already exists — not overwriting"
      failed=$((failed + 1))
      continue
    fi
    if mv "$entry" "$target"; then
      console.log "moved $entry -> $target"
      moved=$((moved + 1))
    else
      error.log "user.ssh.backup.migrate: could not move $entry — it is probably owned by another user; re-run as: \$SUDO user ssh.backup.migrate $home"
      failed=$((failed + 1))
    fi
  done

  if [ "$failed" -gt 0 ]; then
    echo "INCOMPLETE: moved $moved, failed $failed"
    create.result 1 "moved $moved, failed $failed" "$1"
    return $(result)
  fi
  echo "OK: moved $moved legacy ssh.* director(ies) to $legacy"
  create.result 0 "migrated" "$1"
  return $(result)
}


user.ssh.backup.migrate.completion.home() { echo "$HOME"; }
private.user.delete.command.get()     # <?sbinDir:/usr/sbin> # echo the user-delete command of this system WITH its remove-home flag, or nothing if it has none #
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell, so
  # RESULT could never reach the caller. Same exemption as the other getters.
  #
  # ONE definition, called from both places that need it: private.user.init's
  # OS_CMD heal and private.user.delete.linux. They used to probe separately and
  # BOTH probed only `userdel`, which alpine does not have — it ships busybox
  # `deluser`. So on alpine the cache stayed empty (two red assertions in every
  # alpine run since the heal was written on 2026-04-24) and every delete ran
  # `/usr/sbin/userdel -rf` and died with ENOENT 127.
  #
  # The flag is PART OF THE VALUE, as it is for darwin's
  # `sysadminctl -deleteUser`, because the two spellings differ and a caller
  # appending its own would have to know which command it got:
  #
  #   shadow    userdel -rf USER            (shadow-utils)
  #   busybox   deluser --remove-home USER  (measured: BusyBox v1.36.1, alpine 3.19)
  #
  # <sbinDir> is a real parameter, not a test hook: these binaries live in
  # /usr/sbin, which is NOT on a non-root PATH on Debian, so the directory to
  # fall back to has to be nameable. It is also the only way to exercise the
  # busybox branch on a shadow host — without it the absolute path wins and the
  # test passes for the wrong reason, which is how this stayed hidden.
  local sbinDir="${1:-/usr/sbin}"
  local name candidate
  for name in userdel deluser; do
    candidate=$(command -v "$name" 2>/dev/null || echo "$sbinDir/$name")
    if [ -x "$candidate" ]; then
      case "$name" in
        userdel) echo "$candidate -rf" ;;
        deluser) echo "$candidate --remove-home" ;;
      esac
      return 0
    fi
  done
  return 1
}


private.user.bashrc.install()     # <targetHome> <?ooshDir:$OOSH_DIR> # install <ooshDir>/templates/user/bashrcTemplate as <targetHome>/.bashrc when it differs; the first original is kept as .bashrc.pre-oosh, a later hand edit as .bashrc.orig.<ts> (an earlier committed oosh template is no hand edit); a .bash_profile that sources .bashrc is created #
{
 # The ONE .bashrc writer. user.oosh.install, config.init.user and oo's root
 # installation each had a hand copy with its own condition — and the "only
 # if the bashrc has no oosh section" one left boot-sourcing bashrcs behind.
 # Runs as the user who owns <targetHome>: the callers hop with
 # private.as.user. Personal additions belong in ~/.bash_aliases, which the
 # template sources.
 local targetHome="$1"
 local ooshDir="${2:-$OOSH_DIR}"
 local template="$ooshDir/templates/user/bashrcTemplate"
 if [ -z "$targetHome" ] || [ ! -d "$targetHome" ]; then
   create.result 1 "private.user.bashrc.install requires an existing <targetHome>, got '$targetHome'"; error.log "$RESULT"; return $(result)
 fi
 if [ ! -f "$template" ]; then
   create.result 1 "private.user.bashrc.install: no template at $template"; error.log "$RESULT"; return $(result)
 fi
 if private.this.file.same "$template" "$targetHome/.bashrc"; then
   create.result 0 "$targetHome/.bashrc is the oosh template"
 else
   # The originals are COPIED (cp -p keeps mode and mtime), not moved: the
   # template is written over .bashrc right after, and a copy leaves the user
   # a .bashrc if a step fails between. Raw cp, not `check … call cp`: the
   # copy's rc must stop the install before the template overwrites the only
   # original.
   if [ -f "$targetHome/.bashrc" ]; then
     if [ ! -e "$targetHome/.bashrc.pre-oosh" ]; then
       cp -p "$targetHome/.bashrc" "$targetHome/.bashrc.pre-oosh" || { create.result 1 "could not keep $targetHome/.bashrc as .bashrc.pre-oosh"; error.log "$RESULT"; return $(result); }
     elif ! private.this.file.same "$targetHome/.bashrc" "$targetHome/.bashrc.pre-oosh"; then
       # A later hand edit: keep it as .bashrc.orig.<ts> unless it is the
       # newest one already kept. "Newest" is the last glob match — stamps
       # sort lexically, so a -10 bump sorts before -2 (limit; it only
       # costs one extra copy). Raw: no kernel method lists the newest .orig.
       local newestOrig="" origFile
       for origFile in "$targetHome"/.bashrc.orig.*; do [ -f "$origFile" ] && newestOrig="$origFile"; done
       if { [ -z "$newestOrig" ] || ! private.this.file.same "$targetHome/.bashrc" "$newestOrig"; } \
          && ! private.user.bashrc.old.template.is "$targetHome/.bashrc" "$ooshDir"; then
         local origStamp
         origStamp=$(private.this.orig.stamp.get "$targetHome" .bashrc)
         cp -p "$targetHome/.bashrc" "$targetHome/.bashrc.orig.$origStamp" || { create.result 1 "could not keep $targetHome/.bashrc as .bashrc.orig.$origStamp"; error.log "$RESULT"; return $(result); }
       fi
     fi
   fi
   # The bytes, not the mode: the template is committed executable, and cp gave a
   # new .bashrc rwxrwxr-x under the heal's umask 002. A new file is rw-r--r--, as
   # the install leaves it over the one of /etc/skel; an existing one keeps its mode
   # (T-USER-BASHRC-INSTALL-MODE).
   ( umask 022; cat "$template" > "$targetHome/.bashrc" ) || { create.result 1 "could not write $targetHome/.bashrc"; error.log "$RESULT"; return $(result); }
   create.result 0 "$targetHome/.bashrc installed from $template"
 fi
 # rw-r--r--, as the install leaves it, also when the text was already the
 # template (an old install made it executable, Alpine; owner ruling P6 round 1);
 # only when it differs, so a second run changes nothing (T-USER-BASHRC-INSTALL-MODE).
 [ "$(private.this.path.stat.get "$targetHome/.bashrc" mode)" = 644 ] || chmod 644 "$targetHome/.bashrc" 2>/dev/null # kernel-exception: the mode of one file the install writes 644, no helper sets the mode of an existing file
 [ -f "$targetHome/.bash_profile" ] || printf '%s\n' '[ -f ~/.bashrc ] && source ~/.bashrc' > "$targetHome/.bash_profile"
 return $(result)
}


private.user.login.term.get()     #  # echo the TERM user login hands to the new shell: the TERM of the caller, or xterm-256color when it is empty or dumb #
{
 # A getter consumed as $(...): no create.result. TERM describes the TERMINAL,
 # so it is the one variable `env -i` lets through (T-USER-LOGIN-KEEPS-TERM).
 # "dumb" is what an `env -i sh` leaves behind — the boss's clean-boot flow is
 # `env -i sh`, then `user login` — not a terminal anyone uses for oosh, so it
 # counts as unset: the new shell gets colour, less, vi, clear and tmux back.
 case "$TERM" in
   ""|dumb) echo xterm-256color ;;
   *)       echo "$TERM" ;;
 esac
}


private.user.group.member.pending()     # <group> <?user> # rc 0 when <user> (default: id -un) is in <group> per the group database while this process does not have the group yet: a membership that counts from the next login or sg #
{
 # A predicate (rc only, no create.result). `id -nG <user>` reads the group
 # database, `id -nG` the groups of this process: a membership in the first and
 # not the second counts from the next login, or at once through sg. odocker
 # asked only the database and re-ran every call under sg — also when docker
 # failed for another reason (2026-10-06, T-USER-GROUP-MEMBER-PENDING). No
 # $USER: under `docker exec` there may be none.
 local group="$1" user="${2:-$(id -un 2>/dev/null)}"
 [ -n "$group" ] && [ -n "$user" ] || return 1
 private.user.group.member.is "$group" "$user" || return 1
 case " $(id -nG 2>/dev/null) " in *" $group "*) return 1 ;; esac
 return 0
}


private.user.group.member.is()     # <group> <?user> # rc 0 when <user> (default: id -un) is in <group> per the group database: the membership a new login gets #
{
 # A predicate (rc only, no create.result). `id -nG <user>` reads the group
 # database on GNU, busybox (Alpine) and BSD (macOS) alike. user.group.add asks
 # it first: an existing member needs no sudo and no usermod — config.init.user
 # adds every user to dev on every oo update (T-USER-GROUP-ADD-IDEMPOTENT). No
 # $USER: under `docker exec` there may be none.
 local group="$1" user="${2:-$(id -un 2>/dev/null)}"
 [ -n "$group" ] && [ -n "$user" ] || return 1
 case " $(id -nG "$user" 2>/dev/null) " in *" $group "*) return 0 ;; esac
 return 1
}




private.user.home.ensure()     # <username> <?home> <?skel:/etc/skel> # create a missing home directory for a passwd entry: owner and primary group of the user, the home mode of the platform, the entries of <skel> copied as the user (none when there is no <skel>, macOS); RESULT created or exists #
{
 # A passwd entry can outlive its home (once_dev: developking without
 # /home/developking). The mode is what useradd gives on THIS platform
 # (private.user.home.mode.get through os.check: 0750 Ubuntu, 0755 Debian and
 # macOS, 0700 RHEL), not a guess. The home comes from the user database
 # (user.get home) unless <home> names it. The directories come from
 # private.this.dir.ensure, which elevates only where it must; missing
 # PARENTS get no owner and 0755 — they belong to the system, never to the
 # user. A home made here gets the entries of the skeleton (/etc/skel unless
 # <skel> names another; none where there is none, macOS), each copied AS the
 # user with its own mode, as useradd -m gives them — the compare found
 # developking's remade home without .profile (T-USER-HOME-ENSURE-SKEL, owner
 # ruling P6 round 1); private.user.bashrc.install then installs the .bashrc.
 # Caller: private.oo.heal.system.
 local username="$1" home="$2" skel="${3:-/etc/skel}" grp mode parent entry
 if [ -z "$username" ]; then
   create.result 1 "private.user.home.ensure requires a <username>"; error.log "$RESULT"; return $(result)
 fi
 [ -z "$home" ] && home=$(user.get home "$username")
 if [ -z "$home" ]; then
   create.result 1 "private.user.home.ensure: no home known for '$username'"; error.log "$RESULT"; return $(result)
 fi
 if [ -d "$home" ]; then
   create.result 0 "exists: $home"
   return $(result)
 fi
 grp=$(user.id -gn "$username" 2>/dev/null)
 if [ -z "$grp" ]; then
   create.result 1 "private.user.home.ensure: no primary group for '$username'"; error.log "$RESULT"; return $(result)
 fi
 if os.check private.user.home.mode.get; then mode=$($RESULT); fi
 [ -n "$mode" ] || mode=0755
 parent="${home%/*}"
 [ -n "$parent" ] || parent=/
 private.this.dir.ensure "$parent" "" 0755 >/dev/null || { create.result 1 "private.user.home.ensure: could not create $parent"; error.log "$RESULT"; return $(result); }
 private.this.dir.ensure "$home" "$grp" "$mode" "$username" >/dev/null || { create.result 1 "private.user.home.ensure: could not create $home as $username:$grp"; error.log "$RESULT"; return $(result); }
 if [ -d "$skel" ]; then
   for entry in "$skel"/* "$skel"/.[!.]* "$skel"/..?*; do
     [ -e "$entry" ] || continue
     private.as.user "$username" cp -Rp "$entry" "$home/" || { create.result 1 "private.user.home.ensure: could not copy ${entry##*/} of $skel into $home"; error.log "$RESULT"; return $(result); }
   done
 fi
 create.result 0 "created: $home ($username:$grp $mode)"
 return $(result)
}


private.user.home.mode.get.linux()     # <?loginDefs:/etc/login.defs> # echo the mode useradd gives a new home on Linux: HOME_MODE of login.defs, else 0777 minus its UMASK, else 0755; 2755 where adduser is the one of BusyBox (Alpine), as it makes a home #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # Ubuntu >= 21.04 ships HOME_MODE 0750; Debian only UMASK 022 (0755); RHEL and
 # AlmaLinux UMASK 077 (0700); BusyBox has no login.defs (0755). Read raw:
 # no kernel method reads a login.defs key.
 local defs="${1:-/etc/login.defs}" key val mode="" umask="" adder
 # BusyBox adduser makes a home 2755 (setgid) — the install's developking on Alpine,
 # created before shadow's useradd is there; a probe of the platform, no OS fork
 # (the compare, alpine P6; T-USER-HOME-MODE-LINUX).
 adder=$(command -v adduser 2>/dev/null)
 if [ -n "$adder" ] && [ "$(basename "$(private.this.path.canonical "$adder")")" = busybox ]; then echo 2755; return 0; fi
 if [ -r "$defs" ]; then
   while read -r key val _; do
     case "$key" in
       HOME_MODE) mode="$val" ;;
       UMASK)     umask="$val" ;;
     esac
   done < "$defs"
 fi
 case "$umask" in *[!0-7]*) umask="" ;; esac   # login.defs text never reaches the arithmetic unless it is octal
 if [ -z "$mode" ]; then
   if [ -n "$umask" ]; then
     mode=$(printf '%04o' $(( 0777 & ~0$umask )))
   else
     mode=0755
   fi
 fi
 echo "$mode"
}


private.user.home.mode.get.darwin()     #  # echo the mode a new home has on macOS: 0755 #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # sysadminctl creates /Users/<name> as 0755.
 echo 0755
}


private.user.bashrc.old.template.is()     # <bashrc> <?ooshDir:$OOSH_DIR> # rc 0 when the file is a committed revision of templates/user/bashrcTemplate of ooshDir: its blob id among the blob ids the template had over the last 200 commits that changed it #
{
 # An EARLIER oosh template is not a hand edit: private.user.bashrc.install
 # keeps no .bashrc.orig.<ts> of it, or every template change would leave one
 # for every user on `sudo oo update`. Two git processes: the blob id of the
 # file (ogit.file.hash.get) and the blob ids of the template over the commits
 # that CHANGED it (ogit.file.history.blobs.get) — not the template read at
 # each of the last 200 commits, which missed a revision older than that
 # (T-USER-BASHRC-OLD-TEMPLATE-BLOBS). A tree git refuses (no repository, one
 # the user may not read or does not trust), a shallow clone without the
 # revision, or no git: a hand edit — the safe side, a copy is made, nothing
 # is lost. config init.user trusts the base before its .bashrc hop.
 local file="$1" ooshDir="${2:-$OOSH_DIR}" blob history
 if [ ! -s "$file" ]; then
   create.result 1 "$file is missing or empty"; return $(result)
 fi
 private.this.script.load ogit ogit.file.history.blobs.get || { create.result 1 "ogit is not available"; return $(result); }
 blob=$(ogit.file.hash.get "$file")
 history=$(ogit.file.history.blobs.get templates/user/bashrcTemplate 200 "$ooshDir")
 if [ -n "$blob" ] && printf '%s\n' "$history" | grep -qxF -- "$blob"; then
   create.result 0 "$file is a committed revision of the template"; return $(result)
 fi
 create.result 1 "$file is no committed revision of the template"
 return $(result)
}


private.user.uid.min.get.linux()     # <?loginDefs:/etc/login.defs> # echo the first uid of a person on Linux: UID_MIN of login.defs, else 1000 (BusyBox has none) #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The sibling of private.user.home.mode.get.linux, read the same raw way: no
 # kernel method reads a login.defs key. AlmaLinux, Debian and Ubuntu ship
 # UID_MIN 1000; BusyBox has no login.defs and adduser starts at 1000.
 local defs="${1:-/etc/login.defs}" key val min=""
 if [ -r "$defs" ]; then
   while read -r key val _; do
     [ "$key" = UID_MIN ] && min="$val"
   done < "$defs"
 fi
 case "$min" in ''|*[!0-9]*) min=1000 ;; esac   # login.defs text never reaches the arithmetic unless it is a number
 echo "$min"
}


private.user.uid.min.get.darwin()     #  # echo the first uid of a person on macOS: 501 #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # sysadminctl gives the first person uid 501; below are the system accounts.
 echo 501
}


private.user.account.heals.is()     # <username> # rc 0 when oo heal all heals <username>: (a) root or a uid of at least UID_MIN (private.user.uid.min.get), (b) a login shell that is not nologin or false, (c) a home of its own, owned by it, and (d) ~/oosh or ~/config in it (a link, even a dangling one, or a real entry); rc 1 an account that sees ~/oosh or ~/config but fails (a), (b) or (c), RESULT says why; rc 2 nothing to heal: neither in its home, or no home (empty, /, /nonexistent, /var/empty); silent predicate #
{
 # NO output — a predicate: rc and RESULT only. The almalinux_9 gate: operator
 # (uid 11, home /root, /sbin/nologin) saw ROOT's ~/oosh, was healed, failed
 # its shell step and kept the second heal at rc 1. An account is healed only
 # when it is a person's (or root's) with a login and a home of its own:
 #   (d) ~/oosh or ~/config in its home — else rc 2, nothing to heal; so is a
 #       home that is no home: empty, /, /nonexistent, /var/empty;
 #   (a) root, or a uid of at least UID_MIN (private.user.uid.min.get);
 #   (b) a login shell that is not nologin or false;
 #   (c) the home is owned by the account itself (private.this.path.stat.get).
 # rc 1 for (a)-(c): RESULT names why, private.oo.heal.users.list prints it.
 local username="$1" home uid shell min owner
 if [ -z "$username" ]; then
   create.result 2 "no username"; return $(result)
 fi
 home=$(user.get home "$username" 2>/dev/null)
 case "$home" in
   ''|/|/nonexistent|/var/empty) create.result 2 "$username: no home of its own (${home:-none})"; return $(result) ;;
 esac
 if [ ! -e "$home/oosh" ] && [ ! -L "$home/oosh" ] && [ ! -e "$home/config" ] && [ ! -L "$home/config" ]; then
   create.result 2 "$username: no ~/oosh or ~/config in $home"; return $(result)
 fi
 uid=$(user.id -u "$username" 2>/dev/null)
 shell=$(user.get shell "$username" 2>/dev/null)
 min=""; if os.check private.user.uid.min.get; then min=$($RESULT); fi
 case "$min" in ''|*[!0-9]*) min=1000 ;; esac
 case "$uid" in ''|*[!0-9]*) uid="?" ;; esac
 if [ "$uid" = "?" ] || { [ "$uid" != 0 ] && [ "$uid" -lt "$min" ]; }; then
   create.result 1 "system account (uid $uid, ${shell:-no shell}, home $home)"; return $(result)
 fi
 case "${shell##*/}" in
   nologin|false) create.result 1 "system account (uid $uid, $shell, home $home)"; return $(result) ;;
 esac
 owner=$(private.this.path.stat.get "$home" owner)
 if [ "$owner" != "$username" ]; then
   create.result 1 "home $home is not its own (owner ${owner:-unknown})"; return $(result)
 fi
 create.result 0 "heals: $username (uid $uid, $shell, home $home)"
 return $(result)
}


private.user.login.shell.bash.ensure()     # <user> # set the login shell of <user> to the bash on PATH when it is not a bash yet (a shell named bash on any path is left as it is); state 32 and the heal call it; RESULT unchanged or set <shell>; rc 1 when it cannot #
{
 # Owner decision 3 (2026-10-08): the heal does what install state 32 does,
 # through this one method — state 32 changed root's login shell inline. The
 # bash is a value of the platform (private.user.login.shell.bash.path.get
 # .linux / .darwin through os.check), the change too: chsh or /etc/passwd on
 # Linux, dscl then chsh on macOS (private.user.oosh.install.shell.*). The
 # answer is what the passwd database says afterwards (user.get shell), not the
 # rc of the tool (T-USER-LOGIN-SHELL-BASH-ENSURE).
 local username="$1" bashPath current
 if [ -z "$username" ]; then
   create.result 1 "private.user.login.shell.bash.ensure requires <user>"
   return $(result)
 fi
 if os.check private.user.login.shell.bash.path.get; then bashPath=$($RESULT "$username"); fi
 if [ -z "$bashPath" ]; then
   create.result 1 "no bash for the login shell of $username"
   return $(result)
 fi
 current=$(user.get shell "$username")
 # A bash already — /bin/bash beside a /usr/bin/bash on PATH — is never changed:
 # the install leaves the shell the system gave it (the compare, alma P6; owner
 # ruling P6 round 1). Otherwise the bash on PATH, as install state 32 chose it.
 if [ "$current" = "$bashPath" ] || [ "${current##*/}" = bash ]; then
   create.result 0 "unchanged"
   return $(result)
 fi
 if os.check private.user.oosh.install.shell; then $RESULT "$username" "$(user.get home "$username")" >/dev/null 2>&1; fi
 current=$(user.get shell "$username")
 if [ "$current" = "$bashPath" ]; then
   create.result 0 "set $bashPath"
   return $(result)
 fi
 create.result 1 "cannot set the login shell of $username to $bashPath — it is ${current:-unknown}"
 return $(result)
}


