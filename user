 # The platform value of private.user.login.shell.bash.ensure (os.check):
 # /bin/bash is 3.2 on macOS, so the bash the install chose for the user
 # (BASH_FILE of their user.env, a Homebrew bash) comes first, read as data.
 local home value
 home=$(user.get home "$1")
