# Ensure LOG_DEVICE points at the LIVE terminal — prevents "ambiguous redirect"
# errors AND the stale-device trap: LOG_DEVICE is now loaded from the chained
# log.session.env (user.env's chain sources it before this runs), where it holds the PREVIOUS
# session's tty (e.g. /dev/pts/1). A pts owned by the same user is still writable,
# so a plain `-w` guard would keep it and this shell's console.log/important.log
# would land on the WRONG terminal. So: when stdout is a live tty, ALWAYS
# re-derive it (the live terminal wins); only fall back to the fd/null cascade for
# non-tty contexts (ssh exec, cron, CI) with no usable device set.
_oosh_livetty="$(tty 2>/dev/null)"
if [ -n "$_oosh_livetty" ] && [ "$_oosh_livetty" != "not a tty" ] && [ -w "$_oosh_livetty" ]; then
  # A controlling terminal is attached. The LIVE terminal wins over a STALE
  # terminal device loaded from the chained log.session.env (a PREVIOUS session's
  # /dev/pts/N, still writable because same-user — it would send this shell's
  # output to the old terminal). But do NOT override an EXPLICIT non-terminal
  # device: a capture file (tests set `LOG_DEVICE=/tmp/…`), `log device <file>`,
  # or /dev/null must be respected. So refresh only when LOG_DEVICE is empty or
  # is itself a terminal path; leave any other value alone.
  case "$LOG_DEVICE" in
    "" | "$_oosh_livetty") export LOG_DEVICE="$_oosh_livetty" ;;
    /dev/pts/* | /dev/tty*)  export LOG_DEVICE="$_oosh_livetty" ;;  # stale terminal → refresh
    *) : ;;                                                          # explicit non-terminal → respect
  esac
elif [ -z "$LOG_DEVICE" ] || [ ! -w "$LOG_DEVICE" ]; then
  # No terminal (ssh exec, cron, CI) and no usable device set — fall back.
  if [ -w /proc/self/fd/1 ]; then
    export LOG_DEVICE=/proc/self/fd/1
  else
    export LOG_DEVICE=/dev/null
  fi
fi
unset _oosh_livetty

# LOG_LIVE is genuinely per-USER: it lives in the user's OWN $HOME/.config/oosh
# (NOT the shared ~/config — every user symlinks that to one sharedConfig, where
# all users would clobber a single log.live.out). Private file → no dev-group
# write. Re-anchored unconditionally to the current user each shell. The `:-`
# fallback covers contexts that sourced log before this or user.env set the var.
mkdir -p "$HOME/.config/oosh" 2>/dev/null
export LOG_LIVE="$HOME/.config/oosh/log.live.out"
touch "$LOG_LIVE" 2>/dev/null

log.device() # <?device> # set LOG_DEVICE to <device>, probed by private.log.device.probe (/dev/tty without a terminal, a file nobody may write: falls back to /dev/stderr; fd1/fd2 spellings are never probed); without <device>: report the current one #
{
  # ONE definition. A second `log.device() {` further down the file (2024)
  # overrode this one on every source — so the probe here was dead code and
  # `log device` only reported and re-ran `config save log LOG` (the D10
  # recursion out of config.save's HACK). Now: set, probe, report a change.
  # Persistence is not this method's job: LOG_DEVICE is per user and
  # log.session.save (bashrc) writes it to log.session.env.
  if [ -n "$1" ]; then
    local before="${LOG_DEVICE:-}"
    export LOG_DEVICE=$1
    private.log.device.probe
    [ "$LOG_DEVICE" = "$before" ] || important.log "new LOG_DEVICE=$LOG_DEVICE"
  else
    important.log "LOG_DEVICE=${LOG_DEVICE:-<unset>}"
  fi
}
log.device.completion.device() { echo /dev/tty; echo /dev/stderr; }


log.init() {
  local level=$1
  if [ "$level" = "localInstall" ] || ! this.isNumber $level; then
    level=3
  fi
  if [ -z "$CONFIG" ]; then
    # Ensure the path anchor exists before sourcing the env chain directly (this
    # path bypasses this). The same anchor this and user.env set.
    : ${CONFIG_PATH:=$HOME/config}
    export CONFIG_PATH
    CONFIG=~/config/user.env
    source $CONFIG
    source $OOSH_DIR/config
    log.init.colors
  fi

  private.log.device.probe

  if [ -n "$level" ]; then
    export LOG_LEVEL="$level"
    important.log "log level changed to $LOG_LEVEL"
  else
    export LOG_LEVEL=3
  fi

  # Initialize LOG_LIVE with per-user default path if not already set
  if [ -z "$LOG_LIVE" ]; then
    mkdir -p "$HOME/.config/oosh" 2>/dev/null
    export LOG_LIVE="$HOME/.config/oosh/log.live.out"
    touch "$LOG_LIVE" 2>/dev/null
  fi

  important.log "log initialized on level $LOG_LEVEL"
}

if ! [ "$(type -t info.log)" = "function" ]; then
  source $(dirname ${BASH_SOURCE[0]})/this
fi

# LOG_NAME — OOSH's OWN log identity, in the LOG_ underscore family. This is NOT
# the system `LOGNAME` (no underscore), which OOSH neither owns nor persists.
# Defaults to user@host; overridable via `log name <value>`. Keep an existing
# value (a custom name set this session survives re-sourcing). Below the
# source of `this`: the host is the kernel's private.this.host.name.get —
# `hostname` where it exists, else $HOSTNAME (T-LOG-NAME-NO-HOSTNAME).
export LOG_NAME="${LOG_NAME:-${USER:-$(id -un 2>/dev/null)}@${OOSH_SSH_CONFIG_HOST:-$(private.this.host.name.get short || echo localhost)}}"

