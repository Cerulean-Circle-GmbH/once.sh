  seq.puml.log
  private.log.install.append "TEST.CONSOLE" "$*"
  if [ -n "$LOG_LIVE" ] && [ -w "$LOG_LIVE" ] \
  && [ "$LOG_LEVEL" -gt "0" ]; then
    echo -e "${NO_COLOR}log: ${BASH_SOURCE[0]##*/} -> ${BASH_SOURCE[1]##*/}: ${FUNCNAME[0]}:${LINENO}   - ${BASH_SOURCE[@]##*/} >$*${NORMAL}" | tee -a ~/config/result.txt  >>$LOG_LIVE  
  fi
