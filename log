log.install.live() { # # install live logging (creates LOG_LIVE file if missing)
  if [ -z "$LOG_LIVE" ]; then
    export LOG_LIVE="${CONFIG_PATH:-$HOME/config}/log.live.out"
  fi
  touch "$LOG_LIVE" 2>/dev/null
  info.log "log.install.live: $LOG_LIVE"
}

log.install.init() { # <?path> # start capturing all log output to an install log file
  local logFile="${1:-${CONFIG_PATH:-$HOME/config}/install.log}"
  export LOG_INSTALL="$logFile"
  echo "# OOSH Install Log — $(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$LOG_INSTALL"
  create.result 0 "Install log created"
}

log.install.finish() { # # stop capturing install log and write completion marker
  if [ -n "$LOG_INSTALL" ] && [ -f "$LOG_INSTALL" ]; then
    echo "# Install completed: $(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$LOG_INSTALL"
  fi
  export LOG_INSTALL=""
  unset LOG_INSTALL
  create.result 0 "Install log finalized"
}

log.install() { # <?subcommand> # output install log, or dispatch sub-method (init/finish/errors/live)
  if [ -n "$1" ]; then
    local sub="$1"; shift
    if this.functionExists "log.install.$sub"; then
      "log.install.$sub" "$@"
      return $?
    fi
  fi
  local logFile="${LOG_INSTALL:-${CONFIG_PATH:-$HOME/config}/install.log}"
  if [ -f "$logFile" ]; then
    cat "$logFile"
  else
    warn.log "No install log found at $logFile"
    return 1
  fi
}

log.install.errors() { # # show only ERROR lines from the install log
  local logFile="${LOG_INSTALL:-${CONFIG_PATH:-$HOME/config}/install.log}"
  if [ -f "$logFile" ]; then
    grep -i "ERROR" "$logFile"
  else
    warn.log "No install log found at $logFile"
    return 1
  fi
}

log.live.panes() { # <?session:ooshlog> # create a tmux session with 4 panes for live log monitoring
  local session="${1:-ooshlog}"
  local tmux="${TMUX_CMD:-tmux -u}"
  if $tmux has-session -t "$session" 2>/dev/null; then
    info.log "log.live.panes: session $session already exists"
    return 0
  fi
  $tmux new-session -d -s "$session" 2>/dev/null
  $tmux split-window -v -t "$session" 2>/dev/null
  $tmux split-window -h -t "${session}:0.0" 2>/dev/null
  $tmux split-window -h -t "${session}:0.2" 2>/dev/null
  success.log "log.live.panes: created $session with 4 panes"
}

log.live.panes.stop() { # <?session:ooshlog> # kill the live panes session
  local session="${1:-ooshlog}"
  if otmux has "$session" 2>/dev/null; then
    otmux kill "$session" 2>/dev/null
    success.log "log.live.panes.stop: killed $session"
  else
    info.log "log.live.panes.stop: session $session not running"
  fi
  return 0
}

