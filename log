log.session.save() { # # persist per-user/session log vars (LOG_NAME, LOG_DEVICE, LOG_LIVE) to $HOME/.config/oosh/log.session.env
  # Per-user / per-session: these must NOT go into the shared log.env (every
  # user symlinks ~/config to one sharedConfig — they would leak). Written to
  # the user's OWN $HOME/.config/oosh, the same private dir oo uses for
  # mode-env.bash (oo.mode). Deliberately no system LOGNAME (see log.name).
  # The file is chained unguarded into every shell of this user, so each line
  # is built by the kernel's pure-data rule (private.this.env.export.line.get,
  # the one config uses): the raw value let a log name holding a quote run
  # code at every login (T-LOG-SESSION-PURE-DATA). A value that cannot be pure
  # data is refused and the file keeps its previous content.
  # Every interactive shell runs this (.bashrc): a file whose text already is
  # the built text is left alone — no rewrite, no new mtime — so parallel
  # terminals and a second run change nothing (T-LOG-SESSION-SAVE-IDEMPOTENT).
  # read -d '' takes the whole file, trailing newlines included; it answers
  # rc 0 only when it met a NUL byte, which the built text never holds.
  local d="$HOME/.config/oosh" body="" variableName line saved=""
  for variableName in LOG_NAME LOG_DEVICE LOG_LIVE; do
    if ! line=$(private.this.env.export.line.get "$variableName" "${!variableName}"); then
      create.result 1 "log.session.save: $variableName cannot be written as pure data — $d/log.session.env kept"
      error.log "$RESULT"
      return $(result)
    fi
    body="$body$line"$'\n'
  done
  if [ -f "$d/log.session.env" ] && ! IFS= read -r -d '' saved < "$d/log.session.env" && [ "$saved" = "$body" ]; then
    create.result 0 "$d/log.session.env"
    return $(result)
  fi
  mkdir -p "$d" 2>/dev/null
  printf '%s' "$body" > "$d/log.session.env" 2>/dev/null
  create.result 0 "$d/log.session.env"
  return $(result)
}

