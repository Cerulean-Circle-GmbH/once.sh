# oo shell function — source this file to enable 'oo mode' in the current shell
# Delegates mode/use to the newest worktree branch (so exports propagate),
# everything else to ~/oosh/oo as a normal command.

private.oo.shim.findLatest() {
  local base

  # Resolve ~/oosh (follow symlink if present) to find worktree base
  local ooshReal
  ooshReal=$(readlink -f "$HOME/oosh" 2>/dev/null || echo "$HOME/oosh")
  local parent
  parent=$(dirname "$ooshReal")
  if [ -d "$parent/main" ]; then
    base="$parent"
  elif [ -n "$OOSH_WORKTREE_BASE" ] && [ -d "$OOSH_WORKTREE_BASE" ]; then
    base="$OOSH_WORKTREE_BASE"
  else
    echo "$HOME/oosh"
    return
  fi

  # Pick most recently modified worktree dir
  ls -dt "$base"/*/ 2>/dev/null | head -1 | sed 's|/$||'
}

oo() {
  case "$1" in
    mode|use)
      local ooCmd="$1"
      shift
      # Pick up env from a previous subprocess run of 'oo mode'
      if [ -f "$HOME/.config/oosh/mode-env.bash" ]; then
        source "$HOME/.config/oosh/mode-env.bash"
        rm -f "$HOME/.config/oosh/mode-env.bash"
      fi
      local ooLatest
      ooLatest=$(private.oo.shim.findLatest)
      # Source in current shell so exports (OOSH_DIR, OOSH_MODE) propagate
      export STARTED=true
      export OO_FROM_LATEST=1
      source "$ooLatest/this" 2>/dev/null
      source "$ooLatest/oo" 2>/dev/null
      "oo.$ooCmd" "$@"
      ;;
    *)
      # All other oo subcommands run as normal command
      command "$HOME/oosh/oo" "$@"
      ;;
  esac
}
