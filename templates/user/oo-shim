#!/usr/bin/env bash
# oo shim — delegates mode/use to the newest branch, everything else to ~/oosh/oo

# Find the latest branch by picking the most recently modified worktree directory
_oo_shim_find_latest() {
  local base

  # Try OOSH_WORKTREE_BASE first
  if [ -n "$OOSH_WORKTREE_BASE" ] && [ -d "$OOSH_WORKTREE_BASE" ]; then
    base="$OOSH_WORKTREE_BASE"
  else
    # Resolve ~/oosh (follow symlink if present)
    local oosh_real
    oosh_real=$(readlink -f "$HOME/oosh" 2>/dev/null || echo "$HOME/oosh")
    local parent
    parent=$(dirname "$oosh_real")
    if [ -d "$parent/main" ]; then
      base="$parent"
    else
      # No worktree structure — fall back to ~/oosh itself
      echo "$HOME/oosh"
      return
    fi
  fi

  # Pick most recently modified worktree dir
  ls -dt "$base"/*/ 2>/dev/null | head -1 | sed 's|/$||'
}

case "$1" in
  mode)
    shift
    LATEST=$(_oo_shim_find_latest)
    export STARTED=true
    export OO_FROM_LATEST=1
    source "$LATEST/this" 2>/dev/null
    source "$LATEST/oo" 2>/dev/null
    oo.mode "$@"
    ;;
  use)
    shift
    LATEST=$(_oo_shim_find_latest)
    export STARTED=true
    export OO_FROM_LATEST=1
    source "$LATEST/this" 2>/dev/null
    source "$LATEST/oo" 2>/dev/null
    oo.use "$@"
    ;;
  *)
    # All other oo subcommands go through the normal ~/oosh/oo
    unset STARTED OO_FROM_LATEST
    exec "$HOME/oosh/oo" "$@"
    ;;
esac
