#!/bin/sh
# /usr/local/bin/this — the oosh launcher (templates/user/thisLauncher).
#
# THE EMPTY SHELL: `env -i sh` leaves only the system PATH
# (/usr/local/bin:/usr/bin:… on Linux, /usr/gnu/bin:/usr/local/bin:/bin:/usr/bin
# on macOS) and no HOME. Nothing of oosh is there, so a bare `this` was "not
# found". This one host-wide command — not a login file — starts the CALLER's
# own ~/oosh/this, whoever they are (root included), with every argument.
# Installed by the install, `oo update` and `oo user.fix`
# (private.oo.install.launcher). POSIX sh: dash and the macOS sh run it.
#
# SOURCED, not started: `source this` searches PATH for a bare name, and where
# ~/oosh is not on it yet (an empty shell, test.tilde's clean environment)
# bash finds THIS file. Its exec would replace the script that sourced it with
# a started `this` (T69 hung the platform run). So load the real ~/oosh/this
# into the caller and return — before homeRecovery, whose `exit` would end
# the caller too. `~`, not $HOME: bash expands it from the password database.
if [ -n "${BASH_VERSION:-}" ] && [ "${BASH_SOURCE:-$0}" != "$0" ]; then
  if [ -f ~/oosh/this ]; then
    . ~/oosh/this "$@"
    return $?
  fi
  echo "this: no oosh at ~/oosh — run: oo user.fix" >&2
  return 127
fi

# HOME first, from the OS identity, exactly as init/oosh does it (the
# homeRecovery block is the same; T-HOME-RECOVERY-NSS runs both).
# BEGIN homeRecovery
if [ -z "$HOME" ] || [ ! -d "$HOME" ]; then
  _oosh_user=$(id -un 2>/dev/null)
  _oosh_home=""
  if [ -n "$_oosh_user" ]; then
    # The shell's own ~user: it reads the user database (files, LDAP, … through
    # the C library) and gives ONE home — no getent at runtime (Marcel,
    # 2026-10-06). An unknown user stays a literal ~user: rejected.
    _oosh_home=$(eval echo ~"$_oosh_user" 2>/dev/null)
    case "$_oosh_home" in '~'*) _oosh_home="" ;; esac
    if [ -z "$_oosh_home" ] && command -v dscl >/dev/null 2>&1; then
      # macOS returns TWO paths in one field for root ("/var/root
      # /private/var/root"); take the first — same as private.get.home.darwin.
      # Hence `awk '{print $2}'` (field 2 = first path, after the key) and
      # not the rest of the line.
      _oosh_home=$(dscl . -read "/Users/$_oosh_user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    fi
    if [ -z "$_oosh_home" ] && [ -r /etc/passwd ]; then
      _oosh_home=$(awk -F: -v u="$_oosh_user" '$1 == u { print $6; exit }' /etc/passwd)
    fi
  fi
  if [ -n "$_oosh_home" ] && [ -d "$_oosh_home" ]; then
    HOME="$_oosh_home"
    export HOME
      else
    echo "this: \$HOME is unset or not a directory, and no home could be" >&2
    echo "this: derived for '${_oosh_user:-?}' from the user database (~user, dscl or /etc/passwd)." >&2
    echo "this: run it with HOME set, e.g. HOME=/home/you this" >&2
    unset _oosh_user _oosh_home
    exit 1
  fi
  unset _oosh_user _oosh_home
fi
# END homeRecovery

if [ ! -f "$HOME/oosh/this" ]; then
  echo "this: no oosh for $(id -un 2>/dev/null) at $HOME/oosh — run: oo user.fix" >&2
  exit 127
fi

# The bash the config names (BASH_FILE, read from user.env as data), else a
# brew bash, else the system's. Never the shebang of ~/oosh/this: under
# `env -i` on macOS `/usr/bin/env bash` finds /bin/bash 3.2.
ooshBash=$(sed -n 's/^export BASH_FILE="\(.*\)"$/\1/p' "$HOME/config/user.env" 2>/dev/null)
for ooshBashCandidate in "$ooshBash" /opt/homebrew/bin/bash /usr/local/bin/bash /bin/bash /usr/bin/bash; do
  if [ -n "$ooshBashCandidate" ] && [ -x "$ooshBashCandidate" ]; then
    exec "$ooshBashCandidate" "$HOME/oosh/this" "$@"
  fi
done
echo "this: no bash found to start $HOME/oosh/this" >&2
exit 127
