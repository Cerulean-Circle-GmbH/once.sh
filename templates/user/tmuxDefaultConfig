# ============================================================================
# tmux.conf - tmux configuration for oosh/otmux
# Generated by: otmux config.init
# Features: mouse, macOS clipboard, color support for Claude Code
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# MOUSE SUPPORT
# ─────────────────────────────────────────────────────────────────────────────

# Enable full mouse support
set -g mouse on

# ─────────────────────────────────────────────────────────────────────────────
# CLIPBOARD - macOS Integration
# ─────────────────────────────────────────────────────────────────────────────

# Use macOS clipboard
set -g set-clipboard on

# Copy mode key bindings (vi style)
setw -g mode-keys vi

# In copy mode: v to start selection, y to copy to clipboard
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "pbcopy"

# Mouse drag to copy directly to clipboard
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"

# Paste from macOS clipboard with prefix + p
bind p run "pbpaste | tmux load-buffer - && tmux paste-buffer"

# ─────────────────────────────────────────────────────────────────────────────
# TERMINAL SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Use xterm-256color for broad compatibility
set -g default-terminal "xterm-256color"

# Enable true color support
set -ga terminal-overrides ",xterm-256color:Tc"

# Set color environment variables for Claude Code and other apps
# FORCE_COLOR=1 ensures colors even if NO_COLOR is set elsewhere
set-environment -g COLORTERM truecolor
set-environment -g FORCE_COLOR 1

# Faster escape time (better for vim/editors)
set -s escape-time 10

# Large scrollback
set -g history-limit 50000

# ─────────────────────────────────────────────────────────────────────────────
# WINDOW & PANE SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Renumber windows when one is closed
set -g renumber-windows on

# ─────────────────────────────────────────────────────────────────────────────
# KEY BINDINGS
# ─────────────────────────────────────────────────────────────────────────────

# Reload config with prefix + r
bind r source-file ~/.tmux.conf \; display-message "Config reloaded!"

# Split panes with | and - (more intuitive)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# New windows/panes inherit current path
bind c new-window -c "#{pane_current_path}"

# Navigate panes with vim keys
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Resize panes with vim keys (prefix + H/J/K/L)
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
