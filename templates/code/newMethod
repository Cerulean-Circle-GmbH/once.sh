#   # @group:<name>   puts the method in a help section
#   # @hidden         omits the method from help and completion
newScript.newMethod()     # parameters # method description # an example
{
 local arg1="$1"
 if [ -n "$arg1" ]; then
   shift
   create.result 0 "arg1 is set to $arg1"
 else
  arg1=defualtVlaue
  create.result 1 "arg1 missing. Using: $arg1"
 fi
 info.log "arg1 is set to $arg1"


 return $(result)
}

