### new.method

newScript.usage()
{
  local this=${0##*/}
  echo "You started" 
  echo "$0

  Usage:
  $this: command   Parameter and Description"
  # this.help DERIVES the METHOD | PARAMETER | DESCRIPTION table from each
  # method's own `name() # <params> # description #` docstring. That docstring is
  # the single source — the completion engine reads the same line. Do NOT add a
  # per-method table below: it would duplicate what is derived here, and go stale
  # the moment a method changes (see docs/first-principles.md, DRY).
  this.help
  echo "
  
  Examples
    $this v
    $this init
  "
}

newScript.start()
{
  #echo "sourcing init"
  source this

  # if [ -z "$1" ]; then
