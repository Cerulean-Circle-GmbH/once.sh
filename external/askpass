#!/usr/bin/env bash
# SSH_ASKPASS script for oosh
# When invoked by SSH via SSH_ASKPASS, simply echoes the password
# stored in OSSH_PASSWORD. Falls back to oosh pipeline if available.
if [ -n "$OSSH_PASSWORD" ]; then
  echo "$OSSH_PASSWORD"
else
  # Fallback: try oosh pipeline
  DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
  OOSH_DIR="$(dirname "$DIR")"
  if [ -x "$OOSH_DIR/oosh" ]; then
    exec "$OOSH_DIR/oosh" ossh askpass "$@"
  fi
fi
