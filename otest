otest.parameter.completion.branch() {
  # The branches of the EAMD.ucp repository otest deploys; the current dir when
  # it is not known. private.eamdRoot only when OTEST_DIR is set — with it empty
  # its walk up never reaches / (dirname "" is "."), and completion would hang.
  private.this.script.load ogit ogit.branch.get
  local root=""
  [ -n "$OTEST_DIR" ] && root=$(private.eamdRoot)
  ogit.branch.list local "${root:-$PWD}"
}

