        if not name:
            continue
        print(name)
        if 'environments' in cfg:
            for env in cfg['environments']:
                if env != 'local':
                    print(name + '_' + env)
"
}

private.testNames.camel()
{
  # Convert discovered snake_case names to camelCase for tab-completion
  private.discoverTests | cut -f1 | sed 's/_\([a-z]\)/\U\1/g'
  echo "all"
}

