path.validate()     # <?treeRoot:$OOSH_DIR> # verify every PATH assignment in the tree carries a # path-exception: marker — no file builds PATH, it is data in ~/config/user.env; rc 1 + report on any violation #
{
  private.this.script.load ogit ogit.branch.get
  # THE RULE (docs/config.md § The PATH line): no file in the tree builds PATH.
  # A shell's PATH comes from ~/config/user.env, where `config save` writes the
  # oosh directories as DATA (there is no boot any more). So every assignment
  # in the tree is a violation unless it carries
  # `# path-exception: <reason>` on the line or in the few lines above it, or
  # `# path-exception-file: <reason>` anywhere in the file.
  #
  # Sibling of this.anchor.validate, NOT a copy of it, because what
  # "conforming" means is different. The anchor validator matches a CONSTANT:
  # OOSH_DIR is $HOME/oosh and anything else is wrong. PATH is an
  # ACCUMULATION, so no value test is possible — the rule can only be about
  # WHO MAY WRITE IT. That makes this a WRITER SWEEP with an exception marker.
  #
  # Same shape as this.anchor.validate and config.validate otherwise: one
  # tree scan, a verdict echoed to stdout (so it survives any LOG_LEVEL — the
  # status-output idiom), create.result / return $(result).
  local treeRoot="${1:-$OOSH_DIR}"
  if [ ! -d "$treeRoot" ]; then
    error.log "path.validate: no such directory: $treeRoot"
    echo "INVALID: no such directory: $treeRoot"
    create.result 2 "no such directory: $treeRoot"
    return $(result)
  fi
  # A sweep that reads nothing must not report OK (T-PATH-VALIDATE-BLIND).
  private.this.tree.tracked.check "$treeRoot" path.validate || return $(result)

  # ONE scan of the TRACKED tree (git grep is a single process and sees
  # tracked-but-gitignored files such as init/once, which predates its own
  # .gitignore entry). Excluded on purpose, same reasoning as the anchor
  # validator plus two of our own:
  #   docs/  test/  .claude/  *.md  *.json  — prose, fixtures and tool config
  #   old/  restore/                        — the legacy graveyards; every
  #                                           file in them is superseded, and
  #                                           marking them would only say so
  #                                           twenty more times.
  local matches
  # `(^|[^A-Za-z0-9_])PATH=` rather than `^[[:space:]]*PATH=`: boot's own
  # assignments sit inside a `case` and read `*) PATH="..." ;;`, so an anchored
  # pattern missed THE ONE CONFORMING SITE and reported 0 of them. The leading
  # class also keeps CONFIG_PATH=, OSSH_CONTROL_PATH= and every other
  # <SOMETHING>_PATH= out, because `_` is excluded from it.
  # path-exception: this is the sweep PATTERN, not an assignment — the sweep
  # necessarily contains the text it looks for.
  # The grep, the comment skip and the markers (on the line, in the 5 lines
  # above, `# path-exception-file:` file-wide) are the kernel's one sweep.
  matches=$(private.this.marker.sweep '(^|[^A-Za-z0-9_])(export[[:space:]]+)?PATH=' path "$treeRoot" \
              ':!docs' ':!test' ':!.claude' ':!old' ':!restore' ':!*.md' ':!*.json')

  local conforming=0 exceptions=0 violations=0
  local hit class match file lineNo content trimmed
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    class="${hit%% *}"
    match="${hit#* }"
    file="${match%%:*}"
    content="${match#*:}"
    lineNo="${content%%:*}"
    content="${content#*:}"
    trimmed="${content#"${content%%[![:space:]]*}"}"

    # A line that only TALKS about PATH is not an assignment.
    [ "$class" = comment ] && continue

    # Self-assignment is a no-op and cannot violate the rule.
    # path-exception: the two self-assignment SHAPES, quoted as data.
    case "$trimmed" in
      'PATH=$PATH' | 'PATH="$PATH"') continue ;;
    esac

    # Sanctioned exception: marked on the line, above it or file-wide.
    if [ "$class" = marked ]; then
      exceptions=$((exceptions + 1)); continue
    fi

    error.log "path.validate: $file:$lineNo writes PATH without a # path-exception: marker: $trimmed"
    violations=$((violations + 1))
  done <<< "$matches"

  if [ "$violations" -gt 0 ]; then
    error.log "path.validate: $violations violation(s); no file builds PATH — it is data in ~/config/user.env (see ${YELLOW}docs/config.md${NORMAL} § The PATH line). Mark a genuine exception with '# path-exception: <reason>'"
    echo "INVALID: PATH in $treeRoot — $violations violation(s), $conforming conforming, $exceptions exception(s)"
    create.result 1 "PATH: violations found"
    return $(result)
  fi
  echo "OK: PATH in $treeRoot — $conforming conforming, $exceptions exception(s), 0 violations"
  create.result 0 "PATH: 0 violations"
  return $(result)
}


path.validate.completion.treeRoot() { echo "$OOSH_DIR"; }
### new.method

path.usage() # # prints the usage information for path commands
{
  # The command table is rendered by this.help FROM THE DOCSTRINGS, exactly as
  # templates/code/newScript does it. A table that is written twice drifts; a
  # docstring cannot (docs/first-principles.md). add/push/put/rm are aliases
  # again; save/saved/load/edit front user.session.env (docs/config.md § The PATH line).
  local this=${0##*/}
  echo "You started"
  echo "$0

  reports the PATH, edits it for THIS SESSION, and saves it for new logins.
  ${CYAN}path save${NORMAL} writes ~/.config/oosh/user.session.env, which ~/config/user.env chains last — see docs/config.md § The PATH line.
  append / prepend / remove change the CALLING shell only when this script is
  SOURCED (\"source path\") and called by their dotted name (path.append …);
  \"path append …\" runs the script again, a child that exits.

  Usage:
  $this: command   Parameter and Description"
  this.help
  echo "

  Examples
    $this list
    $this env
    $this validate
    source path && path.prepend /my/custom/path
    $this save
    $this saved
  "
}

path.list() # # lists all PATH entries line by line
{
  # "$PATH" quoted: an unquoted $PATH word-splits and glob-expands, so a
  # segment containing a space or a * would be reported wrong.
  echo "$PATH" \
  | line.split ":" \
  | line.unquote
}

path.env() # # returns the PATH as an export statement in RESULT
{
  # path-exception: path.env REPORTS the PATH as an export statement; it does
  # not set one.
  create.result 0 "export PATH=$PATH" "$1"
  console.log "
          $RESULT
  "
  return $(result save)
}

path.file.custom() { # <file> # lists the custom path config
  cat "$1"
}

path.append() # <dir> # appends dir to the end of PATH for THIS SESSION; requires `source path`
{
  # SESSION-LOCAL, and the docstring now says so. Run as a command
  # (`path append /x`) this mutates a child process that then exits and the
  # calling shell is untouched; it changes the caller only under
  # `source path`. It used to claim "and saves config" and print "Path updated
  # in OOSH config: $CONFIG", neither of which was ever true — PATH is stopped
  # by config.save inclusion gate and no generated env file has carried it
  # since the env-file migration. The login PATH is data in ~/config/user.env; see docs/config.md.
  #
  # line.remove.exact, not line.filter: line.filter is `grep -v "$1"`, a
  # SUBSTRING match, so de-duping `/opt/x` also dropped `/opt/xy`.
  # line.unquote, because line.split already returns QUOTED entries.
  # No `line.into PATH`: that writes a bare unquoted PATH=<value> into
  # result.env, which corrupts on any later result.load.
  local dir="$1"
  if [ -z "$dir" ]; then
    error.log "path.append: no directory given — usage: path append <dir>"
    create.result 1 "no directory given"
    return $(result)
  fi
  # path-exception: session scope, and this script's whole job. user.env carries the
  # login PATH; these three methods edit only the shell that sourced them.
  PATH="$( echo "$PATH" \
         | line.split ":" \
         | line.unquote \
         | line.remove.exact "$dir" \
         | line.add "$dir" \
         | line.join ":" )"
  export PATH
  create.result 0 "appended $dir" "$2"
  return $(result)
}

path.prepend() # <dir> # prepends dir to the front of PATH for THIS SESSION; requires `source path`
{
  # Session-local, and segment-exact — see path.append for both. Prepend also
  # MOVES an entry that is already present to the front, which is the reason
  # the removal happens first.
  local dir="$1"
  if [ -z "$dir" ]; then
    error.log "path.prepend: no directory given — usage: path prepend <dir>"
    create.result 1 "no directory given"
    return $(result)
  fi
  # path-exception: session scope, and this script's whole job. user.env carries the
  # login PATH; these three methods edit only the shell that sourced them.
  PATH="$( echo "$PATH" \
         | line.split ":" \
         | line.unquote \
         | line.remove.exact "$dir" \
         | line.prepend "$dir" \
         | line.join ":" )"
  export PATH
  create.result 0 "prepended $dir" "$2"
  return $(result)
}

path.remove() # <dir> # removes every exact occurrence of dir from PATH for THIS SESSION; requires `source path`
{
  # Session-local, and WHOLE-SEGMENT. The old body used line.remove, which is
  # `grep -v "$1"` — a substring match — so `path remove /usr` deleted
  # /usr/bin, /usr/local/bin and /usr/sbin along with /usr. That is the bug
  # line.remove.exact was created for.
  local dir="$1"
  if [ -z "$dir" ]; then
    error.log "path.remove: no directory given — usage: path remove <dir>"
    create.result 1 "no directory given"
    return $(result)
  fi
  # path-exception: session scope, and this script's whole job. user.env carries the
  # login PATH; these three methods edit only the shell that sourced them.
  PATH="$( echo "$PATH" \
         | line.split ":" \
         | line.unquote \
         | line.remove.exact "$dir" \
         | line.join ":" )"
  export PATH
  create.result 0 "removed $dir" "$2"
  return $(result)
}

path.add() # <dir> # appends dir to PATH for THIS SESSION (alias for append); requires `source path` #
{
  path.append "$@"
}

path.push() # <dir> # appends dir to PATH for THIS SESSION (alias for append); requires `source path` #
{
  path.append "$@"
}

path.put() # <dir> # prepends dir to PATH for THIS SESSION (alias for prepend); requires `source path` #
{
  path.prepend "$@"
}

path.rm() # <dir> # removes dir from PATH for THIS SESSION (alias for remove); requires `source path` #
{
  path.remove "$@"
}

path.save() # # saves the PATH of this shell for every new login shell of this user (~/.config/oosh/user.session.env), then lists it #
{
  # The user's front for config.session.save: the writer, the segment filter
  # (no ., relative, /tmp, missing or venv directory) and the file are the ones
  # every login already reads — user.env chains user.session.env last. No file
  # of its own, so nothing can override it.
  source "$OOSH_DIR/config"
  config.session.save || { error.log "path.save: ${RESULT}"; return $(result); }
  echo "saved for every new login shell of $(id -un): $(private.config.user.session.file.get)"
  path.saved
  echo "shells opened before this one may write their older PATH back on 'oo mode' or 'config save'"
  create.result 0 "PATH saved" "$1"
  return $(result)
}

private.path.lines.join() # # reads directories one per line on stdin, drops blank, dot and relative lines, echoes the rest joined by a colon; pure bash, because line.join goes through xargs, which splits a directory with a space and dies on a quote #
{
  # NO create.result — a filter consumed as $(...): SILENT BY CONTRACT.
  local dir out=""
  while IFS= read -r dir || [ -n "$dir" ]; do
    case "$dir" in /*) out="${out:+$out:}$dir" ;; esac
  done
  printf '%s' "$out"
}

path.saved() # # lists the saved PATH (what a new login shell gets), one directory per line #
{
  source "$OOSH_DIR/config"
  local f list
  f=$(private.config.user.session.file.get)
  if [ ! -f "$f" ]; then
    # Not on stdout: path load reads this method's output as a PATH.
    error.log "path.saved: nothing saved yet: $f — run: path save"
    create.result 1 "nothing saved yet: $f"
    return $(result)
  fi
  # The file is pure data, so a subshell may source it. It starts with an EMPTY
  # PATH: a file without a PATH line (empty, or only OOSH_MODE) must not echo
  # the PATH this shell inherited. Sourcing needs builtins only.
  # path-exception: a subshell reads the saved PATH as data; this shell's PATH is untouched.
  list=$( PATH=; . "$f" >/dev/null 2>&1; printf '%s' "$PATH" )
  if [ -z "$list" ]; then
    error.log "path.saved: $f holds no PATH — run: path save"
    create.result 1 "no PATH in $f"
    return $(result)
  fi
  printf '%s\n' "$list" | tr ':' '\n'
  create.result 0 "listed $f"
  return $(result)
}

path.load() # <?file> # sets PATH in THIS shell from the saved PATH, or from <file> (one directory per line, e.g. an old ~/paths); requires `source path` #
{
  # A command cannot change its parent shell. Executed ($0 is this script)
  # it changes nothing and says how to get the result; sourced it sets PATH.
  if [ "${0##*/}" = "path" ]; then
    echo "path load changes the calling shell only when path is sourced — open a new shell (it already loads the saved PATH), or: source path; path.load"
    create.result 0 "nothing changed (run as a command)"
    return $(result)
  fi
  source "$OOSH_DIR/config"
  local file="$1" list
  if [ -n "$file" ]; then
    if [ ! -f "$file" ]; then
      error.log "path.load: no such file: $file"
      create.result 1 "no such file: $file"
      return $(result)
    fi
    list=$(private.path.lines.join < "$file")
  else
    if [ ! -f "$(private.config.user.session.file.get)" ]; then
      error.log "path.load: nothing saved yet — PATH unchanged; run: path save"
      create.result 1 "nothing saved yet"
      return $(result)
    fi
    list=$(path.saved 2>/dev/null | private.path.lines.join)
  fi
  # An empty list would empty PATH and break every command after it.
  if [ -z "$list" ]; then
    error.log "path.load: no directory to load${file:+ in $file} — PATH unchanged"
    create.result 1 "no directory to load"
    return $(result)
  fi
  # path-exception: session scope, and this script's whole job — the list is
  # the saved PATH (or the file the caller named), loaded into this shell.
  PATH="$list"
  export PATH
  private.this.path.dedup
  create.result 0 "PATH loaded${file:+ from $file}" "$2"
  return $(result)
}

path.edit() # # edits the saved PATH, one directory per line, in $EDITOR and saves the result for every new login shell #
{
  source "$OOSH_DIR/config"
  local tmp list
  tmp=$(mktemp "${TMPDIR:-/tmp}/oosh.path.edit.XXXXXX") || { create.result 1 "no temp file"; return $(result); }
  # Any way out of this method removes the temp file (Ctrl-C included).
  trap 'rm -f "$tmp" "$tmp.bak"; trap - RETURN' RETURN
  if [ -f "$(private.config.user.session.file.get)" ]; then
    path.saved > "$tmp" 2>/dev/null
  else
    path.list > "$tmp"
  fi
  if ! ${EDITOR:-vi} "$tmp"; then
    error.log "path.edit: editor aborted — nothing saved"
    create.result 1 "editor aborted — nothing saved"
    return $(result)
  fi
  list=$(private.path.lines.join < "$tmp")
  if [ -z "$list" ]; then
    error.log "path.edit: empty list — nothing saved"
    create.result 1 "empty list — nothing saved"
    return $(result)
  fi
  # A list that cannot find a shell would break every new login.
  # path-exception: a lookup test only, for the duration of one command.
  if ! PATH="$list" command -v sh >/dev/null 2>&1; then
    error.log "path.edit: the list finds no shell — /usr/bin and /bin are missing; nothing saved"
    create.result 1 "no shell on the edited PATH (/usr/bin and /bin are missing) — nothing saved"
    return $(result)
  fi
  # config.session.save's segment filter decides what is written, so no
  # hand-written line reaches the env file. A subshell: this shell keeps its PATH.
  (
    # path-exception: the edited list, in a subshell, only so config.session.save writes it.
    PATH="$list"
    export PATH
    config.session.save >/dev/null
  ) || { create.result 1 "save failed"; return $(result); }
  path.saved
  create.result 0 "PATH saved from the edit"
  return $(result)
}

