#!/usr/bin/env bash
# osemvec — semvec-guarded claudeCode provisioner (OOSH).
#
# Provisions a semvec environment (via `opy`) and spawns claudeCode instances
# that both LEVERAGE semvec (MCP memory tools) and are GUARDED by it (a
# PreToolUse gate + a supervisor loop). `osemvec install` uses `opy` to
# guarantee Python + a dedicated venv, then pip-installs semvec (all extras)
# and stages the .mcp.json / .claude/settings.json integration shapes.
#
# SAFETY (PO opy1, CRITICAL): osemvec.new DEFAULTS TO DRY-RUN. It never spawns a
# live claudeCode until explicitly authorized — mirroring hiveMind.agent.rewind's
# default-refuse auth. No live spawns during dev/test.
#
# Author: oosh-expert · Spec: sprint-1/task-2.osemvec.md · Depends: Epic 1 (opy)

# ── Resolution helpers (private) ─────────────────────────────────────────────

private.osemvec.venvName() # # echo the managed venv name osemvec builds via opy
{
  echo "${OSEMVEC_VENV:-osemvec}"
}

private.osemvec.venvPython() # # absolute interpreter path of the opy-built osemvec venv
{
  # Coupled to opy's public venv-home contract (OPY_VENVS, default ~/.opy/venvs).
  echo "${OPY_VENVS:-$HOME/.opy/venvs}/$(private.osemvec.venvName)/bin/python"
}

private.osemvec.pyver() # # python version to build on — measured from opy, overridable
{
  # Measure the newest installed pyenv version (via opy) rather than assume one.
  echo "${OSEMVEC_PYVER:-$(opy version.list 2>/dev/null | tail -1)}"
}

private.osemvec.stateDir() # # osemvec state/template home
{
  echo "${OSEMVEC_STATE:-$HOME/.osemvec}"
}

private.osemvec.templatesDir() # # where install stages the integration templates
{
  echo "$(private.osemvec.stateDir)/templates"
}

private.osemvec.osemvecBin() # # absolute path to this script (for hook commands)
{
  command -v osemvec 2>/dev/null || echo "$OOSH_DIR/osemvec"
}

private.osemvec.agentsDir() # # canonical agents dir — cwd/shell-independent (env → config FILE → FS walk)
{
  # Resolve-from-canonical-source (same doctrine class as the oo-new bug): the
  # roles/agents dir must NOT depend on the caller's cwd. The agents dir is not
  # under OOSH_DIR in this deployment, so we resolve, in order:
  #   1. HIVEMIND_AGENTS_DIR env (explicit override)
  #   2. the persisted pointer read DIRECTLY from the OOSH config FILE (env may be
  #      unset in non-login shells; the file is the source of truth)
  #   3. an upward walk from realpath(OOSH_DIR), then PWD (last resort)
  if [ -n "$HIVEMIND_AGENTS_DIR" ] && [ -d "$HIVEMIND_AGENTS_DIR" ]; then
    echo "$HIVEMIND_AGENTS_DIR"; return 0
  fi
  local cfg="${CONFIG:-$HOME/config/user.env}"
  if [ -f "$cfg" ]; then
    local fromFile
    fromFile=$(grep -E '^[[:space:]]*export[[:space:]]+HIVEMIND_AGENTS_DIR=' "$cfg" 2>/dev/null \
      | tail -1 | sed -E 's/^[^=]*=//; s/^"//; s/"$//')
    [ -n "$fromFile" ] && [ -d "$fromFile" ] && { echo "$fromFile"; return 0; }
  fi
  local start d
  for start in "$(realpath "${OOSH_DIR:-.}" 2>/dev/null)" "$PWD"; do
    d="$start"
    while [ -n "$d" ] && [ "$d" != "/" ]; do
      [ -d "$d/.claude/agents" ] && { echo "$d/.claude/agents"; return 0; }
      d=$(dirname "$d")
    done
  done
  return 0
}

private.osemvec.knownRoles() # # clean role-name list, resolved canonically (FILTERED — error text never leaks)
{
  local ad; ad=$(private.osemvec.agentsDir)
  # grep filter = the error-leak guard: only plausible role names survive, so an
  # "ERROR> Agents directory not found" line can never be treated as a role.
  HIVEMIND_AGENTS_DIR="$ad" hiveMind role.list 2>/dev/null | grep -E '^[A-Za-z][A-Za-z0-9._-]{0,39}$'
}

# ── Integration templates (private; emit JSON with the venv interpreter baked in)
# Reuses the proven shapes from web4x/osemvec, adding the PreToolUse guard.

private.osemvec.mcpJson() # <?python> # emit .mcp.json (semvec MCP server via venv python)
{
  local py="${1:-$(private.osemvec.venvPython)}"
  cat <<EOF
{
  "mcpServers": {
    "semvec": {
      "command": "$py",
      "args": ["-m", "semvec.coding.mcp_server"],
      "env": {
        "SEMVEC_STATE_DIR": ".semvec",
        "SEMVEC_WORKSPACE": ".",
        "SEMVEC_EMBED_MODEL": "all-MiniLM-L6-v2",
        "SEMVEC_EMBED_DEVICE": "cpu"
      }
    }
  }
}
EOF
}

private.osemvec.settingsJson() # <?python> # emit .claude/settings.json (SessionStart/PreCompact + PreToolUse guard)
{
  local py="${1:-$(private.osemvec.venvPython)}"
  local guard; guard="$(private.osemvec.osemvecBin)"
  cat <<EOF
{
  "env": {
    "MCP_TIMEOUT": "180000",
    "MCP_CONNECT_TIMEOUT_MS": "180000"
  },
  "permissions": {
    "allow": [
      "mcp__semvec__pss_get_context",
      "mcp__semvec__pss_update",
      "mcp__semvec__pss_check_anti_resonance",
      "mcp__semvec__pss_register_code",
      "mcp__semvec__pss_record_error",
      "mcp__semvec__pss_save"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$py -m semvec.coding.hooks.session_start", "timeout": 120 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "$py -m semvec.coding.hooks.pre_compact", "timeout": 120 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "$guard check", "timeout": 30 } ] }
    ]
  }
}
EOF
}

private.osemvec.venvReady() # # 0 if the osemvec venv interpreter exists + runs
{
  local py; py="$(private.osemvec.venvPython)"
  [ -x "$py" ] && "$py" -c 'pass' >/dev/null 2>&1
}

private.osemvec.semvecVersion() # <python> # echo installed semvec version (or empty)
{
  # Kept out of an inline $(...) — nested single-quoted parens break bash's parser.
  local py="$1"
  "$py" -c 'import semvec; print(getattr(semvec,"__version__","?"))' 2>/dev/null
}

private.osemvec.provision() # <projectDir> # write .claude/settings.json + .mcp.json into a dir (idempotent)
{
  local dir="$1"
  [ -z "$dir" ] && { error.log "provision: projectDir required"; return 1; }
  mkdir -p "$dir/.claude" || { error.log "provision: cannot create $dir/.claude"; return 1; }
  private.osemvec.mcpJson      > "$dir/.mcp.json"            || return 1
  private.osemvec.settingsJson > "$dir/.claude/settings.json" || return 1
  return 0
}

# ── Constructor ──────────────────────────────────────────────────────────────

osemvec.start() # # constructor: source kernel + dispatch (provisioning lives in osemvec.install)
{
  source this
  this.start "$@"
}

# ── Provisioning ─────────────────────────────────────────────────────────────

osemvec.install() # # opy-ensure python + build osemvec venv + pip semvec (all extras) + stage integration templates
{
  local pyver; pyver="$(private.osemvec.pyver)"
  [ -z "$pyver" ] && { error.log "osemvec.install: no python version resolvable (set OSEMVEC_PYVER or run 'opy install <ver>')"; return 1; }
  local venv; venv="$(private.osemvec.venvName)"

  # 1. Ensure Python + the dedicated venv, via opy (idempotent).
  console.log "osemvec.install: ensuring python $pyver + venv '$venv' via opy"
  opy install "$pyver"            || { error.log "osemvec.install: opy install $pyver failed"; return 1; }
  opy venv.create "$venv" "$pyver" || { error.log "osemvec.install: opy venv.create $venv failed"; return 1; }

  # 2. pip-install semvec (all extras) + sentence-transformers through the venv.
  local py; py="$(private.osemvec.venvPython)"
  [ -x "$py" ] || { error.log "osemvec.install: venv interpreter missing at $py"; return 1; }
  console.log "osemvec.install: pip installing semvec[all-extras] + sentence-transformers (this can take a while)…"
  "$py" -m pip install --upgrade pip >/dev/null 2>&1
  "$py" -m pip install "semvec[cortex,coding,compliance,api,hybrid]" sentence-transformers \
    || { error.log "osemvec.install: pip install failed"; return 1; }

  # 3. Stage integration templates (interpreter path baked in).
  local tdir; tdir="$(private.osemvec.templatesDir)"
  mkdir -p "$tdir/.claude" || { error.log "osemvec.install: cannot create $tdir"; return 1; }
  private.osemvec.mcpJson      "$py" > "$tdir/.mcp.json"
  private.osemvec.settingsJson "$py" > "$tdir/.claude/settings.json"
  console.log "osemvec.install: staged templates under $tdir"
  return 0
}

# ── Indexing ─────────────────────────────────────────────────────────────────

osemvec.index() # <projectDir> # prepare/refresh the semvec state dir for a project (semvec indexes incrementally)
{
  local dir="$1"
  [ -z "$dir" ] && { error.log "usage: osemvec index <projectDir>"; return 1; }
  [ -d "$dir" ] || { error.log "osemvec.index: no such directory: $dir"; return 1; }
  local py; py="$(private.osemvec.venvPython)"
  if [ ! -x "$py" ]; then
    error.log "osemvec.index: osemvec venv not built — run 'osemvec install' first"; return 1
  fi
  if ! "$py" -c 'import semvec' >/dev/null 2>&1; then
    error.log "osemvec.index: semvec not importable in venv — run 'osemvec install'"; return 1
  fi
  # MEASURED: semvec exposes NO batch/CLI project indexer. CodePointerIndex.register
  # is per-pointer, driven by the MCP pss_register_code tool as the guarded instance
  # works; state persists to SEMVEC_STATE_DIR (.semvec). So 'index' PREPARES that
  # state dir and the index populates incrementally. When semvec ships a batch
  # indexer, wire it here (see task-2 done-report seam note for python-expert).
  local stateDir="$dir/.semvec"
  mkdir -p "$stateDir" || { error.log "osemvec.index: cannot create $stateDir"; return 1; }
  console.log "osemvec.index: prepared $stateDir — semvec populates it incrementally via pss_register_code"
  return 0
}
osemvec.index.completion.projectDir() { compgen -d -- "$1"; }

# ── semvec operations (reflect semvec's real surface as OOSH object.verb) ─────
# semvec's CLI is `semvec serve` (REST API); its operational surface is 6 PSS
# handlers in semvec.coding.mcp_server (the MCP pss_* tools). Each is exposed here
# as a thin OOSH method through a single engine-invoking chokepoint. NOTE: building
# the engine loads the embedder model (~seconds) — these are explicit CLI ops, not
# per-tool hooks. Skip-guarded in tests.

private.osemvec.pss() # <projectDir> <handler> <args...> # invoke a semvec MCP handler via the venv engine; echo its result
{
  local dir="$1" handler="$2"; shift 2
  [ -d "$dir" ] || { error.log "osemvec: no such projectDir: $dir"; return 1; }
  local py; py="$(private.osemvec.venvPython)"
  [ -x "$py" ] || { error.log "osemvec: venv not built — run 'osemvec install'"; return 1; }
  ( cd "$dir" && SEMVEC_STATE_DIR=".semvec" SEMVEC_WORKSPACE="." OSEMVEC_HANDLER="$handler" \
      "$py" - "$@" <<'PYEOF'
import os, sys
import semvec.coding.mcp_server as m
h = getattr(m, os.environ["OSEMVEC_HANDLER"], None)
if h is None:
    sys.stderr.write("unknown semvec handler: %s\n" % os.environ["OSEMVEC_HANDLER"]); sys.exit(2)
eng = m.create_engine(state_dir=os.environ.get("SEMVEC_STATE_DIR", ".semvec"),
                      workspace_dir=os.environ.get("SEMVEC_WORKSPACE", "."))
try:
    out = h(eng, *sys.argv[1:])
    sys.stdout.write(out if isinstance(out, str) else str(out))
except TypeError as e:
    sys.stderr.write("semvec %s arg error: %s\n" % (os.environ["OSEMVEC_HANDLER"], e)); sys.exit(2)
except Exception as e:
    sys.stderr.write("semvec %s error: %s\n" % (os.environ["OSEMVEC_HANDLER"], e)); sys.exit(3)
PYEOF
  )
}

osemvec.serve() # <?port:8000> <?host:127.0.0.1> # run the semvec REST API server (semvec serve)
{
  local port="${1:-8000}" host="${2:-127.0.0.1}"
  local py; py="$(private.osemvec.venvPython)"
  [ -x "$py" ] || { error.log "osemvec.serve: venv not built — run 'osemvec install'"; return 1; }
  console.log "osemvec.serve: semvec REST API on ${host}:${port} (Ctrl-C to stop)"
  "$py" -m semvec.api.cli serve --host "$host" --port "$port"
}

osemvec.context() # <projectDir> <task> # semvec PSS: get semantic context for a task (pss_get_context)
{
  local dir="$1" task="$2"
  [ -z "$dir" ] || [ -z "$task" ] && { error.log "usage: osemvec context <projectDir> <task>"; return 1; }
  private.osemvec.pss "$dir" handle_get_context "$task"
}
osemvec.context.completion.projectDir() { compgen -d -- "$1"; }

osemvec.register() # <projectDir> <file> <intent> <signature> # semvec PSS: register a code pointer into the index (pss_register_code)
{
  local dir="$1" file="$2" intent="$3" sig="$4"
  [ -z "$dir" ] || [ -z "$file" ] || [ -z "$intent" ] || [ -z "$sig" ] && { error.log "usage: osemvec register <projectDir> <file> <intent> <signature>"; return 1; }
  private.osemvec.pss "$dir" handle_register_code "$file" "$intent" "$sig"
}
osemvec.register.completion.projectDir() { compgen -d -- "$1"; }
osemvec.register.completion.file() { compgen -f -- "$1"; }

osemvec.update() # <projectDir> <text> <type> # semvec PSS: update persistent semantic state (pss_update)
{
  local dir="$1" text="$2" type="$3"
  [ -z "$dir" ] || [ -z "$text" ] || [ -z "$type" ] && { error.log "usage: osemvec update <projectDir> <text> <type>"; return 1; }
  private.osemvec.pss "$dir" handle_update "$text" "$type"
}
osemvec.update.completion.projectDir() { compgen -d -- "$1"; }

osemvec.error() # <projectDir> <errorText> <source> # semvec PSS: record an error (pss_record_error)
{
  local dir="$1" text="$2" src="$3"
  [ -z "$dir" ] || [ -z "$text" ] || [ -z "$src" ] && { error.log "usage: osemvec error <projectDir> <errorText> <source>"; return 1; }
  private.osemvec.pss "$dir" handle_record_error "$text" "$src"
}
osemvec.error.completion.projectDir() { compgen -d -- "$1"; }

osemvec.save() # <projectDir> # semvec PSS: persist state to .semvec (pss_save)
{
  local dir="$1"
  [ -z "$dir" ] && { error.log "usage: osemvec save <projectDir>"; return 1; }
  private.osemvec.pss "$dir" handle_save
}
osemvec.save.completion.projectDir() { compgen -d -- "$1"; }

# ── Spawn (SAFETY: default dry-run, live spawn is auth-gated) ─────────────────

osemvec.new() # <role> <projectDir> <?policy> # provision + (auth-gated) spawn a semvec-guarded claudeCode
{
  local role="$1" dir="$2" policy="$3"
  [ -z "$role" ] || [ -z "$dir" ] && { error.log "usage: osemvec new <role> <projectDir> <?policy>"; return 1; }
  if ! this.isRoleName "$role"; then
    error.log "osemvec.new: malformed role '$role' (see 'hiveMind roles')"; return 1
  fi
  # Resolve the agents dir CANONICALLY (not from cwd) and export it, so BOTH the
  # role lookup below AND the downstream hiveMind bootstrap resolve roles from any
  # cwd/shell. This is the resolve-from-canonical-source fix for the clean-cwd bug.
  export HIVEMIND_AGENTS_DIR="$(private.osemvec.agentsDir)"
  # Existence check: reject unknown roles when the (filtered) registry lists any.
  local knownRoles; knownRoles=$(private.osemvec.knownRoles)
  if [ -n "$knownRoles" ] && ! printf '%s\n' "$knownRoles" | grep -qx "$role"; then
    error.log "osemvec.new: unknown role '$role' — see 'hiveMind roles'"; return 1
  fi
  [ -d "$dir" ] || { error.log "osemvec.new: no such projectDir: $dir"; return 1; }

  # Inject the guard + semvec inheritance into projectDir/.claude BEFORE any spawn.
  private.osemvec.provision "$dir" || { error.log "osemvec.new: provisioning failed"; return 1; }
  console.log "osemvec.new: provisioned $dir/.claude/settings.json + $dir/.mcp.json (semvec-guarded)"

  # AUTH GATE — default-refuse the LIVE spawn (mirror hiveMind.agent.rewind).
  # Live spawn requires an explicit policy token OR OSEMVEC_SPAWN_AUTHORIZED=1.
  local authorized=0
  case "$policy" in
    authorized|confirm|yes|live) authorized=1 ;;
  esac
  [ "${OSEMVEC_SPAWN_AUTHORIZED:-0}" = "1" ] && authorized=1

  if [ "$authorized" -eq 0 ]; then
    important.log "osemvec.new: DRY-RUN (default) — NOT spawning a live claudeCode."
    console.log "  Would: cd '$dir' && hiveMind agent.bootstrap '$role' (semvec inherited via .mcp.json)."
    console.log "  Authorize a real spawn with: osemvec new '$role' '$dir' authorized   (or OSEMVEC_SPAWN_AUTHORIZED=1)"
    create.result 0 "dry-run: $role @ $dir"
    return 0
  fi

  # LIVE PATH (authorized) — cd first so the spawned instance inherits projectDir.
  # All cross-tool calls go through the CLI (osemvec sources only `this`).
  local session; session=$(hiveMind team.active 2>/dev/null | head -1 | tr -d ' ')
  [ -z "$session" ] && { error.log "osemvec.new: no active team session to spawn into"; return 1; }
  otmux split.h -t "${session}:0" || { error.log "osemvec.new: pane split failed"; return 1; }
  otmux tiled "${session}:0"
  local idx; idx=$(otmux panes -t "${session}:0" -F "#{pane_index}" | sort -n | tail -1)
  local pane="${session}:0.${idx}"
  otmux send.enter "$pane" "cd '$dir'"          # cd BEFORE launch (spec)
  console.log "osemvec.new: spawning guarded '$role' in $pane (cwd=$dir)"
  hiveMind agent.bootstrap "$role" "$session" "$pane" || { error.log "osemvec.new: bootstrap failed"; return 1; }
  create.result 0 "spawned: $role @ $pane"
  return 0
}
osemvec.new.completion.role() { private.osemvec.knownRoles; }
osemvec.new.completion.projectDir() { compgen -d -- "$1"; }

# ── Guard verdict (used by the PreToolUse hook) ──────────────────────────────

osemvec.check() # <?target> # semvec anti-resonance / query verdict; exit 0 = allow, 2 = block (Claude Code hook)
{
  local target="${1:-.}"
  local py; py="$(private.osemvec.venvPython)"
  # Fail-OPEN when the guard infra is not yet built (never brick a project);
  # honor a real semvec verdict when available. Loud either way.
  if [ ! -x "$py" ]; then
    debug.log "osemvec.check: semvec venv absent — allowing (infra not built; run 'osemvec install')"
    return 0
  fi
  # semvec exposes anti-resonance via MCP (pss_check_anti_resonance). A CLI seam
  # is not yet published, so this is best-effort: probe importability and defer
  # the verdict to semvec when a check module lands. Until then: allow + note.
  if "$py" -c 'import semvec' >/dev/null 2>&1; then
    debug.log "osemvec.check: semvec present — anti-resonance CLI seam pending; allowing '$target'"
    return 0
  fi
  warn.log "osemvec.check: semvec not importable in venv — allowing '$target' (fail-open)"
  return 0
}
osemvec.check.completion.target() { compgen -d -- "$1"; }

# ── Supervisor gate (mirror agent.rewind: default-refuse auth to actually HOLD)

osemvec.guard() # <pane> <?auth> # one gate pass: measure pane, HOLD on drift / clear on pass (auth-gated mutation)
{
  local pane="$1" auth="$2"
  [ -z "$pane" ] && { error.log "usage: osemvec guard <pane> <?auth>"; return 1; }
  if ! this.isPaneTarget "$pane"; then
    error.log "osemvec.guard: '$pane' is not a live pane target"; return 1
  fi

  # Resolve pane → role (state mutation uses the PUBLIC role-keyed hiveMind API).
  local role; role=$(hiveMind registry.list "${pane%%:*}" 2>/dev/null | grep "^${pane}|" | head -1 | cut -d'|' -f2)

  # Measure the semantic verdict for the instance's project (its cwd).
  local verdict=0
  osemvec.check "$pane" >/dev/null 2>&1 || verdict=$?

  if [ "$verdict" -eq 0 ]; then
    # Pass → clear any HOLD (only mutate state when authorized, default-refuse).
    if private.osemvec.authorized "$auth"; then
      [ -n "$role" ] && hiveMind agent.state.clear "$role" >/dev/null 2>&1
      console.log "osemvec.guard: $pane (${role:-?}) PASS — hold cleared"
    else
      console.log "osemvec.guard: $pane (${role:-?}) PASS (dry-run — pass 'authorized' to clear hold state)"
    fi
    return 0
  fi

  # Drift → HOLD the instance (à la agent.rewind DURING_REWIND quiesce).
  if private.osemvec.authorized "$auth"; then
    [ -n "$role" ] && hiveMind agent.state.set "$role" "OSEMVEC_HOLD" >/dev/null 2>&1
    error.log "osemvec.guard: $pane (${role:-?}) DRIFT (verdict=$verdict) — set OSEMVEC_HOLD"
  else
    error.log "osemvec.guard: $pane (${role:-?}) DRIFT (verdict=$verdict) — WOULD set OSEMVEC_HOLD (dry-run; pass 'authorized')"
  fi
  return "$verdict"
}
osemvec.guard.completion.pane() { hiveMind registry.list 2>/dev/null | cut -d'|' -f1; }

private.osemvec.authorized() # <?auth> # 0 if guard state-mutation is authorized (default-refuse)
{
  case "$1" in authorized|confirm|yes) return 0 ;; esac
  [ "${OSEMVEC_GUARD_AUTHORIZED:-0}" = "1" ]
}

# ── Status ───────────────────────────────────────────────────────────────────

osemvec.status() # # list guarded instances + semvec health
{
  console.log "── semvec health ──"
  local py; py="$(private.osemvec.venvPython)"
  if private.osemvec.venvReady; then
    local ver; ver="$(private.osemvec.semvecVersion "$py")"
    console.log "  venv:   $py (ok)"
    console.log "  semvec: ${ver:-not importable}"
  else
    console.log "  venv:   NOT BUILT — run 'osemvec install'"
  fi
  console.log "── guarded instances (HOLD state) ──"
  local stateFile="${HIVEMIND_STATE:-${CONFIG_PATH:-$HOME/config}/hivemind.state.env}"
  if [ -f "$stateFile" ]; then
    grep 'OSEMVEC_HOLD' "$stateFile" 2>/dev/null | cut -d'|' -f1,2 | tr '|' ' ' || true
  fi
  return 0
}

