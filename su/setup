#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

#echo "starting: $0 <LOG_LEVEL=$1>"

# What install state 50 (headless.setup.started) runs on every computer:
# setup all = docker, nodejs + npm (nvm), headless (VNC / Screen Sharing) and
# samba support. Nothing asks for a password during the install: VNC and Samba
# stay off until vnc.password / samba.password (docs/setup.md). Every method
# installs nothing under OOSH_NO_INSTALL (a test run); packages go through
# oo cmd, Docker through odocker prereqs.install (test/test.setup).

# The nvm release the installer is pinned to: never an unpinned script.
SETUP_NVM_VERSION="v0.40.3"

### new.method

private.setup.gate()     #  # rc 0 with RESULT when OOSH_NO_INSTALL is set — a test run installs nothing; rc 1 otherwise #
{
 [ -n "$OOSH_NO_INSTALL" ] || return 1
 create.result 0 "OOSH_NO_INSTALL is set: nothing installed"
}

private.setup.user.get()     # <?user> # echo <user>, else the one who ran sudo (never root), else nothing #
{
 # NO create.result — a getter consumed as $(...).
 if [ -n "$1" ]; then echo "$1"
 elif [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then echo "$SUDO_USER"
 fi
}

private.setup.as.user()     # <user> <command> <?args…> # run <command> as <user>: directly when that is who runs, through sudo -u <user> -H as root, through $SUDO -u <user> -H for anyone else #
{
 # Anyone else: user create runs as a user with sudo and gives the new user
 # node (user.oosh.install, T-USER-INSTALL-NODE) — the same $SUDO the rest of
 # user.oosh.install uses.
 local user="$1"; shift
 if [ "$user" = "$(id -un)" ]; then
   "$@"
 elif [ "$(id -u)" = "0" ]; then
   sudo -u "$user" -H "$@"
 else
   ${SUDO:-sudo } -u "$user" -H "$@"
 fi
}

private.setup.nvm.is()     # <user> # rc 0 when <user> has nvm — asked AS <user>: the caller may not see into that home #
{
 # user create runs as a user with sudo, and /home/oosh-user is drwxr-x---: a
 # check from the caller said "nvm install failed" for an nvm that was there
 # (platform container, 2026-10-14, T-SETUP-NVM).
 private.setup.as.user "$1" sh -c '[ -f "$HOME/.nvm/nvm.sh" ]'
}

private.setup.systemd.is()     #  # rc 0 when systemd runs this computer (the VNC and Samba services need it) #
{
 [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

private.setup.mac.is()     #  # rc 0 on macOS #
{
 case "${OOSH_OS:-$(uname -s)}" in darwin*|Darwin) return 0 ;; esac
 return 1
}

private.setup.pm.ensure()     #  # load oo cmd and discover the package manager when OOSH_PM is still empty #
{
 private.this.script.load oo oo.cmd || return 1
 [ -n "$OOSH_PM" ] || oo.pm.discover >/dev/null 2>&1
}

private.setup.package.get()     # <cmd> # echo the package that provides <cmd> for the package manager in OOSH_PM; <cmd> itself when it is the same #
{
 # NO create.result — a getter consumed as $(...). The one table of su/setup,
 # like private.odocker.prereq.package.get for odocker.
 case "$1:${OOSH_PM%% *}" in
   vncserver:dnf|vncserver:yum)       echo "tigervnc-server" ;;
   vncserver:*)                       echo "tigervnc-standalone-server" ;;
   startxfce4:*)                      echo "xfce4-session" ;;
   dbus-launch:*)                     echo "dbus-x11" ;;
   smbd:*)                            echo "samba" ;;
   smbclient:dnf|smbclient:yum)       echo "samba-client" ;;
   avahi-daemon:dnf|avahi-daemon:yum) echo "avahi" ;;
   *)                                 echo "$1" ;;
 esac
}

private.setup.cmds.install()     # <cmd> <?cmd…> # oo cmd every <cmd> with its package; rc 1 at the first that fails, naming it #
{
 local cmd
 for cmd in "$@"; do
   oo.cmd "$cmd" "$(private.setup.package.get "$cmd")" || { create.result 1 "$cmd: $RESULT"; return 1; }
 done
 create.result 0 "installed: $*"
}

private.setup.launchd.on()     # <label> # macOS: enable and load the system launch daemon <label> (com.apple.screensharing, com.apple.smbd); rc 0 when it is loaded #
{
 $SUDO launchctl enable "system/$1" >/dev/null 2>&1
 # bootstrap refuses a daemon that is already loaded: then it is on.
 $SUDO launchctl bootstrap system "/System/Library/LaunchDaemons/$1.plist" >/dev/null 2>&1 \
   || $SUDO launchctl print "system/$1" >/dev/null 2>&1
}

setup.docker()     # <?user:$SUDO_USER> # Docker here (engine on a computer, client in a container) and <user> in the group of its socket — odocker prereqs.install #
{
 private.setup.gate && return $(result)
 local user; user=$(private.setup.user.get "$1")
 [ -n "$1" ] && shift
 private.this.script.load odocker odocker.prereqs.install || { create.result 1 "odocker not found in $OOSH_DIR"; error.log "$RESULT"; return $(result); }
 odocker.prereqs.install $user
 return $(result)
}

setup.nvm()     # <?user:$SUDO_USER> <?version:v0.40.3> # install nvm for <user> from its official installer, pinned to <version>; nothing when it is there #
{
 private.setup.gate && return $(result)
 local user version="${2:-$SETUP_NVM_VERSION}" tmp
 user=$(private.setup.user.get "$1"); [ -n "$user" ] || user=$(id -un)
 if private.setup.nvm.is "$user"; then
   create.result 0 "nvm already there for $user"; return $(result)
 fi
 # A temp file in /tmp, never the repository; readable by <user> (root's own
 # TMPDIR on macOS is private). PROFILE=/dev/null: the login already loads nvm
 # (templates/user/bashrcTemplate).
 tmp=$(mktemp /tmp/setup.nvm.XXXXXX) || { create.result 1 "nvm: no temp file"; return $(result); }
 if ! curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/$version/install.sh" -o "$tmp"; then
   rm -f "$tmp"
   create.result 1 "nvm download failed ($version)"; error.log "$RESULT"; return $(result)
 fi
 chmod 644 "$tmp"
 private.setup.as.user "$user" env PROFILE=/dev/null bash "$tmp"
 rm -f "$tmp"
 if private.setup.nvm.is "$user"; then
   create.result 0 "nvm $version for $user"
 else
   create.result 1 "nvm install failed for $user ($version)"; error.log "$RESULT"
 fi
 return $(result)
}

setup.nodejs()     # <?version:--lts> <?user:$SUDO_USER> # install node <version> through nvm for <user> and make sure it runs #
{
 private.setup.gate && return $(result)
 local version="${1:---lts}" user v
 user=$(private.setup.user.get "$2"); [ -n "$user" ] || user=$(id -un)
 setup.nvm "$user" || return $(result)
 private.setup.as.user "$user" bash -c '. "$HOME/.nvm/nvm.sh" && nvm install "$1"' _ "$version"
 v=$(private.setup.as.user "$user" bash -c '. "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && node -v' 2>/dev/null)
 if [ -n "$v" ]; then
   create.result 0 "node $v for $user"
 else
   create.result 1 "node install failed for $user ($version)"; error.log "$RESULT"
 fi
 return $(result)
}

setup.npm()     # <?user:$SUDO_USER> # make sure <user> has npm — the one of nvm's node only; rc 1 naming setup nodejs when it is missing #
{
 private.setup.gate && return $(result)
 local user v
 user=$(private.setup.user.get "$1"); [ -n "$user" ] || user=$(id -un)
 v=$(private.setup.as.user "$user" bash -c '. "$HOME/.nvm/nvm.sh" >/dev/null 2>&1; npm -v' 2>/dev/null)
 if [ -n "$v" ]; then
   create.result 0 "npm $v for $user"; return $(result)
 fi
 # Never the package manager: on Ubuntu `npm` pulls in the system nodejs 18
 # for the whole machine (oosh-user, platform container, 2026-10-14).
 create.result 1 "no npm for $user — run: setup nodejs \"\" $user"; warn.log "$RESULT"
 return $(result)
}

setup.headless()     # <?user:$SUDO_USER> # remote desktop: TigerVNC + a small Xfce on Linux (off until vnc.password), Screen Sharing on macOS; skipped in a container or without systemd #
{
 private.setup.gate && return $(result)
 local user; user=$(private.setup.user.get "$1")
 if private.setup.mac.is; then
   if private.setup.launchd.on com.apple.screensharing; then
     create.result 0 "Screen Sharing on — log in with the macOS account; allow remote control once in System Settings › General › Sharing › Screen Sharing"
   else
     create.result 1 "Screen Sharing could not be switched on (needs root)"; error.log "$RESULT"
   fi
   return $(result)
 fi
 if private.this.container.is; then
   create.result 0 "skipped: no VNC in a container"; info.log "$RESULT"; return $(result)
 fi
 if ! private.setup.systemd.is; then
   create.result 0 "skipped: no systemd here to run the VNC service"; info.log "$RESULT"; return $(result)
 fi
 private.setup.pm.ensure
 private.setup.cmds.install vncserver startxfce4 xfwm4 xfce4-panel xfce4-terminal dbus-launch || { error.log "$RESULT"; return $(result); }
 create.result 0 "TigerVNC and Xfce installed; off until: sudo -i ~root/oosh/su/setup vnc.password ${user:-<user>}"
 return $(result)
}

setup.vnc.password()     # <user> # ask <user>'s VNC password, give <user> an Xfce session on a display of its own and switch the VNC service on #
{
 private.setup.gate && return $(result)
 local user="$1" users display
 if [ -z "$user" ]; then
   create.result 1 "setup.vnc.password: <user> required"; error.log "$RESULT"; return $(result)
 fi
 if private.setup.mac.is; then
   create.result 0 "macOS Screen Sharing uses the macOS account password of $user: nothing to set"; return $(result)
 fi
 private.setup.as.user "$user" vncpasswd || { create.result 1 "no VNC password set for $user"; error.log "$RESULT"; return $(result); }
 private.setup.as.user "$user" sh -c 'mkdir -p "$HOME/.vnc" && { grep -qx "session=xfce" "$HOME/.vnc/config" 2>/dev/null || echo "session=xfce" >> "$HOME/.vnc/config"; }'
 # One display per user in TigerVNC's systemd map; the first free one.
 users="${SETUP_ETC_DIR:-/etc}/tigervnc/vncserver.users"
 display=$(sed -n "s/^:\([0-9]*\)=$user\$/\1/p" "$users" 2>/dev/null | head -1)
 if [ -z "$display" ]; then
   display=1
   while grep -q "^:$display=" "$users" 2>/dev/null; do display=$((display + 1)); done
   $SUDO mkdir -p "${users%/*}"
   echo ":$display=$user" | $SUDO tee -a "$users" >/dev/null
 fi
 if ! $SUDO systemctl enable --now "vncserver@:$display"; then
   create.result 1 "vncserver@:$display did not start"; error.log "$RESULT"; return $(result)
 fi
 create.result 0 "VNC on for $user at display :$display (port $((5900 + display)))"
 return $(result)
}

setup.samba.support()     # <?user:$SUDO_USER> # file sharing: Samba + Avahi on Linux (off until samba.password), File Sharing (SMB) on macOS; skipped in a container or without systemd #
{
 private.setup.gate && return $(result)
 local user service
 user=$(private.setup.user.get "$1")
 if private.setup.mac.is; then
   if private.setup.launchd.on com.apple.smbd; then
     create.result 0 "File Sharing (SMB) on — choose the folders and turn on SMB for ${user:-the user} in System Settings › General › Sharing › File Sharing › Options"
   else
     create.result 1 "File Sharing could not be switched on (needs root)"; error.log "$RESULT"
   fi
   return $(result)
 fi
 if private.this.container.is; then
   create.result 0 "skipped: no Samba in a container"; info.log "$RESULT"; return $(result)
 fi
 if ! private.setup.systemd.is; then
   create.result 0 "skipped: no systemd here to run Samba"; info.log "$RESULT"; return $(result)
 fi
 private.setup.pm.ensure
 private.setup.cmds.install smbd smbclient avahi-daemon || { error.log "$RESULT"; return $(result); }
 # Debian starts smbd on install; it stays off until a user has a password.
 $SUDO systemctl disable --now smbd >/dev/null 2>&1
 $SUDO systemctl disable --now nmbd >/dev/null 2>&1
 # Avahi announces the share, so Macs see it in the Finder.
 service="${SETUP_ETC_DIR:-/etc}/avahi/services/smb.service"
 if [ ! -f "$service" ]; then
   $SUDO mkdir -p "${service%/*}"
   printf '%s\n' '<?xml version="1.0" standalone='"'"'no'"'"'?>' \
     '<!DOCTYPE service-group SYSTEM "avahi-service.dtd">' \
     '<service-group>' '  <name replace-wildcards="yes">%h</name>' \
     '  <service>' '    <type>_smb._tcp</type>' '    <port>445</port>' '  </service>' \
     '</service-group>' | $SUDO tee "$service" >/dev/null
 fi
 create.result 0 "Samba and Avahi installed; off until: sudo -i ~root/oosh/su/setup samba.password ${user:-<user>}"
 return $(result)
}

setup.samba.password()     # <user> # ask <user>'s Samba password and switch Samba and Avahi on #
{
 private.setup.gate && return $(result)
 local user="$1"
 if [ -z "$user" ]; then
   create.result 1 "setup.samba.password: <user> required"; error.log "$RESULT"; return $(result)
 fi
 if private.setup.mac.is; then
   create.result 0 "macOS: turn on SMB for $user in System Settings › General › Sharing › File Sharing › Options (it asks for the password there)"
   return $(result)
 fi
 $SUDO smbpasswd -a "$user" || { create.result 1 "no Samba password set for $user"; error.log "$RESULT"; return $(result); }
 if ! $SUDO systemctl enable --now smbd avahi-daemon; then
   create.result 1 "smbd or avahi-daemon did not start"; error.log "$RESULT"; return $(result)
 fi
 create.result 0 "Samba on for $user"
 return $(result)
}

private.setup.all.step()     # <name> <method> <?args…> # one step of setup.all: count it ok, skipped or failed and add its line to SETUP_SUMMARY; a failure is a warning, never a stop #
{
 local name="$1"; shift
 if "$@"; then
   case "$RESULT" in
     skipped:*) SETUP_SKIPPED=$((SETUP_SKIPPED + 1)) ;;
     *)         SETUP_OK=$((SETUP_OK + 1)) ;;
   esac
 else
   SETUP_FAILED=$((SETUP_FAILED + 1)); SETUP_FAILED_NAMES="${SETUP_FAILED_NAMES:+$SETUP_FAILED_NAMES }$name"
   warn.log "setup $name: $RESULT"
 fi
 SETUP_SUMMARY="${SETUP_SUMMARY}  $name: $RESULT"$'\n'
 return 0
}

setup.all()     # <?user:$SUDO_USER> # everything install state 50 runs: docker, nodejs + npm for <user> and this user, headless, samba support; a failing step is a warning, never a stop #
{
 private.setup.gate && return $(result)
 local user me u nodeUsers=""
 user=$(private.setup.user.get "$1")
 me=$(id -un)
 # node + npm (nvm, per home) for <user>, this user and every member of dev —
 # each once (2026-10-14: bash-user had none).
 for u in $user $me $(private.this.group.members.get dev); do
   case " $nodeUsers " in *" $u "*) ;; *) nodeUsers="${nodeUsers:+$nodeUsers }$u" ;; esac
 done
 SETUP_OK=0; SETUP_SKIPPED=0; SETUP_FAILED=0; SETUP_FAILED_NAMES=""; SETUP_SUMMARY=""
 private.setup.all.step docker setup.docker "$user"
 for u in $nodeUsers; do private.setup.all.step nodejs setup.nodejs "" "$u"; done
 for u in $nodeUsers; do private.setup.all.step npm setup.npm "$u"; done
 private.setup.all.step headless setup.headless "$user"
 private.setup.all.step samba.support setup.samba.support "$user"
 important.log "headless setup:
${SETUP_SUMMARY%$'\n'}"
 create.result 0 "headless setup: $SETUP_OK ok, $SETUP_SKIPPED skipped, $SETUP_FAILED failed${SETUP_FAILED_NAMES:+ ($SETUP_FAILED_NAMES)}"
 return $(result)
}

setup.pacstall() {
  bash -c "$(wget -q https://git.io/JsADh -O -)"
}

setup.snapAppStore() # # sets up everything needed for headless operation
{
  oo cmd snapd
  snap install snap-store

}

setup.chromium() # # sets up everything needed for headless operation
{
  oo cmd chromium-browser
}

setup.usage()
{
  local this=${0##*/}
  echo "You started"
  echo "$0

  Usage:
  $this: command   Parameter and Description"
  this.help
  echo "

  Examples
    $this all
    $this vnc.password <user>
    $this samba.password <user>
    ----------
  "
}

setup.start()
{
  #echo "sourcing init"
  source this

  # if [ -z "$1" ]; then
  #   status.discover "$@"
  #   return 0
  # fi

  this.start "$@"
}

setup.start "$@"
