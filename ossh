private.ossh.config.push()     # <toHost> <?sshConfigName> # put the local Host block <sshConfigName> into <toHost>:~/.ssh/config — the first block of that name replaced in place, further copies dropped, else added — rc 0 + RESULT added or replaced; without <sshConfigName> nothing is pushed (rc 0 + RESULT); rc 1 + RESULT and error.log when <toHost> is missing, the name is no Host here, the connection or the host fails #
{
  # Named object.verb since 2026-10-16 (was private.ossh.push.config,
  # T-OSSH-RENAMES-OBJECT-VERB); a RESULT on every path, it returned a bare 1
  # and the rc of its last rm (T-OSSH-PUSH-PULL-RESULT).
  # Without <sshConfigName>: NO-OP — the legacy "push runner's self-config to
  # remote" behaviour was useless in every supported deployment (back-call
  # from remote to runner doesn't work in platform.test containers — Docker
  # NAT — and doesn't work in real ProxyJump — jump host's privkey isn't on
  # the remote). Removed in Phase A.6.
  local toHost="$1" configName file block how
  if [ -n "$1" ]; then
    shift
  else
    create.result 1 "no toHost was specified"
    error.log "$RESULT"
    return $(result)
  fi

  configName="$1"
  if [ -n "$1" ]; then
    shift
  else
    # No configName given — historical "push runner's self-config" path.
    # Always skip: nothing in OOSH's deployment topologies actually uses
    # back-call from the remote to the runner, and the resulting Host
    # block was either broken (hardcoded runner-side IdentityFile pre-A.5)
    # or unreachable (Docker NAT in platform.test) or unauthenticated
    # (no jump host privkey in real ProxyJump). See Phase A.6 commit msg.
    create.result 0 "private.ossh.config.push: no configName given — skipping runner self-config push (no supported deployment uses back-call from remote)"
    info.log "$RESULT"
    return $(result)
  fi

  # The name goes into the remote command: only what a Host alias is made
  # of, checked before the host is asked (T-OSSH-CONFIG-PUSH).
  case "$configName" in
    (*[!A-Za-z0-9._@-]*|.|..)
      create.result 1 "config.push: $configName is no Host name"
      error.log "$RESULT"
      return $(result)
      ;;
  esac
  # The block is read here first: an unknown name answered rc 0 "appended"
  # and added an empty line there (lab cplab, 2026-10-19). Only the lines from
  # "Host <name>" to the empty line, as config.pull keeps them; a . is a dot.
  private.get.sshDir
  file="$RESULT/config"
  block="$( LOG_DEVICE=/dev/null ossh.config.get "$configName" "$file" 2>/dev/null | line.find "^Host ${configName//./\\.}$" "^$" )"
  if [ -z "$block" ]; then
    create.result 1 "config.push: $configName is not in $file"
    error.log "$RESULT"
    return $(result)
  fi

  ossh.connection.open "$toHost" || return $(result)   # no master: every step would ask the password again (T-OSSH-CONNECTION-OPEN-FAIL)
  # One ssh call, the block on stdin, the host's own commands put it in
  # place (private.ossh.config.block.put.get): replaced where it is or added,
  # never a second copy. It was a temp file in ~/config, a sudo chown -h of
  # the remote ~/config (macOS installs left it root-owned) and rsync, then
  # cat >> — rsync is missing on a bare host, and >> appended a second block
  # that ssh never reads (T-OSSH-CONFIG-PUSH).
  # The answer is the last line: a login banner or rc file of the host may print before it.
  how="$( private.ossh.ssh "$toHost" "$(private.ossh.config.block.put.get "$configName")" <<< "$block" | tail -n 1 )"
  case "$how" in
    (added)    create.result 0 "$configName added to $toHost:~/.ssh/config" ;;
    (replaced) create.result 0 "$configName replaced in $toHost:~/.ssh/config" ;;
    (*)        create.result 1 "could not put $configName into $toHost:~/.ssh/config" ;;
  esac
  if [ "$(result)" = 0 ]; then
    success.log "$RESULT"
  else
    error.log "$RESULT"
  fi
  return $(result)
}

