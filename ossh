private.ossh.control.path.get()     #  # echo the ControlMaster socket path for connection reuse: ${TMPDIR:-/tmp}/ossh-%C when it fits a Unix socket, else /tmp/ossh-%C, else ~/.ssh/ossh-%C #
{
 # NO create.result — a getter consumed as $(...): by ossh.start and by
 # os.platform.test, each as the default of OSSH_CONTROL_PATH
 # (T-OSSH-CONTROL-PATH-IN-START).
 # %C (hash of %l%h%p%r, OpenSSH 6.7+) is 40 characters; ssh binds the master
 # at <path>.<16 random chars> first, and a Unix socket path is at most 103
 # characters on macOS (107 on Linux). macOS's TMPDIR (/var/folders/t7/…/T/,
 # 49 characters) made it 112: connection.open failed every time and every
 # step asked the password again (pol-dev review 2026-10-15,
 # T-OSSH-CONTROL-PATH-SHORT). TMPDIR stays first — Termux has no /tmp.
 local dir
 for dir in "${TMPDIR:-/tmp}" /tmp "$HOME/.ssh"; do
   dir="${dir%/}"
   [ -d "$dir" ] && [ -w "$dir" ] || continue
   [ $(( ${#dir} + 6 + 40 + 17 )) -le 103 ] || continue   # "/ossh-" + %C + ".<16 random>"
   echo "$dir/ossh-%C"
   return 0
 done
 echo "/tmp/ossh-%C"
}

ossh.remote.prelude.get()     #  # echo the command prefix that stands a non-interactive shell up (ssh command, runuser/sudo -u, docker exec): ~/config/user.env when present, else ~/oosh on PATH; POSIX, expanded by the target shell #
{
 # NO create.result — a getter consumed as $(...) and embedded in command
 # strings. There is no boot: ~/config/user.env is what a shell starts from,
 # and a command over ssh, runuser/sudo -u or docker exec never runs .bashrc.
 # Single quotes: ~ and $PATH belong to the TARGET user's shell, not this one.
 # `if`, not `[ -f … ] && . … || …`: with && || a failing source falls into
 # the fallback as if the file were missing (5d06827). POSIX: the target may
 # be sh/dash/ash.
 # path-exception: a command TEXT for another shell, not an assignment here.
 echo 'if [ -f ~/config/user.env ]; then . ~/config/user.env; else export PATH=~/oosh:~/oosh/ng:$PATH; fi;'
}


ossh.remote.prelude.get.completion() { :; }
private.ossh.host.fqdn.get()     #  # echo the fully qualified name of this computer for SSH key names: hostname -f when the hostname program exists, else the full HOSTNAME from the kernel; only the characters A-Z a-z 0-9 . _ - #
{
 # NO create.result — a getter consumed as $(...). The name part of the SSH key
 # name (<user>.<this>), used by private.ossh.get.key.name and
 # private.ossh.set.key.name. Where the hostname program exists the answer is
 # exactly what it always was — existing keys are found by that name. Only
 # where it is missing (AlmaLinux 9 minimal) the kernel answers with the full
 # HOSTNAME of bash; before, the name part was empty (T-OSSH-KEY-NAME-NO-HOSTNAME).
 # Sanitized: on GHA macOS runners `hostname -f` returns multi-token output
 # (e.g. "sat12-bq160-... ssh.runner...") — a key name with literal spaces
 # propagates into filenames in private_key/ and public_keys/ and breaks the
 # `ls | sed` file detection (private.ossh.get.file.name) and the scp/ssh
 # dispatches that do not quote $keyName. Everything except alphanumeric, dot,
 # dash and underscore is stripped.
 if command -v hostname >/dev/null 2>&1; then
   hostname -f | tr -dc 'A-Za-z0-9._-'
 else
   private.this.host.name.get full | tr -dc 'A-Za-z0-9._-'
 fi
}


private.ossh.connection.error.get()     # <errFile> # echo ssh's reason from the stderr it wrote to <errFile>: the last line that is not a "Warning: Permanently added" notice; nothing when there is none #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # connection.open read the reason twice with the same grep | tail, once per
 # attempt (T-OSSH-CONNECTION-ERROR-GET). accept-new adds the host key and
 # says so on stderr: that line is no reason, the failure comes after it.
 local errFile="$1"
 [ -f "$errFile" ] || return 0
 line.filter '^Warning: Permanently added' < "$errFile" | tail -1
}


private.ossh.connection.error.network.is()     # <reason> # rc 0 when ssh's <reason> is a network error worth a retry with -4 (Broken pipe, a reset, no route, an empty reason); rc 1 for a refused login, a host key, a too long socket path or too many keys tried #
{
 # A predicate (rc only, no create.result). The -4 retry only helps a network
 # that fails on IPv6 (Termux/Android: Broken pipe). A refused login or host
 # key would only ask the password a second time (T-OSSH-CONNECTION-OPEN-FAIL);
 # "too long" is the socket path (T-OSSH-CONTROL-PATH-SHORT), which -4 does not
 # change. The list lives here, so it is read in one place
 # (T-OSSH-CONNECTION-ERROR-NETWORK-IS).
 case "$1" in
   *"Permission denied"*|*"Host key verification failed"*|*"too long"*|*"Too many authentication failures"*) return 1 ;;
 esac
 return 0
}


private.ossh.master.start()     # <host> <errFile> <?ipv4> # start the ControlMaster to <host> in the background, persisting 10 minutes; ssh's stderr goes to <errFile>; ipv4 adds -4; rc 0 + RESULT when it runs, rc 1 + RESULT when ssh fails #
{
 # The one ssh call connection.open made twice, once with -4
 # (T-OSSH-MASTER-START). stderr to a file, not $(...): the master behind -f
 # keeps the pipe open for 10 minutes. Silent: connection.open logs.
 local host="$1" errFile="${2:-/dev/null}" ipv4=""
 if [ -z "$host" ]; then
   create.result 1 "private.ossh.master.start requires <host>"
   return $(result)
 fi
 [ "$3" = ipv4 ] && ipv4="-4"
 if ssh $ipv4 -o ControlMaster=yes \
     -o ControlPath="$OSSH_CONTROL_PATH" \
     -o ControlPersist=600 \
     -o StrictHostKeyChecking=accept-new \
     -N -f "$host" 2>"$errFile"; then
   create.result 0 "master to $host started${ipv4:+ (IPv4)}"
 else
   create.result 1 "master to $host failed${ipv4:+ (IPv4)}"
 fi
 return $(result)
}


private.ossh.remote.public.key.put()     # <host> <localFile> <keyFileName> # copy <localFile> to <host>:~/.ssh/public_keys/<keyFileName> (folder made when missing, a file of that name replaced; ~/.ssh made 700, a new file 600); rc 0 + RESULT when it is there, rc 1 + RESULT when the file is missing or the copy fails #
{
 # install.key.authorize and key.push each carried the same remote
 # "mkdir -p … && cat > …", and key.push ignored its rc (T-OSSH-REMOTE-PUBLIC-KEY-PUT).
 # Over ssh cat, not rsync: the target may have no rsync. The name is
 # single-quoted for the remote shell — a legacy name with a space stays one
 # word — and a ' in it is dropped, as private.ossh.authorized.key.append.get
 # does, so it cannot end the quote. Silent: the caller logs $RESULT.
 # umask 077 and chmod 700 ~/.ssh in the remote text: it ran under the
 # target's umask, and with pam_umask 002 a new ~/.ssh was 775 — sshd's
 # StrictModes then ignores every key in it (T-OSSH-REMOTE-PUBLIC-KEY-PUT-MODES).
 local host="$1" localFile="$2" keyFileName="${3//\'/}"
 if [ -z "$host" ] || [ -z "$keyFileName" ]; then
   create.result 1 "private.ossh.remote.public.key.put requires <host> <localFile> <keyFileName>"
   return $(result)
 fi
 if [ ! -f "$localFile" ]; then
   create.result 1 "no key file $localFile to copy to $host"
   return $(result)
 fi
 if private.ossh.ssh "$host" "umask 077; mkdir -p ~/.ssh/public_keys && chmod 700 ~/.ssh && cat > ~/.ssh/public_keys/'$keyFileName'" < "$localFile"; then
   create.result 0 "$keyFileName copied to $host:~/.ssh/public_keys/"
 else
   create.result 1 "could not copy $keyFileName to $host"
 fi
 return $(result)
}


private.ossh.control.path.resolved.get()     # <host> # echo the ControlMaster socket path ssh uses for <host> — $OSSH_CONTROL_PATH with %C expanded, asked from ssh -G (no connection); nothing and rc 1 without a <host> or when ssh gives no expanded path #
{
 # NO create.result — a getter consumed as $(...).
 # os.platform.test removed "/tmp/ossh-test@localhost:<port>" as a stale
 # socket — a name from before %C, so it never existed (fresh review
 # 2026-10-16, T-OSSH-CONTROL-PATH-RESOLVED-GET). Only ssh knows the %C hash
 # (of %l%h%p%r, from the Host entry); `ssh -G` prints the configuration it
 # would use, %C expanded, and connects to nothing. An answer that still has
 # a % (an ssh that does not expand it), or "none", is no path.
 local host="$1" path
 [ -n "$host" ] || return 1
 path=$(ssh -G -o ControlPath="$OSSH_CONTROL_PATH" "$host" 2>/dev/null | awk '$1 == "controlpath" { print $2; exit }')
 case "$path" in
   (""|none|*%*) return 1 ;;
 esac
 echo "$path"
}


# ─────────────────────────────────────────────────────────────────────────────
# ONE FIELD OF A HOST — ossh config.set / config.field.get
# Marcel's design (test/mcdonges.latest, March 2026), rebuilt on dev on
# 2026-10-19 (user decision): seven fields, each with its own
# private.ossh.config.<field>.get|set, so each completes its own values.
# ─────────────────────────────────────────────────────────────────────────────

ossh.config.set()     # <configItem> <field> <value> # set <field> (identityFile user port hostName proxyJump forwardAgent identitiesOnly) of the Host block <configItem> in ~/.ssh/config to <value> — the line is replaced, or added below the Host line — rc 1 + RESULT for an unknown Host or field or a value the field does not take #
{
 local configItem="$1" field="$2" value="$3"
 if [ -z "$configItem" ] || [ -z "$field" ] || [ "$#" -lt 3 ]; then
   create.result 1 "usage: ossh config.set <configItem> <field> <value>"
   error.log "$RESULT"
   return $(result)
 fi
 # The field is checked before it names a method: "field" would call
 # private.ossh.config.field.set with the arguments shifted (T-OSSH-CONFIG-SET).
 if ! private.ossh.config.field.keyword.get "$field" >/dev/null; then
   create.result 1 "config.set: $field is no field — one of: $(ossh.config.set.completion.field | tr '\n' ' ' | line.trim.trailing)"
   error.log "$RESULT"
   return $(result)
 fi
 "private.ossh.config.$field.set" "$configItem" "$value"
 return $(result)
}

ossh.config.set.completion.configItem() {
  ossh.parameter.completion.sshConfigHost "$@"
}
ossh.config.set.completion.field() {
  # The seven fields; config.set and config.field.get name them when one is wrong.
  echo identityFile; echo user; echo port; echo hostName
  echo proxyJump; echo forwardAgent; echo identitiesOnly
}
ossh.config.set.completion.value() {
  # c2 parses the words typed so far into PARAM_<name> before it asks: the
  # field is $PARAM_field. Marcel read $2, which c2 fills with the class name
  # (T-OSSH-CONFIG-SET-COMPLETION). hostName has no list.
  local field="$PARAM_field"
  private.ossh.config.field.keyword.get "$field" >/dev/null || return 0
  this.functionExists "private.ossh.config.$field.set.completion.value" && "private.ossh.config.$field.set.completion.value" "$@"
  return 0
}

ossh.config.field.get()     # <configItem> <field> # echo the value of <field> in the Host block <configItem> of ~/.ssh/config — rc 1 + RESULT when the Host, the field or its line is missing #
{
 # A command, not a kernel getter: the value on stdout AND a RESULT, as
 # ossh config.get does (T-OSSH-CONFIG-FIELD-GET).
 local configItem="$1" field="$2" value
 if [ -z "$configItem" ] || [ -z "$field" ]; then
   create.result 1 "usage: ossh config.field.get <configItem> <field>"
   error.log "$RESULT"
   return $(result)
 fi
 if ! private.ossh.config.field.keyword.get "$field" >/dev/null; then
   create.result 1 "config.field.get: $field is no field — one of: $(ossh.config.set.completion.field | tr '\n' ' ' | line.trim.trailing)"
   error.log "$RESULT"
   return $(result)
 fi
 if ! value="$( "private.ossh.config.$field.get" "$configItem" )"; then
   create.result 1 "config.field.get: no $field in Host $configItem"
   error.log "$RESULT"
   return $(result)
 fi
 echo "$value"
 create.result 0 "$value"
 return $(result)
}

ossh.config.field.get.completion.configItem() {
  ossh.parameter.completion.sshConfigHost "$@"
}
ossh.config.field.get.completion.field() {
  ossh.config.set.completion.field "$@"
}

private.ossh.config.field.set()     # <configItem> <field> <value> <?file:~/.ssh/config> # set the ssh keyword of <field> in the Host block <configItem> of <file> to <value> — replaced in place, or added below the Host line, in one atomic write that keeps the mode — rc 1 + RESULT when the Host, the field or the value is wrong or the file cannot be written #
{
 # Marcel wrote <file>.tmp and moved it over the config: the new file had the
 # umask mode — 664 under umask 002 — and ssh refuses a config others may
 # write. private.this.file.write instead: atomic, mode and group kept. Every
 # refusal comes before the write, so the file stays byte for byte
 # (T-OSSH-CONFIG-SET).
 local configItem="$1" field="$2" value="$3" file="$4" keyword how content
 if [ -z "$configItem" ] || [ -z "$field" ] || [ -z "$value" ]; then
   create.result 1 "usage: ossh config.set <configItem> <field> <value>"
   error.log "$RESULT"
   return $(result)
 fi
 if ! keyword="$( private.ossh.config.field.keyword.get "$field" )"; then
   create.result 1 "config.set: $field is no field — one of: $(ossh.config.set.completion.field | tr '\n' ' ' | line.trim.trailing)"
   error.log "$RESULT"
   return $(result)
 fi
 # One line: a newline in the value would start another keyword in the file.
 case "$value" in
   (*$'\n'*)
     create.result 1 "config.set: the value of $field is one line"
     error.log "$RESULT"
     return $(result)
     ;;
 esac
 case "$field" in
   (port)
     case "$value" in
       (*[!0-9]*|0*) value="no port" ;;
       (*) [ "${#value}" -le 5 ] && [ "$value" -le 65535 ] || value="no port" ;;
     esac
     if [ "$value" = "no port" ]; then
       create.result 1 "config.set: port takes 1 to 65535, not $3"
       error.log "$RESULT"
       return $(result)
     fi
     ;;
   (forwardAgent|identitiesOnly)
     case "$value" in
       (yes|no) ;;
       (*)
         create.result 1 "config.set: $field takes yes or no, not $value"
         error.log "$RESULT"
         return $(result)
         ;;
     esac
     ;;
 esac
 if [ -z "$file" ]; then
   private.get.sshDir
   file="$RESULT/config"
 fi
 # The Host is compared as a string, not as a pattern: s.cond is not the
 # Host second. The block is the Host line up to the empty line or the next
 # Host, as ossh config.get shows it.
 if ! HOST="$configItem" awk '$1 == "Host" && $2 == ENVIRON["HOST"] && NF == 2 { found = 1 } END { exit !found }' "$file" 2>/dev/null; then
   create.result 1 "config.set: no Host $configItem in $file"
   error.log "$RESULT"
   return $(result)
 fi
 how=added
 private.ossh.config.field.get "$configItem" "$field" "$file" >/dev/null && how=replaced
 # One pass: the first line of the keyword in the block, whatever its case,
 # becomes "<indent><Keyword> <value>"; without one the line goes right below
 # the Host line. ENVIRON, not -v: awk -v reads backslashes in a value as
 # escapes. The x keeps the last newlines that $( ) would drop — a trailing
 # empty line stays; private.this.file.write adds the one newline back.
 content="$( HOST="$configItem" KEYWORD="$keyword" VALUE="$value" HOW="$how" awk '
   $1 == "Host" {
     inBlock = ($2 == ENVIRON["HOST"] && NF == 2); done = 0; print
     if (inBlock && ENVIRON["HOW"] == "added") { print " " ENVIRON["KEYWORD"] " " ENVIRON["VALUE"]; done = 1 }
     next
   }
   /^[ \t]*$/ { inBlock = 0 }
   inBlock && !done && tolower($1) == tolower(ENVIRON["KEYWORD"]) {
     match($0, /^[ \t]*/); print substr($0, 1, RLENGTH) ENVIRON["KEYWORD"] " " ENVIRON["VALUE"]; done = 1; next
   }
   { print }
 ' "$file"; echo x )"
 content="${content%x}"
 content="${content%$'\n'}"
 if ! private.this.file.write "$file" "$content"; then
   error.log "$RESULT"
   return $(result)
 fi
 create.result 0 "$keyword $value set in Host $configItem ($how)"
 success.log "$RESULT"
 return $(result)
}


private.ossh.config.field.get()     # <configItem> <field> <?file:~/.ssh/config> # echo the value of the ssh keyword of <field> in the Host block <configItem> of <file> — nothing and rc 1 when there is none #
{
 # NO create.result — a getter consumed as $(...): only the value on stdout.
 # The same block rule as private.ossh.config.field.set: the Host compared as
 # a string, the keyword found whatever its case (T-OSSH-CONFIG-FIELD-GET).
 local configItem="$1" field="$2" file="$3" keyword
 [ -n "$configItem" ] || return 1
 keyword="$( private.ossh.config.field.keyword.get "$field" )" || return 1
 if [ -z "$file" ]; then
   private.get.sshDir
   file="$RESULT/config"
 fi
 HOST="$configItem" KEYWORD="$keyword" awk '
   $1 == "Host" { inBlock = ($2 == ENVIRON["HOST"] && NF == 2); next }
   /^[ \t]*$/ { inBlock = 0 }
   inBlock && tolower($1) == tolower(ENVIRON["KEYWORD"]) { sub(/^[ \t]*[^ \t]+[ \t]+/, ""); print; found = 1; exit }
   END { exit !found }
 ' "$file" 2>/dev/null
}

private.ossh.config.field.keyword.get()     # <field> # echo the ssh keyword of <field> — identityFile is IdentityFile, hostName is HostName — nothing and rc 1 for a field that is not one of the seven #
{
 # NO create.result — a getter. The seven fields of Marcel's design, as ssh
 # spells their keywords; ossh.config.set.completion.field lists the same
 # seven (T-OSSH-CONFIG-SET-COMPLETION checks both).
 case "$1" in
   (identityFile) echo IdentityFile ;;
   (user) echo User ;;
   (port) echo Port ;;
   (hostName) echo HostName ;;
   (proxyJump) echo ProxyJump ;;
   (forwardAgent) echo ForwardAgent ;;
   (identitiesOnly) echo IdentitiesOnly ;;
   (*) return 1 ;;
 esac
}

# The seven fields, one getter and one setter each (Marcel's design): the
# setter's value completion is what ossh.config.set.completion.value asks.

private.ossh.config.identityFile.get()     # <configItem> # echo the IdentityFile of Host <configItem> #
{ private.ossh.config.field.get "$1" identityFile; }
private.ossh.config.identityFile.set()     # <configItem> <value> # set the IdentityFile of Host <configItem> #
{ private.ossh.config.field.set "$1" identityFile "$2"; }
private.ossh.config.identityFile.set.completion.value() {
  # the keys under ids/ (Marcel) and the ones in the sshDir itself — the
  # IdentityFile ossh config.create writes is ~/.ssh/id_ed25519
  private.get.sshDir
  local key
  for key in "$RESULT"/ids/*/id_* "$RESULT"/id_*; do
    [ -f "$key" ] || continue
    case "$key" in (*.pub) ;; (*) echo "$key" ;; esac
  done
}

private.ossh.config.user.get()     # <configItem> # echo the User of Host <configItem> #
{ private.ossh.config.field.get "$1" user; }
private.ossh.config.user.set()     # <configItem> <value> # set the User of Host <configItem> #
{ private.ossh.config.field.set "$1" user "$2"; }
private.ossh.config.user.set.completion.value() { echo git; echo root; echo deploy; echo ubuntu; }

private.ossh.config.port.get()     # <configItem> # echo the Port of Host <configItem> #
{ private.ossh.config.field.get "$1" port; }
private.ossh.config.port.set()     # <configItem> <value> # set the Port of Host <configItem> #
{ private.ossh.config.field.set "$1" port "$2"; }
private.ossh.config.port.set.completion.value() { echo 22; echo 443; echo 2222; echo 8022; }

private.ossh.config.hostName.get()     # <configItem> # echo the HostName of Host <configItem> #
{ private.ossh.config.field.get "$1" hostName; }
private.ossh.config.hostName.set()     # <configItem> <value> # set the HostName of Host <configItem> #
{ private.ossh.config.field.set "$1" hostName "$2"; }

private.ossh.config.proxyJump.get()     # <configItem> # echo the ProxyJump of Host <configItem> #
{ private.ossh.config.field.get "$1" proxyJump; }
private.ossh.config.proxyJump.set()     # <configItem> <value> # set the ProxyJump of Host <configItem> #
{ private.ossh.config.field.set "$1" proxyJump "$2"; }
private.ossh.config.proxyJump.set.completion.value() { ossh.parameter.completion.sshConfigHost "$@"; }

private.ossh.config.forwardAgent.get()     # <configItem> # echo the ForwardAgent of Host <configItem> #
{ private.ossh.config.field.get "$1" forwardAgent; }
private.ossh.config.forwardAgent.set()     # <configItem> <value> # set the ForwardAgent of Host <configItem> #
{ private.ossh.config.field.set "$1" forwardAgent "$2"; }
private.ossh.config.forwardAgent.set.completion.value() { echo yes; echo no; }

private.ossh.config.identitiesOnly.get()     # <configItem> # echo the IdentitiesOnly of Host <configItem> #
{ private.ossh.config.field.get "$1" identitiesOnly; }
private.ossh.config.identitiesOnly.set()     # <configItem> <value> # set the IdentitiesOnly of Host <configItem> #
{ private.ossh.config.field.set "$1" identitiesOnly "$2"; }
private.ossh.config.identitiesOnly.set.completion.value() { echo yes; echo no; }

private.ossh.config.block.put.get()     # <sshConfigName> # echo the POSIX commands that put the Host block <sshConfigName> read from their stdin into ~/.ssh/config of the shell that runs them — the first block of that name replaced in place, further copies dropped, else appended — and that echo added or replaced; no oosh needed there #
{
 # NO create.result — a getter; its output is the command text config.push
 # sends (T-OSSH-CONFIG-BLOCK-PUT). config.push appended with >>: a second
 # push gave a second block, and ssh reads only the first, so a changed block
 # had no effect (lab cplab, 2026-10-19). Replaced IN PLACE, not moved to the
 # end: a Host * before it decides which value counts. Further copies go with
 # their empty line. POSIX sh and awk (ENVIRON), so a host without oosh takes
 # it; written back with cat >, so owner and mode stay (as ossh.config.delete),
 # under umask 077 a new ~/.ssh is 700 and a new config 600 (as
 # private.ossh.remote.public.key.put). A ' in the name is dropped, as
 # private.ossh.authorized.key.append.get does — it would end the quote.
 local sshConfigName="${1//\'/}"
 [ -n "$sshConfigName" ] || return 1
 printf "H='%s'; export H\n" "$sshConfigName"
 cat <<'EOF'
umask 077
mkdir -p ~/.ssh && chmod 700 ~/.ssh || exit 1
f=~/.ssh/config
[ -f "$f" ] || : > "$f" || exit 1
B="$(cat)"; export B
how=added
awk '$1 == "Host" && $2 == ENVIRON["H"] && NF == 2 { found = 1 } END { exit !found }' "$f" && how=replaced
awk '
  $1 == "Host" {
    inOld = 0; drop = 0
    if ($2 == ENVIRON["H"] && NF == 2) {
      if (!done) { print ENVIRON["B"]; done = 1; inOld = 1 } else { drop = 1 }
      next
    }
  }
  drop && /^[ \t]*$/ { drop = 0; next }
  drop { next }
  inOld && /^[ \t]*$/ { inOld = 0; print; last = $0; next }
  inOld { next }
  { print; last = $0 }
  END {
    if (!done) {
      if (NR > 0 && last !~ /^[ \t]*$/) print ""
      print ENVIRON["B"]
    }
  }
' "$f" > "$f.new" || { rm -f "$f.new"; exit 1; }
cat "$f.new" > "$f" || { rm -f "$f.new"; exit 1; }
rm -f "$f.new"
echo "$how"
EOF
}

private.ossh.config.last.file.get()     #  # echo the file ossh config.create writes its Host block to and ossh config.save.last reads it from — its own file, no logger writes there #
{
 # NO create.result — a getter consumed as $(...). result.txt is a scratch
 # file the live log tees into and ossh.config.get overwrites; save.last
 # appended it whole, log lines included (T-OSSH-CONFIG-SAVE-LAST).
 echo "$CONFIG_PATH/ssh.config.last"
}


private.ossh.system.config.file.get()     #  # echo the system-wide ssh client file every user reads, holding the Host github.com block — OSSH_SYSTEM_SSH_CONFIG overrides #
{
 # NO create.result — a getter consumed as $(...). OpenSSH reads
 # ssh_config.d for every user (Include /etc/ssh/ssh_config.d/*.conf on Linux,
 # /etc/ssh/ssh_config.d/* on macOS — checked 2026-10-19); .conf for Linux.
 echo "${OSSH_SYSTEM_SSH_CONFIG:-/etc/ssh/ssh_config.d/oosh-github.conf}"
}

private.ossh.system.known.hosts.get()     #  # echo the system-wide known_hosts file every user reads — OSSH_SYSTEM_KNOWN_HOSTS overrides #
{
 # NO create.result — a getter consumed as $(...). GlobalKnownHostsFile of
 # OpenSSH; macOS has none until oosh writes it.
 echo "${OSSH_SYSTEM_KNOWN_HOSTS:-/etc/ssh/ssh_known_hosts}"
}

private.ossh.user.homes.get()     #  # echo every home on this host whose ~/.ssh oosh may have written to — the homes under the users base without shared, then the home of root; rc 1 without a users base #
{
 # NO create.result — a getter consumed as $(...). shared is the shared tree
 # (/home/shared, /Users/Shared on macOS), not a user.
 local basehome home
 basehome=$(private.ossh.users.basehome) || return 1
 for home in "$basehome"/*; do
   [ -d "$home" ] || continue
   case "${home##*/}" in (shared|Shared) continue ;; esac
   echo "$home"
 done
 eval echo ~root
}

private.ossh.github.block.is.oosh()     # <block> # rc 0 when <block> is a Host github.com block as oosh writes it — only HostName github.com, User git, Port 22, IdentitiesOnly yes and IdentityFile ~/.ssh/ids/ssh.developking/id_rsa; any other line makes it the own block of the user #
{
 # The forms oosh wrote over time: config.create (state 31, the template),
 # the heredoc fallback of state 31 and the one of folder.fix (no
 # IdentitiesOnly). Keywords in any case and order; a comment or any other
 # keyword or value is the user's own and stays.
 printf '%s\n' "$1" | awk '
   NF == 0 { next }
   { k = tolower($1); v = $2 }
   k == "host" && v == "github.com" && NF == 2 { host = 1; next }
   NF != 2 { other = 1; next }
   k == "hostname" && v == "github.com" { next }
   k == "user" && v == "git" { next }
   k == "port" && v == "22" { next }
   k == "identitiesonly" && tolower(v) == "yes" { next }
   k == "identityfile" && v == "~/.ssh/ids/ssh.developking/id_rsa" { id = 1; next }
   { other = 1 }
   END { exit !(host && id && !other) }'
}

private.ossh.github.copy.remove()     # <sshDir> <knownHosts> # remove from <sshDir> what oosh copied there for GitHub — the Host github.com block of oosh in config, the lines of <knownHosts> in known_hosts — in place, owner and mode kept; rc 0 when something was removed #
{
 # A block in ~/.ssh/config wins over the system file, and an old host key in
 # ~/.ssh/known_hosts makes ssh refuse GitHub after a key rotation — so the
 # copies go once the system files hold them. Written with > in place, as
 # ossh.config.delete does: the file stays the user's, with its mode.
 local sshDir="$1" knownHosts="$2" block kept removed=1
 if [ -z "$sshDir" ] || [ -z "$knownHosts" ]; then
   create.result 1 "private.ossh.github.copy.remove requires <sshDir> <knownHosts>"
   return $(result)
 fi
 if [ -f "$sshDir/config" ]; then
   block="$(LOG_DEVICE=/dev/null ossh.config.get github.com "$sshDir/config" 2>/dev/null)"
   if [ -n "$block" ] && private.ossh.github.block.is.oosh "$block" \
      && LOG_DEVICE=/dev/null ossh.config.delete github.com "$sshDir/config" >/dev/null 2>&1; then
     removed=0
   fi
 fi
 if [ -f "$sshDir/known_hosts" ] && [ -s "$knownHosts" ]; then
   # The lines of the system file, and the comments ssh-keyscan wrote along
   # with them on some systems (Alma 9: "# github.com:22 SSH-2.0-…"). Only
   # non-empty lines are dropped, so kept differs exactly when one was.
   kept="$(awk 'NR == FNR { if (NF) k[$0] = 1; next } !($0 in k) && !/^# github\.com:22 /' "$knownHosts" "$sshDir/known_hosts")"
   if [ "$kept" != "$(cat "$sshDir/known_hosts")" ]; then
     if [ -n "$kept" ]; then printf '%s\n' "$kept" > "$sshDir/known_hosts"; else : > "$sshDir/known_hosts"; fi
     removed=0
   fi
 fi
 create.result 0 "$sshDir"
 return $removed
}

private.ossh.github.copies.remove()     # <knownHosts> # private.ossh.github.copy.remove for the ~/.ssh of every home; echo the folders that changed #
{
 local knownHosts="$1" homes home
 homes="$(private.ossh.user.homes.get)" || return 0
 while IFS= read -r home; do
   [ -d "$home/.ssh" ] || continue
   private.ossh.github.copy.remove "$home/.ssh" "$knownHosts" && printf ' %s' "$home/.ssh"
 done <<< "$homes"
 return 0
}

private.ossh.shared.ssh.legacy.remove()     # <?legacyDir:<basehome>/shared/.ssh> # remove the old template folder <legacyDir> when it holds only config and known_hosts, else keep it with a warning; echo it when removed #
{
 # Since 1b5c427e (2026-04-01) ossh install wrote a root-only template here
 # and copied it into every home; until 6e09d74f (2026-05-11) it also held the
 # deploy key 2cuGitHub. Anything but config and known_hosts is for a human
 # to look at, so the folder then stays as it is.
 local dir="$1" basehome entry extra=""
 if [ -z "$dir" ]; then
   basehome=$(private.ossh.users.basehome) || return 0
   dir="$basehome/shared/.ssh"
 fi
 [ -d "$dir" ] || return 0
 for entry in "$dir"/* "$dir"/.[!.]*; do
   [ -e "$entry" ] || [ -L "$entry" ] || continue
   case "${entry##*/}" in (config|known_hosts) ;; (*) extra="$extra ${entry##*/}" ;; esac
 done
 if [ -n "$extra" ]; then
   warn.log "kept $dir: it holds more than config and known_hosts:$extra — check and remove it by hand"
   return 0
 fi
 if rm -f "$dir/config" "$dir/known_hosts" && rmdir "$dir"; then
   printf ' %s' "$dir"
 else
   warn.log "could not remove $dir"
 fi
 return 0
}

