ossh.prereqs.install() # <sshConfigHost> # install the oosh install-time prereqs — git and curl — on the remote host
{
  local host="$1"
  [ -z "$host" ] && { error.log "ossh.prereqs.install: no sshConfigHost specified"; return 1; }

  local pkg rc=0
  for pkg in curl git; do
