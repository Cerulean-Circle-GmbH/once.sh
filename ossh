private.ossh.remote.key.file.name.get()     # <fromHost> # echo the name of <fromHost>'s own oosh key: a ~/.ssh/private_key/<name>.private_key there that has its public_keys/<name>.public_key (the last one when there are several); nothing and rc 1 when it has none or the answer is no plain file name #
{
  # NO create.result — a getter consumed as $(...).
  # It asked the host `ossh file.get.name` (`ossh id.file.get` on an older
  # oosh): with no private_key/ there, that made a key name and ran
  # `config save ssh.info` ON THE HOST — a read that wrote (fresh review
  # 2026-10-16). Both methods are `ls ~/.ssh/private_key/` minus
  # .private_key, so a POSIX listing gives the same answer, writes nothing and
  # needs no oosh on the host (T-OSSH-REMOTE-KEY-FILE-NAME-GET). Only a name
  # with its public key file counts: that file is what key.pull fetches.
  # The answer is remote data: colours and \r go, the last line is the
  # answer, and a name with a space, a / or a ' is no name — it would leave
  # public_keys/ or end the remote quote.
  local fromHost="$1" name
  [ -n "$fromHost" ] || return 1
  name=$( private.ossh.ssh "$fromHost" 'for f in ~/.ssh/private_key/*.private_key; do n="${f##*/}"; n="${n%.private_key}"; [ -f ~/.ssh/public_keys/"$n".public_key ] && echo "$n"; done' 2>/dev/null | line.strip.color | tr -d '\r' | tail -1 )
  case "$name" in
    (""|.|..|*[[:space:]]*|*/*|*\'*) return 1 ;;
  esac
  echo "$name"
}

private.ossh.key.pull()     # <fromHost> <?remoteKeyName> <?sshDir:~/.ssh> # get the key public_keys/<?remoteKeyName> (default: the key of <fromHost>) from <fromHost>:~/.ssh/ into the LOCAL <sshDir>/public_keys/ and authorize it here — key.push the other way around; rc 1 + RESULT when the name is no file name, there is no key or it cannot be saved #
{
  local fromHost="$1"
  if [ -n "$1" ]; then
    shift
  else
    create.result 1 "no fromHost was specified"
    error.log "$RESULT"
    return $(result)
  fi

  # An empty <?remoteKeyName> still holds its place: key.pull <host> "" <sshDir>.
  # A ' is dropped, as key.push does: it would end the remote quote. A name
  # with a / is refused before the host is asked — it would read and write
  # outside public_keys/ (T-OSSH-KEY-PULL).
  local keyName="${1//\'/}"
  [ $# -gt 0 ] && shift
  case "$keyName" in
    (*/*|.|..)
      create.result 1 "key.pull: $keyName is no file name in public_keys/"
      error.log "$RESULT"
      return $(result)
      ;;
  esac

  private.get.sshDir "$1"
  [ -n "$1" ] && shift
  local sshDir="$RESULT"

  ossh.connection.open "$fromHost" || return $(result)   # no master: every step would ask the password again (T-OSSH-CONNECTION-OPEN-FAIL)

  # The file key.push would send from <fromHost>: public_keys/<keyName>,
  # by default the host's own key file. A host without oosh keys (Termux,
  # cb040d55) only has ~/.ssh/id_*.pub — kept as <fromHost>.<type>.public_key,
  # the <owner>.<type>.public_key scheme install.key.authorize names its
  # fallback key by too (T-OSSH-INSTALL-KEY-FALLBACK).
  local remoteFile="" localName="" key="" name file
  if [ -n "$keyName" ]; then
    remoteFile="public_keys/'$keyName'"; localName="$keyName"
  else
    name="$( private.ossh.remote.key.file.name.get "$fromHost" )"
    if [ -n "$name" ]; then
      remoteFile="public_keys/'$name.public_key'"; localName="$name.public_key"
    fi
  fi
  # Single-quoted like key.push: a keyName with a space stays one word remotely.
  [ -n "$remoteFile" ] && key="$( private.ossh.ssh "$fromHost" "cat ~/.ssh/$remoteFile" 2>/dev/null )"
  if [ -z "$key" ] && [ -z "$keyName" ]; then
    name="$( private.ossh.ssh "$fromHost" "for k in id_ed25519 id_ecdsa id_rsa id_dsa; do [ -f ~/.ssh/\$k.pub ] && echo \$k && break; done" 2>/dev/null | tr -d '\r' )"
    # Remote data: only one of the four names asked for is one.
    case "$name" in (id_ed25519|id_ecdsa|id_rsa|id_dsa) ;; (*) name="" ;; esac
    if [ -n "$name" ]; then
      localName="$fromHost.$name.public_key"
      key="$( private.ossh.ssh "$fromHost" "cat ~/.ssh/'$name.pub'" 2>/dev/null )"
    fi
  fi
  # A key is what user's rebuild reads as one: private.user.authorized.key.get
  # finds "<type> <key>" in it — the one definition, not a second case list.
  private.this.script.load user private.user.authorized.key.get || {
    create.result 1 "user not found in $OOSH_DIR"; error.log "$RESULT"; return $(result)
  }
  if [ -z "$( private.user.authorized.key.get "$key" )" ]; then
    create.result 1 "key.pull: no public key ${keyName:+$keyName }found on $fromHost"
    error.log "$RESULT"
    return $(result)
  fi
  # Every source of the local name ends here, <fromHost> included: one /
  # and the file would land outside public_keys/.
  case "$localName" in
    (*/*|.|..)
      create.result 1 "key.pull: $localName is no file name in public_keys/"
      error.log "$RESULT"
      return $(result)
      ;;
  esac

  # Both checked: a file in the way or a full disk said nothing and the
  # rebuild went on without the key (T-THIS-FOLDER-ENSURE, T-THIS-FILE-WRITE).
  file="$sshDir/public_keys/$localName"
  private.this.folder.ensure "$sshDir/public_keys" || { error.log "$RESULT"; return $(result); }
  private.this.file.write "$file" "$key" || { error.log "$RESULT"; return $(result); }
  important.log "key.pull: $fromHost -> $file"

  # key.pull's own result, not the rebuild's: the rebuild is rc 1 when this
  # computer has no ssh set up (no private key in <sshDir>,
  # T-USER-AUTHORIZED-KEYS-UPDATE-RC) — the key is saved all the same, and the
  # next rebuild authorizes it (T-OSSH-KEY-PULL-RESULT).
  if ossh.authorized.keys.update "$sshDir"; then
    create.result 0 "key.pull: $fromHost's key saved as $file and authorized"
    success.log "$RESULT"
  else
    create.result 0 "key.pull: $fromHost's key saved as $file, but not authorized yet: $RESULT"
    warn.log "$RESULT"
  fi
  return $(result)
}

ossh.key.pull()     # <fromHost> <?remoteKeyName> <?sshDir:~/.ssh> # gets the key of <fromHost> (or public_keys/<?remoteKeyName> there) from <fromHost>:~/.ssh/ into the LOCAL <sshDir>/public_keys/ and authorizes it here — key.push the other way around #
{
  private.ossh.key.pull "$@";
}

# c2 completes per parameter: <fromHost> and <sshDir> from
# ossh.parameter.completion.*. <remoteKeyName> is a file on <fromHost>, not
# here, and has no completion on purpose: a remote listing would ask the
# password on Tab. It was <keyName> with an empty
# ossh.key.pull.completion.keyName — c2 takes an empty answer as "none" and
# asks the shared ossh.parameter.completion.keyName next, which listed this
# computer's keys (T-OSSH-KEY-COMPLETION). The whole-method form answered
# every position with hosts. Same as key.push.

private.ossh.config.pull()     # <fromHost> <remoteConfigName> <?file:~/.ssh/config> # copy the Host block <remoteConfigName> from ~/.ssh/config on <fromHost> into <file> — config.push the other way around; a Host <file> already has stays as it is; rc 1 + RESULT when the name is no Host name, <fromHost> has no such block or <file> cannot be written #
{
  local fromHost="$1"
  if [ -n "$1" ]; then
    shift
  else
    create.result 1 "no fromHost was specified"
    error.log "$RESULT"
    return $(result)
  fi

  # The name lives on <fromHost>, so it has no completion here
  # (T-OSSH-CONFIG-PULL-COMPLETION); without one, the host's names are shown.
  local remoteConfigName="$1"
  if [ -n "$1" ]; then
    shift
  else
    create.result 1 "no remoteConfigName was specified"
    error.log "$RESULT"
    important.log "available ssh configs on $fromHost:"
    ossh.exec "$fromHost" "ossh config.list" | grep '^Host '
    return $(result)
  fi
  # The name goes into the remote command and into config.get's pattern:
  # only what a Host alias is made of, checked before the host is asked
  # (T-OSSH-CONFIG-PULL).
  case "$remoteConfigName" in
    (*[!A-Za-z0-9._@-]*|.|..)
      create.result 1 "config.pull: $remoteConfigName is no Host name"
      error.log "$RESULT"
      return $(result)
      ;;
  esac

  local file="$1"
  if [ -n "$1" ]; then
    shift
  else
    private.get.sshDir
    file="$RESULT/config"
  fi

  # A Host that is here already stays as it is: a second block of the same
  # name is one ssh never reads, and the first may be this computer's own.
  # A question, not a lookup: config.get's "not found" warning goes to
  # LOG_DEVICE, which >/dev/null does not reach — it stood before every pull.
  if LOG_DEVICE=/dev/null ossh.config.get "$remoteConfigName" "$file" >/dev/null 2>&1; then
    create.result 0 "$remoteConfigName is already in $file — ossh config.delete $remoteConfigName first to replace it"
    important.log "$RESULT"
    return $(result)
  fi

  ossh.connection.open "$fromHost" || return $(result)   # no master: every step would ask the password again (T-OSSH-CONNECTION-OPEN-FAIL)

  # It asked for a command that no longer exists (was `ossh get.config`):
  # nothing or an error line was appended. A host without a terminal logs to stdout
  # (log: LOG_DEVICE=/proc/self/fd/1), so its logs go to /dev/null and only
  # the lines from "Host <name>" to the empty line are kept (T-OSSH-CONFIG-PULL).
  # line.find takes a pattern: a . in the name is escaped, or demo.x would
  # also take a Host demoAx.
  local block
  block="$( ossh.exec "$fromHost" "LOG_DEVICE=/dev/null ossh config.get '$remoteConfigName'" | line.find "^Host ${remoteConfigName//./\\.}$" "^$" )"
  if [ -z "$block" ]; then
    create.result 1 "$remoteConfigName not found on $fromHost"
    error.log "$RESULT"
    return $(result)
  fi

  # The file is written whole, not with >>: atomic, the mode kept, a new
  # one owner only (private.this.file.write); an empty line between blocks,
  # as config.get reads them.
  local content=""
  [ -s "$file" ] && content="$(cat "$file")"$'\n\n'
  case "$file" in (*/*) private.this.folder.ensure "${file%/*}" || { error.log "$RESULT"; return $(result); } ;; esac
  if ! private.this.file.write "$file" "$content$block"; then
    error.log "$RESULT"
    return $(result)
  fi
  create.result 0 "$remoteConfigName pulled from $fromHost into $file"
  success.log "$RESULT"
  return $(result)
}

ossh.config.pull()     # <fromHost> <remoteConfigName> <?file:~/.ssh/config> # copies the Host block <remoteConfigName> from ~/.ssh/config on <fromHost> into <file> (config.push the other way around) — a Host already there stays as it is #
{
  private.ossh.config.pull "$@"
}

