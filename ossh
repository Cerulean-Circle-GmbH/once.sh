ossh.config.save.last()     # <?file:~/.ssh/config> # append the Host block of the last ossh config.create to <file> — read from its own file, checked to be one Host block, <file> written whole with its mode kept — rc 1 + RESULT when there is none, it is damaged or <file> has that Host already #
{
  # It appended the WHOLE $CONFIG_PATH/result.txt: with live logging the
  # loggers tee into it, so a log line between create and save landed in
  # ~/.ssh/config — ssh then refuses the whole file ("Bad configuration
  # option") and every login of that user fails (meeting item 6,
  # T-OSSH-CONFIG-SAVE-LAST). Now only config.create's own file, and only
  # when it is one Host block.
  local file="$1" last hostEntry block content
  if [ -z "$file" ]; then
    private.get.sshDir
    file="$RESULT/config"
  fi
  last="$(private.ossh.config.last.file.get)"
  if [ ! -s "$last" ]; then
    create.result 1 "config.save.last: no last config in $last — ossh config.create first"
    error.log "$RESULT"
    return $(result)
  fi
  # One block: the first line that is not empty is "Host <name>", no second
  # Host line, every other line an indented "<Keyword> <value>" or empty.
  hostEntry="$( awk '
    NF == 0 { next }
    !seen { seen = 1; if ($1 == "Host" && NF == 2) print $2; else bad = 1; next }
    $1 == "Host" || $0 !~ /^[ \t]+[A-Za-z]+[ \t]+[^ \t]/ { bad = 1 }
    END { exit bad }
  ' "$last" )" || hostEntry=""
  if [ -z "$hostEntry" ]; then
    create.result 1 "config.save.last: $last is no single Host block — not appended"
    error.log "$RESULT"
    return $(result)
  fi
  # The Host compared as a string, as config.set does.
  if HOST="$hostEntry" awk '$1 == "Host" && $2 == ENVIRON["HOST"] && NF == 2 { found = 1 } END { exit !found }' "$file" 2>/dev/null; then
    create.result 1 "Host '$hostEntry' already exists in $file — not appending duplicate"
    warn.log "$RESULT"
    return $(result)
  fi
  # One empty line between the blocks. An existing file is written in place
  # with > after every check: owner and mode stay, as ossh.config.delete does
  # — the shared config (ossh.config.shared.github.create) belongs to its
  # owner, and a rename would hand it to the writer. A new file goes through
  # private.this.file.write: 600, owner only.
  block="$( awk 'NF' "$last" )"
  content=""
  [ -s "$file" ] && content="$(cat "$file")"$'\n\n'
  if [ -e "$file" ]; then
    if ! { printf '%s\n' "$content$block" > "$file"; } 2>/dev/null; then
      create.result 1 "config.save.last: cannot write $file"
      error.log "$RESULT"
      return $(result)
    fi
  else
    case "$file" in (*/*) private.this.folder.ensure "${file%/*}" || { error.log "$RESULT"; return $(result); } ;; esac
    if ! private.this.file.write "$file" "$content$block"; then
      error.log "$RESULT"
      return $(result)
    fi
  fi
  create.result 0 "appended $hostEntry to $file"
  important.log "$RESULT"
  return $(result)
}

ossh.config.shared.github.create() # <?configFile> <?knownHosts> # set GitHub up for every user of this host — the Host github.com block (IdentityFile ~/.ssh/ids/ssh.developking/id_rsa) in the ssh_config.d of OpenSSH, its host key in ssh_known_hosts, both 644 — then remove the old template folder under the users base and the copies it left in the homes. Idempotent; runs as root
{
  # OpenSSH reads both files for every user, so nothing is copied into a home
  # (checked 2026-10-19: Debian 12, Alma 9.8, Alpine 3.19/3.23, Ubuntu 24.04,
  # macOS 15/26). IdentityFile keeps the literal `~`: ssh expands it for the
  # user who runs it, and every user has ids/ssh.developking/id_rsa from
  # osshLayout.role.developking. `identitiesOnly` adds IdentitiesOnly yes so
  # the agent does not offer the wrong key first.
  local file="${1:-$(private.ossh.system.config.file.get)}"
  local knownHosts="${2:-$(private.ossh.system.known.hosts.get)}"
  local keys removed

  if ! LOG_DEVICE=/dev/null ossh.config.get github.com "$file" >/dev/null 2>&1; then
    if ! private.this.folder.ensure "${file%/*}"; then
      error.log "$RESULT"
      return $(result)
    fi
    ossh.config.create github.com git@github.com:22 "~/.ssh/ids/ssh.developking/id_rsa" identitiesOnly >/dev/null
    if ! ossh.config.save.last "$file" >/dev/null; then
      create.result 1 "could not write Host github.com to $file: $RESULT"
      error.log "$RESULT"
      return $(result)
    fi
  fi
  chmod 644 "$file"

  # The host key comes from ssh-keyscan at run time, so a rotation by GitHub
  # is picked up by the next install; it is never baked into a template.
  if ! grep -q '^github\.com ' "$knownHosts" 2>/dev/null; then
    keys="$(ssh-keyscan github.com 2>/dev/null | grep '^github\.com ')"
    if [ -z "$keys" ] || ! { printf '%s\n' "$keys" >> "$knownHosts"; } 2>/dev/null; then
      create.result 1 "could not add the host key of github.com to $knownHosts"
      error.log "$RESULT"
      return $(result)
    fi
  fi
  chmod 644 "$knownHosts"

  removed="$(private.ossh.shared.ssh.legacy.remove)$(private.ossh.github.copies.remove "$knownHosts")"
  create.result 0 "github.com for all users: $file, $knownHosts${removed:+; removed:$removed}"
  success.log "$RESULT"
  return $(result)
}
