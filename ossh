private.ossh.shared.ssh.copy.to.all() # <sshConfigHost> # on <sshConfigHost>, copy /home/shared/.ssh/{config,known_hosts,2cuGitHub} to every existing user's ~/.ssh/ with owner=user (login group), perms 700/600/644. Single source of truth for the per-user propagation step shared by ossh.install.finish.local's caller-side path and its developking-fallback else branch.
{
  local sshConfigHost="$1"
  if [ -z "$sshConfigHost" ]; then
    error.log "no ${YELLOW}sshConfigHost${NORMAL} was specified"
    return 1
  fi

  # One SSH roundtrip, sudo-wrapped remote bash. Files in /home/shared/.ssh/
  # are assumed to already exist (seeded by either the caller's deploy_keys
  # push or the developking fallback). If the shared key is missing, exit
  # quietly — this method is idempotent/no-op in that case.
  #
  # `chown $u:` (trailing colon, no group) sets the group to the user's
  # login group whatever it's named. Robust against platform.test containers
  # where `test` has gid=0 and no `test` group exists; explicit `$u:$u`
  # would error with "invalid group".
  private.ossh.ssh "$sshConfigHost" "sudo bash -c '
    basehome=\$(dirname \"\$HOME\")
    [ \"\$basehome\" = / ] && basehome=/home
    sharedSsh=\"\$basehome/shared/.ssh\"
    [ -f \"\$sharedSsh/2cuGitHub\" ] || exit 0
    for u in \$(ls \"\$basehome\" 2>/dev/null | grep -v shared); do
      h=\"\$basehome/\$u\"
      [ -d \"\$h\" ] || continue
      mkdir -p \"\$h/.ssh\"
      cp \"\$sharedSsh/config\" \"\$h/.ssh/config\" 2>/dev/null
      cp \"\$sharedSsh/known_hosts\" \"\$h/.ssh/known_hosts\" 2>/dev/null
      cp \"\$sharedSsh/2cuGitHub\" \"\$h/.ssh/2cuGitHub\" 2>/dev/null
      chown \"\$u:\" \"\$h/.ssh/config\" \"\$h/.ssh/known_hosts\" \"\$h/.ssh/2cuGitHub\" 2>/dev/null
      chmod 700 \"\$h/.ssh\"
      chmod 600 \"\$h/.ssh/config\" \"\$h/.ssh/2cuGitHub\"
      chmod 644 \"\$h/.ssh/known_hosts\"
    done
    rootHome=\$(eval echo ~root)
    if [ -d \"\$rootHome\" ]; then
      mkdir -p \"\$rootHome/.ssh\"
      cp \"\$sharedSsh/config\" \"\$rootHome/.ssh/config\" 2>/dev/null
      cp \"\$sharedSsh/known_hosts\" \"\$rootHome/.ssh/known_hosts\" 2>/dev/null
      cp \"\$sharedSsh/2cuGitHub\" \"\$rootHome/.ssh/2cuGitHub\" 2>/dev/null
      chown root: \"\$rootHome/.ssh/config\" \"\$rootHome/.ssh/known_hosts\" \"\$rootHome/.ssh/2cuGitHub\" 2>/dev/null
      chmod 700 \"\$rootHome/.ssh\"
      chmod 600 \"\$rootHome/.ssh/config\" \"\$rootHome/.ssh/2cuGitHub\"
      chmod 644 \"\$rootHome/.ssh/known_hosts\"
    fi
  '" 2>/dev/null
}

