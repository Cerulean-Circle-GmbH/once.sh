ossh.config.shared.seed.github() # <sshConfigHost> # set GitHub up for every user on <sshConfigHost> — the remote ossh config.shared.github.create, as root. Skipped when the system file there has Host github.com and the old template folder is gone
{
  local sshConfigHost="$1" systemConfig
  if [ -z "$sshConfigHost" ]; then
    error.log "no ${YELLOW}sshConfigHost${NORMAL} was specified"
    return 1
  fi

  # Skip-when-already-seeded probe. NOTE (Phase A.8): grep is intentional
  # here — this expression runs in a remote bash via ossh.exec where OOSH
  # functions like ossh.config.get aren't reliably importable across the
  # shell layers (sudo + ssh + bash -c). While <basehome>/shared/.ssh is
  # still there, the remote create has a cleanup to do, so it runs.
  systemConfig="$(private.ossh.system.config.file.get)"
  if ossh.exec "$sshConfigHost" 'case "$OSTYPE" in darwin*) b=/Users ;; *) b=/home ;; esac; grep -q "^Host github.com$" "'"$systemConfig"'" 2>/dev/null && [ ! -d "$b/shared/.ssh" ]' 2>/dev/null; then
    info.log "$sshConfigHost already has Host github.com in $systemConfig — skipping seed"
    return 0
  fi

  # Delegate to remote `ossh config.shared.github.create`. sudo + absolute
  # path so we don't lose PATH on macOS sudoers env_reset; root writes /etc/ssh
  # and cleans up the homes.
  if ossh.exec "$sshConfigHost" 'sudo -E $(command -v ossh) config.shared.github.create'; then
    return 0
  fi

  warn.log "Could not set GitHub up for every user on $sshConfigHost — users will lack the Host github.com alias"
  return 1
}
