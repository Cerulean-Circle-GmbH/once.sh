private.ossh.key.push()     # <toHost> <?keyName> <?sshDir:~/.ssh> # add your key <sshDir>/public_keys/<?keyName> (default: the key of <sshDir>) to <toHost>: copied to its public_keys/, then its authorized_keys rebuilt by its oosh, or the key only added where it has none; rc 0 + RESULT saying which, rc 1 + RESULT when the connection, the copy or both ways of authorizing fail #
{
  local toHost="$1"
  if [ -n "$1" ]; then
    shift
  else
    create.result 1 "no toHost was specified"
    error.log "$RESULT"
    return $(result)
  fi

  # An empty <?keyName> still holds its place: key.push <host> "" <sshDir>,
  # as key.pull. The default key is the one of THAT sshDir, so it is named
  # after the sshDir is known — it was named from the default sshDir first,
  # and `[ -n "$1" ] && shift` then took the <sshDir> as missing
  # (T-OSSH-REMOTE-PUBLIC-KEY-PUT).
  local keyName="$1"
  [ $# -gt 0 ] && shift

  private.get.sshDir "$1"
  [ -n "$1" ] && shift
  local sshDir="$RESULT"
  [ -n "$keyName" ] || keyName="$( private.ossh.get.file.name "$sshDir" ).public_key"

  # Quote keyName everywhere — defensive against legacy filenames
  # that may have spaces (pre-sanitization at private.ossh.set.key.name).
  info.log "$sshDir/public_keys/$keyName -> $toHost:.ssh/public_keys/$keyName"
  ossh.connection.open "$toHost" || return $(result)   # no master: every step would ask the password again (T-OSSH-CONNECTION-OPEN-FAIL)
  # The key file first — no rebuild on <toHost> without it: the copy's rc
  # was ignored, and a missing file still ran the rebuild there
  # (T-OSSH-REMOTE-PUBLIC-KEY-PUT).
  private.ossh.remote.public.key.put "$toHost" "$sshDir/public_keys/$keyName" "$keyName" || {
    error.log "$RESULT"; return $(result)
  }
  # An oosh on <toHost> without authorized.keys.update: the key is only added.
  # `command -v user` first: a host without oosh printed "user: command not
  # found" on every push (T-OSSH-KEY-PUSH-BARE-QUIET). One RESULT per way out:
  # the push ended with the pipeline's rc, and a failed fallback said nothing
  # (T-OSSH-REMOTE-PUBLIC-KEY-PUT).
  if ossh.exec "$toHost" "command -v user >/dev/null 2>&1 && user authorized.keys.update"; then
    create.result 0 "$keyName authorized on $toHost (rebuild)"
    success.log "$RESULT"
  elif private.ossh.authorized.key.append.get "$keyName" | private.ossh.ssh "$toHost" "sh"; then
    create.result 0 "$keyName added to $toHost's authorized_keys"
    success.log "$RESULT"
  else
    create.result 1 "could not authorize $keyName on $toHost"
    error.log "$RESULT"
  fi
  return $(result)
}

private.ossh.authorized.key.append.get()     # <keyFileName> # echo the POSIX commands that add ~/.ssh/public_keys/<keyFileName> to ~/.ssh/authorized_keys of the shell that runs them — only when it is not there; no other key is touched #
{
 # NO create.result — a getter; its output is piped into the target's sh.
 # It replaced `cat public_keys/* > authorized_keys`, which deleted every key
 # without a file in public_keys/ (POL.dev, 2026-10-15,
 # T-OSSH-AUTHORIZED-KEY-APPEND). The rebuild is user authorized.keys.update.
 # A last line without its newline gets one first, so the keys stay apart.
 local keyFileName="${1//\'/}"
 cat <<EOF
k=~/.ssh/public_keys/'$keyFileName'; a=~/.ssh/authorized_keys
touch "\$a"
if ! grep -qxF "\$(cat "\$k")" "\$a"; then
  [ -n "\$(tail -c 1 "\$a")" ] && echo >> "\$a"
  cat "\$k" >> "\$a"
fi
chmod 600 "\$a"
EOF
}

