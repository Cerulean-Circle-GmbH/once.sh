ossh.config.push()     # <toHost> <?sshConfigName> # puts the local Host block <sshConfigName> into ~/.ssh/config on <toHost> — replaced where it is, or added — one ssh call, no rsync or oosh needed there #
{
  private.ossh.config.push "$@"
