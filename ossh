ossh.config.delete() # <sshConfigHost> <?file:~/.ssh/config> # removes the Host block of <sshConfigHost> — what ossh config.get shows, from "Host <sshConfigHost>" to the next empty line — in place; the other blocks and the mode of the file stay; rc 2 when there is none
{
  # The twin of ossh.config.create: the tart_ubuntu entry of the headless
  # check (2026-10-14) would have been hand-edited (T-OSSH-CONFIG-DELETE).
  # Written back with `cat >`, which keeps owner and mode (600 for ssh).
  local host="$1" file="$2" kept
  if [ -z "$host" ]; then
    create.result 1 "ossh.config.delete: <sshConfigHost> required"; error.log "$RESULT"; return $(result)
  fi
  if [ -z "$file" ]; then
    private.get.sshDir
    file="$RESULT/config"
  fi
  if ! grep -qx "Host $host" "$file" 2>/dev/null; then
    create.result 2 "config $host not found in $file"; warn.log "$RESULT"; return $(result)
  fi
  # The trailing x keeps the last empty lines: $(…) would drop them, and the
  # next config.save.last block would run into the one before it.
  kept=$(awk -v h="Host $host" '$0 == h { skip = 1; next } skip && /^$/ { skip = 0; next } !skip' "$file"; echo x)
  kept="${kept%x}"
  if ! { printf '%s' "$kept" > "$file"; } 2>/dev/null; then
    create.result 1 "cannot write $file — config $host not deleted"; error.log "$RESULT"; return $(result)
  fi
  create.result 0 "config $host deleted from $file"
  return $(result)
}



ossh.config.parse.url() {  # <url>  <?method> # parses the url and shows config values. Then calls optional method that has acces to the paresed values
  local url="$1"
  if [ -n "$1" ]; then
    url="$1"
    shift
  else
    url="$USER@$(private.this.host.name.get):22"
  fi

  local call="$1"
  if [ -n "$1" ]; then
    call="$1"
    shift
  else
    call=""
  fi


  local user="$( echo $url | cut -d"@" -f1  )"
  local hostAndPort="$( echo $url | cut -d"@" -f2  )"

  local hostname="$( echo $hostAndPort | cut -d":" -f1  )"
  local port="$( echo $hostAndPort | cut -d":" -f2  )"
  if ! this.isNumber $port; then
    path=$port
    SSH_CONFIG_Port=22
    port="$SSH_CONFIG_Port"
  fi
  
  if [ -z "$id" ]; then
    private.get.sshDir
    if private.detect.ssh.key "$RESULT"; then
      id="$RESULT"
    else
      id="$RESULT/id_ed25519"
    fi
  fi

  private.config.create
  $call
}

ossh.config.parse() # <sshConfigHost>  <?method:private.config.create> # parses the config and shows config values. Then calls optional <method> that has acces to the paresed values
{

  #set -x
  local sshConfigHost="$1"
  if [ -n "$1" ]; then
    shift
  else
    error.log "no sshConfigHost was specified"
    return 1
  fi


  local call="$1"
  if [ -n "$1" ]; then
    call="$1"
    shift
  else
    call="private.config.create"
  fi

  ossh.config.get $sshConfigHost | line.trim | line.split | line.unquote | line.format "declare -- SSH_CONFIG_%s=%s\n" >$CONFIG_PATH/result.env
  source $CONFIG_PATH/result.env

  local sshConfigHost="$SSH_CONFIG_Host"
  local user="$SSH_CONFIG_User"
  local hostname="$SSH_CONFIG_HostName"
  
  local path=""
  local port="$SSH_CONFIG_Port"
  if ! this.isNumber port; then
    path=$port
    SSH_CONFIG_Port=22
    port="$SSH_CONFIG_Port"
  fi
  local id="$SSH_CONFIG_IdentityFile"

  $call
}

private.config.create() {
  # The block goes to its own file, the one config.save.last reads: result.txt
  # is a scratch file the live log tees into and ossh.config.get overwrites
