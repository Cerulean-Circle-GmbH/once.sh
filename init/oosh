#!/bin/sh
#http://www.etalabs.net/sh_tricks.html

export PS4='sh debug> '
if [ -z "$SH_OPT" ]; then
  if [ -n "$LOG_LEVEL" ] && [ "$LOG_LEVEL" -gt 5 ] 2>/dev/null; then
    export SH_OPT="-x"
  else
    export SH_OPT="+x"
  fi
fi

# find all set -x
#  '^ *[^#] *set -x'
set $SH_OPT
# force debug

#unset SHELL
oosh_get_running_shell()
{
  if [ -n "$BASH_VERSION" ]; then
     SHELLNAME="bash"
     if [ -n "$BASH" ]; then
       SHELL="$BASH"
     else
       SHELL="$(command -v bash)"
     fi
     return
  fi

  # Fallback for sh/dash/etc
  SHELLPS="$(ps -o pid,args | grep "\w*$$ [^g]*/sh" 2>/dev/null)"
  if [ -n "$SHELLPS" ]; then
      local shellPath=$(echo "$SHELLPS" | awk '{print $2}')
      if [ -n "$shellPath" ]; then
          SHELLNAME=$(basename "$shellPath")
          SHELL="$shellPath"
      fi
  fi

  # Last resort
  if [ -z "$SHELLNAME" ]; then
      SHELLNAME="sh"
      SHELL="$(command -v sh)"
  fi
}

log()
{
  install_log "LOG: $*"
  if [ "${LOG_LEVEL:-0}" -gt 4 ]; then
    echo "$@"
  fi
}

oosh_check_pm()             # checks for a package manager
{
    packageManager=$1
    packageManagerCommand=$2


    if [ -z "$packageManagerCommand" ]; then
        package=$packageManager
    fi   
    if ! [ -x "$(command -v $packageManager)" ]; then
        log "no $packageManager"
    else
        if [ -z "$OOSH_PM" ]; then
            export OOSH_PM="$packageManagerCommand"
            #export groupAddCommand=$2
            #export userAddCommand=$3
            log "Package Manager found: using $OOSH_PM somePackage"
            if [ "$packageManager" = "apt-get" ]; then
                if [ -z "$OOSH_PM_UPDATED" ]; then
                  OOSH_PM_UPDATED="$SUDO apt-get update"
                  if [ "$HOME" = "/root" ]; then
                    $OOSH_PM_UPDATED
                  else
                    #sudo $OOSH_PM_UPDATED
                    PM="sudo $PM"
                    SUDO="sudo -S"
                    $SUDO $OOSH_PM_UPDATED
                  fi
                else
                  log "in case of installation errors try to call: apt-get update"
                fi
            fi
        fi
    fi
}

oosh_check_all_pm()         # adds tools and configurations to package manager (brew, apt-get, addgroup, adduser, dpkg, pkg)
{
    # Ensure Homebrew is discoverable on macOS (SSH sessions have minimal PATH)
    if [ "$(uname -s)" = "Darwin" ]; then
        for _brew_path in /opt/homebrew/bin /usr/local/bin; do
            if [ -x "$_brew_path/brew" ]; then
                case ":$PATH:" in
                    *":$_brew_path:"*) ;;
                    *) export PATH="$_brew_path:$PATH" ;;
                esac
                break
            fi
        done
    fi

    oosh_check_pm brew "brew install"
   #oosh_check_pm apt "apt add"
    oosh_check_pm apt-get "apt-get -y install" "groupadd -f" "useradd -g dev"
    oosh_check_pm dnf "dnf -y install" "groupadd -f" "useradd -g dev"
    oosh_check_pm yum "yum -y install" "groupadd -f" "useradd -g dev"
    oosh_check_pm apk "apk add" "addgroup" "adduser -g dev"
    oosh_check_pm dpkg "dpkg install"
    oosh_check_pm pkg "pkg install"
    oosh_check_pm pacman "pacman -S"
 
}

oosh_check_os() # check on which Operating System oosh is being deploid on #
{
  if ! [ -x "$( command -v oo )" ]; then
   info.log "no os script class installed yet"
   return 1
  fi
  if os check.env; then
    info.log "OS detected and OOSH_OS populated with $OOSH_OS"
  else
    error.log "NO OS detected"
  fi

  exit 
}

oosh_cmd() 
{
    unset package
    current=$1
    shift
    if [ -n "$1" ]; then
      package=$1
      shift
    fi
    if [ -z "$package" ]; then
        package=$current
    else
      shift
      package=$1
    fi

    if [ -z "$OOSH_OS" ]; then
      log "no OS found (expected during bootstrap — oo not available yet)"
    fi
    
    if [ -z "$OOSH_PM" ]; then
      echo "no PM found...checking" 
      oosh_check_all_pm
    fi
    if ! [ -x "$(command -v $current)" ]; then
        echo "no $current"
        if [ -n "$OOSH_PM" ]; then
          $SUDO $OOSH_PM $package
        else
          echo "still no PM found: $OOSH_PM $package"
        fi
    # else
    #   echo "command $current exists"
    fi
}

oosh_install_oosh()
{

  oosh_cmd git
  oosh_cmd rsync
  cd ~
  # Ensure OOSH_DIR is always an absolute path
  if [ "$(uname -s)" = "Linux" ]; then
    OOSH_DIR="$(readlink -f "./oosh")"
  else
    OOSH_DIR="$(pwd)/oosh"
  fi


  if ! [ -d "$OOSH_DIR" ]; then
    #set -x # force debug
    mkdir -p ./init
    if [ ! -z ${OOSH_INSTALL_SOURCE} ] && [ -d ${OOSH_INSTALL_SOURCE} ]; then
      echo "<oosh> Install oosh from ${OOSH_INSTALL_SOURCE}"
      rsync -a ${OOSH_INSTALL_SOURCE}/ oosh/
    else
      echo "<oosh> Install oosh from https://github.com/Cerulean-Circle-GmbH/once.sh.git"
      git clone https://github.com/Cerulean-Circle-GmbH/once.sh.git
      if [ -f ./oosh ]; then
        mv ./oosh ./init
        chmod +x ./init/oosh
      fi
      mv ./once.sh ./oosh
      
      if [ ! -z "$DEV_MODE" ] || [ ! -z "${OOSH_BRANCH}" ]; then
        if [ -z "${OOSH_BRANCH}" ]; then
          OOSH_BRANCH=dev
        fi
        echo "<oosh> Install oosh with branch ${OOSH_BRANCH}"

        # Set up worktree structure: main/ + branch/ with ~/oosh as symlink
        _wt_base="$(dirname "$OOSH_DIR")"

        # Rename the clone from oosh/ to main/
        mv ./oosh "${_wt_base}/main"

        if [ "${OOSH_BRANCH}" = "main" ]; then
          # Already on main — just symlink
          ln -s "${_wt_base}/main" ./oosh
        else
          # Create worktree for the target branch
          cd "${_wt_base}/main"
          git fetch origin
          git worktree add -B "${OOSH_BRANCH}" "../${OOSH_BRANCH}" "origin/${OOSH_BRANCH}"
          cd ~
          ln -s "${_wt_base}/${OOSH_BRANCH}" ./oosh
        fi

        OOSH_DIR="$(readlink -f ./oosh 2>/dev/null || echo "$(pwd)/oosh")"
        OOSH_WORKTREE_BASE="${_wt_base}"
        export OOSH_WORKTREE_BASE
        unset _wt_base
      fi
    fi
    cp -r ~/oosh/init/* ~/init
  else
    cd "$OOSH_DIR"
    git pull
    cd ..
  fi
}

oosh_setup_env()
{
  # Minimal Phase 2: set up user environment files
  # Full Phase 2 (state machine, SSH, shared config) only runs in 'mode root'.
  # This ensures .bashrc and config exist for tests and basic usage.
  install_log "Setting up user environment"

  # Install .bashrc from template (pattern: oo:private.check.root.installation.done)
  if [ -f "$OOSH_DIR/templates/user/bashrcTemplate" ]; then
    if [ -f "$HOME/.bashrc" ] && [ ! -f "$HOME/.bashrc.pre-oosh" ]; then
      cp "$HOME/.bashrc" "$HOME/.bashrc.pre-oosh"
      install_log "Backed up existing .bashrc to .bashrc.pre-oosh"
    fi
    cp "$OOSH_DIR/templates/user/bashrcTemplate" "$HOME/.bashrc"
    install_log "Installed .bashrc from template"

    # macOS Terminal opens login shells which read .bash_profile, not .bashrc
    # Ensure .bash_profile sources .bashrc so oosh works on all platforms
    if [ ! -f "$HOME/.bash_profile" ] || ! grep -q '\.bashrc' "$HOME/.bash_profile" 2>/dev/null; then
      echo '# Source .bashrc for login shells (required on macOS)
[ -f "$HOME/.bashrc" ] && source "$HOME/.bashrc"' >> "$HOME/.bash_profile"
      install_log "Added .bashrc source to .bash_profile"
    fi
  fi

  # Ensure ~/config/user.env exists (pattern: config:config.init)
  mkdir -p "$HOME/config"
  if [ ! -f "$HOME/config/user.env" ]; then
    touch "$HOME/config/user.env"
    install_log "Created empty ~/config/user.env"
  fi
}

oosh_status()
{
  # Ensure LOG_LEVEL has a default value to avoid [ -gt ] errors
  if [ -z "$LOG_LEVEL" ]; then
    LOG_LEVEL=1
  fi

  # Ensure USER is populated
  if [ -z "$USER" ]; then
    USER=$(id -u -n 2>/dev/null)
  fi

  # Compute BASH_MAJOR_VERSION if not set
  if [ -z "$BASH_MAJOR_VERSION" ] && [ -n "$BASH_FILE" ]; then
    BASH_MAJOR_VERSION=$("$BASH_FILE" -c "echo \"\${BASH_VERSINFO[0]}\"" 2>/dev/null)
  fi

  echo "
  SHELL: $SHELL
       : $SHELLNAME
       : $SHELLPS
    PWD: $(pwd)
      0: $0

     PM: $OOSH_PM${OOSH_PM_UPDATED:+
         $OOSH_PM_UPDATED}

   BASH: $BASH_FILE
      v: ${BASH_MAJOR_VERSION:-unknown}

   INSTALL_MODE: ${INSTALL_MODE:-not set}
       DEV_MODE: ${DEV_MODE:-not set}

   USER: $USER

   PATH: $PATH
  "
  if [ "$HOME"  = "/root" ];then
    SUDO=""
  else
    SUDO="sudo -S"
  fi
}

# Remote installation — always installs to root, no menu
oosh_install_remote() {
  local sshConfigNameUsedForLocal="$1"
  local sshConfigFromRemote="${2:-}"

  echo "Remote installation initiated (root mode)"
  install_log "Remote installation initiated (root mode)"

  if [ "$(id -u)" = "0" ]; then
    # Already root — install directly
    oosh_check_all_pm
    oosh_status
    oosh_install_oosh

    # Use 'this call' for bootstrapped execution
    # Pass OOSH_BRANCH inline so it survives the 'this' bootstrap (which resets env via config.init)
    echo "Continuing installation via oosh bootstrap (branch: $OOSH_BRANCH)..."
    install_log "Phase 1 complete, handing off to Phase 2"
    "$BASH_FILE" -xc "export OOSH_BRANCH='$OOSH_BRANCH'; export INSTALL_LOG='$INSTALL_LOG'; $OOSH_DIR/this call ossh install.continue.local $sshConfigNameUsedForLocal $sshConfigFromRemote"
    install_log "Done with ROOT installation."
    echo "Done with ROOT installation."
    return 0
  else
    # Not root — re-exec this script as root so oosh clones into root's home
    echo "Re-executing as root via sudo..."
    oosh_check_all_pm
    oosh_status
    # Determine root's home directory (Linux: /root, macOS: /var/root)
    # Use directory services / passwd directly — $HOME via sudo is unreliable (macOS doesn't reset it)
    local rootHome=""
    if command -v dscl >/dev/null 2>&1; then
      rootHome=$(dscl . -read /Users/root NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    fi
    : ${rootHome:=$(awk -F: '$1 == "root" {print $6}' /etc/passwd 2>/dev/null)}
    : ${rootHome:=/root}
    # Copy init/oosh to a location root can access
    $SUDO cp ~/oosh "$rootHome/oosh_init"
    $SUDO chmod +x "$rootHome/oosh_init"
    # Pass OOSH_BRANCH as both env var and positional arg $5 for robustness
    # Use '_' placeholder for empty config_remote (empty args get lost in argument passing)
    # Use 'env' after sudo to set HOME reliably (macOS sudo env_reset strips inline vars)
    $SUDO env HOME="$rootHome" PATH="$PATH" OOSH_BRANCH="$OOSH_BRANCH" INSTALL_LOG="$rootHome/config/install.log" "$BASH_FILE" "$rootHome/oosh_init" mode root "$sshConfigNameUsedForLocal" "${sshConfigFromRemote:-_}" "$OOSH_BRANCH" "${LOG_LEVEL:-1}"
    local rc=$?
    # Fix shared config permissions so non-root users can write
    local basehome
    basehome="$(dirname "$HOME")"
    $SUDO chgrp -R dev "$basehome/shared" 2>/dev/null
    $SUDO chmod -R g+w "$basehome/shared" 2>/dev/null
    $SUDO find "$basehome/shared" -type d -exec chmod g+s {} + 2>/dev/null
    # usermod may be in /usr/sbin which is not in PATH on Debian
    local _usermod
    _usermod=$(command -v usermod 2>/dev/null || echo /usr/sbin/usermod)
    if [ -x "$_usermod" ]; then
      $SUDO "$_usermod" -aG dev "$(whoami)" 2>/dev/null || {
        echo "WARNING: Could not add $(whoami) to dev group — shared config may be read-only"
      }
    elif command -v addgroup >/dev/null 2>&1; then
      $SUDO addgroup "$(whoami)" dev 2>/dev/null || {
        echo "WARNING: Could not add $(whoami) to dev group — shared config may be read-only"
      }
    elif command -v dseditgroup >/dev/null 2>&1; then
      $SUDO dseditgroup -o edit -a "$(whoami)" -t user dev 2>/dev/null || {
        echo "WARNING: Could not add $(whoami) to dev group — shared config may be read-only"
      }
    else
      echo "WARNING: Neither usermod, addgroup, nor dseditgroup found — cannot add $(whoami) to dev group"
    fi
    $SUDO rm -f "$rootHome/oosh_init"
    echo "Done with ROOT installation (from user context)."
    return $rc
  fi
}

oosh_parse_shellps()
{
  if [ -n "$1" ]; then
    shell_pid=$1
    shift
  fi
  script=$1
  shell=$1
  if [ "$(echo $script | cut -c 1)" = "{" ]; then
    #echo script=$script
    shift
    shell=$1
  else
    #echo shell=$script
    shell=$script
    script=$2
  fi
  this=$2

  log " 
    shell: $shell
      pid: $shell_pid
   script: $script
     this: $this
  "
  SHELL=$shell

}


install_log()
{
  if [ -n "$INSTALL_LOG" ]; then
    echo "$*" >>"$INSTALL_LOG" 2>/dev/null
  fi
}

oosh_start()
{
  # Phase 1 install log setup
  INSTALL_LOG="$HOME/config/install.log"
  mkdir -p "$HOME/config" 2>/dev/null
  echo "# OOSH Install Log - $(date)" > "$INSTALL_LOG"
  echo "# Phase 1: init/oosh bootstrap" >> "$INSTALL_LOG"
  export INSTALL_LOG

  oosh_get_running_shell

  # Only try to parse ps if we haven't already identified the shell as bash
  if [ "$SHELLNAME" != "bash" ]; then
      oosh_parse_shellps $SHELLPS
      if [ -n "$SHELL" ]; then
        SHELLNAME=$(basename $SHELL)
      fi
  fi

  BASH_FILE=$(command -v bash)

  # Ensure we're running in bash — re-exec if not
  if [ "$SHELLNAME" != "bash" ]; then
    echo "Current shell ($SHELLNAME) is not bash. Ensuring bash is installed..."
    # Set SUDO early so oosh_cmd can install packages as non-root
    if [ "$HOME" != "/root" ] && [ -z "$SUDO" ]; then
      SUDO="sudo"
    fi
    oosh_check_all_pm
    if [ -z "$BASH_FILE" ]; then
      oosh_cmd bash
      BASH_FILE=$(command -v bash)
    fi
    if [ -n "$BASH_FILE" ]; then
      echo "Re-executing with $BASH_FILE..."
      exec "$BASH_FILE" "$0" "$@"
    else
      echo "ERROR: bash not found and could not be installed."
      return 1
    fi
  fi

  # Now we are guaranteed to be in bash — check version (macOS ships Bash 3.2)
  if [ -n "$BASH_FILE" ]; then
    BASH_MAJOR_VERSION=$("$BASH_FILE" -c "echo \"\${BASH_VERSINFO[0]}\"" 2>/dev/null)
  fi
  if [ "${BASH_MAJOR_VERSION:-0}" -lt 4 ]; then
    echo "BASH_MAJOR_VERSION=$BASH_MAJOR_VERSION"
    echo "Bash $BASH_MAJOR_VERSION is too old (oosh needs Bash 4+). Installing newer bash..."
    # Ensure PM is available for install
    if [ -z "$OOSH_PM" ]; then
      if [ "$(id -u)" != "0" ] && [ -z "$SUDO" ]; then SUDO="sudo"; fi
      oosh_check_all_pm
    fi
    if [ -n "$OOSH_PM" ]; then
      $SUDO $OOSH_PM bash
    fi
    BASH_FILE=""
    for _candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
      if [ -x "$_candidate" ]; then
        _ver=$("$_candidate" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null)
        if [ "${_ver:-0}" -ge 4 ]; then
          BASH_FILE="$_candidate"
          break
        fi
      fi
    done
    if [ -n "$BASH_FILE" ]; then
      # Register new bash in /etc/shells (required for SSH login on macOS)
      if [ -f /etc/shells ] && ! grep -q "$BASH_FILE" /etc/shells 2>/dev/null; then
        echo "$BASH_FILE" | $SUDO tee -a /etc/shells >/dev/null
      fi
      echo "Re-executing with $BASH_FILE..."
      exec "$BASH_FILE" "$0" "$@"
    else
      echo "WARNING: Could not find Bash 4+ after install. Continuing with Bash ${BASH_MAJOR_VERSION}..."
      BASH_FILE=$(command -v bash)
    fi
  fi

  if [ -n "$1" ]; then
    echo "got parameters: $@"
    while [ -n "$1" ]; do
      case $1 in
        mode)
          echo "got: $*"
          # Fixed positions: ./oosh mode <install_mode> <name_local> <config_remote> <branch> <logLevel>
          # install_mode ($2) is accepted but always treated as root
          install_remote_name_local="$3"
          # '_' is a placeholder for empty values (empty args get lost across SSH + shebang chain)
          install_remote_config_remote="$4"
          if [ "$install_remote_config_remote" = "_" ]; then install_remote_config_remote=""; fi
          # Branch passed as argument because shebang env -i wipes environment variables
          if [ -n "$5" ]; then
            export OOSH_BRANCH="$5"
            echo "OOSH_BRANCH set from argument: $OOSH_BRANCH"
          fi
          # Log level passed as argument to control verbosity
          if [ -n "$6" ]; then
            export LOG_LEVEL="$6"
            if [ "$LOG_LEVEL" -gt 5 ] 2>/dev/null; then
              export SH_OPT="-x"
            else
              export SH_OPT="+x"
            fi
            set $SH_OPT
          fi

          oosh_install_remote "$install_remote_name_local" "$install_remote_config_remote"
          return $?
        ;;
        localInstall)
          oosh_check_all_pm
          oosh_status
          oosh_install_oosh
          oosh_setup_env
          return 0
        ;;
        *)
          echo "this.call to: $*"
          shift
      esac
    done
  fi

  if [ -z "$LOG_LEVEL" ]; then
    LOG_LEVEL=1
  fi

  #oosh_check_os
  oosh_check_all_pm

  oosh_status
  oosh_install_oosh
  oosh_setup_env

  # Bootstrap config paths so oosh commands can persist to user.env
  export CONFIG_PATH="$HOME/config"
  export CONFIG="$CONFIG_PATH/user.env"
  case ":$PATH:" in
    *":$OOSH_DIR:"*) ;;
    *) export PATH="$OOSH_DIR:$PATH" ;;
  esac

  # Use oosh path prepend to add bash 4+ directory to front of PATH
  # This persists PATH, BASH_FILE, and OOSH config to user.env via config save
  export BASH_FILE OOSH_DIR
  if [ -n "$BASH_FILE" ]; then
    bashDir="$(dirname "$BASH_FILE")"
    if [ "$bashDir" != "/usr/bin" ] && [ "$bashDir" != "/bin" ]; then
      install_log "Using path prepend to add $bashDir to PATH"
      "$BASH_FILE" "$OOSH_DIR/path" prepend "$bashDir"
    else
      # System bash is already in PATH — just persist config
      install_log "System bash at $BASH_FILE — persisting config"
      "$BASH_FILE" "$OOSH_DIR/config" save
    fi
  fi

  echo "BASH Version: $BASH_VERSION[@]"
}

oosh_start "$@"
