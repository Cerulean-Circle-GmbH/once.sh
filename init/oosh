#!/usr/bin/env -iS HOME=${HOME} sh
#http://www.etalabs.net/sh_tricks.html

export PS4='sh debug> '
if [ -z "$SH_OPT" ]; then export SH_OPT="-x"; echo "SH_OPT set to: $SH_OPT"; fi


# find all set -x
#  '^ *[^#] *set -x'
set $SH_OPT
# force debug

#unset SHELL
oosh_get_running_shell() 
{
  if [ -n "$BASH_VERSION" ]; then
     SHELLNAME="bash"
     if [ -n "$BASH" ]; then
       SHELL="$BASH"
     else
       SHELL="$(which bash)"
     fi
     return
  fi

  # Fallback for sh/dash/etc
  SHELLPS="$(ps -o pid,args | grep "\w*$$ [^g]*/sh" 2>/dev/null)"
  if [ -n "$SHELLPS" ]; then
      # Try to extract shell path/name. This is brittle.
      local shell_path=$(echo "$SHELLPS" | awk '{print $2}')
      if [ -n "$shell_path" ]; then
          SHELLNAME=$(basename "$shell_path")
          SHELL="$shell_path"
      fi
  fi
  
  # Last resort
  if [ -z "$SHELLNAME" ]; then
      SHELLNAME="sh" # Assume sh if we started with shebang
      SHELL="$(which sh)"
  fi
}

log()
{
  if [ "$LOG_LEVEL" -gt 4 ]; then
    echo "$@"
  fi
} 

oosh_check_pm()             # checks for a package manager
{
    packageManager=$1
    packageManagerCommand=$2


    if [ -z "$packageManagerCommand" ]; then
        package=$packageManager
    fi   
    if ! [ -x "$(command -v $packageManager)" ]; then
        log "no $packageManager"
    else
        if [ -z "$OOSH_PM" ]; then
            export OOSH_PM="$packageManagerCommand"
            #export groupAddCommand=$2
            #export userAddCommand=$3
            log "Package Manager found: using $OOSH_PM somePackage"
            if [ "$packageManager" = "apt-get" ]; then
                if [ -z "$OOSH_PM_UPDATED" ]; then
                  OOSH_PM_UPDATED="$SUDO apt-get update"
                  if [ "$HOME" = "/root" ]; then
                    $OOSH_PM_UPDATED
                  else
                    #sudo $OOSH_PM_UPDATED
                    PM="sudo $PM"
                    SUDO="sudo -S"
                    $SUDO $OOSH_PM_UPDATED
                  fi
                else
                  log "in case of installation errors try to call: apt-get update"
                fi
            fi
        fi
    fi
}

oosh_check_all_pm()         # adds tools and configurations to package manager (brew, apt-get, addgroup, adduser, dpkg, pkg)
{

    oosh_check_pm brew "brew install"    
   #oosh_check_pm apt "apt add"
    oosh_check_pm apt-get "apt-get -y install" "groupadd -f" "useradd -g dev"
    oosh_check_pm apk "apk add" "addgroup" "adduser -g dev"
    oosh_check_pm dpkg "dpkg install"
    oosh_check_pm pkg "pkg install"
    oosh_check_pm pacman "pacman -S"
 
}

oosh_check_os() # check on which Operating System oosh is being deploid on #
{
  if ! [ -x "$( command -v oo )" ]; then
   info.log "no os script class installed yet"
   return 1
  fi
  if os check.env; then
    info.log "OS detected and OOSH_OS populated with $OOSH_OS"
  else
    error.log "NO OS detected"
  fi

  exit 
}

oosh_cmd() 
{
    unset package
    current=$1
    shift
    if [ -n "$1" ]; then
      package=$1
      shift
    fi
    if [ -z "$package" ]; then
        package=$current
    else
      shift
      package=$1
    fi

    if [ -z "$OOSH_OS" ]; then
      echo "no OS found...checking" 
      #oosh_check_os
    fi
    
    if [ -z "$OOSH_PM" ]; then
      echo "no PM found...checking" 
      oosh_check_all_pm
    fi
    if ! [ -x "$(command -v $current)" ]; then
        echo "no $current"
        if [ -n "$OOSH_PM" ]; then
          $SUDO $OOSH_PM $package
        else
          echo "still no PM found: $OOSH_PM $package"
        fi
    # else
    #   echo "command $current exists"
    fi
}

oosh_install_oosh()
{

  oosh_cmd git
  oosh_cmd rsync
  cd ~
  # Ensure OOSH_DIR is always an absolute path
  if [ "$(uname -s)" = "Linux" ]; then
    OOSH_DIR="$(readlink -f "./oosh")"
  else
    OOSH_DIR="$(pwd)/oosh"
  fi

  if ! [ -d "$OOSH_DIR" ]; then
    #set -x # force debug
    mkdir -p ./init
    if [ ! -z ${OOSH_INSTALL_SOURCE} ] && [ -d ${OOSH_INSTALL_SOURCE} ]; then
      echo "<oosh> Install oosh from ${OOSH_INSTALL_SOURCE}"
      rsync -a ${OOSH_INSTALL_SOURCE}/ oosh/
    else
      echo "<oosh> Install oosh from https://github.com/Cerulean-Circle-GmbH/once.sh.git"
      git clone https://github.com/Cerulean-Circle-GmbH/once.sh.git
      if [ -f ./oosh ]; then
        mv ./oosh ./init
        chmod +x ./init/oosh
      fi
      mv ./once.sh ./oosh
      
      ### temporary for testing
      if [ ! -z "$DEV_MODE" ] || [ ! -z ${OOSH_BRANCH} ]; then
        cd "$OOSH_DIR"
        if [ -z ${OOSH_BRANCH} ]; then
          OOSH_BRANCH=dev
        fi
        echo "<oosh> Install oosh with branch ${OOSH_BRANCH}"
        git checkout -t origin/${OOSH_BRANCH}
      fi
      ###
    fi
    cp -r ~/oosh/init/* ~/init
  else
    cd "$OOSH_DIR"
    git pull
    cd ..
  fi
}

oosh_status()
{
  # Ensure LOG_LEVEL has a default value to avoid [ -gt ] errors
  if [ -z "$LOG_LEVEL" ]; then
    LOG_LEVEL=3
  fi

  echo "
  SHELL: $SHELL
       : $SHELLNAME
       : $SHELLPS
    PWD: $(pwd)
      0: $0

     PM: $OOSH_PM
         $OOSH_PM_UPDATED 

   BASH: $BASH_FILE
      v: $BASH_MAJOR_VERSION

   INSTALL_MODE: $INSTALL_MODE
       DEV_MODE: $DEV_MODE

   USER: $USER 

   PATH: $PATH
  "
  if [ "$HOME"  = "/root" ];then
    SUDO=""
  else
    SUDO="sudo -S"
  fi
}

# New function for remote installation orchestration
oosh_install_remote() {
  local install_mode="$1"
  local ssh_config_name_used_for_local="$2" # This corresponds to $configName from client
  local ssh_config_from_remote="${3:-}"    # This corresponds to $OOSH_SSH_CONFIG_HOST from client

  echo "Remote installation initiated with mode: $install_mode"

  oosh_install_oosh # Always clone/update the oosh repository first
  
  # Ensure OOSH_DIR is in PATH so short source names work
  PATH="$OOSH_DIR:$PATH"

  # Now that the repo is cloned, source dependencies (short names, OOSH_DIR is in PATH)
  source debug
  source user
  source ossh
  source os
  source oo


  if [ "$install_mode" = "root" ]; then
    echo "Installing for root..."
    user.root.install
    "$BASH_FILE" -xc "$OOSH_DIR/this call ossh install.continue.local $ssh_config_name_used_for_local $ssh_config_from_remote"
    echo "Done with ROOT installation."
    return 0
  elif [ "$install_mode" = "user" ]; then
    echo "Installing for user ($USER)..."
    "$BASH_FILE" -xc "$OOSH_DIR/this call ossh install.continue.local $ssh_config_name_used_for_local $ssh_config_from_remote"
    echo "Done with USER installation."
    return 0
  elif [ "$install_mode" = "both" ]; then
    echo "Installing for both root and user ($USER)..."
    echo "Installing for root..."
    user.root.install
    echo "Installing for user ($USER)..."
    "$BASH_FILE" -xc "$OOSH_DIR/this call ossh install.continue.local $ssh_config_name_used_for_local $ssh_config_from_remote"
    echo "Done with BOTH installation."
    return 0
  else
    error.log "Unknown INSTALL_MODE: $install_mode"
    return 1
  fi
}

oosh_parse_shellps() 
{
  if [ -n "$1" ]; then
    shell_pid=$1
    shift
  fi
  script=$1
  shell=$1
  if [ "$(echo $script | cut -c 1)" = "{" ]; then
    #echo script=$script
    shift
    shell=$1
  else
    #echo shell=$script
    shell=$script
    script=$2
  fi
  this=$2

  log " 
    shell: $shell
      pid: $shell_pid
   script: $script
     this: $this
  "
  SHELL=$shell

}


oosh_start() 
{
  oosh_get_running_shell
  
  # Only try to parse ps if we haven't already identified the shell as bash
  # oosh_parse_shellps can clobber SHELL if SHELLPS is empty
  if [ "$SHELLNAME" != "bash" ]; then
      oosh_parse_shellps $SHELLPS
      if [ -n "$SHELL" ]; then
        SHELLNAME=$(basename $SHELL)
      fi
  fi

  BASH_FILE=$(which bash)
  
  if [ "$SHELLNAME" != "bash" ]; then
    echo "Current shell ($SHELLNAME) is not bash. Ensuring bash is installed..."
    oosh_check_all_pm
    if [ -z "$BASH_FILE" ]; then
      oosh_cmd bash
      BASH_FILE=$(which bash)
    fi
    if [ -n "$BASH_FILE" ]; then
      echo "Re-executing with $BASH_FILE..."
      exec "$BASH_FILE" "$0" "$@"
    else
      echo "ERROR: bash not found and could not be installed."
      return 1
    fi
  fi

  # Now we are guaranteed to be in bash
  if [ -n "$1" ]; then
    echo "got parameters: $@"
    while [ -n "$1" ]; do
      case $1 in
        mode)
          echo "got: $*"
          # Assign based on fixed positions after 'mode'
          # Command: ./oosh mode <install_mode> <name_local> <config_remote>
          install_remote_mode="$2"
          install_remote_name_local="$3"
          install_remote_config_remote="$4"
          
          oosh_install_remote "$install_remote_mode" "$install_remote_name_local" "$install_remote_config_remote"
          return $?
        ;;
        localInstall)
          oosh_check_all_pm
          oosh_status
          oosh_install_oosh
          oo state
          user get home # HACK needed to get the package manager right for the first time
          important.log "
          
          still during oosh installation

          continue with:

            state
            state next

          "
          return 0
        ;;
        *)
          echo "this.call to: $*"
          #this.call "$@"
          shift
      esac
    done
    #return 0 
  fi

  if [ -z "$LOG_LEVEL" ]; then
    LOG_LEVEL=3
  fi

  # if [ -r /root ]; then
  #   cd /root
  # fi

  # for testing: Docker install from OOSH_INSTALL_SOURCE
  # export OOSH_INSTALL_SOURCE=/opt/once.sh

  if [ -n "$BASH_FILE" ]; then
    echo BASH_MAJOR_VERSION=$("$BASH_FILE" -c "echo \"\${BASH_VERSINFO[0]}\"")
    BASH_MAJOR_VERSION=$("$BASH_FILE" -c "echo \"\${BASH_VERSINFO[0]}\"")
  fi

  #oosh_check_os
  oosh_check_all_pm
  oosh_status
  oosh_install_oosh

  echo "BASH Version: $BASH_VERSION[@]"
}

oosh_start "$@"
