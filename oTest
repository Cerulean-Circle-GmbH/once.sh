#!/usr/bin/env bash
#
# oTest - WODA Test Suite runner (oosh methodology)
# Manages Playwright-based UI tests for the WODA framework.
# Handles its own lifecycle: venv creation, dependency installation, test execution.
#

### new.method

# ─────────────────────────────────────────────────────────────────────────────
# TEST METHODS - one per registered test
# ─────────────────────────────────────────────────────────────────────────────

oTest.all() # <?headless> <?updateGolden> <?keepScreenshots> # Run all tests
{
  private.runTest all "$@"
}

oTest.canvasGauges() # <?headless> <?updateGolden> <?keepScreenshots> # Canvas Gauges drag-drop test
{
  private.runTest canvas_gauges "$@"
}

oTest.mobilityDemo() # <?headless> <?updateGolden> <?keepScreenshots> # Mobility Demo navigation test
{
  private.runTest mobility_demo "$@"
}

oTest.iotDemo() # <?headless> <?updateGolden> <?keepScreenshots> # IoT Demo sensor connection test
{
  private.runTest iot_demo "$@"
}

oTest.dialogManager() # <?headless> <?updateGolden> <?keepScreenshots> # DialogManager test (localhost)
{
  private.runTest dialog_manager "$@"
}

oTest.dialogManagerOnline() # <?headless> <?updateGolden> <?keepScreenshots> # DialogManager test (test.wo-da.de)
{
  private.runTest dialog_manager_online "$@"
}

# ─────────────────────────────────────────────────────────────────────────────
# UTILITY METHODS
# ─────────────────────────────────────────────────────────────────────────────

oTest.here() # <?headless> <?updateGolden> <?keepScreenshots> # Auto-detect and run test for the current directory
{
  # Simply check for otest.yaml in current directory
  if [ -f "$(pwd)/otest.yaml" ]; then
    local testName
    testName=$(grep '^name:' "$(pwd)/otest.yaml" | sed 's/name: *//' | tr -d '"' | tr -d "'")
    if [ -n "$testName" ]; then
      console.log "Detected test: $testName"
      private.runTest "$testName" "$@"
      return $?
    fi
  fi

  error.log "No otest.yaml found in current directory: $(pwd)"
  return 1
}

oTest.list() # # List all available tests
{
  private.ensureDir
  private.ensureVenv

  console.log "Available tests:"
  private.python "$OTEST_DIR/run_tests.py" --list-only 2>/dev/null || \
  private.python -c "
import yaml, os
for root, dirs, files in os.walk('$(private.eamdRoot)/Components'):
    if 'otest.yaml' in files:
        with open(os.path.join(root, 'otest.yaml')) as f:
            cfg = yaml.safe_load(f)
        name = cfg.get('name', '')
        desc = cfg.get('description', '')
        print(f'  {name:30s} {desc}')
        if 'environments' in cfg:
            for env in cfg['environments']:
                if env != 'local':
                    print(f'  {name + \"_\" + env:30s} {desc} ({env})')
"
}

oTest.updateGolden() # <testName> <?headless> # Run a test and update golden screenshots
{
  local testName="$1"
  [ -z "$testName" ] && { error.log "Usage: oTest updateGolden <testName>"; return 1; }
  shift

  # Map camelCase to snake_case if needed
  testName=$(private.mapName "$testName")
  private.runTest "$testName" updateGolden "$@"
}

oTest.updateGolden.completion.testName()
{
  private.testNames
}

oTest.setup() # # Force reinstall venv and all dependencies
{
  private.ensureDir

  local venv_dir="$OTEST_DIR/venv"
  if [ -d "$venv_dir" ]; then
    console.log "Removing existing venv..."
    rm -rf "$venv_dir"
  fi

  private.ensureVenv
  success.log "Setup complete. venv recreated with all dependencies."
}

oTest.deploy() # <?branch:test/WODA245> # Merge current branch to test, push, and deploy to test server
{
  local branch="${1:-test/WODA245}"
  private.ensureDir

  local eamd_root
  eamd_root=$(private.eamdRoot)

  if [ -z "$eamd_root" ]; then
    error.log "Cannot find EAMD.ucp git root"
    return 1
  fi

  local current_branch
  current_branch=$(git -C "$eamd_root" branch --show-current)

  console.log "Merging $current_branch into $branch..."
  git -C "$eamd_root" checkout "$branch" || return 1
  git -C "$eamd_root" merge "$current_branch" || return 1
  git -C "$eamd_root" push || return 1

  console.log "Deploying to test server..."
  ssh -o ConnectTimeout=10 \
      -i ~/.ssh/id_rsa \
      root@178.254.18.182 \
      "docker exec 69ede060b6e3 bash -c 'cd /var/dev/EAMD.ucp && git fetch origin && git checkout $branch && git pull'" 2>&1

  console.log "Switching back to $current_branch..."
  git -C "$eamd_root" checkout "$current_branch"

  success.log "Deployed to test server on branch $branch"
}

# ─────────────────────────────────────────────────────────────────────────────
# PRIVATE HELPERS
# ─────────────────────────────────────────────────────────────────────────────

private.runTest()
{
  local testName="$1"
  shift

  private.ensureDir
  private.ensureVenv

  # Translate oosh positional words to Python flags
  local pythonArgs=()
  for arg in "$@"; do
    case "$arg" in
      headless)        pythonArgs+=("--headless") ;;
      updateGolden)    pythonArgs+=("--update-golden") ;;
      keepScreenshots) pythonArgs+=("--keep-screenshots") ;;
      *)               pythonArgs+=("$arg") ;;
    esac
  done

  # Export OTEST_DIR so Python tests can use it
  export OTEST_DIR

  local saved_dir="$(pwd)"
  cd "$OTEST_DIR"
  "$OTEST_DIR/venv/bin/python" run_tests.py "$testName" "${pythonArgs[@]}"
  local rc=$?
  cd "$saved_dir"
  return $rc
}

private.ensureDir()
{
  if [ -n "$OTEST_DIR" ] && [ -d "$OTEST_DIR" ]; then
    return 0
  fi

  # Auto-discover TestSuite directory
  local candidates=(
    "$HOME/WODA.2023/_var_dev/EAMD.ucp/Components/me/hannesnortje/TestSuite/2.0.0"
    "/var/dev/EAMD.ucp/Components/me/hannesnortje/TestSuite/2.0.0"
  )

  # Also try walking up from current directory
  local current="$(pwd)"
  while [ "$current" != "/" ]; do
    local candidate="$current/Components/me/hannesnortje/TestSuite/2.0.0"
    if [ -d "$candidate" ]; then
      export OTEST_DIR="$candidate"
      info.log "Found TestSuite at: $OTEST_DIR"
      return 0
    fi
    current="$(dirname "$current")"
  done

  for dir in "${candidates[@]}"; do
    if [ -d "$dir" ]; then
      export OTEST_DIR="$dir"
      info.log "Found TestSuite at: $OTEST_DIR"
      return 0
    fi
  done

  error.log "Cannot find TestSuite directory. Set OTEST_DIR environment variable."
  return 1
}

private.ensureVenv()
{
  local venv_dir="$OTEST_DIR/venv"
  local venv_python="$venv_dir/bin/python"

  # Check if venv exists and has a working pip
  if [ -f "$venv_python" ]; then
    if "$venv_python" -m pip --version >/dev/null 2>&1; then
      # Venv is healthy
      return 0
    fi
    # Broken venv — remove and recreate
    warn.log "Existing venv is broken (no pip). Removing..."
    rm -rf "$venv_dir"
  fi

  # Check if python3 is available
  if ! command -v python3 >/dev/null 2>&1; then
    error.log "python3 is not installed"
    return 1
  fi

  # Check if ensurepip is available (needed by venv)
  if ! python3 -c "import ensurepip" 2>/dev/null; then
    warn.log "ensurepip not available. Installing python3-venv..."
    local pyver
    pyver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')

    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get install -y "python${pyver}-venv" || sudo apt-get install -y python3-venv || {
        error.log "Failed to install python3-venv. Install it manually: sudo apt install python${pyver}-venv"
        return 1
      }
    else
      error.log "No apt-get found. Install python3-venv manually for your OS."
      return 1
    fi
  fi

  console.log "Creating virtual environment in $venv_dir..."
  python3 -m venv "$venv_dir"
  if [ $? -ne 0 ]; then
    error.log "Failed to create virtual environment"
    [ -d "$venv_dir" ] && rm -rf "$venv_dir"
    return 1
  fi

  # Ensure pip is up to date
  "$venv_python" -m ensurepip --upgrade >/dev/null 2>&1

  console.log "Installing Python dependencies..."
  "$venv_python" -m pip install -r "$OTEST_DIR/requirements.txt" || {
    error.log "Failed to install requirements"
    return 1
  }

  console.log "Installing Playwright Chromium browser..."
  "$venv_python" -m playwright install chromium || {
    error.log "Failed to install Playwright browsers"
    return 1
  }

  # Install setuptools for pkg_resources compatibility
  "$venv_python" -m pip install setuptools >/dev/null 2>&1

  success.log "Virtual environment ready"
  return 0
}

private.python()
{
  "$OTEST_DIR/venv/bin/python" "$@"
}

private.eamdRoot()
{
  local dir="$OTEST_DIR"
  while [ "$dir" != "/" ]; do
    if [ "$(basename "$dir")" = "EAMD.ucp" ] && [ -d "$dir/Components" ]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

private.mapName()
{
  # Convert camelCase to snake_case: canvasGauges -> canvas_gauges
  echo "$1" | sed 's/\([A-Z]\)/_\L\1/g' | sed 's/^_//'
}

private.testNames()
{
  private.ensureDir || return 1
  private.ensureVenv || return 1

  local eamd_root
  eamd_root=$(private.eamdRoot) || return 1

  private.python -c "
import yaml, os
for root, dirs, files in os.walk('$eamd_root/Components'):
    if 'otest.yaml' in files:
        with open(os.path.join(root, 'otest.yaml')) as f:
            cfg = yaml.safe_load(f)
        print(cfg.get('name', ''))
        if 'environments' in cfg:
            for env in cfg['environments']:
                if env != 'local':
                    print(cfg['name'] + '_' + env)
"
}

# ─────────────────────────────────────────────────────────────────────────────
# STANDARD OOSH FUNCTIONS
# ─────────────────────────────────────────────────────────────────────────────

oTest.usage()
{
  local this=${0##*/}
  echo "You started"
  echo "$0

  Usage:
  $this: command   Parameter and Description"
  this.help
  echo "

  Examples
    $this all                              Run all tests
    $this all headless                     Run all tests headless
    $this canvasGauges                     Run Canvas Gauges test
    $this canvasGauges headless            Run Canvas Gauges test headless
    $this canvasGauges headless updateGolden   Run headless and update golden
    $this here                             Run test for current directory
    $this list                             List available tests
    $this updateGolden canvasGauges        Update golden screenshots
    $this setup                            Reinstall venv and dependencies
    $this deploy                           Deploy to test server
    ----------
  "
}

oTest.start()
{
  source this
  this.start "$@"
}

oTest.start "$@"
