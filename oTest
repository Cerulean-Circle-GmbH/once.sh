oTest.usage()
{
  local this=${0##*/}
  echo "You started"
  echo "$0

  Usage:
  $this: command   Parameter and Description"
  this.help
  echo "

  Examples
    $this all                              Run all tests
    $this all headless                     Run all tests headless
    $this <testName> headless              Run a specific test headless
    $this <testName> headless updateGolden Run headless and update golden
    $this here                             Run test for current directory
    $this list                             List available tests
    $this newTest MyTest                   Scaffold a new test (URL from cwd)
    $this newTest MyTest https://...       Scaffold with explicit URL
    $this updateGolden <testName>          Update golden screenshots
    $this sync                             Regenerate test methods
    $this setup                            Reinstall venv and dependencies
    $this deploy                           Deploy to test server
    ----------
  "
}

oTest.start()
{
  source this
  # Dynamic dispatch: if first arg doesn't match any oTest.* method,
  # try it as a test name (camelCase -> snake_case -> run_tests.py)
  if [ -n "$1" ] && ! type -t "oTest.$1" >/dev/null 2>&1; then
    local snakeName
    snakeName=$(private.mapName "$1")
    if private.testExists "$snakeName"; then
      console.log "Dispatching dynamically: $1 -> $snakeName"
      shift
      private.runTest "$snakeName" "$@"
      return $?
    fi
  fi
  this.start "$@"
}

oTest.start "$@"
