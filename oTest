        if os.path.isdir(candidate):
            return candidate
        current = os.path.dirname(current)
    raise RuntimeError("Cannot find TestSuite/2.0.0. Set OTEST_DIR or run via oTest.")

sys.path.insert(0, _find_test_suite())
