#!/usr/bin/env bash
#
# oTest - WODA Test Suite runner (oosh methodology)
# Manages Playwright-based UI tests for the WODA framework.
# Handles its own lifecycle: venv creation, dependency installation, test execution.
#

### new.method

# ─────────────────────────────────────────────────────────────────────────────
# TEST METHODS - one per registered test
# ─────────────────────────────────────────────────────────────────────────────

oTest.all() # <?--headless> <?--update-golden> <?--keep-screenshots> # Run all tests
{
  private.runTest all "$@"
}

