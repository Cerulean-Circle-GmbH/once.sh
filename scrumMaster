    error.log "No hiveMind registry found"
    create.result 1 "no registry"
    return $(result)
  fi

  local totalUp=0
  local totalDown=0
  local agentCount=0

  while IFS='|' read -r target role; do
    [ -z "$role" ] && continue

    local content
    content=$("$OOSH_DIR/otmux" pane.capture "$target" "${SCRUMMASTER_CAPTURE_LINES:-30}" 2>/dev/null)
