private.scrumMaster.subscription.api.call() # # fetch subscription data from OAuth API and cache
{
  # Auth
  local token
  token=$(private.scrumMaster.subscription.auth)
  if [ $? -ne 0 ]; then return 1; fi

  # API call
  local response
  response=$(curl -s -f \
    -H "Authorization: Bearer $token" \
