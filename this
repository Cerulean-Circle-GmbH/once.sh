 if [ -z "$dir" ] || [ ! -d "$dir" ]; then
   create.result 1 "private.this.selfLoop.remove requires an existing <dir>, got '$dir'"; return $(result)
 fi
 [ -O "$dir" ] || sudoWord="$SUDO"
 resolvedDir=$(private.this.path.canonical "$dir")
 for entry in "$dir"/*; do
   [ -L "$entry" ] || continue
   resolvedEntry=$(private.this.path.canonical "$entry")
   [ -n "$resolvedEntry" ] && [ "$resolvedEntry" = "$resolvedDir" ] || continue
   important.log "private.this.selfLoop.remove: removing self-referential symlink ${YELLOW}$entry${NORMAL}"
   $sudoWord rm -f "$entry" && removed=$((removed + 1))
 done
 if [ "$removed" -gt 0 ]; then
   create.result 0 "$removed self-loop(s) removed from $dir"
 else
   create.result 0 "no self-loop in $dir"
 fi
 return $(result)
}


this.kernel.validate()     # <?treeRoot:$OOSH_DIR> # sweep the tracked files for raw mkdir, chown, chgrp, chmod, ln -s, readlink, stat, mktemp, cmp, id -nG, getent, dscl, runuser, su -, docker, ssh, scp, sudo outside the kernel helpers, odocker, ossh and user; a line that must stay raw carries a kernel-exception: <why> marker comment on that same line; echo an OK:/INVALID: verdict; rc 1 on any violation, rc 2 when the sweep read nothing #
{
 # THE RULE: a script does not hand-write what a kernel helper owns. A raw
 # mkdir/chown/chgrp/chmod is private.this.dir.ensure or
 # private.this.folder.share, ln -s is private.this.symlink.with.backup,
 # readlink -f is private.this.path.canonical, stat is
 # private.this.path.stat.get, mktemp is private.this.temp.dir.get, cmp is
 # private.this.file.same, id -nG is private.user.group.member.is, getent is
 # private.this.group.exists, runuser/su -/sudo -u is private.as.user, docker
 # is odocker, ssh/scp is ossh (docs/oosh-architecture.md § Kernel helpers).
 # A line that must stay raw says why: `# kernel-exception: <why>` on that
 # same line (window 0 of the sweep: a marker covers no line but its own,
 # T-THIS-KERNEL-VALIDATE-SAME-LINE), or `# kernel-exception-file: <why>` in
 # the file.
 #
 # Exempt BY CONSTRUCTION (the owner's ruling, 2026-10-08):
 #   - the kernel helpers themselves, every private.this.* function of this:
 #     the one place the raw command may live;
 #   - a command in the script that wraps it (homes below): docker in
 #     odocker, ssh and scp in ossh, the group and account database and the
 #     user hop in user;
 #   - init/oosh (POSIX sh before oosh exists; its file-level marker),
 #     init/once, osx, old/, external/, the CI workflow that sets up a VM
 #     before oosh exists, and the files of the pre-existing list below;
 #   - the POSIX sh of the os heredoc arms that runs only inside the
 #     disposable container is judged per line, by a marker.
 #
 # Under test/ a fixture is BUILT raw on purpose (mkdir, chmod, chown, chgrp,
 # ln -s): a state the kernel would never make is the point of the test. Test
 # code READS through the kernel, so only testCommands are swept there; mktemp
 # in a test is test.suite.portability.validate (test.suite.fixture.make).
 #
 # Where a call is: the command word in command position, the anchor of
 # portability.validate, after an optional if/then/do/!/exec/command and $SUDO. Each
 # hit is read once more with its quoted text and its trailing comment blanked
 # (a "$( … )" stays code), so a word inside a message string, a case pattern
 # or a regex is no call (T-THIS-KERNEL-VALIDATE, the precedent is
 # T-PORTABILITY-ADVISORY-STRING). Accepted limits: a string that spans lines
 # is read line by line; a command inside a single-quoted remote or bash -c
 # script is quoted text and not swept; a call through a variable is not seen;
 # an apostrophe in a heredoc body or in a string spanning lines (say "it's"
 # read alone) opens a quote for the rest of that line, so a call after it on
 # the same line is missed.
 #
 # Sibling of this.recursive.validate, same shape: the kernel guard
 # (private.this.tree.tracked.check), the one sweep
 # (private.this.marker.sweep), the verdict on stdout, each violation named by
 # error.log, create.result / return $(result).
 #
 # The DATA below names the commands, it calls none of them.
 # A word is <command> or <command>:<flag letters> (ln:s is ln -s, id:nG is
 # id -nG, su: is su -). Trim a word to drop a rule.
 local commands='mkdir chown chgrp chmod ln:s readlink stat mktemp cmp id:nG id:Gn getent dscl runuser su: docker ssh scp sudo'
 local testCommands='stat readlink cmp id:nG id:Gn getent dscl sudo runuser su: docker ssh scp'
 # <script>=<commands at home there>
 local homes='odocker=docker ossh=ssh,scp user=id,getent,dscl,runuser,su,sudo'
 # Not read: prose, data, tool config, the legacy graveyards, the pre-oosh sh.
 local excluded='docs .claude old restore external osx init/once test/fixtures *.md *.json'
 # CI VM set up before oosh exists (same class as init/oosh).
 excluded="$excluded .github/workflows/macos-test.yml"
 # Pre-existing on dev, out of the heal's scope; a name leaves this list when the file is cleaned.
 excluded="$excluded Install?oosh.command agentRoom backup claudeCode disk hiveMind index log myId ng/c2 odocker os.specific/osx.intel/al2ln os.specific/osx.intel/alias2ln.osx.sh osshLayout otest otmux promote replace scrumMaster snet su/setup templates/user/ooShim templates/user/thisLauncher test/test.backup test/test.osshLayout test/test.platform.shared.boot.invariant test/test.platform.shared.config.invariant test/test.platform.shared.layout.invariant test/test.platform.ssh.layout.invariant test/test.ssh.config.invariant"

 local treeRoot="${1:-$OOSH_DIR}"
 if [ ! -d "$treeRoot" ]; then
   error.log "this.kernel.validate: no such directory: $treeRoot"
   echo "INVALID: no such directory: $treeRoot"
   create.result 2 "no such directory: $treeRoot"
   return $(result)
 fi
 # A sweep that reads nothing must not report OK (T-THIS-KERNEL-VALIDATE-BLIND).
 private.this.tree.tracked.check "$treeRoot" this.kernel.validate || return $(result)

 local anchor='(^|[|;&({`)]|\$\()[[:space:]]*((if|then|else|elif|do|while|until|!|exec|time|command)[[:space:]]+)*(\$\{?SUDO\}?[[:space:]]+)?'
 local list word alternation prodPattern testPattern
 for list in commands testCommands; do
   alternation=""
   for word in ${!list}; do
     case "$word" in
       *:*) word="${word%%:*}[[:space:]]+-[A-Za-z]*${word#*:}[A-Za-z]*" ;;
     esac
     alternation="${alternation:+$alternation|}$word"
   done
   case "$list" in
     commands) prodPattern="${anchor}(${alternation})([[:space:];&|)]|\$)" ;;
     *)        testPattern="${anchor}(${alternation})([[:space:];&|)]|\$)" ;;
   esac
 done
 # read -a, not an unquoted for: *.md must reach git as a pathspec, not be
 # expanded against the current directory first.
 local pathspecs=() paths path
 read -r -a paths <<< "$excluded"
 for path in "${paths[@]}"; do pathspecs+=(":!$path"); done

 # One awk pass over both sweeps: blank the quoted text and the trailing
 # comment, match again, and name the command word. Out: class TAB file TAB
 # line TAB word TAB content; a hit that was only quoted text is dropped.
 local hits
 hits=$( { private.this.marker.sweep "$prodPattern" kernel "$treeRoot" 0 ':!test' "${pathspecs[@]}" | sed 's/^/prod /'
           private.this.marker.sweep "$testPattern" kernel "$treeRoot" 0 'test' "${pathspecs[@]}" | sed 's/^/test /'; } \
   | KERNEL_PROD="$prodPattern" KERNEL_TEST="$testPattern" awk '
     function code(s,   out, i, n, c, top, st) {
       n = 0; st[0] = "c"; out = ""
       for (i = 1; i <= length(s); i++) {
         c = substr(s, i, 1); top = st[n]
         if (top == "s") { if (c == "\047") n--; out = out " "; continue }
         if (top == "d") {
           if (c == "\\") { out = out "  "; i++; continue }
           if (c == "\"") { n--; out = out " "; continue }
           if (c == "$" && substr(s, i + 1, 1) == "(") { st[++n] = "c"; out = out "$("; i++; continue }
           out = out " "; continue
         }
         if (c == "\\") { out = out substr(s, i, 2); i++; continue }
         if (c == "\047") { st[++n] = "s"; out = out " "; continue }
         if (c == "\"") { st[++n] = "d"; out = out " "; continue }
         if (c == "#" && (i == 1 || substr(s, i - 1, 1) ~ /[[:space:]]/)) break
         if (c == "(") { st[++n] = "p"; out = out c; continue }
         if (c == "$" && substr(s, i + 1, 1) == "(") { st[++n] = "c"; out = out "$("; i++; continue }
         if (c == ")" && n > 0 && (top == "c" || top == "p")) { n--; out = out c; continue }
         out = out c
       }
       return out
     }
     {
       scope = $1; class = $2
       match($0, /^[a-z]+ [a-z]+ /); rest = substr($0, RLENGTH + 1)
       file = rest; sub(/:.*/, "", file)
       content = substr(rest, length(file) + 2)
       line = content; sub(/:.*/, "", line)
       content = substr(content, length(line) + 2)
       if (class == "comment") next
       blanked = code(content)
       pattern = (scope == "prod") ? ENVIRON["KERNEL_PROD"] : ENVIRON["KERNEL_TEST"]
       # A case label (`stat)` at the start of its line) names a branch, it
       # calls nothing; the rest of the line can still call: `stat) stat x ;;`.
       # So a label is cut off and the rest is matched again, its `)` the anchor.
       for (guard = 0; guard < 8; guard++) {
         if (!match(blanked, pattern)) next
         word = substr(blanked, RSTART, RLENGTH)
         if (word !~ /\)$/ || word ~ /^\$\(/ || substr(blanked, 1, RSTART - 1) !~ /^[[:space:]]*$/) break
         blanked = substr(blanked, RSTART + RLENGTH - 1)
       }
       if (guard == 8) next
       sub(/^(\$\(|[|;&({`)])/, "", word); sub(/^[[:space:]]+/, "", word)
       while (match(word, /^(if|then|else|elif|do|while|until|!|exec|time|command)[[:space:]]+/)) word = substr(word, RLENGTH + 1)
       sub(/^\$\{?SUDO\}?[[:space:]]+/, "", word)
       sub(/[[:space:];&|)].*$/, "", word)
       printf "%s\t%s\t%s\t%s\t%s\n", class, file, line, word, content
     }')

 local checked=0 exceptions=0 violations=0 home=0
 local class file lineNo content trimmed enclosing homeWords
 while IFS=$'\t' read -r class file lineNo word content; do
   [ -z "$file" ] && continue
   # At home: the script that wraps the command, or a kernel helper of this.
   homeWords=" ${homes} "; homeWords="${homeWords#* ${file}=}"
   if [ "$homeWords" != " ${homes} " ] && case ",${homeWords%% *}," in *",${word},"*) true ;; *) false ;; esac; then
     home=$((home + 1)); continue
   fi
   if [ "$file" = this ]; then
     enclosing=$(awk -v n="$lineNo" 'NR > n { exit } /^[A-Za-z][A-Za-z0-9._]*\(\)/ { f = $0; sub(/\(.*/, "", f) } END { print f }' "$treeRoot/$file" 2>/dev/null)
     case "$enclosing" in private.this.*) home=$((home + 1)); continue ;; esac
   fi
   checked=$((checked + 1))
   [ "$class" = marked ] && { exceptions=$((exceptions + 1)); continue; }
   trimmed="${content#"${content%%[![:space:]]*}"}"
   error.log "this.kernel.validate: $file:$lineNo: $word: $trimmed"
   violations=$((violations + 1))
 done <<< "$hits"

 if [ "$violations" -gt 0 ]; then
   error.log "this.kernel.validate: $violations violation(s); use the kernel helper, odocker, ossh or user (docs/oosh-architecture.md § Kernel helpers), or declare the line with '# kernel-exception: <why>'"
   echo "INVALID: raw kernel commands in $treeRoot — $violations violation(s), $checked checked, $exceptions exception(s), $home at home"
   create.result 1 "kernel commands: violations found"
   return $(result)
 fi
 echo "OK: raw kernel commands in $treeRoot — $checked checked, $exceptions exception(s), $home at home, 0 violations"
 create.result 0 "kernel commands: 0 violations"
 return $(result)
}


