  && [ "$LOG_LEVEL" -gt "1" ]; then
    echo -e "[90mINFO: ${BASH_SOURCE[0]##*/} -> ${BASH_SOURCE[1]##*/}: ${FUNCNAME[0]}:${LINENO}   - ${BASH_SOURCE[@]##*/} >$*${NORMAL}"  >>$LOG_LIVE     
  fi
