private.this.script.load()     # <script> <probeFn> # source $OOSH_DIR/<script> into this shell once, unless <probeFn> is already a function; This is saved and restored around the source; rc 0 when <probeFn> is a function afterwards #
{
 # A predicate (rc only, no create.result): it runs inside completion paths.
 # Lazy, because <script> sources `this` and every consumer (oo, promote, …)
 # may itself be merely sourced by the ooShim or a test. Not this.load: that
 # one CALLS the method and overwrites This (see this.load). Sourcing re-runs
 # this.start, which points This at the sourced file — restore it, or the
 # caller's own dispatch/help would describe the wrong script.
 [ "$(type -t "$2")" = function ] && return 0
 local savedThis="$This"
 [ -f "$OOSH_DIR/$1" ] && source "$OOSH_DIR/$1" >/dev/null 2>&1
 This="$savedThis"
 [ "$(type -t "$2")" = function ]
}

private.this.path.case.get()     # <path> # echo <path> in the file system canonical letter case: its longest existing prefix through osascript on macOS (trailing / dropped), the missing rest appended as given; echo <path> unchanged when osascript is absent or fails #
{
 # A getter consumed as $(...): no create.result. macOS HFS+/APFS is
 # case-insensitive, but git's safe.directory and a link target are strings:
 # /Users/shared and /Users/Shared are one inode, two strings. osascript
 # resolves only a path that exists, so a sharedConfig the install has not
 # made yet came back lowercase (M3): the longest existing prefix is resolved,
 # once, and the missing rest kept (T-CONFIG-SHARED-PATH-CASE-MISSING-CHILD).
 # `[ -e ]` itself is case-insensitive there, so the walk finds the prefix.
 local p="$1" known rest="" r=""
 [ -z "$p" ] && return 1
 known="$p"
 while [ -n "$known" ] && [ ! -e "$known" ] && [ ! -L "$known" ]; do
   case "$known" in
     */*) rest="/${known##*/}$rest"; known="${known%/*}" ;;
     *)   rest="$known$rest"; known="" ;;
   esac
 done
 if [ -n "$known" ] && command -v osascript >/dev/null 2>&1; then
   r=$(osascript -e "POSIX path of (POSIX file \"$known\" as alias)" 2>/dev/null | sed 's:/$::')
 fi
 printf '%s\n' "${r:-$known}$rest"
}

private.this.path.dedup()     #  # de-duplicate PATH in THIS shell by whole segment — first occurrence wins, order kept, empty segments (the CWD, CWE-426) dropped; runs once per source this; pure parameter expansion, no subshell #
{
 # The login PATH line is data and cannot guard itself — before the switch
 # the shared user.env's `export PATH="$HOME/oosh:…:$PATH"`, after it the
 # user's own ~/.config/oosh/user.session.env — so a shell that sources a prepend twice (bashrc + a nested `source this`,
 # a re-login inside tmux) carries the prepend twice. this.init calls it on
 # every `source this`; T-THIS-PATH-DEDUP drives it directly,
 # T-THIS-PATH-NO-GROWTH through a whole cold start.
 #
 # Pure parameter expansion, no `read`/here-string: bash before 5.1 backs a
 # here-string with a TMPDIR temp file, so that form did filesystem I/O on
 # every single `source this` on macOS bash 3.2 and broke outright on a
 # read-only or noexec /tmp during install. NO create.result: a mutator of the
 # caller's PATH, run before `create.result` matters and never as $(...).
 local newPath="" seen=":" rest="$PATH:" seg
 while [ -n "$rest" ]; do
   seg=${rest%%:*}; rest=${rest#*:}
   # An EMPTY segment ("::", a leading or trailing colon) means the current
   # directory — CWE-426, the same hole ticket T8 closed for a literal `.` in
   # config.save's brew-bash line. Dropped here, never preserved. This does NOT
   # shut the hole: a LITERAL `.` segment is a non-empty segment and survives
   # de-duplication untouched, exactly as it did before.
   if [ -n "$seg" ]; then
     case "$seen" in *":$seg:"*) ;; *)
       seen="$seen$seg:"
       newPath="${newPath:+$newPath:}$seg" ;;
     esac
   fi
 done
 # path-exception: a REWRITE of the value already there, not a build — the
 # segments put back are exactly the ones that came in, minus the repeats. A
 # no-op when nothing changed, which is the common case.
 [ "$newPath" = "$PATH" ] || export PATH="$newPath"
 return 0
}


private.this.as.user.preamble.get()     # <username> <targetHome> <sharedOosh> <?umask:022> # echo the bash -c preamble that stands the oosh environment of the TARGET user up before a command runs as them: the umask (022 unless the caller names one), HOME/USER, no leaked anchors, this from the shared tree, its dirs first on PATH #
{
 # The one preamble behind every `private.as.user "$u" bash -c "…"` hop
 # (config.init.user, user.oosh.install). runuser keeps the CALLER's
 # environment, so without this the target inherits root's CONFIG/CONFIG_PATH/
 # OOSH_DIR, and a string that sources "$OOSH_DIR/this" is expanded by the
 # caller — /root/oosh/this, unreadable under a 0700 /root — so every source
 # failed silently and the bashrc heal of another user never ran (T86's
 # sibling, T-THIS-AS-USER-PREAMBLE).
 #
 # OOSH_MODE goes too: the target's branch is where THEIR ~/oosh points,
 # never the caller's (T-THIS-AS-USER-PREAMBLE-NO-MODE).
 # Unsetting the anchors is what lets `this` cold-start from the TARGET's
 # ~/config/user.env (or fall back to their $HOME/oosh); sourcing `this` from
 # <sharedOosh> is what makes that possible before their ~/oosh symlink exists;
 # the explicit PATH prepend is why `user`/`ossh` resolve in that same window.
 # The umask first: runuser and a same-user hop keep the caller's umask —
 # oo heal's clean process runs with 002 for the shared places — so a hop
 # starts from <umask>, 022 unless the caller names one, and a home is never
 # written group-writable by accident (T-THIS-AS-USER-PREAMBLE-UMASK). The
 # target's own `this` then sets 002 only for a member of dev
 # (private.this.umask.apply); a hop whose user is not in dev yet but writes
 # the sharedConfig — root's own hop of a heal — gets 002 from its caller
 # (owner decision 2, T-THIS-PREAMBLE-UMASK). A <umask> that is not octal
 # would be shell text in the string: nothing and rc 1.
 # NO create.result — a getter consumed as $(...), a subshell.
 local username="$1" targetHome="$2" sharedOosh="$3" umaskValue="${4:-022}"
 case "$umaskValue" in [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;; *) return 1 ;; esac
 printf '%s\n' \
   "umask $umaskValue" \
   "export HOME='$targetHome'" \
   "export USER='$username'" \
   "unset CONFIG CONFIG_PATH CONFIG_FILE OOSH_DIR OOSH_MODE" \
   'cd "$HOME" 2>/dev/null' \
   "source '$sharedOosh/this' >/dev/null 2>&1 || exit 1" \
   "export PATH=\"$sharedOosh:$sharedOosh/ng:\$PATH\""  # path-exception: a string executed AS ANOTHER USER, before their user.env has been read
 return 0
}


private.this.folder.entries.copy()     # <from> <to> # copy every entry of <from> (dotfiles included) into <to>, keeping relative paths — never <from>/. itself, whose own mode and owner would land on <to>; rc 1 names the entries that failed #
{
 # One definition, shared by ogit (private.ogit.folder.ignored.restore) and
 # odocker (workspace.seed). Each ENTRY, dotfiles included — never
 # `cp -Rp <from>/. <to>/`: that also copies <from>'s own mode/owner onto <to>
 # (the host dev/ came out drwx------ root:root, 2026-09-25). Plain [ -d ]
 # tests, not `check dir`: check sources this, and this is the kernel.
 local from="$1" to="$2" entry failed=""
 if [ ! -d "$from" ]; then create.result 1 "no such folder: $from"; return $(result); fi
 if [ ! -d "$to" ]; then create.result 1 "no such folder: $to"; return $(result); fi
 for entry in "$from"/* "$from"/.[!.]* "$from"/..?*; do
   [ -e "$entry" ] || continue
   cp -Rp "$entry" "$to/" || failed="$failed ${entry##*/}"
 done
 if [ -n "$failed" ]; then create.result 1 "entries not copied:$failed"; return $(result); fi
 create.result 0 "copied the entries of $from into $to"
 return $(result)
}


private.this.folder.share()     # <dir> <?setgid:yes> # share <dir> (a directory, or one file) with group dev: chgrp dev and g+w on the entries private.this.share.pending.list names and on nothing else — never recursive — and setgid on its directories (setgid yes) so new files inherit the group; an entry another user owns that is right is no error; rc 1 naming the first entry still pending afterwards (wrong and not ours); without a dev group only the setgid part (setgid yes), else nothing, rc 0; $SUDO when <dir> is not ours; never chown #
{
 # The one share primitive: ogit.repo.share (.git), ogit.folder.finish (the
 # work tree), config.init.shared and install state 31 (the sharedConfig),
 # odocker workspace.seed. Never chown (T-STATE-31-CHOWN-NOT-RECURSIVE).
 # Only what is pending is handed to chgrp and chmod: one pending entry used
 # to run chgrp -R / chmod -R over the whole tree, failures silenced
 # (T-THIS-FOLDER-SHARE-PENDING-ONLY), and chmod and chgrp fail on another
 # owner's entry even when nothing would change — root's fast-forward left
 # root-owned, right files in a user's clone (T-THIS-FOLDER-SHARE-NOT-OURS).
 local dir="$1" setgid="${2:-yes}" pending entry sudoWord="" dirMode=g+w what="g+w" devGroup=yes
 local -a dirs=() files=()
 # One file is shared like a folder of one entry (private.ensure.groupWrite).
 if [ ! -e "$dir" ]; then create.result 1 "no such folder or file: $dir"; return $(result); fi
 case "$setgid" in
   yes) dirMode=g+ws; what="g+w, setgid" ;;
   no)  ;;
   *)   create.result 1 "private.this.folder.share: <setgid> is yes or no, got '$setgid'"; return $(result) ;;
 esac
 # No dev group: the group part (chgrp, g+w) has nothing to hand out, but the
 # setgid the layout invariant asks of a repository still does — then
 # pending.list names only the directories without it, and only they get g+s
 # (T-THIS-FOLDER-SHARE-NO-DEV-GROUP).
 if ! private.this.group.exists dev; then
   devGroup=no; dirMode=g+s; what="setgid on its directories (no dev group)"
   if [ "$setgid" = no ]; then create.result 0 "no dev group — $dir left as it is"; return $(result); fi
 fi
 pending=$(private.this.share.pending.list "$dir" "$setgid")
 if [ -n "$pending" ]; then
   # The sharedConfig is developking's: a user's `config init.shared` elevates, as before.
   [ -O "$dir" ] || sudoWord="$SUDO"
   while IFS= read -r entry; do
     [ -n "$entry" ] || continue
     if [ -d "$entry" ]; then dirs+=("$entry"); else files+=("$entry"); fi
   done <<< "$pending"
   # One chgrp and one chmod per batch of pending entries (xargs -0: any name,
   # ARG_MAX). Their rc is not the verdict: an entry another user owns fails
   # them, right or not — what is still pending afterwards is.
   # The group first; what is still pending then wants a mode: g+w only on a
   # file its owner may write (private.this.share.pending.list), so a 0444
   # file of a wrong group gets the group and keeps its mode.
   if [ "$devGroup" = yes ]; then
     printf '%s\0' "${dirs[@]}" "${files[@]}" | xargs -0 $sudoWord chgrp dev 2>/dev/null
     dirs=(); files=()
     while IFS= read -r entry; do
       [ -n "$entry" ] || continue
       if [ -d "$entry" ]; then dirs+=("$entry")
       elif [ -n "$(find "$entry" -prune -perm -200 2>/dev/null)" ]; then files+=("$entry"); fi   # g+w only where the owner may write
     done <<< "$(private.this.share.pending.list "$dir" "$setgid")"
     [ "${#files[@]}" -eq 0 ] || printf '%s\0' "${files[@]}" | xargs -0 $sudoWord chmod g+w 2>/dev/null
   fi
   [ "${#dirs[@]}" -eq 0 ] || printf '%s\0' "${dirs[@]}" | xargs -0 $sudoWord chmod "$dirMode" 2>/dev/null
   pending=$(private.this.share.pending.list "$dir" "$setgid")
 fi
 if [ -n "$pending" ] && [ "$devGroup" = no ]; then
   create.result 1 "could not set setgid in $dir (no dev group): $(echo "$pending" | grep -c .) directories are not $(id -un)'s to change (first: $(echo "$pending" | head -n 1))"
   return $(result)
 fi
 if [ -n "$pending" ]; then
   create.result 1 "could not share $dir with group dev: $(echo "$pending" | grep -c .) entries are not group dev, group-writable$([ "$setgid" = yes ] && echo " and setgid"), and not $(id -un)'s to change (first: $(echo "$pending" | head -n 1))"
   return $(result)
 fi
 if [ "$devGroup" = no ]; then create.result 0 "$dir: $what"; return $(result); fi
 create.result 0 "$dir shared with group dev ($what)"
 return $(result)
}


private.this.group.name.get()     # <gid> # echo the name of the group with number <gid>: getent where present, else /etc/group, dscl on macOS; nothing when there is none #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # Sibling of private.this.group.exists, by number instead of name: the docker
 # socket of a container carries the HOST's group number, and odocker asked a
 # bare getent for it — macOS has none, a minimal image may have none
 # (2026-10-06, T-THIS-GROUP-NAME-GET).
 this.isNumber "$1" || return 1
 case "$OSTYPE" in
   darwin*)
     dscl . -search /Groups PrimaryGroupID "$1" 2>/dev/null | awk 'NR == 1 { print $1 }' ;;
   *)
     if command -v getent >/dev/null 2>&1; then
       getent group "$1" 2>/dev/null | cut -d: -f1
     else
       awk -F: -v gid="$1" '$3 == gid { print $1; exit }' /etc/group 2>/dev/null
     fi ;;
 esac
}


private.this.container.is()     # <?root:/> # rc 0 when this computer is a container: <root>/.dockerenv (Docker) or <root>/run/.containerenv (Podman) exists #
{
 # A predicate (rc only, no create.result), like private.this.group.exists.
 # Nothing in oosh answered "am I a container": odocker installed a Docker
 # engine in a platform container without the host's socket, where none can
 # start (2026-10-06, T-THIS-CONTAINER-IS). <root> lets a test use a fixture.
 local root="${1:-/}"
 root="${root%/}"
 [ -e "$root/.dockerenv" ] || [ -e "$root/run/.containerenv" ]
}


private.this.env.export.line.get()     # <variableName> <value> # echo ONE pure-data env line export variableName=value, the value quoted by bash declare -p so a quote, dollar or backslash reads back as given; nothing and rc 1 when it cannot be one line of pure data: an invalid name, a control character, a command substitution or backtick, an ANSI-C rendering #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT (config
 # renders inside `{ … } >file`, where LOG_DEVICE can be fd1). The ONE rule for
 # "how a value becomes a line of an env file, and which values are refused",
 # in the kernel because both config (private.config.variable.export.line) and
 # log (log.session.save) write env files and log must not load config.
 # Bash quotes (`declare -p` of a local, the named form — the same on 3.2 and
 # 5): a quote, $, backslash or backtick comes out escaped and reads back as
 # given in bash and every POSIX sh (T77 in test.config). Refused, because no
 # single line could hold it as data: a control character (the files are
 # line-oriented; bash 5.1 writes it raw, 5.2 and 3.2 as $'…') and any $'…'
 # rendering (a bashism dash reads literally). T-THIS-ENV-EXPORT-LINE.
 # Refused as well: a command substitution `$(` or a backtick. Escaped they
 # would be harmless, but config.validate rejects every line holding one, and
 # env files are pure data with no exception in the validator — so the writer
 # gives way (T-CONFIG-WRITER-VALIDATOR-AGREE).
 local variableName="$1" value="$2" declaration
 case "$variableName" in ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;; esac
 case "$value" in *[[:cntrl:]]*|*'$('*|*'`'*) return 1 ;; esac
 declaration=$(declare -p value 2>/dev/null) || return 1
 declaration="${declaration#declare -* value=}"
 case "$declaration" in '"'*) ;; *) return 1 ;; esac
 echo "export $variableName=$declaration"
}


private.this.file.same()     # <fileA> <fileB> # rc 0 when both files exist with identical bytes: cmp -s where it exists, else an od byte dump of each compared, which needs no extra package #
{
 # A predicate (rc only, no create.result), like private.this.container.is.
 # cmp is diffutils, which AlmaLinux minimal does not ship: its rc 127 read as
 # "differs", so a file was re-copied on every run and idempotence was lost
 # silently (T-CONFIG-BASHRC-ALL-NO-CMP). The fallback is exact, not a
 # checksum: od (coreutils, busybox, BSD) writes every byte as hex text, so a
 # binary byte or a trailing newline is part of the compared text — $(cat)
 # would drop trailing newlines. Sizes first: unequal files are told apart
 # without reading them (T-THIS-FILE-SAME).
 local a="$1" b="$2"
 [ -f "$a" ] && [ -f "$b" ] || return 1
 if command -v cmp >/dev/null 2>&1; then
   cmp -s "$a" "$b"
   return
 fi
 [ "$(wc -c < "$a")" -eq "$(wc -c < "$b")" ] || return 1
 [ "$(od -An -v -tx1 "$a")" = "$(od -An -v -tx1 "$b")" ]
}


private.this.temp.dir.get()     # <?label:oosh> # echo the canonical path of a new private directory (mode 700) under TMPDIR, else /tmp, named after label; nothing and rc 1 when the label is not a plain name or none can be made #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. The
 # caller owns the directory and removes it. mktemp was called raw in c2,
 # odocker and ossh; test.suite.fixture.make is the test-only twin. Canonical,
 # because on macOS /tmp is /private/tmp and $TMPDIR ends in a slash — a path
 # compared or resolved later must be the physical one (T-THIS-TEMP-DIR-GET).
 # `mktemp -d <template>` is the one spelling GNU, busybox and BSD share.
 local label="${1:-oosh}" base="${TMPDIR:-/tmp}" dir
 case "$label" in *[!A-Za-z0-9._-]*) return 1 ;; esac
 base="${base%/}"
 dir=$(mktemp -d "${base:-/tmp}/$label.XXXXXX" 2>/dev/null) || return 1
 chmod 700 "$dir" 2>/dev/null || { rm -rf "$dir"; return 1; }
 private.this.path.canonical "$dir"
}


private.this.tree.tracked.check()     # <treeRoot> <?caller:sweep> # rc 0 when the tracked files of treeRoot are visible; else an INVALID: verdict on stdout and rc 2 — a tree sweep that reads nothing must never report OK #
{
 # The one guard of the tree sweeps (path.validate, this.anchor.validate,
 # ogit.caller.validate, test.suite.portability.validate,
 # this.recursive.validate). ogit.repo.grep
 # discards stderr, so no repository, a repository with nothing tracked and the
 # "dubious ownership" refusal (root in a container against an oosh-user tree)
 # all come back empty — indistinguishable from a clean tree. A sweep proves it
 # can see the files BEFORE it trusts that it found nothing in them
 # (T-PATH-VALIDATE-BLIND, T-ANCHOR-VALIDATE-BLIND, T-PORTABILITY-BLIND,
 # T-OGIT-ONLY-CALLER-REJECTS). The verdict goes to stdout, like the sweeps.
 local treeRoot="$1" caller="${2:-sweep}"
 if ! private.this.script.load ogit ogit.repo.files.list; then
   error.log "$caller: cannot load ogit.repo.files.list from $OOSH_DIR/ogit"
   echo "INVALID: $treeRoot — not scanned, ogit could not be loaded"
   create.result 2 "ogit could not be loaded: $treeRoot not scanned"
   return $(result)
 fi
 if [ -z "$(ogit.repo.files.list "$treeRoot" | head -1)" ]; then
   error.log "$caller: no tracked file under $treeRoot is visible to git — no repository, nothing tracked, or ownership refused (ogit safeDirectory.ensure). A sweep that reads nothing reports OK, so this is a failure, not a pass."
   echo "INVALID: cannot read $treeRoot through git — no tracked files visible"
   create.result 2 "no tracked file visible under $treeRoot"
   return $(result)
 fi
 create.result 0 "tracked files visible under $treeRoot"
 return $(result)
}


private.this.marker.sweep()     # <pattern> <markerSlug> <treeRoot> <?window:5> <?excludes...> # echo one line per match of pattern in the tracked files of treeRoot: comment, marked or unmarked, a space, then file:line:content; marked is a comment markerSlug-exception: on the line or in the <window> lines above (0: the line only), or markerSlug-exception-file: in the file; a window is all digits, so a caller without one passes its excludes as before; callers run private.this.tree.tracked.check first #
{
 # The one sweep of the five tree validators — path.validate (path),
 # this.anchor.validate (oosh-dir, config-path), ogit.caller.validate (ogit),
 # test.suite.portability.validate (portability), this.recursive.validate
 # (recursive). It owns what they shared:
 # the grep of the TRACKED tree (git grep is one process and sees
 # tracked-but-gitignored files), the comment skip (a line that only TALKS
 # about a construct is not a use of it) and the three marker rules. The
 # marker is anchored to a COMMENT, so it counts only where a human wrote one —
 # otherwise a validator, which names its own marker, would exempt itself. The
 # window is the 5 lines above by default, because these sites often sit
 # inside a heredoc or a `bash -c` string where the marker cannot go on the
 # line; a caller that wants every line to say why itself passes 0
 # (this.kernel.validate, T-THIS-MARKER-SWEEP-WINDOW). A <window> is all
 # digits — no pathspec is — so the five callers that pass none keep theirs.
 # Each caller keeps its OWN rules and summary: what is conforming, the
 # self-assignments, the portability advisories. A getter: stdout, no RESULT.
 local pattern="$1" slug="$2" treeRoot="$3" window=5
 if [ $# -ge 3 ]; then shift 3; else set --; fi
 case "$1" in ''|*[!0-9]*) ;; *) window="$1"; shift ;; esac
 private.this.script.load ogit ogit.repo.grep || return 2
 local matches match file lineNo content trimmed windowFrom class
 matches=$(ogit.repo.grep "$pattern" "$treeRoot" "$@")
 while IFS= read -r match; do
   [ -z "$match" ] && continue
   file="${match%%:*}"
   content="${match#*:}"
   lineNo="${content%%:*}"
   content="${content#*:}"
   trimmed="${content#"${content%%[![:space:]]*}"}"
   case "$trimmed" in '#'*) printf 'comment %s\n' "$match"; continue ;; esac
   class=unmarked
   if printf '%s' "$content" | grep -qE "#[[:space:]]*${slug}-exception:"; then
     class=marked
   elif grep -qE "^[[:space:]]*#[[:space:]]*${slug}-exception-file:" "$treeRoot/$file" 2>/dev/null; then
     class=marked
   elif [ "$window" -gt 0 ] && [ "$lineNo" -gt 1 ]; then
     windowFrom=$((lineNo - window))
     [ "$windowFrom" -lt 1 ] && windowFrom=1
     sed -n "${windowFrom},$((lineNo - 1))p" "$treeRoot/$file" 2>/dev/null \
       | grep -qE "#[[:space:]]*${slug}-exception:" && class=marked
   fi
   printf '%s %s\n' "$class" "$match"
 done <<< "$matches"
 return 0
}


private.this.group.file.get()     #  # echo the group file the last-resort append of private.this.group.create may write: /etc/group; nothing on macOS, where Directory Services ignores that file #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The platform difference of the last resort, as a VALUE in one place: a
 # line appended to /etc/group on macOS is ignored by Directory Services, so
 # there is no file there and the append is not tried (T-THIS-GROUP-CREATE-FAIL).
 # A test points private.this.group.create at a fixture through this getter.
 case "$OSTYPE" in
   darwin*) return 1 ;;
 esac
 echo /etc/group
}


this.recursive.validate()     # <?treeRoot:$OOSH_DIR> # verify every recursive chown/chgrp/chmod in the tracked tree carries a recursive-exception: <why> marker comment on the same line; echo an OK:/INVALID: verdict; rc 1 on any violation, rc 2 when the sweep read nothing #
{
 # THE RULE: a recursive change of owner, group or mode is declared where it
 # is written. Install state 31 changed owner and mode of the whole shared
 # folder — on macOS that is /Users/Shared, the boss's whole workspace. So,
 # like a raw git call carries `# ogit-exception: <why>` (ogit.caller.validate),
 # every recursive chown/chgrp/chmod carries `# recursive-exception: <why>`
 # with a non-empty reason ON THE SAME LINE. Unlike the other tree validators,
 # a marker in the lines above or a file-wide marker does not count: each
 # recursive call names its own reason, next to the folder it walks.
 #
 # Accepted limits: the marker must be on the same line even inside a heredoc
 # or a `bash -c` string; a call through a variable (`CHMOD=chmod; $CHMOD -R`)
 # is not caught — unlike ogit.caller.validate, no assignment is swept for it;
 # and the command word is not tied to command position, so a word "chmod"
 # in an argument followed by an R flag matches too (same as the bare git
 # pattern of ogit.caller.validate).
 #
 # Sibling of ogit.caller.validate and path.validate, same shape: the kernel's
 # one guard (private.this.tree.tracked.check) and one sweep
 # (private.this.marker.sweep), the verdict echoed to stdout (it survives any
 # LOG_LEVEL — the status-output idiom), each violation named by error.log,
 # create.result / return $(result).
 local treeRoot="${1:-$OOSH_DIR}"
 if [ ! -d "$treeRoot" ]; then
   error.log "this.recursive.validate: no such directory: $treeRoot"
   echo "INVALID: no such directory: $treeRoot"
   create.result 2 "no such directory: $treeRoot"
   return $(result)
 fi
 # A sweep that reads nothing must not report OK (T-THIS-RECURSIVE-VALIDATE-BLIND).
 private.this.tree.tracked.check "$treeRoot" this.recursive.validate || return $(result)

 # What a recursive call looks like (T-THIS-RECURSIVE-VALIDATE-FLAGS): the
 # command word (the leading class keeps ochmod, x.chmod and a_chown out),
 # then any words, then a flag word that is --recursive or a short-flag
 # cluster holding R: -R, -Rf, -fR, -HR, -Rv. A flag AFTER the mode or owner
 # counts too, GNU reads options anywhere. Only an uppercase R: lowercase -r
 # is chmod's "remove read", and chown/chgrp have no -r. Excluded on purpose,
 # as in ogit.caller.validate: docs/ test/ .claude/ *.md *.json (prose,
 # fixtures, tool config) and old/ restore/ (the legacy graveyards).
 local command='(^|[^A-Za-z0-9_./-])(chown|chgrp|chmod)'
 local flag='(-[A-Za-z]*R[A-Za-z]*|--recursive)'
 local matches
 matches=$(private.this.marker.sweep "${command}([[:space:]]+[^[:space:];&|#]+)*[[:space:]]+${flag}([[:space:];&|)]|\$)" recursive "$treeRoot" \
             ':!docs' ':!test' ':!.claude' ':!old' ':!restore' ':!*.md' ':!*.json')

 local checked=0 exceptions=0 violations=0
 local hit class match file lineNo content trimmed
 while IFS= read -r hit; do
   [ -z "$hit" ] && continue
   class="${hit%% *}"
   match="${hit#* }"
   file="${match%%:*}"
   content="${match#*:}"
   lineNo="${content%%:*}"
   content="${content#*:}"
   trimmed="${content#"${content%%[![:space:]]*}"}"

   # A line that only TALKS about a recursive call is not one.
   [ "$class" = comment ] && continue
   checked=$((checked + 1))
   # Sanctioned exception: the marker comment with a reason, on this line.
   if [ "$class" = marked ] \
      && printf '%s' "$content" | grep -qE "#[[:space:]]*recursive-exception:[[:space:]]*[^[:space:]]"; then
     exceptions=$((exceptions + 1)); continue
   fi

   error.log "this.recursive.validate: $file:$lineNo: $trimmed"
   violations=$((violations + 1))
 done <<< "$matches"

 if [ "$violations" -gt 0 ]; then
   error.log "this.recursive.validate: $violations violation(s); a recursive owner, group or mode change walks a whole tree. Change only what oosh created, or declare it with '# recursive-exception: <why>' on the same line"
   echo "INVALID: recursive chown/chgrp/chmod in $treeRoot — $violations violation(s), $checked checked, $exceptions exception(s)"
   create.result 1 "recursive calls: violations found"
   return $(result)
 fi
 echo "OK: recursive chown/chgrp/chmod in $treeRoot — $checked checked, $exceptions exception(s), 0 violations"
