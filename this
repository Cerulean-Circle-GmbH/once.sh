  fi
}

create.result() # <processRETURN_VALUE:0> <RESULT:all went well> <option:$1> # creates a process return value and a function RESULT that been be returned in the calling function
# to make create result work, you have to call a SOURCED function
# e.g.  if os.check some.function; then ...
#   if you call 'os check' from th scrip 'os', it cannot return a RESULT since the porcess will end and no RESULT is left...
#   if you call 'os.check' you have to source the script oo before: 
#       source oo
# Then $RESULT will be in the same process and can be read from the calling function
#   otherwise if you call 'os check' you have to call:
#      create.result ERROR_CODE "some RSULT value" save
# <option> can be 'save' then you can retrieve the result with
#      result.load
# in the calling function.
# normaly <option> should always be "$1" to mark the start of the next command
{

  RETURN_VALUE=$1
  shift
  RESULT=$1
  shift
  RETURN=$1
  

  if ! (this.isNumber "$RETURN_VALUE"); then
    export RESULT=$RETURN_VALUE
    RETURN_VALUE=0
  fi
  
  info.log "create.result: $RETURN_VALUE $RESULT"
  if [ "$RETURN" = "save" ]; then    
    shift
    RETURN=$1
    result.save "$@"
    info.log "result saved"
  fi
  info.log "next argument: $RETURN"
  
  # if ! (this.isSourced); then
  #   important.log "show RESULT: $RESULT"
  # fi
}

result() {
  if [ "$1" = "save" ]; then    
    shift
    result.save "$@"
    RETURN=$1
  fi
  if [ -z "$RETURN_VALUE" ]; then
    RETURN_VALUE=0
  fi 
  echo $RETURN_VALUE
}

result.save() # # write RESULT and its metadata to $CONFIG_PATH/result.env, for result.load to read back
{
  export RESULT_RETURN_VALUE=$RETURN_VALUE
  export RESULT=$RESULT

  export RESULT_DATE="$(date)"
  export RESULT_CALLER="${FUNCNAME[2]}"
  export RESULT_CALL_STACK="${FUNCNAME[@]}"
  export RESULT_SOURCE_STACK="${BASH_SOURCE[@]##*/}"
  export RESULT_NEXT_ARGS="$*"
  # `declare -px` WITH THE EXPLICIT NAMES. The old body was
  # `declare -px | grep "RESULT"` — a SUBSTRING match on the WHOLE LINE, so it
  # harvested any exported variable whose NAME merely contained RESULT
  # (test.suite exports TEST_SUITE_RESULT_PATH) and any whose VALUE did. That
  # file is then SOURCED by result.load, so what it picks up is re-assigned in
  # the caller's shell. config.save fixed exactly this class for itself — see
  # its old ` ${name}[_=]` value match, pinned by test/test.config T28.
  #
  # A list, not a sweep: these seven names are exported three lines above, so
  # the set is known exactly and no pattern can be more correct than naming it.
  # The named form is also the one that behaves on bash 3.2 (measured) — see
  # docs/research/2026-09-17-config-save-bash32.md, and result.into below,
  # which has used the named form all along for the neighbouring reason.
  declare -px RESULT RESULT_RETURN_VALUE RESULT_DATE RESULT_CALLER \
              RESULT_CALL_STACK RESULT_SOURCE_STACK RESULT_NEXT_ARGS \
    >$CONFIG_PATH/result.env 2>/dev/null
}

result.cat() { # # logs the $CONFIG_PATH/result.env file
