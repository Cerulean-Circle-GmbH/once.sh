private.this.sudo.prompt.is()     #  # rc 0 when sudo may ask for a password in this process (no -n option of sudo in SUDO and none in the sudo function); the one predicate ogit sudo.rerun and the heal read; silent #
{
 # A predicate: it answers by rc and says nothing. The heal without a terminal
 # sets both facts (oo heal.sudo.ensure): SUDO="sudo -n " and a sudo function
 # that adds -n; either one means a password could not be typed.
 # Only an OPTION of sudo counts: the words after a `sudo` (or a path ending
 # in /sudo) up to the first that is no option — -n, a cluster that holds n
 # before an option taking a value (-u n is the user n), --non-interactive.
 # A `[ -n "$x" ]` elsewhere in the function is no option of sudo
 # (T-THIS-SUDO-PROMPT-IS-OPTION). read -a splits without globbing.
 local text word state=out cluster i letter
 local -a words
 text=" $SUDO $(declare -f sudo 2>/dev/null) "
 text="${text//$'\n'/ }"
