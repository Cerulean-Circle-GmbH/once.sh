private.this.link.target.get()     # <link> # echo the target text of the symlink <link> as it was written, no link followed further; nothing and rc 1 when <link> is no symlink; silent getter #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The one plain readlink: a test or a repair compares a link with the target
 # it should have, as written (relative stays relative, a dangling link has
 # one). The resolved path is private.this.path.canonical. Plain readlink is
 # the same on GNU, BSD and BusyBox (T-THIS-LINK-TARGET-GET).
 [ -L "$1" ] || return 1
 readlink "$1"
}


