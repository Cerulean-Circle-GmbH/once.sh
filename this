private.this.orig.stamp.get()     # <dir> <names...> # echo a YYYYmmdd-HHMMSS stamp for which <dir>/<name>.orig.<stamp> is free for every name, bumped with -<n> when taken; silent getter, rc 1 on missing arguments #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The one stamp behind every "keep it as <name>.orig.<ts>". A second run
 # inside the same second must get a new stamp, or a real entry is moved INTO
 # the earlier backup
 # (private.this.symlink.with.backup, T-THIS-SYMLINK-BACKUP-NEVER-NESTS).
 # The bump is private.this.orig.stamp.free.get, the one loop; this adds the clock.
 local dir="$1"
 [ -n "$dir" ] && [ $# -gt 1 ] || return 1
 shift
 # date is the one clock source; the kernel has no time getter.
 private.this.orig.stamp.free.get "$dir" "$(date +%Y%m%d-%H%M%S)" "$@"
}


private.this.dir.ensure()     # <dir> <?group> <?mode> <?owner> # create only the missing path segments of <dir>, from the first existing ancestor down, and give only those the <owner>, then the <group>, then the <mode>; never touch a directory that existed; $SUDO only where the parent is not writable or the owner is another user, and for the group when the caller is not in it yet; refuses a . or .. segment; RESULT = the created segments or exists; rc 1 when it cannot create #
{
 # The kernel owner of "mkdir with group and mode". Install state 31 created
 # one shared directory and then changed owner and mode of the whole shared
 # folder recursively — on macOS /Users/Shared. This walks up to the first
 # existing ancestor, creates the missing segments top down and sets group and
 # mode on exactly those; a directory that existed is never changed, so no
 # recursion is ever needed. $SUDO (empty for root) only for a segment whose
 # parent the caller cannot write, or whose <owner> is another user — a home
 # for another user (private.user.home.ensure) comes from here, not a raw chown.
 # Owner first, then group, then mode: a chown may clear the setgid bit.
 # A <dir> with a . or .. segment is refused: the walk would create or change
 # something other than what the path names.
 local dir="$1" group="$2" mode="$3" owner="$4"
 if [ -z "$dir" ]; then
   create.result 1 "private.this.dir.ensure requires <dir>"
   error.log "$RESULT"; return $(result)
 fi
 case "/$dir/" in
   */./*|*/../*)
     create.result 1 "private.this.dir.ensure refuses $dir: a . or .. segment"
     error.log "$RESULT"; return $(result) ;;
 esac
 # Repeated and trailing slashes are squeezed, so every segment is one name.
 local twoSlashes=// oneSlash=/
 while :; do
   case "$dir" in *//*) dir="${dir//$twoSlashes/$oneSlash}" ;; *) break ;; esac
 done
 while [ "${#dir}" -gt 1 ] && [ "${dir%/}" != "$dir" ]; do dir="${dir%/}"; done
 # An existing <dir> is most calls: answered before the id lookups
 # (T-THIS-DIR-ENSURE-EXISTS-NO-FORK).
 if [ -d "$dir" ]; then
   create.result 0 "exists"; return $(result)
 fi
 # Who the caller is, from the system: USER is unset under docker exec, su and
 # cron, and is what the kernel itself derives from id -un (bootstrap of this).
 local me myGroups
 me=$(id -un 2>/dev/null)
 # The groups this process has: a user just added to <group> is not in it before
 # the next login (private.user.group.member.pending), so chgrp needs $SUDO.
 myGroups=" $(id -Gn 2>/dev/null) "
 local probe="$dir" missing=()
 while [ -n "$probe" ] && [ ! -e "$probe" ] && [ ! -L "$probe" ]; do
   missing=("$probe" "${missing[@]}")
   case "$probe" in */*) probe="${probe%/*}" ;; *) probe=. ;; esac
 done
 [ -n "$probe" ] || probe=/
 if [ ! -d "$probe" ]; then
   create.result 1 "cannot create $dir: $probe is in the way and is no directory"
   error.log "$RESULT"; return $(result)
 fi
 local seg parent sudo created=""
 for seg in "${missing[@]}"; do
   case "$seg" in */*) parent="${seg%/*}" ;; *) parent=. ;; esac
   [ -n "$parent" ] || parent=/
   sudo=""
   [ -w "$parent" ] || sudo="$SUDO"
   if ! $sudo mkdir "$seg"; then
     # Two callers racing: the other one made it — not ours, so left as it is.
     [ -d "$seg" ] && continue
     local why=""
     [ -z "$sudo" ] && [ ! -w "$parent" ] && why=" (parent not writable, no SUDO)"
     create.result 1 "cannot create $seg$why${created:+ (created: $created)}"
     error.log "$RESULT"; return $(result)
   fi
   created="${created:+$created }$seg"
   if [ -n "$owner" ]; then
     # Once the segment belongs to another user, its group and mode need $SUDO too.
     [ "$owner" = "$me" ] || sudo="$SUDO"
     if ! $sudo chown "$owner" "$seg"; then
       create.result 1 "created $created, but cannot give $seg the owner $owner"
       error.log "$RESULT"; return $(result)
     fi
   fi
   local groupSudo="$sudo"
   case "$myGroups" in *" $group "*) ;; *) groupSudo="$SUDO" ;; esac
   if [ -n "$group" ] && ! $groupSudo chgrp "$group" "$seg"; then
     create.result 1 "created $created, but cannot give $seg the group $group"
     error.log "$RESULT"; return $(result)
   fi
   if [ -n "$mode" ] && ! $sudo chmod "$mode" "$seg"; then
     create.result 1 "created $created, but cannot give $seg the mode $mode"
     error.log "$RESULT"; return $(result)
   fi
 done
 create.result 0 "$created"
 return $(result)
}


private.this.orig.stamp.free.get()     # <dir> <base> <names...> # echo <base>, bumped with -<n> until <dir>/<name>.orig.<stamp> is free for every name; silent getter #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The ONE bump loop of the .orig.<ts> backups: private.this.orig.stamp.get
 # (a clock stamp) and private.this.symlink.with.backup (a given ts) both end
 # here. One stamp is free for every name, so names moved aside together share
 # it; a dangling symlink at a candidate counts as taken.
 local dir="$1" base="$2" ts n=0 name taken
 [ -n "$dir" ] && [ -n "$base" ] && [ $# -gt 2 ] || return 1
 shift 2
 ts="$base"
 while :; do
   taken=0
   for name in "$@"; do
     { [ -e "$dir/$name.orig.$ts" ] || [ -L "$dir/$name.orig.$ts" ]; } && taken=1
   done
   [ "$taken" = 0 ] && break
   n=$((n + 1)); ts="$base-$n"
 done
 echo "$ts"
}


private.this.entry.aside()     # <path> <?ts> <?asideDir:${path%/*}> # move a real file or directory to <asideDir>/<name>.orig.<ts> (stamped and bumped in <asideDir> through private.this.orig.stamp.free.get / orig.stamp.get when <ts> is empty or taken), remove a symlink; never nests, never deletes; <asideDir> must exist; RESULT = the new name or "removed link" / "nothing"; rc 1 on failure #
{
 # The one move-aside: private.this.symlink.with.backup, private.oo.entry.aside
 # (deinstall) and the heal all keep a real entry this way. A real file or
 # directory is only renamed to <path>.orig.<ts>, whole; a symlink is removed,
 # its target untouched; nothing is ever deleted.
 # Never nests (T-THIS-ENTRY-ASIDE): mv of a directory onto an existing
 # directory moves it INTO that directory — the D7 root cause. A taken <ts> is
 # bumped with -<n> (private.this.orig.stamp.free.get); without <ts> the stamp
 # comes from private.this.orig.stamp.get. Accepted limit: a directory created
 # at <path>.orig.<ts> between that probe and the mv still nests — there is no
 # portable mv -T (BSD/macOS mv has none).
 # <asideDir> defaults to the entry's own parent; the heal gives <base>.aside so a
 # broken branch folder is kept BESIDE the base, not inside it. The stamp is
 # probed in the directory the entry lands in.
 local path="$1" ts="$2" asideDir="$3" dir=. aside
 if [ -z "$path" ]; then
   create.result 1 "private.this.entry.aside requires <path>"
   error.log "$RESULT"; return $(result)
 fi
 while [ "${#path}" -gt 1 ] && [ "${path%/}" != "$path" ]; do path="${path%/}"; done
 if [ -n "$asideDir" ]; then
   while [ "${#asideDir}" -gt 1 ] && [ "${asideDir%/}" != "$asideDir" ]; do asideDir="${asideDir%/}"; done
   if [ ! -d "$asideDir" ]; then
     create.result 1 "no aside directory $asideDir — $path left as it is"
     error.log "$RESULT"; return $(result)
   fi
 fi
 if [ -L "$path" ]; then
   if ! rm -f "$path"; then
     create.result 1 "could not remove the symlink $path"
     error.log "$RESULT"; return $(result)
   fi
   create.result 0 "removed link"; return $(result)
 fi
 if [ ! -e "$path" ]; then
   create.result 0 "nothing"; return $(result)
 fi
 case "$path" in */*) dir="${path%/*}" ;; esac
 [ -n "$asideDir" ] && dir="$asideDir"
 if [ -n "$ts" ]; then
   ts=$(private.this.orig.stamp.free.get "${dir:-/}" "$ts" "${path##*/}")
 else
   ts=$(private.this.orig.stamp.get "${dir:-/}" "${path##*/}")
 fi
 aside="$path.orig.$ts"
 [ -n "$asideDir" ] && aside="$asideDir/${path##*/}.orig.$ts"
 if [ -z "$ts" ] || ! mv "$path" "$aside"; then
   create.result 1 "could not preserve $path as $aside"
   error.log "$RESULT"; return $(result)
 fi
 create.result 0 "$aside"
 return $(result)
}


private.this.share.pending.list()     # <dir> <?setgid:yes> # echo every entry under <dir> (itself included) that is not shared with group dev yet, one per line: not group dev or not group-writable while its owner may write it (when a dev group exists), a directory without setgid (setgid yes, with or without a dev group — what private.this.folder.share still sets then); symlinks skipped; nothing when all is shared; silent getter #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # What a share still has to change, so it touches nothing that is right:
 # chmod and chgrp on an entry another user owns fail (EPERM) even when they
 # would change nothing — after root's heal fast-forwarded a user's clone, the
 # user's own repo.share and folder.share failed on every root-written entry
 # (T-THIS-SHARE-PENDING-LIST, T-THIS-FOLDER-SHARE-NOT-OURS,
 # T-OGIT-REPO-SHARE-NOT-OURS). The list private.this.folder.share hands to
 # chgrp and chmod, and nothing else (T-THIS-FOLDER-SHARE-PENDING-ONLY).
 # Octal -perm: 020 group write, 200 owner write, 2000 setgid (BSD and GNU
 # find alike). g+w is asked only of an entry its owner may write: a 0444
 # file is read-only for everyone, and a chmod on another owner's one fails
 # for nothing (T-THIS-SHARE-PENDING-READ-ONLY). <dir> may be one file
 # (private.ensure.groupWrite).
 local dir="$1" setgid="${2:-yes}"
 [ -n "$dir" ] && [ -e "$dir" ] || return 0
 if private.this.group.exists dev; then
   if [ "$setgid" = no ]; then
     find "$dir" ! -type l \( ! -group dev -o \( -perm -200 ! -perm -020 \) \) -print 2>/dev/null
   else
     find "$dir" ! -type l \( ! -group dev -o \( -perm -200 ! -perm -020 \) -o \( -type d ! -perm -2000 \) \) -print 2>/dev/null
   fi
 elif [ "$setgid" != no ]; then
   find "$dir" -type d ! -perm -2000 -print 2>/dev/null
 fi
}


private.this.selfLoop.remove()     # <dir> # remove every symlink directly in <dir> that resolves to <dir> itself — the sharedConfig/sharedConfig an old install left; $SUDO when <dir> is not ours; RESULT names how many #
{
