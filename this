    #   #source $OOSH_DIR/../config/user.env
    #   #config.save


    #   this.path.add "$OOSH_DIR"
    #   this.path.add "$OOSH_DIR/ng"
    #   this.path.add "$OOSH_DIR/external"
    #   this.path.add "$OOSH_DIR/init"
    #   if [ "$USER" = "root" ]; then
    #     this.path.add "$OOSH_DIR/su"
    #   fi
    #   this.path.add "."

    #   if [ -n "$OOSH_CONFIG_NEEDS_SAVE" ]; then
    #     unset OOSH_CONFIG_NEEDS_SAVE
    #     config.save
    #   fi
    #   hash -r
    #   echo "initialising config done: $CONFIG"
    # fi
    # COLD START: no .bashrc ran (cron, `ssh host '~/oosh/oo …'`, sudo -u), so
    # CONFIG is empty — and without boot, `this` is the one place that stands
    # the shell up from ~/config/user.env and its chain (the MacStudio model).
    # CONFIG is set only when the file exists: mid-install it may not yet.
    # The process keeps the LOG_DEVICE and LOG_LIVE it derived above:
    # log.session.env holds the LAST session's tty and would send this
    # process's log lines to another terminal (T-THIS-COLD-START-KEEPS-LOG-DEVICE).
    if [ -z "$CONFIG" ] && [ -f "$CONFIG_PATH/${CONFIG_FILE:-user.env}" ]; then
      export CONFIG="$CONFIG_PATH/${CONFIG_FILE:-user.env}"
    fi
    if [ -f "$CONFIG" ]; then
      local savedLogDevice="$LOG_DEVICE" savedLogLive="$LOG_LIVE"
      source "$CONFIG"
      [ -n "$savedLogDevice" ] && export LOG_DEVICE="$savedLogDevice"
      [ -n "$savedLogLive" ] && export LOG_LIVE="$savedLogLive"
      private.this.path.dedup
    fi
  fi
  if [ -z "$OOSH_PROMPT" ]; then
    export OOSH_STATUS="0: started in shell level: $shellLevel"
