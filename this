  shift

  local len=${#BASH_LINENO[@]}
  local caller=${BASH_SOURCE[$len - 2]##*/}
  #info.log "stack : ${BASH_SOURCE[@]}"
  info.log "script: $0"
  info.log "caller: $caller"

  if (this.functionExists $aFunction); then
    debug.log "this.call: $aFunction $*"
    $aFunction "$@"
    return "$?"
  #else
    #info.log "$aFunction does not exist!"
  fi
  if (this.functionExists $caller.$aFunction); then
    # Prefer compound sub-method if it exists (e.g., oo.mode.stage over oo.mode)
    if [ -n "$1" ] && (this.functionExists $caller.$aFunction.$1); then
      local subMethod=$1
      shift
      debug.log "this.call: $caller.$aFunction.$subMethod $*"
      $caller.$aFunction.$subMethod "$@"
    else
      debug.log "this.call: $caller.$aFunction $*"
      $caller.$aFunction "$@"
    fi
  else
    info.log "$caller.$aFunction does not exist!"
    local aShellScript=$aFunction
    aFunction=$1
    shift

    info.log "aShellScript: $aShellScript"
    info.log "aFunction: $aFunction"
    info.log "next parameter \$1: $1"

    # if [ -z "$aFunction" ]; then
    #   aFunction="$aShellScript"
    #   aShellScript=$(which $caller)
    # fi

    if (this.functionExists $aFunction); then
      debug.log "this.call: $aFunction $* "
      stop.log "$aFunction $*"
      $aFunction "$@"
    else
      if [ -z "$aFunction" ]; then
        aFunction=usage
      fi
      # Guard: check if aShellScript is an actual script before trying this.load
      if [ -n "$(command -v $aShellScript 2>/dev/null)" ]; then
        important.log "this.load: $aFunction $aShellScript"
        if (this.load $aFunction $aShellScript "$@"); then
          debug.log "done this.call: $aShellScript.$aFunction $*"
        else
          problem.log "this.load failed to load $aShellScript from \"$aFunction\": $?"
          return 127
        fi
      else
        # aShellScript is not a real script — it was an unknown method name
        this.methodNotFound "$aShellScript" "$caller"
        return 127
      fi
    fi
  fi
} #2>/dev/null



this.path.add() # <dir> # prepends dir to the PATH of this process, de-duping by whole segment; the login PATH itself is data in the per-user ~/.config/oosh/user.session.env
{
  # A BOOTSTRAP helper, not a PATH builder — the login PATH is data in the
  # user's own ~/.config/oosh/user.session.env, chained last by the shared
  # ~/config/user.env (docs/config.md § The PATH line). The executed-script branch
  # at the bottom of this file uses it to get the oosh directories in front in
  # contexts that have not read user.env.
  #
  # It carried NO signature comment, which made it invisible to
  # test/test.completion.audit and to every usage table while
  # docs/oosh-architecture.md listed it as a public method of `this`. By the
  # Method Structure Standard that made it broken as it stood.
  #
  # RESULT is assigned directly rather than through create.result: this runs at
  # file scope during bootstrap, before $CONFIG_PATH/result.env necessarily has
  # a home to be written to.
  if ! this.functionExists "line.add"; then
    # path-exception: bootstrap — `line` has to be reachable before the
    # pipeline below can run, and user.env has not been read in this context.
    case ":$PATH:" in
      *":$OOSH_DIR:"*) : ;;
      *) export PATH="$OOSH_DIR:$PATH" ;;
    esac
    source $OOSH_DIR/line '' ''
  fi

  # line.remove.exact, not line.remove. line.remove is `grep -v "$1"`, a
  # SUBSTRING match — which is why this used to rewrite "." as "\." before the
  # de-dupe pass: without that escape `grep -v .` deleted the ENTIRE PATH. A
  # whole-line match needs no escaping, so the special case is gone with it.
  # line.unquote, because line.split already returns QUOTED entries.
  # path-exception: the bootstrap prepend itself — see the docstring above.
  PATH="$( echo "$PATH" \
         | line.split ":" \
         | line.unquote \
         | line.remove.exact "$1" \
         | line.prepend "$1" \
         | line.join ":" )"
  export PATH
  RESULT=$PATH
}
