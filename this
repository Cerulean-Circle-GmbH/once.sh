#!/usr/bin/env bash
# echo "entering: ${BASH_SOURCE[0]}"
# echo "remove all echos to preseve output"
# echo ""

export PS4='\e[90m  ${BASH_SOURCE[0]##*/} -> ${BASH_SOURCE[1]##*/}: ${FUNCNAME[0]}:${LINENO}   - ${BASH_SOURCE[@]##*/} \e[0m'
if [ -n "$SH_OPT" ]; then set $SH_OPT; fi # force debug


if [ -z "$LOG_LEVEL" ]; then
  export LOG_LEVEL=3
fi
if [ -z "$LOG_DEVICE" ] || [ ! -w "$LOG_DEVICE" ] || { [ "$LOG_DEVICE" = "/dev/null" ] && [ -t 1 ]; }; then
  if [ -t 1 ] && [ -w "$(tty 2>/dev/null)" ]; then
    export LOG_DEVICE="$(tty)"
  elif [ -w /proc/self/fd/1 ]; then
    export LOG_DEVICE=/proc/self/fd/1
  elif [ -w /dev/tty ]; then
    export LOG_DEVICE=/dev/tty
  else
    export LOG_DEVICE=/dev/null
  fi
fi


if [ -z "$EXPECTED_RETURN_VALUE" ]; then
  export EXPECTED_RETURN_VALUE=1
fi

if [ "$EXPECTED_RETURN_VALUE" -lt 1 ]; then
  export EXPECTED_RETURN_VALUE=1
fi


# THE CLEAN BOOT: `env -i` wipes the environment — the boss's recovery route,
# and what every `user login` does (`env -i su - <user>`) — and oosh constructs
# it again. HOME is the one thing nothing else can supply: left unset,
# CONFIG_PATH degrades to /config and OOSH_DIR to /oosh, and a `user login`
# from an empty shell ran `config save` into /config. Derive it from the OS
# IDENTITY, not the environment: bash's ~user expansion reads the password
# database on macOS and Linux alike (the MacStudio `this`,
# T-THIS-ENV-I-DERIVES-HOME). A shell with HOME set pays one test.
if [ -z "$HOME" ]; then
  derivedHome=$(eval echo ~"$(id -un 2>/dev/null)" 2>/dev/null)
  # reject a failed expansion (a literal ~user when there is no passwd entry)
  case "$derivedHome" in ''|'~'*) derivedHome="" ;; esac
  [ -n "$derivedHome" ] && export HOME="$derivedHome"
  unset derivedHome
fi
# OOSH_DIR is ALWAYS ~/oosh — a constant (docs/config.md § The anchor rule),
# carried by oosh.env as "$HOME/oosh". This is only a fallback for contexts that
# have not read user.env yet (a mid-install sub-shell): same literal value,
# never a BASH_SOURCE/$0 walk, never a resolved physical path.
# path-exception: the same fallback, one line down — without $OOSH_DIR on PATH
# nothing in oosh resolves, and user.env has not been read in these contexts.
if [ -z "$OOSH_DIR" ]; then
  OOSH_DIR="$HOME/oosh"
  PATH="$OOSH_DIR:$PATH"
fi

# Ensure $SUDO is set for ALL oosh contexts. bashrcTemplate exports it
# for interactive shells, but ssh-with-command (e.g. ossh exec.tty) on
# distros without Debian's SSH_SOURCE_BASHRC bash patch (Alpine/musl)
# won't source bashrc — leaving privileged ops like user.create's
# `$SUDO useradd` to run unprivileged and fail with "Permission
# denied". Self-heal here so every oosh script invocation has a
# reliable $SUDO contract regardless of shell-startup quirks.
# Use ${SUDO+x} to distinguish unset from explicitly-empty (root sets
# SUDO="" intentionally; we must not clobber that).
if [ -z "${SUDO+x}" ]; then
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    export SUDO=""
  else
    export SUDO="sudo "
  fi
fi

# Ensure $USER is set for ALL oosh contexts — the same contract as $SUDO.
# Login sets USER; bash does NOT. `env -i bash` — and init/oosh's clean
# re-exec — arrive here with it empty, and install state 13
# (private.check.priviledges.checked) routes root vs user on
# `[ "$USER" = root ]`: an empty USER sent a root install down the user lane.
# Self-heal from the process identity, as $SUDO does above.
if [ -z "$USER" ]; then
  USER=$(id -un 2>/dev/null)
  export USER
fi

private.this.path.stat.get()     # <path> <field> # echo one stat field of the path itself, a symlink not followed: owner, group, uid, gid or mode (octal permission bits); GNU stat format first, else the BSD one, both from one table; nothing and rc 1 for a missing path or an unknown field #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # `stat -c <gnu> … || stat -f <bsd> …` was hand-written six times (config ×3,
 # odocker ×2, user). The platform difference is DATA — the table below — and
 # the try-GNU-then-BSD is written once: GNU and busybox know -c, macOS fails
 # on it and knows -f. Neither follows a symlink by default, so a link is
 # described itself (config.init.check asks about the ~/config link).
 local path="$1" field="$2" gnu bsd value
 [ -e "$path" ] || [ -L "$path" ] || return 1
 case "$field" in
   owner) gnu=%U bsd=%Su ;;
   group) gnu=%G bsd=%Sg ;;
   uid)   gnu=%u bsd=%u ;;
   gid)   gnu=%g bsd=%g ;;
   mode)  gnu=%a bsd=%Lp ;;
   *)     return 1 ;;
 esac
 value=$(stat -c "$gnu" "$path" 2>/dev/null) || value=$(stat -f "$bsd" "$path" 2>/dev/null) || return 1
 [ -n "$value" ] || return 1
 echo "$value"
}

private.this.umask.apply()     #  # umask 002 when this process is in group dev, a multi-user install; else the umask stays as it is #
{
 # Runs at file scope on EVERY `source this`, before anything is written —
 # line.init's colour files, the loggers' result.txt and error.txt, config
 # save — so it is defined and called here, ahead of the rest of the kernel.
 # NO create.result: result.env may have no home yet.
 #
 # Membership is the one signal (owner decision 2, 2026-10-08). A process
 # whose groups lag — a root heal whose own system step created group dev —
 # is not guessed at here: its caller knows, and passes 002 into the hop
 # (private.this.as.user.preamble.get <umask>). Anyone else keeps the umask
 # they came with (T-THIS-UMASK-MEMBERSHIP-ONLY).
 case " $(id -nG 2>/dev/null) " in
   *" dev "*) umask 002 ;;
 esac
 return 0
}

private.this.umask.apply

private.log.install.append() # <prefix> <messageBody> # idempotent guarded append to $LOG_INSTALL: skip silently when LOG_INSTALL is unset OR not writable. <prefix> is the level tag (INFO/CONSOLE/SUCCESS/...); <messageBody> is the message body. Eliminates the 11-site copy-paste of `[ -n "$LOG_INSTALL" ] && [ -w "$LOG_INSTALL" ] && echo -e "..." >>"$LOG_INSTALL" 2>/dev/null` previously duplicated across log + this. Lives in `this` (not `log`) so info.log can reach it during early bootstrap before `log` is sourced. Output byte-identical to the prior pattern (BASH_SOURCE[1] = caller log function file, BASH_SOURCE[2] = user script, FUNCNAME[2] = user function, BASH_LINENO[1] = user line).
{
  [ -n "$LOG_INSTALL" ] && [ -w "$LOG_INSTALL" ] || return 0
  echo -e "$1: ${BASH_SOURCE[1]##*/} -> ${BASH_SOURCE[2]##*/}: ${FUNCNAME[2]}:${BASH_LINENO[1]} > $2" >>"$LOG_INSTALL" 2>/dev/null
}

private.this.device.is.terminal()     # <device> # rc 0 when the log device is terminal-type (unset, stdout or fd1, stderr or fd2, the tty), written by a dup of fd2, never probed, never stdout; the ONE list info.log and log share #
{
 # A predicate: rc only. The ONE list of terminal-type devices (#41): they are
 # written through a dup of fd2 and never probed by log.device — stdout among
 # them, so nothing lands in a $() capture. Created by oo method.new and moved
 # up here, above info.log: the kernel logs before log is loaded, and log's
 # private.log.emit asks the same predicate — the list was spelled in both
 # (T-LOG-TERMINAL-ONE-LIST). Plain case, bash 3.2 clean.
 case "${1:-}" in
   ""|/dev/stdout|/dev/stderr|/proc/self/fd/1|/dev/fd/1|/proc/self/fd/2|/dev/fd/2|/dev/tty) return 0 ;;
 esac
 return 1
}

info.log() {
  private.log.install.append "INFO" "$*"
  if [ "$LOG_LEVEL" -gt "3" ]; then
    # The rule of log's private.log.emit — this is the kernel and runs before
    # log is loaded: a terminal-type device is fd2 by dup (never a reopen,
    # never fd1), a file is appended, an unwritable one falls back to fd2.
    if private.this.device.is.terminal "${LOG_DEVICE:-}"; then
      echo -e "\e[90mINFO> $*\e[0m" >&2
    else
      { echo -e "\e[90mINFO> $*\e[0m" >>"$LOG_DEVICE"; } 2>/dev/null || echo -e "\e[90mINFO> $*\e[0m" >&2
    fi
  fi
}

this.isNumber() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

private.ensure.groupWrite() { # <file...> # give each existing file group dev and g+w where it lacks them, through private.this.folder.share; never sudo; the RESULT of the caller is kept; g+w alone without a dev group
  # The writers (config save, log, c2) call it after every write, c2 inside a
  # completion: so no $SUDO (a completion must not prompt), and RESULT and
  # RETURN_VALUE stay the caller's (T-THIS-ENSURE-GROUP-WRITE).
  # Without a dev group there is no group to give, and g+w is still set, as
  # on dev.
  local f devGroup=yes RESULT="$RESULT" RETURN_VALUE="$RETURN_VALUE" RETURN="$RETURN"
  private.this.group.exists dev || devGroup=no
  for f in "$@"; do
    [ -e "$f" ] || continue
    if [ "$devGroup" = yes ]; then
      SUDO="" private.this.folder.share "$f" no >/dev/null 2>&1
    else
      chmod g+w "$f" 2>/dev/null # kernel-exception: no dev group to share with, g+w as on dev
    fi
  done
  return 0
}

private.this.group.create() { # <groupName> <?gid> # cross-platform create a system group if it does not exist, with number <gid> when given. Idempotent — succeeds silently when the group is already there. Through $SUDO (empty for root). Uses the first that exists of groupadd (RHEL/Debian/most Linux), addgroup (Alpine/busybox-based images), dseditgroup (macOS), once — its failure is the answer; only when none exists a /etc/group append (never on macOS, never a number another group holds).
  # Sibling to private.this.group.exists. Used by install state machine
  # (state 31 step 1) to ensure the `dev` group exists before any
  # user.group.add invocation, and by odocker for the group of the docker
  # socket's number (T-THIS-GROUP-CREATE-GID). On Alma minimal `groupadd` is
  # present; on Alpine 3.x only `addgroup` (busybox) is — neither image ships
  # both; macOS has dseditgroup.
  local name="$1" gid="$2" cmd cmdPath
  if private.this.group.exists "$name"; then
    return 0
  fi
  if [ -n "$gid" ] && ! this.isNumber "$gid"; then
    error.log "private.this.group.create: group number '$gid' is not a number"
    return 1
  fi
  # The FIRST tool that exists is used, once: its failure (a wrong sudo
  # password, no rights) is the answer. Going on to the next one ran Debian's
  # perl addgroup with busybox syntax — a second password prompt and a
  # misparsed command (T-THIS-GROUP-CREATE-FAIL).
  for cmd in groupadd addgroup dseditgroup; do
    # path-exception: a lookup for this one command, PATH itself stays — Debian
    # puts groupadd in /usr/sbin, which is not on a normal user's PATH.
    cmdPath=$(PATH="$PATH:/usr/sbin:/sbin" command -v "$cmd" 2>/dev/null) || continue
    # The one platform difference: how each program spells the number.
    case "$cmd" in
      dseditgroup) $SUDO "$cmdPath" -o create ${gid:+-i "$gid"} "$name" >/dev/null 2>&1 && return 0 ;;
      *)           $SUDO "$cmdPath" ${gid:+-g "$gid"} "$name" >/dev/null 2>&1 && return 0 ;;
    esac
    error.log "private.this.group.create: $cmd could not create group '$name'${gid:+ with number $gid}"
    return 1
  done
  # Last resort, only where no tool exists: <gid>, else the next free GID
  # >=500, appended to the group file. Sufficient for OOSH's needs (just
  # owning the group); login-shell group resolution will pick it up. No group
  # file on macOS (private.this.group.file.get): Directory Services ignores it.
  local groupFile holder
  groupFile=$(private.this.group.file.get)
  if [ -z "$groupFile" ]; then
    error.log "private.this.group.create: cannot create group '$name' — no group tool, and no group file on this system"
    return 1
  fi
  # A given number another group holds is never written a second time.
  if [ -n "$gid" ]; then
    holder=$(private.this.group.name.get "$gid")
    [ -z "$holder" ] && holder=$(grep -E "^[^:]*:[^:]*:${gid}:" "$groupFile" 2>/dev/null | cut -d: -f1 | head -n 1)
    if [ -n "$holder" ]; then
      error.log "private.this.group.create: group number $gid is held by '$holder' — '$name' not created"
      return 1
    fi
  fi
  warn.log "private.this.group.create: neither groupadd, addgroup nor dseditgroup exists — appending to $groupFile"
  if [ -w "$groupFile" ] || [ "$(id -u 2>/dev/null)" = "0" ]; then
    local nextGid="${gid:-500}"
    while [ -z "$gid" ] && grep -qE "^[^:]*:[^:]*:${nextGid}:" "$groupFile" 2>/dev/null; do
      nextGid=$((nextGid + 1))
    done
    echo "$name:x:${nextGid}:" >> "$groupFile" 2>/dev/null && return 0
  fi
  error.log "private.this.group.create: cannot create group '$name' — no groupadd, addgroup or dseditgroup, cannot write $groupFile"
  return 1
}

private.this.group.exists() { # <groupName> # cross-platform check if a system group exists (returns 0 if found)
  # Kernel-level helper so any script can call it without depending on `os`
  # or `user` being sourced. $OSTYPE is a bash builtin — available everywhere.
  # macOS uses dscl (Directory Services); Linux uses getent (NSS) with a
  # /etc/group fallback for minimal images that lack getent.
  case "$OSTYPE" in
    darwin*)
      command -v dscl >/dev/null 2>&1 && dscl . -read /Groups/"$1" >/dev/null 2>&1
      ;;
    *)
      if command -v getent >/dev/null 2>&1; then
        getent group "$1" >/dev/null 2>&1
      else
        grep -qE "^${1}:" /etc/group 2>/dev/null
      fi
      ;;
  esac
}

private.this.path.canonical() { # <path> # echo canonical absolute path; portable across GNU readlink -f and BSD/macOS
  # Tries GNU `readlink -f` first (Linux, macOS 12.3+) then falls back to
  # `cd && pwd -P` for older BSD readlink that lacks -f. For non-existent
  # paths echoes the input unchanged (matches readlink -f semantics on input
  # that exists at the leaf level only).
  local p="$1"
  [ -z "$p" ] && return 1
  local r
  r=$(readlink -f "$p" 2>/dev/null)
  if [ -n "$r" ]; then
    printf '%s\n' "$r"
    return 0
  fi
  if [ -d "$p" ]; then
    r=$(cd "$p" 2>/dev/null && pwd -P) && [ -n "$r" ] && { printf '%s\n' "$r"; return 0; }
  fi
  if [ -L "$p" ]; then
    local target
    target=$(readlink "$p" 2>/dev/null)
    case "$target" in
      /*) r=$(cd "$target" 2>/dev/null && pwd -P) && [ -n "$r" ] && { printf '%s\n' "$r"; return 0; } ;;
      *)  r=$(cd "$(dirname "$p")/$target" 2>/dev/null && pwd -P) && [ -n "$r" ] && { printf '%s\n' "$r"; return 0; } ;;
    esac
  fi
  printf '%s\n' "$p"
}

private.this.host.name.get()     # <?form:full> # echo the host name of this computer: the hostname program when it exists, else the HOSTNAME of bash; form short is the name up to the first dot; nothing and rc 1 for an unknown form or no name #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # Created by oo method.new and moved up here: log's default LOG_NAME needs it,
 # and `this` loads log (through debug, further down) before the kernel's
 # later methods exist. AlmaLinux 9's minimal image has no `hostname` program —
 # in a container the name fell back to "localhost"; bash always sets
 # $HOSTNAME. The short form is cut here, not by `hostname -s`
 # (T-THIS-HOST-NAME-GET, T-CONFIG-HOST-NAME-NO-HOSTNAME, T-LOG-NAME-NO-HOSTNAME).
 local form="${1:-full}" name=""
 case "$form" in full|short) ;; *) return 1 ;; esac
 command -v hostname >/dev/null 2>&1 && name=$(hostname 2>/dev/null)
 [ -n "$name" ] || name="${HOSTNAME:-}"
 [ -n "$name" ] || return 1
 [ "$form" = short ] && name="${name%%.*}"
 echo "$name"
}

private.this.anchor.validate.one() # <anchor> <leaf> <treeRoot> # scan <treeRoot> for assignments of <anchor>; echo the verdict; rc 0 clean / 1 violations
{
  local anchor="$1" leaf="$2" treeRoot="$3"
  # Without ogit there is no scan, and no scan must never read as OK
  # (T-THIS-OGIT-LOAD-PROBE).
  if ! private.this.script.load ogit ogit.repo.grep; then
    error.log "this.anchor.validate: cannot load ogit.repo.grep from $OOSH_DIR/ogit"
    echo "INVALID: $anchor in $treeRoot — not scanned, ogit could not be loaded"
    return 1
  fi
  # ONE scan of the tracked tree (git grep = a single process, and it honours
  # .gitignore). Excluded on purpose: docs/ (prose about the rule), test/
  # (fixtures legitimately point an anchor at a fixture dir), .claude/ and
  # *.md/*.json (tool config and documentation, not runnable oosh code).
  # Marker slug is derived from the variable name, so each anchor gets its own:
  # OOSH_DIR -> "# oosh-dir-exception:", CONFIG_PATH -> "# config-path-exception:".
  # NOT `${anchor,,}`. That is bash 4+, and on macOS /bin/bash 3.2 it is a "bad
  # substitution" — so `this anchor.validate` produced NO VERDICT AT ALL on any
  # macOS shell that had not already been re-pathed to brew bash. A validator
  # that silently declines to validate is worse than none. Found by the 2026-09-17
  # macOS gate, same class as config.save's `${file^^}`; `${slug//_/-}` is bash
  # 3.1 and stays.
  local slug; slug=$(printf '%s' "$anchor" | tr '[:upper:]' '[:lower:]')
  slug="${slug//_/-}"

  # The grep, the comment skip and the markers are the kernel's one sweep.
  local matches
  matches=$(private.this.marker.sweep "(export[[:space:]]+${anchor}=|^[[:space:]]*${anchor}=|\\\$\\{${anchor}:=)" "$slug" "$treeRoot" \
              ':!docs' ':!test' ':!.claude' ':!*.md' ':!*.json')

  local conforming=0 exceptions=0 violations=0
  local hit class match file lineNo content trimmed
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    class="${hit%% *}"
    match="${hit#* }"
    file="${match%%:*}"
    content="${match#*:}"
    lineNo="${content%%:*}"
    content="${content#*:}"
    trimmed="${content#"${content%%[![:space:]]*}"}"

    # A line that only TALKS about the anchor is not an assignment.
    [ "$class" = comment ] && continue

    # Self-assignment (`X=$X`) is a no-op — it appears inside `config`'s and
    # `test.suite`'s usage banners, where a marker comment would be PRINTED to
    # the user. It cannot violate the rule, so it is not an assignment site.
    case "$trimmed" in
      "${anchor}=\$${anchor}" | "${anchor}=\"\$${anchor}\"") continue ;;
    esac

    # Sanctioned exception: marked on the line itself, in the few lines just
    # above, or file-wide (private.this.marker.sweep).
    if [ "$class" = marked ]; then
      exceptions=$((exceptions + 1)); continue
    fi

    # Conforming: the constant, and nothing else. `"$HOME/<leaf>"` /
    # `$HOME/<leaf>` / `~/<leaf>` (a BARE tilde expands; a quoted one does not).
    # A `pwd -P`, a `readlink -f`, a BASH_SOURCE/$0 walk or any physical path
    # is a violation.
    if printf '%s' "$trimmed" \
       | grep -qE "^(export[[:space:]]+)?${anchor}=(\"\\\$HOME/${leaf}\"|\\\$HOME/${leaf}|~/${leaf})[[:space:]]*\$"; then
      conforming=$((conforming + 1)); continue
    fi
    if printf '%s' "$trimmed" \
       | grep -qE "^:[[:space:]]+\\\$\\{${anchor}:=(\"\\\$HOME/${leaf}\"|\\\$HOME/${leaf}|~/${leaf})\\}[[:space:]]*\$"; then
      conforming=$((conforming + 1)); continue
    fi

    error.log "this.anchor.validate: $file:$lineNo does not set $anchor to ~/$leaf: $trimmed"
    violations=$((violations + 1))
  done <<< "$matches"

  if [ "$violations" -gt 0 ]; then
    error.log "this.anchor.validate: $anchor — $violations violation(s); it is always \$HOME/$leaf (see ${YELLOW}docs/config.md${NORMAL} § The anchor rule). Resolve physical paths at point of use with private.this.path.canonical, or mark a genuine exception with '# ${slug}-exception: <reason>'"
    echo "INVALID: $anchor in $treeRoot — $violations violation(s), $conforming conforming, $exceptions exception(s)"
    return 1
  fi
  echo "OK: $anchor in $treeRoot — $conforming conforming, $exceptions exception(s), 0 violations"
  return 0
}

this.anchor.validate() # <?anchor:all> <?treeRoot:$OOSH_DIR> # verify every assignment of a path anchor (all|OOSH_DIR|CONFIG_PATH) in the tree is its ~/… constant; rc 1 + report on any violation
{
  # THE RULE (docs/config.md § The anchor rule): the per-user path anchors are ALWAYS the symlink
  # in the user's home — OOSH_DIR is ~/oosh, CONFIG_PATH is ~/config — written
  # "$HOME/…" because a quoted tilde does not expand. They are therefore
  # CONSTANTS: switching branches or re-pointing the shared tree moves only what
  # the symlink points AT. Code that needs the PHYSICAL directory resolves it at
  # point of use with private.this.path.canonical; it must never be baked in.
  #
  # Shaped like config.validate / context.validate: one tree scan per anchor, a
  # verdict echoed to stdout (so it survives any LOG_LEVEL — the status-output
  # idiom), create.result / return $(result).
  local anchor="${1:-all}" treeRoot="${2:-$OOSH_DIR}"
  if [ ! -d "$treeRoot" ]; then
    error.log "this.anchor.validate: no such directory: $treeRoot"
    echo "INVALID: no such directory: $treeRoot"
    create.result 2 "no such directory: $treeRoot"
    return $(result)
  fi
  # A sweep that reads nothing must not report OK (T-ANCHOR-VALIDATE-BLIND).
  private.this.tree.tracked.check "$treeRoot" this.anchor.validate || return $(result)

  local rc=0 verdicts=""
  local pair name leaf
  for pair in "OOSH_DIR:oosh" "CONFIG_PATH:config"; do
    name="${pair%%:*}"
    leaf="${pair##*:}"
    [ "$anchor" = "all" ] || [ "$anchor" = "$name" ] || continue
    verdicts="${verdicts}$(private.this.anchor.validate.one "$name" "$leaf" "$treeRoot")"$'\n'
    [ $? -eq 0 ] || rc=1
  done

  if [ -z "$verdicts" ]; then
    error.log "this.anchor.validate: unknown anchor '$anchor' — use all, OOSH_DIR or CONFIG_PATH"
    echo "INVALID: unknown anchor: $anchor"
    create.result 2 "unknown anchor: $anchor"
    return $(result)
  fi
  printf '%s' "$verdicts"
  if [ "$rc" -ne 0 ]; then
    create.result 1 "$anchor: violations found"
    return $(result)
  fi
  create.result 0 "$anchor: 0 violations"
  return $(result)
}
this.anchor.validate.completion.anchor() { echo "all"; echo "OOSH_DIR"; echo "CONFIG_PATH"; }
this.anchor.validate.completion.treeRoot() { echo "$OOSH_DIR"; }

this.oosh.dir.validate() # <?treeRoot:$OOSH_DIR> # verify every OOSH_DIR assignment in the tree is the constant ~/oosh; rc 1 + report on any violation
{
  this.anchor.validate OOSH_DIR "$1"
  return $(result)
}
this.oosh.dir.validate.completion.treeRoot() { echo "$OOSH_DIR"; }

this.config.path.validate() # <?treeRoot:$OOSH_DIR> # verify every CONFIG_PATH assignment in the tree is the constant ~/config; rc 1 + report on any violation
{
  this.anchor.validate CONFIG_PATH "$1"
  return $(result)
}
this.config.path.validate.completion.treeRoot() { echo "$OOSH_DIR"; }

private.this.symlink.with.backup()     # <linkPath> <target> <?ts> # ensure <linkPath> is a symlink to <target>; keep a pre-existing real entry as <linkPath>.orig.<ts> (private.this.orig.stamp.free.get bumps a taken ts, private.this.orig.stamp.get stamps when no ts), never nested; a relink logs the old target; idempotent; fails loud on every step #
{
  # Shared by state 31's private.oo.user.shared.symlinks.ensure (oo) and
  # config.init.user (config). Both want the same convergence: end with a
  # symlink at <linkPath> pointing to <target>, never silently overwrite a
  # real entry, never collide with a pre-existing .orig.<ts> (the macstudio
  # `.initial` collision bug — see commit 4e1bd9f).
  #
  # Behaviour:
  #   - <linkPath> is already a symlink to <target>     → no-op (return 0)
  #   - <linkPath> is a stale symlink to something else → info.log the old target, rm + relink
  #   - <linkPath> is a real entry (dir/file)           → mv to <linkPath>.orig.<ts>, then link
  #   - <linkPath> is absent                            → link
  #
  # Never nests (T-THIS-SYMLINK-BACKUP-NEVER-NESTS): the real entry is kept by
  # private.this.entry.aside, which bumps a taken <ts> and stamps when there is
  # none — D7 was a second real ~/config moved INTO config.orig.<ts>. Its
  # accepted limit (a race between the probe and the mv) applies here too.
  #
  # Each step fails loud (no `2>/dev/null` suppression on the operations
  # we depend on for convergence). Caller checks the return code.
  local linkPath="$1"
  local target="$2"
  local ts="$3"
  if [ -z "$linkPath" ] || [ -z "$target" ]; then
    create.result 1 "private.this.symlink.with.backup requires <linkPath> <target>"
    error.log "$RESULT"
    return $(result)
  fi
  if [ -L "$linkPath" ]; then
    local oldTarget
    oldTarget=$(readlink "$linkPath")
    if [ "$oldTarget" = "$target" ]; then
      create.result 0 "unchanged"; return $(result)
    fi
    # The user package reads this trace (T-THIS-SYMLINK-BACKUP-RELINK-LOGGED).
    info.log "relinked $linkPath (was → $oldTarget)"
    if ! rm -f "$linkPath"; then
      create.result 1 "could not remove stale symlink $linkPath"
      error.log "$RESULT"; return $(result)
    fi
  elif [ -e "$linkPath" ]; then
    # The one move-aside: stamped, bumped, never nested.
    private.this.entry.aside "$linkPath" "$ts" >/dev/null || return $(result)
  fi
  if ! ln -s "$target" "$linkPath"; then
    create.result 1 "could not symlink $linkPath → $target"
    error.log "$RESULT"; return $(result)
  fi
  create.result 0 "linked $linkPath → $target"
  return $(result)
}

this.functionExists() {

  local startFunc="$1"
  shift
  RETURN=$1

  if [ "$(type -t $startFunc)" = "function" ]; then
    info.log "$startFunc exists"
    return 0
  else
    info.log "$startFunc does not exist"
    return 1
  fi
} 2>/dev/null

this.function.partial() # <newName> <existingName> <firstArg> # define <newName>() as a wrapper that calls <existingName> with <firstArg> closured in front of any args. Replaces ad-hoc `source /dev/stdin <<HEREDOC` patterns for runtime delegate generation; sets RESULT to the signature of the new function
{
  local newName="$1"
  local existingName="$2"
  local firstArg="$3"

  if [ -z "$newName" ] || [ -z "$existingName" ] || [ -z "$firstArg" ]; then
    create.result 1 "this.function.partial requires <newName> <existingName> <firstArg>"
    error.log "$RESULT"
    return $(result)
  fi

  source /dev/stdin <<HEREDOC
$newName() { $existingName "$firstArg" "\$@"; }
HEREDOC

  create.result 0 "defined $newName() => $existingName $firstArg \$@"
  return $(result)
}

