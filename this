case "${0##*/}" in
  "init"|"oosh"|"log"|"this")
    #source $OOSH_DIR/loop
    #LOG_LEVEL=6
    # Entering oosh (`this`, `log` started from any shell, an empty one
    # included) writes only the user's OWN user.session.env — never the
    # SHARED env files of every user (T-THIS-START-METHOD) — and BEFORE the
    # directories below go on PATH: they serve this process only, and a save
    # after them froze ~/oosh/init and ~/oosh/external into every later login
    # PATH (T-THIS-START-SESSION-PATH). Not while `log` is still loading: log
    # sources this before it defines console.log …, and the save
    # needs the full log API.
    if [ -n "$OOSH_CONFIG_NEEDS_SAVE" ] && this.functionExists console.log; then
      case "${0##*/}" in
        log|this)
          unset OOSH_CONFIG_NEEDS_SAVE
          source $OOSH_DIR/config
          config.session.save >/dev/null
        ;;
      esac
    fi
    this.path.add "$OOSH_DIR/external"
    this.path.add "$OOSH_DIR/init"
    # `this.path.add "."` was here. CWE-426, untrusted search path: because each
    # call PREPENDS, "." landed fourth — ahead of /usr/local/bin, /usr/bin and
    # /bin — whenever `this`, `log`, `init` or `oosh` was EXECUTED, which
    # includes the whole install run (init/oosh has $0 of "oosh"). The hijack
    # was silent: oosh own tools still resolved from $OOSH_DIR while every
    # git, curl, tar and sudo they shelled out to came from whatever directory
    # the user last cd'd into. Root got the same treatment via $OOSH_DIR/su.
    this.path.add "$OOSH_DIR"
    this.path.add "$OOSH_DIR/ng"

    if [ "$USER" = "root" ]; then
      this.path.add "$OOSH_DIR/su"
    fi

    if [ -n "$OOSH_CONFIG_NEEDS_SAVE" ]; then
      unset OOSH_CONFIG_NEEDS_SAVE
      # The install (init|oosh — `this` and `log` saved above) writes the
      # whole config, with the PATH it runs on. Same log-API rule as above.
      if this.functionExists console.log; then
        source $OOSH_DIR/config
        config.save
      fi
    fi
  ;;
  "config"|"loop")
    info.log "  running ${0##*/}"
  ;;
  *)
    info.log "  running unknown ${0##*/}"
  ;;
esac






