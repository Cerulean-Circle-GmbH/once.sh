  # ~/.config/oosh/user.session.env (chained last by the shared user.env), or,
  # before the switch, the shared user.env's `…:$PATH` prepend: every re-source
  # (.bashrc, then a nested `source this`) would add the prepend again. Every
  # `source this` passes here, so this is where PATH loses its repeats.
  private.this.path.dedup
  # Ensure CONFIG_PATH is set — needed by state machine and other file-based operations
  : ${CONFIG_PATH:=$HOME/config}
  export CONFIG_PATH
  # The per-user (NON-shared) oosh dir is always $HOME/.config/oosh — the home of
  # per-user/per-session state (log.session.env, log.live.out, oo's
  # mode-env.bash / oo-func.bash). CONFIG_PATH usually symlinks to the shared
  # sharedConfig; this one never does. No variable names it any more: it was
  # a constant pretending to be a setting (removed 2026-10-01, T44).
  if [ -n "$CONFIG" ]; then
    info.log "inititlized"
    if [ -f "$CONFIG" ]; then
      if ! (this.isSourced); then
        # Preserve current PATH and LOG_LIVE — config may contain stale
        # values from a different user or install phase (e.g. root's PATH
        # saved during install; a stale LOG_LIVE). PATH comes from the user's
        # own ~/.config/oosh/user.session.env (chained by ~/config/user.env)
        # and this.path.add; LOG_LIVE is re-anchored to the
        # current user's $HOME/.config/oosh by log's top-level each shell
        # — same anchor must hold across mid-session $CONFIG re-sources or
        # console.log starts writing to another user's directory and hits
        # "Permission denied".
        # (Write-side complement: config.save keeps LOG_LIVE — and LOG_NAME,
        # LOG_DEVICE — out of the shared log.env; they live only in each user's
        # log.session.env. See private.config.variables.list.)
        # path-exception: SAVE AND RESTORE across a mid-session `source "$CONFIG"`,
        # not a write — the value put back is the one that was there.
        local _savedPath="$PATH" _savedLogLive="$LOG_LIVE"
        source "$CONFIG"
        export PATH="$_savedPath"
        [ -n "$_savedLogLive" ] && export LOG_LIVE="$_savedLogLive"
      fi
    fi
    return 0
  fi
  #set -x
  let shellLevel=$SHLVL-1
  let ooShellLevel=$SHLVL+2

  #export PS1="[oosh $ONCE_SSH_CONFIG_HOST] $PS1"
  if ! [ "${0##*/}" = "config" ]; then
    # if [ -z "$CONFIG" ]; then
    #   echo "no config found...initialising it: $OOSH_DIR/../config"
    #   #source $OOSH_DIR/../config/user.env
    #   #config.save


    #   this.path.add "$OOSH_DIR"
    #   this.path.add "$OOSH_DIR/ng"
    #   this.path.add "$OOSH_DIR/external"
    #   this.path.add "$OOSH_DIR/init"
    #   if [ "$USER" = "root" ]; then
    #     this.path.add "$OOSH_DIR/su"
    #   fi
    #   this.path.add "."

    #   if [ -n "$OOSH_CONFIG_NEEDS_SAVE" ]; then
    #     unset OOSH_CONFIG_NEEDS_SAVE
    #     config.save
    #   fi
    #   hash -r
    #   echo "initialising config done: $CONFIG"
    # fi
    # COLD START: no .bashrc ran (cron, `ssh host '~/oosh/oo …'`, sudo -u), so
    # CONFIG is empty — and without boot, `this` is the one place that stands
    # the shell up from ~/config/user.env and its chain (the MacStudio model).
    # CONFIG is set only when the file exists: mid-install it may not yet.
    # The process keeps the LOG_DEVICE and LOG_LIVE it derived above:
    # log.session.env holds the LAST session's tty and would send this
    # process's log lines to another terminal (T-THIS-COLD-START-KEEPS-LOG-DEVICE).
    if [ -z "$CONFIG" ] && [ -f "$CONFIG_PATH/${CONFIG_FILE:-user.env}" ]; then
      export CONFIG="$CONFIG_PATH/${CONFIG_FILE:-user.env}"
    fi
    if [ -f "$CONFIG" ]; then
      local savedLogDevice="$LOG_DEVICE" savedLogLive="$LOG_LIVE"
      source "$CONFIG"
      [ -n "$savedLogDevice" ] && export LOG_DEVICE="$savedLogDevice"
      [ -n "$savedLogLive" ] && export LOG_LIVE="$savedLogLive"
      private.this.path.dedup
    fi
  fi
  if [ -z "$OOSH_PROMPT" ]; then
    export OOSH_STATUS="0: started in shell level: $shellLevel"
