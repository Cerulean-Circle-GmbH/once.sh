    echo -e "\e[90mINFO> $*\e[0m" >>$LOG_DEVICE ## normal
  fi
}

this.isNumber() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

this.isEmpty() {
  # True (rc 0) if $1 is empty or contains only whitespace (space/tab/newline).
  # Single-source predicate for empty-payload guards (Tron P0 2026-05-12 LATE):
  # used by otmux.send / send.smart / send.verified and hiveMind.send /
  # send.message / agent.send to no-op rather than deliver bare prefix.
  [[ "$1" =~ ^[[:space:]]*$ ]]
}

# ── SC-E.2 Ingress identifier predicates (DRY triple-defense Pattern P3) ────
# Format validation (layer "a") for caller-supplied identifiers. Pair with
# pipe-safe check (this.isPipeSafe) and existence check (otmux has / file
# grep) at every public ingress per task-sc-e.1-findings.md.

this.isPaneTarget() {
  # True if $1 is a tmux pane reference. Accepts canonical
  # session:window.pane or raw pane id %N.
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_.-]*:[0-9]+\.[0-9]+$ ]] || [[ "$1" =~ ^%[0-9]+$ ]]
}

this.isSessionName() {
  # True if $1 is a valid tmux session name (alphanumeric / _ / . / -).
  # Must start with alphanumeric or underscore (tmux convention).
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]
}

this.isRoleName() {
  # True if $1 is a plausible agent role name. Conservative bounds: starts with
  # a letter, alphanumeric + dots/dashes/underscores, length 1..40. Rejects
  # prompts ("Read", "You") indirectly via length, but a separate prompt-leak
  # guard exists in private.hiveMind.live.discover for harder cases.
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9._-]{0,39}$ ]]
}

this.isUuid() {
  # True if $1 is a canonical 36-char UUID (Claude session ids).
  [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
}

this.isPipeSafe() {
  # True if $1 contains no pipe, no newline. Use to reject delimiter-corrupting
  # input before appending to env files (3-field pipe-separated rows).
  [[ "$1" != *"|"* && "$1" != *$'\n'* ]]
}

this.isSshHost() {
  # True if $1 is a plausible SSH config alias (alphanumeric + dots/dashes/underscores).
  # SC-E.2 P3: prevents command injection when sshHost flows to `ssh "$host"` —
  # rejects shell metacharacters, spaces, semicolons, backticks, $().
  # Length capped at 64 (longest reasonable hostname or alias).
  [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]]
}

private.this.resolve.fundamentals() {
  # Canonical resolution of HOME, OOSH_DIR, CONFIG_PATH, OOSH_MODE from BASH_SOURCE.
  # Symlink-safe (cd -P). No $HOME/oosh guess. Called by this.init + config.init.
  # Sets and exports all three vars.

  # HOME: resolve if missing (env -i, cron, minimal container)
  : ${HOME:=$(eval echo ~$(id -un 2>/dev/null || echo root))}
  export HOME

  # OOSH_DIR: resolve from the 'this' script's own location (BASH_SOURCE chain)
  local scriptPath=""
  local i
  for ((i=${#BASH_SOURCE[@]}-1; i>=0; i--)); do
    local candidate="${BASH_SOURCE[$i]}"
    [ -z "$candidate" ] && continue
    local candidateDir
    candidateDir=$(cd -P "$(dirname "$candidate")" 2>/dev/null && pwd)
    [ -z "$candidateDir" ] && continue
    if [ -f "$candidateDir/this" ] && [ -f "$candidateDir/config" ]; then
      scriptPath="$candidateDir"
      break
    fi
  done
  if [ -z "$scriptPath" ]; then
    # Last resort: which this (on PATH)
    local whichThis
    whichThis=$(which this 2>/dev/null)
    [ -n "$whichThis" ] && scriptPath=$(cd -P "$(dirname "$whichThis")" 2>/dev/null && pwd)
  fi
  if [ -n "$scriptPath" ]; then
    OOSH_DIR="$scriptPath"
  fi
  export OOSH_DIR

  # CONFIG_PATH: follow ~/config symlink canonically
  if [ -L "$HOME/config" ]; then
    CONFIG_PATH=$(cd -P "$HOME/config" 2>/dev/null && pwd)
  else
    CONFIG_PATH="${HOME}/config"
  fi
  export CONFIG_PATH

  # OOSH_MODE: from git branch in OOSH_DIR
  local branch
  branch=$(cd "$OOSH_DIR" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null)
  case "$branch" in
    dev|dev.*) OOSH_MODE="dev" ;;
    test/*) OOSH_MODE="macos" ;;
    main|master) OOSH_MODE="prod" ;;
    *) OOSH_MODE="${branch:-unknown}" ;;
  esac
  export OOSH_MODE
}

private.this.selfheal() {
  # Auto-repair polluted user.env via harvest-resolve-merge. Always succeeds.
  [ -z "$CONFIG" ] || [ ! -f "$CONFIG" ] && return 0
  this.functionExists config.save || return 0
  local _line _hasPollution=""
  while IFS= read -r _line; do
    [ -z "$_line" ] && continue
    [[ "$_line" == "#"* ]] && continue
    [[ "$_line" =~ ^(export|declare)[[:space:]] ]] && continue
    [[ "$_line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue
    [[ "$_line" =~ ^source[[:space:]].*\.env ]] && continue
    [[ "$_line" =~ ^\.[[:space:]].*\.env ]] && continue
    _hasPollution="yes"
    break
  done < "$CONFIG"
  [ "$_hasPollution" = "yes" ] && config.save
  return 0
}

this.functionExists() {

  local startFunc="$1"
  shift
  RETURN=$1

  if [ "$(type -t $startFunc)" = "function" ]; then
    info.log "$startFunc exists"
    return 0
  else
    info.log "$startFunc does not exist"
    return 1
  fi
} 2>/dev/null

if (this.functionExists this.load); then
  info.log "this was already sourced"
  return 0
fi

this.load() { # <aFunction> <aShellScript> # loads <aFunction> from a <aShellScript>
  local aFunction=$1
  shift
  if [ -n "$1" ]; then
    local fullQualifiedScript="$(which $1)"
    local aShellScript=$(basename $1)
    shift
  else
    error.log "this.load: No script name provided!"
    return 1
  fi

  if (this.functionExists $aShellScript.$aFunction); then
    info.log "$aShellScript was already sourced"
  else
    if [ -z "$fullQualifiedScript" ]; then
      warn.log "Please check \$PATH: $PATH"
      fullQualifiedScript="$aShellScript"
    fi
    info.log "sourcing $fullQualifiedScript $aShellScript.$aFunction $@"
    source $fullQualifiedScript
    This=$fullQualifiedScript
  fi
  if ! (this.functionExists $aShellScript.$aFunction); then
    if (this.functionExists private.$aShellScript.$aFunction); then
      error.log "$aFunction is a private method of $aShellScript — not callable from CLI"
    else
      error.log "Unknown method: $aShellScript $aFunction"
    fi
    return 1
  fi
  $aShellScript.$aFunction "$@"
  #stop.log "loaded and executed $aShellScript.$aFunction"
  RETURN=$1
  return "$(result save)"
}

