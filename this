private.this.folder.entries.copy()     # <from> <to> # copy every entry of <from> (dotfiles included) into <to>, keeping relative paths — never <from>/. itself, whose own mode and owner would land on <to>; rc 1 names the entries that failed #
{
 # One definition, shared by ogit (private.ogit.folder.ignored.restore) and
 # odocker (workspace.seed). Each ENTRY, dotfiles included — never
 # `cp -Rp <from>/. <to>/`: that also copies <from>'s own mode/owner onto <to>
 # (the host dev/ came out drwx------ root:root, 2026-09-25). Plain [ -d ]
 # tests, not `check dir`: check sources this, and this is the kernel.
 local from="$1" to="$2" entry failed=""
 if [ ! -d "$from" ]; then create.result 1 "no such folder: $from"; return $(result); fi
 if [ ! -d "$to" ]; then create.result 1 "no such folder: $to"; return $(result); fi
 for entry in "$from"/* "$from"/.[!.]* "$from"/..?*; do
   [ -e "$entry" ] || continue
   cp -Rp "$entry" "$to/" || failed="$failed ${entry##*/}"
 done
 if [ -n "$failed" ]; then create.result 1 "entries not copied:$failed"; return $(result); fi
 create.result 0 "copied the entries of $from into $to"
 return $(result)
}


private.this.folder.share()     # <dir> # share <dir> with group dev: private.ensure.sharedTree (chgrp dev, g+w) plus setgid on every directory so new files inherit the group; rc 0 without a dev group; never chown #
{
 # One definition, shared by ogit (ogit.folder.finish) and odocker
 # (workspace.seed). private.ensure.sharedTree deliberately sets no SGID —
 # sharedConfig relies on its writers calling private.ensure.groupWrite — but a
 # NEW folder under the shared tree needs setgid dirs so that files created
 # later inherit group dev. Never chown (T-STATE-31-CHOWN-NOT-RECURSIVE).
 local dir="$1"
 if [ ! -d "$dir" ]; then create.result 1 "no such folder: $dir"; return $(result); fi
 if ! private.this.group.exists dev; then create.result 0 "no dev group — $dir left as it is"; return $(result); fi
 if ! private.ensure.sharedTree "$dir" >/dev/null 2>&1 || ! find "$dir" -type d -exec chmod g+s {} + 2>/dev/null; then
   create.result 1 "could not share $dir with group dev"; return $(result)
 fi
 create.result 0 "$dir shared with group dev (g+w, setgid)"
 return $(result)
}


private.this.group.name.get()     # <gid> # echo the name of the group with number <gid>: getent where present, else /etc/group, dscl on macOS; nothing when there is none #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # Sibling of private.this.group.exists, by number instead of name: the docker
 # socket of a container carries the HOST's group number, and odocker asked a
 # bare getent for it — macOS has none, a minimal image may have none
 # (2026-10-06, T-THIS-GROUP-NAME-GET).
 this.isNumber "$1" || return 1
 case "$OSTYPE" in
   darwin*)
     dscl . -search /Groups PrimaryGroupID "$1" 2>/dev/null | awk 'NR == 1 { print $1 }' ;;
   *)
     if command -v getent >/dev/null 2>&1; then
       getent group "$1" 2>/dev/null | cut -d: -f1
     else
       awk -F: -v gid="$1" '$3 == gid { print $1; exit }' /etc/group 2>/dev/null
     fi ;;
 esac
}


private.this.container.is()     # <?root:/> # rc 0 when this computer is a container: <root>/.dockerenv (Docker) or <root>/run/.containerenv (Podman) exists #
{
 # A predicate (rc only, no create.result), like private.this.group.exists.
 # Nothing in oosh answered "am I a container": odocker installed a Docker
 # engine in a platform container without the host's socket, where none can
 # start (2026-10-06, T-THIS-CONTAINER-IS). <root> lets a test use a fixture.
 local root="${1:-/}"
 root="${root%/}"
 [ -e "$root/.dockerenv" ] || [ -e "$root/run/.containerenv" ]
}


private.this.env.export.line.get()     # <variableName> <value> # echo ONE pure-data env line export variableName=value, the value quoted by bash declare -p so a quote, dollar, backslash or backtick reads back as given; nothing and rc 1 when it cannot be one line of pure data: an invalid name, a control character, an ANSI-C rendering #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT (config
 # renders inside `{ … } >file`, where LOG_DEVICE can be fd1). The ONE rule for
 # "how a value becomes a line of an env file, and which values are refused",
 # in the kernel because both config (private.config.variable.export.line) and
 # log (log.session.save) write env files and log must not load config.
 # Bash quotes (`declare -p` of a local, the named form — the same on 3.2 and
 # 5): a quote, $, backslash or backtick comes out escaped and reads back as
 # given in bash and every POSIX sh (T77 in test.config). Refused, because no
 # single line could hold it as data: a control character (the files are
 # line-oriented; bash 5.1 writes it raw, 5.2 and 3.2 as $'…') and any $'…'
 # rendering (a bashism dash reads literally). T-THIS-ENV-EXPORT-LINE.
 local variableName="$1" value="$2" declaration
 case "$variableName" in ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;; esac
 case "$value" in *[[:cntrl:]]*) return 1 ;; esac
 declaration=$(declare -p value 2>/dev/null) || return 1
 declaration="${declaration#declare -* value=}"
 case "$declaration" in '"'*) ;; *) return 1 ;; esac
 echo "export $variableName=$declaration"
}


private.this.file.same()     # <fileA> <fileB> # rc 0 when both files exist with identical bytes: cmp -s where it exists, else an od byte dump of each compared, which needs no extra package #
{
 # A predicate (rc only, no create.result), like private.this.container.is.
 # cmp is diffutils, which AlmaLinux minimal does not ship: its rc 127 read as
 # "differs", so a file was re-copied on every run and idempotence was lost
 # silently (T-CONFIG-BASHRC-ALL-NO-CMP). The fallback is exact, not a
 # checksum: od (coreutils, busybox, BSD) writes every byte as hex text, so a
 # binary byte or a trailing newline is part of the compared text — $(cat)
 # would drop trailing newlines. Sizes first: unequal files are told apart
 # without reading them (T-THIS-FILE-SAME).
 local a="$1" b="$2"
 [ -f "$a" ] && [ -f "$b" ] || return 1
 if command -v cmp >/dev/null 2>&1; then
   cmp -s "$a" "$b"
   return
 fi
 [ "$(wc -c < "$a")" -eq "$(wc -c < "$b")" ] || return 1
 [ "$(od -An -v -tx1 "$a")" = "$(od -An -v -tx1 "$b")" ]
}


private.this.path.stat.get()     # <path> <field> # echo one stat field of the path itself, a symlink not followed: owner, group, uid, gid or mode (octal permission bits); GNU stat format first, else the BSD one, both from one table; nothing and rc 1 for a missing path or an unknown field #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # `stat -c <gnu> … || stat -f <bsd> …` was hand-written six times (config ×3,
 # odocker ×2, user). The platform difference is DATA — the table below — and
 # the try-GNU-then-BSD is written once: GNU and busybox know -c, macOS fails
 # on it and knows -f. Neither follows a symlink by default, so a link is
 # described itself (config.init.check asks about the ~/config link).
 local path="$1" field="$2" gnu bsd value
 [ -e "$path" ] || [ -L "$path" ] || return 1
 case "$field" in
   owner) gnu=%U bsd=%Su ;;
   group) gnu=%G bsd=%Sg ;;
   uid)   gnu=%u bsd=%u ;;
   gid)   gnu=%g bsd=%g ;;
   mode)  gnu=%a bsd=%Lp ;;
   *)     return 1 ;;
 esac
 value=$(stat -c "$gnu" "$path" 2>/dev/null) || value=$(stat -f "$bsd" "$path" 2>/dev/null) || return 1
 [ -n "$value" ] || return 1
 echo "$value"
}

private.this.path.stat.get.completion.field() { echo owner; echo group; echo uid; echo gid; echo mode; }


private.this.temp.dir.get()     # <?label:oosh> # echo the canonical path of a new private directory (mode 700) under TMPDIR, else /tmp, named after label; nothing and rc 1 when the label is not a plain name or none can be made #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. The
 # caller owns the directory and removes it. mktemp was called raw in c2,
 # odocker and ossh; test.suite.fixture.make is the test-only twin. Canonical,
 # because on macOS /tmp is /private/tmp and $TMPDIR ends in a slash — a path
 # compared or resolved later must be the physical one (T-THIS-TEMP-DIR-GET).
 # `mktemp -d <template>` is the one spelling GNU, busybox and BSD share.
 local label="${1:-oosh}" base="${TMPDIR:-/tmp}" dir
 case "$label" in *[!A-Za-z0-9._-]*) return 1 ;; esac
 base="${base%/}"
 dir=$(mktemp -d "${base:-/tmp}/$label.XXXXXX" 2>/dev/null) || return 1
 chmod 700 "$dir" 2>/dev/null || { rm -rf "$dir"; return 1; }
 private.this.path.canonical "$dir"
}


private.this.tree.tracked.check()     # <treeRoot> <?caller:sweep> # rc 0 when the tracked files of treeRoot are visible; else an INVALID: verdict on stdout and rc 2 — a tree sweep that reads nothing must never report OK #
{
 # The one guard of the tree sweeps (path.validate, this.anchor.validate,
 # ogit.caller.validate, test.suite.portability.validate). ogit.repo.grep
 # discards stderr, so no repository, a repository with nothing tracked and the
 # "dubious ownership" refusal (root in a container against an oosh-user tree)
 # all come back empty — indistinguishable from a clean tree. A sweep proves it
 # can see the files BEFORE it trusts that it found nothing in them
 # (T-PATH-VALIDATE-BLIND, T-ANCHOR-VALIDATE-BLIND, T-PORTABILITY-BLIND,
 # T-OGIT-ONLY-CALLER-REJECTS). The verdict goes to stdout, like the sweeps.
 local treeRoot="$1" caller="${2:-sweep}"
 if ! private.this.script.load ogit ogit.repo.files.list; then
   error.log "$caller: cannot load ogit.repo.files.list from $OOSH_DIR/ogit"
   echo "INVALID: $treeRoot — not scanned, ogit could not be loaded"
   create.result 2 "ogit could not be loaded: $treeRoot not scanned"
   return $(result)
 fi
 if [ -z "$(ogit.repo.files.list "$treeRoot" | head -1)" ]; then
   error.log "$caller: no tracked file under $treeRoot is visible to git — no repository, nothing tracked, or ownership refused (ogit safeDirectory.ensure). A sweep that reads nothing reports OK, so this is a failure, not a pass."
   echo "INVALID: cannot read $treeRoot through git — no tracked files visible"
   create.result 2 "no tracked file visible under $treeRoot"
   return $(result)
 fi
 create.result 0 "tracked files visible under $treeRoot"
 return $(result)
}


private.this.marker.sweep()     # <pattern> <markerSlug> <treeRoot> <?excludes...> # echo one line per match of pattern in the tracked files of treeRoot: comment, marked or unmarked, a space, then file:line:content; marked is a comment markerSlug-exception: on the line or in the 5 lines above, or markerSlug-exception-file: in the file; callers run private.this.tree.tracked.check first #
{
 # The one sweep of the four tree validators — path.validate (path),
 # this.anchor.validate (oosh-dir, config-path), ogit.caller.validate (ogit),
 # test.suite.portability.validate (portability). It owns what they shared:
 # the grep of the TRACKED tree (git grep is one process and sees
 # tracked-but-gitignored files), the comment skip (a line that only TALKS
 # about a construct is not a use of it) and the three marker rules. The
 # marker is anchored to a COMMENT, so it counts only where a human wrote one —
 # otherwise a validator, which names its own marker, would exempt itself. The
 # window is the 5 lines above, because these sites often sit inside a heredoc
 # or a `bash -c` string where the marker cannot go on the line.
 # Each caller keeps its OWN rules and summary: what is conforming, the
 # self-assignments, the portability advisories. A getter: stdout, no RESULT.
 local pattern="$1" slug="$2" treeRoot="$3"
 if [ $# -ge 3 ]; then shift 3; else set --; fi
 private.this.script.load ogit ogit.repo.grep || return 2
 local matches match file lineNo content trimmed windowFrom class
 matches=$(ogit.repo.grep "$pattern" "$treeRoot" "$@")
 while IFS= read -r match; do
   [ -z "$match" ] && continue
   file="${match%%:*}"
   content="${match#*:}"
   lineNo="${content%%:*}"
   content="${content#*:}"
   trimmed="${content#"${content%%[![:space:]]*}"}"
   case "$trimmed" in '#'*) printf 'comment %s\n' "$match"; continue ;; esac
   class=unmarked
   if printf '%s' "$content" | grep -qE "#[[:space:]]*${slug}-exception:"; then
     class=marked
   elif grep -qE "^[[:space:]]*#[[:space:]]*${slug}-exception-file:" "$treeRoot/$file" 2>/dev/null; then
     class=marked
   elif [ "$lineNo" -gt 1 ]; then
     windowFrom=$((lineNo - 5))
     [ "$windowFrom" -lt 1 ] && windowFrom=1
     sed -n "${windowFrom},$((lineNo - 1))p" "$treeRoot/$file" 2>/dev/null \
       | grep -qE "#[[:space:]]*${slug}-exception:" && class=marked
   fi
   printf '%s %s\n' "$class" "$match"
 done <<< "$matches"
 return 0
}


