replace.commit() # <file> # swap the transformed copy in: <file> becomes <file>.bak, the content of <file>.new takes the name with the whole mode of the original
{
  FILE="$1"
  # REFUSE a symlink. The swap below would `chmod -x` the link's TARGET, move
  # the LINK aside and put the edit down as a plain file under the link's name
  # — top-level `c2 -> ng/c2` became a stale copy with ng/c2 no longer
  # executable. Callers edit the target (private.this.path.canonical).
  if [ -L "$FILE" ]; then
    create.result 1 "replace commit: $FILE is a symlink — refusing; commit its target $(private.this.path.canonical "$FILE")"
    error.log "$RESULT"
    return $(result)
  fi
  # REFUSE without the working copy. This used to run unconditionally: the
  # first `mv` displaced the original to .bak, the second failed because
  # .new was never written, and the script was left with NO file under its
  # own name. private.oo.new.method calls this whether or not any
  # substitution matched, so it was one failed `replace within` away from
  # deleting the script it was editing.
  if [ ! -f "$FILE.new" ]; then
    create.result 1 "replace commit: $FILE.new does not exist — nothing to commit, refusing (committing anyway would leave $FILE with no file under its own name)"
    error.log "$RESULT"
    return $(result)
  fi
  # Use standard bash test - works on case-insensitive APFS
  [ -f "$FILE.bak" ] && rm "$FILE.bak"
  # The WHOLE mode of the original stays (and its group; its owner as root):
  # `mv <file>.new <file>` put the editor's umask under the name — on the
  # shared tree a 664 script came back 644 and the next dev-group user could
  # not edit it; only the exec bit was put back. A cp -p copy of the ORIGINAL
  # takes the new content and then the name — no stat -c / chmod --reference
  # (GNU-only). Not written INTO the original: a running bash script (oo
  # method.new oo.x edits oo) reads on from its offset in the file it opened,
  # and must go on reading the old content — which mv keeps as the .bak.
  # The .bak is made non-executable so completion never lists it as a command.
  local next="$FILE.new.$$"
  if ! cp -p "$FILE" "$next" || ! cat "$FILE.new" > "$next"; then
    rm -f "$next"
    create.result 1 "replace commit: could not copy $FILE to $next — $FILE is unchanged"
    error.log "$RESULT"
    return $(result)
  fi
  mv "$FILE" "$FILE.bak"
  chmod -x "$FILE.bak" 2>/dev/null   # a .bak of a file another user owns keeps its mode
  mv "$next" "$FILE"
  rm -f "$FILE.new"
  create.result 0 "$FILE committed, previous kept as $FILE.bak"
  return $(result)
}

replace.rollback() # <file> # undo: drop an uncommitted <file>.new, else write <file>.bak back into <file> (the committed edit is kept as <file>.new); refuses when there is neither
{
  FILE="$1"
  if [ -f "$FILE.new" ]; then
    rm "$FILE.new"
  elif [ ! -f "$FILE.bak" ]; then
    # It used to move <file> to <file>.new and then fail to move a missing
    # .bak back: nothing was left under the file's own name.
    create.result 1 "replace rollback: neither $FILE.new nor $FILE.bak exists — nothing to roll back, $FILE is unchanged"
    error.log "$RESULT"
    return $(result)
  else
    # As replace.commit: a cp -p copy of <file> (its whole mode) takes the
    # .bak content and then the name; the committed edit is kept as <file>.new.
    local next="$FILE.new.$$"
    if ! cp -p "$FILE" "$next" || ! cat "$FILE.bak" > "$next"; then
      rm -f "$next"
      create.result 1 "replace rollback: could not copy $FILE to $next — $FILE is unchanged, the previous content is in $FILE.bak"
      error.log "$RESULT"
      return $(result)
    fi
    mv "$FILE" "$FILE.new"
    mv "$next" "$FILE"
    rm -f "$FILE.bak"
  fi
  create.result 0 "$FILE rolled back"
  return $(result)
}

replace.cleanup()
{
  if [ -n "$1" ]; then
    # Use standard bash test - works on case-insensitive APFS
    [ -f "$1.bak" ] && rm "$1.bak"
    [ -f "$1.new" ] && rm "$1.new"
  else
    rm -f $OOSH_DIR/*.bak 2>/dev/null
    rm -f $OOSH_DIR/*.new 2>/dev/null
  fi
  # rc 0 always: the `[ -f … ] && rm …` above leaves 1 behind when there was
  # nothing to clean, which broke every `… && replace cleanup` chain.
  return 0
}




