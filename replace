{
  local this=${0##*/}
  echo "You started 
$0

  Usage:
  $this: in filename expressin by relpaceExpression

      usage             prints this dialog while it will print the status when there are no parameters          
      v                 print version information
      commit            filename
      rollback          filename
      diff              filename

      by        <replace expression>
      by.file
      within        <filename> <search expression>   substring, every line
      line          <filename> <exact line>          whole line, exactly one match

      cleanup


  Examples
