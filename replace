replace.by() # <newText> # completes `replace within`, `line`, `block` or `word`; writes the transformed copy to <file>.new
{
  REPLACE_EXPRESSION="$1"
  shift

  # Use perl instead of awk — BSD awk cannot handle newlines in -v strings
  # Export vars so perl can access them via %ENV
  export SEARCH_EXPRESSION
  export REPLACE_EXPRESSION

  if [ "$REPLACE_ANCHOR" = "block" ]; then
    # Whole BLOCK, from <startLine> to <endLine> inclusive, and exactly one of
    # them. `by ""` deletes it; `by "<text>"` swaps the whole block for <text>.
    # This is what `oo method.delete` removes a function with — a method is a
    # block, not a line, and deleting it by hand is how docstrings and
    # completion functions get orphaned.
    local starts; starts=$(grep -c -x -F -- "$SEARCH_EXPRESSION" "$FILE" 2>/dev/null)
    unset REPLACE_ANCHOR
    if [ "${starts:-0}" != "1" ]; then
      create.result 1 "replace block: start '$SEARCH_EXPRESSION' matches ${starts:-0} whole line(s) in $FILE — expected exactly 1, refusing"
      error.log "$RESULT"
      return $(result)
    fi
    # Same reasoning as the line form: awk, not perl (Alpine ships no perl),
    # and ENVIRON, not -v (awk processes escapes in a -v assignment).
    export BLOCK_END_EXPRESSION
    if ! awk 'BEGIN{s=ENVIRON["SEARCH_EXPRESSION"];e=ENVIRON["BLOCK_END_EXPRESSION"];r=ENVIRON["REPLACE_EXPRESSION"]}
              !inBlock && !closed && $0==s {inBlock=1; next}
              inBlock && $0==e {inBlock=0; closed=1; if (r != "") print r; next}
              inBlock {next}
              {print}
              END{ if (inBlock) exit 3 }' "$FILE" > "$FILE.new"; then
      create.result 1 "replace block: no '$BLOCK_END_EXPRESSION' line after '$SEARCH_EXPRESSION' in $FILE"
      error.log "$RESULT"
      return $(result)
    fi
    create.result 0 "$FILE.new written" "$1"
    return $(result)
  fi

  if [ "$REPLACE_ANCHOR" = "word" ]; then
    # Every WHOLE-WORD occurrence, on every line: a hit counts only when the
    # characters around it are not [A-Za-z0-9_.] — so `debug.step`, `step.x`,
    # `stepping` and `my_step` are other words, and a rerun matches nothing.
    # awk with index(), not perl or a regex: Alpine ships no perl, and <word>
    # is literal text that may contain dots. ENVIRON, not -v (escapes).
    unset REPLACE_ANCHOR
    if ! awk 'function isWord(c) { return c ~ /[A-Za-z0-9_.]/ }
              BEGIN{s=ENVIRON["SEARCH_EXPRESSION"];r=ENVIRON["REPLACE_EXPRESSION"];n=0;len=length(s)}
              {
                out=""; rest=$0
                while (len > 0 && (i=index(rest, s)) > 0) {
                  before = (i > 1) ? substr(rest, i-1, 1) : substr(out, length(out), 1)
                  after = substr(rest, i+len, 1)
                  if (!isWord(before) && !isWord(after)) { out = out substr(rest, 1, i-1) r; n++ }
                  else { out = out substr(rest, 1, i-1+len) }
                  rest = substr(rest, i+len)
                }
                print out rest
              }
              END{ if (n == 0) exit 3 }' "$FILE" > "$FILE.new"; then
      rm -f "$FILE.new"
      create.result 1 "replace word: no whole-word '$SEARCH_EXPRESSION' in $FILE"
      error.log "$RESULT"
      return $(result)
    fi
    create.result 0 "$FILE.new written" "$1"
    return $(result)
  fi

  if [ "$REPLACE_ANCHOR" = "line" ] || [ "$REPLACE_ANCHOR" = "lines" ]; then
    # Whole line, and exactly one of them. `replace within` matches a
    # SUBSTRING, and `perl -pe` loops over every line, so it rewrites the
    # first match on EVERY line that contains one. Running `oo method.new
    # oo.something` used to corrupt oo's own source that way: the marker text
    # "### new.method" appears both as the real marker and inside the tool's
    # own string literal one line above it.
    # `lines` (replace.lines): every equal whole line, one or more.
    local matches anchor="$REPLACE_ANCHOR"; matches=$(grep -c -x -F -- "$SEARCH_EXPRESSION" "$FILE" 2>/dev/null)
    unset REPLACE_ANCHOR
    if [ "$anchor" = "lines" ] && [ "${matches:-0}" = "0" ]; then
      create.result 1 "replace lines: '$SEARCH_EXPRESSION' matches no whole line in $FILE — refusing"
      error.log "$RESULT"
      return $(result)
    fi
    if [ "$anchor" = "line" ] && [ "${matches:-0}" != "1" ]; then
      create.result 1 "replace line: '$SEARCH_EXPRESSION' matches ${matches:-0} whole line(s) in $FILE — expected exactly 1, refusing"
      error.log "$RESULT"
      return $(result)
    fi
    # awk, NOT perl. Alpine ships no perl at all, so `replace` — and therefore
    # `oo method.new`, which is the whole point of the whole-line form — could
    # not run there. Caught by the alpine platform gate on f386f87: three tests
    # red with "replace line returned 1". busybox awk is enough for an
    # equality test, and this is the path the method tool uses.
    #
    # ENVIRON, not `-v`: awk processes escape sequences in a -v assignment, so
    # a backslash anywhere in the generated method body would be mangled.
    if ! awk 'BEGIN{s=ENVIRON["SEARCH_EXPRESSION"];r=ENVIRON["REPLACE_EXPRESSION"]}
              $0==s{print r; next}{print}' "$FILE" > "$FILE.new"; then
      create.result 1 "replace line: could not write $FILE.new"
      error.log "$RESULT"
      return $(result)
    fi
    create.result 0 "$FILE.new written" "$1"
    return $(result)
  fi

  # The substring form still needs perl for its literal \Q…\E match. That is a
  # pre-existing dependency, unchanged here, and it is why `replace within`
  # does not work on a host without perl — its own card.
  if ! perl -pe 's/\Q$ENV{SEARCH_EXPRESSION}\E/$ENV{REPLACE_EXPRESSION}/' "$FILE" > "$FILE.new"; then
    create.result 1 "replace by: could not write $FILE.new (perl absent? `replace within` requires it)"
    error.log "$RESULT"
    return $(result)
  fi
  if [[ $FILE == *.new ]]; then
    replace commit "$FILE" || return 1
    replace cleanup "$FILE"
  fi
  # create.result's THIRD argument is the chaining marker. This used to be a
  # bare `RETURN=$1` as the last statement, which pinned the exit status at 0 —
  # the same defect oo.cmd carried until 8928c3e, and the reason a failed
  # substitution could be followed by an unconditional `replace commit`.
  create.result 0 "$FILE.new written" "$1"
  return $(result)
}

replace.line() # <file> <exactLine> # like `replace within`, but the search must match a WHOLE line and exactly one of them; continue with `by <newText>`
{
  FILE="$1"
  shift
  SEARCH_EXPRESSION=$1
  shift
  REPLACE_ANCHOR="line"
  export REPLACE_ANCHOR
  RETURN=$1
}

# This function reads text from stdin, and substitutes a *BLOCK* with the contents from a FILE, and outputs to stdout
# The BLOCK is indicated with BLOCK_StartRegexp and BLOCK_EndRegexp
#
# Usage:
#    seq 100 110 | substitute_BLOCK_with_FILEcontents '^102' '^104' /tmp/FileWithContents > /tmp/result.txt
replace.by.file() 
{
  local BLOCK_StartRegexp="${1}"
  local BLOCK_EndRegexp="${2}"
  local FILE="${3}"
  sed -e "/${BLOCK_EndRegexp}/a ___tmpMark___" -e "/${BLOCK_StartRegexp}/,/${BLOCK_EndRegexp}/d" | sed -e "/___tmpMark___/r ${FILE}" -e '/___tmpMark___/d'
}


