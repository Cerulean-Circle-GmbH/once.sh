replace.block()     # <file> <startLine> <endLine> # selects the whole block from <startLine> to <endLine> inclusive, exactly one of them; continue with `by <newText>` — `by ""` deletes it #
{
  # A SELECTOR, like replace.line and replace.within: it only records what to
  # act on and hands the chain forward via RETURN. replace.by does the write
  # and owns the result — which is why there is no create.result here.
  #
  # Both patterns are WHOLE LINES, matched literally (grep -x -F / awk ==),
  # never regexes: the block this exists to remove is a shell function, whose
  # first line contains (), $, quotes and often a docstring.
  FILE="$1"
  shift
  SEARCH_EXPRESSION="$1"
  shift
  BLOCK_END_EXPRESSION="$1"
  shift
  REPLACE_ANCHOR="block"
  export REPLACE_ANCHOR BLOCK_END_EXPRESSION
  RETURN=$1
}


replace.block.completion.file() {
  # one candidate per line on stdout; $1 is the word being completed
  echo ""
}
replace.block.completion.startLine() {
  # one candidate per line on stdout; $1 is the word being completed
  echo ""
}
replace.block.completion.endLine() {
  # one candidate per line on stdout; $1 is the word being completed
  echo ""
}
replace.word()     # <file> <word> # every WHOLE-WORD occurrence of <word> on every line, not when part of a longer or dotted name (a rerun is a no-op); continue with `by <newText>` #
{
 # A SELECTOR, like replace.line and replace.block: it records what to act
 # on and hands the chain forward via RETURN; replace.by does the write and
 # owns the result. It exists to RENAME an identifier: `replace line`
 # refuses a line that occurs twice, and `replace within` takes only the
 # first substring on each line and re-matches its own output
 # (step → debug.step → debug.debug.step).
 FILE="$1"
 shift
 SEARCH_EXPRESSION="$1"
 shift
 REPLACE_ANCHOR="word"
 export REPLACE_ANCHOR
 RETURN=$1
}


replace.word.completion.file() {
  # one candidate per line on stdout; $1 is the word being completed
  compgen -f "$1"
}
replace.word.completion.word() {
  # one candidate per line on stdout; $1 is the word being completed
  echo ""
}
replace.lines()     # <file> <exactLine> # every WHOLE line equal to <exactLine>, one or more of them (identical duplicates too); continue with `by <newText>` #
{
 # A SELECTOR, like replace.line: it records what to act on and hands the
 # chain forward via RETURN; replace.by does the write and owns the result.
 # `replace line` refuses a line that occurs twice — right for a marker, wrong
 # for a value that must hold on EVERY such line (promote's OOSH_SELF_BRANCH
 # default). Still whole lines only, matched literally; none is a refusal.
 FILE="$1"
 shift
 SEARCH_EXPRESSION="$1"
 shift
 REPLACE_ANCHOR="lines"
 export REPLACE_ANCHOR
 RETURN=$1
}


replace.lines.completion.file() {
  # one candidate per line on stdout; $1 is the word being completed
  compgen -f "$1"
}
replace.lines.completion.exactLine() {
  # one candidate per line on stdout; $1 is the word being completed
  echo ""
}
