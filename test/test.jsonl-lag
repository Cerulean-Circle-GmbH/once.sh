#!/usr/bin/env bash
# T-JSONL-LAG — RED-FIRST guard (rewind-safety defect b, oopPO 2026-09-30).
# DEFECT: private.claudeCode.context.from.jsonl reads the LAST assistant-usage entry. A mid-reboot
# agent injects a BIG un-recorded window AFTER that turn (context.md + learnings + file reads = user/
# tool entries with no assistant-usage yet) → the number reflects only the PRE-injection state →
# a ~30pt FALSE-SAFE reading with NO lag signal → licenses a walling drive. Today's ONLY guard is
# TIME-based (mtime>600s→'stale'); there is NO CONTENT-lag guard.
#
# CONTRACT this RED pins (align exact names/threshold with the expert; repro jsonl = oopTeam:0.0):
#   (i)  DETECT a large un-recorded lag-window (content AFTER the last assistant-usage) → LAG signal
#        so context.read DEFERS TO THE PANEL, not the lagging-low number.
#   (ii) the threshold is STRUCTURAL (entries/bytes AFTER last assistant-usage), NOT a guessed byte
#        constant — proven by tracking the STRUCTURE (big window→lag, zero window→fresh).
#   (iii)the LAG label is a SEPARATE FIELD — the BARE numeric output stays UNCHANGED (context.check /
#        scrumMaster.pulse / views parse it; a contract break would regress them).
#   (iv) remaining-convention (bare number = remaining%).
#
# PROPOSED interface (CONFIRM with expert): private.claudeCode.context.jsonl.lag <jsonl> → 'lag'|'fresh'.
# If the expert names it differently, only the LAGFN below changes; the scenario/contract stand.
LAGFN="private.claudeCode.context.jsonl.lag"

level=$1; [ -z "$level" ] && level=1
echo "starting: T-JSONL-LAG <LOG_LEVEL=$level> (RED-FIRST — no content-lag guard exists yet)"
source this
source test.suite
source claudeCode
export LOG_DEVICE=/dev/null
log.level $level

D="${TMPDIR:-/tmp}/t-jsonl-lag.$$"; rm -rf "$D"; mkdir -p "$D"
cleanup() { rm -rf "$D" 2>/dev/null; }
trap cleanup EXIT

# Build a JSONL: one assistant-usage entry (~40% used) then <window> un-recorded user entries after it.
mk_jsonl() {   # <file> <window>
  local f="$1" window="$2" i
  local max used cr
  max=$(private.claudeCode.max.tokens.for.jsonl "$f" 2>/dev/null); max=${max:-200000}
  used=$(awk "BEGIN{printf \"%d\", $max*0.40}"); cr=$((used-1001))
  printf '{"type":"assistant","message":{"usage":{"input_tokens":1,"cache_creation_input_tokens":1000,"cache_read_input_tokens":%d}}}\n' "$cr" > "$f"
  for ((i=1;i<=window;i++)); do
    printf '{"type":"user","message":{"role":"user","content":"[injected boot chunk %d: context.md/learnings/read — big un-recorded tokens]"}}\n' "$i" >> "$f"
  done
  touch "$f"   # fresh mtime — isolates CONTENT-lag from the existing TIME-staleness guard
}

LAG_JF="$D/lagging.jsonl";  mk_jsonl "$LAG_JF" 40   # BIG un-recorded window (mid-reboot injection)
FRESH_JF="$D/fresh.jsonl";  mk_jsonl "$FRESH_JF" 0  # last assistant-usage IS the last entry — no lag

echo; echo "===== (1) STRUCTURAL DETECT: big un-recorded window → 'lag', zero window → 'fresh' ====="
if type -t "$LAGFN" >/dev/null 2>&1; then
  GLAG=$("$LAGFN" "$LAG_JF" 2>/dev/null); GFRESH=$("$LAGFN" "$FRESH_JF" 2>/dev/null)
  test.case $level "(1a) lag-detector: big window → 'lag' (got '$GLAG')" echo "$GLAG"
  [ "$GLAG" = "lag" ] && expect.pass "detected the un-recorded lag-window" || expect.fail "RED: no 'lag' on a 40-entry un-recorded window (got '$GLAG')"
  test.case $level "(1b) lag-detector: zero window → 'fresh' (got '$GFRESH')" echo "$GFRESH"
  [ "$GFRESH" = "fresh" ] && expect.pass "no false lag on a current jsonl" || expect.fail "RED/over-trigger: got '$GFRESH' on a no-window jsonl"
else
  test.case $level "(1) lag-detector $LAGFN defined" echo "absent"
  expect.fail "RED: $LAGFN not defined — no STRUCTURAL content-lag guard exists (defect open)"
fi

echo; echo "===== (2) DEFER-TO-PANEL: context.read must SIGNAL lag, not hand back the lagging-low number ====="
# On a lagging jsonl the reader must NOT silently return a trustworthy-looking bare number. Whether via
# a 'lag'/'defer' state or an rc that routes to the panel — the caller must be told to distrust it.
GOT=$(private.claudeCode.context.from.jsonl "$LAG_JF" 2>/dev/null)
test.case $level "(2) from.jsonl on a lagging jsonl signals lag/defer (got '$GOT')" echo "$GOT"
case "$GOT" in
  *lag*|*defer*|*panel*|stale|unknown) expect.pass "signals lag/defer → caller uses the panel" ;;
  *) expect.fail "RED: returned bare '$GOT' with NO lag signal — FALSE-SAFE, licenses a walling drive" ;;
esac

echo; echo "===== (3) SEPARATE FIELD: the BARE numeric output is UNCHANGED on a FRESH jsonl (no contract break) ====="
BARE=$(private.claudeCode.context.from.jsonl "$FRESH_JF" 2>/dev/null)
test.case $level "(3) fresh jsonl → bare numeric remaining, parseable by pulse/views (got '$BARE')" echo "$BARE"
if printf '%s' "$BARE" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
  expect.pass "bare output is a plain remaining number (contract intact for context.check/pulse/views)"
else
  expect.fail "CONTRACT BREAK: fresh bare output '$BARE' is not a plain number — pulse/views would regress"
fi

echo; echo "===== (4) remaining-convention anchor ====="
test.case $level "(4) fresh bare number is REMAINING (0-100)" echo "$BARE"
if printf '%s' "$BARE" | grep -qE '^[0-9]+(\.[0-9]+)?$' && awk "BEGIN{exit !($BARE>=0 && $BARE<=100)}"; then
  expect.pass "remaining in [0,100]"
else
  expect.fail "not a remaining% in [0,100]: '$BARE'"
fi

echo
echo "=================================================================="
echo "  T-JSONL-LAG RED-FIRST: a big un-recorded window after the last assistant-usage must raise a"
echo "  SEPARATE lag signal (bare number unchanged) so context.read/pulse DEFER to the panel."
echo "  Align $LAGFN name + structural threshold with the expert (repro jsonl = oopTeam:0.0)."
echo "=================================================================="
cleanup
test.suite.save.results
