#!/usr/bin/env bash
# T-PULSE-REMOVED — gate for oosh-expert/remove-pulse (6c4e3165 + b2c024ff), TRON order 2026-10-28:
# the deprecated Python scrumMaster.pulse is DELETED; swipe is the only monitor. RED on deployed (pulse
# still there), GREEN once removed. The rewind declaration verbs (rewind.mark/unmark/list) are KEPT.
#   P1  `scrumMaster pulse` is refused with the OOSH unknown-method MESSAGE (no table, no python ran).
#       rc is NOT asserted: OOSH unknown-verb dispatch exits rc0 by convention.
#   P2  static: scrumMaster defines no pulse method / completion / SM_PULSE_PY block, and NO caller of
#       `scrumMaster pulse` / scrumMaster.pulse remains in any script or test (comments excluded).
#   P3  KEPT: sandboxed rewind.mark -> swipe shows DURING-REWIND on that agent row -> rewind.list names it
#       -> rewind.unmark -> swipe row back to a live state, marker gone. Live marker dir sha unchanged.
# ISOLATION: sandbox HOME + CONFIG_PATH (marker dir = $CONFIG_PATH/scrumMaster.rewind.active).

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED on deployed — pulse still present)"
source this
source test.suite
log.level $level
export LOG_DEVICE=/dev/null

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

SM_UT=$(command -v scrumMaster); TREE_UT=$(dirname "$SM_UT")
FX_PREFIX="fxprm_"; FX="${FX_PREFIX}fix"
GEN="${OOSH_DIR}/test/gen/t-pulse-removed"; SBX="$GEN/home"
LIVE_MARKS="${CONFIG_PATH:-$HOME/config}/scrumMaster.rewind.active"
dsha(){ [ -d "$1" ] && (cd "$1" && ls -A | sort | sha256sum | cut -c1-16) || echo absent; }
LIVE_BEFORE=$(dsha "$LIVE_MARKS")
sbx(){ HOME="$SBX" CONFIG_PATH="$SBX/config" "$@"; }

# PRE-RUN sweep by prefix (an EXIT trap does not fire on SIGKILL/timeout).
sweep(){ tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" \
           | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; rm -rf "$GEN"; }
trap sweep EXIT
sweep
mkdir -p "$GEN/bin" "$GEN/cwd" "$SBX/config" "$SBX/.claude/projects"
: > "$SBX/config/result.txt"; : > "$SBX/config/error.txt"
echo "  scrumMaster under test: $SM_UT"

echo; echo "===== P1 — 'scrumMaster pulse' is refused (unknown method), no monitor table rendered ====="
POUT=$(sbx "$SM_UT" pulse ooshTeam 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
printf '%s\n' "$POUT" | grep -v '^[[:space:]]*$' | sed -n '1,4p' | sed 's/^/    /'
REFUSED=0; printf '%s\n' "$POUT" | grep -qiE 'unknown|not found|no such|not a (method|function)|command not found|usage' && REFUSED=1
TABLE=0;   printf '%s\n' "$POUT" | grep -qE '^TEAM |[0-9]+ agents' && TABLE=1
PY=0;      printf '%s\n' "$POUT" | grep -qiE 'Traceback|python' && PY=1
test.case $level "P1 'scrumMaster pulse' refused with a message, no table, no python" echo "refused=$REFUSED table=$TABLE py=$PY"
{ [ "$REFUSED" -eq 1 ] && [ "$TABLE" -eq 0 ] && [ "$PY" -eq 0 ]; } \
  && ok "pulse refused (unknown-method message), no monitor table" \
  || no "RED: pulse still runs or is not refused (refused=$REFUSED table=$TABLE python=$PY)"

echo; echo "===== P2 — static: no pulse method / completion / embedded python, no caller anywhere ====="
DEF=$(grep -cE '^(private\.)?scrumMaster\.pulse[a-zA-Z0-9_.]*\(\)' "$SM_UT")
PYB=$(grep -cE 'SM_PULSE_PY' "$SM_UT")
test.case $level "P2a scrumMaster: pulse defs=0 and SM_PULSE_PY refs=0" echo "defs=$DEF py=$PYB"
{ [ "$DEF" -eq 0 ] && [ "$PYB" -eq 0 ]; } && ok "no pulse method/completion/python block" \
  || no "RED: scrumMaster still defines pulse ($DEF def(s), $PYB SM_PULSE_PY ref(s))"
# callers: non-comment lines invoking `scrumMaster pulse` or scrumMaster.pulse, in every script + test
CALLERS=$(cd "$TREE_UT" && grep -nE 'scrumMaster"?[[:space:]]+pulse([[:space:]]|$|")|scrumMaster\.pulse' \
           $(ls -p | grep -v / ; ls test/test.* 2>/dev/null) 2>/dev/null \
           | grep -vE '^[^:]+:[0-9]+:[[:space:]]*#' | grep -v '^test/test.pulse-removed:')
NC=$(printf '%s' "$CALLERS" | grep -c .)
test.case $level "P2b no caller of scrumMaster pulse in any script/test (comments excluded)" echo "callers=$NC"
[ "$NC" -eq 0 ] && ok "zero pulse callers" || no "RED: $NC caller(s): $(printf '%s\n' "$CALLERS" | head -3 | tr '\n' '~')"

if [ -z "$TMUX" ]; then
  test.case $level "P3 mark->swipe->unmark (skipped — no tmux)" echo skip; expect.pass "skipped"
else
echo; echo "===== P3 — KEPT: rewind.mark -> swipe DURING-REWIND -> list -> unmark clears (sandboxed) ====="
cat > "$GEN/bin/claude" <<'SH'
#!/bin/sh
printf '%s\n' '──────────' '❯ ' '──────────' '  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents'
while :; do sleep 86400; done
SH
chmod +x "$GEN/bin/claude"
RC=$(cd "$GEN/cwd" && pwd -P)
tmux new-session -d -s "$FX" -x 120 -y 12 -c "$RC" 2>/dev/null
tmux send-keys -t "${FX}:0.0" "'$GEN/bin/claude' --model x" Enter 2>/dev/null
sleep 1.4
tmux select-pane -t "${FX}:0.0" -T '✳ fxprm-agent@WODA.prod' 2>/dev/null
state(){ sbx "$SM_UT" swipe "$FX" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '$1=="0.0"{print $3; exit}'; }
S0=$(state)
sbx "$SM_UT" rewind.mark "${FX}:0.0" >/dev/null 2>&1
S1=$(state)
LST=$(sbx "$SM_UT" rewind.list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')
NM=$(ls -A "$SBX/config/scrumMaster.rewind.active" 2>/dev/null | grep -c .)
sbx "$SM_UT" rewind.unmark "${FX}:0.0" >/dev/null 2>&1
S2=$(state)
NM2=$(ls -A "$SBX/config/scrumMaster.rewind.active" 2>/dev/null | grep -c .)
echo "  before='$S0' marked='$S1' (markers=$NM) after-unmark='$S2' (markers=$NM2)"
test.case $level "P3a fixture: agent row renders a live state before marking" echo "$S0"
echo "$S0" | grep -qxE 'IDLE|ACTIVE' && ok "agent row live ($S0)" || no "FIXTURE CONFOUND: agent row state '${S0:-<no row>}'"
test.case $level "P3b rewind.mark -> swipe shows DURING-REWIND; list names the pane" echo "$S1"
{ [ "$S1" = DURING-REWIND ] && [ "$NM" -ge 1 ] && echo "$LST" | grep -q "${FX}:0.0"; } \
  && ok "marked: swipe DURING-REWIND, marker written, list names ${FX}:0.0" \
  || no "RED: mark state='$S1' markers=$NM list-has-pane=$(echo "$LST" | grep -q "${FX}:0.0" && echo y || echo n)"
test.case $level "P3c rewind.unmark -> swipe back to a live state, marker gone" echo "$S2|$NM2"
{ echo "$S2" | grep -qxE 'IDLE|ACTIVE' && [ "$NM2" -eq 0 ]; } && ok "unmarked: '$S2', 0 markers" \
  || no "RED: after unmark state='$S2' markers=$NM2"
fi

echo; echo "===== ISOLATION — the LIVE rewind marker dir was never touched ====="
LIVE_AFTER=$(dsha "$LIVE_MARKS")
test.case $level "ISOLATION: live scrumMaster.rewind.active listing unchanged" echo "$LIVE_BEFORE..$LIVE_AFTER"
[ "$LIVE_BEFORE" = "$LIVE_AFTER" ] && ok "live markers untouched" || no "LIVE MARKER DIR CHANGED by the test"

echo
echo "=================================================================="
echo "  T-PULSE-REMOVED  PASS=$pass FAIL=$fail"
echo "=================================================================="
sweep
test.suite.save.results
