#!/usr/bin/env bash
# T-SESSION-DISCOVER-ALL — RED-FIRST gate for #3 pulse-perf + (b) disambig
# (architect d354bf63). Scenario-first: FAILS on current deployed /root/oosh, DEFINES acceptance.
#
# CURRENT: pulse resolve_jsonl (scrumMaster:638) is called PER-PANE @726 = N framework-loads (slow).
# FIX: a shared one-pass private.claudeCode.session.jsonl.scan (uuid|lastTitle|cwd|mtime) + session.rank,
# used by BOTH per-pane session.discover (claudeCode:1030) AND a NEW session.discover.all
# (agree-by-construction). (b) disambig is FOLDED IN as PARITY+SCOPE: batch MUST agree with per-pane
# even in dup-uuid(fork)/dup-title cases — gate AGREEMENT, not "never collides" (collision is orthogonal).
#
# SCENARIOS (expert recipe 1-4):
#  (1) PARITY   : session.discover.all uuid for EVERY live pane == claudeCode session.current <pane>
#                 (INCLUDING any rewound/fork dup-uuid pane) = batch == per-pane.            [RED: absent]
#  (2) PERF     : session.discover.all resolves ALL panes in ONE pass / < 15s.                [RED: absent]
#  (3) BYTE-ID  : existing per-pane session.current output UNCHANGED + stable.                [anchor]
#  (4) SCOPE    : batch==per-pane EVEN with same-title/dup-uuid panes — gate agreement.       [RED: absent]
# Current code RED on session.discover.all ABSENT + perf.

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-FIRST — session.discover.all ABSENT must fail)"
source this
source test.suite
source claudeCode >/dev/null 2>&1
log.level $level
HAVE_TMUX=0; [ -n "$TMUX" ] && HAVE_TMUX=1

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

TEAM="${DISCOVER_TEST_TEAM:-ooshTeam}"

# Seed artifacts for scenario (5) — scratch-law: /root/.claude/projects/ + component test/gen are allow-roots.
SEED_PROJ="$HOME/.claude/projects/-test-seed-discoverpair"
SEED_BASE="${OOSH_DIR}/test/gen/t-seedpair"
IL_PROJ="$HOME/.claude/projects/-test-seed-interimlift"       # (6s) synthetic always-runnable arm
IL_GEN="${OOSH_DIR}/test/gen/t-interimlift"
cleanup_seed(){ for s in fxs_A fxs_B fxsyn_A fxsyn_B fxoracle; do tmux kill-session -t "$s" 2>/dev/null; done
  rm -rf "$SEED_PROJ" "$SEED_BASE" "$IL_PROJ" "$IL_GEN"; }
trap cleanup_seed EXIT
cleanup_seed   # PRE-RUN sweep (survives SIGKILL; orphans never accumulate)

echo; echo "===== (0) EXISTS: session.discover.all is implemented [RED now] ====="
HAS=$(type -t claudeCode.session.discover.all 2>/dev/null)
[ -z "$HAS" ] && HAS=$(type -t private.claudeCode.session.discover.all 2>/dev/null)
test.case $level "0-EXISTS: session.discover.all is a function" echo "$HAS"
[ "$HAS" = function ] && ok "session.discover.all defined" || no "session.discover.all ABSENT (RED — new batch verb not implemented)"

echo; echo "===== shared one-pass scanner (fix target) present? [RED now] ====="
SCAN=$(grep -cE 'session.jsonl.scan|session.rank' "$OOSH_DIR/claudeCode")
test.case $level "0-SCAN: private.claudeCode.session.jsonl.scan + session.rank exist" echo "$SCAN"
[ "$SCAN" -gt 0 ] && ok "shared one-pass scanner present" || no "no shared scanner (RED — per-pane N-load path still the only one)"

# Enumerate LIVE Claude panes on TEAM (session.current returns a uuid) — the parity oracle set.
LIVE_PANES=""
if [ "$HAVE_TMUX" -eq 1 ]; then
  for addr in $(tmux list-panes -t "$TEAM" -F '#{window_index}.#{pane_index}' 2>/dev/null); do
    u=$(claudeCode session.current "${TEAM}:${addr}" 2>/dev/null)
    [ -n "$u" ] && [ "$u" != "unknown" ] && LIVE_PANES="$LIVE_PANES ${TEAM}:${addr}=${u}"
  done
fi
echo "  live Claude panes on $TEAM: ${LIVE_PANES:-<none>}"

echo; echo "===== (1)+(4) PARITY/SCOPE: batch discover.all == per-pane session.current, all live panes ====="
test.case $level "1-PARITY: session.discover.all agrees with session.current for every live pane" echo "checking"
if [ "$HAS" != function ]; then
  no "cannot gate PARITY — session.discover.all ABSENT (RED; post-fix: batch must equal per-pane incl dup-uuid/dup-title)"
else
  BATCH=$(claudeCode session.discover.all 2>/dev/null)   # expect lines: <pane>|<uuid>|...
  mism=""
  for pu in $LIVE_PANES; do
    p="${pu%=*}"; u="${pu#*=}"
    bu=$(printf '%s\n' "$BATCH" | awk -F'|' -v p="$p" '$1==p{print $2; exit}')
    [ "$bu" != "$u" ] && mism="$mism $p[batch='$bu' vs per-pane='$u']"
  done
  [ -z "$mism" ] && ok "batch==per-pane for all ${LIVE_PANES:+live} panes (disambig agree-by-construction)" \
    || no "PARITY MISMATCH:$mism"
fi
# SCOPE visibility (no silent cap): report any same-UUID (fork) / same-title collisions in the live set.
DUP=$(printf '%s\n' $LIVE_PANES | sed 's/.*=//' | sort | uniq -d | tr '\n' ' ')
echo "  SCOPE: dup-UUID collisions in live set: ${DUP:-none present this run (parity still gated for any that appear)}"

echo; echo "===== (2) PERF: session.discover.all one-pass time — DISCLOSURE (non-ship-blocking, oosh-po AC-split) ====="
# PERF is a DISCLOSED-OPEN metric, NOT a ship-blocking pass/fail: a >15s number must NOT red-the-suite
# and falsely block the CORRECTNESS fix. We report the number; <=15s is the next perf increment.
test.case $level "2-PERF-DISCLOSE: session.discover.all one-pass time (DISCLOSED, non-blocking)" echo "disclose"
if [ "$HAS" != function ]; then
  ok "PERF pending — discover.all absent (EXISTS gates existence; perf disclosed once present)"
else
  t0=$SECONDS; claudeCode session.discover.all >/dev/null 2>&1; dt=$((SECONDS - t0))
  echo "  discover.all one-pass elapsed=${dt}s (target <=15s)"
  if [ "$dt" -lt 15 ]; then ok "DISCLOSED: one-pass ${dt}s (<=15s target met)"
  else ok "DISCLOSED-OPEN: one-pass ${dt}s (>15s — perf follow-up / next increment; NOT ship-blocking)"; fi
fi

echo; echo "===== (3) BYTE-IDENTICAL: per-pane session.current UNCHANGED + stable [anchor] ====="
# A LIVE claude pane from the measured oracle set — never a remembered address (the old hardcoded
# ${TEAM}:0.4 went to a bare shell when oosh-tester moved to 0.3 on 10-28 → '' vs '' false-RED on every tree).
SELF=$(printf '%s\n' $LIVE_PANES | head -1 | cut -d= -f1)
u1=$(claudeCode session.current "$SELF" 2>/dev/null); u2=$(claudeCode session.current "$SELF" 2>/dev/null)
test.case $level "3-STABLE: session.current <live pane ${SELF:-none}> non-empty + identical across calls" echo "$u1/$u2"
{ [ -n "$u1" ] && [ "$u1" = "$u2" ]; } && ok "per-pane session.current stable ($u1)" || no "session.current unstable: '$u1' vs '$u2'"
# Full byte-identical regression lives in test.session-id-fresh (run alongside; must stay green post-fix).
test.case $level "3-REGRESSION-PRESENT: test.session-id-fresh exists as the byte-identical guard" echo "checking"
[ -f "$OOSH_DIR/test/test.session-id-fresh" ] && ok "test.session-id-fresh present (run as the unchanged-output regression)" \
  || no "test.session-id-fresh missing — no byte-identical regression"

echo; echo "===== (5) CWD-DISAMBIG UNIT TEST [distinct-cwd same-title; NOT the interim-lift gate] ====="
# ⚠ UNIT TEST ONLY — NOT the address-by-pane interim-lift gate. The REAL dup oosh-po measured
# (ooshTeam:0.3 vs diamonds:0.1) is SAME-cwd + DIFFERENT-@host-title + ORPHAN (both collapse to ONE
# uuid today); that is gate (B), pending oopPO's contract (two-distinct vs exclude-orphan), tracked
# separately. This case only unit-tests cwd-rank for a DISTINCT-cwd same-title pair.
# Seed a SAME-TITLE PAIR: one RESUMED uuid (A, older JSONL) + one FRESH (B, newer), SAME customTitle,
# DISTINCT cwds. They MUST resolve to TWO DISTINCT identities, NEVER collapse to one uuid.
# ('agree-by-construction' is NOT enough — oopPO: a shared resolver that drops cwd-disambig and picks
#  newest-mtime collapses the pair; this seed catches that.)
if [ "$HAVE_TMUX" -ne 1 ] || ! command -v node >/dev/null 2>&1; then
  test.case $level "5-DISTINCT (skipped — no tmux/node)" echo skip; expect.pass "skipped"
else
  cleanup_seed; mkdir -p "$SEED_PROJ" "$SEED_BASE/cwdA" "$SEED_BASE/cwdB"
  RA=$(cd "$SEED_BASE/cwdA" && pwd -P); RB=$(cd "$SEED_BASE/cwdB" && pwd -P)   # RESOLVED (symlink-safe) cwds
  UA="aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa"; UB="bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb"
  printf '{"cwd":"%s","type":"x"}\n{"type":"assistant","customTitle":"SEEDPAIR"}\n' "$RA" > "$SEED_PROJ/$UA.jsonl"
  printf '{"cwd":"%s","type":"x"}\n{"type":"assistant","customTitle":"SEEDPAIR"}\n' "$RB" > "$SEED_PROJ/$UB.jsonl"
  touch -d '2020-01-01' "$SEED_PROJ/$UA.jsonl" 2>/dev/null   # A is the RESUMED/older; B newer (would win a naive mtime pick)
  for tag in A B; do s="fxs_$tag"; tmux kill-session -t "$s" 2>/dev/null
    cwd=$RA; [ "$tag" = B ] && cwd=$RB
    tmux new-session -d -s "$s" -x 120 -y 10 -c "$cwd" 2>/dev/null
    tmux send-keys -t "$s" "node -e 'setInterval(()=>{},1e9)'" Enter; tmux select-pane -t "$s" -T "SEEDPAIR" 2>/dev/null; done
  sleep 1.3
  pcA=$(claudeCode session.current fxs_A:0.0 2>/dev/null); pcB=$(claudeCode session.current fxs_B:0.0 2>/dev/null)
  echo "  per-pane: A=$pcA B=$pcB (expect $UA / $UB, distinct)"
  # 5a ANCHOR: per-pane cwd-disambig already resolves the same-title pair DISTINCTLY (validates seed)
  test.case $level "5a-PER-PANE: same-title pair resolves distinct per-pane (A!=B, correct)" echo "$pcA/$pcB"
  { [ "$pcA" = "$UA" ] && [ "$pcB" = "$UB" ]; } && ok "per-pane distinct ($UA / $UB)" || no "per-pane wrong: A=$pcA B=$pcB"
  # 5b RED: discover.all must resolve the pair to the SAME two distinct uuids (never one)
  if [ "$HAS" != function ]; then
    no "5b-DISTINCT: session.discover.all ABSENT — cannot resolve the seeded pair (RED; gates address-by-pane lift)"
    no "5c-NEVER-ONE: cannot prove two-distinct while discover.all ABSENT (RED)"
  else
    BA=$(claudeCode session.discover.all 2>/dev/null)
    baA=$(printf '%s\n' "$BA" | awk -F'|' '$1=="fxs_A:0.0"{print $2;exit}')
    baB=$(printf '%s\n' "$BA" | awk -F'|' '$1=="fxs_B:0.0"{print $2;exit}')
    echo "  discover.all: A=$baA B=$baB"
    test.case $level "5b-DISTINCT: discover.all resolves the pair == per-pane ($UA / $UB)" echo "$baA/$baB"
    { [ "$baA" = "$UA" ] && [ "$baB" = "$UB" ]; } && ok "discover.all distinct + matches per-pane" || no "discover.all wrong/collapsed: A=$baA B=$baB"
    test.case $level "5c-NEVER-ONE: the two panes NEVER share one uuid (no collapse)" echo "$baA vs $baB"
    { [ -n "$baA" ] && [ "$baA" != "$baB" ]; } && ok "two distinct identities (no same-title collapse)" || no "COLLAPSED to one uuid: A=$baA B=$baB (RED)"
  fi
  cleanup_seed
fi

echo; echo "===== (6) INTERIM-LIFT GATE [oopPO contract (a): TWO DISTINCT, ground-truth = cmdline --resume] ====="
# THE representative dup oopPO measured: ooshTeam:0.3 (RESUMED, cmdline --resume a43c1b23) vs
# diamonds:0.1 (FRESH claude, NO --resume, same role 'oosh-expert' + SAME cwd + diff @host, LIVE).
# Current title+cwd heuristic COLLAPSES both to a43c1b23. Contract: 0.3 -> a43c1b23 AND
# diamonds:0.1 -> NOT a43c1b23 (its own identity, never 0.3's). Ground-truth oracle = the claude
# process cmdline in each pane's subtree. This gates LIFTING the address-by-pane interim.
LP="ooshTeam:0.3"; OP="diamonds:0.1"
# cmdline ground-truth: the --resume/--session-id uuid of the claude proc in <pane>'s pane_pid subtree.
# HARDENED ORACLE (oopPO req, 2026-10-12): read truth by a DIFFERENT METHOD than the resolver so the
# oracle cannot share the resolver's failure (the bug was a `ps -eo`-TEXT leading-space split used by
# BOTH = common-mode → both wrong the same way AGREE = false GREEN). Here: walk the pane_pid subtree
# via `pgrep -P` (kernel/proc, no column parsing) and read each argv from /proc/<pid>/cmdline
# (NUL-separated EXACT argv, zero whitespace parsing). Proven immune by the 6o leading-space seed-proof.
truth_uuid(){ local pane="$1" root; root=$(tmux display-message -t "$pane" -p '#{pane_pid}' 2>/dev/null)
  [ -z "$root" ] && return
  local frontier="$root" next pid cl uuid _d
  for _d in 1 2 3 4 5 6 7 8; do next=""
    for pid in $frontier; do
      cl=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)   # EXACT argv, NUL-split — no ps-text parse
      case "$cl" in *claude*--resume*|*claude*--session-id*)
        uuid=$(printf '%s' "$cl" | grep -oE -- '--(resume|session-id)[ =][0-9a-f-]{36}' | grep -oE '[0-9a-f-]{36}' | head -1)
        [ -n "$uuid" ] && { printf '%s' "$uuid"; return 0; } ;;
      esac
      next="$next $(pgrep -P "$pid" 2>/dev/null | tr '\n' ' ')"
    done
    frontier="$next"; [ -z "$(printf '%s' "$frontier" | tr -d ' ')" ] && break
  done; }

# ── 6o VERIFY-THE-INSTRUMENT (oopPO): the oracle must resolve truth by a method INDEPENDENT of the
# resolver's ps-text parse. Seed a stand-in whose argv[0] carries a LEADING SPACE (the exact trap that
# bit the resolver) + the claude --resume token; the /proc oracle MUST still resolve it. A shared
# ps-text parse would MISS it → false-agree with a broken resolver. This arm proves no common-mode.
if [ "$HAVE_TMUX" -eq 1 ]; then
  O6U="12345678-aaaa-4bbb-8ccc-1234567890ab"
  tmux kill-session -t fxoracle 2>/dev/null
  tmux new-session -d -s fxoracle -x 120 -y 8 2>/dev/null
  tmux send-keys -t fxoracle "exec -a ' claude --resume $O6U' sleep 600" Enter; sleep 0.6
  o6=$(truth_uuid fxoracle:0.0); tmux kill-session -t fxoracle 2>/dev/null
  test.case $level "6o-ORACLE-INDEPENDENT: /proc oracle resolves a LEADING-SPACE argv stand-in (no ps common-mode)" echo "$o6"
  [ "$o6" = "$O6U" ] && ok "independent oracle immune to the ps leading-space bug ($o6)" \
    || no "oracle FAILED on leading-space argv ('$o6') — would share the resolver's common-mode failure (CONFOUNDED instrument, cannot gate)"
else
  test.case $level "6o-ORACLE-INDEPENDENT (skipped — no tmux)" echo skip; expect.pass "skipped"
fi
if ! tmux has-session -t diamonds 2>/dev/null || [ -z "$(tmux list-panes -t "$OP" 2>/dev/null)" ]; then
  test.case $level "6-INTERIM-LIFT (SKIPPED — live dup pane $OP absent; NOT a pass)" echo skip
  no "6-INTERIM-LIFT: $OP not live this run — cannot gate the real dup (loud skip, NOT silent pass; re-run with the dup present or seed two same-role+same-cwd claude panes, one --resume one fresh)"
else
  # GATE = resolver agrees with the INDEPENDENT /proc oracle for BOTH panes (oopPO principle), and
  # neither is mis-attributed to the other. UNIDENTIFIED (empty) is the CORRECT output for a fresh
  # pane (no cmdline --resume) — it is NOT a collapse. (Reconciled 2026-10-12: diamonds:0.1 is now a
  # FRESH `claudeCode new` pane (--model only) titled oosh-expert@v60211 → oracle+resolver both empty.)
  t03=$(truth_uuid "$LP"); tOP=$(truth_uuid "$OP")
  cur03=$(claudeCode session.current "$LP" 2>/dev/null); curOP=$(claudeCode session.current "$OP" 2>/dev/null)
  echo "  $LP oracle=${t03:-∅} resolver=${cur03:-∅} | $OP oracle=${tOP:-∅} resolver=${curOP:-∅}"
  test.case $level "6a-ORACLE: $LP resolver == independent /proc cmdline oracle" echo "$cur03 vs $t03"
  { [ -n "$t03" ] && [ "$cur03" = "$t03" ]; } && ok "$LP resolver matches /proc ground-truth ($t03)" || no "6a-RED: $LP resolver=${cur03:-∅} != /proc oracle ${t03:-∅}"
  test.case $level "6b-ORACLE-MATCH: $OP resolver == independent /proc oracle (UNIDENTIFIED ok)" echo "op-oracle=${tOP:-∅} op-resolver=${curOP:-∅}"
  [ "${curOP:-}" = "${tOP:-}" ] && ok "$OP resolver tells the SAME truth as the independent oracle (${curOP:-UNIDENTIFIED}) — not fabricated" \
    || no "6b-RED: $OP resolver='${curOP:-∅}' != /proc oracle '${tOP:-∅}' (resolver disagrees with ground truth)"
  test.case $level "6b2-NEVER-COLLAPSE: $OP must NOT resolve to $LP's uuid ($cur03)" echo "${curOP:-UNIDENTIFIED}"
  { [ -n "$curOP" ] && [ "$curOP" = "$cur03" ]; } && no "COLLAPSE (RED): $OP resolves to $LP's uuid $cur03 — a live agent mis-identified as another (gates address-by-pane lift)" \
    || ok "$OP NOT collapsed into $LP (resolver='${curOP:-UNIDENTIFIED}')"
  test.case $level "6c-TWO-DISTINCT: the two live panes hold DISTINCT identities (UNIDENTIFIED≠resolved)" echo "$cur03 vs ${curOP:-UNIDENTIFIED}"
  [ "$cur03" != "$curOP" ] && ok "distinct (${cur03:-∅} vs ${curOP:-UNIDENTIFIED})" || no "two live panes share ONE uuid (${cur03:-∅}) — never-exclude contract violated (RED)"
fi

echo; echo "===== (6s) SYNTHETIC INTERIM-LIFT [ALWAYS-RUNNABLE — no dependence on a live dup; oopPO] ====="
# Deterministic reproduction of the real dup (does NOT depend on diamonds:0.1 being alive):
# two panes, SAME cwd + SAME role title (diff @host), a stand-in whose REAL /proc argv is
# `claude --resume <seedA>` (paneA, resumed) vs `claude --model x` (paneB, fresh). Real /proc +
# real tmux + real resolver (not a mock). Expect paneA->seedA, paneB->UNIDENTIFIED (never seedA).
if [ "$HAVE_TMUX" -ne 1 ] || ! command -v node >/dev/null 2>&1; then
  test.case $level "6s-SYNTHETIC (skipped — no tmux)" echo skip; expect.pass "skipped"
else
  cleanup_seed; mkdir -p "$IL_GEN/bin" "$IL_GEN/cwd" "$IL_PROJ"
  RC=$(cd "$IL_GEN/cwd" && pwd -P); SEEDA="11111111-aaaa-4aaa-8aaa-111111111111"
  printf '#!/bin/sh\nwhile :; do sleep 86400; done\n' > "$IL_GEN/bin/claude"; chmod +x "$IL_GEN/bin/claude"
  printf '{"cwd":"%s","type":"x"}\n{"type":"assistant","customTitle":"ilrole@WODA.prod"}\n' "$RC" > "$IL_PROJ/$SEEDA.jsonl"
  tmux new-session -d -s fxsyn_A -x 120 -y 10 -c "$RC" 2>/dev/null
  tmux send-keys -t fxsyn_A "$IL_GEN/bin/claude --resume $SEEDA --model x" Enter; tmux select-pane -t fxsyn_A -T "ilrole@WODA.prod" 2>/dev/null
  tmux new-session -d -s fxsyn_B -x 120 -y 10 -c "$RC" 2>/dev/null
  tmux send-keys -t fxsyn_B "$IL_GEN/bin/claude --model x" Enter; tmux select-pane -t fxsyn_B -T "ilrole@v60211" 2>/dev/null
  sleep 1.3
  tA=$(truth_uuid fxsyn_A:0.0); sA=$(claudeCode session.current fxsyn_A:0.0 2>/dev/null); sB=$(claudeCode session.current fxsyn_B:0.0 2>/dev/null)
  echo "  cmdline-truth(A)=$tA | session.current A=$sA B=$sB (expect A=$SEEDA, B!=$SEEDA)"
  test.case $level "6s-ORACLE: stand-in argv carries --resume seedA (truth==seedA)" echo "$tA"
  [ "$tA" = "$SEEDA" ] && ok "cmdline ground-truth readable ($SEEDA)" || no "stand-in argv not readable: '$tA'"
  test.case $level "6s-A: resumed pane resolves to seedA" echo "$sA"
  [ "$sA" = "$SEEDA" ] && ok "paneA -> seedA" || no "paneA -> '$sA' (expected $SEEDA)"
  test.case $level "6s-B: fresh same-role+same-cwd pane must NOT collapse to seedA" echo "$sB"
  { [ -n "$sB" ] && [ "$sB" != "$SEEDA" ] || [ -z "$sB" ]; } && ok "paneB not mis-attributed to seedA ($sB)" \
    || no "COLLAPSE (RED): paneB -> seedA ($sB) — fresh pane mis-ID'd as the resumed one (interim-lift gate)"
  test.case $level "6s-DISTINCT: the two panes hold DISTINCT identities" echo "$sA vs $sB"
  [ "$sA" != "$sB" ] && ok "distinct" || no "COLLAPSE (RED): both panes -> $sA"
  cleanup_seed
fi

echo; echo "===== (7) PART-B: scrumMaster swipe ctx for EVERY agent [correctness arm — repointed pulse -> swipe] ====="
# 2026-10-28: scrumMaster.pulse REMOVED (6c4e3165); swipe is the only monitor and reads ctx from the ONE
# discover.all map. Contract: every agent row carries a live 'N% (Uk/Dk)' reading OR the honest
# '?ctx-lag(reboot)' deferral (jsonl-lag guard) — never '?ctx-no-jsonl' / parse-fail / — never / traceback.
# Count is checked against the header's agent count (EVERY agent, not just >=1).
TEAM7="${DISCOVER_TEST_TEAM:-ooshTeam}"
t0=$SECONDS; POUT=$(scrumMaster swipe "$TEAM7" 2>&1 | sed 's/\x1b\[[0-9;]*m//g'); dtp=$((SECONDS - t0))
MISS=$(printf '%s\n' "$POUT" | grep -iE 'no-jsonl|parse-fail|— never|traceback|Error:|unknown method' )
NCTX=$(printf '%s\n' "$POUT" | grep -oE '[0-9]+% \(' | wc -l | tr -d ' ')
NLAG=$(printf '%s\n' "$POUT" | grep -c 'ctx-lag')
NAG=$(printf '%s\n' "$POUT" | grep -oE '[0-9]+ agents' | head -1 | grep -oE '^[0-9]+')
echo "  swipe $TEAM7: ${dtp}s, agents=$NAG, ctx-readings=$NCTX, lag-deferrals=$NLAG, missing/err=$(printf '%s' "${MISS:-none}" | head -1)"
test.case $level "7a-CTX-EVERY-AGENT: swipe shows ctx for every agent (readings+lag == agents; no no-jsonl/err)" echo "$NCTX+$NLAG/$NAG"
{ [ -z "$MISS" ] && [ -n "$NAG" ] && [ "$NAG" -ge 1 ] && [ $((NCTX + NLAG)) -eq "$NAG" ]; } \
  && ok "swipe ctx for every agent ($NCTX readings + $NLAG lag of $NAG agents, no missing/err)" \
  || no "swipe ctx incomplete: readings=$NCTX lag=$NLAG agents=${NAG:-?} miss='$(printf '%s' "$MISS" | head -1)'"
test.case $level "7b-SWIPE-PERF: swipe time (DISCLOSED, non-blocking)" echo "$dtp"
if [ "$dtp" -lt 15 ]; then ok "DISCLOSED: swipe ${dtp}s (<=15s)"; else ok "DISCLOSED-OPEN: swipe ${dtp}s (>15s — perf follow-up, NOT ship-blocking)"; fi

echo
echo "=================================================================="
echo "  T-SESSION-DISCOVER-ALL  PASS=$pass FAIL=$fail"
echo "  SHIP (A+B correctness)=EXISTS/SCAN/PARITY/byte-identical/5a/7a ctx-every-agent + no-regression;"
echo "  PERF (2,7b)=DISCLOSED-OPEN non-blocking; (6)/(6s) INTERIM-LIFT=RED-disclosed (separate follow-up)."
echo "=================================================================="
test.suite.save.results
