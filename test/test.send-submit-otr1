#!/usr/bin/env bash
# T-SEND-SUBMIT-OTR1 — gate for the send SUBMISSION-verify + send.submit fix
# (architect f5911d54 + d75b3f72; bug 9fd85fbc) + the GHOST regression-guard (ac4d641a).
#
# ORACLE (deployed contract): SUBMITTED <=> composer.state != staged (empty OR ghost — a dim ghost
# SUGGESTION is NOT staged user input). Only 'staged' = still unsubmitted → bounded re-submit.
# REGRESSION (ac4d641a, expert self-caught in prod): the old oracle was empty-ONLY, so a GHOST
# composer after a real submit read as not-submitted → FALSE rc1 + NOISE re-Enters while the msg
# actually delivered. Guard: a ghost-post-send pane → rc0 SUBMITTED, NO refuse, NO extra re-Enter.
#
# SCENARIOS: (a) OTR-1 submission (short + long-chip bounded-resubmit, no false rc0 while staged);
#   (b) send.submit exists + submit-only; (c) retrain send.raw-stage + send.submit; (d) send.raw pure;
#   (e) GHOST-POST-SEND [regression-guard]: ghost composer => rc0 submitted, no refuse, EXACTLY 1 Enter.
#
# FIXTURE: node Claude-TUI mock (reuses #1 composer-state approach), parameterized:
#   GHOST=1 → after a submit the composer shows a dim ESC[2m suggestion (composer.state=ghost);
#   ECLOG=<file> → the mock appends one line per Enter it receives (counts re-Enters = noise detector).
# Long single-burst (>=600c)+Enter collapses to a paste chip (composer.state stays 'staged').

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"
source this
source test.suite
source otmux >/dev/null 2>&1
log.level $level
HAVE_TMUX=0; [ -n "$TMUX" ] && HAVE_TMUX=1

GEN="${OOSH_DIR}/test/gen/t-send-submit-otr1"; MOCK="${GEN}/mock.js"; ECLOG="${GEN}/enters.log"
FX_PREFIX="fxo_"
sweep_fixtures(){ tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" \
  | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; }
trap sweep_fixtures EXIT

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }
submitted(){ [ "$1" != staged ] && [ -n "$1" ]; }   # deployed contract: empty OR ghost = submitted

sweep_fixtures
mkdir -p "$GEN" 2>/dev/null

if [ "$HAVE_TMUX" -ne 1 ] || ! command -v node >/dev/null 2>&1; then
  test.case $level "T-SEND-SUBMIT-OTR1 (skipped — no tmux/node)" echo skip; expect.pass "skipped"
  test.suite.save.results; return 0 2>/dev/null || exit 0
fi

cat > "$MOCK" <<'JS'
const fs=require('fs');
let buf='', chip=false; const GHOST=process.env.GHOST==='1'; const EC=process.env.ECLOG;
process.stdin.setRawMode&&process.stdin.setRawMode(true); process.stdin.resume();
function render(status){
  process.stdout.write('\x1b[2J\x1b[H');
  if(chip) process.stdout.write('❯ [Pasted text #1 +12 lines]\npaste again to expand\n');
  else if(GHOST && buf==='') process.stdout.write('❯ \x1b[2mtry: read foo.md\x1b[0m\n');  // ghost suggestion after submit
  else process.stdout.write('❯ '+buf+'\n');
  if(status) process.stdout.write(status+'\n');
}
process.stdin.on('data',d=>{ const s=d.toString();
  for(const ch of s){
    if(ch==='\x15'){ buf=''; chip=false; }
    else if(ch==='\r'||ch==='\n'){
      if(EC) try{fs.appendFileSync(EC,'E\n');}catch(e){}        // count every Enter (noise detector)
      if(!chip && buf.length>=600){ chip=true; render(''); }    // long 1st Enter -> chip (staged)
      else { buf=''; chip=false; render('esc to interrupt'); }  // short / 2nd Enter -> submit
    } else buf+=ch;
  }
  if(!/[\r\n]/.test(s)) render('');
});
render('');
JS

plant(){ local s="${FX_PREFIX}$1"; local ghost="$2"; tmux kill-session -t "$s" 2>/dev/null
  tmux new-session -d -s "$s" -x 160 -y 14 2>/dev/null || { echo ""; return 1; }
  : > "$ECLOG"
  tmux send-keys -t "$s" "GHOST=${ghost:-0} ECLOG='$ECLOG' node '$MOCK'" Enter; sleep 1.3; echo "${s}:0.0"; }
state(){ otmux composer.state "$1" 2>/dev/null; }

echo; echo "===== PRECOND ====="
P=$(plant pre 0); cmd=$(tmux display-message -t "$P" -p '#{pane_current_command}' 2>/dev/null)
test.case $level "PRECOND: node pane + composer empty at rest" echo "$cmd/$(state "$P")"
{ [ "$cmd" = node ] && [ "$(state "$P")" = empty ]; } && ok "isClaudeCode node, composer empty" || no "precond bad: cmd=$cmd state=$(state "$P")"

echo; echo "===== (a) OTR-1 SUBMISSION (submitted = NOT staged) ====="
P=$(plant a1 0); otmux send.verified "$P" "short order foo" >/dev/null 2>&1; a1s=$(state "$P")
test.case $level "a1: short send.verified -> SUBMITTED (not staged)" echo "$a1s"
submitted "$a1s" && ok "short submitted (state=$a1s)" || no "short not submitted: state=$a1s"
P=$(plant a2 0); LONG=$(printf 'X%.0s' $(seq 1 800)); otmux send.verified "$P" "$LONG" >/dev/null 2>&1; a2rc=$?; a2s=$(state "$P")
echo "  long: rc=$a2rc state=$a2s"
test.case $level "a2-SUBMIT: long send -> SUBMITTED (bounded re-submit cleared the chip)" echo "$a2s"
submitted "$a2s" && ok "long submitted (state=$a2s)" || no "long STAYED staged (chip, never submitted)"
test.case $level "a2-NO-FALSE-POS: NOT(rc0 while still staged)" echo "rc=$a2rc st=$a2s"
{ [ "$a2rc" -eq 0 ] && [ "$a2s" = staged ]; } && no "FALSE-POSITIVE: rc0 while staged" || ok "no false rc0 (rc=$a2rc st=$a2s)"

echo; echo "===== (b) send.submit EXISTS + submit-only ====="
has=$(type -t otmux.send.submit 2>/dev/null)
test.case $level "b-EXISTS: otmux.send.submit is a function" echo "$has"
[ "$has" = function ] && ok "send.submit defined" || no "send.submit ABSENT"
if [ "$has" = function ]; then
  body=$(sed -n '/^otmux.send.submit()/,/^}/p' "$OOSH_DIR/otmux")
  test.case $level "b-PURE: send.submit has no C-u/Escape (submit-only)" echo checking
  echo "$body" | grep -qiE 'C-u|Escape|BTab' && no "send.submit does destructive pre-clear" || ok "send.submit submit-only"
fi

echo; echo "===== (c) RETRAIN: send.raw stage + send.submit -> submitted ====="
P=$(plant c 0); otmux send.raw "$P" "foo" >/dev/null 2>&1; sleep 0.4; cPre=$(state "$P")
otmux send.submit "$P" >/dev/null 2>&1; sleep 0.4; cPost=$(state "$P")
test.case $level "c-STAGE: send.raw 'foo' leaves it staged" echo "$cPre"
[ "$cPre" = staged ] && ok "send.raw staged (pure)" || no "send.raw not staged: $cPre"
test.case $level "c-SUBMIT: send.submit submits (not staged)" echo "$cPost"
submitted "$cPost" && ok "send.submit submitted (state=$cPost)" || no "send.submit did not submit: $cPost"

echo; echo "===== (d) send.raw stays PURE ====="
RAW=$(sed -n '/^otmux.send.raw()/,/^}/p' "$OOSH_DIR/otmux")
test.case $level "d: send.raw body has no submission/chip logic" echo checking
echo "$RAW" | grep -qiE 'paste again|chip|composer.state|re-?enter|submit' && no "send.raw gained submission logic" || ok "send.raw pure-raw"

echo; echo "===== (e) GHOST-POST-SEND regression-guard (ac4d641a): ghost => rc0, no refuse, EXACTLY 1 Enter ====="
P=$(plant e 1)                                   # GHOST=1: composer shows a dim suggestion after submit
: > "$ECLOG"
otmux send.verified "$P" "hello ghost" >/dev/null 2>&1; eRC=$?; eS=$(state "$P")
nEnter=$(grep -c . "$ECLOG" 2>/dev/null)
echo "  rc=$eRC post-state=$eS enters=$nEnter"
test.case $level "e-STATE: ghost-post-send is ghost (regression surface)" echo "$eS"
[ "$eS" = ghost ] && ok "composer ends ghost (the regression state)" || no "fixture didn't reach ghost: $eS"
test.case $level "e-SUBMITTED: send.verified treats ghost as SUBMITTED (rc0)" echo "$eRC"
[ "$eRC" -eq 0 ] && ok "ghost => rc0 submitted (not a false rc1)" || no "FALSE rc1 on ghost (rc=$eRC) — regression"
test.case $level "e-NO-NOISE: EXACTLY 1 Enter (no noise re-Enter on ghost)" echo "$nEnter"
[ "${nEnter:-0}" -eq 1 ] && ok "no noise re-Enter (1 Enter)" || no "noise re-Enters on ghost: $nEnter Enters (regression)"

echo
echo "=================================================================="
echo "  T-SEND-SUBMIT-OTR1  PASS=$pass FAIL=$fail  (expect ALL GREEN on deployed ac4d641a incl ghost-guard)"
echo "=================================================================="
sweep_fixtures
test.suite.save.results
