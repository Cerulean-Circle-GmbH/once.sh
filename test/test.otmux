#!/usr/bin/env bash
# Tests for the otmux tmux wrapper script
# Tests read-only methods against live tmux sessions

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source $OOSH_DIR/otmux

log.level $level

# Disable STEP_DEBUG to prevent test blocking
ORIGINAL_STEP_DEBUG=$STEP_DEBUG
export STEP_DEBUG=OFF

# ============================================================================
# T1: otmux.version returns tmux version string
# ============================================================================
test.case $level "T1: otmux.version returns version string" \
  otmux.version

OUTPUT=$(otmux.version 2>/dev/null)
if echo "$OUTPUT" | grep -qi "tmux"; then
  expect.pass "version contains 'tmux'"
else
  expect.fail "expected version string with 'tmux', got: $OUTPUT"
fi

# ============================================================================
# T2: otmux.v is alias for version
# ============================================================================
test.case $level "T2: otmux.v returns same as version" \
  otmux.v

V_OUTPUT=$(otmux.v 2>/dev/null)
VERSION_OUTPUT=$(otmux.version 2>/dev/null)
if [ "$V_OUTPUT" = "$VERSION_OUTPUT" ]; then
  expect.pass "v matches version"
else
  expect.fail "v='$V_OUTPUT' != version='$VERSION_OUTPUT'"
fi

# ============================================================================
# T3: otmux.sessions lists sessions
# ============================================================================
test.case $level "T3: otmux.sessions lists active sessions" \
  otmux.sessions

OUTPUT=$(otmux.sessions 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "sessions returned output"
else
  expect.fail "sessions returned empty"
fi

# ============================================================================
# T4: otmux.session.list is alias for sessions
# ============================================================================
test.case $level "T4: otmux.session.list matches sessions" \
  otmux.session.list

LIST_OUTPUT=$(otmux.session.list 2>/dev/null)
SESSIONS_OUTPUT=$(otmux.sessions 2>/dev/null)
if [ "$LIST_OUTPUT" = "$SESSIONS_OUTPUT" ]; then
  expect.pass "session.list matches sessions"
else
  expect.fail "outputs differ"
fi

# ============================================================================
# T5: otmux.has returns 0 for existing session
# ============================================================================
# Get first session name from live sessions
FIRST_SESSION=$(tmux -u list-sessions -F "#{session_name}" 2>/dev/null | head -1)

test.case $level "T5: otmux.has returns 0 for existing session" \
  otmux.has "$FIRST_SESSION"

if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "has returns 0 for '$FIRST_SESSION'"
else
  expect.fail "has returned $RETURN_VALUE for existing session '$FIRST_SESSION'"
fi

# ============================================================================
# T6: otmux.has returns non-zero for non-existent session
# ============================================================================
test.case $level "T6: otmux.has returns non-zero for fake session" \
  otmux.has "nonexistent_session_$$_test"

if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "has returns non-zero for fake session"
else
  expect.fail "has returned 0 for non-existent session"
fi

# ============================================================================
# T7: otmux.session.has is alias for has
# ============================================================================
test.case $level "T7: otmux.session.has works like has" \
  otmux.session.has "$FIRST_SESSION"

if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "session.has returns 0 for existing session"
else
  expect.fail "session.has returned $RETURN_VALUE"
fi

# ============================================================================
# T8: otmux.panes lists panes
# ============================================================================
test.case $level "T8: otmux.panes lists panes" \
  otmux.panes

OUTPUT=$(otmux.panes 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "panes returned output"
else
  expect.fail "panes returned empty"
fi

# ============================================================================
# T9: otmux.pane.list lists panes for a session
# ============================================================================
test.case $level "T9: otmux.pane.list lists panes for session" \
  otmux.pane.list "$FIRST_SESSION"

OUTPUT=$(otmux.pane.list "$FIRST_SESSION" 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "pane.list returned output for '$FIRST_SESSION'"
else
  expect.fail "pane.list returned empty"
fi

# ============================================================================
# T10: otmux.pane.capture captures pane content
# ============================================================================
# Get a valid pane target
FIRST_PANE=$(tmux -u list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null | head -1)

test.case $level "T10: otmux.pane.capture returns content" \
  otmux.pane.capture "$FIRST_PANE" 5

OUTPUT=$(otmux.pane.capture "$FIRST_PANE" 5 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "pane.capture returned content"
else
  # Empty pane is valid — check that exit code was 0
  if [ "$RETURN_VALUE" -eq 0 ]; then
    expect.pass "pane.capture succeeded (pane may be empty)"
  else
    expect.fail "pane.capture failed with code $RETURN_VALUE"
  fi
fi

# ============================================================================
# T11: otmux.pane.capture fails without target
# ============================================================================
test.case $level "T11: otmux.pane.capture fails without target" \
  otmux.pane.capture

if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "pane.capture returns error without target"
else
  expect.fail "pane.capture should fail without target"
fi

# ============================================================================
# T12: otmux.tree outputs formatted session tree
# ============================================================================
test.case $level "T12: otmux.tree shows session tree" \
  otmux.tree

OUTPUT=$(otmux.tree 2>/dev/null)
if echo "$OUTPUT" | grep -q "tmux sessions"; then
  expect.pass "tree shows 'tmux sessions' header"
else
  expect.fail "tree missing header, got: $(echo "$OUTPUT" | head -1)"
fi

# ============================================================================
# T13: otmux.status is alias for tree
# ============================================================================
test.case $level "T13: otmux.status matches tree" \
  otmux.status

STATUS_OUTPUT=$(otmux.status 2>/dev/null)
TREE_OUTPUT=$(otmux.tree 2>/dev/null)
if [ "$STATUS_OUTPUT" = "$TREE_OUTPUT" ]; then
  expect.pass "status matches tree"
else
  expect.fail "status and tree differ"
fi

# ============================================================================
# T14: otmux.usage shows help text
# ============================================================================
test.case $level "T14: otmux.usage shows help" \
  otmux.usage

OUTPUT=$(otmux.usage 2>/dev/null)
if echo "$OUTPUT" | grep -q "Usage:"; then
  expect.pass "usage contains 'Usage:'"
else
  expect.fail "usage missing 'Usage:', got: $(echo "$OUTPUT" | head -3)"
fi

# ============================================================================
# T15: otmux.help outputs help text
# ============================================================================
test.case $level "T15: otmux.help shows tmux help" \
  otmux.help

OUTPUT=$(otmux.help 2>/dev/null)
if echo "$OUTPUT" | grep -q "man tmux"; then
  expect.pass "help references 'man tmux'"
else
  expect.fail "help missing man reference"
fi

# ============================================================================
# T16: otmux.session.details shows session info
# ============================================================================
test.case $level "T16: otmux.session.details shows session detail" \
  otmux.session.details "$FIRST_SESSION"

OUTPUT=$(otmux.session.details "$FIRST_SESSION" 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "session.details returned output"
else
  expect.fail "session.details returned empty"
fi

# ============================================================================
# T17: otmux.windows lists windows
# ============================================================================
test.case $level "T17: otmux.windows lists windows" \
  otmux.windows

OUTPUT=$(otmux.windows 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "windows returned output"
else
  expect.fail "windows returned empty"
fi

# ============================================================================
# T18: otmux.config.show returns tmux options
# ============================================================================
test.case $level "T18: otmux.config.show returns options" \
  otmux.config.show

OUTPUT=$(otmux.config.show 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "config.show returned options"
else
  expect.fail "config.show returned empty"
fi

# ============================================================================
# T19: otmux.config.show.global returns global options
# ============================================================================
test.case $level "T19: otmux.config.show.global returns global options" \
  otmux.config.show.global

OUTPUT=$(otmux.config.show.global 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "config.show.global returned options"
else
  expect.fail "config.show.global returned empty"
fi

# ============================================================================
# T20: otmux.commands lists tmux commands
# ============================================================================
test.case $level "T20: otmux.commands lists tmux commands" \
  otmux.commands

OUTPUT=$(otmux.commands 2>/dev/null)
if echo "$OUTPUT" | grep -q "send-keys"; then
  expect.pass "commands includes 'send-keys'"
else
  expect.fail "commands missing 'send-keys'"
fi

# ============================================================================
# T21: c2 completion lists otmux methods
# ============================================================================
test.case $level "T21: c2 completion lists otmux methods" \
  echo "checking completion"

COMP_OUTPUT=$(./c2 function.completion ./otmux 2>/dev/null)
if echo "$COMP_OUTPUT" | grep -q "sessions" && \
   echo "$COMP_OUTPUT" | grep -q "panes" && \
   echo "$COMP_OUTPUT" | grep -q "send"; then
  create.result 0 "completion lists key methods"
else
  create.result 1 "completion missing methods"
fi
expect 0 "completion lists key methods" "c2 lists otmux methods"

# ============================================================================
# T22: c2 completion lists sub-methods (pane.*)
# ============================================================================
test.case $level "T22: c2 completion lists pane sub-methods" \
  echo "checking sub-completion"

COMP_OUTPUT=$(./c2 function.completion ./otmux pane 2>/dev/null)
if echo "$COMP_OUTPUT" | grep -q "pane.capture" && \
   echo "$COMP_OUTPUT" | grep -q "pane.list"; then
  create.result 0 "pane sub-methods listed"
else
  create.result 1 "pane sub-methods missing: $COMP_OUTPUT"
fi
expect 0 "pane sub-methods listed" "c2 lists pane.* sub-methods"

# ============================================================================
# T23: otmux.server.info returns server info
# ============================================================================
test.case $level "T23: otmux.server.info returns info" \
  otmux.server.info

OUTPUT=$(otmux.server.info 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "server.info returned output"
else
  expect.fail "server.info returned empty"
fi

# ============================================================================
# T24: otmux.env.show returns environment
# ============================================================================
test.case $level "T24: otmux.env.show returns environment" \
  otmux.env.show

OUTPUT=$(otmux.env.show 2>/dev/null)
if [ -n "$OUTPUT" ]; then
  expect.pass "env.show returned output"
else
  expect.fail "env.show returned empty"
fi

# ============================================================================
# T25: TMUX_CMD uses -u flag (UTF-8 mode)
# ============================================================================
test.case $level "T25: TMUX_CMD includes -u for UTF-8" \
  echo "$TMUX_CMD"

if echo "$TMUX_CMD" | grep -q "\-u"; then
  expect.pass "TMUX_CMD='$TMUX_CMD' has -u flag"
else
  expect.fail "TMUX_CMD='$TMUX_CMD' missing -u flag"
fi

# ============================================================================
# Setup: create a dedicated test session for save/restore tests
# ============================================================================
SAVE_TEST_SESSION="otmux_savetest_$$"
SAVE_FILE="/tmp/otmux_test_save_$$.tmux"
tmux -u new-session -d -s "$SAVE_TEST_SESSION" -c "/tmp"

# ============================================================================
# T26: otmux.session.save fails without arguments
# ============================================================================
test.case $level "T26: otmux.session.save fails without arguments" \
  otmux.session.save

if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "session.save returns error without arguments"
else
  expect.fail "session.save should fail without arguments"
fi

# ============================================================================
# T27: otmux.session.save fails for non-existent session
# ============================================================================
test.case $level "T27: otmux.session.save fails for fake session" \
  otmux.session.save "nonexistent_session_$$" "/tmp/otmux_test_$$.tmux"

if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "session.save returns error for fake session"
else
  expect.fail "session.save should fail for non-existent session"
fi

# ============================================================================
# T28: otmux.session.save creates topology file
# ============================================================================
test.case $level "T28: otmux.session.save creates topology file" \
  otmux.session.save "$SAVE_TEST_SESSION" "$SAVE_FILE"

if [ -f "$SAVE_FILE" ]; then
  expect.pass "topology file created: $SAVE_FILE"
else
  expect.fail "topology file not created"
fi

# ============================================================================
# T29: saved topology file contains SESSION variable
# ============================================================================
test.case $level "T29: topology file contains SESSION variable" \
  echo "checking topology content"

if grep -q "^SESSION=" "$SAVE_FILE" 2>/dev/null; then
  expect.pass "SESSION variable found in topology"
else
  expect.fail "SESSION variable missing from topology"
fi

# ============================================================================
# T30: saved topology file contains WINDOW_COUNT
# ============================================================================
test.case $level "T30: topology file contains WINDOW_COUNT" \
  echo "checking WINDOW_COUNT"

if grep -q "^WINDOW_COUNT=" "$SAVE_FILE" 2>/dev/null; then
  expect.pass "WINDOW_COUNT found in topology"
else
  expect.fail "WINDOW_COUNT missing from topology"
fi

# ============================================================================
# T31: saved topology file contains pane directories
# ============================================================================
test.case $level "T31: topology file contains pane directories" \
  echo "checking pane dirs"

if grep -q "W0_P0_DIR=" "$SAVE_FILE" 2>/dev/null; then
  expect.pass "W0_P0_DIR found in topology"
else
  expect.fail "W0_P0_DIR missing from topology"
fi

# ============================================================================
# T32: saved topology file is sourceable
# ============================================================================
test.case $level "T32: topology file is sourceable bash" \
  echo "checking sourceable"

bash -n "$SAVE_FILE" 2>/dev/null
if [ $? -eq 0 ]; then
  expect.pass "topology file passes bash syntax check"
else
  expect.fail "topology file has syntax errors"
fi

# ============================================================================
# T33: otmux.session.restore fails without arguments
# ============================================================================
test.case $level "T33: otmux.session.restore fails without arguments" \
  otmux.session.restore

if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "session.restore returns error without arguments"
else
  expect.fail "session.restore should fail without arguments"
fi

# ============================================================================
# T34: otmux.session.restore fails for non-existent file
# ============================================================================
test.case $level "T34: otmux.session.restore fails for missing file" \
  otmux.session.restore "/tmp/nonexistent_file_$$"

if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "session.restore returns error for missing file"
else
  expect.fail "session.restore should fail for missing file"
fi

# ============================================================================
# T35: otmux.session.restore refuses to clobber existing session
# ============================================================================
test.case $level "T35: otmux.session.restore refuses to clobber" \
  otmux.session.restore "$SAVE_FILE"

# SAVE_FILE contains SAVE_TEST_SESSION which still exists
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "session.restore refuses to clobber existing session"
else
  expect.fail "session.restore should refuse to clobber"
fi

# Cleanup the save test session
tmux -u kill-session -t "$SAVE_TEST_SESSION" 2>/dev/null

# ============================================================================
# T36: save/restore round-trip creates matching session
# ============================================================================
# Create a test session, save it, kill it, restore it, verify
TEST_SESSION="otmux_roundtrip_$$"
ROUNDTRIP_FILE="/tmp/otmux_roundtrip_$$.tmux"

# Create test session with 2 panes (use dynamic window index for base-index compat)
tmux -u new-session -d -s "$TEST_SESSION" -c "/tmp"
TEST_FIRST_WIN=$(tmux -u list-windows -t "$TEST_SESSION" -F "#{window_index}" 2>/dev/null | head -1)
tmux -u split-window -t "$TEST_SESSION:$TEST_FIRST_WIN" -c "/tmp"

test.case $level "T36: save/restore round-trip" \
  otmux.session.save "$TEST_SESSION" "$ROUNDTRIP_FILE"

# Count original panes
ORIG_PANE_COUNT=$(tmux -u list-panes -t "$TEST_SESSION" -F "#{pane_index}" 2>/dev/null | wc -l | tr -d ' ')

# Kill the test session
tmux -u kill-session -t "$TEST_SESSION" 2>/dev/null

# Restore it
otmux.session.restore "$ROUNDTRIP_FILE"

if tmux -u has-session -t "$TEST_SESSION" 2>/dev/null; then
  RESTORED_PANE_COUNT=$(tmux -u list-panes -t "$TEST_SESSION" -F "#{pane_index}" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$ORIG_PANE_COUNT" = "$RESTORED_PANE_COUNT" ]; then
    expect.pass "round-trip: $ORIG_PANE_COUNT panes preserved"
  else
    expect.fail "pane count mismatch: orig=$ORIG_PANE_COUNT restored=$RESTORED_PANE_COUNT"
  fi
  # Cleanup: kill the restored test session
  tmux -u kill-session -t "$TEST_SESSION" 2>/dev/null
else
  expect.fail "restored session not found"
fi

# Cleanup temp files
rm -f "$SAVE_FILE" "$ROUNDTRIP_FILE"

# ============================================================================
# Cleanup
# ============================================================================
export STEP_DEBUG=$ORIGINAL_STEP_DEBUG

test.suite.save.results
