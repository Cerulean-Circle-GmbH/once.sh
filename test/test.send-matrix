#!/usr/bin/env bash
# T-SEND-MATRIX — the exhaustive otmux-send regression guard (architect 2a6e3fa,
# spec: scrum.pmo/sprints/sprint-2/task-s2-g.5). 11 groups / 50 cells; SUPERSET
# of T-DISPATCH-SUBMIT(5) + T-SEND-SESSION(3) → zero regression.
#
# PRIORITY CELLS FIRST (PO): D3 (never-duplicate) + E5 (prefix-exactly-once) —
# the guards for the LIVE "all messages duplicate" regression. RED now (dup live
# on the claude path); the expert's double-invoke fix greens them = the cure is
# verified.
#
# Testability tags: [S]=static source-assert · [B]=behavioral (real tmux pane)
# · [I]=isolated planted fixture. Live claude ❯ state isn't forgeable, so claude
# cells use an [I] FAKE-CLAUDE fixture: a binary named `claude` (= cat) so
# `pane_current_command==claude` → isClaudeCode → the CLAUDE path (prefix+verify
# +submit), while cat echoes the delivered keystrokes so duplication is visible.
# FULL ISOLATION: scratch sessions + temp bin; the live registry is never touched.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

OTMUX_SRC="$OOSH_DIR/otmux"
WORK="${TMPDIR:-/tmp}/test.send-matrix.$$"
mkdir -p "$WORK/bin"
CFG="${CONFIG_PATH:-$HOME/config}"
LIVE_SESS="$CFG/hivemind.sessions.env"
LIVE_MD5_BEFORE=$( [ -f "$LIVE_SESS" ] && md5sum "$LIVE_SESS" | cut -d' ' -f1 || echo none )

HAVE_TMUX=1
[ -z "$(command -v tmux)" ] && HAVE_TMUX=0

# ── [I] fake-claude fixture: a pane whose pane_current_command is `claude` ────
# so isClaudeCode → the CLAUDE send path fires; cat echoes typed keys → any
# duplicate keystroke shows up verbatim in the pane.
cp /bin/cat "$WORK/bin/claude" 2>/dev/null
FC_SESSION=""; FC_PANE=""
mk_fake_claude() {   # <tag> → sets FC_SESSION / FC_PANE
  FC_SESSION="__smfc_${1}_$$"
  tmux new-session -d -s "$FC_SESSION" -x 100 -y 30 2>/dev/null || return 1
  FC_PANE="${FC_SESSION}:0.0"
  # `stty -echo` FIRST: with terminal echo ON, a single send counts 2 (input
  # echo + cat's stdout) — a false positive. With echo OFF only the program's
  # STDOUT is captured, so the count == times the message was actually DELIVERED
  # (1 correct, 2 = real duplication). (expert 4808a6d)
  tmux send-keys -t "$FC_PANE" "stty -echo; PATH=$WORK/bin:\$PATH claude" Enter
  sleep 1
  [ "$(tmux display-message -t "$FC_PANE" -p '#{pane_current_command}' 2>/dev/null)" = "claude" ]
}
rm_fake_claude() { [ -n "$FC_SESSION" ] && tmux kill-session -t "$FC_SESSION" 2>/dev/null; }
fc_capture() { tmux capture-pane -t "$FC_PANE" -p 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g'; }

# ============================================================================
# D3 [B/I] — NEVER DUPLICATE. A single send delivers the message EXACTLY ONCE
# (submit/poke are text-free & idempotent — not N×). With the stty -echo fixture
# the count == times DELIVERED (1 correct, 2 = real dup). VERIFIED: otmux send
# delivers ONCE (count 1). (My first pass counted 2 with echo ON — a fixture
# artifact, not a dup; expert 4808a6d caught it. The discriminator now holds:
# single send=1, two-raw-send control=2.)
# ============================================================================
if [ "$HAVE_TMUX" -eq 1 ] && mk_fake_claude d3; then
  D3="D3MARK_$$"
  otmux send "$FC_PANE" "$D3" >/dev/null 2>&1
  sleep 1.5
  D3N=$(fc_capture | grep -c "$D3")
  test.case $level "D3: send delivers the message EXACTLY ONCE (never duplicate)" \
    echo "count=$D3N"
  if [ "${D3N:-0}" -eq 1 ]; then
    expect.pass "message delivered once (no duplication)"
  else
    expect.fail "message DUPLICATED: delivered ${D3N}× (want 1) [live double-invoke regression]"
  fi
  rm_fake_claude
else
  test.case $level "D3: (skipped — no tmux/fixture)" echo "skip"; expect.pass "skipped"
fi

# ============================================================================
# E5 [B/I] — SENDER PREFIX EXACTLY ONCE (BUG9 idempotent-prefix). `[@role pane]`
# appears once and only once in the delivered text (counted from the program's
# stdout, echo off). VERIFIED: prefix count 1. A real double-invoke would show 2.
# ============================================================================
if [ "$HAVE_TMUX" -eq 1 ] && mk_fake_claude e5; then
  E5="E5MARK_$$"
  otmux send "$FC_PANE" "$E5" >/dev/null 2>&1
  sleep 1.5
  # count [@ prefixes on the delivered marker line(s) — once per delivered copy
  E5N=$(fc_capture | grep "$E5" | grep -o '\[@' | wc -l | tr -d ' ')
  test.case $level "E5: sender prefix appears EXACTLY ONCE (never doubled)" \
    echo "prefixCount=$E5N"
  if [ "${E5N:-0}" -eq 1 ]; then
    expect.pass "[@…] prefix delivered exactly once"
  else
    expect.fail "prefix count=$E5N (want 1) — doubled prefix / duplicated send [BUG9/double-invoke]"
  fi
  rm_fake_claude
else
  test.case $level "E5: (skipped — no tmux/fixture)" echo "skip"; expect.pass "skipped"
fi

# ── E5-GUARD [S] — the idempotent-prefix guard exists: already-`[@`-prefixed
# text is NOT re-prefixed (so poke/re-send can never add a second prefix). ─────
GUARD=$(sed -n '/# Step 2: Add sender prefix/,/prefix.*text/p' "$OTMUX_SRC" | grep -E '\!= \\\[@' )
[ -z "$GUARD" ] && GUARD=$(grep -E 'text.*!=.*\\\[@|\!\= \\\[@\*' "$OTMUX_SRC")
test.case $level "E5-GUARD: send.smart guards against re-prefixing already-[@ text" \
  echo "guard=$(printf '%s' "$GUARD" | head -1)"
if [ -n "$GUARD" ]; then
  expect.pass "idempotent-prefix guard present ([[ text != [@* ]] — BUG9)"
else
  expect.fail "no idempotent-prefix guard in send.smart — a second prefix could be added"
fi

# ============================================================================
# A2 [B] — bare shell → kind=shell → non-claude path → NO prefix (also E3).
# ============================================================================
if [ "$HAVE_TMUX" -eq 1 ] && tmux new-session -d -s "__sma2_$$" -x 100 -y 30 2>/dev/null; then
  A2P="__sma2_$$:0.0"
  tmux send-keys -t "$A2P" "PS1='oosh > '" Enter; sleep 0.6
  A2M="A2MARK_$$"
  otmux send "$A2P" "echo $A2M" >/dev/null 2>&1
  sleep 1
  A2CAP=$(tmux capture-pane -t "$A2P" -p 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g')
  A2_OUT=$(printf '%s\n' "$A2CAP" | grep -cE "^${A2M}$")
  A2_PFX=$(printf '%s\n' "$A2CAP" | grep "$A2M" | grep -o '\[@' | wc -l | tr -d ' ')
  test.case $level "A2/E3: shell target → non-claude path, NO prefix, delivered once" \
    echo "out=$A2_OUT prefix=$A2_PFX"
  if [ "${A2_OUT:-0}" -ge 1 ] && [ "${A2_PFX:-0}" -eq 0 ]; then
    expect.pass "shell send dispatched, zero [@ prefix (E3), no dup"
  else
    expect.fail "shell send wrong: out=$A2_OUT prefix=$A2_PFX (want out>=1 prefix=0)"
  fi
  tmux kill-session -t "__sma2_$$" 2>/dev/null
else
  test.case $level "A2/E3: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
fi

# ============================================================================
# G3 [S] — the send message path issues NO pkill/pattern-kill (BUG6 scar):
# send dispatches keys only, never reaps processes.
# ============================================================================
G3_PKILL=$(sed -n '/private.otmux.send.smart()/,/^}/p' "$OTMUX_SRC" | grep -cE 'pkill')
test.case $level "G3: send path issues NO pkill (never reaps — BUG6 hazard guard)" \
  echo "pkill=$G3_PKILL"
if [ "${G3_PKILL:-0}" -eq 0 ]; then
  expect.pass "send.smart contains zero pkill — dispatches keys only"
else
  expect.fail "send.smart contains $G3_PKILL pkill call(s) — BUG6 hazard"
fi

# ============================================================================
# K6 [S] — send.raw is the KEY primitive: its body invokes NONE of the message
# contract (prefix / verify / poke / queue). A key ≠ a message, by construction.
# ============================================================================
RAW_BODY=$(sed -n '/^otmux.send.raw()/,/^}/p' "$OTMUX_SRC")
K6_VIOL=$(printf '%s\n' "$RAW_BODY" | grep -cE 'send\.prefix|send\.verify|send\.poke|queue\.(enqueue|drain)')
test.case $level "K6: send.raw invokes no prefix/verify/poke/queue (key ≠ message)" \
  echo "contractCalls=$K6_VIOL"
if [ "${K6_VIOL:-0}" -eq 0 ]; then
  expect.pass "send.raw is key-only — no message-contract calls"
else
  expect.fail "send.raw calls the message contract ($K6_VIOL) — a key must not be a message"
fi

# ============================================================================
# K1 [B] — send.raw <pane> Enter is a raw KEY event: NO prefix added, message
# delivered verbatim (no [@…]), single dispatch.
# ============================================================================
if [ "$HAVE_TMUX" -eq 1 ] && tmux new-session -d -s "__smk1_$$" -x 100 -y 30 2>/dev/null; then
  K1P="__smk1_$$:0.0"
  tmux send-keys -t "$K1P" "PS1='oosh > '" Enter; sleep 0.6
  K1M="K1MARK_$$"
  otmux send.raw "$K1P" "echo $K1M" Enter >/dev/null 2>&1
  sleep 1
  K1CAP=$(tmux capture-pane -t "$K1P" -p 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g')
  K1_OUT=$(printf '%s\n' "$K1CAP" | grep -cE "^${K1M}$")
  K1_PFX=$(printf '%s\n' "$K1CAP" | grep "$K1M" | grep -o '\[@' | wc -l | tr -d ' ')
  test.case $level "K1: send.raw <pane> ... Enter = raw key event (no prefix, single)" \
    echo "out=$K1_OUT prefix=$K1_PFX"
  if [ "${K1_OUT:-0}" -eq 1 ] && [ "${K1_PFX:-0}" -eq 0 ]; then
    expect.pass "send.raw dispatched once, no prefix (key event, not a message)"
  else
    expect.fail "send.raw wrong: out=$K1_OUT prefix=$K1_PFX (want out=1 prefix=0)"
  fi
  tmux kill-session -t "__smk1_$$" 2>/dev/null
else
  test.case $level "K1: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
fi

# ── Isolation assertion: the live session registry was NEVER mutated ─────────
LIVE_MD5_AFTER=$( [ -f "$LIVE_SESS" ] && md5sum "$LIVE_SESS" | cut -d' ' -f1 || echo none )
test.case $level "ISOLATION: live sessions.env untouched by the send-matrix run" \
  echo "before=$LIVE_MD5_BEFORE after=$LIVE_MD5_AFTER"
if [ "$LIVE_MD5_BEFORE" = "$LIVE_MD5_AFTER" ]; then
  expect.pass "live registry md5 unchanged — zero real-agent disturbance"
else
  expect.fail "live sessions.env CHANGED: $LIVE_MD5_BEFORE → $LIVE_MD5_AFTER"
fi

# ── Cleanup ──────────────────────────────────────────────────────────────────
rm -rf "$WORK" 2>/dev/null

echo ""
echo "=== T-SEND-MATRIX (D3 + E5 priority cells) complete ==="
echo ""

test.suite.save.results
