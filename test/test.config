#!/usr/bin/env bash
# Comprehensive tests for the config script
# Tests: init, file, save, list, get, set, add, update, clean, delete, discover

#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source config

log.level $level

# Save original config state
ORIGINAL_CONFIG=$CONFIG
ORIGINAL_CONFIG_PATH=$CONFIG_PATH
ORIGINAL_CONFIG_FILE=$CONFIG_FILE

# Test directory for isolation
TEST_CONFIG_PATH="${TMPDIR:-/tmp}/test.config.$$"
mkdir -p "$TEST_CONFIG_PATH"

# Cleanup function
cleanup_test_config() {
  rm -rf "$TEST_CONFIG_PATH" 2>/dev/null
  export CONFIG=$ORIGINAL_CONFIG
  export CONFIG_PATH=$ORIGINAL_CONFIG_PATH
  export CONFIG_FILE=$ORIGINAL_CONFIG_FILE
}

# Setup test environment
setup_test_config() {
  export CONFIG_PATH="$TEST_CONFIG_PATH"
  export CONFIG_FILE="test.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  touch "$CONFIG"
}

# ============================================================================
# T1: Test config.init sets up CONFIG variables
# ============================================================================
test.case - "T1: config.init creates CONFIG_PATH and sets CONFIG" \
  config.init

if [ -d "$CONFIG_PATH" ] && [ -n "$CONFIG" ]; then
  create.result 0 "CONFIG initialized"
else
  create.result 1 "CONFIG_PATH=$CONFIG_PATH CONFIG=$CONFIG"
fi
expect 0 "CONFIG initialized" "config.init sets up environment"

# Reset to test environment
setup_test_config

# ============================================================================
# T2: Test config.file without args returns current file
# ============================================================================
test.case - "T2: config.file returns current file" \
  echo "checking"

CURRENT_FILE=$(config.file)
if [ "$CURRENT_FILE" = "$CONFIG_FILE" ]; then
  create.result 0 "file returned"
else
  create.result 1 "got: $CURRENT_FILE expected: $CONFIG_FILE"
fi
expect 0 "file returned" "config.file returns current file"

# ============================================================================
# T3: Test config.file sets new file
# ============================================================================
test.case - "T3: config.file sets new file" \
  config.file newtest.env

if [ "$CONFIG_FILE" = "newtest.env" ]; then
  create.result 0 "file changed"
else
  create.result 1 "CONFIG_FILE=$CONFIG_FILE"
fi
expect 0 "file changed" "config.file sets new file"

# Reset
setup_test_config

# ============================================================================
# T4: Test config.file.check with existing file
# ============================================================================
touch "$CONFIG_PATH/exists.env"
test.case - "T4: config.file.check finds existing file" \
  config.file.check exists

if [ "$RETURN_VALUE" -eq 0 ]; then
  create.result 0 "found exists.env"
else
  create.result 1 "not found"
fi
expect 0 "found exists.env" "config.file.check finds existing file"

# ============================================================================
# T5: Test config.save creates config file
# ============================================================================
export TEST_CONFIG_VAR1="value1"
export TEST_CONFIG_VAR2="value2"
setup_test_config

test.case - "T5: config.save creates file" \
  config.save testcfg TEST_CONFIG

if [ -f "$CONFIG_PATH/testcfg.env" ]; then
  create.result 0 "testcfg.env created"
else
  create.result 1 "testcfg.env missing"
fi
expect 0 "testcfg.env created" "config.save creates file"

# ============================================================================
# T6: Test config.save captures prefixed variables
# ============================================================================
test.case - "T6: config.save captures prefixed variables" \
  echo "checking saved content"

SAVED_CONTENT=$(cat "$CONFIG_PATH/testcfg.env" 2>/dev/null)
if echo "$SAVED_CONTENT" | grep -q "TEST_CONFIG_VAR1" && \
   echo "$SAVED_CONTENT" | grep -q "TEST_CONFIG_VAR2"; then
  create.result 0 "variables saved"
else
  create.result 1 "variables missing"
fi
expect 0 "variables saved" "config.save captures prefixed variables"

# ============================================================================
# T7: Test config.list shows config content
# ============================================================================
setup_test_config
echo 'export TEST_LIST_VAR="listvalue"' > "$CONFIG_PATH/listtest.env"

test.case - "T7: config.list shows content" \
  echo "checking list"

config.file listtest.env
LIST_OUTPUT=$(config.list listtest 2>/dev/null)
if echo "$LIST_OUTPUT" | grep -q "TEST_LIST_VAR"; then
  create.result 0 "list shows content"
else
  create.result 1 "list output: $LIST_OUTPUT"
fi
expect 0 "list shows content" "config.list shows variables"

# ============================================================================
# T8: Test config.set adds new variable
# ============================================================================
setup_test_config
echo '# empty config' > "$CONFIG"

test.case - "T8: config.set adds new variable" \
  config.set NEW_VAR "newvalue"

if grep -q 'NEW_VAR="newvalue"' "$CONFIG"; then
  create.result 0 "NEW_VAR added"
else
  create.result 1 "NEW_VAR missing in $CONFIG"
fi
expect 0 "NEW_VAR added" "config.set adds new variable"

# ============================================================================
# T9: Test config.set updates existing variable
# ============================================================================
setup_test_config
echo 'export EXISTING_VAR="oldvalue"' > "$CONFIG"

test.case - "T9: config.set updates existing variable" \
  config.set EXISTING_VAR "updatedvalue"

if grep -q 'EXISTING_VAR="updatedvalue"' "$CONFIG"; then
  create.result 0 "EXISTING_VAR updated"
else
  create.result 1 "EXISTING_VAR not updated"
fi
expect 0 "EXISTING_VAR updated" "config.set updates existing variable"

# ============================================================================
# T10: Test config.get retrieves variable value
# ============================================================================
export GET_TEST_VAR="getvalue"
setup_test_config
echo 'export GET_TEST_VAR="getvalue"' > "$CONFIG"

test.case - "T10: config.get retrieves variable value" \
  echo "checking get"

GET_RESULT=$(config.get GET_TEST_VAR 2>/dev/null)
if [ "$GET_RESULT" = "getvalue" ]; then
  create.result 0 "got value"
else
  create.result 1 "got: $GET_RESULT"
fi
expect 0 "got value" "config.get retrieves correct value"

# ============================================================================
# T11: Test config.add appends source line
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
touch "$CONFIG_PATH/addon.env"

test.case - "T11: config.add appends source line" \
  config.add addon

# config.add calls config.clean which sorts the file
if grep -q 'source $CONFIG_PATH/addon.env' "$CONFIG"; then
  create.result 0 "source added"
else
  create.result 1 "source missing in: $(cat $CONFIG)"
fi
expect 0 "source added" "config.add appends source line"

# ============================================================================
# T12: Test config.clean removes duplicates
# ============================================================================
setup_test_config
cat > "$CONFIG" << 'EOF'
export DUP_VAR="value"
export DUP_VAR="value"
export UNIQUE_VAR="unique"
export DUP_VAR="value"
EOF

test.case - "T12: config.clean removes duplicates" \
  config.clean

LINE_COUNT=$(grep -c "DUP_VAR" "$CONFIG" 2>/dev/null || echo "0")
if [ "$LINE_COUNT" -eq 1 ]; then
  create.result 0 "duplicates removed"
else
  create.result 1 "duplicates remain: $LINE_COUNT"
fi
expect 0 "duplicates removed" "config.clean removes duplicates"

# ============================================================================
# T13: Test config.delete removes config file
# ============================================================================
setup_test_config
touch "$CONFIG_PATH/todelete.env"
config.file todelete.env

test.case - "T13: config.delete removes file" \
  config.delete todelete

if [ ! -f "$CONFIG_PATH/todelete.env" ]; then
  create.result 0 "file deleted"
else
  create.result 1 "file still exists"
fi
expect 0 "file deleted" "config.delete removes file"

# ============================================================================
# T14: Test config.discover lists config files
# ============================================================================
setup_test_config
touch "$CONFIG_PATH/discover1.env"
touch "$CONFIG_PATH/discover2.env"

test.case - "T14: config.discover lists files" \
  echo "checking discover"

DISCOVER_OUTPUT=$(config.discover 2>/dev/null)
if echo "$DISCOVER_OUTPUT" | grep -q "discover1.env"; then
  create.result 0 "discover1 found"
else
  create.result 1 "output: $DISCOVER_OUTPUT"
fi
expect 0 "discover1 found" "config.discover lists files"

# ============================================================================
# T15: Test config.string.quote handles special chars
# ============================================================================
test.case - "T15: config.string.quote returns quoted string" \
  echo "checking quote"

QUOTED=$(config.string.quote "hello world")
if [ -n "$QUOTED" ]; then
  create.result 0 "string quoted"
else
  create.result 1 "quote failed"
fi
expect 0 "string quoted" "config.string.quote returns quoted string"

# ============================================================================
# T16: Test config.file reset restores defaults
# ============================================================================
config.file someother.env

test.case - "T16: config.file reset restores user.env" \
  config.file reset

if [ "$CONFIG_FILE" = "user.env" ]; then
  create.result 0 "file reset"
else
  create.result 1 "CONFIG_FILE=$CONFIG_FILE"
fi
expect 0 "file reset" "config.file reset restores user.env"

# Reset for remaining tests
setup_test_config

# ============================================================================
# T17: Test config.update saves and adds
# ============================================================================
export TEST_UPDATE_VAR="updateval"
setup_test_config
echo '# main config' > "$CONFIG"

test.case - "T17: config.update saves and adds" \
  config.update updatetest TEST_UPDATE

# Check file was created and source line added
if [ -f "$CONFIG_PATH/updatetest.env" ] && grep -q 'source $CONFIG_PATH/updatetest.env' "$CONFIG"; then
  create.result 0 "update complete"
else
  create.result 1 "file exists: $(test -f $CONFIG_PATH/updatetest.env && echo yes || echo no) source: $(grep updatetest $CONFIG)"
fi
expect 0 "update complete" "config.update saves and adds"

# ============================================================================
# T18: Test config.get with missing variable
# ============================================================================
unset NONEXISTENT_VAR

test.case - "T18: config.get returns empty for missing var" \
  echo "checking missing"

GET_MISSING=$(config.get NONEXISTENT_VAR 2>/dev/null)
if [ -z "$GET_MISSING" ]; then
  create.result 0 "empty for missing"
else
  create.result 1 "returned: $GET_MISSING"
fi
expect 0 "empty for missing" "config.get returns empty for missing var"

# ============================================================================
# T19: Test config.set with empty value
# ============================================================================
setup_test_config
echo 'export EMPTY_TEST="hasvalue"' > "$CONFIG"

test.case - "T19: config.set allows empty value" \
  config.set EMPTY_TEST ""

if grep -q 'EMPTY_TEST=""' "$CONFIG"; then
  create.result 0 "set to empty"
else
  create.result 1 "config content: $(cat $CONFIG)"
fi
expect 0 "set to empty" "config.set allows empty value"

# ============================================================================
# T20: Test config.v returns version
# ============================================================================
test.case - "T20: config.v returns version" \
  echo "checking version"

VERSION_OUTPUT=$(config.v 2>/dev/null)
if echo "$VERSION_OUTPUT" | grep -q "version"; then
  create.result 0 "version returned"
else
  create.result 1 "output: $VERSION_OUTPUT"
fi
expect 0 "version returned" "config.v returns version string"

# ============================================================================
# Cleanup
# ============================================================================
cleanup_test_config

# Unset test variables
unset TEST_CONFIG_VAR1
unset TEST_CONFIG_VAR2
unset TEST_UPDATE_VAR

# ============================================================================
# T-ENV-LOGIN: fresh login must have zero '/log' and '/c2.install' errors
# Guards against empty OOSH_DIR causing source /log, source /templates/...
# ============================================================================

echo ""
echo "=== T-ENV-LOGIN: fresh login env tests ==="
echo ""

# T-ENV-LOGIN-1: user.env sets OOSH_DIR non-empty
test.case $level "T-ENV-LOGIN-1: user.env sets OOSH_DIR non-empty" \
  echo "checking OOSH_DIR from user.env"
LOGIN_OOSH_DIR=$(env -i HOME="$HOME" bash --norc --noprofile -c '
  [ -f "$HOME/config/user.env" ] && source "$HOME/config/user.env" 2>/dev/null
  echo "$OOSH_DIR"
' 2>/dev/null)
if [ -n "$LOGIN_OOSH_DIR" ]; then
  expect.pass "OOSH_DIR='$LOGIN_OOSH_DIR' after sourcing user.env"
else
  expect.fail "OOSH_DIR is EMPTY after sourcing user.env — fresh login will get /log and /c2.install errors"
fi

# T-ENV-LOGIN-2: user.env passes config.validate (Rule A: source *.env OK, logic NOT)
test.case $level "T-ENV-LOGIN-2: user.env passes config.validate" \
  echo "checking user.env validity"
USER_ENV="$HOME/config/user.env"
if [ -f "$USER_ENV" ]; then
  CONFIG_SAVE="$CONFIG"
  CONFIG="$USER_ENV"
  if config.validate 2>/dev/null; then
    expect.pass "user.env passes config.validate (Rule A compliant)"
  else
    expect.fail "user.env fails config.validate"
  fi
  CONFIG="$CONFIG_SAVE"
else
  expect.fail "user.env not found at $USER_ENV"
fi

# T-ENV-LOGIN-3: .bashrc guards OOSH_DIR before source $OOSH_DIR/...
test.case $level "T-ENV-LOGIN-3: .bashrc guards OOSH_DIR before sourcing" \
  echo "checking .bashrc guards"
BASHRC="$HOME/.bashrc"
if [ -f "$BASHRC" ]; then
  # Find unguarded source $OOSH_DIR lines — lines that source $OOSH_DIR
  # without a preceding [ -n "$OOSH_DIR" ] guard in the same block
  UNGUARDED=$(grep -n 'source.*\$OOSH_DIR\|source.*\${OOSH_DIR}' "$BASHRC" 2>/dev/null | while IFS=: read -r linenum rest; do
    # Check if this line is inside an if-block that guards OOSH_DIR
    BEFORE=$(sed -n "1,${linenum}p" "$BASHRC" | tac | head -20)
    if echo "$BEFORE" | grep -q '\-n.*OOSH_DIR\|OOSH_DIR.*\-n\|if.*OOSH_DIR'; then
      : # guarded
    else
      echo "$linenum:$rest"
    fi
  done)
  if [ -z "$UNGUARDED" ]; then
    expect.pass ".bashrc: all source \$OOSH_DIR lines are guarded"
  else
    expect.fail ".bashrc has unguarded source \$OOSH_DIR: $UNGUARDED"
  fi
else
  expect.fail ".bashrc not found at $BASHRC"
fi

# T-ENV-LOGIN-4: fresh login produces no /log or /c2.install errors
test.case $level "T-ENV-LOGIN-4: fresh login zero '/log' '/c2.install' errors" \
  echo "checking clean login"
LOGIN_ERRORS=$(env -i HOME="$HOME" TERM="dumb" bash -lc 'echo __LOGIN_OK__' 2>&1 | grep -c '/log\|/c2.install\|/templates' || true)
if [ "$LOGIN_ERRORS" -eq 0 ]; then
  expect.pass "fresh login: zero /log or /c2.install errors"
else
  LOGIN_DETAIL=$(env -i HOME="$HOME" TERM="dumb" bash -lc 'echo __LOGIN_OK__' 2>&1 | grep '/log\|/c2.install\|/templates')
  expect.fail "fresh login has $LOGIN_ERRORS error(s): $LOGIN_DETAIL"
fi

echo ""
echo "=== T-ENV-LOGIN tests complete ==="
echo ""

# ============================================================================
# T-CONSTRUCTOR: Sprint constructor-contract (S-2..S-6)
# Spec: scrum.pmo/sprints/sprint-constructor-contract/planning.md
# Principle: init() ALWAYS yields a valid object — no failure path
# ============================================================================

echo ""
echo "=== T-CONSTRUCTOR: constructor contract tests ==="
echo ""

# Fixture: restore real CONFIG (earlier tests may have redirected to test path)
private.this.resolve.fundamentals
export CONFIG_FILE="user.env"
export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
CON_BACKUP="${CONFIG}.constructor-backup-$$"
cp "$CONFIG" "$CON_BACKUP" 2>/dev/null
__constructor_restore() {
  [ -f "$CON_BACKUP" ] && cp "$CON_BACKUP" "$CONFIG" 2>/dev/null && rm -f "$CON_BACKUP"
  private.this.resolve.fundamentals
  export CONFIG_FILE="user.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
}

# ── T-FUND: S-2 — OOSH_DIR from BASH_SOURCE, not HOME/oosh ─────────────

test.case $level "T-FUND-1: resolve.fundamentals function exists" \
  type -t private.this.resolve.fundamentals
if type -t private.this.resolve.fundamentals &>/dev/null; then
  expect.pass "private.this.resolve.fundamentals defined"
else
  expect.fail "private.this.resolve.fundamentals should exist (S-2)"
fi

test.case $level "T-FUND-2: OOSH_DIR resolved from BASH_SOURCE not HOME/oosh" \
  echo "checking resolve implementation"
# The resolver must NOT contain $HOME/oosh as a primary path
RESOLVER_BODY=$(type private.this.resolve.fundamentals 2>/dev/null)
if echo "$RESOLVER_BODY" | grep -q 'BASH_SOURCE'; then
  if echo "$RESOLVER_BODY" | grep -q 'HOME/oosh' | grep -v 'Last resort\|fallback\|#'; then
    expect.fail "resolve.fundamentals still uses \$HOME/oosh as primary"
  else
    expect.pass "resolves from BASH_SOURCE (no HOME/oosh primary)"
  fi
else
  expect.fail "resolve.fundamentals does not reference BASH_SOURCE"
fi

test.case $level "T-FUND-3: OOSH_DIR is non-empty after resolve" \
  echo "checking resolved value"
private.this.resolve.fundamentals 2>/dev/null
if [ -n "$OOSH_DIR" ]; then
  expect.pass "OOSH_DIR='$OOSH_DIR'"
else
  expect.fail "OOSH_DIR empty after resolve.fundamentals"
fi

test.case $level "T-FUND-4: CONFIG_PATH resolves symlinks (cd -P)" \
  echo "checking symlink resolution"
if echo "$RESOLVER_BODY" | grep -q 'cd -P'; then
  expect.pass "uses cd -P for symlink-safe resolution"
else
  expect.fail "resolve.fundamentals should use cd -P"
fi

# ── T-EMIT: S-3 — fresh subshell empty OOSH_DIR → user.env has it ───────

test.case $level "T-EMIT-1: user.env exports OOSH_DIR" \
  echo "checking file"
if grep -q '^export OOSH_DIR=' "$CONFIG" 2>/dev/null; then
  expect.pass "OOSH_DIR exported in user.env"
else
  expect.fail "OOSH_DIR NOT in user.env — config.save must emit it unconditionally"
fi

test.case $level "T-EMIT-2: fresh subshell gets OOSH_DIR from user.env" \
  echo "checking clean env"
EMIT_DIR=$(env -i HOME="$HOME" bash --norc --noprofile -c "source '$CONFIG' 2>/dev/null; echo \"\$OOSH_DIR\"" 2>/dev/null)
if [ -n "$EMIT_DIR" ]; then
  expect.pass "fresh subshell: OOSH_DIR='$EMIT_DIR'"
else
  expect.fail "OOSH_DIR empty in fresh subshell — not emitted in user.env"
fi

test.case $level "T-EMIT-3: config.save emits OOSH_MODE" \
  echo "checking OOSH_MODE"
if grep -q '^export OOSH_MODE=' "$CONFIG" 2>/dev/null; then
  expect.pass "OOSH_MODE exported in user.env"
else
  expect.fail "OOSH_MODE NOT in user.env"
fi

# ── T-VALIDATE: S-4 — accepts source *.env, rejects logic ───────────────

test.case $level "T-VALIDATE-1: accepts clean user.env" \
  echo "validating current"
if config.validate 2>/dev/null; then
  expect.pass "current user.env is valid"
else
  expect.fail "current user.env fails validation"
fi

test.case $level "T-VALIDATE-2: accepts source *.env (Rule A)" \
  echo "testing Rule A"
# Create a test env with source *.env line
VTEST="${CONFIG}.vtest-$$"
printf 'export FOO="bar"\nsource $CONFIG_PATH/oosh.env\n' > "$VTEST"
CONFIG_SAVE="$CONFIG"
CONFIG="$VTEST"
if config.validate 2>/dev/null; then
  expect.pass "source *.env accepted (Rule A)"
else
  expect.fail "source *.env should be accepted by Rule A"
fi
CONFIG="$CONFIG_SAVE"
rm -f "$VTEST"

test.case $level "T-VALIDATE-3: rejects logic (: \${, \$(), conditionals)" \
  echo "testing rejection"
VTEST="${CONFIG}.vtest-$$"
printf 'export FOO="bar"\n: ${CONFIG_PATH:="${BASH_SOURCE[0]%%/*}"}\n' > "$VTEST"
CONFIG_SAVE="$CONFIG"
CONFIG="$VTEST"
if config.validate 2>/dev/null; then
  expect.fail "logic line should be rejected"
else
  expect.pass "logic correctly rejected"
fi
CONFIG="$CONFIG_SAVE"
rm -f "$VTEST"

test.case $level "T-VALIDATE-4: rejects source *.sh (only *.env allowed)" \
  echo "testing .sh rejection"
VTEST="${CONFIG}.vtest-$$"
printf 'export FOO="bar"\nsource $OOSH_DIR/log\n' > "$VTEST"
CONFIG_SAVE="$CONFIG"
CONFIG="$VTEST"
if config.validate 2>/dev/null; then
  expect.fail "source *.sh (non .env) should be rejected"
else
  expect.pass "source non-.env correctly rejected"
fi
CONFIG="$CONFIG_SAVE"
rm -f "$VTEST"

# ── T-NOLOSS: S-5 — user var survives corrupt+reinit ────────────────────

test.case $level "T-NOLOSS-1: user var preserved through reinit" \
  echo "testing no-loss"
# Set a custom user var via `config set` (TRACKED). BUG A made config.save an
# ALLOW-LIST — only OOSH vars + vars registered through `config set` are
# harvested (that is what stopped VSCode/terminal/test env leakage, 113→19
# exports). A bare `export` is deliberately NOT captured; the persistence
# contract is `config set`, so the no-loss test must use it.
config.set TRON_TEST_CUSTOM_VAR "keepme-$$" 2>/dev/null
config.save 2>/dev/null
# Verify it's in the file
if grep -q "TRON_TEST_CUSTOM_VAR=\"keepme-$$\"" "$CONFIG" 2>/dev/null; then
  # Now corrupt the file
  echo ': ${BOGUS:="logic"}' >> "$CONFIG"
  # Reinit (config.save = the constructor)
  config.save 2>/dev/null
  # Var must survive
  if grep -q "TRON_TEST_CUSTOM_VAR=\"keepme-$$\"" "$CONFIG" 2>/dev/null; then
    if config.validate 2>/dev/null; then
      expect.pass "TRON_TEST_CUSTOM_VAR survived reinit + env clean"
    else
      expect.fail "var survived but env not clean"
    fi
  else
    expect.fail "TRON_TEST_CUSTOM_VAR LOST after reinit"
  fi
else
  expect.fail "config.save did not capture TRON_TEST_CUSTOM_VAR (set via config.set — tracked)"
fi
config.delete TRON_TEST_CUSTOM_VAR 2>/dev/null
unset TRON_TEST_CUSTOM_VAR

test.case $level "T-NOLOSS-2: reinit is idempotent" \
  echo "testing idempotent"
BEFORE_MD5=$(md5sum "$CONFIG" 2>/dev/null | cut -d' ' -f1)
config.save 2>/dev/null
AFTER_MD5=$(md5sum "$CONFIG" 2>/dev/null | cut -d' ' -f1)
if [ "$BEFORE_MD5" = "$AFTER_MD5" ]; then
  expect.pass "idempotent: md5 unchanged"
else
  if config.validate 2>/dev/null; then
    expect.pass "content changed but still valid (ordering)"
  else
    expect.fail "2nd save produced invalid output"
  fi
fi

# ── T-NEVERFAIL: S-6 — every broken input → init → valid object ─────────

test.case $level "T-NEVERFAIL-1: empty user.env → init → valid" \
  echo "testing empty file"
: > "$CONFIG"
config.save 2>/dev/null
RC=$?
CONFIG="$CONFIG_PATH/$CONFIG_FILE"
if [ "$RC" -eq 0 ] && config.validate 2>/dev/null && grep -q '^export OOSH_DIR=' "$CONFIG" 2>/dev/null; then
  expect.pass "empty file → valid object (RC=$RC)"
else
  expect.fail "init failed or invalid after empty file (RC=$RC)"
fi

test.case $level "T-NEVERFAIL-2: fully polluted u20 → init → valid" \
  echo "testing u20 pollution"
cat > "$CONFIG" << 'U20'
: ${CONFIG_PATH:="${BASH_SOURCE[0]%/*}"}
{ [ -z "$CONFIG_PATH" ] || [ ! -f "$CONFIG_PATH/user.env" ]; } && CONFIG_PATH="$HOME/config"
: ${OOSH_DIR:="$(cd "$HOME/oosh" 2>/dev/null && pwd -P || echo "$HOME/oosh")"}
export CONFIG_FILE="user.env"
export BASH_FILE="/usr/bin/bash"
source $CONFIG_PATH/oosh.env
source $CONFIG_PATH/log.env
U20
config.save 2>/dev/null
RC=$?
CONFIG="$CONFIG_PATH/$CONFIG_FILE"
if [ "$RC" -eq 0 ] && config.validate 2>/dev/null && grep -q '^export OOSH_DIR=' "$CONFIG" 2>/dev/null; then
  expect.pass "u20 polluted → valid object (RC=$RC)"
else
  expect.fail "init failed on u20 polluted input (RC=$RC)"
fi

test.case $level "T-NEVERFAIL-3: missing user.env → init → valid" \
  echo "testing missing file"
rm -f "$CONFIG" 2>/dev/null
config.save 2>/dev/null
RC=$?
CONFIG="$CONFIG_PATH/$CONFIG_FILE"
if [ "$RC" -eq 0 ] && [ -f "$CONFIG" ] && config.validate 2>/dev/null; then
  expect.pass "missing file → created valid object (RC=$RC)"
else
  expect.fail "init failed on missing file (RC=$RC, exists=$([ -f "$CONFIG" ] && echo y || echo n))"
fi

test.case $level "T-NEVERFAIL-4: config.repair = config.save (alias)" \
  echo "checking alias"
REPAIR_TYPE=$(type config.repair 2>/dev/null)
if echo "$REPAIR_TYPE" | grep -q 'config.save'; then
  expect.pass "config.repair is alias for config.save"
else
  expect.fail "config.repair should be alias for config.save (repair IS init)"
fi

# Restore original
__constructor_restore

echo ""
echo "=== T-CONSTRUCTOR tests complete ==="
echo ""

# ============================================================================
# T-ENV-INSTALL: integration test — install emits pure state, repair heals,
# boot auto-heals (CS-7, sprint-config-selfheal)
# ============================================================================

echo ""
echo "=== T-ENV-INSTALL: config lifecycle integration tests ==="
echo ""

INSTALL_BACKUP="${CONFIG}.install-backup-$$"
cp "$CONFIG" "$INSTALL_BACKUP" 2>/dev/null

# T-ENV-INSTALL-1: config.save (fresh emit) produces pure state
test.case $level "T-ENV-INSTALL-1: fresh config.save emits pure state" \
  echo "testing fresh emit"
: > "$CONFIG"
config.save 2>/dev/null
CONFIG="$CONFIG_PATH/$CONFIG_FILE"
if config.validate 2>/dev/null; then
  expect.pass "fresh config.save → valid pure state"
else
  expect.fail "fresh config.save produced invalid output"
fi

# T-ENV-INSTALL-2: emitted file has all fundamentals
test.case $level "T-ENV-INSTALL-2: all fundamentals present after fresh emit" \
  echo "checking fundamentals"
MISSING=""
grep -q '^export OOSH_DIR=' "$CONFIG" 2>/dev/null || MISSING="$MISSING OOSH_DIR"
grep -q '^export CONFIG_PATH=' "$CONFIG" 2>/dev/null || MISSING="$MISSING CONFIG_PATH"
grep -q '^export OOSH_MODE=' "$CONFIG" 2>/dev/null || MISSING="$MISSING OOSH_MODE"
grep -q '^export BASH_FILE=' "$CONFIG" 2>/dev/null || MISSING="$MISSING BASH_FILE"
if [ -z "$MISSING" ]; then
  expect.pass "all fundamentals present"
else
  expect.fail "missing:$MISSING"
fi

# T-ENV-INSTALL-3: corrupted env → config.save → clean (self-heal)
test.case $level "T-ENV-INSTALL-3: corrupted → config.save → clean" \
  echo "testing self-heal"
cat > "$CONFIG" << 'CORRUPT'
: ${CONFIG_PATH:="${BASH_SOURCE[0]%/*}"}
{ [ -z "$CONFIG_PATH" ] || [ ! -f "$CONFIG_PATH/user.env" ]; } && CONFIG_PATH="$HOME/config"
: ${OOSH_DIR:="$(cd "$HOME/oosh" 2>/dev/null && pwd -P || echo "$HOME/oosh")"}
export CONFIG_FILE="user.env"
source $CONFIG_PATH/oosh.env
CORRUPT
config.save 2>/dev/null
if config.validate 2>/dev/null && grep -q '^export OOSH_DIR=' "$CONFIG" 2>/dev/null; then
  expect.pass "corrupted env → self-healed to pure state"
else
  expect.fail "config.save did not heal corrupted env"
fi

# T-ENV-INSTALL-4: boot never asks user — no read/prompt in this.init or config.save
test.case $level "T-ENV-INSTALL-4: boot never prompts user (non-interactive)" \
  echo "checking non-interactive"
# Grep this and config for interactive reads (read -p, read -r with prompt, select)
CONFIG_SRC="$OOSH_DIR/config"
THIS_SRC="$OOSH_DIR/this"
INTERACTIVE=""
for fn in "config.save" "config.init" "config.repair" "this.init"; do
  BODY=$(type "$fn" 2>/dev/null)
  if echo "$BODY" | grep -q 'read -p\|read -r.*".*"\|select .* in'; then
    INTERACTIVE="$INTERACTIVE $fn"
  fi
done
if [ -z "$INTERACTIVE" ]; then
  expect.pass "no interactive prompts in init/save/repair"
else
  expect.fail "interactive prompts found in:$INTERACTIVE"
fi

# T-ENV-INSTALL-5: boot never fails — config.save always RC=0
test.case $level "T-ENV-INSTALL-5: config.save always RC=0 (never fails)" \
  echo "testing never-fail"
# Try the 3 worst cases
ALL_RC0=true
for scenario in "empty" "garbage" "missing"; do
  case "$scenario" in
    empty) : > "$CONFIG" ;;
    garbage) echo ': ${X:="$(evil)"}' > "$CONFIG" ;;
    missing) rm -f "$CONFIG" ;;
  esac
  config.save 2>/dev/null
  RC=$?
  if [ "$RC" -ne 0 ]; then
    ALL_RC0=false
    expect.fail "config.save RC=$RC on $scenario input"
    break
  fi
done
if [ "$ALL_RC0" = true ]; then
  expect.pass "config.save RC=0 on all broken inputs"
fi

# T-ENV-INSTALL-6: after self-heal, fresh subshell gets OOSH_DIR
test.case $level "T-ENV-INSTALL-6: fresh subshell works after self-heal" \
  echo "testing subshell"
SUBSHELL_DIR=$(env -i HOME="$HOME" bash --norc --noprofile -c "source '$CONFIG' 2>/dev/null; echo \"\$OOSH_DIR\"" 2>/dev/null)
if [ -n "$SUBSHELL_DIR" ]; then
  expect.pass "subshell OOSH_DIR='$SUBSHELL_DIR'"
else
  expect.fail "OOSH_DIR empty in fresh subshell after self-heal"
fi

# Restore
cp "$INSTALL_BACKUP" "$CONFIG" 2>/dev/null
rm -f "$INSTALL_BACKUP"

echo ""
echo "=== T-ENV-INSTALL tests complete ==="
echo ""

# ============================================================================
# REGRESSION: T-BOOT-HOME — env -i bash must not error on $HOME
# BUG 1: after env -i, $HOME is empty → ". $HOME/.local/bin/env" errors.
# Fix: this.init discovers HOME before anything uses it.
# ============================================================================

# T-BOOT-HOME-1: env -i bash produces no error about /.local/bin/env
BOOT_ERRORS=$(env -i HOME="" bash --norc --noprofile -c \
  ': ${HOME:=$(eval echo ~$(id -un 2>/dev/null || echo root))}; . "$HOME/.local/bin/env" 2>&1 || true' 2>&1)
test.case $level "T-BOOT-HOME-1: env -i bash no /.local/bin/env error" \
  echo "$BOOT_ERRORS"
if echo "$BOOT_ERRORS" | grep -q "/.local/bin/env: No such file"; then
  expect.fail "HOME not discovered: $BOOT_ERRORS"
else
  expect.pass "no /.local/bin/env error"
fi

# T-BOOT-HOME-2: this.init sets HOME when empty
HOME_DISCOVERED=$(env -i bash --norc --noprofile -c \
  'source /root/oosh/this 2>/dev/null; echo "$HOME"' 2>/dev/null)
test.case $level "T-BOOT-HOME-2: this.init discovers HOME when empty" \
  echo "HOME=$HOME_DISCOVERED"
if [ -n "$HOME_DISCOVERED" ] && [ -d "$HOME_DISCOVERED" ]; then
  expect.pass "HOME='$HOME_DISCOVERED' (valid directory)"
else
  expect.fail "HOME empty or invalid after this.init: '$HOME_DISCOVERED'"
fi

echo ""
echo "=== T-BOOT-HOME tests complete ==="
echo ""

# ============================================================================
# REGRESSION: T-CONFIGSAVE-PURE — config save must be inert
# BUG 3: config save resets LOG_DEVICE, triggers this.load, outputs IMPORTANT.
# Fix: config save serializes+writes only — no re-bootstrap, no side effects.
# ============================================================================

# T-CONFIGSAVE-PURE-1: config save produces no IMPORTANT output
SAVE_OUTPUT=$(config save 2>&1)
test.case $level "T-CONFIGSAVE-PURE-1: config save produces no IMPORTANT lines" \
  echo "$SAVE_OUTPUT"
if echo "$SAVE_OUTPUT" | grep -qi "IMPORTANT"; then
  expect.fail "config save produced IMPORTANT output: $(echo "$SAVE_OUTPUT" | grep -i IMPORTANT)"
else
  expect.pass "no IMPORTANT output"
fi

# T-CONFIGSAVE-PURE-2: config save does not mention LOG_DEVICE
test.case $level "T-CONFIGSAVE-PURE-2: config save does not reset LOG_DEVICE" \
  echo "$SAVE_OUTPUT"
if echo "$SAVE_OUTPUT" | grep -q "LOG_DEVICE"; then
  expect.fail "config save mutated LOG_DEVICE: $(echo "$SAVE_OUTPUT" | grep LOG_DEVICE)"
else
  expect.pass "no LOG_DEVICE mutation"
fi

# T-CONFIGSAVE-PURE-3: config save does not trigger this.load
test.case $level "T-CONFIGSAVE-PURE-3: config save does not trigger this.load" \
  echo "$SAVE_OUTPUT"
if echo "$SAVE_OUTPUT" | grep -q "this.load"; then
  expect.fail "config save triggered this.load"
else
  expect.pass "no this.load triggered"
fi

echo ""
echo "=== T-CONFIGSAVE-PURE tests complete ==="
echo ""

# ============================================================================
# REGRESSION: T-NO-SOURCE — grep guard: no oosh scripts sourced
# BUG 4: agents must NEVER source oosh scripts (only .env files).
# Guard: scan test files and SKILL.md files for 'source <oosh-script>'.
# ============================================================================

OOSH_DIR_PATH="${OOSH_DIR:-/root/oosh}"

# T-NO-SOURCE-1: no test files source oosh scripts (non-.env)
SOURCE_VIOLATIONS_TEST=$(grep -rn "^[[:space:]]*source.*${OOSH_DIR_PATH}" "$OOSH_DIR_PATH/test/" 2>/dev/null \
  | grep -v '\.env' \
  | grep -v 'source this$' \
  | grep -v 'source test\.suite' \
  | grep -v 'source config$' \
  | grep -v 'grep\|echo\|#' \
  || true)
test.case $level "T-NO-SOURCE-1: no test files source oosh scripts" \
  echo "$SOURCE_VIOLATIONS_TEST"
if [ -z "$SOURCE_VIOLATIONS_TEST" ]; then
  expect.pass "no source-script violations in test/"
else
  VIOLATION_COUNT=$(echo "$SOURCE_VIOLATIONS_TEST" | wc -l | tr -d ' ')
  expect.fail "$VIOLATION_COUNT source-script violations in test/: $(echo "$SOURCE_VIOLATIONS_TEST" | head -3)"
fi

# T-NO-SOURCE-2: no SKILL.md files recommend sourcing oosh scripts
SKILL_DIR="${OOSH_DIR_PATH}/.claude/agents"
if [ -d "$SKILL_DIR" ]; then
  SOURCE_VIOLATIONS_SKILL=$(grep -rn "source.*oosh/" "$SKILL_DIR" 2>/dev/null \
    | grep -v '\.env' \
    | grep -v 'grep\|echo\|#.*source\|example\|NEVER source' \
    || true)
  test.case $level "T-NO-SOURCE-2: no SKILL.md files recommend sourcing scripts" \
    echo "$SOURCE_VIOLATIONS_SKILL"
  if [ -z "$SOURCE_VIOLATIONS_SKILL" ]; then
    expect.pass "no source-script recommendations in SKILL.md files"
  else
    SKILL_VIOLATION_COUNT=$(echo "$SOURCE_VIOLATIONS_SKILL" | wc -l | tr -d ' ')
    expect.fail "$SKILL_VIOLATION_COUNT violations in SKILL.md: $(echo "$SOURCE_VIOLATIONS_SKILL" | head -3)"
  fi
else
  test.case $level "T-NO-SOURCE-2: (skipped — no agents dir)" echo "skip"
  expect.pass "skipped"
fi

echo ""
echo "=== T-NO-SOURCE tests complete ==="
echo ""

# ============================================================================
# REGRESSION: T-USERENV-PURE — user.env must contain only pure exports
# BUG 2: user.env still contains 'source' lines from old config.add.
# Fix: config save/clean regenerates a pure-state file.
# config validate catches violations.
# ============================================================================

USERENV="${CONFIG:-$HOME/config/user.env}"

# T-USERENV-PURE-1: user.env has no source lines
test.case $level "T-USERENV-PURE-1: user.env has no source lines" \
  echo "checking $USERENV"
if [ -f "$USERENV" ]; then
  SOURCE_LINES=$(grep -n "^[[:space:]]*source " "$USERENV" 2>/dev/null || true)
  if [ -z "$SOURCE_LINES" ]; then
    expect.pass "user.env is pure (no source lines)"
  else
    SOURCE_COUNT=$(echo "$SOURCE_LINES" | wc -l | tr -d ' ')
    expect.fail "$SOURCE_COUNT source lines in user.env: $(echo "$SOURCE_LINES" | head -3)"
  fi
else
  expect.fail "user.env not found at $USERENV"
fi

# T-USERENV-PURE-2: config validate passes (if available)
test.case $level "T-USERENV-PURE-2: config validate passes" \
  echo "running config validate"
VALIDATE_OUTPUT=$(config validate 2>&1 || true)
VALIDATE_RC=$?
if echo "$VALIDATE_OUTPUT" | grep -qi "violation\|FAIL\|error"; then
  expect.fail "config validate found violations: $(echo "$VALIDATE_OUTPUT" | grep -i 'violation\|FAIL\|error' | head -3)"
else
  expect.pass "config validate clean (rc=$VALIDATE_RC)"
fi

echo ""
echo "=== T-USERENV-PURE tests complete ==="
echo ""

# ============================================================================
# Save results
# ============================================================================
test.suite.save.results
