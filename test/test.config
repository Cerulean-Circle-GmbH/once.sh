# ============================================================================
# T69: test.tilde runs from a CLEAN ENVIRONMENT
# ============================================================================
# 815d14d gave test/test.tilde `#!/usr/bin/env -iS HOME=${HOME} bash` — the
# sibling commit to 8c277f4, which did the same for init/oosh. 075b4a3 removed
# that shebang from BOTH (BusyBox `env` has no -S) and nothing replaced the
# guarantee. init/oosh got it back as an in-file re-exec (the OOSH_CLEAN_ENV block);
# test.tilde did not, and has since inherited whatever the caller happened to
# have.
#
# It passes either way — which is exactly the problem. A test whose entire
# subject is `~` versus $HOME, run with an arbitrary inherited environment, is
# green for a reason unrelated to what it asserts. Same shape as a mode check
# that never looked at the mode.
#
# Pinned here, all observable from OUTSIDE the file:
#   1. a variable planted by the caller does NOT survive into it;
#   2. the re-exec really happened;
#   3. the sentinel is HONOURED — preset, the file must NOT re-exec. That is
#      what makes an exec loop impossible, and it is asserted rather than
#      assumed. Every invocation is wrapped in `timeout` where available, so a
#      regression that DOES loop fails this test instead of hanging the suite.
#   4. it still does its actual job, and still exits 0.
test.config.tildeRunsInCleanEnvironment() {
  local tilde="$OOSH_DIR/test/test.tilde" out cleanOut rc bad="" to="" tmp
  # The child now sources this + test.suite and saves ITS results to
  # $CONFIG_PATH/testresult.env — give it a throwaway one, never the parent's.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t69.XXXXXX") || { create.result 1 "mktemp failed"; return $(result); }
  command -v timeout >/dev/null 2>&1 && to="timeout 20"
  if [ ! -x "$tilde" ]; then
    rm -rf "$tmp"
    create.result 1 "$tilde is not executable — test.suite runs it as a bare \$file (kernel exec)"
    return $(result)
  fi
  bash -n "$tilde" 2>/dev/null || bad="$bad lint:$(bash -n "$tilde" 2>&1 | head -1)"

  # 1 + 2 — plant a canary; it must not survive, and the sentinel must be set.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CANARY=leaked OOSH_TILDE_CLEAN_ENV= $to "$tilde" 1 2>&1); rc=$?
  cleanOut="$out"
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc"
  case "$out" in
    *"Environment                                : clean, canary absent"*) : ;;
    *INHERITED*) bad="$bad canary-survived (test.tilde did not re-exec with env -i — the 075b4a3 regression)" ;;
    *) bad="$bad no-environment-line:$(echo "$out" | head -1)" ;;
  esac

  # 3 — sentinel honoured: preset, it must NOT re-exec (so the canary DOES
  #     survive) and must still terminate.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CLEAN_ENV=1 OOSH_TILDE_CANARY=leaked $to "$tilde" 1 2>&1); rc=$?
  if [ "$rc" -eq 124 ]; then
    bad="$bad sentinel-LOOPED (timed out — the re-exec guard does not stop)"
  else
    [ "$rc" -eq 0 ] || bad="$bad sentinel-rc=$rc"
    case "$out" in
      *INHERITED*) : ;;
      *"clean, canary absent"*) bad="$bad sentinel-ignored (it re-execs even when already clean; nothing but luck prevents a loop)" ;;
      *) bad="$bad sentinel-check-inconclusive (no Environment line at all)" ;;
    esac
  fi

  # 4 — it must still be the test it was: on the CLEAN run, its own assertions
  #     ran through the framework and none failed.
  case "$cleanOut" in
    *"T-TILDE-HOME"*"T-TILDE-FILE-TEST"*) : ;;
    *) bad="$bad tilde-assertions-missing:$(echo "$cleanOut" | tr '\n' ' ' | cut -c1-120)" ;;
  esac
  case "$cleanOut" in
    *"✗ FAIL"*) bad="$bad tilde-assertion-failed:$(echo "$cleanOut" | grep -F "✗ FAIL" | head -1 | cut -c1-100)" ;;
  esac
  rm -rf "$tmp"

  if [ -z "$bad" ]; then
    create.result 0 "test.tilde runs clean and cannot loop"
  else
    create.result 1 "test.tilde clean-environment guarantee broken —$bad"
  fi
  return $(result)
}
test.case - "T69: test/test.tilde runs from a clean environment and cannot loop" \
  test.config.tildeRunsInCleanEnvironment
expect 0 "test.tilde runs clean and cannot loop" \
  "a tilde test that inherits the caller's environment is green for the wrong reason"

# ============================================================================
# T70 (POSIX-mode bash sources boot) went with boot (dev.config Round 5): a shell starts from ~/config/user.env.
# ============================================================================

# ============================================================================
# T71: a generated config does not carry OOSH_BRANCH into the next shell
# ============================================================================
# The drift loop, end to end. oosh.env seeds a shell with OOSH_BRANCH; that
# shell reaches a config save; the save writes OOSH_BRANCH straight back. On
# this host it has been saying "prod" against a dev checkout for weeks, which
# makes private.oo.install.branch.get — "the one rule behind state 31, state 34
# and oo boot.fix" — answer prod on a dev box.
#
# OOSH_BRANCH is the install INPUT: the branch the operator asked for. It is
# meaningful for the length of one install and meaningless afterwards, so it
# must not survive into a shell. The branch a box is ON is derived from the
# checkout, never remembered.
test.config.branchIsInputNotState() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t71.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out
  # Generate a config from a shell that carries the install input, then source
  # the generated chain in a CLEAN child and ask what it inherited.
  out=$(env -i PATH="$PATH" HOME="$fixture" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
            OOSH_BRANCH=prod OOSH_MODE=dev \
        bash -c '
          mkdir -p "$HOME/.config/oosh"; : > "$HOME/.config/oosh/log.session.env"
          source "$OOSH_DIR/this" >/dev/null 2>&1
          source "$OOSH_DIR/config" >/dev/null 2>&1
          : > "$CONFIG"; config.save >/dev/null 2>&1
          grep -h OOSH_BRANCH "$CONFIG_PATH"/*.env 2>/dev/null | tr -d " \t"
        ')
  rm -rf "$fixture" 2>/dev/null

  if [ -n "$out" ]; then
    create.result 1 "the install input was persisted into the config: [$out]"
  else
    create.result 0 "OOSH_BRANCH is install input and never reaches the config"
  fi
  return $(result)
}
test.case - "T71: config.save does not persist the install input OOSH_BRANCH" \
  test.config.branchIsInputNotState
expect 0 "OOSH_BRANCH is install input and never reaches the config" \
  "persisting it closes a loop that never consults the checkout — the T7 drift"

# ============================================================================
# T72: config.init honours the anchor it was given, and defaults when given none
# ============================================================================
# config.init did an UNCONDITIONAL `export CONFIG_PATH=~/config`, and
# config.start re-runs it whenever $CONFIG is not a file — so any fixture was
# undone from inside the file under test. That is why test.config and
# test.completion.audit had to declare TEST_SHARED_TIER_WRITER instead of
# isolating: they source `config`, and sourcing it moved the anchor back.
#
# The conditional form is not a bend of the anchor rule, it is the rule:
# private.this.anchor.validate.one classifies `: ${CONFIG_PATH:=~/config}` as
# CONFORMING, and `this`, `log` and `ossh` already use exactly that shape for
# this exact variable.
test.config.initHonoursGivenAnchor() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t72.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local given defaulted
  # (a) given an anchor, keep it
  given=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
          bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                   source "$OOSH_DIR/config" >/dev/null 2>&1
                   config.init >/dev/null 2>&1
                   printf "%s|%s" "$CONFIG_PATH" "$CONFIG"')
  # (b) given none, produce the constant
  defaulted=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                       source "$OOSH_DIR/config" >/dev/null 2>&1
                       config.init >/dev/null 2>&1
                       printf "%s" "$CONFIG_PATH"')
  rm -rf "$fixture" 2>/dev/null

  if [ "${given%%|*}" != "$fixture" ]; then
    create.result 1 "config.init clobbered the anchor it was given: [${given%%|*}] wanted [$fixture]"
  elif [ "${given#*|}" != "$fixture/user.env" ]; then
    create.result 1 "\$CONFIG did not follow the given anchor: [${given#*|}]"
  elif [ "$defaulted" != "$HOME/config" ]; then
    create.result 1 "with no anchor given, config.init did not produce \$HOME/config: [$defaulted]"
  else
    create.result 0 "config.init honours a given anchor and defaults to the constant"
  fi
  return $(result)
}
test.case - "T72: config.init keeps an inherited CONFIG_PATH and still defaults to ~/config" \
  test.config.initHonoursGivenAnchor
expect 0 "config.init honours a given anchor and defaults to the constant" \
  "config.start re-runs config.init, so an unconditional export undoes a fixture from inside"

# ============================================================================
# T73: config validate required — names what is missing, and reports drift
# ============================================================================
# The card asks for two things this tree had neither of: a declared set of
# variables a config must carry for a branch version, and something that
# notices when the persisted branch disagrees with the checkout.
#
# config.init only ever created a directory and three variables, so on a
# missing config it succeeded emptily. config.validate checks line SHAPE and
# knows no variable name at all. config.init.check never opens an env file.
test.config.requiredFixture() { # <dir> <oosh-branch> <?omit> # a config tier plus a ~/oosh symlink on <oosh-branch>
  local dir="$1" branch="$2" omit="$3"
  mkdir -p "$dir/home" "$dir/base/$branch"
  ln -sfn "$dir/base/$branch" "$dir/home/oosh"
  printf 'export BASH_FILE="/usr/bin/bash"\nexport CONFIG_FILE="user.env"\n' > "$dir/user.env"
  printf 'export LOG_LEVEL="1"\n' > "$dir/log.env"
  [ "$omit" = "omit" ] && return 0
  printf 'export OOSH_MODE="%s"\nexport OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' \
    "${4:-$branch}" > "$dir/oosh.env"
}

test.config.requiredRun() { # <dir> # run `config validate required` against <dir> in a pinned child; echo "rc|verdict"
  local out rc
  out=$(env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
        bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                 source "$OOSH_DIR/config" >/dev/null 2>&1
                 config.validate.required 2>/dev/null'); rc=$?
  printf '%s|%s' "$rc" "$(printf '%s' "$out" | tr '\n' ' ')"
}

test.config.validateRequired() {
  local base; base=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t73.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }

  test.config.requiredFixture "$base/ok" dev
  local ok; ok=$(test.config.requiredRun "$base/ok")

  test.config.requiredFixture "$base/gone" dev omit          # no oosh.env at all
  local gone; gone=$(test.config.requiredRun "$base/gone")

  test.config.requiredFixture "$base/drift" dev "" prod      # persisted prod, checkout dev
  local drift; drift=$(test.config.requiredRun "$base/drift")
  rm -rf "$base" 2>/dev/null

  if [ "${ok%%|*}" != "0" ]; then
    create.result 1 "a complete config was rejected: [$ok]"
  elif [ "${gone%%|*}" = "0" ]; then
    create.result 1 "a config with no oosh.env was accepted — succeeding emptily is the bug"
  elif [ "${gone#*OOSH_MODE}" = "$gone" ] || [ "${gone#*OOSH_PM}" = "$gone" ]; then
    create.result 1 "the missing variables were not all named: [$gone]"
  elif [ "${drift%%|*}" = "0" ]; then
    create.result 1 "persisted prod against a dev checkout was accepted: [$drift]"
  elif [ "${drift#*prod}" = "$drift" ] || [ "${drift#*dev}" = "$drift" ]; then
    create.result 1 "the drift report names neither side: [$drift]"
  else
    create.result 0 "missing variables are named and branch drift is reported"
  fi
  return $(result)
}
test.case - "T73: config validate required names every missing variable and reports branch drift" \
  test.config.validateRequired
expect 0 "missing variables are named and branch drift is reported" \
  "config.init succeeded emptily on a missing config, and nothing compared the persisted branch to the checkout"

# ============================================================================
# T75: config.save survives a bash-3.2 `declare -p` stream
# ============================================================================
# THE BUG THIS PINS (docs/research/2026-09-17-config-save-bash32.md):
# on macOS /bin/bash 3.2.57, `declare -p` with NO NAMES is `set`-style — no
# `declare -x` prefix — and it ALSO prints every function body, verbatim and
# multi-line, into the same stream config.save filters. The filter derived a
# "variable name" with three string-strips and never checked it was one, so a
# function-body line with no `=` survived `${_vn%%=*}` whole and glob-matched
# `OOSH_*`. Rows of private.config.required.variables.get's heredoc became
# lines in ~/config/oosh.env, and every login printed
# "OOSH_MODE: command not found".
#
# Linux runs bash 5, where `declare -p` prints no functions — so this cannot
# be reproduced here, it has to be INJECTED. A shell function shadows a
# builtin, so the stub below reproduces 3.2's BROKEN no-argument output while
# delegating the CORRECT named form (`declare -p NAME`, measured right on 3.2)
# to the real builtin. Same move as T28's fixture, but wired to the real code
# path instead of to a grep.
test.config.bash32Save() { # <fixture> # run config.save under a simulated bash-3.2 `declare -p`; echo the file it generated
  (
    declare() {
      if [ "$1" = "-p" ] && [ $# -eq 1 ]; then
        # The four lines that really landed on the VM.
        printf '%s\n' "OOSH_PM='brew install'" \
                      "OOSH_PROMPT='oosh '" \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      'OOSH_OS oosh.env $OSTYPE, via os'
        return 0
      fi
      builtin declare "$@"
    }
    export OOSH_PM="brew install" OOSH_PROMPT="oosh "
    CONFIG_PATH="$1" CONFIG_FILE="bash32.env" CONFIG="$1/bash32.env" \
      config.save bash32 OOSH >/dev/null 2>&1
    cat "$1/bash32.env" 2>/dev/null
  )
}
test.config.saveSurvivesBash32Stream() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.bash32.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }
  local generated; generated=$(test.config.bash32Save "$fixture")
  rm -rf "$fixture" 2>/dev/null

  local junk unexported total
  # A junk row is NAME followed by a FILENAME — never an assignment. Anchoring
  # on "a word then a space" alone was wrong: `export OOSH_MODE="released"` is
  # also a word then a space, so the first version of this check failed on the
  # CORRECT output. Watched failing both ways, which is the point.
  junk=$(printf '%s\n' "$generated" | grep -c -E '^(export )?[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[a-z]+\.env[[:space:]]' 2>/dev/null)
  total=$(printf '%s\n' "$generated" | grep -c -E '[^[:space:]]' 2>/dev/null)
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if [ "${total:-0}" = "0" ]; then
    create.result 1 "config.save wrote nothing at all"
  elif [ "${junk:-0}" != "0" ]; then
    create.result 1 "$junk function-body row(s) were written as if they were variables: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported line(s) carry no 'export' — the sed cannot match bash 3.2 output: [$generated]"
  elif ! printf '%s\n' "$generated" | grep -q 'OOSH_PM='; then
    create.result 1 "OOSH_PM did not survive the save: [$generated]"
  else
    create.result 0 "every generated line is an export assignment"
  fi
  return $(result)
}
test.case - "T75: config.save survives a bash-3.2 declare -p stream" \
  test.config.saveSurvivesBash32Stream
expect 0 "every generated line is an export assignment" \
  "bash 3.2 declare -p is set-style AND dumps function bodies — rows of the required-variables table became lines in oosh.env"

# ============================================================================
# T76: private.config.variables.list emits variable NAMES, never anything else
# ============================================================================
# The unit-level pin for the shape gate. compgen -v can only produce valid
# identifiers, so the gate is belt-and-braces in production — this drives it
# directly, with compgen stubbed, which is the only way to see it work.
test.config.variablesListShapeGate() {
  local listed
  listed=$(
    compgen() {
      if [ "$1" = "-v" ]; then
        printf '%s\n' 'OOSH_TEST_MODE' \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      '9BAD' 'OOSH-DASH'
        return 0
      fi
      builtin compgen "$@"
    }
    private.config.variables.list OOSH 2>/dev/null
  )
  if [ "$listed" = "OOSH_TEST_MODE" ]; then
    create.result 0 "only a valid variable name survives the gate"
  else
    create.result 1 "expected just OOSH_TEST_MODE, got: [$listed]"
  fi
  return $(result)
}
test.case - "T76: private.config.variables.list returns names, not whatever starts with the prefix" \
  test.config.variablesListShapeGate
expect 0 "only a valid variable name survives the gate" \
  "the old filter took three string-strips as a variable name and never checked it was one"

# ============================================================================
# T77: private.config.variable.export.line — fidelity, and the dash promise
# ============================================================================
# The value must survive a round trip through EVERY shell that sources the
# generated file. these files are sourced by /bin/sh on Debian login shells,
# so bash alone is not enough (review-2026-09-09 § D1).
test.config.exportLineRoundTrip() {
  export OOSH_T77='a    b $HOME `x` "q" back\slash'
  local line; line=$(private.config.variable.export.line OOSH_T77 2>/dev/null)
  case "$line" in
    export\ OOSH_T77=*) ;;
    *) create.result 1 "not an export line: [$line]"; return $(result) ;;
  esac

  # Every available POSIX shell must reproduce the value byte for byte.
  local shellBin bin got broken=""
  for shellBin in sh dash ash bash busybox; do
    bin=$(command -v "$shellBin" 2>/dev/null) || continue
    [ -n "$bin" ] || continue
    if [ "$shellBin" = "busybox" ]; then bin="$bin sh"; fi
    got=$($bin -c "$line"'; printf %s "$OOSH_T77"' 2>/dev/null)
    [ "$got" = "$OOSH_T77" ] || broken="$broken $shellBin"
  done
  if [ -n "$broken" ]; then
    create.result 1 "the value did not survive:$broken — line was [$line]"
    return $(result)
  fi

  # A value carrying a NEWLINE cannot go into a line-oriented file, whatever
  # quoting bash picks for it — config.validate reads these one line at a time.
  #
  # THIS ASSERTION EARNED ITS KEEP on 2026-09-18: it went red on almalinux 9
  # during `oo stage testing` while passing on the host, ubuntu 24.04 and
  # macOS. The guard in config tested bash's RENDERING (`$'…'`) rather than the
  # value, and `$'…'` is a bash >= 5.2 behaviour — bash 5.1 emits a
  # double-quoted string with a literal newline in it, measured identically on
  # almalinux 9 (5.1.8), ubuntu 22.04 (5.1.16) and debian 11 (5.1.4). So the
  # guard caught nothing on any bash 5.1 and a two-line assignment was written
  # into oosh.env. Keep BOTH shapes below: they differ only in which bash
  # renders them which way, which is exactly the axis that hid the defect.
  export OOSH_T77_MULTI="line1
line2"
  export OOSH_T77_CR="a$(printf '\r')b"
  local multi multiRc cr crRc
  multi=$(private.config.variable.export.line OOSH_T77_MULTI 2>/dev/null); multiRc=$?
  cr=$(private.config.variable.export.line OOSH_T77_CR 2>/dev/null); crRc=$?
  # An array has no single-line export form.
  OOSH_T77_ARR=(a b)
  local arr arrRc
  arr=$(private.config.variable.export.line OOSH_T77_ARR 2>/dev/null); arrRc=$?
  # An unset name is not an error to report, just nothing to write.
  local gone goneRc
  gone=$(private.config.variable.export.line OOSH_T77_NEVER_SET 2>/dev/null); goneRc=$?
  unset OOSH_T77 OOSH_T77_MULTI OOSH_T77_CR OOSH_T77_ARR

  if [ "$multiRc" = "0" ] || [ -n "$multi" ]; then
    create.result 1 "a newline-bearing value was written as [$multi] — a line-oriented file cannot hold it, whatever quoting bash picked"
  elif [ "$crRc" = "0" ] || [ -n "$cr" ]; then
    create.result 1 "a carriage-return value was written as [$cr]"
  elif [ "$arrRc" = "0" ] || [ -n "$arr" ]; then
    create.result 1 "an array was written as [$arr]"
  elif [ "$goneRc" = "0" ] || [ -n "$gone" ]; then
    create.result 1 "an unset name produced [$gone]"
  else
    create.result 0 "the value round-trips through every shell, and the unwritable cases are refused"
  fi
  return $(result)
}
test.case - "T77: private.config.variable.export.line round-trips through every POSIX shell" \
  test.config.exportLineRoundTrip
expect 0 "the value round-trips through every shell, and the unwritable cases are refused" \
  "dash/ash shells source these files — a bash-only rendering breaks Debian login shells"

# ============================================================================
# T78: a trailing "_" in the prefix does not silence the sweep
# ============================================================================
# `backup config.save global` passes BACKUP_ (backup:262). The old gate was
# `${name}|${name}_*` — with the underscore already there that reads
# `BACKUP_|BACKUP__*`, which BACKUP_TARGET matches neither, so backup.env has
# been written empty all along.
test.config.variablesListTrailingUnderscore() {
  export BACKUP_TARGET="/some/where"
  local listed; listed=$(private.config.variables.list BACKUP_ 2>/dev/null)
  unset BACKUP_TARGET
  if printf '%s\n' "$listed" | grep -qx 'BACKUP_TARGET'; then
    create.result 0 "a trailing underscore in the prefix is tolerated"
  else
    create.result 1 "BACKUP_ found nothing; BACKUP_TARGET was set. got: [$listed]"
  fi
  return $(result)
}
test.case - "T78: config.save prefix tolerates a trailing underscore" \
  test.config.variablesListTrailingUnderscore
expect 0 "a trailing underscore in the prefix is tolerated" \
  "backup passes BACKUP_ and has been writing an empty backup.env ever since"

# The four placeholder cases `oo method.new` generated for
# private.config.variables.list / .variable.export.line / .variables.export /
# .string.upper were removed here, deliberately: all four are GETTERS consumed
# as $(...), so none calls create.result, and the template's
# `expect 0 "<result>"` would have compared whatever $RESULT the PREVIOUS test
# left behind — a test that cannot fail, which is the exact defect the
# "Tests that cannot fail" card is about. Their real coverage is T75-T78 above.
#
# templates/code/newMethodTest assumes a create.result method. A getter needs a
# different shape (assert on stdout, not on $RESULT). Recorded as a card —
# there is no newGetterTest template and this is not the last getter the tree
# will grow.

# ============================================================================
# T79: every generated line is an export assignment, and a one-argument
#      `config save <file>` derives its prefix without ${var^^}
# ============================================================================
# A REGRESSION GUARD, not a red-first test, and labelled so: on bash 5 the old
# code already produced export lines, and `${file^^}` already worked. Both
# halves fail only on macOS /bin/bash 3.2 — the first silently (no `export` on
# any line), the second fatally (a "bad substitution" that EXITS the shell).
# This pins the shapes so the fix cannot quietly come undone.
test.config.saveShapeAndPrefix() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.shape.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }

  # The upper-caser itself.
  local upper; upper=$(private.config.string.upper "myApp")
  if [ "$upper" != "MYAPP" ]; then
    rm -rf "$fixture" 2>/dev/null
    create.result 1 "private.config.string.upper myApp gave [$upper]"
    return $(result)
  fi

  # One argument: `config save myapp` must derive MYAPP and harvest MYAPP_*.
  export MYAPP_TOKEN="a value with spaces"
  (
    CONFIG_PATH="$fixture" CONFIG_FILE="myapp.env" CONFIG="$fixture/myapp.env" \
      config.save myapp >/dev/null 2>&1
  )
  local generated; generated=$(cat "$fixture/myapp.env" 2>/dev/null)
  unset MYAPP_TOKEN
  rm -rf "$fixture" 2>/dev/null

  local unexported
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if ! printf '%s\n' "$generated" | grep -q '^export MYAPP_TOKEN='; then
    create.result 1 "the one-argument form derived no prefix: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported generated line(s) are not export assignments: [$generated]"
  else
    create.result 0 "the prefix is derived and every line is an export assignment"
  fi
  return $(result)
}
test.case - "T79: config save <file> derives its prefix, and writes only export lines" \
  test.config.saveShapeAndPrefix
expect 0 "the prefix is derived and every line is an export assignment" \
  "on bash 3.2 the derivation was a fatal bad substitution and no line ever carried export"

# ============================================================================
# T80: every required-variable row has a deriver, and each one answers
# ============================================================================
# F6. private.config.required.variables.get declares "<variable> <file> <how it
# is re-derived>" and NOTHING read the third column — documentation of a repair
# that did not exist. That is why config.init.env could not repair, and why the
# macOS VM oscillated: OOSH_MODE present and OOSH_OS gone one hour, the reverse
# the next, depending only on which shell last wrote the file.
# See docs/research/2026-09-17-config-save-bash32.md §§ 6-8.
test.config.deriversAnswer() {
  local fixture; fixture=$(test.suite.fixture.make test.config.derive) \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/home" "$fixture/base/dev"
  ln -sfn "$fixture/base/dev" "$fixture/home/oosh"

  local mode os level cfgFile bashFile
  mode=$(HOME="$fixture/home" private.config.derive.oosh.mode 2>/dev/null)
  os=$(private.config.derive.oosh.os 2>/dev/null)
  # LOG_LEVEL is set to 1 by the suite itself, and the deriver correctly lets an
  # already-chosen level win. Unset it to exercise the FALLBACK, which is the
  # half the table got wrong: it said "defaults to 1" and both this:16 and
  # log:125 use 3.
  level=$( unset LOG_LEVEL; private.config.derive.log.level 2>/dev/null )
  cfgFile=$(private.config.derive.config.file 2>/dev/null)
  bashFile=$(private.config.derive.bash.file 2>/dev/null)
  rm -rf "$fixture" 2>/dev/null

  if [ "$mode" != "dev" ]; then
    create.result 1 "oosh.mode derived [$mode], expected 'dev' — it is the basename of the canonical ~/oosh"
  elif [ -z "$os" ]; then
    create.result 1 "oosh.os derived nothing; os.check.env maps \$OSTYPE and must always answer"
  elif [ "$level" != "3" ]; then
    create.result 1 "log.level derived [$level], expected 3 — the table said 1, but this:16 and log:125 both default to 3"
  elif [ "$cfgFile" != "user.env" ]; then
    create.result 1 "config.file derived [$cfgFile], expected user.env"
  elif [ ! -x "${bashFile%% *}" ]; then
    create.result 1 "bash.file derived [$bashFile], which is not executable"
  else
    create.result 0 "every deriver answers"
  fi
  return $(result)
}
test.case - "T80: each required variable has a deriver that answers" \
  test.config.deriversAnswer
expect 0 "every deriver answers" \
  "the table's third column was prose nothing could run — that is why the advertised repair could not repair"

# ============================================================================
# T81: config.init.env RE-DERIVES a missing required variable
# ============================================================================
# F5, reproduced. Measured on a clean macOS VM 2026-09-17: `config validate
# required` said `missing: OOSH_MODE OOSH_OS`, the operator ran the repair it
# advertises, and it came back `missing: OOSH_MODE OOSH_OS OOSH_PM` with
# oosh.env EMPTY. config.save persists the ENVIRONMENT, and the environment is
# populated FROM the config — a closed loop with no source of truth, so a value
# that falls out can never come back.
test.config.initEnvRederives() { # <dir> # run config.init.env against <dir> with OOSH_OS empty; echo the resulting oosh.env
  env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
      CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1
  cat "$1/oosh.env" 2>/dev/null
}
test.config.initEnvRepairsMissing() {
  local base; base=$(test.suite.fixture.make test.config.rederive) \
    || { create.result 1 "mktemp failed"; return $(result); }
  # A tier that is complete EXCEPT for OOSH_OS — exactly the VM's state.
  test.config.requiredFixture "$base" dev
  # Remove the one variable. Nothing in a shell re-derives it (os.check.env is
  # never called by boot/this/config), so without a repair it is gone for good.
  grep -v 'OOSH_OS=' "$base/oosh.env" > "$base/oosh.env.tmp" && mv "$base/oosh.env.tmp" "$base/oosh.env"
  local after; after=$(test.config.initEnvRederives "$base")
  rm -rf "$base" 2>/dev/null

  if [ -z "$after" ]; then
    create.result 1 "config.init.env produced an EMPTY oosh.env — the measured macOS failure"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_OS='; then
    create.result 1 "OOSH_OS was not re-derived; oosh.env is now: [$(printf '%s' "$after" | tr '\n' ' ')]"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_MODE='; then
    create.result 1 "the repair lost OOSH_MODE, which was present before it ran"
  else
    create.result 0 "the missing variable is re-derived and the surviving ones are kept"
  fi
  return $(result)
}
test.case - "T81: config.init.env re-derives a missing required variable instead of re-persisting the gap" \
  test.config.initEnvRepairsMissing
expect 0 "the missing variable is re-derived and the surviving ones are kept" \
  "the command config validate required advertises as the repair made the report WORSE on a real machine"

# ============================================================================
# T82: the repair can never leave the report worse than it found it
# ============================================================================
# The guard that would have caught the macOS failure as it happened. A repair
# that cannot repair must leave the tier alone, not overwrite it with less.
test.config.initEnvNeverWorsens() {
  local base; base=$(test.suite.fixture.make test.config.noworsen) \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.config.requiredFixture "$base" dev
  local before; before=$(cat "$base/oosh.env" 2>/dev/null)
  # Point HOME at a home with NO ~/oosh symlink, so oosh.mode cannot derive.
  rm -f "$base/home/oosh"
  env -i PATH="$PATH" HOME="$base/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
      CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1
  local after; after=$(cat "$base/oosh.env" 2>/dev/null)
  local beforeCount afterCount
  beforeCount=$(printf '%s\n' "$before" | grep -c '^export ')
  afterCount=$(printf '%s\n' "$after" | grep -c '^export ')
  rm -rf "$base" 2>/dev/null

  if [ -z "$after" ]; then
    create.result 1 "the repair emptied oosh.env when it could not derive — exactly the macOS failure"
  elif [ "${afterCount:-0}" -lt "${beforeCount:-0}" ]; then
    create.result 1 "the repair lost variables: $beforeCount export lines before, $afterCount after"
  else
    create.result 0 "a repair that cannot repair leaves the tier no worse"
  fi
  return $(result)
}
test.case - "T82: a repair that cannot derive leaves the config no worse than it found it" \
  test.config.initEnvNeverWorsens
expect 0 "a repair that cannot repair leaves the tier no worse" \
  "on the VM the advertised repair went from 2 missing variables to 3, and emptied the file"

# ============================================================================
# T83: config.save reports an invalid file it just wrote — on STDERR
# ============================================================================
# F4. config.save validated what it wrote and threw the verdict away
# (`>/dev/null 2>&1 || warn.log`), which is why card 1's corruption reached a
# user at all: config.validate caught it on the FIRST macOS install and nobody
# heard it.
#
# STDERR, not stdout, and the reason is load-bearing: user:1702-1708 records
# that `$(user get basehome)` CAPTURES config.save's stdout, and a stray line
# there once propagated a garbage IdentityFile into a generated ssh config and
# failed the downstream git clone. stderr survives every LOG_LEVEL just as well
# and $( ) does not capture it.
#
# config.validate is shadowed rather than a file seeded invalid, because
# config.save REWRITES all three files before validating them — a seeded file
# would simply be replaced. Same technique as T75.
test.config.saveReportsInvalid() {
  local base; base=$(test.suite.fixture.make test.config.f4) \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out err rc
  out=$(
    config.validate() { return 1; }        # every file it writes "fails" validation
    CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
      config.save 2>"$base/stderr.txt"
    echo "RC=$?"
  )
  err=$(cat "$base/stderr.txt" 2>/dev/null)
  rc=$(printf '%s' "$out" | sed -n 's/.*RC=\([0-9]*\).*/\1/p')
  # The VERDICT must not be on stdout. NOT "stdout is empty" — the first version
  # of this assertion said that and was wrong: config.save has always written
  # `console.log` to stdout, 0 lines at LOG_LEVEL 1 but 9 at level 3, and the
  # container gate runs test cases above level 1. That is long-standing
  # behaviour which `$(user get basehome)` already defends against by forcing
  # LOG_DEVICE=/dev/null and redirecting (user:1699-1722). What card 2 could
  # newly break is putting the VERDICT there, so that is what is pinned.
  local stdoutNoise; stdoutNoise=$(printf '%s' "$out" | grep -c 'INVALID')
  rm -rf "$base" 2>/dev/null

  if [ "${rc:-0}" = "0" ]; then
    create.result 1 "config.save returned 0 after writing a file its own validator rejected"
  elif ! printf '%s\n' "$err" | grep -qE 'INVALID|invalid'; then
    create.result 1 "no verdict on stderr; stderr was: [$(printf '%s' "$err" | tr '\n' ' ')]"
  elif [ "${stdoutNoise:-0}" != "0" ]; then
    create.result 1 "the verdict reached STDOUT ($stdoutNoise line(s)); it belongs on stderr because $(user get basehome) captures stdout"
  else
    create.result 0 "the verdict reaches stderr and the exit status, stdout stays clean"
  fi
  return $(result)
}
test.case - "T83: config.save reports a file it wrote that its own validator rejects" \
  test.config.saveReportsInvalid
expect 0 "the verdict reaches stderr and the exit status, stdout stays clean" \
  "the guard caught card 1's corruption on the first install and the verdict went to /dev/null"

# The six placeholder cases `oo method.new` generated for the
# private.config.derive.* family were removed here, for the same reason as the
# four in card 1: every one of them is a GETTER consumed as $(...), so none sets
# $RESULT, and templates/code/newMethodTest's `expect 0 "<result>"` would have
# compared whatever the PREVIOUS test left behind. Six more tests that cannot
# fail. Their real coverage is T80 above.
#
# This is the second ticket in two days to hit it. The card for a newGetterTest
# template is filed; until it exists, generating a getter means deleting six
# placeholder cases by hand.

# ============================================================================
# T84: a rewrite never drops a required variable the file already carried
# ============================================================================
# Card 3. config.save persists the ENVIRONMENT and truncates with `{ … } >$CONFIG`,
# so a shell that is missing a required variable REWRITES THE FILE WITHOUT IT.
# `oo mode <branch>` is the live example (oo:938-940): it sets OOSH_MODE and
# immediately runs `config save oosh OOSH` from that shell — which has OOSH_MODE
# but nothing re-derives OOSH_OS at shell init, so OOSH_OS is dropped.
#
# That is the oscillation measured on the macOS VM across 2026-09-17: OOSH_OS
# present and OOSH_MODE missing at one point, the exact reverse an hour later.
# Card 2 made the config REPAIRABLE; this makes it stop degrading.
#
# Carrying forward is deliberately NOT derivation. Deriving belongs in
# config.init.env (card 2) where it can source `os` and take its time; the
# WRITER only has to refrain from throwing away what it was already holding.
test.config.saveKeepsRequired() {
  local fixture; fixture=$(test.suite.fixture.make test.config.keep) \
    || { create.result 1 "mktemp failed"; return $(result); }
  # A complete oosh.env, as a healthy host has.
  printf 'export OOSH_MODE="dev"\nexport OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' \
    > "$fixture/oosh.env"
  : > "$fixture/user.env"
  # A shell like the one `oo mode` saves from: OOSH_MODE set, OOSH_OS absent.
  local after
  after=$(
    unset OOSH_OS
    export OOSH_MODE="dev"
    CONFIG_PATH="$fixture" CONFIG_FILE=oosh.env CONFIG="$fixture/oosh.env" \
      config.save oosh OOSH >/dev/null 2>&1
    cat "$fixture/oosh.env" 2>/dev/null
  )
  rm -rf "$fixture" 2>/dev/null

  if ! printf '%s\n' "$after" | grep -q '^export OOSH_MODE='; then
    create.result 1 "OOSH_MODE, which the saving shell HAD, is missing: [$(printf '%s' "$after" | tr '\n' ' ')]"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_OS='; then
    create.result 1 "OOSH_OS was in the file and the rewrite dropped it — this is how the VM degraded"
  else
    create.result 0 "a rewrite keeps the required variables the file already carried"
  fi
  return $(result)
}
test.case - "T84: config.save does not drop a required variable the file already had" \
  test.config.saveKeepsRequired
expect 0 "a rewrite keeps the required variables the file already carried" \
  "oo mode saves oosh.env from a shell that has OOSH_MODE and no OOSH_OS, and the file loses OOSH_OS"

# ============================================================================
# T85: the config anchor survives into a GRANDCHILD process
# ============================================================================
# test.suite.config.isolate exports CONFIG_PATH, and a test that reaches a
# subprocess relies on that export surviving. On 2026-09-17 a macOS probe caught
# it NOT surviving: the audit had CONFIG_PATH=<fixture> and `export -p` agreed,
# and the `config` process two levels down had it EMPTY and defaulted to
# ~/config, writing the shared tier (research § 2 / § 5).
#
# That was never reproduced afterwards — see research § 17 for what was ruled
# out — and the chain that produced it no longer runs. But "isolation held the
# last five times I looked" is not a guarantee, and nothing in the suite
# asserted the property at all. This does.
#
# It is deliberately a WRITE test, not a variable-echo test: what matters is not
# that the child can read the anchor but that its writes land in the fixture and
# the real tier is untouched. That is what the canary guards globally and what
# this pins for one explicit, deep call chain.
test.config.anchorSurvivesGrandchild() {
  local fixture; fixture=$(test.suite.fixture.make test.config.anchor) \
    || { create.result 1 "mktemp failed"; return $(result); }
  : > "$fixture/user.env"
  local realTier="${TEST_SUITE_CONFIG_ORIGIN:-$HOME/config}"
  local realBefore realAfter
  realBefore=$(cat "$realTier/oosh.env" 2>/dev/null | cksum)

  # TWO levels: this shell → bash -c → config. The shape the macOS probe caught
  # losing the anchor was audit → oo → config, the same depth.
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    bash -c "\"$OOSH_DIR/config\" save oosh OOSH" >/dev/null 2>&1

  realAfter=$(cat "$realTier/oosh.env" 2>/dev/null | cksum)
  local wroteFixture=0
  [ -s "$fixture/oosh.env" ] && wroteFixture=1
  rm -rf "$fixture" 2>/dev/null

  if [ "$realBefore" != "$realAfter" ]; then
    create.result 1 "a grandchild config.save wrote the REAL tier $realTier — the anchor did not survive"
  elif [ "$wroteFixture" != "1" ]; then
    create.result 1 "the grandchild wrote nothing to the fixture; it did not see CONFIG_PATH at all"
  else
    create.result 0 "the anchor survives two levels down and the write lands in the fixture"
  fi
  return $(result)
}
test.case - "T85: an exported CONFIG_PATH survives into a grandchild process" \
  test.config.anchorSurvivesGrandchild
expect 0 "the anchor survives two levels down and the write lands in the fixture" \
  "a macOS probe once caught a grandchild defaulting to ~/config and writing the shared tier"

# ============================================================================
# The MacStudio config model (dev.config, Round 1.1 — red until Round 2)
# ============================================================================
# user.env: the CONFIG_* anchors, PATH, BASH_FILE, then
# `. $CONFIG_PATH/oosh.env` and `. $CONFIG_PATH/log.env`. oosh.env: EVERY
# OOSH_* variable; log.env: EVERY LOG_* variable, its last line
# `. $HOME/.config/oosh/log.session.env`. ~/config is SHARED between users,
# so a value under the saving user's $HOME is written "$HOME/…" — correct for
# every user of the shared files. Every line is `export X="v"`: pure data.

# T-CONFIG-SAVE-PREFIX-OOSH: every OOSH_* variable, $HOME-relative
test.config.savePrefixOosh() {
  local fx bad="" f; fx=$(test.suite.fixture.make saveprefixoosh); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export OOSH_DIR="$fx/oosh" OOSH_COMPONENTS_DIR="/opt/probe/base" OOSH_PROBE="plain value"
    export OOSH_SHLVL=5 OOSH_STATUS="0: started in shell level: 2" OOSH_PROMPT="oosh " OOSH_CONFIG_NEEDS_SAVE=1
    config.save oosh OOSH ) >/dev/null 2>&1
  f="$fx/config/oosh.env"
  grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$f" 2>/dev/null || bad="$bad OOSH_DIR"
  grep -qxF 'export OOSH_COMPONENTS_DIR="/opt/probe/base"' "$f" 2>/dev/null || bad="$bad OOSH_COMPONENTS_DIR"
  grep -qxF 'export OOSH_PROBE="plain value"' "$f" 2>/dev/null || bad="$bad OOSH_PROBE"
  grep -qE '^export (OOSH_SHLVL|OOSH_STATUS|OOSH_PROMPT|OOSH_CONFIG_NEEDS_SAVE)=' "$f" 2>/dev/null && bad="$bad runtime-reading-saved"
  grep -vqE '^export OOSH_[A-Z0-9_]+=".*"$' "$f" 2>/dev/null && bad="$bad foreign-line=[$(grep -vE '^export OOSH_[A-Z0-9_]+=".*"$' "$f" | head -1)]"
  grep -qF "$fx" "$f" 2>/dev/null && bad="$bad absolute-home-leaked"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oosh.env holds every OOSH_* setting, \$HOME-relative, no runtime reading" || create.result 1 "oosh.env:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-PREFIX-OOSH: config save oosh saves every OOSH_* variable, \$HOME-relative" test.config.savePrefixOosh
expect 0 "oosh.env holds every OOSH_* setting, \$HOME-relative, no runtime reading" "the MacStudio model: config save oosh saves all OOSH_ settings"

# T-CONFIG-SAVE-PREFIX-LOG: every LOG_* variable, then the session chain line
test.config.savePrefixLog() {
  local fx bad="" f; fx=$(test.suite.fixture.make saveprefixlog); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export LOG_LEVEL_RESET="3"
    export LOG_DEVICE="/dev/pts/9" LOG_NAME="probe" LOG_LIVE="$fx/log.live"
    config.save log LOG ) >/dev/null 2>&1
  f="$fx/config/log.env"
  grep -qxF 'export LOG_LEVEL_RESET="3"' "$f" 2>/dev/null || bad="$bad LOG_LEVEL_RESET"
  grep -qE '^export (LOG_DEVICE|LOG_NAME|LOG_LIVE)=' "$f" 2>/dev/null && bad="$bad session-value-saved"
  [ "$(tail -1 "$f" 2>/dev/null)" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad chain-not-last"
  sed '$d' "$f" 2>/dev/null | grep -vqE '^export LOG_[A-Z0-9_]+=".*"$' && bad="$bad foreign-line"
  grep -qF "$fx" "$f" 2>/dev/null && bad="$bad absolute-home-leaked"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "log.env holds every LOG_* setting, not the session values, and ends with the session chain" || create.result 1 "log.env:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-PREFIX-LOG: config save log saves every LOG_* setting, not the session values, the session chain last" test.config.savePrefixLog
expect 0 "log.env holds every LOG_* setting, not the session values, and ends with the session chain" "LOG_NAME/LOG_DEVICE/LOG_LIVE belong in each user's log.session.env"

# T-CONFIG-SAVE-USER-ENV-LAYOUT: the bare config save writes user.env exactly
test.config.saveUserEnvLayout() {
  local fx bad="" expected; fx=$(test.suite.fixture.make saveuserenv); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/usr/bin/bash" ODOCKER_WORKSPACES="$fx/ws" PATH="$fx/.local/bin:/usr/bin:/bin"
    config.save ) >/dev/null 2>&1
  expected='export CONFIG_PATH="$HOME/config"
export CONFIG_FILE="user.env"
export CONFIG="$HOME/config/user.env"
export PATH="$HOME/oosh:$HOME/oosh/ng:$HOME/.local/bin:/usr/bin:/bin:$PATH"
export BASH_FILE="/usr/bin/bash"
. $CONFIG_PATH/oosh.env
. $CONFIG_PATH/log.env'
  [ "$(cat "$fx/config/user.env" 2>/dev/null)" = "$expected" ] || bad=" got=[$(tr '\n' '|' < "$fx/config/user.env" 2>/dev/null)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "user.env: anchors, PATH, BASH_FILE, then oosh.env and log.env; ODOCKER_WORKSPACES stays in odocker.env" || create.result 1 "user.env layout:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-USER-ENV-LAYOUT: config save writes user.env in the MacStudio layout" test.config.saveUserEnvLayout
expect 0 "user.env: anchors, PATH, BASH_FILE, then oosh.env and log.env; ODOCKER_WORKSPACES stays in odocker.env" "user.env starts a shell on its own — no boot"

# T-CONFIG-LOG-ENV-CHAIN-LAST: after a full save, and again after a re-save, the chain is last and once
test.config.logEnvChainLast() {
  local fx bad="" f n; fx=$(test.suite.fixture.make logenvchain); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    config.save; config.save ) >/dev/null 2>&1
  f="$fx/config/log.env"
  [ "$(tail -1 "$f" 2>/dev/null)" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad not-last"
  n=$(grep -cxF '. $HOME/.config/oosh/log.session.env' "$f" 2>/dev/null)
  [ "$n" = 1 ] || bad="$bad count=$n"
  grep -q 'log.session.env' "$fx/config/user.env" 2>/dev/null && bad="$bad chained-from-user.env"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "log.env ends with the unguarded session chain, exactly once" || create.result 1 "log.env chain:$bad"
  return $(result)
}
test.case $level "T-CONFIG-LOG-ENV-CHAIN-LAST: log.env ends with the session chain, once, after every save" test.config.logEnvChainLast
expect 0 "log.env ends with the unguarded session chain, exactly once" "the line that went missing in the boot removal"

# T-CONFIG-SESSION-FILE-ENSURE: every user gets ~/.config/oosh/log.session.env, so the chain needs no guard
test.config.sessionFileEnsure() {
  local fx bad="" f; fx=$(test.suite.fixture.make sessionfile)
  f="$fx/.config/oosh/log.session.env"
  private.config.session.file.ensure "$fx" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -f "$f" ] || bad="$bad not-created"
  printf 'export LOG_NAME="kept"\n' > "$f" 2>/dev/null
  private.config.session.file.ensure "$fx" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$(cat "$f" 2>/dev/null)" = 'export LOG_NAME="kept"' ] || bad="$bad existing-content-changed"
  private.config.session.file.ensure "" >/dev/null 2>&1 && bad="$bad empty-home-passed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the session file is created once and never overwritten" || create.result 1 "session file:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SESSION-FILE-ENSURE: config init.user and the install create log.session.env for every user" test.config.sessionFileEnsure
expect 0 "the session file is created once and never overwritten" "log.env chains it unguarded — it must exist for every user"

# T-CONFIG-SAVE-PATH-BASH-DIR: a bash outside /bin and /usr/bin (brew on macOS) is put on
# PATH by user.env itself, right after the oosh dirs — as data, computed at save time.
# boot used to prepend dirname $BASH_FILE on every shell.
test.config.savePathBashDir() {
  local fx bad="" line; fx=$(test.suite.fixture.make savebashdir); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/opt/homebrew/bin/bash"
    unset ODOCKER_WORKSPACES; export PATH="/usr/bin:/bin"
    config.save ) >/dev/null 2>&1
  line=$(grep '^export PATH=' "$fx/config/user.env" 2>/dev/null)
  [ "$line" = 'export PATH="$HOME/oosh:$HOME/oosh/ng:/opt/homebrew/bin:/usr/bin:/bin:$PATH"' ] || bad=" got=[$line]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "user.env puts the brew bash directory on PATH after the oosh dirs" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-PATH-BASH-DIR: a brew bash directory is part of user.env's PATH line" test.config.savePathBashDir
expect 0 "user.env puts the brew bash directory on PATH after the oosh dirs" \
  "without boot nothing else puts brew bash ahead of /bin/bash 3.2 on macOS"

# T-CONFIG-SAVE-ANCHORS-CONSTANT: the anchors are the ~/… constants, whatever the saving shell holds
# The installer's shell holds CONFIG_PATH as the RESOLVED sharedConfig — not under
# $HOME, so it was written literally and every user's shell got a physical path
# (found by the first os platform.test on dev.config). CONFIG_PATH, CONFIG,
# OOSH_DIR are always "$HOME/…" (T31, T-CONFIG-PATH-IS-HOME-CONFIG). OOSH_USER_CONFIG_PATH,
# exported by an old shell, is never saved (T44).
test.config.saveAnchorsConstant() {
  local fx shared bad="" f; fx=$(test.suite.fixture.make anchorhome); shared=$(test.suite.fixture.make anchorshared)
  ( export HOME="$fx" CONFIG_PATH="$shared" CONFIG_FILE=user.env CONFIG="$shared/user.env"
    export OOSH_DIR="$shared/tree" OOSH_USER_CONFIG_PATH="$shared/percfg"
    config.save ) >/dev/null 2>&1
  for want in 'export CONFIG_PATH="$HOME/config"' 'export CONFIG="$HOME/config/user.env"'; do
    grep -qxF "$want" "$shared/user.env" 2>/dev/null || bad="$bad user.env-missing=[$want]"
  done
  grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$shared/oosh.env" 2>/dev/null || bad="$bad oosh.env-missing=[OOSH_DIR]"
  grep -q 'OOSH_USER_CONFIG_PATH' "$shared/oosh.env" 2>/dev/null && bad="$bad OOSH_USER_CONFIG_PATH-saved"
  grep -qF "$shared" "$shared/user.env" "$shared/oosh.env" 2>/dev/null && bad="$bad resolved-path-written"
  rm -rf "$fx" "$shared"
  [ -z "$bad" ] && create.result 0 "the anchors are written as the ~/… constants" || create.result 1 "anchors:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-ANCHORS-CONSTANT: config save writes the anchors as the ~/… constants" test.config.saveAnchorsConstant
expect 0 "the anchors are written as the ~/… constants" "the installer's resolved sharedConfig became every user's CONFIG_PATH"

# T-CONFIG-SAVE-LOG-ENSURES-SESSION: whoever writes the chain line makes sure the saver's target exists
# The installing user and root get their config through `config save` only —
# not user.oosh.install / config init.user — so on the first os platform.test
# `test` had no log.session.env and dash failed on log.env's last line.
test.config.saveLogEnsuresSession() {
  local fx bad=""; fx=$(test.suite.fixture.make logensures); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    config.save log LOG ) >/dev/null 2>&1
  [ -f "$fx/.config/oosh/log.session.env" ] || bad=" no-session-file"
  ( export HOME="$fx"; sh -c '. "$HOME/config/log.env"' ) >/dev/null 2>&1 || bad="$bad log.env-not-sourceable"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save log leaves a sourceable log.env and the saver's session file" || create.result 1 "session:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-LOG-ENSURES-SESSION: config save log creates the saving user's log.session.env" test.config.saveLogEnsuresSession
expect 0 "config save log leaves a sourceable log.env and the saver's session file" "dash: .: cannot open …/log.session.env — the installing user had none"

# T-CONFIG-PATH-LINE: user.env's PATH line is a snapshot of the saving shell's PATH, made safe
# The MacStudio model writes the whole PATH. On a SHARED ~/config it must still be
# right for every user: ~/oosh and ~/oosh/ng first, then a bash outside /bin and
# /usr/bin, then the saver's PATH — each segment under $HOME written "$HOME/…",
# trailing slashes dropped, no empty or "." segment (CWE-426), nothing relative,
# nothing transient (/tmp, a .vscode-server CLI), each segment once — and ":$PATH"
# last, so what the system adds after the save still reaches the shell.
test.config.pathLine() {
  local fx bad="" got want; fx=$(test.suite.fixture.make pathline)
  got=$( export HOME="$fx" BASH_FILE="/opt/homebrew/bin/bash"
         PATH="/opt/homebrew/bin/:$fx/.nvm/bin:.::rel/bin:/tmp/test.oo.1/bin:$fx/oosh/:/usr/bin:/usr/bin:$fx/.vscode-server/bin/abc/bin/remote-cli:/bin" \
           private.config.path.line.get 2>/dev/null )
  want='export PATH="$HOME/oosh:$HOME/oosh/ng:/opt/homebrew/bin:$HOME/.nvm/bin:/usr/bin:/bin:$PATH"'
  [ "$got" = "$want" ] || bad=" got=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH line: oosh first, the saver's PATH made safe, :\$PATH last" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-PATH-LINE: user.env's PATH line is the saving shell's PATH, made safe for every user" test.config.pathLine
expect 0 "PATH line: oosh first, the saver's PATH made safe, :\$PATH last" \
  "the MacStudio model writes the whole PATH, but ~/config is shared"

# T-CONFIG-PATH-LINE-PHYSICAL-OOSH: the physical folder of ~/oosh is written as $HOME/oosh
# Found in a fresh platform container (2026-10-01): root saved the shared
# user.env while its PATH held the shared tree under its PHYSICAL name
# (…/Once.sh/dev.config, /ng, /su, /init, /external). Those went in literally:
# after `oo mode testing` (~/oosh -> testing) the old branch's su/init/external
# still came first on every user's PATH. The physical folder of ~/oosh — and
# anything below it — is ~/oosh, so it is written "$HOME/oosh…" and merges
# with the oosh entries instead of duplicating them.
test.config.pathLinePhysicalOosh() {
  local fx bad="" got want shared; fx=$(test.suite.fixture.make pathlinephys)
  shared="$fx/shared/Once.sh/dev.config"
  mkdir -p "$shared/ng" "$shared/su" "$fx/home"; ln -s "$shared" "$fx/home/oosh"
  got=$( export HOME="$fx/home" BASH_FILE="/usr/bin/bash"
         PATH="$shared:$shared/ng:$shared/su:/usr/bin:/bin" private.config.path.line.get 2>/dev/null )
  want='export PATH="$HOME/oosh:$HOME/oosh/ng:$HOME/oosh/su:/usr/bin:/bin:$PATH"'
  [ "$got" = "$want" ] || bad=" got=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH line: the physical ~/oosh folder written as \$HOME/oosh, merged" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-PATH-LINE-PHYSICAL-OOSH: the physical folder of ~/oosh is written as \$HOME/oosh" test.config.pathLinePhysicalOosh
expect 0 "PATH line: the physical ~/oosh folder written as \$HOME/oosh, merged" \
  "root's install PATH put the shared tree's physical paths into every user's user.env"

# ============================================================================
# `config save` as a COMMAND — the way a user types it (dev.config, config-save round)
# ============================================================================
# Every other config.save test calls the FUNCTION in the test shell. Typed at
# the prompt, `config` is an executable: a CHILD process that sees only what the
# parent exported, does not re-read user.env, and dispatches through
# config.start / this.start. These cases run the real executable under `env -i`
# with a fixture HOME and only the variables they export.
test.config.cmd.fixture() { # <label> # echo a fixture dir: $fx/home with an empty config/user.env, the anchors a child needs
  local fx; fx=$(test.suite.fixture.make "$1") || return 1
  mkdir -p "$fx/home/config" "$fx/home/.config/oosh"
  : > "$fx/home/config/user.env"
  echo "$fx"
}

# T-CONFIG-CMD-SAVE-OOSH: `config save oosh` writes every exported OOSH_* setting, never a runtime reading
test.config.cmdSaveOosh() {
  local fx bad="" f; fx=$(test.config.cmd.fixture cmdsaveoosh); f="$fx/home/config/oosh.env"
  env -i PATH="$PATH" HOME="$fx/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
    CONFIG_PATH="$fx/home/config" CONFIG_FILE=user.env CONFIG="$fx/home/config/user.env" \
    OOSH_MODE=dev OOSH_PM="apt-get -y install" OOSH_PROBE="plain value" \
    OOSH_SHLVL=5 OOSH_STATUS="0: started in shell level: 2" OOSH_PROMPT="oosh " OOSH_CONFIG_NEEDS_SAVE=1 \
    OOSH_CLEAN_ENV=1 OOSH_APT_UPDATED=1 OOSH_PM_BIN=apt-get OOSH_USER_CONFIG_PATH="$fx/home/.config/oosh" \
    "$OOSH_DIR/config" save oosh >/dev/null 2>&1 </dev/null
  for want in 'export OOSH_MODE="dev"' 'export OOSH_PM="apt-get -y install"' 'export OOSH_PROBE="plain value"' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_PM_BIN="apt-get"'; do
    grep -qxF "$want" "$f" 2>/dev/null || bad="$bad missing=[$want]"
  done
  grep -qE '^export (OOSH_SHLVL|OOSH_STATUS|OOSH_PROMPT|OOSH_CONFIG_NEEDS_SAVE|OOSH_CLEAN_ENV|OOSH_APT_UPDATED|OOSH_USER_CONFIG_PATH)=' "$f" 2>/dev/null \
    && bad="$bad runtime=[$(grep -E '^export (OOSH_SHLVL|OOSH_STATUS|OOSH_PROMPT|OOSH_CONFIG_NEEDS_SAVE|OOSH_CLEAN_ENV|OOSH_APT_UPDATED|OOSH_USER_CONFIG_PATH)=' "$f" | tr '\n' ' ')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save oosh: every OOSH_* setting, no runtime reading" || create.result 1 "config save oosh:$bad"
  return $(result)
}
test.case $level "T-CONFIG-CMD-SAVE-OOSH: typed \`config save oosh\` saves every OOSH_* setting and no runtime reading" test.config.cmdSaveOosh
expect 0 "config save oosh: every OOSH_* setting, no runtime reading" \
  "OOSH_SHLVL/OOSH_STATUS/OOSH_PROMPT of one shell were saved and looped into every new shell"

# T-CONFIG-CMD-SAVE-LOG: `config save log` writes the LOG_* settings, not the per-user session values
test.config.cmdSaveLog() {
  local fx bad="" f; fx=$(test.config.cmd.fixture cmdsavelog); f="$fx/home/config/log.env"
  env -i PATH="$PATH" HOME="$fx/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 LOG_LEVEL_RESET=3 \
    CONFIG_PATH="$fx/home/config" CONFIG_FILE=user.env CONFIG="$fx/home/config/user.env" \
    LOG_NAME="saver@host" LOG_DEVICE="/dev/null" LOG_LIVE="$fx/home/.config/oosh/log.live.out" \
    "$OOSH_DIR/config" save log >/dev/null 2>&1 </dev/null
  for want in 'export LOG_LEVEL="1"' 'export LOG_LEVEL_RESET="3"'; do
    grep -qxF "$want" "$f" 2>/dev/null || bad="$bad missing=[$want]"
  done
  grep -qE '^export (LOG_NAME|LOG_DEVICE|LOG_LIVE)=' "$f" 2>/dev/null \
    && bad="$bad session=[$(grep -E '^export (LOG_NAME|LOG_DEVICE|LOG_LIVE)=' "$f" | tr '\n' ' ')]"
  [ "$(tail -1 "$f" 2>/dev/null)" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad chain-not-last"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save log: the LOG_* settings, no session value, the chain last" || create.result 1 "config save log:$bad"
  return $(result)
}
test.case $level "T-CONFIG-CMD-SAVE-LOG: typed \`config save log\` keeps LOG_NAME/LOG_DEVICE/LOG_LIVE out of the shared log.env" test.config.cmdSaveLog
expect 0 "config save log: the LOG_* settings, no session value, the chain last" \
  "a new user inherited the saver's LOG_NAME from the shared log.env"

# T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS: `config save` keeps every chain line user.env had
test.config.cmdSaveUserKeepsChains() {
  local fx bad="" f got want; fx=$(test.config.cmd.fixture cmdsavechains); f="$fx/home/config/user.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' \
    '. $CONFIG_PATH/odocker.env' 'source $CONFIG_PATH/myapp.env' '. $CONFIG_PATH/gone.env' > "$f"
  : > "$fx/home/config/odocker.env"; : > "$fx/home/config/myapp.env"
  env -i PATH="$PATH" HOME="$fx/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 BASH_FILE=/usr/bin/bash \
    CONFIG_PATH="$fx/home/config" CONFIG_FILE=user.env CONFIG="$f" \
    "$OOSH_DIR/config" save >/dev/null 2>&1 </dev/null
  got=$(grep -E '^(\.|source) ' "$f" 2>/dev/null)
  want='. $CONFIG_PATH/oosh.env
. $CONFIG_PATH/log.env
. $CONFIG_PATH/odocker.env
. $CONFIG_PATH/myapp.env
. $CONFIG_PATH/gone.env'
  [ "$got" = "$want" ] || bad=" chains=[$(printf '%s' "$got" | tr '\n' '|')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save keeps every chain, source written as ., each once, after oosh and log" || create.result 1 "config save:$bad"
  return $(result)
}
test.case $level "T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS: typed \`config save\` keeps odocker.env and every other chain" test.config.cmdSaveUserKeepsChains
expect 0 "config save keeps every chain, source written as ., each once, after oosh and log" \
  "config save rebuilt user.env and dropped . \$CONFIG_PATH/odocker.env"


# T-CONFIG-CHAIN-NAMES-GET: the chain names of a user.env, `.` and `source` alike, junk ignored
test.config.chainNamesGet() {
  local fx got want; fx=$(test.suite.fixture.make chainnames)
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' '. $CONFIG_PATH/oosh.env' '  . $CONFIG_PATH/log.env  ' \
    'source $CONFIG_PATH/myapp.env' '# . $CONFIG_PATH/commented.env' '. /etc/other.env' \
    '. $CONFIG_PATH/bad name.env' '. $CONFIG_PATH/odocker.env' > "$fx/user.env"
  got=$(private.config.chain.names.get "$fx/user.env" | tr '\n' ' ')
  want='oosh log myapp odocker '
  rm -rf "$fx"
  [ "$got" = "$want" ] && create.result 0 "oosh log myapp odocker" || create.result 1 "got [$got] want [$want]"
  return $(result)
}
test.case $level "T-CONFIG-CHAIN-NAMES-GET: the chain names of a user.env, . and source alike, junk ignored" test.config.chainNamesGet
expect 0 "oosh log myapp odocker" "config save must know every chain before it truncates user.env"

# ============================================================================
# T89: config.init.user ensures safe.directory for the caller AND the target
# ============================================================================
# Clone layout (ogit plan, spec § 4): every folder under the base is its own
# repository and needs its own safe.directory entry. config.init.user is what
# `oo update` and `oo user.fix` run, so it is the repair: ogit
# safeDirectory.ensure for the CALLER (function form, after loading ogit), and
# for the TARGET inside the as-user hop (command form through the preamble).
# Structural: driving it end to end needs a second user and the real HOME.
test.config.initUserEnsuresTrust() {
  local body bad=""
  body=$(declare -f config.init.user 2>/dev/null)
  [ -n "$body" ] || { create.result 1 "config.init.user is not defined"; return $(result); }
  printf '%s\n' "$body" | grep -q 'private.this.script.load ogit ogit.branch.get' || bad="$bad no-ogit-loader"
  printf '%s\n' "$body" | grep -qE '(^|[^/])ogit\.safeDirectory\.ensure "\$\(dirname "\$sharedOosh"\)"' || bad="$bad no-caller-ensure"
  printf '%s\n' "$body" | grep -qF "'\$sharedOosh/ogit' safeDirectory.ensure '\$(dirname \"\$sharedOosh\")'" || bad="$bad no-target-hop"
  printf '%s\n' "$body" | grep -q 'safeDirectory.add' && bad="$bad per-folder-add"
  if [ -n "$bad" ]; then
    create.result 1 "config.init.user does not ensure trust:$bad"
  else
    create.result 0 "config.init.user ensures safe.directory for the caller and, in the hop, for the target"
  fi
  return $(result)
}
test.case $level "T89: config.init.user ensures safe.directory under the base for the caller and the target" \
  test.config.initUserEnsuresTrust
expect 0 "config.init.user ensures safe.directory for the caller and, in the hop, for the target" \
  "oo update and oo user.fix run config.init.user — the clone layout needs a trust entry per folder"

# T-CONFIG-LOG-CHAIN-MIGRATE: a host's old log.env chain line is rewritten
# Hosts installed before 2026-10-01 end their shared log.env with
# `. $OOSH_USER_CONFIG_PATH/log.session.env`. Once oosh.env no longer exports the
# variable, that line loads `/log.session.env` and a plain sh stops. config save
# and config.init.user (oo update, oo user.fix) rewrite it, in place.
test.config.logChainMigrate() {
  local fx bad="" f; fx=$(test.suite.fixture.make logchainmigrate); f="$fx/log.env"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $OOSH_USER_CONFIG_PATH/log.session.env' > "$f"
  chmod 664 "$f"
  private.config.log.chain.migrate "$fx" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ "$(cat "$f")" = 'export LOG_LEVEL="1"
. $HOME/.config/oosh/log.session.env' ] || bad="$bad content=[$(tr '\n' '|' < "$f")]"
  [ "$(ls -l "$f" | cut -c1-10)" = "-rw-rw-r--" ] || bad="$bad mode-changed"
  private.config.log.chain.migrate "$fx" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$(grep -c 'log.session.env' "$f")" = 1 ] || bad="$bad not-idempotent"
  rm -f "$f"; private.config.log.chain.migrate "$fx" >/dev/null 2>&1 || bad="$bad missing-file-rc=$?"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the old chain line becomes \$HOME/.config/oosh, in place, once" || create.result 1 "migrate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-LOG-CHAIN-MIGRATE: an old log.env chain line is rewritten to \$HOME/.config/oosh" test.config.logChainMigrate
expect 0 "the old chain line becomes \$HOME/.config/oosh, in place, once" \
  "a host's old log.env would load /log.session.env once oosh.env stops exporting the variable"

### test.method

test.suite.save.results
