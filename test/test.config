    create.result 0 "user.env is pure data after regen"
  else
    create.result 1 "user.env not pure after regen"
  fi
}
test.case - "T38: config.init.env regenerates user.env as pure data" \
  test.config.initEnvRegensUserEnv
expect 0 "user.env is pure data after regen" "config.init.env writes pure-data user.env"

# ============================================================================
# T39: config.init.env backs up user.env to user.env.bak.<ts> before regen
# ============================================================================
test.config.initEnvBacksUpUserEnv() {
  local fixture="/tmp/test.config.bak.$(id -u).$$"
  mkdir -p "$fixture"
  local sentinel="MARKER_$(date +%s%N)"
  echo "$sentinel" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  if ls "$fixture"/user.env.bak.* >/dev/null 2>&1 \
     && grep -q "$sentinel" "$fixture"/user.env.bak.* 2>/dev/null; then
    create.result 0 "user.env backup created with original content"
  else
    create.result 1 "no backup or sentinel missing: $(ls "$fixture")"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T39: config.init.env backs up user.env before regenerating" \
  test.config.initEnvBacksUpUserEnv
expect 0 "user.env backup created with original content" "user.env is preserved as user.env.bak.<ts>"

# ============================================================================
# The shared fixture behind T40/T50/T52/T70: a REAL generated user.env
# ============================================================================
# Every "the bootstrap is DATA" case needs the same thing — a user.env written
# by the live emitter (private.config.anchor.lines.get + the config.add chain),
# in a throwaway directory, never the host's. Generating it is the point: a
# hand-written fixture would go stale the day the emitter changes, and these
# cases exist precisely to catch that.
#
# The anchor lines are $HOME-relative by design, so the generated file's chain
# lines resolve to $HOME/config/*.env when sourced — the same files the host's
# own user.env chains. Only the fixture's HEAD is under test here.
test.config.generatedUserEnv() { # <fx> # config.save into <fx>, echo the path of the generated user.env
  mkdir -p "$1/pu"
  ( export CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" OOSH_USER_CONFIG_PATH="$1/pu" OOSH_MODE=dev
    : > "$CONFIG"; config.save >/dev/null 2>&1 )
  echo "$1/user.env"
}

# ============================================================================
# T40: the bootstrap DATA and the login drop-in are POSIX-sh clean
# ============================================================================
# There is no loader any more: the bootstrap is the head of ~/config/user.env,
# and the only executable half left is the /etc/profile.d drop-in. Both must
# parse under a bare POSIX shell (dash `ossh exec`, `env -i sh`, `env -i sh -l`),
# not just bash — that is what makes "env -i sh … shall boot correctly" true.
test.config.userEnvAndDropinArePosix() {
  local fx target bad=""
  fx=$(test.suite.fixture.make t40) || { create.result 1 "mktemp failed"; return $(result); }
  local generated; generated=$(test.config.generatedUserEnv "$fx")
  for target in "$generated" "$OOSH_DIR/templates/user/profile.d.oosh.sh"; do
    if [ ! -f "$target" ]; then bad="$bad missing:$target"; continue; fi
    if ! sh -n "$target" 2>/dev/null; then
      bad="$bad ${target##*/}-fails-sh-n:$(sh -n "$target" 2>&1 | head -1)"
      continue
    fi
    # ash too (Alpine/busybox is a supported ossh.exec target — see T52, which
    # proves it RUNS; this only proves it PARSES, and runs everywhere busybox is).
    if command -v busybox >/dev/null 2>&1 && ! busybox ash -n "$target" 2>/dev/null; then
      bad="$bad ${target##*/}-fails-ash-n:$(busybox ash -n "$target" 2>&1 | head -1)"
      continue
    fi
    # `-n` alone is blind to `[[`, `local`, `source` … — to dash they are valid
    # COMMAND NAMES and only fail at run time. Grep the common bashisms out
    # explicitly (the same guard T-BOOTPATH-PROFILED-CONTENT-IS-POSIX applies).
    local bashism
    bashism=$(grep -nE '^[^#]*(^|[[:space:];&|(])(\[\[|\(\(|local|source|declare|typeset)([[:space:]]|$)' "$target" | head -1)
    [ -n "$bashism" ] && bad="$bad ${target##*/}-bashism:$bashism"
  done
  rm -rf "$fx" 2>/dev/null
  if [ -z "$bad" ]; then
    create.result 0 "user.env and the drop-in are POSIX sh"
  else
    create.result 1 "not POSIX sh —$bad"
  fi
  return $(result)
}
test.case - "T40: the generated user.env and the profile.d drop-in parse under POSIX sh and ash" \
  test.config.userEnvAndDropinArePosix
expect 0 "user.env and the drop-in are POSIX sh" \
  "no bashisms in either half; env -i sh can source both"

# ============================================================================
# T41: config.validate rejects logic lines (the "NEVER logic in ENV FILES" guard)
# ============================================================================
# config.validate is the enforcement that keeps the pure-data invariant from
# silently regressing. It must ACCEPT export/comment/blank lines and REJECT any
# logic (self-anchor `: ${…}`, `source …`, `if …`).
test.config.fallbackRedirectsMisderivedPath() {
  local fixture="/tmp/test.config.val.$(id -u).$$"; mkdir -p "$fixture"
  local fail=0
  # pure file → accept (rc 0)
  printf '%s\n' '# comment' '' 'export FOO="bar"' 'export BAZ=1' > "$fixture/user.env"
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1 || { fail=1; important.log "validate rejected a pure file"; }
  # planted logic → reject (rc 1)
  printf '%s\n' 'export FOO="bar"' ': ${OOSH_DIR:=$HOME/oosh}' 'source $CONFIG_PATH/oosh.env' > "$fixture/oosh.env"
  if CONFIG_PATH="$fixture" config.validate oosh >/dev/null 2>&1; then
    fail=1; important.log "validate accepted a file containing logic"
  fi
  # D5: an INDENTED self-anchor with a trailing comment must NOT pass as a comment
  printf '%s\n' '  : ${OOSH_DIR:=/x} # guarded' > "$fixture/ind.env"
  if CONFIG_PATH="$fixture" config.validate ind >/dev/null 2>&1; then
    fail=1; important.log "validate accepted an indented self-anchor (comment bypass)"
  fi
  # D5: command substitution in a value EXECUTES on source — must be rejected
  printf '%s\n' 'export FOO="$(echo hi)"' > "$fixture/cmdsub.env"
  if CONFIG_PATH="$fixture" config.validate cmdsub >/dev/null 2>&1; then
    fail=1; important.log "validate accepted command substitution in a value"
  fi
  # and backtick form
  printf '%s\n' 'export BAR=`id`' > "$fixture/bt.env"
  if CONFIG_PATH="$fixture" config.validate bt >/dev/null 2>&1; then
    fail=1; important.log "validate accepted backtick substitution in a value"
  fi
  rm -rf "$fixture" 2>/dev/null
  if [ "$fail" = "0" ]; then
    create.result 0 "validate accepts pure, rejects logic"
  else
    create.result 1 "config.validate misbehaved"
  fi
}
test.case - "T41: config.validate accepts pure data, rejects logic lines" \
  test.config.fallbackRedirectsMisderivedPath
expect 0 "validate accepts pure, rejects logic" \
  "config.validate enforces the NEVER-logic-in-env-files invariant"

# ============================================================================
# T42: config.list reads the per-user tier (~/.config/oosh) by name
# ============================================================================
# `config list log` reads the SHARED ~/config/log.env; `config list log.session`
# must read the PER-USER ~/.config/oosh/log.session.env. Read-only fallback:
# a name present only in the per-user tier resolves there; delete/edit/save
# semantics (which operate on $CONFIG_PATH) are unaffected.
test.config.listReadsPerUserTier() {
  local pu="$HOME/.config/oosh"; mkdir -p "$pu"
  local sess="$pu/log.session.env"
  local backup=""
  [ -f "$sess" ] && backup="$(cat "$sess")"
  printf '%s\n' 'export LOG_NAME="t42@host"' 'export LOG_DEVICE="/dev/pts/9"' > "$sess"
  local out; out="$(config.list log.session 2>/dev/null)"
  # restore original
  if [ -n "$backup" ]; then printf '%s\n' "$backup" > "$sess"; else rm -f "$sess"; fi
  if printf '%s' "$out" | grep -q 'LOG_NAME="t42@host"'; then
    create.result 0 "config list log.session reads per-user tier"
  else
    create.result 1 "config list log.session returned: $out"
  fi
}
test.case - "T42: config.list reads per-user ~/.config/oosh by name" \
  test.config.listReadsPerUserTier
expect 0 "config list log.session reads per-user tier" \
  "config list <name> falls back to the per-user ~/.config/oosh tier"

# ============================================================================
# T43: config.list.completion.name offers names from BOTH tiers
# ============================================================================
test.config.completionOffersPerUser() {
  local pu="$HOME/.config/oosh"; mkdir -p "$pu"
  local sess="$pu/log.session.env"
  local existed=1; [ -f "$sess" ] || { existed=0; : > "$sess"; }
  local out; out="$(config.list.completion.name 2>/dev/null)"
  [ "$existed" = "0" ] && rm -f "$sess"
  if printf '%s\n' "$out" | grep -qx "log.session"; then
    create.result 0 "completion offers log.session"
  else
    create.result 1 "completion names: $(printf '%s' "$out" | tr '\n' ' ')"
  fi
}
test.case - "T43: config list completion offers per-user names" \
  test.config.completionOffersPerUser
expect 0 "completion offers log.session" \
  "config.list.completion.name enumerates the per-user ~/.config/oosh tier"

# ============================================================================
# T44: the bootstrap exports OOSH_USER_CONFIG_PATH (single source of truth)
# ============================================================================
# The per-user (non-shared) oosh config dir is anchored ONCE by the bootstrap
# (this.init and the user.env emitter) as $OOSH_USER_CONFIG_PATH, so
# log/config/oo reference the variable instead of re-spelling ~/.config/oosh.
# Both bootstrap paths must set it, and it must resolve to the live runtime
# value.
test.config.userConfigPathAnchored() {
  local ok=1
  # this.init sets the default
  grep -Eq 'OOSH_USER_CONFIG_PATH:=\$HOME/\.config/oosh' "$OOSH_DIR/this" || ok=0
  # the emitter persists it too, in $HOME-relative data form
  private.config.anchor.lines.get /bin/bash | grep -Fxq 'export OOSH_USER_CONFIG_PATH="$HOME/.config/oosh"' \
    || { create.result 1 "emitter lacks OOSH_USER_CONFIG_PATH"; return $(result); }
  # and it is live in this shell, pointing into the user's HOME
  case "$OOSH_USER_CONFIG_PATH" in "$HOME"/*) ;; *) ok=0 ;; esac
  if [ "$ok" = "1" ]; then
    create.result 0 "OOSH_USER_CONFIG_PATH anchored ($OOSH_USER_CONFIG_PATH)"
  else
    create.result 1 "OOSH_USER_CONFIG_PATH not anchored correctly (live='$OOSH_USER_CONFIG_PATH')"
  fi
}
test.case - "T44: bootstrap exports OOSH_USER_CONFIG_PATH" \
  test.config.userConfigPathAnchored
expect 0 "OOSH_USER_CONFIG_PATH anchored ($OOSH_USER_CONFIG_PATH)" \
  "this.init and the user.env emitter anchor the per-user config dir as a single source of truth"

# ============================================================================
# T45: log owns the per-user session file
# ============================================================================
# No SHARED env file may name a per-user path: dash aborts outright on `.` of a
# missing file. So `log` itself creates log.session.env when absent and sources
# it — before the live-tty cascade, which exists to correct a stale LOG_DEVICE
# loaded from exactly that file.
test.config.logOwnsSessionFile() {
  # T45 — log creates the per-user session file and sources it BEFORE the live-tty
  # cascade (which corrects a stale LOG_DEVICE loaded from it).
  local nTouch nTty
  nTouch=$(grep -nF '[ -f "$OOSH_USER_CONFIG_PATH/log.session.env" ] || : >' "$OOSH_DIR/log" | head -1 | cut -d: -f1)
  nTty=$(grep -nF '_oosh_livetty="$(tty' "$OOSH_DIR/log" | head -1 | cut -d: -f1)
  if [ -n "$nTouch" ] && [ -n "$nTty" ] && [ "$nTouch" -lt "$nTty" ]; then
    create.result 0 "log owns the session file"
  else
    create.result 1 "touch-create at line ${nTouch:-none}, tty cascade at line ${nTty:-none}"
  fi
  return $(result)
}
test.case - "T45: log creates and sources log.session.env before the live-tty cascade" \
  test.config.logOwnsSessionFile
expect 0 "log owns the session file" "dash aborts on . of a missing file, so no shared env file may chain a per-user path"

# ============================================================================
# T46: log.env carries no per-user chain; log itself loads the session file
# ============================================================================
# End-to-end: generate config into a fixture and assert the generated log.env
# names no per-user path at all, then write a per-user session file with a
# custom LOG_NAME and source `log` — the custom LOG_NAME must come through.
test.config.logEnvLoadsSession() {
  local fx="/tmp/test.config.chain.$(id -u).$$"; mkdir -p "$fx/pu"
  # generate a shared config (incl. log.env with the session chain line) into $fx
  bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export CONFIG_PATH="'"$fx"'" CONFIG_FILE=user.env CONFIG="'"$fx"'/user.env"
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
  ' >/dev/null 2>&1
  if grep -q 'log.session.env' "$fx/log.env"; then
    rm -rf "$fx"; create.result 1 "generated log.env still chains the per-user session file"; return $(result)
  fi
  printf 'export LOG_NAME="chained@fixturehost"\n' > "$fx/pu/log.session.env"
  # CONFIG/CONFIG_PATH point at the FIXTURE so `this` (sourced by log) does not
  # cold-start from the real ~/config/user.env and drag the host's session in.
  local got
  got=$(env -i HOME="$HOME" PATH=/usr/bin:/bin OOSH_DIR="$HOME/oosh" CONFIG_PATH="$fx" CONFIG="$fx/user.env" CONFIG_FILE=user.env \
        OOSH_USER_CONFIG_PATH="$fx/pu" LOG_DEVICE=/dev/null bash -c '. "$HOME/oosh/log" >/dev/null 2>&1; echo "$LOG_NAME"')
  rm -rf "$fx"
  if [ "$got" = "chained@fixturehost" ]; then create.result 0 "log loads the session file"; else create.result 1 "LOG_NAME=$got"; fi
  return $(result)
}
test.case - "T46: log.env carries no per-user chain; log itself loads log.session.env" \
  test.config.logEnvLoadsSession
expect 0 "log loads the session file" \
  "the log.env session chain actually loads the per-user LOG_NAME at shell init"

# ============================================================================
# T47: a GENERATED user.env sources cleanly under dash (POSIX `.`, no `source`)
# ============================================================================
# ~/config/user.env must parse under dash/ash (/bin/sh login shells, `ossh exec`
# on Debian). The env files it chains therefore must use POSIX `.`, not the bash
# `source` builtin. Generate a full config and source the resulting user.env
# (which chains oosh.env/log.env, and log.env chains log.session.env) under dash.
test.config.dashSourcesGeneratedUserEnv() {
  # The fixture is a fake $HOME, not a loose directory: user.env now carries the
  # anchors itself (`export CONFIG_PATH="$HOME/config"`), so the sourcing shell
  # supplies HOME and nothing else. That is exactly how a login shell reaches
  # it, and it proves dash expands the $HOME-relative data correctly.
  local fx="/tmp/test.config.dash.$(id -u).$$"; mkdir -p "$fx/config" "$fx/.config/oosh"
  bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export CONFIG_PATH="'"$fx"'/config" CONFIG_FILE=user.env CONFIG="'"$fx"'/config/user.env"
    export OOSH_MODE=dev
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
  ' >/dev/null 2>&1
  : > "$fx/.config/oosh/log.session.env"
  local out
  out=$(dash -c '
    HOME="'"$fx"'"; export HOME
    . "$HOME/config/user.env"
    echo "MODE=[$OOSH_MODE]"
  ' 2>&1)
  rm -rf "$fx"
  if echo "$out" | grep -q "not found"; then
    create.result 1 "dash choked on generated env files (bashism?): $out"
  elif echo "$out" | grep -q 'MODE=\[dev\]'; then
    create.result 0 "dash sourced the generated chain cleanly"
  else
    create.result 1 "unexpected dash output: $out"
  fi
}
# Skip-guard (docs/python.md § Tests that exercise the Python paths): a host
# without dash cannot assert this, and "skipped" is not the expected literal —
# so the guard sits OUTSIDE the case, or the skip is scored as a FAIL (seen on
# alpine and almalinux platform runs, 2026-09-15).
if command -v dash >/dev/null 2>&1; then
test.case - "T47: generated user.env sources cleanly under dash" \
  test.config.dashSourcesGeneratedUserEnv
expect 0 "dash sourced the generated chain cleanly" \
  "generated env files use POSIX . so the user.env chain parses under dash/ash"
else
  expect.pass "T47 skipped: dash not installed on this host (T52 covers busybox ash)"
fi

# ============================================================================
# T48: config.list (per-user tier) does NOT mutate the global $CONFIG
# ============================================================================
# The per-user fallback must resolve read-only via private.config.file.resolve;
# it must never leave $CONFIG repointed at the per-user file for the rest of the
# shell (which would make a later config.add/clean append to / rm the wrong file).
test.config.listNoGlobalMutation() {
  local pu="$HOME/.config/oosh"; mkdir -p "$pu"
  local sess="$pu/log.session.env"
  local existed=1; [ -f "$sess" ] || { existed=0; printf 'export LOG_NAME="t48@h"\n' > "$sess"; }
  local before="$CONFIG"
  config.list log.session >/dev/null 2>&1
  local after="$CONFIG"
  [ "$existed" = "0" ] && rm -f "$sess"
  if [ "$before" = "$after" ]; then
    create.result 0 "\$CONFIG unchanged after config.list log.session"
  else
    create.result 1 "\$CONFIG mutated: before=$before after=$after"
  fi
}
test.case - "T48: config.list per-user view does not mutate \$CONFIG" \
  test.config.listNoGlobalMutation
expect 0 "\$CONFIG unchanged after config.list log.session" \
  "config.list resolves the per-user tier read-only (no global side effect)"

# ============================================================================
# T49: every entry point boots from ~/config/user.env (D3)
# ============================================================================
# user.env carries the bootstrap as data, so every remote/one-liner caller
# sources it first and degrades to a bare PATH prepend when it is missing;
# the two .bashrc writers guard on the new hook (config's by behaviour, T86);
# and no live `oosh/boot`
# reference may be left anywhere in code. Structural check (style of T31/T44).
test.config.userEnvDegradePaths() {
  local f
  for f in ossh user; do
    grep -Eq '\[ -f ~/config/user\.env \] && \. ~/config/user\.env \|\| export PATH=~/oosh' "$OOSH_DIR/$f" \
      || { create.result 1 "$f lacks the user.env degrade one-liner"; return $(result); }
  done
  grep -Eq 'elif \[ -d "\$HOME/oosh" \]' "$OOSH_DIR/templates/user/bashrcTemplate" \
    || { create.result 1 "bashrcTemplate lost its degrade branch"; return $(result); }
  # The .bashrc writer is judged by behaviour in T86 and by count in T87:
  # every site delegates to private.config.bashrc.ensure.
  grep -Fq "private.config.bashrc.ensure" "$OOSH_DIR/config" \
    || { create.result 1 "config.init.user no longer delegates its .bashrc step to private.config.bashrc.ensure (T86)"; return $(result); }
  local hits
  hits=$(git -C "$OOSH_DIR" grep -nE 'oosh/boot|OOSH_DIR/boot|etc/oosh' -- \
           ':!docs' ':!test' ':!old' ':!*.md' ':!claudeCode' ':!hiveMind' ':!restore' ':!boot' 2>/dev/null \
         | grep -vE ':[[:space:]]*#')
  if [ -n "$hits" ]; then create.result 1 "live boot references remain: $hits"; return $(result); fi
  create.result 0 "user.env is the entry point everywhere"
  return $(result)
}
test.case - "T49: every caller sources ~/config/user.env (degrading to a PATH prepend); no live boot reference remains" \
  test.config.userEnvDegradePaths
expect 0 "user.env is the entry point everywhere" \
  "ossh exec, the rootkey pushes, bashrc and the .bashrc writers"

# ============================================================================
# T50: sourcing user.env EXITS 0 — in every shell (T3)
# ============================================================================
# The status is a contract: ossh.exec / ossh.exec.tty and the three `user`
# rootkey pushes all do `[ -f ~/config/user.env ] && . ~/config/user.env ||
# <degrade>` (see T49, which asserts those fallbacks exist). So the LAST line
# of the generated file must never be a conditional list. The loader this
# replaced used to end on
#   [ -n "$BASH_VERSION" ] && type log.session.save … && log.session.save …
# and under sh/dash/ash $BASH_VERSION is always empty, so a perfectly good boot
# returned 1 and every one of those callers took its degrade branch ON SUCCESS.
# Pure data cannot reintroduce that by accident — this is what keeps it true.
test.config.userEnvExitsZeroOnSuccess() {
  local failed="" shell rc fx generated
  fx=$(test.suite.fixture.make t50) || { create.result 1 "mktemp failed"; return $(result); }
  generated=$(test.config.generatedUserEnv "$fx")
  for shell in sh dash bash; do
    command -v "$shell" >/dev/null 2>&1 || continue
    env -i HOME="$HOME" "$shell" -c ". \"$generated\"" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || failed="$failed $shell(rc=$rc)"
  done
  if command -v busybox >/dev/null 2>&1; then
    env -i HOME="$HOME" busybox ash -c ". \"$generated\"" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || failed="$failed busybox-ash(rc=$rc)"
  fi
  rm -rf "$fx" 2>/dev/null
  if [ -z "$failed" ]; then
    create.result 0 "user.env exits 0 in every shell"
  else
    create.result 1 "sourcing user.env returned non-zero in:$failed — a conditional list is the last statement again; ossh.exec and the user rootkey pushes now degrade on success"
  fi
  return $(result)
}
test.case - "T50: sourcing the generated user.env exits 0 (sh/dash/ash/bash)" \
  test.config.userEnvExitsZeroOnSuccess
expect 0 "user.env exits 0 in every shell" \
  "the exit status is a contract — callers branch on it"

# ============================================================================
# T51: the login drop-in FALLS THROUGH when no home can be derived AT ALL
# ============================================================================
# The companion to T65. T65 proves the DATA route anchors from a given $HOME;
# deriving $HOME in the first place is now the /etc/profile.d drop-in's job
# (getent -> dscl -> /etc/passwd). This proves the last resort: when all three
# come up empty there is nothing safe to anchor to, so the drop-in must leave
# the user with a plain login shell — silently, and above all ALIVE. It runs
# for every login on the host, so it may never `exit` (that closes the login
# shell) and may never `return` (not every /etc/profile sources it from a
# function).
#
# All three lookups are defeated by putting `id` out of reach: without a
# username there is nothing to look up. An absolute path to sh is required
# precisely because PATH is emptied.
test.config.dropinFallsThroughWhenHomeUndiscoverable() {
  local shPath out dropin="$OOSH_DIR/templates/user/profile.d.oosh.sh"
  shPath=$(command -v sh 2>/dev/null)
  if [ ! -x "$shPath" ]; then
    create.result 0 "skipped: no sh on PATH"
    return $(result)
  fi
  out=$(cd /tmp && env -i PATH=/nonexistent "$shPath" -c ". \"$dropin\"; echo \"[\$HOME]\"; echo SHELL-ALIVE" 2>&1)
  if ! echo "$out" | grep -Fq '[]'; then
    create.result 1 "the drop-in invented a HOME with nothing to derive it from: $out"
  elif ! echo "$out" | grep -q 'SHELL-ALIVE'; then
    create.result 1 "the drop-in used exit or return — it ended the login shell: $out"
  else
    create.result 0 "drop-in fell through with no derivable home"
  fi
  # A literal expectation below, so fell-through and skipped are not the same answer.
  return $(result)
}
test.case - "T51: the profile.d drop-in falls through (alive) when \$HOME cannot be derived at all" \
  test.config.dropinFallsThroughWhenHomeUndiscoverable
if [ "$RESULT" = "skipped: no sh on PATH" ]; then
  expect.pass "T51 skipped — no sh on PATH"
else
  expect 0 "drop-in fell through with no derivable home" \
    "no getent/dscl//etc/passwd answer — leave a plain login shell, never anchor on /oosh and never kill it"
fi

# ============================================================================
# T52: busybox ash boots from user.env correctly (companion to T47's dash)
# ============================================================================
# Alpine/busybox is a supported shell for `ossh exec`. T40 lints the generated
# user.env under sh and ash; this proves ash actually RUNS it and comes out
# with both anchors and ~/oosh on PATH.
test.config.ashBootsCorrectly() {
  if ! command -v busybox >/dev/null 2>&1; then
    create.result 0 "skipped: busybox absent"; return $(result)
  fi
  local out fx generated
  fx=$(test.suite.fixture.make t52) || { create.result 1 "mktemp failed"; return $(result); }
  generated=$(test.config.generatedUserEnv "$fx")
  out=$(env -i HOME="$HOME" busybox ash -c "
    . \"$generated\"
    echo \"D=[\$OOSH_DIR] C=[\$CONFIG_PATH]\"
    case \":\$PATH:\" in *\":\$HOME/oosh:\"*) echo PATHOK ;; *) echo PATHBAD ;; esac
  " 2>&1)
  rm -rf "$fx" 2>/dev/null
  if ! echo "$out" | grep -Fq "D=[$HOME/oosh]"; then
    create.result 1 "ash: wrong OOSH_DIR: $out"
  elif ! echo "$out" | grep -Fq "C=[$HOME/config]"; then
    create.result 1 "ash: wrong CONFIG_PATH: $out"
  elif ! echo "$out" | grep -q PATHOK; then
    create.result 1 "ash: ~/oosh not on PATH: $out"
  else
    create.result 0 "ash boots correctly"
  fi
  return $(result)
}
test.case - "T52: busybox ash sources the generated user.env and gets both anchors + PATH" \
  test.config.ashBootsCorrectly
if [ "$RESULT" = "skipped: busybox absent" ]; then
  expect.pass "T52 skipped — busybox not installed on this host"
else
  expect 0 "ash boots correctly" \
    "the data route works under ash (Alpine/busybox), not just dash and bash"
fi

# ============================================================================
# T65: ~/config/user.env anchors a bare `env -i` shell, in every shell
# ============================================================================
# `env -i` drops everything and every anchor hangs off $HOME. The card (T3) is
# "env -i sh … shall boot correctly": with $HOME passed, the DATA alone must
# stand the whole environment up, in sh, dash, ash, bash and busybox ash, and
# the sourcing shell must survive it.
#
# Deriving $HOME when even that is gone is NOT this file's job any more — it
# belongs to the /etc/profile.d drop-in (T51 above for the give-up path,
# test.platform.profile.dropin.invariant for the deployed article).
test.config.userEnvAnchorsEveryShell() {
  local bad
  bad=$(test.suite.anchors.check '. "$HOME/config/user.env"')
  if [ -z "$bad" ]; then
    create.result 0 "anchored in every shell"
  else
    create.result 1 "expected [\$HOME|\$HOME/oosh|\$HOME/config] —$bad"
  fi
  return $(result)
}
test.case - "T65: ~/config/user.env anchors every shell under env -i" \
  test.config.userEnvAnchorsEveryShell
expect 0 "anchored in every shell" \
  "the T3 card: env -i sh must boot correctly from the data alone"

# ============================================================================
# T69: test.tilde runs from a CLEAN ENVIRONMENT
# ============================================================================
# 815d14d gave test/test.tilde `#!/usr/bin/env -iS HOME=${HOME} bash` — the
# sibling commit to 8c277f4, which did the same for init/oosh. 075b4a3 removed
# that shebang from BOTH (BusyBox `env` has no -S) and nothing replaced the
# guarantee. init/oosh got it back as an in-file re-exec (the OOSH_CLEAN_ENV block);
# test.tilde did not, and has since inherited whatever the caller happened to
# have.
#
# It passes either way — which is exactly the problem. A test whose entire
# subject is `~` versus $HOME, run with an arbitrary inherited environment, is
# green for a reason unrelated to what it asserts. Same shape as a mode check
# that never looked at the mode.
#
# Pinned here, all observable from OUTSIDE the file:
#   1. a variable planted by the caller does NOT survive into it;
#   2. the re-exec really happened;
#   3. the sentinel is HONOURED — preset, the file must NOT re-exec. That is
#      what makes an exec loop impossible, and it is asserted rather than
#      assumed. Every invocation is wrapped in `timeout` where available, so a
#      regression that DOES loop fails this test instead of hanging the suite.
#   4. it still does its actual job, and still exits 0.
test.config.tildeRunsInCleanEnvironment() {
  local tilde="$OOSH_DIR/test/test.tilde" out cleanOut rc bad="" to="" tmp
  # The child now sources this + test.suite and saves ITS results to
  # $CONFIG_PATH/testresult.env — give it a throwaway one, never the parent's.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t69.XXXXXX") || { create.result 1 "mktemp failed"; return $(result); }
  command -v timeout >/dev/null 2>&1 && to="timeout 20"
  if [ ! -x "$tilde" ]; then
    rm -rf "$tmp"
    create.result 1 "$tilde is not executable — test.suite runs it as a bare \$file (kernel exec)"
    return $(result)
  fi
  bash -n "$tilde" 2>/dev/null || bad="$bad lint:$(bash -n "$tilde" 2>&1 | head -1)"

  # 1 + 2 — plant a canary; it must not survive, and the sentinel must be set.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CANARY=leaked OOSH_TILDE_CLEAN_ENV= $to "$tilde" 1 2>&1); rc=$?
  cleanOut="$out"
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc"
  case "$out" in
    *"Environment                                : clean, canary absent"*) : ;;
    *INHERITED*) bad="$bad canary-survived (test.tilde did not re-exec with env -i — the 075b4a3 regression)" ;;
    *) bad="$bad no-environment-line:$(echo "$out" | head -1)" ;;
  esac

  # 3 — sentinel honoured: preset, it must NOT re-exec (so the canary DOES
  #     survive) and must still terminate.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CLEAN_ENV=1 OOSH_TILDE_CANARY=leaked $to "$tilde" 1 2>&1); rc=$?
  if [ "$rc" -eq 124 ]; then
    bad="$bad sentinel-LOOPED (timed out — the re-exec guard does not stop)"
  else
    [ "$rc" -eq 0 ] || bad="$bad sentinel-rc=$rc"
    case "$out" in
      *INHERITED*) : ;;
      *"clean, canary absent"*) bad="$bad sentinel-ignored (it re-execs even when already clean; nothing but luck prevents a loop)" ;;
      *) bad="$bad sentinel-check-inconclusive (no Environment line at all)" ;;
    esac
  fi

  # 4 — it must still be the test it was: on the CLEAN run, its own assertions
  #     ran through the framework and none failed.
  case "$cleanOut" in
    *"T-TILDE-HOME"*"T-TILDE-FILE-TEST"*) : ;;
    *) bad="$bad tilde-assertions-missing:$(echo "$cleanOut" | tr '\n' ' ' | cut -c1-120)" ;;
  esac
  case "$cleanOut" in
    *"✗ FAIL"*) bad="$bad tilde-assertion-failed:$(echo "$cleanOut" | grep -F "✗ FAIL" | head -1 | cut -c1-100)" ;;
  esac
  rm -rf "$tmp"

  if [ -z "$bad" ]; then
    create.result 0 "test.tilde runs clean and cannot loop"
  else
    create.result 1 "test.tilde clean-environment guarantee broken —$bad"
  fi
  return $(result)
}
test.case - "T69: test/test.tilde runs from a clean environment and cannot loop" \
  test.config.tildeRunsInCleanEnvironment
expect 0 "test.tilde runs clean and cannot loop" \
  "a tilde test that inherits the caller's environment is green for the wrong reason"

# ============================================================================
# T70: POSIX-MODE bash must survive sourcing user.env (the macOS /bin/sh case)
# ============================================================================
# The loader this replaced had a section-4 guard that asked only "is this
# bash?" ([ -n "$BASH_VERSION" ]) before sourcing $OOSH_DIR/log. That question
# is not the one that matters.
#
# On macOS /bin/sh IS bash 3.2 — $BASH_VERSION is SET — but it runs in POSIX
# mode, where a dotted function name is not a valid identifier. `log` is built
# from dotted names (log.device, log.level, …), so the old guard sourced a file
# that cannot parse, and a PARSE ERROR IN A SOURCED FILE UNDER POSIX MODE KILLS
# THE SHELL. Measured on a macOS 15.7.3 arm64 VM:
#
#   env -i /bin/sh   -c '. <bootstrap>; echo REACHED'
#     -> /Users/admin/oosh/log: line 73: `log.device': not a valid identifier
#     -> rc 2, REACHED never printed — the shell was dead.
#   env -i /bin/bash -c '. <bootstrap>; …'   -> rc 0, all anchors set.
#
# Same binary, same file; only POSIX mode differs. The guard is gone along with
# the loader — user.env is DATA, it sources no shell code at all — and that is
# precisely why this case must stay: the day something puts a `source $OOSH_DIR/log`
# back into the generated chain, macOS /bin/sh dies again and only this notices.
#
# `bash --posix` REPRODUCES IT ON LINUX, which is what this test uses — no Mac
# needed.
#
# Assertion 5 is the other half of the trade — SKIP log, not NEVER log: sourcing
# user.env must NOT define the log functions (it is data, nothing more), while a
# plain bash that asks for them explicitly (`. $OOSH_DIR/log`) must still get
# them. A change that made `log` unloadable everywhere cannot pass this.
test.config.userEnvSurvivesPosixModeBash() {
  local bad="" out bashPath probe fx generated
  bashPath=$(command -v bash 2>/dev/null)
  if [ ! -x "$bashPath" ]; then
    create.result 0 "skipped (no bash on PATH)"
    return $(result)
  fi
  fx=$(test.suite.fixture.make t70) || { create.result 1 "mktemp failed"; return $(result); }
  generated=$(test.config.generatedUserEnv "$fx")
  # `type log.device` is how "did log get sourced" is asked without assuming it
  # did; ALIVE is the liveness marker — under POSIX mode a parse error in the
  # sourced file ends the shell, so it simply never prints.
  probe='. "'"$generated"'"; echo "RC=$?"; echo "<[$HOME|$OOSH_DIR|$CONFIG_PATH|$OOSH_USER_CONFIG_PATH]>"; if type log.device >/dev/null 2>&1; then echo LOGFN=yes; else echo LOGFN=no; fi; echo ALIVE'

  # --- 1..4: bash --posix, i.e. macOS /bin/sh -----------------------------
  out=$(cd /tmp && env -i HOME="$HOME" "$bashPath" --posix -c "$probe" 2>&1)
  case "$out" in
    *ALIVE*) : ;;
    *) bad="$bad posix-shell-died:$(echo "$out" | tr '\n' ' ' | cut -c1-140)" ;;
  esac
  case "$out" in
    *"not a valid identifier"*) bad="$bad posix-sourced-log-anyway (dotted names rejected)" ;;
  esac
  case "$out" in
    *RC=0*) : ;;
    *) bad="$bad posix-user-env-rc-not-0:$(echo "$out" | grep -o 'RC=[0-9]*' | tail -1)" ;;
  esac
  case "$out" in
    *"<[$HOME|$HOME/oosh|$HOME/config|$HOME/.config/oosh]>"*) : ;;
    *) bad="$bad posix-anchors:$(echo "$out" | grep -o '<\[[^]]*\]>' | tail -1)" ;;
  esac
  # the data route defines no functions — under POSIX mode least of all
  case "$out" in
    *LOGFN=no*) : ;;
    *) bad="$bad posix-user-env-defined-log-functions:$(echo "$out" | grep -o 'LOGFN=[a-z]*' | tail -1)" ;;
  esac

  # `set -o posix` turned on at RUNTIME is the same shell state by another door
  # (a user's rc, or a caller that set it); it must be just as survivable.
  out=$(cd /tmp && env -i HOME="$HOME" "$bashPath" -c "set -o posix; $probe" 2>&1)
  case "$out" in
    *ALIVE*) : ;;
    *) bad="$bad set-o-posix-shell-died:$(echo "$out" | tr '\n' ' ' | cut -c1-140)" ;;
  esac

  # --- 5: the trade is SKIP LOG, not NEVER LOG ----------------------------
  # A plain bash that sources `log` itself must still come out WITH the
  # functions, or `log` has been broken rather than left out of the data.
  out=$(cd /tmp && env -i HOME="$HOME" "$bashPath" -c ". \"$generated\"; . \"\$OOSH_DIR/log\"; if type log.device >/dev/null 2>&1; then echo LOGFN=yes; else echo LOGFN=no; fi; echo ALIVE" 2>&1)
  case "$out" in
    *LOGFN=yes*) : ;;
    *) bad="$bad plain-bash-lost-log:$(echo "$out" | grep -o 'LOGFN=[a-z]*' | tail -1)" ;;
  esac
  case "$out" in
    *ALIVE*) : ;;
    *) bad="$bad plain-bash-died:$(echo "$out" | tr '\n' ' ' | cut -c1-140)" ;;
  esac
  rm -rf "$fx" 2>/dev/null

  if [ -z "$bad" ]; then
    create.result 0 "POSIX-mode bash survives user.env"
  else
    create.result 1 "POSIX-mode bash broken —$bad"
  fi
  return $(result)
}
test.case - "T70: POSIX-mode bash (macOS /bin/sh) sources the generated user.env and stays alive" \
  test.config.userEnvSurvivesPosixModeBash
expect 0 "POSIX-mode bash survives user.env" \
  "\$BASH_VERSION answers the wrong question — /bin/sh on macOS is bash in POSIX mode"

# ============================================================================
# Save results
# ============================================================================
# ============================================================================
# T71: a generated config does not carry OOSH_BRANCH into the next shell
# ============================================================================
# The drift loop, end to end. oosh.env seeds a shell with OOSH_BRANCH; that
# shell reaches a config save; the save writes OOSH_BRANCH straight back. On
# this host it has been saying "prod" against a dev checkout for weeks, which
# makes private.oo.install.branch.get — "the one rule behind state 31, state 34
# and oo boot.fix" — answer prod on a dev box.
#
# OOSH_BRANCH is the install INPUT: the branch the operator asked for. It is
# meaningful for the length of one install and meaningless afterwards, so it
# must not survive into a shell. The branch a box is ON is derived from the
# checkout, never remembered.
test.config.branchIsInputNotState() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t71.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out
  # Generate a config from a shell that carries the install input, then source
  # the generated chain in a CLEAN child and ask what it inherited.
  out=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
            OOSH_USER_CONFIG_PATH="$fixture/pu" OOSH_BRANCH=prod OOSH_MODE=dev \
        bash -c '
          source "$OOSH_DIR/this" >/dev/null 2>&1
          source "$OOSH_DIR/config" >/dev/null 2>&1
          : > "$CONFIG"; config.save >/dev/null 2>&1
          grep -h OOSH_BRANCH "$CONFIG_PATH"/*.env 2>/dev/null | tr -d " \t"
        ')
  rm -rf "$fixture" 2>/dev/null

  if [ -n "$out" ]; then
    create.result 1 "the install input was persisted into the config: [$out]"
  else
    create.result 0 "OOSH_BRANCH is install input and never reaches the config"
  fi
  return $(result)
}
test.case - "T71: config.save does not persist the install input OOSH_BRANCH" \
  test.config.branchIsInputNotState
expect 0 "OOSH_BRANCH is install input and never reaches the config" \
  "persisting it closes a loop that never consults the checkout — the T7 drift"

# ============================================================================
# T72: config.init honours the anchor it was given, and defaults when given none
# ============================================================================
# config.init did an UNCONDITIONAL `export CONFIG_PATH=~/config`, and
# config.start re-runs it whenever $CONFIG is not a file — so any fixture was
# undone from inside the file under test. That is why test.config and
# test.completion.audit had to declare TEST_SHARED_TIER_WRITER instead of
# isolating: they source `config`, and sourcing it moved the anchor back.
#
# The conditional form is not a bend of the anchor rule, it is the rule:
# private.this.anchor.validate.one classifies `: ${CONFIG_PATH:=~/config}` as
# CONFORMING, and `this`, `log` and `ossh` already use exactly that shape for
# this exact variable.
test.config.initHonoursGivenAnchor() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t72.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local given defaulted
  # (a) given an anchor, keep it
  given=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
          bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                   source "$OOSH_DIR/config" >/dev/null 2>&1
                   config.init >/dev/null 2>&1
                   printf "%s|%s" "$CONFIG_PATH" "$CONFIG"')
  # (b) given none, produce the constant
  defaulted=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                       source "$OOSH_DIR/config" >/dev/null 2>&1
                       config.init >/dev/null 2>&1
                       printf "%s" "$CONFIG_PATH"')
  rm -rf "$fixture" 2>/dev/null

  if [ "${given%%|*}" != "$fixture" ]; then
    create.result 1 "config.init clobbered the anchor it was given: [${given%%|*}] wanted [$fixture]"
  elif [ "${given#*|}" != "$fixture/user.env" ]; then
    create.result 1 "\$CONFIG did not follow the given anchor: [${given#*|}]"
  elif [ "$defaulted" != "$HOME/config" ]; then
    create.result 1 "with no anchor given, config.init did not produce \$HOME/config: [$defaulted]"
  else
    create.result 0 "config.init honours a given anchor and defaults to the constant"
  fi
  return $(result)
}
test.case - "T72: config.init keeps an inherited CONFIG_PATH and still defaults to ~/config" \
  test.config.initHonoursGivenAnchor
expect 0 "config.init honours a given anchor and defaults to the constant" \
  "config.start re-runs config.init, so an unconditional export undoes a fixture from inside"

# ============================================================================
# T73: config validate required — names what is missing, and reports drift
# ============================================================================
# The card asks for two things this tree had neither of: a declared set of
# variables a config must carry for a branch version, and something that
# notices when the persisted branch disagrees with the checkout.
#
# config.init only ever created a directory and three variables, so on a
# missing config it succeeded emptily. config.validate checks line SHAPE and
# knows no variable name at all. config.init.check never opens an env file.
test.config.requiredFixture() { # <dir> <oosh-branch> <?omit> # a config tier plus a ~/oosh symlink on <oosh-branch>
  local dir="$1" branch="$2" omit="$3"
  mkdir -p "$dir/home" "$dir/base/$branch"
  ln -sfn "$dir/base/$branch" "$dir/home/oosh"
  # A COMPLETE user.env now means the boot data too — `config validate required`
  # checks every anchor line the emitter writes, so the fixture is built with
  # the emitter rather than with a hand-rolled two-line file.
  private.config.anchor.lines.get /usr/bin/bash > "$dir/user.env"
  printf 'export LOG_LEVEL="1"\n' > "$dir/log.env"
  [ "$omit" = "omit" ] && return 0
  printf 'export OOSH_MODE="%s"\nexport OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' \
    "${4:-$branch}" > "$dir/oosh.env"
}

test.config.requiredRun() { # <dir> # run `config validate required` against <dir> in a pinned child; echo "rc|verdict"
  local out rc
  out=$(env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
        bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                 source "$OOSH_DIR/config" >/dev/null 2>&1
                 config.validate.required 2>/dev/null'); rc=$?
  printf '%s|%s' "$rc" "$(printf '%s' "$out" | tr '\n' ' ')"
}

test.config.validateRequired() {
  local base; base=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t73.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }

  test.config.requiredFixture "$base/ok" dev
  local ok; ok=$(test.config.requiredRun "$base/ok")

  test.config.requiredFixture "$base/gone" dev omit          # no oosh.env at all
  local gone; gone=$(test.config.requiredRun "$base/gone")

  test.config.requiredFixture "$base/drift" dev "" prod      # persisted prod, checkout dev
  local drift; drift=$(test.config.requiredRun "$base/drift")

  # The anchor check needs a fixture that can FAIL it. The three above are all
  # built FROM the emitter and compared AGAINST the emitter — X == X, a branch
  # no test can reach (docs/plans/2026-09-14-tests-that-cannot-fail.md). So:
  # a complete config with exactly ONE anchor line deleted.
  test.config.requiredFixture "$base/noanchor" dev
  grep -v 'OOSH_USER_CONFIG_PATH' "$base/noanchor/user.env" > "$base/noanchor/user.env.new"
  mv "$base/noanchor/user.env.new" "$base/noanchor/user.env"
  local noanchor; noanchor=$(test.config.requiredRun "$base/noanchor")
  rm -rf "$base" 2>/dev/null

  if [ "${ok%%|*}" != "0" ]; then
    create.result 1 "a complete config was rejected: [$ok]"
  elif [ "${gone%%|*}" = "0" ]; then
    create.result 1 "a config with no oosh.env was accepted — succeeding emptily is the bug"
  elif [ "${gone#*OOSH_MODE}" = "$gone" ] || [ "${gone#*OOSH_PM}" = "$gone" ]; then
    create.result 1 "the missing variables were not all named: [$gone]"
  elif [ "${drift%%|*}" = "0" ]; then
    create.result 1 "persisted prod against a dev checkout was accepted: [$drift]"
  elif [ "${drift#*prod}" = "$drift" ] || [ "${drift#*dev}" = "$drift" ]; then
    create.result 1 "the drift report names neither side: [$drift]"
  elif [ "${noanchor%%|*}" = "0" ]; then
    create.result 1 "a user.env with an anchor line deleted was accepted: [$noanchor]"
  elif [ "${noanchor#*anchor:}" = "$noanchor" ]; then
    create.result 1 "the missing anchor line was not named: [$noanchor]"
  else
    create.result 0 "missing variables, missing anchors and branch drift are all reported"
  fi
  return $(result)
}
test.case - "T73: config validate required names every missing variable and anchor, and reports branch drift" \
  test.config.validateRequired
expect 0 "missing variables, missing anchors and branch drift are all reported" \
  "config.init succeeded emptily on a missing config, and nothing compared the persisted branch to the checkout"

# ============================================================================
# T75: config.save survives a bash-3.2 `declare -p` stream
# ============================================================================
# THE BUG THIS PINS (docs/research/2026-09-17-config-save-bash32.md):
# on macOS /bin/bash 3.2.57, `declare -p` with NO NAMES is `set`-style — no
# `declare -x` prefix — and it ALSO prints every function body, verbatim and
# multi-line, into the same stream config.save filters. The filter derived a
# "variable name" with three string-strips and never checked it was one, so a
# function-body line with no `=` survived `${_vn%%=*}` whole and glob-matched
# `OOSH_*`. Rows of private.config.required.variables.get's heredoc became
# lines in ~/config/oosh.env, and every login printed
# "OOSH_MODE: command not found".
#
# Linux runs bash 5, where `declare -p` prints no functions — so this cannot
# be reproduced here, it has to be INJECTED. A shell function shadows a
# builtin, so the stub below reproduces 3.2's BROKEN no-argument output while
# delegating the CORRECT named form (`declare -p NAME`, measured right on 3.2)
# to the real builtin. Same move as T28's fixture, but wired to the real code
# path instead of to a grep.
test.config.bash32Save() { # <fixture> # run config.save under a simulated bash-3.2 `declare -p`; echo the file it generated
  (
    declare() {
      if [ "$1" = "-p" ] && [ $# -eq 1 ]; then
        # The four lines that really landed on the VM.
        printf '%s\n' "OOSH_PM='brew install'" \
                      "OOSH_PROMPT='oosh '" \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      'OOSH_OS oosh.env $OSTYPE, via os'
        return 0
      fi
      builtin declare "$@"
    }
    export OOSH_PM="brew install" OOSH_PROMPT="oosh "
    CONFIG_PATH="$1" CONFIG_FILE="bash32.env" CONFIG="$1/bash32.env" \
      config.save bash32 OOSH >/dev/null 2>&1
    cat "$1/bash32.env" 2>/dev/null
  )
}
test.config.saveSurvivesBash32Stream() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.bash32.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }
  local generated; generated=$(test.config.bash32Save "$fixture")
  rm -rf "$fixture" 2>/dev/null

  local junk unexported total
  # A junk row is NAME followed by a FILENAME — never an assignment. Anchoring
  # on "a word then a space" alone was wrong: `export OOSH_MODE="released"` is
  # also a word then a space, so the first version of this check failed on the
  # CORRECT output. Watched failing both ways, which is the point.
  junk=$(printf '%s\n' "$generated" | grep -c -E '^(export )?[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[a-z]+\.env[[:space:]]' 2>/dev/null)
  total=$(printf '%s\n' "$generated" | grep -c -E '[^[:space:]]' 2>/dev/null)
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if [ "${total:-0}" = "0" ]; then
    create.result 1 "config.save wrote nothing at all"
  elif [ "${junk:-0}" != "0" ]; then
    create.result 1 "$junk function-body row(s) were written as if they were variables: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported line(s) carry no 'export' — the sed cannot match bash 3.2 output: [$generated]"
  elif ! printf '%s\n' "$generated" | grep -q 'OOSH_PM='; then
    create.result 1 "OOSH_PM did not survive the save: [$generated]"
  else
    create.result 0 "every generated line is an export assignment"
  fi
  return $(result)
}
test.case - "T75: config.save survives a bash-3.2 declare -p stream" \
  test.config.saveSurvivesBash32Stream
expect 0 "every generated line is an export assignment" \
  "bash 3.2 declare -p is set-style AND dumps function bodies — rows of the required-variables table became lines in oosh.env"

# ============================================================================
# T76: private.config.variables.list emits variable NAMES, never anything else
# ============================================================================
# The unit-level pin for the shape gate. compgen -v can only produce valid
# identifiers, so the gate is belt-and-braces in production — this drives it
# directly, with compgen stubbed, which is the only way to see it work.
test.config.variablesListShapeGate() {
  local listed
  listed=$(
    compgen() {
      if [ "$1" = "-v" ]; then
        printf '%s\n' 'OOSH_TEST_MODE' \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      '9BAD' 'OOSH-DASH'
        return 0
      fi
      builtin compgen "$@"
    }
    private.config.variables.list OOSH 2>/dev/null
  )
  if [ "$listed" = "OOSH_TEST_MODE" ]; then
    create.result 0 "only a valid variable name survives the gate"
  else
    create.result 1 "expected just OOSH_TEST_MODE, got: [$listed]"
  fi
  return $(result)
}
test.case - "T76: private.config.variables.list returns names, not whatever starts with the prefix" \
  test.config.variablesListShapeGate
expect 0 "only a valid variable name survives the gate" \
  "the old filter took three string-strips as a variable name and never checked it was one"

# ============================================================================
# T77: private.config.variable.export.line — fidelity, and the dash promise
# ============================================================================
# The value must survive a round trip through EVERY shell that sources the
# generated file. ~/config/user.env is sourced by /bin/sh on Debian login shells,
# so bash alone is not enough (review-2026-09-09 § D1).
test.config.exportLineRoundTrip() {
  export OOSH_T77='a    b $HOME `x` "q" back\slash'
  local line; line=$(private.config.variable.export.line OOSH_T77 2>/dev/null)
  case "$line" in
    export\ OOSH_T77=*) ;;
    *) create.result 1 "not an export line: [$line]"; return $(result) ;;
  esac

  # Every available POSIX shell must reproduce the value byte for byte.
  local shellBin bin got broken=""
  for shellBin in sh dash ash bash busybox; do
    bin=$(command -v "$shellBin" 2>/dev/null) || continue
    [ -n "$bin" ] || continue
    if [ "$shellBin" = "busybox" ]; then bin="$bin sh"; fi
    got=$($bin -c "$line"'; printf %s "$OOSH_T77"' 2>/dev/null)
    [ "$got" = "$OOSH_T77" ] || broken="$broken $shellBin"
  done
  if [ -n "$broken" ]; then
    create.result 1 "the value did not survive:$broken — line was [$line]"
    return $(result)
  fi

  # A value carrying a NEWLINE cannot go into a line-oriented file, whatever
  # quoting bash picks for it — config.validate reads these one line at a time.
  #
  # THIS ASSERTION EARNED ITS KEEP on 2026-09-18: it went red on almalinux 9
  # during `oo stage testing` while passing on the host, ubuntu 24.04 and
  # macOS. The guard in config tested bash's RENDERING (`$'…'`) rather than the
  # value, and `$'…'` is a bash >= 5.2 behaviour — bash 5.1 emits a
  # double-quoted string with a literal newline in it, measured identically on
  # almalinux 9 (5.1.8), ubuntu 22.04 (5.1.16) and debian 11 (5.1.4). So the
  # guard caught nothing on any bash 5.1 and a two-line assignment was written
  # into oosh.env. Keep BOTH shapes below: they differ only in which bash
  # renders them which way, which is exactly the axis that hid the defect.
  export OOSH_T77_MULTI="line1
line2"
  export OOSH_T77_CR="a$(printf '\r')b"
  local multi multiRc cr crRc
  multi=$(private.config.variable.export.line OOSH_T77_MULTI 2>/dev/null); multiRc=$?
  cr=$(private.config.variable.export.line OOSH_T77_CR 2>/dev/null); crRc=$?
  # An array has no single-line export form.
  OOSH_T77_ARR=(a b)
  local arr arrRc
  arr=$(private.config.variable.export.line OOSH_T77_ARR 2>/dev/null); arrRc=$?
  # An unset name is not an error to report, just nothing to write.
  local gone goneRc
  gone=$(private.config.variable.export.line OOSH_T77_NEVER_SET 2>/dev/null); goneRc=$?
  unset OOSH_T77 OOSH_T77_MULTI OOSH_T77_CR OOSH_T77_ARR

  if [ "$multiRc" = "0" ] || [ -n "$multi" ]; then
    create.result 1 "a newline-bearing value was written as [$multi] — a line-oriented file cannot hold it, whatever quoting bash picked"
  elif [ "$crRc" = "0" ] || [ -n "$cr" ]; then
    create.result 1 "a carriage-return value was written as [$cr]"
  elif [ "$arrRc" = "0" ] || [ -n "$arr" ]; then
    create.result 1 "an array was written as [$arr]"
  elif [ "$goneRc" = "0" ] || [ -n "$gone" ]; then
    create.result 1 "an unset name produced [$gone]"
  else
    create.result 0 "the value round-trips through every shell, and the unwritable cases are refused"
  fi
  return $(result)
}
test.case - "T77: private.config.variable.export.line round-trips through every POSIX shell" \
  test.config.exportLineRoundTrip
expect 0 "the value round-trips through every shell, and the unwritable cases are refused" \
  "/bin/sh sources these files through user.env — a bash-only rendering breaks Debian login shells"

# ============================================================================
# T78: a trailing "_" in the prefix does not silence the sweep
# ============================================================================
# `backup config.save global` passes BACKUP_ (backup:262). The old gate was
# `${name}|${name}_*` — with the underscore already there that reads
# `BACKUP_|BACKUP__*`, which BACKUP_TARGET matches neither, so backup.env has
# been written empty all along.
test.config.variablesListTrailingUnderscore() {
  export BACKUP_TARGET="/some/where"
  local listed; listed=$(private.config.variables.list BACKUP_ 2>/dev/null)
  unset BACKUP_TARGET
  if printf '%s\n' "$listed" | grep -qx 'BACKUP_TARGET'; then
    create.result 0 "a trailing underscore in the prefix is tolerated"
  else
    create.result 1 "BACKUP_ found nothing; BACKUP_TARGET was set. got: [$listed]"
  fi
  return $(result)
}
test.case - "T78: config.save prefix tolerates a trailing underscore" \
  test.config.variablesListTrailingUnderscore
expect 0 "a trailing underscore in the prefix is tolerated" \
  "backup passes BACKUP_ and has been writing an empty backup.env ever since"

# The four placeholder cases `oo method.new` generated for
# private.config.variables.list / .variable.export.line / .variables.export /
# .string.upper were removed here, deliberately: all four are GETTERS consumed
# as $(...), so none calls create.result, and the template's
# `expect 0 "<result>"` would have compared whatever $RESULT the PREVIOUS test
# left behind — a test that cannot fail, which is the exact defect the
# "Tests that cannot fail" card is about. Their real coverage is T75-T78 above.
#
# templates/code/newMethodTest assumes a create.result method. A getter needs a
# different shape (assert on stdout, not on $RESULT). Recorded as a card —
# there is no newGetterTest template and this is not the last getter the tree
# will grow.

# ============================================================================
# T79: every generated line is an export assignment, and a one-argument
#      `config save <file>` derives its prefix without ${var^^}
# ============================================================================
# A REGRESSION GUARD, not a red-first test, and labelled so: on bash 5 the old
# code already produced export lines, and `${file^^}` already worked. Both
# halves fail only on macOS /bin/bash 3.2 — the first silently (no `export` on
# any line), the second fatally (a "bad substitution" that EXITS the shell).
# This pins the shapes so the fix cannot quietly come undone.
test.config.saveShapeAndPrefix() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.shape.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }

  # The upper-caser itself.
  local upper; upper=$(private.config.string.upper "myApp")
  if [ "$upper" != "MYAPP" ]; then
    rm -rf "$fixture" 2>/dev/null
    create.result 1 "private.config.string.upper myApp gave [$upper]"
    return $(result)
  fi

  # One argument: `config save myapp` must derive MYAPP and harvest MYAPP_*.
  export MYAPP_TOKEN="a value with spaces"
  (
    CONFIG_PATH="$fixture" CONFIG_FILE="myapp.env" CONFIG="$fixture/myapp.env" \
      config.save myapp >/dev/null 2>&1
  )
  local generated; generated=$(cat "$fixture/myapp.env" 2>/dev/null)
  unset MYAPP_TOKEN
  rm -rf "$fixture" 2>/dev/null

  local unexported
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if ! printf '%s\n' "$generated" | grep -q '^export MYAPP_TOKEN='; then
    create.result 1 "the one-argument form derived no prefix: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported generated line(s) are not export assignments: [$generated]"
  else
    create.result 0 "the prefix is derived and every line is an export assignment"
  fi
  return $(result)
}
test.case - "T79: config save <file> derives its prefix, and writes only export lines" \
  test.config.saveShapeAndPrefix
expect 0 "the prefix is derived and every line is an export assignment" \
  "on bash 3.2 the derivation was a fatal bad substitution and no line ever carried export"

# ============================================================================
# T80: every required-variable row has a deriver, and each one answers
# ============================================================================
# F6. private.config.required.variables.get declares "<variable> <file> <how it
# is re-derived>" and NOTHING read the third column — documentation of a repair
# that did not exist. That is why config.init.env could not repair, and why the
# macOS VM oscillated: OOSH_MODE present and OOSH_OS gone one hour, the reverse
# the next, depending only on which shell last wrote the file.
# See docs/research/2026-09-17-config-save-bash32.md §§ 6-8.
test.config.deriversAnswer() {
  local fixture; fixture=$(test.suite.fixture.make test.config.derive) \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/home" "$fixture/base/dev"
  ln -sfn "$fixture/base/dev" "$fixture/home/oosh"

  local mode os level cfgFile bashFile
  mode=$(HOME="$fixture/home" private.config.derive.oosh.mode 2>/dev/null)
  os=$(private.config.derive.oosh.os 2>/dev/null)
  # LOG_LEVEL is set to 1 by the suite itself, and the deriver correctly lets an
  # already-chosen level win. Unset it to exercise the FALLBACK, which is the
  # half the table got wrong: it said "defaults to 1" and both this:16 and
  # log:125 use 3.
  level=$( unset LOG_LEVEL; private.config.derive.log.level 2>/dev/null )
  cfgFile=$(private.config.derive.config.file 2>/dev/null)
  bashFile=$(private.config.derive.bash.file 2>/dev/null)
  rm -rf "$fixture" 2>/dev/null

  if [ "$mode" != "dev" ]; then
    create.result 1 "oosh.mode derived [$mode], expected 'dev' — it is the basename of the canonical ~/oosh"
  elif [ -z "$os" ]; then
    create.result 1 "oosh.os derived nothing; os.check.env maps \$OSTYPE and must always answer"
  elif [ "$level" != "3" ]; then
    create.result 1 "log.level derived [$level], expected 3 — the table said 1, but this:16 and log:125 both default to 3"
  elif [ "$cfgFile" != "user.env" ]; then
    create.result 1 "config.file derived [$cfgFile], expected user.env"
  elif [ ! -x "${bashFile%% *}" ]; then
    create.result 1 "bash.file derived [$bashFile], which is not executable"
  else
    create.result 0 "every deriver answers"
  fi
  return $(result)
}
test.case - "T80: each required variable has a deriver that answers" \
  test.config.deriversAnswer
expect 0 "every deriver answers" \
  "the table's third column was prose nothing could run — that is why the advertised repair could not repair"

# ============================================================================
# T81: config.init.env RE-DERIVES a missing required variable
# ============================================================================
# F5, reproduced. Measured on a clean macOS VM 2026-09-17: `config validate
# required` said `missing: OOSH_MODE OOSH_OS`, the operator ran the repair it
# advertises, and it came back `missing: OOSH_MODE OOSH_OS OOSH_PM` with
# oosh.env EMPTY. config.save persists the ENVIRONMENT, and the environment is
# populated FROM the config — a closed loop with no source of truth, so a value
# that falls out can never come back.
test.config.initEnvRederives() { # <dir> # run config.init.env against <dir> with OOSH_OS empty; echo the resulting oosh.env
  env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
      CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1
  cat "$1/oosh.env" 2>/dev/null
}
test.config.initEnvRepairsMissing() {
  local base; base=$(test.suite.fixture.make test.config.rederive) \
    || { create.result 1 "mktemp failed"; return $(result); }
  # A tier that is complete EXCEPT for OOSH_OS — exactly the VM's state.
  test.config.requiredFixture "$base" dev
  # Remove the one variable. Nothing in a shell re-derives it (os.check.env is
  # never called by boot/this/config), so without a repair it is gone for good.
  grep -v 'OOSH_OS=' "$base/oosh.env" > "$base/oosh.env.tmp" && mv "$base/oosh.env.tmp" "$base/oosh.env"
  local after; after=$(test.config.initEnvRederives "$base")
  rm -rf "$base" 2>/dev/null

  if [ -z "$after" ]; then
    create.result 1 "config.init.env produced an EMPTY oosh.env — the measured macOS failure"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_OS='; then
    create.result 1 "OOSH_OS was not re-derived; oosh.env is now: [$(printf '%s' "$after" | tr '\n' ' ')]"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_MODE='; then
    create.result 1 "the repair lost OOSH_MODE, which was present before it ran"
  else
    create.result 0 "the missing variable is re-derived and the surviving ones are kept"
  fi
  return $(result)
}
test.case - "T81: config.init.env re-derives a missing required variable instead of re-persisting the gap" \
  test.config.initEnvRepairsMissing
expect 0 "the missing variable is re-derived and the surviving ones are kept" \
  "the command config validate required advertises as the repair made the report WORSE on a real machine"

# ============================================================================
# T82: the repair can never leave the report worse than it found it
# ============================================================================
# The guard that would have caught the macOS failure as it happened. A repair
# that cannot repair must leave the tier alone, not overwrite it with less.
test.config.initEnvNeverWorsens() {
  local base; base=$(test.suite.fixture.make test.config.noworsen) \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.config.requiredFixture "$base" dev
  local before; before=$(cat "$base/oosh.env" 2>/dev/null)
  # Point HOME at a home with NO ~/oosh symlink, so oosh.mode cannot derive.
  rm -f "$base/home/oosh"
  env -i PATH="$PATH" HOME="$base/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
      CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1
  local after; after=$(cat "$base/oosh.env" 2>/dev/null)
  local beforeCount afterCount
  beforeCount=$(printf '%s\n' "$before" | grep -c '^export ')
  afterCount=$(printf '%s\n' "$after" | grep -c '^export ')
  rm -rf "$base" 2>/dev/null

  if [ -z "$after" ]; then
    create.result 1 "the repair emptied oosh.env when it could not derive — exactly the macOS failure"
  elif [ "${afterCount:-0}" -lt "${beforeCount:-0}" ]; then
    create.result 1 "the repair lost variables: $beforeCount export lines before, $afterCount after"
  else
    create.result 0 "a repair that cannot repair leaves the tier no worse"
  fi
  return $(result)
}
test.case - "T82: a repair that cannot derive leaves the config no worse than it found it" \
  test.config.initEnvNeverWorsens
expect 0 "a repair that cannot repair leaves the tier no worse" \
  "on the VM the advertised repair went from 2 missing variables to 3, and emptied the file"

# ============================================================================
# T83: config.save reports an invalid file it just wrote — on STDERR
# ============================================================================
# F4. config.save validated what it wrote and threw the verdict away
# (`>/dev/null 2>&1 || warn.log`), which is why card 1's corruption reached a
# user at all: config.validate caught it on the FIRST macOS install and nobody
# heard it.
#
# STDERR, not stdout, and the reason is load-bearing: user:1702-1708 records
# that `$(user get basehome)` CAPTURES config.save's stdout, and a stray line
# there once propagated a garbage IdentityFile into a generated ssh config and
# failed the downstream git clone. stderr survives every LOG_LEVEL just as well
# and $( ) does not capture it.
#
# config.validate is shadowed rather than a file seeded invalid, because
# config.save REWRITES all three files before validating them — a seeded file
# would simply be replaced. Same technique as T75.
test.config.saveReportsInvalid() {
  local base; base=$(test.suite.fixture.make test.config.f4) \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out err rc
  out=$(
    config.validate() { return 1; }        # every file it writes "fails" validation
    CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
      config.save 2>"$base/stderr.txt"
    echo "RC=$?"
  )
  err=$(cat "$base/stderr.txt" 2>/dev/null)
  rc=$(printf '%s' "$out" | sed -n 's/.*RC=\([0-9]*\).*/\1/p')
  # The VERDICT must not be on stdout. NOT "stdout is empty" — the first version
  # of this assertion said that and was wrong: config.save has always written
  # `console.log` to stdout, 0 lines at LOG_LEVEL 1 but 9 at level 3, and the
  # container gate runs test cases above level 1. That is long-standing
  # behaviour which `$(user get basehome)` already defends against by forcing
  # LOG_DEVICE=/dev/null and redirecting (user:1699-1722). What card 2 could
  # newly break is putting the VERDICT there, so that is what is pinned.
  local stdoutNoise; stdoutNoise=$(printf '%s' "$out" | grep -c 'INVALID')
  rm -rf "$base" 2>/dev/null

  if [ "${rc:-0}" = "0" ]; then
    create.result 1 "config.save returned 0 after writing a file its own validator rejected"
  elif ! printf '%s\n' "$err" | grep -qE 'INVALID|invalid'; then
    create.result 1 "no verdict on stderr; stderr was: [$(printf '%s' "$err" | tr '\n' ' ')]"
  elif [ "${stdoutNoise:-0}" != "0" ]; then
    create.result 1 "the verdict reached STDOUT ($stdoutNoise line(s)); it belongs on stderr because $(user get basehome) captures stdout"
  else
    create.result 0 "the verdict reaches stderr and the exit status, stdout stays clean"
  fi
  return $(result)
}
test.case - "T83: config.save reports a file it wrote that its own validator rejects" \
  test.config.saveReportsInvalid
expect 0 "the verdict reaches stderr and the exit status, stdout stays clean" \
  "the guard caught card 1's corruption on the first install and the verdict went to /dev/null"

# The six placeholder cases `oo method.new` generated for the
# private.config.derive.* family were removed here, for the same reason as the
# four in card 1: every one of them is a GETTER consumed as $(...), so none sets
# $RESULT, and templates/code/newMethodTest's `expect 0 "<result>"` would have
# compared whatever the PREVIOUS test left behind. Six more tests that cannot
# fail. Their real coverage is T80 above.
#
# This is the second ticket in two days to hit it. The card for a newGetterTest
# template is filed; until it exists, generating a getter means deleting six
# placeholder cases by hand.

# ============================================================================
# T84: a rewrite never drops a required variable the file already carried
# ============================================================================
# Card 3. config.save persists the ENVIRONMENT and truncates with `{ … } >$CONFIG`,
# so a shell that is missing a required variable REWRITES THE FILE WITHOUT IT.
# `oo mode <branch>` is the live example (oo:938-940): it sets OOSH_MODE and
# immediately runs `config save oosh OOSH` from that shell — which has OOSH_MODE
# but nothing re-derives OOSH_OS at shell init, so OOSH_OS is dropped.
#
# That is the oscillation measured on the macOS VM across 2026-09-17: OOSH_OS
# present and OOSH_MODE missing at one point, the exact reverse an hour later.
# Card 2 made the config REPAIRABLE; this makes it stop degrading.
#
# Carrying forward is deliberately NOT derivation. Deriving belongs in
# config.init.env (card 2) where it can source `os` and take its time; the
# WRITER only has to refrain from throwing away what it was already holding.
test.config.saveKeepsRequired() {
  local fixture; fixture=$(test.suite.fixture.make test.config.keep) \
    || { create.result 1 "mktemp failed"; return $(result); }
  # A complete oosh.env, as a healthy host has.
  printf 'export OOSH_MODE="dev"\nexport OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' \
    > "$fixture/oosh.env"
  : > "$fixture/user.env"
  # A shell like the one `oo mode` saves from: OOSH_MODE set, OOSH_OS absent.
  local after
  after=$(
    unset OOSH_OS
    export OOSH_MODE="dev"
    CONFIG_PATH="$fixture" CONFIG_FILE=oosh.env CONFIG="$fixture/oosh.env" \
      config.save oosh OOSH >/dev/null 2>&1
    cat "$fixture/oosh.env" 2>/dev/null
  )
  rm -rf "$fixture" 2>/dev/null

  if ! printf '%s\n' "$after" | grep -q '^export OOSH_MODE='; then
    create.result 1 "OOSH_MODE, which the saving shell HAD, is missing: [$(printf '%s' "$after" | tr '\n' ' ')]"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_OS='; then
    create.result 1 "OOSH_OS was in the file and the rewrite dropped it — this is how the VM degraded"
  else
    create.result 0 "a rewrite keeps the required variables the file already carried"
  fi
  return $(result)
}
test.case - "T84: config.save does not drop a required variable the file already had" \
  test.config.saveKeepsRequired
expect 0 "a rewrite keeps the required variables the file already carried" \
  "oo mode saves oosh.env from a shell that has OOSH_MODE and no OOSH_OS, and the file loses OOSH_OS"

# ============================================================================
# T85: the config anchor survives into a GRANDCHILD process
# ============================================================================
# test.suite.config.isolate exports CONFIG_PATH, and a test that reaches a
# subprocess relies on that export surviving. On 2026-09-17 a macOS probe caught
# it NOT surviving: the audit had CONFIG_PATH=<fixture> and `export -p` agreed,
# and the `config` process two levels down had it EMPTY and defaulted to
# ~/config, writing the shared tier (research § 2 / § 5).
#
# That was never reproduced afterwards — see research § 17 for what was ruled
# out — and the chain that produced it no longer runs. But "isolation held the
# last five times I looked" is not a guarantee, and nothing in the suite
# asserted the property at all. This does.
#
# It is deliberately a WRITE test, not a variable-echo test: what matters is not
# that the child can read the anchor but that its writes land in the fixture and
# the real tier is untouched. That is what the canary guards globally and what
# this pins for one explicit, deep call chain.
test.config.anchorSurvivesGrandchild() {
  local fixture; fixture=$(test.suite.fixture.make test.config.anchor) \
    || { create.result 1 "mktemp failed"; return $(result); }
  : > "$fixture/user.env"
  local realTier="${TEST_SUITE_CONFIG_ORIGIN:-$HOME/config}"
  local realBefore realAfter
  realBefore=$(cat "$realTier/oosh.env" 2>/dev/null | cksum)

  # TWO levels: this shell → bash -c → config. The shape the macOS probe caught
  # losing the anchor was audit → oo → config, the same depth.
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    bash -c "\"$OOSH_DIR/config\" save oosh OOSH" >/dev/null 2>&1

  realAfter=$(cat "$realTier/oosh.env" 2>/dev/null | cksum)
  local wroteFixture=0
  [ -s "$fixture/oosh.env" ] && wroteFixture=1
  rm -rf "$fixture" 2>/dev/null

  if [ "$realBefore" != "$realAfter" ]; then
    create.result 1 "a grandchild config.save wrote the REAL tier $realTier — the anchor did not survive"
  elif [ "$wroteFixture" != "1" ]; then
    create.result 1 "the grandchild wrote nothing to the fixture; it did not see CONFIG_PATH at all"
  else
    create.result 0 "the anchor survives two levels down and the write lands in the fixture"
  fi
  return $(result)
}
test.case - "T85: an exported CONFIG_PATH survives into a grandchild process" \
  test.config.anchorSurvivesGrandchild
expect 0 "the anchor survives two levels down and the write lands in the fixture" \
  "a macOS probe once caught a grandchild defaulting to ~/config and writing the shared tier"


# ============================================================================
# T86: config.init.user re-templates a boot-era ~/.bashrc
# ============================================================================
# After boot was deleted (ee92d9e) a new terminal on a host templated between
# 2026-09-09 and 09-22 printed `bash: /home/…/oosh/boot: No such file`, then a
# cascade (`/setup.color.env`, `/log`, …) from empty anchors. The heal never
# fired: the guard was `grep -q 'config/user.env'`, and EVERY template era
# carries `CONFIG=~/config/user.env` on line 9 — so it matched the assignment
# and skipped the rewrite, for config init.user, oo user.fix and oo update
# alike. T49 pinned that guard's TEXT, never its verdict. This drives the
# extracted step on real .bashrc shapes and judges the files it leaves.
test.config.bashrcEnsure.case() { # <name> <bashrcContent|-absent-> <expectRewrite:yes|no> # one fixture home; echoes a diagnosis on failure
  local name="$1" content="$2" want="$3" home tmpl
  home=$(mktemp -d "${TMPDIR:-/tmp}/test.config.bashrc.XXXXXX") || { echo "$name: mktemp failed"; return 1; }
  tmpl="$OOSH_DIR/templates/user/bashrcTemplate"
  [ "$content" = "-absent-" ] || printf '%s\n' "$content" > "$home/.bashrc"
  private.config.bashrc.ensure "$home" "$OOSH_DIR" 20260923T000000 >/dev/null 2>&1
  local rc=$? bad=""
  [ "$rc" = "0" ] || bad="rc=$rc"
  if [ "$want" = "yes" ]; then
    cmp -s "$home/.bashrc" "$tmpl" || bad="$bad .bashrc is not the template"
    if [ "$content" != "-absent-" ]; then
      local b saved=""
      for b in "$home"/.bashrc.pre-oosh "$home"/.bashrc.orig.*; do
        [ -f "$b" ] && [ "$(cat "$b")" = "$content" ] && saved=yes
      done
      [ -n "$saved" ] || bad="$bad replaced without a backup of what it replaced"
    fi
  else
    [ "$(cat "$home/.bashrc")" = "$content" ] || bad="$bad a current .bashrc was rewritten"
  fi
  [ -f "$home/.bash_profile" ] || bad="$bad no .bash_profile"
  rm -rf "$home"
  [ -z "$bad" ] || { echo "$name:$bad"; return 1; }
  return 0
}
test.config.bashrcEnsure() {
  local out="" line
  # The exact boot-era shape from a real host: the line-9 assignment that
  # fooled the old guard, and the dead hook.
  local bootEra='#if [ -z "$CONFIG" ]; then
    CONFIG=~/config/user.env
if [ -f "$CONFIG" ]; then
    . "$HOME/oosh/boot"
    source $CONFIG_PATH/setup.color.env
fi'
  line=$(test.config.bashrcEnsure.case boot-era "$bootEra" yes) || out="$out [$line]"
  line=$(test.config.bashrcEnsure.case template "$(cat "$OOSH_DIR/templates/user/bashrcTemplate")" no) || out="$out [$line]"
  line=$(test.config.bashrcEnsure.case appended '[ -f ~/config/user.env ] && . ~/config/user.env' no) || out="$out [$line]"
  line=$(test.config.bashrcEnsure.case commented '# . ~/config/user.env' yes) || out="$out [$line]"
  line=$(test.config.bashrcEnsure.case absent -absent- yes) || out="$out [$line]"
  if [ -n "$out" ]; then
    create.result 1 "wrong .bashrc verdict:$out"
  else
    create.result 0 "boot-era and hookless files are re-templated with a backup; live hooks are left alone"
  fi
  return $(result)
}
test.case - "T86: a boot-era ~/.bashrc is re-templated; a live user.env hook is not" \
  test.config.bashrcEnsure
expect 0 "boot-era and hookless files are re-templated with a backup; live hooks are left alone" \
  "the guard matched line 9's CONFIG=~/config/user.env, so no heal ever replaced the dead boot hook"

# ============================================================================
# T87: ONE .bashrc writer, and no as-user hop sources the CALLER's ~/oosh
# ============================================================================
# T86 fixed config's writer; user.oosh.install and install state 33 kept their
# own inline copies — one with the very guard T86 replaced, both copying the
# template unconditionally with no stamped backup. And config.init.user's own
# `private.as.user … bash -c` strings sourced "$OOSH_DIR/this" — expanded by the
# CALLER, so root healing another user made them source /root/oosh/this, which
# they cannot read (/root is 0700); every source failed under 2>/dev/null and
# the heal never ran. Two structural pins, in the style of T49:
#   (1) `cp …/templates/user/bashrcTemplate` occurs in exactly one script: config.
#   (2) no script embeds `source "$OOSH_DIR/this"` in an as-user string — the
#       hop goes through private.this.as.user.preamble.get (T-THIS-AS-USER-PREAMBLE).
test.config.oneBashrcWriter() {
  local writers hops
  writers=$(git -C "$OOSH_DIR" grep -lE 'cp .*templates/user/bashrcTemplate' -- \
              ':!docs' ':!test' ':!old' ':!init/once' ':!*.md' ':!.claude' 2>/dev/null | tr '\n' ' ')
  [ "$writers" = "config " ] || { create.result 1 "bashrcTemplate is copied by: ${writers:-nobody} — expected config only"; return $(result); }
  hops=$(git -C "$OOSH_DIR" grep -nF 'source \"$OOSH_DIR/this\"' -- ':!docs' ':!test' ':!old' ':!*.md' 2>/dev/null)
  [ -z "$hops" ] || { create.result 1 "an as-user hop still sources the caller's \$OOSH_DIR/this: $hops"; return $(result); }
  create.result 0 "config is the one .bashrc writer and every as-user hop uses the preamble getter"
  return $(result)
}
test.case - "T87: bashrcTemplate is copied by config only; no as-user hop sources the caller's \$OOSH_DIR/this" \
  test.config.oneBashrcWriter
expect 0 "config is the one .bashrc writer and every as-user hop uses the preamble getter" \
  "user.oosh.install and state 33 carried inline copies; config.init.user sourced /root/oosh/this as another user"

### test.method

test.suite.save.results
