#!/usr/bin/env bash
# Comprehensive tests for the config script
# Tests: init, file, save, list, get, set, add, update, clean, delete, discover

#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi

source this
source test.suite
info.log "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

# This file dispatches `config` as a COMMAND in several probes, and a
# non-sourced `log.level` / `config save` persists to whatever CONFIG_PATH it
# inherits. Isolate before sourcing config. Possible only since T7 made
# config.init honour the anchor it is given — until then config.start re-ran
# config.init and moved the anchor back from inside this very file.
test.suite.config.isolate test.config >/dev/null || exit 1

source $OOSH_DIR/config

log.level $level

# Save original config state
ORIGINAL_CONFIG=$CONFIG
ORIGINAL_CONFIG_PATH=$CONFIG_PATH
ORIGINAL_CONFIG_FILE=$CONFIG_FILE

# Test directory for isolation
TEST_CONFIG_PATH="/tmp/test.config.$(id -u).$$"
mkdir -p "$TEST_CONFIG_PATH"

# Cleanup function
cleanup_test_config() {
  rm -rf "$TEST_CONFIG_PATH" 2>/dev/null
  export CONFIG=$ORIGINAL_CONFIG
  export CONFIG_PATH=$ORIGINAL_CONFIG_PATH
  export CONFIG_FILE=$ORIGINAL_CONFIG_FILE
}

# Setup test environment
setup_test_config() {
  export CONFIG_PATH="$TEST_CONFIG_PATH"
  export CONFIG_FILE="test.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  touch "$CONFIG"
}

# ============================================================================
# T1: Test config.init sets up CONFIG variables
# ============================================================================
test.case - "T1: config.init creates CONFIG_PATH and sets CONFIG" \
  config.init

if [ -d "$CONFIG_PATH" ] && [ -n "$CONFIG" ]; then
  create.result 0 "CONFIG initialized"
else
  create.result 1 "CONFIG_PATH=$CONFIG_PATH CONFIG=$CONFIG"
fi
expect 0 "CONFIG initialized" "config.init sets up environment"

# Reset to test environment
setup_test_config

# ============================================================================
# T2: Test config.file without args returns current file
# ============================================================================
test.case - "T2: config.file returns current file" \
  echo "checking"

CURRENT_FILE=$(config.file)
if [ "$CURRENT_FILE" = "$CONFIG_FILE" ]; then
  create.result 0 "file returned"
else
  create.result 1 "got: $CURRENT_FILE expected: $CONFIG_FILE"
fi
expect 0 "file returned" "config.file returns current file"

# ============================================================================
# T3: Test config.file sets new file
# ============================================================================
test.case - "T3: config.file sets new file" \
  config.file newtest.env

if [ "$CONFIG_FILE" = "newtest.env" ]; then
  create.result 0 "file changed"
else
  create.result 1 "CONFIG_FILE=$CONFIG_FILE"
fi
expect 0 "file changed" "config.file sets new file"

# Reset
setup_test_config

# ============================================================================
# T4: Test config.file.check with existing file
# ============================================================================
touch "$CONFIG_PATH/exists.env"
test.case - "T4: config.file.check finds existing file" \
  config.file.check exists

if [ "$RETURN_VALUE" -eq 0 ]; then
  create.result 0 "found exists.env"
else
  create.result 1 "not found"
fi
expect 0 "found exists.env" "config.file.check finds existing file"

# ============================================================================
# T5: Test config.save creates config file
# ============================================================================
export TEST_CONFIG_VAR1="value1"
export TEST_CONFIG_VAR2="value2"
setup_test_config

test.case - "T5: config.save creates file" \
  config.save testcfg TEST_CONFIG

if [ -f "$CONFIG_PATH/testcfg.env" ]; then
  create.result 0 "testcfg.env created"
else
  create.result 1 "testcfg.env missing"
fi
expect 0 "testcfg.env created" "config.save creates file"

# ============================================================================
# T6: Test config.save captures prefixed variables
# ============================================================================
test.case - "T6: config.save captures prefixed variables" \
  echo "checking saved content"

SAVED_CONTENT=$(cat "$CONFIG_PATH/testcfg.env" 2>/dev/null)
if echo "$SAVED_CONTENT" | grep -q "TEST_CONFIG_VAR1" && \
   echo "$SAVED_CONTENT" | grep -q "TEST_CONFIG_VAR2"; then
  create.result 0 "variables saved"
else
  create.result 1 "variables missing"
fi
expect 0 "variables saved" "config.save captures prefixed variables"

# ============================================================================
# T7: Test config.list shows config content
# ============================================================================
setup_test_config
echo 'export TEST_LIST_VAR="listvalue"' > "$CONFIG_PATH/listtest.env"

test.case - "T7: config.list shows content" \
  echo "checking list"

config.file listtest.env
LIST_OUTPUT=$(config.list listtest 2>/dev/null)
if echo "$LIST_OUTPUT" | grep -q "TEST_LIST_VAR"; then
  create.result 0 "list shows content"
else
  create.result 1 "list output: $LIST_OUTPUT"
fi
expect 0 "list shows content" "config.list shows variables"

# ============================================================================
# T8: Test config.set adds new variable
# ============================================================================
setup_test_config
echo '# empty config' > "$CONFIG"

test.case - "T8: config.set adds new variable" \
  config.set NEW_VAR "newvalue"

if grep -q 'NEW_VAR="newvalue"' "$CONFIG"; then
  create.result 0 "NEW_VAR added"
else
  create.result 1 "NEW_VAR missing in $CONFIG"
fi
expect 0 "NEW_VAR added" "config.set adds new variable"

# ============================================================================
# T9: Test config.set updates existing variable
# ============================================================================
setup_test_config
echo 'export EXISTING_VAR="oldvalue"' > "$CONFIG"

test.case - "T9: config.set updates existing variable" \
  config.set EXISTING_VAR "updatedvalue"

if grep -q 'EXISTING_VAR="updatedvalue"' "$CONFIG"; then
  create.result 0 "EXISTING_VAR updated"
else
  create.result 1 "EXISTING_VAR not updated"
fi
expect 0 "EXISTING_VAR updated" "config.set updates existing variable"

# ============================================================================
# T10: config.get reads value from the file (not from shell env)
# ============================================================================
setup_test_config
echo 'export GET_TEST_VAR="getvalue"' > "$CONFIG"
unset GET_TEST_VAR

test.case - "T10: config.get reads value from file" \
  echo "checking get"

GET_RESULT=$(config.get GET_TEST_VAR 2>/dev/null)
if [ "$GET_RESULT" = "getvalue" ]; then
  create.result 0 "got value"
else
  create.result 1 "got: $GET_RESULT"
fi
expect 0 "got value" "config.get reads value from file (not shell env)"

# ============================================================================
# T11: Test config.add appends source line
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
touch "$CONFIG_PATH/addon.env"

test.case - "T11: config.add appends source line" \
  config.add addon

# config.add calls config.clean which sorts the file
if grep -qE '(source|\.) \$CONFIG_PATH/addon\.env' "$CONFIG"; then
  create.result 0 "source added"
else
  create.result 1 "source missing in: $(cat $CONFIG)"
fi
expect 0 "source added" "config.add appends source line"

# ============================================================================
# T12: Test config.clean removes duplicates
# ============================================================================
setup_test_config
cat > "$CONFIG" << 'EOF'
export DUP_VAR="value"
export DUP_VAR="value"
export UNIQUE_VAR="unique"
export DUP_VAR="value"
EOF

test.case - "T12: config.clean removes duplicates" \
  config.clean

LINE_COUNT=$(grep -c "DUP_VAR" "$CONFIG" 2>/dev/null || echo "0")
if [ "$LINE_COUNT" -eq 1 ]; then
  create.result 0 "duplicates removed"
else
  create.result 1 "duplicates remain: $LINE_COUNT"
fi
expect 0 "duplicates removed" "config.clean removes duplicates"

# ============================================================================
# T13: Test config.delete removes config file
# ============================================================================
setup_test_config
touch "$CONFIG_PATH/todelete.env"
config.file todelete.env

test.case - "T13: config.delete removes file" \
  config.delete todelete

if [ ! -f "$CONFIG_PATH/todelete.env" ]; then
  create.result 0 "file deleted"
else
  create.result 1 "file still exists"
fi
expect 0 "file deleted" "config.delete removes file"

# ============================================================================
# T14: Test config.discover lists config files
# ============================================================================
setup_test_config
touch "$CONFIG_PATH/discover1.env"
touch "$CONFIG_PATH/discover2.env"

test.case - "T14: config.discover lists files" \
  echo "checking discover"

DISCOVER_OUTPUT=$(config.discover 2>/dev/null)
if echo "$DISCOVER_OUTPUT" | grep -q "discover1.env"; then
  create.result 0 "discover1 found"
else
  create.result 1 "output: $DISCOVER_OUTPUT"
fi
expect 0 "discover1 found" "config.discover lists files"

# ============================================================================
# T15: Test config.string.quote handles special chars
# ============================================================================
test.case - "T15: config.string.quote returns quoted string" \
  echo "checking quote"

QUOTED=$(config.string.quote "hello world")
if [ -n "$QUOTED" ]; then
  create.result 0 "string quoted"
else
  create.result 1 "quote failed"
fi
expect 0 "string quoted" "config.string.quote returns quoted string"

# ============================================================================
# T16: Test config.file reset restores defaults
# ============================================================================
config.file someother.env

test.case - "T16: config.file reset restores user.env" \
  config.file reset

if [ "$CONFIG_FILE" = "user.env" ]; then
  create.result 0 "file reset"
else
  create.result 1 "CONFIG_FILE=$CONFIG_FILE"
fi
expect 0 "file reset" "config.file reset restores user.env"

# Reset for remaining tests
setup_test_config

# ============================================================================
# T17: Test config.update saves and adds
# ============================================================================
export TEST_UPDATE_VAR="updateval"
setup_test_config
echo '# main config' > "$CONFIG"

test.case - "T17: config.update saves and adds" \
  config.update updatetest TEST_UPDATE

# Check file was created and source line added
if [ -f "$CONFIG_PATH/updatetest.env" ] && grep -qE '(source|\.) \$CONFIG_PATH/updatetest\.env' "$CONFIG"; then
  create.result 0 "update complete"
else
  create.result 1 "file exists: $(test -f $CONFIG_PATH/updatetest.env && echo yes || echo no) source: $(grep updatetest $CONFIG)"
fi
expect 0 "update complete" "config.update saves and adds"

# ============================================================================
# T18: Test config.get with missing variable
# ============================================================================
unset NONEXISTENT_VAR

test.case - "T18: config.get returns empty for missing var" \
  echo "checking missing"

GET_MISSING=$(config.get NONEXISTENT_VAR 2>/dev/null)
if [ -z "$GET_MISSING" ]; then
  create.result 0 "empty for missing"
else
  create.result 1 "returned: $GET_MISSING"
fi
expect 0 "empty for missing" "config.get returns empty for missing var"

# ============================================================================
# T19: Test config.set with empty value
# ============================================================================
setup_test_config
echo 'export EMPTY_TEST="hasvalue"' > "$CONFIG"

test.case - "T19: config.set allows empty value" \
  config.set EMPTY_TEST ""

if grep -q 'EMPTY_TEST=""' "$CONFIG"; then
  create.result 0 "set to empty"
else
  create.result 1 "config content: $(cat $CONFIG)"
fi
expect 0 "set to empty" "config.set allows empty value"

# ============================================================================
# T20: config.set + config.get round-trip
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
unset ROUND_TRIP_VAR

test.case - "T20: config.set then config.get round-trips through the file" \
  echo "checking round-trip"

config.set ROUND_TRIP_VAR foo >/dev/null
ROUND_TRIP_RESULT=$(config.get ROUND_TRIP_VAR 2>/dev/null)
if [ "$ROUND_TRIP_RESULT" = "foo" ]; then
  create.result 0 "round-trip worked"
else
  create.result 1 "got: $ROUND_TRIP_RESULT (config: $(cat $CONFIG))"
fi
expect 0 "round-trip worked" "config.set + config.get round-trip via file"

# ============================================================================
# T21: config.set + config.get preserves quoted spaces
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
unset SPACE_RT_VAR

test.case - "T21: config.set + config.get preserves quoted spaces" \
  echo "checking spaces"

config.set SPACE_RT_VAR "hello world" >/dev/null
SPACE_RT_RESULT=$(config.get SPACE_RT_VAR 2>/dev/null)
if [ "$SPACE_RT_RESULT" = "hello world" ]; then
  create.result 0 "spaces preserved"
else
  create.result 1 "got: '$SPACE_RT_RESULT'"
fi
expect 0 "spaces preserved" "config.set/get preserves quoted spaces"

# ============================================================================
# T22: config.set does NOT leak the full config to stdout on append
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
unset LEAK_CHECK_VAR

test.case - "T22: config.set does not leak full config on append" \
  echo "checking no leak"

LEAK_OUT=$(config.set LEAK_CHECK_VAR x 2>&1)
LEAK_LINES=$(printf '%s' "$LEAK_OUT" | grep -c '.' )
if [ "$LEAK_LINES" -le 1 ]; then
  create.result 0 "no leak"
else
  create.result 1 "leaked $LEAK_LINES lines: $LEAK_OUT"
fi
expect 0 "no leak" "config.set must not print the full config on append"

# ============================================================================
# T23: config.get tolerates legacy "export declare X=" malformed lines
# ============================================================================
setup_test_config
echo 'export declare LEGACY_VAR="legacy"' > "$CONFIG"
unset LEGACY_VAR

test.case - "T23: config.get reads legacy 'export declare X=' lines" \
  echo "checking legacy form"

LEGACY_RESULT=$(config.get LEGACY_VAR 2>/dev/null)
if [ "$LEGACY_RESULT" = "legacy" ]; then
  create.result 0 "legacy form readable"
else
  create.result 1 "got: '$LEGACY_RESULT' (file: $(cat $CONFIG))"
fi
expect 0 "legacy form readable" "config.get tolerates malformed export-declare line"

# ============================================================================
# T24: config.set normalizes malformed lines on update
# ============================================================================
setup_test_config
echo 'export declare NORMALIZE_VAR="old"' > "$CONFIG"
unset NORMALIZE_VAR

test.case - "T24: config.set normalizes 'export declare X=' to clean form" \
  echo "checking normalization"

config.set NORMALIZE_VAR "new" >/dev/null
NORMALIZE_RESULT=$(config.get NORMALIZE_VAR 2>/dev/null)
if [ "$NORMALIZE_RESULT" = "new" ] && grep -q '^export NORMALIZE_VAR=' "$CONFIG" && ! grep -q 'export declare NORMALIZE_VAR' "$CONFIG"; then
  create.result 0 "normalized"
else
  create.result 1 "got '$NORMALIZE_RESULT', file: $(cat $CONFIG)"
fi
expect 0 "normalized" "config.set normalizes legacy export-declare lines on update"

# ============================================================================
# Cleanup
# ============================================================================
cleanup_test_config

# Unset test variables
unset TEST_CONFIG_VAR1
unset TEST_CONFIG_VAR2
unset TEST_UPDATE_VAR

# ============================================================================
# Completion function tests
# ============================================================================

test.case $level "config.parameter.completion.configfile exists" \
  type -t config.parameter.completion.configfile
if type -t config.parameter.completion.configfile &>/dev/null; then
  expect.pass "config.parameter.completion.configfile function exists"
else
  expect.fail "config.parameter.completion.configfile should exist"
fi

test.case $level "config.parameter.completion.envVariable exists" \
  type -t config.parameter.completion.envVariable
if type -t config.parameter.completion.envVariable &>/dev/null; then
  expect.pass "config.parameter.completion.envVariable function exists"
else
  expect.fail "config.parameter.completion.envVariable should exist"
fi

test.case $level "config.parameter.completion.name returns values" \
  config.parameter.completion.name ""
COMP_OUTPUT=$(config.parameter.completion.name "" 2>/dev/null)
if [ -n "$COMP_OUTPUT" ]; then
  expect.pass "config.parameter.completion.name returns config names"
else
  expect.pass "config.parameter.completion.name runs (may be empty if no configs)"
fi

test.case $level "config.parameter.completion.sshConfigName exists" \
  type -t config.parameter.completion.sshConfigName
if type -t config.parameter.completion.sshConfigName &>/dev/null; then
  expect.pass "config.parameter.completion.sshConfigName function exists"
else
  expect.fail "config.parameter.completion.sshConfigName should exist"
fi

# ============================================================================
# T-CONFIG-SAVE-EXCLUDES-INSTALL: config.save excludes INSTALL variables
# ============================================================================
test.config.saveExcludesInstall() {
  local FIXTURE="/tmp/test.config.install.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="install_test.env" CONFIG="$FIXTURE/install_test.env"
  touch "$CONFIG"
  export LOG_INSTALL="/tmp/test_install_log"
  config.save install_test LOG
  if grep -q 'LOG_INSTALL' "$FIXTURE/install_test.env" 2>/dev/null; then
    create.result 1 "LOG_INSTALL found in saved config (should be excluded)"
  else
    create.result 0 "INSTALL variables excluded"
  fi
  unset LOG_INSTALL
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  rm -rf "$FIXTURE"
}
test.case - "T-CONFIG-SAVE-EXCLUDES-INSTALL: config.save excludes INSTALL variables" \
  test.config.saveExcludesInstall
expect 0 "INSTALL variables excluded" "config.save excludes INSTALL variables"

# ============================================================================
# T-CONFIG-SAVE-KEEPS-NON-INSTALL: config.save preserves non-INSTALL variables
# ============================================================================
test.config.savePreservesNonInstall() {
  local FIXTURE="/tmp/test.config.preserve.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="preserve_test.env" CONFIG="$FIXTURE/preserve_test.env"
  touch "$CONFIG"
  export OOSH_TEST_PRESERVE="keepme"
  config.save preserve_test OOSH_TEST
  if grep -q 'OOSH_TEST_PRESERVE' "$FIXTURE/preserve_test.env" 2>/dev/null; then
    create.result 0 "non-INSTALL variables preserved"
  else
    create.result 1 "OOSH_TEST_PRESERVE missing from saved config"
  fi
  unset OOSH_TEST_PRESERVE
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  rm -rf "$FIXTURE"
}
test.case - "T-CONFIG-SAVE-KEEPS-NON-INSTALL: config.save preserves non-INSTALL variables" \
  test.config.savePreservesNonInstall
expect 0 "non-INSTALL variables preserved" "config.save preserves non-INSTALL variables"

# ============================================================================
# T-CONFIG-SAVE-BASH-FILE: config saves BASH_FILE to oosh.env
# ============================================================================
test.config.savesBashFile() {
  local SRC
  # The body of config.save is private.config.save (T-CONFIG-SAVE-LAYOUT-ARGS).
  SRC=$(declare -f private.config.save 2>/dev/null)
  if echo "$SRC" | grep -q 'BASH_FILE'; then
    create.result 0 "BASH_FILE referenced in config.save"
  else
    create.result 1 "BASH_FILE not found in config.save"
  fi
}
test.case - "T-CONFIG-SAVE-BASH-FILE: config saves BASH_FILE to oosh.env" \
  test.config.savesBashFile
expect 0 "BASH_FILE referenced in config.save" "config saves BASH_FILE"

# ============================================================================
# T74 (re-sourcing boot never grows PATH) is test/test.this T-THIS-PATH-NO-GROWTH now:
# `this` de-duplicates PATH, not boot (dev.config Round 3).
# ============================================================================

# ============================================================================
# T25: config.string.quote handles spaces
# ============================================================================
test.config.stringQuoteSpaces() {
  local RESULT_QUOTE
  RESULT_QUOTE=$(config.string.quote "hello world")
  if echo "$RESULT_QUOTE" | grep -q "hello world"; then
    create.result 0 "spaces preserved in quoted string"
  else
    create.result 1 "got: $RESULT_QUOTE"
  fi
}
test.case - "T25: config.string.quote handles spaces" \
  test.config.stringQuoteSpaces
expect 0 "spaces preserved in quoted string" "config.string.quote handles spaces"

# ============================================================================
# T26: config.string.quote handles double quotes
# ============================================================================
test.config.stringQuoteDoubleQuotes() {
  local RESULT_QUOTE
  RESULT_QUOTE=$(config.string.quote 'say "hello"')
  if echo "$RESULT_QUOTE" | grep -q 'hello'; then
    create.result 0 "double-quote string quoted"
  else
    create.result 1 "quote returned empty or mangled"
  fi
}
test.case - "T26: config.string.quote handles double quotes" \
  test.config.stringQuoteDoubleQuotes
expect 0 "double-quote string quoted" "config.string.quote handles double quotes"

# ============================================================================
# T27: config.set handles value with spaces
# ============================================================================
test.config.setHandlesSpaces() {
  local FIXTURE="/tmp/test.config.spaces.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="spaces_test.env" CONFIG="$FIXTURE/spaces_test.env"
  echo '# empty config' > "$CONFIG"
  config.set SPACE_VAR "hello world test"
  if grep -q 'SPACE_VAR=.*hello world test' "$CONFIG"; then
    create.result 0 "value with spaces stored"
  else
    create.result 1 "config content: $(cat "$CONFIG")"
  fi
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  rm -rf "$FIXTURE"
}
test.case - "T27: config.set handles value with spaces" \
  test.config.setHandlesSpaces
expect 0 "value with spaces stored" "config.set handles value with spaces"

# ============================================================================
# T28: config.save does not capture variables whose VALUE contains the prefix
# ============================================================================
# T28: grep pattern [_=] matches var NAMES with prefix but not VALUES containing prefix
test.case - "T28: config grep pattern excludes value-only matches" \
  echo "checking"

# Simulate declare -p output with a false-positive value match
TEST_DECLARE='declare -x OOSH_DIR="/path"
declare -- COMMANDS="save oosh OOSH"
declare -x OOSH_PROMPT="oosh "'
MATCHED=$(echo "$TEST_DECLARE" | grep " OOSH[_=]")
if echo "$MATCHED" | grep -q "OOSH_DIR" && \
   echo "$MATCHED" | grep -q "OOSH_PROMPT" && \
   ! echo "$MATCHED" | grep -q "COMMANDS"; then
  create.result 0 "pattern correct"
else
  create.result 1 "got: $MATCHED"
fi
expect 0 "pattern correct" "grep ' PREFIX[_=]' matches names not values"

# ============================================================================
# T29: config.save never writes the saving user's absolute $HOME into the shared config
# ============================================================================
# ~/config is SHARED between the users of a host. Every OOSH_*/LOG_*/CONFIG*
# variable is persisted (the MacStudio model), so the per-user paths among them
# — CONFIG_PATH, OOSH_DIR, OOSH_COMPONENTS_DIR, LOG_LIVE — are written
# "$HOME/…" and expand to each reader's own home. OOSH_BRANCH is install INPUT
# and is never persisted (T7).
test.config.saveNoAbsoluteHome() {
  local fx bad="" content want; fx=$(test.suite.fixture.make leaks); mkdir -p "$fx/config"
  # a switched shared config: OOSH_MODE is per user there
  echo '. $HOME/.config/oosh/user.session.env' > "$fx/config/user.env"
  content=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=leaks_test.env CONFIG="$fx/config/leaks_test.env"
    export OOSH_DIR="$fx/oosh" OOSH_COMPONENTS_DIR="$fx/components" LOG_LIVE="$fx/config/log.live.out" OOSH_BRANCH=prod
    export OOSH_SHLVL=5 OOSH_STATUS="0: started in shell level: 2" LOG_NAME="saver@host" OOSH_MODE=dev
    for p in CONFIG OOSH LOG; do config.save leaks_test $p >/dev/null 2>&1; cat "$CONFIG" 2>/dev/null; done )
  printf '%s\n' "$content" | grep -qF "$fx" && bad="$bad absolute-home=[$(printf '%s\n' "$content" | grep -F "$fx" | head -1)]"
  for want in 'export CONFIG_PATH="$HOME/config"' 'export OOSH_DIR="$HOME/oosh"' \
              'export OOSH_COMPONENTS_DIR="$HOME/components"'; do
    printf '%s\n' "$content" | grep -qxF "$want" || bad="$bad missing=[$want]"
  done
  printf '%s\n' "$content" | grep -qE '^export (OOSH_BRANCH|OOSH_MODE|OOSH_SHLVL|OOSH_STATUS|LOG_NAME|LOG_LIVE)=' \
    && bad="$bad persisted=[$(printf '%s\n' "$content" | grep -E '^export (OOSH_BRANCH|OOSH_MODE|OOSH_SHLVL|OOSH_STATUS|LOG_NAME|LOG_LIVE)=' | tr '\n' ' ')]"
  rm -rf "$fx"
  if [ -z "$bad" ]; then create.result 0 "no absolute home in the shared config; no install input, runtime reading or session value"
  else create.result 1 "saved config:$bad"; fi
}
test.case - "T29: config.save writes values under \$HOME as \"\$HOME/…\" and never persists OOSH_BRANCH" \
  test.config.saveNoAbsoluteHome
expect 0 "no absolute home in the shared config; no install input, runtime reading or session value" "~/config is shared: the saving user's home must never reach another user"

# ============================================================================
# T30: config.save generates a CODE-FREE user.env (values + source chain, no logic)
# ============================================================================
# "NEVER logic in ENV FILES": user.env holds config values + the `source *.env`
# chain (composition, allowed) but NO logic — no self-anchor `: ${…}`, no `{ } &&`,
# no `if`. Fixture-based (config.init.env into a temp dir), independent of the
# live host.
test.config.userEnvSelfAnchors() {
  local fixture="/tmp/test.config.pure.$(id -u).$$"; mkdir -p "$fixture"
  echo "# bogus" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1
  local rc=$?
  # forbid actual logic (self-anchor / brace-group / if); the source chain is fine
  local code; code=$(grep -nE '^[[:space:]]*(:[[:space:]]|\{|if[[:space:]])' "$fixture/user.env" 2>/dev/null | head -1)
  # and it must carry the source chain (proves it's the full config, not 2 lines)
  local haschain=1; grep -qE '(source|\.) .*oosh\.env' "$fixture/user.env" || haschain=0
  rm -rf "$fixture" 2>/dev/null
  if [ "$rc" -eq 0 ] && [ -z "$code" ] && [ "$haschain" = "1" ]; then
    create.result 0 "user.env is code-free with source chain"
  else
    create.result 1 "user.env wrong (validate rc=$rc, code line: $code, chain=$haschain)"
  fi
}
test.case - "T30: config.save generates code-free user.env (values + source chain)" \
  test.config.userEnvSelfAnchors
expect 0 "user.env is code-free with source chain" "user.env has no logic but keeps the source chain"

# ============================================================================
# T31: both anchors are the ~/… constants everywhere in the tree
# ============================================================================
# boot is gone (dev.config Round 5). The anchors reach a shell as DATA —
# user.env/oosh.env carry "$HOME/config" and "$HOME/oosh" whatever the saving
# shell held (T-CONFIG-SAVE-ANCHORS-CONSTANT) — and as `this`'s fallback. The
# tree-wide sweep is owned by this.anchor.validate (test.this T-OOSH-DIR-* /
# T-CONFIG-PATH-*); this case delegates to it.
test.config.anchorsTreeConform() {
  local verdict okLines
  verdict=$(this.anchor.validate all "$OOSH_DIR" 2>/dev/null)
  # LOG_DEVICE may not be a tty here, so error.log lines can share the capture
  okLines=$(printf '%s\n' "$verdict" | grep -c "0 violations")
  if [ "$okLines" -eq 2 ]; then
    create.result 0 "both anchors conform tree-wide"
  else
    create.result 1 "tree: $verdict"
  fi
}
test.case - "T31: every OOSH_DIR= / CONFIG_PATH= in the tree is the ~/… constant" \
  test.config.anchorsTreeConform
expect 0 "both anchors conform tree-wide" "both anchors are always the ~/… symlinks themselves"

# ============================================================================
# T32: private.ensure.sharedTree drops self-referential symlinks
# ============================================================================
# Fixture: a temp dir with a symlink that points back to itself (the exact
# bug pattern observed under sharedConfig/sharedConfig on tampered VMs).
test.config.selfLoopRemoved() {
  local fixture="/tmp/test.config.fixture.$(id -u).$$"
  mkdir -p "$fixture"
  ln -s "$fixture" "$fixture/loop"
  private.ensure.sharedTree "$fixture" >/dev/null 2>&1
  if [ -L "$fixture/loop" ] || [ -e "$fixture/loop" ]; then
    create.result 1 "self-loop survived"
  else
    create.result 0 "self-loop removed"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T32: private.ensure.sharedTree removes self-loop symlinks" \
  test.config.selfLoopRemoved
expect 0 "self-loop removed" "self-referential symlink is detected and dropped"

# ============================================================================
# T33: private.ensure.sharedTree is idempotent (re-run produces no further change)
# ============================================================================
# Capture the dir's metadata, re-run, compare. If the helper is idempotent
# the second run is a no-op observable in the metadata snapshot.
test.config.sharedTreeIdempotent() {
  local fixture="/tmp/test.config.idem.$(id -u).$$"
  mkdir -p "$fixture/sub"
  touch "$fixture/file"
  private.ensure.sharedTree "$fixture" >/dev/null 2>&1
  local snap1
  snap1=$(find "$fixture" -printf "%M %g %p\n" 2>/dev/null | sort)
  private.ensure.sharedTree "$fixture" >/dev/null 2>&1
  local snap2
  snap2=$(find "$fixture" -printf "%M %g %p\n" 2>/dev/null | sort)
  if [ "$snap1" = "$snap2" ]; then
    create.result 0 "idempotent"
  else
    create.result 1 "second run changed metadata"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T33: private.ensure.sharedTree is idempotent" \
  test.config.sharedTreeIdempotent
expect 0 "idempotent" "re-running produces no further metadata change"

# ============================================================================
# T34: config.init.check is silent (returns 0, no failure) on a healthy shell
# ============================================================================
# We can't assert *no warnings* without parsing log output, so just verify
# the return code: check is documented as diagnostic-only and must always
# return 0 regardless of state.
test.config.checkAlwaysSucceeds() {
  config.init.check "$USER" >/dev/null 2>&1
  create.result $? "check returned"
}
test.case - "T34: config.init.check is non-blocking (always returns 0)" \
  test.config.checkAlwaysSucceeds
expect 0 "check returned" "config.init.check never fails the caller"

# ============================================================================
# T35: completion functions for username parameter exist and are callable
# ============================================================================
# config.init.user/.check/.full all delegate username completion to user.list.
# We assert the functions are defined; verifying user.list output requires
# sourcing dev/user, which this test file deliberately does not (test isolation
# pattern matches T18-T20 above which use `type -t`).
test.config.completionsExist() {
  if [ "$(type -t config.init.user.completion.username)"  = "function" ] \
  && [ "$(type -t config.init.check.completion.username)" = "function" ] \
  && [ "$(type -t config.init.full.completion.username)"  = "function" ]; then
    create.result 0 "completions defined"
  else
    create.result 1 "missing: user/[$(type -t config.init.user.completion.username)] check/[$(type -t config.init.check.completion.username)] full/[$(type -t config.init.full.completion.username)]"
  fi
}
test.case - "T35: config.init.* username completion functions are defined" \
  test.config.completionsExist
expect 0 "completions defined" "all three username completions exist"

# ============================================================================
# T36: config.init.full is defined and callable as a function
# ============================================================================
# Function-existence smoke test only — invoking config.init.full for real
# would call config.init.shared which mutates the live sharedConfig (chgrp,
# chmod) and prompts for sudo on a fresh shell. That's the right behaviour
# in production but bad for unit tests. We assert the dispatcher exists;
# real end-to-end coverage lives in the manual verification block in the
# plan (running ./config init.full on .149 + diffing snapshots).
test.config.fullExists() {
  if [ "$(type -t config.init.full)" = "function" ]; then
    create.result 0 "full defined"
  else
    create.result 1 "config.init.full is not a function"
  fi
}
test.case - "T36: config.init.full is a defined function (dispatcher smoke test)" \
  test.config.fullExists
expect 0 "full defined" "config.init.full exists and is callable"

# ============================================================================
# T37: config.init.env regenerates oosh.env as PURE data
# ============================================================================
# Mirrors what install does. After init.env, oosh.env must be pure data (only
# export/comment/blank) — no OOSH_DIR self-anchor, no PATH block, no source-log
# line. config.validate is the guard.
test.config.initEnvRegensOoshEnv() {
  local fixture="/tmp/test.config.env.$(id -u).$$"
  mkdir -p "$fixture"
  # Seed with deliberately-wrong content (the boss-tamper pattern)
  echo "# bogus content" > "$fixture/oosh.env"
  echo "# bogus user" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  CONFIG_PATH="$fixture" config.validate oosh >/dev/null 2>&1
  local rc=$?
  # CONTENT, not just shape. `config.validate oosh` passes on a ZERO-BYTE file —
  # a file with no lines has no bad lines — so this test could not fail for the
  # one outcome that actually happened: config.init.env emptying oosh.env on the
  # macOS VM (F5). A regenerated oosh.env must carry at least one export.
  local exports
  exports=$(grep -c '^[[:space:]]*export ' "$fixture/oosh.env" 2>/dev/null)
  rm -rf "$fixture" 2>/dev/null
  if [ "$rc" -ne 0 ]; then
    create.result 1 "oosh.env not pure after regen"
  elif [ "${exports:-0}" -lt 1 ]; then
    create.result 1 "oosh.env is pure but EMPTY after regen — a zero-byte file passes config.validate"
  else
    create.result 0 "oosh.env is pure data after regen"
  fi
}
test.case - "T37: config.init.env regenerates oosh.env as pure data" \
  test.config.initEnvRegensOoshEnv
expect 0 "oosh.env is pure data after regen" "config.init.env writes pure-data oosh.env"

# ============================================================================
# T38: config.init.env regenerates user.env as PURE data
# ============================================================================
test.config.initEnvRegensUserEnv() {
  local fixture="/tmp/test.config.userenv.$(id -u).$$"
  mkdir -p "$fixture"
  echo "# bogus content" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1
  local rc=$?
  rm -rf "$fixture" 2>/dev/null
  if [ "$rc" -eq 0 ]; then
    create.result 0 "user.env is pure data after regen"
  else
    create.result 1 "user.env not pure after regen"
  fi
}
test.case - "T38: config.init.env regenerates user.env as pure data" \
  test.config.initEnvRegensUserEnv
expect 0 "user.env is pure data after regen" "config.init.env writes pure-data user.env"

# ============================================================================
# T39: config.init.env backs up user.env to user.env.bak.<ts> before regen
# ============================================================================
test.config.initEnvBacksUpUserEnv() {
  local fixture="/tmp/test.config.bak.$(id -u).$$"
  mkdir -p "$fixture"
  local sentinel="MARKER_$(date +%s%N)"
  echo "$sentinel" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  if ls "$fixture"/user.env.bak.* >/dev/null 2>&1 \
     && grep -q "$sentinel" "$fixture"/user.env.bak.* 2>/dev/null; then
    create.result 0 "user.env backup created with original content"
  else
    create.result 1 "no backup or sentinel missing: $(ls "$fixture")"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T39: config.init.env backs up user.env before regenerating" \
  test.config.initEnvBacksUpUserEnv
expect 0 "user.env backup created with original content" "user.env is preserved as user.env.bak.<ts>"

# ============================================================================
# T41: config.validate rejects logic lines (the "NEVER logic in ENV FILES" guard)
# ============================================================================
# config.validate is the enforcement that keeps the pure-data invariant from
# silently regressing. It must ACCEPT export/comment/blank lines and REJECT any
# logic (self-anchor `: ${…}`, `source …`, `if …`).
test.config.fallbackRedirectsMisderivedPath() {
  local fixture="/tmp/test.config.val.$(id -u).$$"; mkdir -p "$fixture"
  local fail=0
  # pure file → accept (rc 0)
  printf '%s\n' '# comment' '' 'export FOO="bar"' 'export BAZ=1' > "$fixture/user.env"
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1 || { fail=1; important.log "validate rejected a pure file"; }
  # planted logic → reject (rc 1)
  printf '%s\n' 'export FOO="bar"' ': ${OOSH_DIR:=$HOME/oosh}' 'source $CONFIG_PATH/oosh.env' > "$fixture/oosh.env"
  if CONFIG_PATH="$fixture" config.validate oosh >/dev/null 2>&1; then
    fail=1; important.log "validate accepted a file containing logic"
  fi
  # D5: an INDENTED self-anchor with a trailing comment must NOT pass as a comment
  printf '%s\n' '  : ${OOSH_DIR:=/x} # guarded' > "$fixture/ind.env"
  if CONFIG_PATH="$fixture" config.validate ind >/dev/null 2>&1; then
    fail=1; important.log "validate accepted an indented self-anchor (comment bypass)"
  fi
  # D5: command substitution in a value EXECUTES on source — must be rejected
  printf '%s\n' 'export FOO="$(echo hi)"' > "$fixture/cmdsub.env"
  if CONFIG_PATH="$fixture" config.validate cmdsub >/dev/null 2>&1; then
    fail=1; important.log "validate accepted command substitution in a value"
  fi
  # and backtick form
  printf '%s\n' 'export BAR=`id`' > "$fixture/bt.env"
  if CONFIG_PATH="$fixture" config.validate bt >/dev/null 2>&1; then
    fail=1; important.log "validate accepted backtick substitution in a value"
  fi
  rm -rf "$fixture" 2>/dev/null
  if [ "$fail" = "0" ]; then
    create.result 0 "validate accepts pure, rejects logic"
  else
    create.result 1 "config.validate misbehaved"
  fi
}
test.case - "T41: config.validate accepts pure data, rejects logic lines" \
  test.config.fallbackRedirectsMisderivedPath
expect 0 "validate accepts pure, rejects logic" \
  "config.validate enforces the NEVER-logic-in-env-files invariant"

# A test of the per-user tier runs in a fixture HOME: the real
# ~/.config/oosh/log.session.env of the user running the suite stays as it was —
# same bytes, same inode, not written (no newer than a marker made just before).
test.config.realSessionUntouched() { # <testFunction> — run it; rc 1 when it touched the real log.session.env
  local f="$HOME/.config/oosh/log.session.env" fx before after rc
  fx=$(test.suite.fixture.make test.config.realSessionUntouched); touch "$fx/marker"
  before="$(ls -i "$f" 2>&1) $(cksum < "$f" 2>&1)"
  "$@"; rc=$?
  after="$(ls -i "$f" 2>&1) $(cksum < "$f" 2>&1)"
  [ "$f" -nt "$fx/marker" ] && after="$after written"
  rm -rf "$fx"
  if [ "$after" != "$before" ]; then
    create.result 1 "$1 touched the real $f: [$before] -> [$after]"
    return $(result)
  fi
  return $rc
}

# ============================================================================
# T42: config.list reads the per-user tier (~/.config/oosh) by name
# ============================================================================
# `config list log` reads the SHARED ~/config/log.env; `config list log.session`
# must read the PER-USER ~/.config/oosh/log.session.env. Read-only fallback:
# a name present only in the per-user tier resolves there; delete/edit/save
# semantics (which operate on $CONFIG_PATH) are unaffected.
test.config.listReadsPerUserTier() {
  local fx out
  fx=$(test.suite.fixture.make test.config.listReadsPerUserTier); mkdir -p "$fx/.config/oosh"
  printf '%s\n' 'export LOG_NAME="t42@host"' 'export LOG_DEVICE="/dev/pts/9"' > "$fx/.config/oosh/log.session.env"
  out=$(export HOME="$fx"; config.list log.session 2>/dev/null)
  rm -rf "$fx"
  if printf '%s' "$out" | grep -q 'LOG_NAME="t42@host"'; then
    create.result 0 "config list log.session reads per-user tier"
  else
    create.result 1 "config list log.session returned: $out"
  fi
}
test.case - "T42: config.list reads per-user ~/.config/oosh by name" \
  test.config.realSessionUntouched test.config.listReadsPerUserTier
expect 0 "config list log.session reads per-user tier" \
  "config list <name> falls back to the per-user ~/.config/oosh tier"

# ============================================================================
# T43: config.list.completion.name offers names from BOTH tiers
# ============================================================================
test.config.completionOffersPerUser() {
  local fx out
  fx=$(test.suite.fixture.make test.config.completionOffersPerUser); mkdir -p "$fx/.config/oosh"
  : > "$fx/.config/oosh/log.session.env"
  out=$(export HOME="$fx"; config.list.completion.name 2>/dev/null)
  rm -rf "$fx"
  if printf '%s\n' "$out" | grep -qx "log.session"; then
    create.result 0 "completion offers log.session"
  else
    create.result 1 "completion names: $(printf '%s' "$out" | tr '\n' ' ')"
  fi
}
test.case - "T43: config list completion offers per-user names" \
  test.config.realSessionUntouched test.config.completionOffersPerUser
expect 0 "completion offers log.session" \
  "config.list.completion.name enumerates the per-user ~/.config/oosh tier"

# ============================================================================
# T44: no code reads OOSH_USER_CONFIG_PATH — the per-user dir is $HOME/.config/oosh
# ============================================================================
# OOSH_USER_CONFIG_PATH was a constant pretending to be a setting: always
# "$HOME/.config/oosh", defaulted in four places, saved into the shared oosh.env
# only so log.env's last line could use it — which is also why oosh.env had to
# be chained BEFORE log.env. Removed 2026-10-01: code and log.env spell
# $HOME/.config/oosh. Only these places may still name it: the never-persist list
# in config (an old shell may still export it), the log.env migration, which
# rewrites a host's old chain line, and config.init.env's list of retired names
# an old user.env may carry (both marked "legacy-chain").
test.config.noUserConfigPathVar() {
  [ "$(type -t ogit.repo.grep)" = function ] || private.this.script.load ogit ogit.branch.get
  local left
  left=$(ogit.repo.grep 'OOSH_USER_CONFIG_PATH' "$OOSH_DIR" ':!docs' ':!test' ':!sessions' ':!old' ':!restore' ':!*.md' \
    | grep -v 'legacy-chain' | grep -vE '^config:[0-9]+: +\*INSTALL\*\|')
  if [ -z "$left" ]; then
    create.result 0 "no code reads OOSH_USER_CONFIG_PATH"
  else
    create.result 1 "still read: $(printf '%s\n' "$left" | cut -d: -f1,2 | tr '\n' ' ')"
  fi
  return $(result)
}
test.case $level "T44: no code reads OOSH_USER_CONFIG_PATH; the per-user dir is \$HOME/.config/oosh" test.config.noUserConfigPathVar
expect 0 "no code reads OOSH_USER_CONFIG_PATH" \
  "it was always \$HOME/.config/oosh — a constant pretending to be a setting"

# ============================================================================
# T46: sourcing a generated log.env LOADS the per-user session values
# ============================================================================
# End-to-end: generate config into a fixture, write a per-user session file with
# a custom LOG_NAME, then source the generated log.env with HOME pointed at the
# fixture — the custom LOG_NAME must come through the chain.
test.config.logEnvLoadsSession() {
  local fx="/tmp/test.config.chain.$(id -u).$$"; mkdir -p "$fx/.config/oosh"
  # generate a shared config (incl. log.env with the session chain line) into $fx
  bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export HOME="'"$fx"'" CONFIG_PATH="'"$fx"'" CONFIG_FILE=user.env CONFIG="'"$fx"'/user.env"
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
  ' >/dev/null 2>&1
  # a per-user session file with a distinctive LOG_NAME
  printf '%s\n' 'export LOG_NAME="chained@fixturehost"' > "$fx/.config/oosh/log.session.env"
  # source the generated log.env with the chain resolving into the fixture HOME
  local got
  got=$(bash -c '
    export HOME="'"$fx"'"
    . "'"$fx"'/log.env" 2>/dev/null
    echo "$LOG_NAME"
  ' 2>/dev/null)
  rm -rf "$fx"
  if [ "$got" = "chained@fixturehost" ]; then
    create.result 0 "log.env chain loaded LOG_NAME"
  else
    create.result 1 "LOG_NAME after sourcing log.env: '$got'"
  fi
}
test.case - "T46: sourcing generated log.env loads per-user session values" \
  test.config.logEnvLoadsSession
expect 0 "log.env chain loaded LOG_NAME" \
  "the log.env session chain actually loads the per-user LOG_NAME at shell init"

# ============================================================================
# T47: a GENERATED user.env sources cleanly under every POSIX shell (POSIX `.`, no `source`)
# ============================================================================
# user.env and its chain must parse under dash/ash (/bin/sh login shells, `ossh exec` on
# Debian). The env files it sources therefore must use POSIX `.`, not the bash
# `source` builtin. Generate a full config and source the resulting user.env
# (which chains oosh.env/log.env, and log.env chains log.session.env) under
# every POSIX shell this host has — like T77. `sh` is on every platform (dash on
# Debian/Ubuntu, busybox ash on Alpine, bash in POSIX mode on AlmaLinux and
# macOS), so the case always asserts: a host without dash used to score a
# skip as a pass (docs/test-suite.md: a skip is indistinguishable from a pass).
test.config.dashSourcesGeneratedUserEnv() {
  # HOME is the fixture: user.env writes the anchors as the "$HOME/…" constants
  # (T-CONFIG-SAVE-ANCHORS-CONSTANT), so the chain resolves inside HOME and never
  # reaches the real ~/config. config save creates the session file itself.
  local fx shellBin bin out bad="" ran=""
  fx=$(test.suite.fixture.make test.config.dashSourcesGeneratedUserEnv); mkdir -p "$fx/config"
  bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export HOME="'"$fx"'" CONFIG_PATH="'"$fx"'/config" CONFIG_FILE=user.env CONFIG="'"$fx"'/config/user.env"
    export OOSH_MODE=dev
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
  ' >/dev/null 2>&1
  for shellBin in sh dash ash busybox; do
    bin=$(command -v "$shellBin" 2>/dev/null) || continue
    [ "$shellBin" = "busybox" ] && bin="$bin sh"
    ran="$ran $shellBin"
    out=$(HOME="$fx" $bin -c '
      . "$HOME/config/user.env"
      echo "MODE=[$OOSH_MODE]"
    ' 2>&1)
    if echo "$out" | grep -q "not found"; then
      bad="$bad $shellBin-choked(bashism?)=[$out]"
    elif ! echo "$out" | grep -q 'MODE=\[dev\]'; then
      bad="$bad $shellBin-unexpected=[$out]"
    fi
  done
  rm -rf "$fx"
  [ -n "$ran" ] || bad=" no-sh-on-PATH"
  if [ -z "$bad" ]; then
    create.result 0 "every POSIX shell sourced the generated chain cleanly"
  else
    create.result 1 "generated env files:$bad"
  fi
}
test.case - "T47: generated user.env sources cleanly under every POSIX shell of this host" \
  test.config.dashSourcesGeneratedUserEnv
expect 0 "every POSIX shell sourced the generated chain cleanly" \
  "generated env files use POSIX . so dash/ash shells can source them"

# ============================================================================
# T48: config.list (per-user tier) does NOT mutate the global $CONFIG
# ============================================================================
# The per-user fallback must resolve read-only via private.config.file.resolve;
# it must never leave $CONFIG repointed at the per-user file for the rest of the
# shell (which would make a later config.add/clean append to / rm the wrong file).
test.config.listNoGlobalMutation() {
  local fx out
  fx=$(test.suite.fixture.make test.config.listNoGlobalMutation); mkdir -p "$fx/.config/oosh"
  printf 'export LOG_NAME="t48@h"\n' > "$fx/.config/oosh/log.session.env"
  # config.list runs in THIS (sub)shell, not in a $( ) of its own: a mutation of
  # $CONFIG must be visible to the comparison after it.
  out=$( export HOME="$fx"; before="$CONFIG"
         config.list log.session >/dev/null 2>&1
         [ "$CONFIG" = "$before" ] && echo same || echo "before=$before after=$CONFIG" )
  rm -rf "$fx"
  if [ "$out" = "same" ]; then
    create.result 0 "\$CONFIG unchanged after config.list log.session"
  else
    create.result 1 "\$CONFIG mutated: $out"
  fi
}
test.case - "T48: config.list per-user view does not mutate \$CONFIG" \
  test.config.realSessionUntouched test.config.listNoGlobalMutation
expect 0 "\$CONFIG unchanged after config.list log.session" \
  "config.list resolves the per-user tier read-only (no global side effect)"

# ============================================================================
# T49 (callers fall back when boot is absent) is test/test.ossh T-OSSH-REMOTE-PRELUDE now:
# the one prelude every non-interactive caller uses carries the fallback (dev.config Round 4).

# ============================================================================
# T69: test.tilde runs from a CLEAN ENVIRONMENT
# ============================================================================
# 815d14d gave test/test.tilde `#!/usr/bin/env -iS HOME=${HOME} bash` — the
# sibling commit to 8c277f4, which did the same for init/oosh. 075b4a3 removed
# that shebang from BOTH (BusyBox `env` has no -S) and nothing replaced the
# guarantee. init/oosh got it back as an in-file re-exec (the OOSH_CLEAN_ENV block);
# test.tilde did not, and has since inherited whatever the caller happened to
# have.
#
# It passes either way — which is exactly the problem. A test whose entire
# subject is `~` versus $HOME, run with an arbitrary inherited environment, is
# green for a reason unrelated to what it asserts. Same shape as a mode check
# that never looked at the mode.
#
# Pinned here, all observable from OUTSIDE the file:
#   1. a variable planted by the caller does NOT survive into it;
#   2. the re-exec really happened;
#   3. the sentinel is HONOURED — preset, the file must NOT re-exec. That is
#      what makes an exec loop impossible, and it is asserted rather than
#      assumed. Every invocation is wrapped in `timeout` where available, so a
#      regression that DOES loop fails this test instead of hanging the suite.
#   4. it still does its actual job, and still exits 0.
test.config.tildeRunsInCleanEnvironment() {
  local tilde="$OOSH_DIR/test/test.tilde" out cleanOut rc bad="" to="" tmp
  # The child now sources this + test.suite and saves ITS results to
  # $CONFIG_PATH/testresult.env — give it a throwaway one, never the parent's.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t69.XXXXXX") || { create.result 1 "mktemp failed"; return $(result); }
  command -v timeout >/dev/null 2>&1 && to="timeout 20"
  if [ ! -x "$tilde" ]; then
    rm -rf "$tmp"
    create.result 1 "$tilde is not executable — test.suite runs it as a bare \$file (kernel exec)"
    return $(result)
  fi
  bash -n "$tilde" 2>/dev/null || bad="$bad lint:$(bash -n "$tilde" 2>&1 | head -1)"

  # 1 + 2 — plant a canary; it must not survive, and the sentinel must be set.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CANARY=leaked OOSH_TILDE_CLEAN_ENV= $to "$tilde" 1 2>&1); rc=$?
  cleanOut="$out"
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc"
  case "$out" in
    *"Environment                                : clean, canary absent"*) : ;;
    *INHERITED*) bad="$bad canary-survived (test.tilde did not re-exec with env -i — the 075b4a3 regression)" ;;
    *) bad="$bad no-environment-line:$(echo "$out" | head -1)" ;;
  esac

  # 3 — sentinel honoured: preset, it must NOT re-exec (so the canary DOES
  #     survive) and must still terminate.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CLEAN_ENV=1 OOSH_TILDE_CANARY=leaked $to "$tilde" 1 2>&1); rc=$?
  if [ "$rc" -eq 124 ]; then
    bad="$bad sentinel-LOOPED (timed out — the re-exec guard does not stop)"
  else
    [ "$rc" -eq 0 ] || bad="$bad sentinel-rc=$rc"
    case "$out" in
      *INHERITED*) : ;;
      *"clean, canary absent"*) bad="$bad sentinel-ignored (it re-execs even when already clean; nothing but luck prevents a loop)" ;;
      *) bad="$bad sentinel-check-inconclusive (no Environment line at all)" ;;
    esac
  fi

  # 4 — it must still be the test it was: on the CLEAN run, its own assertions
  #     ran through the framework and none failed.
  case "$cleanOut" in
    *"T-TILDE-HOME"*"T-TILDE-FILE-TEST"*) : ;;
    *) bad="$bad tilde-assertions-missing:$(echo "$cleanOut" | tr '\n' ' ' | cut -c1-120)" ;;
  esac
  case "$cleanOut" in
    *"✗ FAIL"*) bad="$bad tilde-assertion-failed:$(echo "$cleanOut" | grep -F "✗ FAIL" | head -1 | cut -c1-100)" ;;
  esac
  rm -rf "$tmp"

  if [ -z "$bad" ]; then
    create.result 0 "test.tilde runs clean and cannot loop"
  else
    create.result 1 "test.tilde clean-environment guarantee broken —$bad"
  fi
  return $(result)
}
test.case - "T69: test/test.tilde runs from a clean environment and cannot loop" \
  test.config.tildeRunsInCleanEnvironment
expect 0 "test.tilde runs clean and cannot loop" \
  "a tilde test that inherits the caller's environment is green for the wrong reason"

# ============================================================================
# T71: a generated config does not carry OOSH_BRANCH into the next shell
# ============================================================================
# The drift loop, end to end. oosh.env seeds a shell with OOSH_BRANCH; that
# shell reaches a config save; the save writes OOSH_BRANCH straight back. On
# this host it has been saying "prod" against a dev checkout for weeks, which
# makes private.oo.install.branch.get — "the one rule behind state 31, state 34
# and oo boot.fix" — answer prod on a dev box.
#
# OOSH_BRANCH is the install INPUT: the branch the operator asked for. It is
# meaningful for the length of one install and meaningless afterwards, so it
# must not survive into a shell. The branch a box is ON is derived from the
# checkout, never remembered.
test.config.branchIsInputNotState() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t71.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out
  # Generate a config from a shell that carries the install input, then source
  # the generated chain in a CLEAN child and ask what it inherited.
  out=$(env -i PATH="$PATH" HOME="$fixture" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
            OOSH_BRANCH=prod OOSH_MODE=dev \
        bash -c '
          mkdir -p "$HOME/.config/oosh"; : > "$HOME/.config/oosh/log.session.env"
          source "$OOSH_DIR/this" >/dev/null 2>&1
          source "$OOSH_DIR/config" >/dev/null 2>&1
          : > "$CONFIG"; config.save >/dev/null 2>&1
          grep -h OOSH_BRANCH "$CONFIG_PATH"/*.env 2>/dev/null | tr -d " \t"
        ')
  rm -rf "$fixture" 2>/dev/null

  if [ -n "$out" ]; then
    create.result 1 "the install input was persisted into the config: [$out]"
  else
    create.result 0 "OOSH_BRANCH is install input and never reaches the config"
  fi
  return $(result)
}
test.case - "T71: config.save does not persist the install input OOSH_BRANCH" \
  test.config.branchIsInputNotState
expect 0 "OOSH_BRANCH is install input and never reaches the config" \
  "persisting it closes a loop that never consults the checkout — the T7 drift"

# ============================================================================
# T72: config.init honours the anchor it was given, and defaults when given none
# ============================================================================
# config.init did an UNCONDITIONAL `export CONFIG_PATH=~/config`, and
# config.start re-runs it whenever $CONFIG is not a file — so any fixture was
# undone from inside the file under test. That is why test.config and
# test.completion.audit had to declare TEST_SHARED_TIER_WRITER instead of
# isolating: they source `config`, and sourcing it moved the anchor back.
#
# The conditional form is not a bend of the anchor rule, it is the rule:
# private.this.anchor.validate.one classifies `: ${CONFIG_PATH:=~/config}` as
# CONFORMING, and `this`, `log` and `ossh` already use exactly that shape for
# this exact variable.
test.config.initHonoursGivenAnchor() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t72.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local given defaulted
  # (a) given an anchor, keep it
  given=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
          bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                   source "$OOSH_DIR/config" >/dev/null 2>&1
                   config.init >/dev/null 2>&1
                   printf "%s|%s" "$CONFIG_PATH" "$CONFIG"')
  # (b) given none, produce the constant
  defaulted=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                       source "$OOSH_DIR/config" >/dev/null 2>&1
                       config.init >/dev/null 2>&1
                       printf "%s" "$CONFIG_PATH"')
  rm -rf "$fixture" 2>/dev/null

  if [ "${given%%|*}" != "$fixture" ]; then
    create.result 1 "config.init clobbered the anchor it was given: [${given%%|*}] wanted [$fixture]"
  elif [ "${given#*|}" != "$fixture/user.env" ]; then
    create.result 1 "\$CONFIG did not follow the given anchor: [${given#*|}]"
  elif [ "$defaulted" != "$HOME/config" ]; then
    create.result 1 "with no anchor given, config.init did not produce \$HOME/config: [$defaulted]"
  else
    create.result 0 "config.init honours a given anchor and defaults to the constant"
  fi
  return $(result)
}
test.case - "T72: config.init keeps an inherited CONFIG_PATH and still defaults to ~/config" \
  test.config.initHonoursGivenAnchor
expect 0 "config.init honours a given anchor and defaults to the constant" \
  "config.start re-runs config.init, so an unconditional export undoes a fixture from inside"

# ============================================================================
# T73: config validate required — names what is missing, and reports drift
# ============================================================================
# The card asks for two things this tree had neither of: a declared set of
# variables a config must carry for a branch version, and something that
# notices when the persisted branch disagrees with the checkout.
#
# config.init only ever created a directory and three variables, so on a
# missing config it succeeded emptily. config.validate checks line SHAPE and
# knows no variable name at all. config.init.check never opens an env file.
test.config.requiredFixture() { # <dir> <oosh-branch> <?omit> # a config tier plus a ~/oosh symlink on <oosh-branch>
  local dir="$1" branch="$2" omit="$3"
  mkdir -p "$dir/home" "$dir/base/$branch"
  ln -sfn "$dir/base/$branch" "$dir/home/oosh"
  printf 'export BASH_FILE="/usr/bin/bash"\nexport CONFIG_FILE="user.env"\n' > "$dir/user.env"
  printf 'export LOG_LEVEL="1"\n' > "$dir/log.env"
  [ "$omit" = "omit" ] && return 0
  printf 'export OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' > "$dir/oosh.env"
  # OOSH_MODE is per user: the user's own ~/.config/oosh/oosh.session.env.
  mkdir -p "$dir/home/.config/oosh"
  printf 'export OOSH_MODE="%s"\n' "${4:-$branch}" > "$dir/home/.config/oosh/oosh.session.env"
}

test.config.requiredRun() { # <dir> # run `config validate required` against <dir> in a pinned child; echo "rc|verdict"
  local out rc
  out=$(env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
        bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                 source "$OOSH_DIR/config" >/dev/null 2>&1
                 config.validate.required 2>/dev/null'); rc=$?
  printf '%s|%s' "$rc" "$(printf '%s' "$out" | tr '\n' ' ')"
}

test.config.validateRequired() {
  local base; base=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t73.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }

  test.config.requiredFixture "$base/ok" dev
  local ok; ok=$(test.config.requiredRun "$base/ok")

  test.config.requiredFixture "$base/gone" dev omit          # no oosh.env at all
  local gone; gone=$(test.config.requiredRun "$base/gone")

  test.config.requiredFixture "$base/drift" dev "" prod      # persisted prod, checkout dev
  local drift; drift=$(test.config.requiredRun "$base/drift")
  rm -rf "$base" 2>/dev/null

  if [ "${ok%%|*}" != "0" ]; then
    create.result 1 "a complete config was rejected: [$ok]"
  elif [ "${gone%%|*}" = "0" ]; then
    create.result 1 "a config with no oosh.env was accepted — succeeding emptily is the bug"
  elif [ "${gone#*OOSH_MODE}" = "$gone" ] || [ "${gone#*OOSH_PM}" = "$gone" ]; then
    create.result 1 "the missing variables were not all named: [$gone]"
  elif [ "${drift%%|*}" = "0" ]; then
    create.result 1 "persisted prod against a dev checkout was accepted: [$drift]"
  elif [ "${drift#*prod}" = "$drift" ] || [ "${drift#*dev}" = "$drift" ]; then
    create.result 1 "the drift report names neither side: [$drift]"
  else
    create.result 0 "missing variables are named and branch drift is reported"
  fi
  return $(result)
}
test.case - "T73: config validate required names every missing variable and reports branch drift" \
  test.config.validateRequired
expect 0 "missing variables are named and branch drift is reported" \
  "config.init succeeded emptily on a missing config, and nothing compared the persisted branch to the checkout"

# ============================================================================
# T75: config.save survives a bash-3.2 `declare -p` stream
# ============================================================================
# THE BUG THIS PINS (docs/research/2026-09-17-config-save-bash32.md):
# on macOS /bin/bash 3.2.57, `declare -p` with NO NAMES is `set`-style — no
# `declare -x` prefix — and it ALSO prints every function body, verbatim and
# multi-line, into the same stream config.save filters. The filter derived a
# "variable name" with three string-strips and never checked it was one, so a
# function-body line with no `=` survived `${_vn%%=*}` whole and glob-matched
# `OOSH_*`. Rows of private.config.required.variables.get's heredoc became
# lines in ~/config/oosh.env, and every login printed
# "OOSH_MODE: command not found".
#
# Linux runs bash 5, where `declare -p` prints no functions — so this cannot
# be reproduced here, it has to be INJECTED. A shell function shadows a
# builtin, so the stub below reproduces 3.2's BROKEN no-argument output while
# delegating the CORRECT named form (`declare -p NAME`, measured right on 3.2)
# to the real builtin. Same move as T28's fixture, but wired to the real code
# path instead of to a grep.
test.config.bash32Save() { # <fixture> # run config.save under a simulated bash-3.2 `declare -p`; echo the file it generated
  (
    declare() {
      if [ "$1" = "-p" ] && [ $# -eq 1 ]; then
        # The four lines that really landed on the VM.
        printf '%s\n' "OOSH_PM='brew install'" \
                      "OOSH_PROMPT='oosh '" \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      'OOSH_OS oosh.env $OSTYPE, via os'
        return 0
      fi
      builtin declare "$@"
    }
    export OOSH_PM="brew install" OOSH_PROMPT="oosh "
    CONFIG_PATH="$1" CONFIG_FILE="bash32.env" CONFIG="$1/bash32.env" \
      config.save bash32 OOSH >/dev/null 2>&1
    cat "$1/bash32.env" 2>/dev/null
  )
}
test.config.saveSurvivesBash32Stream() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.bash32.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }
  local generated; generated=$(test.config.bash32Save "$fixture")
  rm -rf "$fixture" 2>/dev/null

  local junk unexported total
  # A junk row is NAME followed by a FILENAME — never an assignment. Anchoring
  # on "a word then a space" alone was wrong: `export OOSH_MODE="released"` is
  # also a word then a space, so the first version of this check failed on the
  # CORRECT output. Watched failing both ways, which is the point.
  junk=$(printf '%s\n' "$generated" | grep -c -E '^(export )?[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[a-z]+\.env[[:space:]]' 2>/dev/null)
  total=$(printf '%s\n' "$generated" | grep -c -E '[^[:space:]]' 2>/dev/null)
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if [ "${total:-0}" = "0" ]; then
    create.result 1 "config.save wrote nothing at all"
  elif [ "${junk:-0}" != "0" ]; then
    create.result 1 "$junk function-body row(s) were written as if they were variables: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported line(s) carry no 'export' — the sed cannot match bash 3.2 output: [$generated]"
  elif ! printf '%s\n' "$generated" | grep -q 'OOSH_PM='; then
    create.result 1 "OOSH_PM did not survive the save: [$generated]"
  else
    create.result 0 "every generated line is an export assignment"
  fi
  return $(result)
}
test.case - "T75: config.save survives a bash-3.2 declare -p stream" \
  test.config.saveSurvivesBash32Stream
expect 0 "every generated line is an export assignment" \
  "bash 3.2 declare -p is set-style AND dumps function bodies — rows of the required-variables table became lines in oosh.env"

# ============================================================================
# T76: private.config.variables.list emits variable NAMES, never anything else
# ============================================================================
# The unit-level pin for the shape gate. compgen -v can only produce valid
# identifiers, so the gate is belt-and-braces in production — this drives it
# directly, with compgen stubbed, which is the only way to see it work.
test.config.variablesListShapeGate() {
  local listed
  listed=$(
    compgen() {
      if [ "$1" = "-v" ]; then
        printf '%s\n' 'OOSH_TEST_MODE' \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      '9BAD' 'OOSH-DASH'
        return 0
      fi
      builtin compgen "$@"
    }
    private.config.variables.list OOSH 2>/dev/null
  )
  if [ "$listed" = "OOSH_TEST_MODE" ]; then
    create.result 0 "only a valid variable name survives the gate"
  else
    create.result 1 "expected just OOSH_TEST_MODE, got: [$listed]"
  fi
  return $(result)
}
test.case - "T76: private.config.variables.list returns names, not whatever starts with the prefix" \
  test.config.variablesListShapeGate
expect 0 "only a valid variable name survives the gate" \
  "the old filter took three string-strips as a variable name and never checked it was one"

# ============================================================================
# T77: private.config.variable.export.line — fidelity, and the dash promise
# ============================================================================
# The value must survive a round trip through EVERY shell that sources the
# generated file. these files are sourced by /bin/sh on Debian login shells,
# so bash alone is not enough (review-2026-09-09 § D1). Every character the
# writer accepts round-trips; a command substitution `$(…)` or a backtick is
# refused, because config.validate rejects any line holding one (env files are
# pure data, the validator gets no exception — T-CONFIG-WRITER-VALIDATOR-AGREE).
test.config.exportLineRoundTrip() {
  export OOSH_T77='a    b $HOME ${x} (y) "q" '"'"'s'"'"' back\slash'
  local line; line=$(private.config.variable.export.line OOSH_T77 2>/dev/null)
  case "$line" in
    export\ OOSH_T77=*) ;;
    *) create.result 1 "not an export line: [$line]"; return $(result) ;;
  esac

  # Every available POSIX shell must reproduce the value byte for byte.
  local shellBin bin got broken=""
  for shellBin in sh dash ash bash busybox; do
    bin=$(command -v "$shellBin" 2>/dev/null) || continue
    [ -n "$bin" ] || continue
    if [ "$shellBin" = "busybox" ]; then bin="$bin sh"; fi
    got=$($bin -c "$line"'; printf %s "$OOSH_T77"' 2>/dev/null)
    [ "$got" = "$OOSH_T77" ] || broken="$broken $shellBin"
  done
  if [ -n "$broken" ]; then
    create.result 1 "the value did not survive:$broken — line was [$line]"
    return $(result)
  fi

  # A value carrying a NEWLINE cannot go into a line-oriented file, whatever
  # quoting bash picks for it — config.validate reads these one line at a time.
  #
  # THIS ASSERTION EARNED ITS KEEP on 2026-09-18: it went red on almalinux 9
  # during `oo stage testing` while passing on the host, ubuntu 24.04 and
  # macOS. The guard in config tested bash's RENDERING (`$'…'`) rather than the
  # value, and `$'…'` is a bash >= 5.2 behaviour — bash 5.1 emits a
  # double-quoted string with a literal newline in it, measured identically on
  # almalinux 9 (5.1.8), ubuntu 22.04 (5.1.16) and debian 11 (5.1.4). So the
  # guard caught nothing on any bash 5.1 and a two-line assignment was written
  # into oosh.env. Keep BOTH shapes below: they differ only in which bash
  # renders them which way, which is exactly the axis that hid the defect.
  export OOSH_T77_MULTI="line1
line2"
  export OOSH_T77_CR="a$(printf '\r')b"
  local multi multiRc cr crRc
  multi=$(private.config.variable.export.line OOSH_T77_MULTI 2>/dev/null); multiRc=$?
  cr=$(private.config.variable.export.line OOSH_T77_CR 2>/dev/null); crRc=$?
  # An array has no single-line export form.
  OOSH_T77_ARR=(a b)
  local arr arrRc
  arr=$(private.config.variable.export.line OOSH_T77_ARR 2>/dev/null); arrRc=$?
  # An unset name is not an error to report, just nothing to write.
  local gone goneRc
  gone=$(private.config.variable.export.line OOSH_T77_NEVER_SET 2>/dev/null); goneRc=$?
  # Command substitution and backtick: bash would escape them, the validator
  # rejects them anyway — the writer gives way.
  export OOSH_T77_SUBST='a$(b)c' OOSH_T77_TICK='a`b`c'
  local subst substRc tick tickRc
  subst=$(private.config.variable.export.line OOSH_T77_SUBST 2>/dev/null); substRc=$?
  tick=$(private.config.variable.export.line OOSH_T77_TICK 2>/dev/null); tickRc=$?
  unset OOSH_T77 OOSH_T77_MULTI OOSH_T77_CR OOSH_T77_ARR OOSH_T77_SUBST OOSH_T77_TICK

  if [ "$multiRc" = "0" ] || [ -n "$multi" ]; then
    create.result 1 "a newline-bearing value was written as [$multi] — a line-oriented file cannot hold it, whatever quoting bash picked"
  elif [ "$crRc" = "0" ] || [ -n "$cr" ]; then
    create.result 1 "a carriage-return value was written as [$cr]"
  elif [ "$arrRc" = "0" ] || [ -n "$arr" ]; then
    create.result 1 "an array was written as [$arr]"
  elif [ "$goneRc" = "0" ] || [ -n "$gone" ]; then
    create.result 1 "an unset name produced [$gone]"
  elif [ "$substRc" = "0" ] || [ -n "$subst" ]; then
    create.result 1 "a command substitution was written as [$subst]"
  elif [ "$tickRc" = "0" ] || [ -n "$tick" ]; then
    create.result 1 "a backtick was written as [$tick]"
  else
    create.result 0 "the value round-trips through every shell, and the unwritable cases are refused"
  fi
  return $(result)
}
test.case - "T77: private.config.variable.export.line round-trips through every POSIX shell" \
  test.config.exportLineRoundTrip
expect 0 "the value round-trips through every shell, and the unwritable cases are refused" \
  "dash/ash shells source these files — a bash-only rendering breaks Debian login shells"

# ============================================================================
# T78: a trailing "_" in the prefix does not silence the sweep
# ============================================================================
# `backup config.save global` passes BACKUP_ (backup.config.save). The old gate was
# `${name}|${name}_*` — with the underscore already there that reads
# `BACKUP_|BACKUP__*`, which BACKUP_TARGET matches neither, so backup.env has
# been written empty all along.
test.config.variablesListTrailingUnderscore() {
  export BACKUP_TARGET="/some/where"
  local listed; listed=$(private.config.variables.list BACKUP_ 2>/dev/null)
  unset BACKUP_TARGET
  if printf '%s\n' "$listed" | grep -qx 'BACKUP_TARGET'; then
    create.result 0 "a trailing underscore in the prefix is tolerated"
  else
    create.result 1 "BACKUP_ found nothing; BACKUP_TARGET was set. got: [$listed]"
  fi
  return $(result)
}
test.case - "T78: config.save prefix tolerates a trailing underscore" \
  test.config.variablesListTrailingUnderscore
expect 0 "a trailing underscore in the prefix is tolerated" \
  "backup passes BACKUP_ and has been writing an empty backup.env ever since"

# The four placeholder cases `oo method.new` generated for
# private.config.variables.list / .variable.export.line / .variables.export /
# .string.upper were removed here, deliberately: all four are GETTERS consumed
# as $(...), so none calls create.result, and the template's
# `expect 0 "<result>"` would have compared whatever $RESULT the PREVIOUS test
# left behind — a test that cannot fail, which is the exact defect the
# "Tests that cannot fail" card is about. Their real coverage is T75-T78 above.
#
# templates/code/newMethodTest assumes a create.result method. A getter needs a
# different shape (assert on stdout, not on $RESULT). Recorded as a card —
# there is no newGetterTest template and this is not the last getter the tree
# will grow.

# ============================================================================
# T79: every generated line is an export assignment, and a one-argument
#      `config save <file>` derives its prefix without ${var^^}
# ============================================================================
# A REGRESSION GUARD, not a red-first test, and labelled so: on bash 5 the old
# code already produced export lines, and `${file^^}` already worked. Both
# halves fail only on macOS /bin/bash 3.2 — the first silently (no `export` on
# any line), the second fatally (a "bad substitution" that EXITS the shell).
# This pins the shapes so the fix cannot quietly come undone.
test.config.saveShapeAndPrefix() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.shape.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }

  # The upper-caser itself.
  local upper; upper=$(private.config.string.upper "myApp")
  if [ "$upper" != "MYAPP" ]; then
    rm -rf "$fixture" 2>/dev/null
    create.result 1 "private.config.string.upper myApp gave [$upper]"
    return $(result)
  fi

  # One argument: `config save myapp` must derive MYAPP and harvest MYAPP_*.
  export MYAPP_TOKEN="a value with spaces"
  (
    CONFIG_PATH="$fixture" CONFIG_FILE="myapp.env" CONFIG="$fixture/myapp.env" \
      config.save myapp >/dev/null 2>&1
  )
  local generated; generated=$(cat "$fixture/myapp.env" 2>/dev/null)
  unset MYAPP_TOKEN
  rm -rf "$fixture" 2>/dev/null

  local unexported
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if ! printf '%s\n' "$generated" | grep -q '^export MYAPP_TOKEN='; then
    create.result 1 "the one-argument form derived no prefix: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported generated line(s) are not export assignments: [$generated]"
  else
    create.result 0 "the prefix is derived and every line is an export assignment"
  fi
  return $(result)
}
test.case - "T79: config save <file> derives its prefix, and writes only export lines" \
  test.config.saveShapeAndPrefix
expect 0 "the prefix is derived and every line is an export assignment" \
  "on bash 3.2 the derivation was a fatal bad substitution and no line ever carried export"

# ============================================================================
# T80: every required-variable row has a deriver, and each one answers
# ============================================================================
# F6. private.config.required.variables.get declares "<variable> <file> <how it
# is re-derived>" and NOTHING read the third column — documentation of a repair
# that did not exist. That is why config.init.env could not repair, and why the
# macOS VM oscillated: OOSH_MODE present and OOSH_OS gone one hour, the reverse
# the next, depending only on which shell last wrote the file.
# See docs/research/2026-09-17-config-save-bash32.md §§ 6-8.
test.config.deriversAnswer() {
  local fixture; fixture=$(test.suite.fixture.make test.config.derive) \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/home" "$fixture/base/dev"
  ln -sfn "$fixture/base/dev" "$fixture/home/oosh"

  local mode os level cfgFile bashFile
  mode=$(HOME="$fixture/home" private.config.derive.oosh.mode 2>/dev/null)
  os=$(private.config.derive.oosh.os 2>/dev/null)
  # LOG_LEVEL is set to 1 by the suite itself, and the deriver correctly lets an
  # already-chosen level win. Unset it to exercise the FALLBACK, which is the
  # half the table got wrong: it said "defaults to 1" and both this (its
  # file-scope default) and log.init use 3.
  level=$( unset LOG_LEVEL; private.config.derive.log.level 2>/dev/null )
  cfgFile=$(private.config.derive.config.file 2>/dev/null)
  bashFile=$(private.config.derive.bash.file 2>/dev/null)
  rm -rf "$fixture" 2>/dev/null

  if [ "$mode" != "dev" ]; then
    create.result 1 "oosh.mode derived [$mode], expected 'dev' — it is the basename of the canonical ~/oosh"
  elif [ -z "$os" ]; then
    create.result 1 "oosh.os derived nothing; os.check.env maps \$OSTYPE and must always answer"
  elif [ "$level" != "3" ]; then
    create.result 1 "log.level derived [$level], expected 3 — the table said 1, but the LOG_LEVEL default of this and log.init's both are 3"
  elif [ "$cfgFile" != "user.env" ]; then
    create.result 1 "config.file derived [$cfgFile], expected user.env"
  elif [ ! -x "${bashFile%% *}" ]; then
    create.result 1 "bash.file derived [$bashFile], which is not executable"
  else
    create.result 0 "every deriver answers"
  fi
  return $(result)
}
test.case - "T80: each required variable has a deriver that answers" \
  test.config.deriversAnswer
expect 0 "every deriver answers" \
  "the table's third column was prose nothing could run — that is why the advertised repair could not repair"

# ============================================================================
# T81: config.init.env RE-DERIVES a missing required variable
# ============================================================================
# F5, reproduced. Measured on a clean macOS VM 2026-09-17: `config validate
# required` said `missing: OOSH_MODE OOSH_OS`, the operator ran the repair it
# advertises, and it came back `missing: OOSH_MODE OOSH_OS OOSH_PM` with
# oosh.env EMPTY. config.save persists the ENVIRONMENT, and the environment is
# populated FROM the config — a closed loop with no source of truth, so a value
# that falls out can never come back.
#
# Where OOSH_MODE survives depends on the layout the gate of the split allows
# (docs/config.md): an open gate chains the user's oosh.session.env from the
# shared oosh.env and OOSH_MODE lives there only; a closed gate keeps the
# transition copy in user.session.env. The gate asks the homes of the host, so
# the test names them (private.config.homes.list): with the real ones, root
# (who can look into every home) got the split and a normal user (who cannot
# look into /root) did not — the same test asserted one layout for both.
test.config.initEnvRederives() { # <dir> <gate:open|closed> # run config.init.env against <dir> with OOSH_OS empty, the gate open (only the own home is linked) or closed (a second linked home without session files); echo the resulting oosh.env
  local homes="$1/home"
  ln -sfn "$1" "$1/home/config"
  if [ "$2" = "closed" ]; then
    mkdir -p "$1/other"; ln -sfn "$1" "$1/other/config"; homes="$homes"$'\n'"$1/other"
  fi
  env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 FX_HOMES="$homes" \
      CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             private.config.homes.list() { printf "%s\n" "$FX_HOMES"; }
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1
  cat "$1/oosh.env" 2>/dev/null
}
test.config.initEnvRepairsMissing() {
  local fx gate base after mode bad=""
  fx=$(test.suite.fixture.make test.config.rederive) \
    || { create.result 1 "mktemp failed"; return $(result); }
  for gate in open closed; do
    base="$fx/$gate"
    # A tier that is complete EXCEPT for OOSH_OS — exactly the VM's state.
    test.config.requiredFixture "$base" dev
    # Remove the one variable. Nothing in a shell re-derives it (os.check.env is
    # never called by boot/this/config), so without a repair it is gone for good.
    grep -v 'OOSH_OS=' "$base/oosh.env" > "$base/oosh.env.tmp" && mv "$base/oosh.env.tmp" "$base/oosh.env"
    after=$(test.config.initEnvRederives "$base" "$gate")
    if [ -z "$after" ]; then
      bad="$bad $gate:oosh.env-EMPTY"
    elif ! printf '%s\n' "$after" | grep -q '^export OOSH_OS='; then
      bad="$bad $gate:OOSH_OS-not-re-derived=[$(printf '%s' "$after" | tr '\n' ' ')]"
    fi
    # The model's place for OOSH_MODE in this layout.
    if [ "$gate" = "open" ]; then
      [ "$(printf '%s\n' "$after" | tail -1)" = '. $HOME/.config/oosh/oosh.session.env' ] || bad="$bad open:oosh.env-not-chaining-oosh.session.env"
      grep -qxF 'export OOSH_MODE="dev"' "$base/home/.config/oosh/oosh.session.env" 2>/dev/null \
        || bad="$bad open:oosh.session.env=[$(tr '\n' ' ' < "$base/home/.config/oosh/oosh.session.env" 2>/dev/null)]"
    else
      printf '%s\n' "$after" | grep -qxF '. $HOME/.config/oosh/oosh.session.env' && bad="$bad closed:oosh.env-chains-before-the-gate-opened"
      grep -qxF 'export OOSH_MODE="dev"' "$base/home/.config/oosh/user.session.env" 2>/dev/null \
        || bad="$bad closed:user.session.env=[$(tr '\n' ' ' < "$base/home/.config/oosh/user.session.env" 2>/dev/null)]"
    fi
    # What counts: a shell started from the repaired config has its branch.
    mode=$(env -i HOME="$base/home" PATH=/usr/bin:/bin bash -c '. "$HOME/config/user.env" >/dev/null 2>&1; printf "%s" "$OOSH_MODE"')
    [ "$mode" = "dev" ] || bad="$bad $gate:shell-OOSH_MODE=[$mode]"
  done
  rm -rf "$fx" 2>/dev/null
  if [ -z "$bad" ]; then
    create.result 0 "the missing variable is re-derived and the surviving ones are kept"
  else
    create.result 1 "the repair lost what it had to keep:$bad"
  fi
  return $(result)
}
test.case - "T81: config.init.env re-derives a missing required variable instead of re-persisting the gap" \
  test.config.initEnvRepairsMissing
expect 0 "the missing variable is re-derived and the surviving ones are kept" \
  "the command config validate required advertises as the repair made the report WORSE on a real machine"

# ============================================================================
# T82: the repair can never leave the report worse than it found it
# ============================================================================
# The guard that would have caught the macOS failure as it happened. A repair
# that cannot repair must leave the tier alone, not overwrite it with less.
test.config.initEnvNeverWorsens() {
  local base; base=$(test.suite.fixture.make test.config.noworsen) \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.config.requiredFixture "$base" dev
  local before; before=$(cat "$base/oosh.env" 2>/dev/null)
  # Point HOME at a home with NO ~/oosh symlink, so oosh.mode cannot derive.
  rm -f "$base/home/oosh"
  env -i PATH="$PATH" HOME="$base/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
      CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1
  local after; after=$(cat "$base/oosh.env" 2>/dev/null)
  local beforeCount afterCount
  beforeCount=$(printf '%s\n' "$before" | grep -c '^export ')
  afterCount=$(printf '%s\n' "$after" | grep -c '^export ')
  rm -rf "$base" 2>/dev/null

  if [ -z "$after" ]; then
    create.result 1 "the repair emptied oosh.env when it could not derive — exactly the macOS failure"
  elif [ "${afterCount:-0}" -lt "${beforeCount:-0}" ]; then
    create.result 1 "the repair lost variables: $beforeCount export lines before, $afterCount after"
  else
    create.result 0 "a repair that cannot repair leaves the tier no worse"
  fi
  return $(result)
}
test.case - "T82: a repair that cannot derive leaves the config no worse than it found it" \
  test.config.initEnvNeverWorsens
expect 0 "a repair that cannot repair leaves the tier no worse" \
  "on the VM the advertised repair went from 2 missing variables to 3, and emptied the file"

# T-CONFIG-INIT-ENV-OLD-USER-ENV: moving OOSH_* out of user.env is the
# migration, not a loss. The 26d15a4-era user.env held seven exports, three of
# them OOSH_*; the model keeps four there, OOSH_DIR in oosh.env, and retired
# OOSH_USER_CONFIG_PATH (2026-10-01) and the OOSH_CONFIG_VERSION stamp. The
# per-file count saw 7 → 4, restored the old user.env and answered rc 1: the
# ubuntu_24_04 26d15a4 heal gate left every user's configLayout red.
test.config.initEnvOldUserEnv() {
  local base rc bad=""
  base=$(test.suite.fixture.make test.config.oldusereenv) || { create.result 1 "mktemp failed"; return $(result); }
  test.config.requiredFixture "$base" dev
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export CONFIG_PATH="$HOME/config"' 'export CONFIG_FILE="user.env"' \
    'export CONFIG="$CONFIG_PATH/$CONFIG_FILE"' 'export OOSH_USER_CONFIG_PATH="$HOME/.config/oosh"' \
    'export OOSH_CONFIG_VERSION="1"' 'export BASH_FILE="/usr/bin/bash"' \
    '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' > "$base/user.env"
  ln -sfn "$base" "$base/home/config"
  env -i PATH="$PATH" HOME="$base/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
      CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
    bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
             source "$OOSH_DIR/config" >/dev/null 2>&1
             config.init.env >/dev/null 2>&1' >/dev/null 2>&1; rc=$?
  [ "$rc" = 0 ] || bad="$bad rc=$rc"
  grep -q '^export OOSH_' "$base/user.env" && bad="$bad user.env-keeps=[$(grep '^export OOSH_' "$base/user.env" | tr '\n' ' ')]"
  for k in CONFIG_PATH CONFIG_FILE CONFIG BASH_FILE; do grep -q "^export $k=" "$base/user.env" || bad="$bad user.env-lost-$k"; done
  grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$base/oosh.env" || bad="$bad oosh.env-no-OOSH_DIR"
  grep -q '^export OOSH_PM=' "$base/oosh.env" || bad="$bad oosh.env-lost-OOSH_PM"
  ls "$base"/user.env.bak.* >/dev/null 2>&1 || bad="$bad no-backup"
  rm -rf "$base" 2>/dev/null
  [ -z "$bad" ] && create.result 0 "the old user.env is migrated: OOSH_DIR in oosh.env, the retired two gone, rc 0, backups kept" || create.result 1 "init.env old user.env:$bad"
  return $(result)
}
test.case - "T-CONFIG-INIT-ENV-OLD-USER-ENV: config init.env moves a 26d15a4-era user.env to the model instead of refusing" \
  test.config.initEnvOldUserEnv
expect 0 "the old user.env is migrated: OOSH_DIR in oosh.env, the retired two gone, rc 0, backups kept" \
  "the per-file count called the migration a loss and restored the old user.env"

# ============================================================================
# T83: config.save reports an invalid file it just wrote — on STDERR
# ============================================================================
# F4. config.save validated what it wrote and threw the verdict away
# (`>/dev/null 2>&1 || warn.log`), which is why card 1's corruption reached a
# user at all: config.validate caught it on the FIRST macOS install and nobody
# heard it.
#
# STDERR, not stdout, and the reason is load-bearing: private.user.init's cache write records
# that `$(user get basehome)` CAPTURES config.save's stdout, and a stray line
# there once propagated a garbage IdentityFile into a generated ssh config and
# failed the downstream git clone. stderr survives every LOG_LEVEL just as well
# and $( ) does not capture it.
#
# config.validate is shadowed rather than a file seeded invalid, because
# config.save REWRITES all three files before validating them — a seeded file
# would simply be replaced. Same technique as T75.
test.config.saveReportsInvalid() {
  local base; base=$(test.suite.fixture.make test.config.f4) \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out err rc
  out=$(
    config.validate() { return 1; }        # every file it writes "fails" validation
    CONFIG_PATH="$base" CONFIG_FILE=user.env CONFIG="$base/user.env" \
      config.save 2>"$base/stderr.txt"
    echo "RC=$?"
  )
  err=$(cat "$base/stderr.txt" 2>/dev/null)
  rc=$(printf '%s' "$out" | sed -n 's/.*RC=\([0-9]*\).*/\1/p')
  # The VERDICT must not be on stdout. NOT "stdout is empty" — the first version
  # of this assertion said that and was wrong: config.save has always written
  # `console.log` to stdout, 0 lines at LOG_LEVEL 1 but 9 at level 3, and the
  # container gate runs test cases above level 1. That is long-standing
  # behaviour which `$(user get basehome)` already defends against by forcing
  # LOG_DEVICE=/dev/null and redirecting (private.user.init's cache write). What card 2 could
  # newly break is putting the VERDICT there, so that is what is pinned.
  local stdoutNoise; stdoutNoise=$(printf '%s' "$out" | grep -c 'INVALID')
  rm -rf "$base" 2>/dev/null

  if [ "${rc:-0}" = "0" ]; then
    create.result 1 "config.save returned 0 after writing a file its own validator rejected"
  elif ! printf '%s\n' "$err" | grep -qE 'INVALID|invalid'; then
    create.result 1 "no verdict on stderr; stderr was: [$(printf '%s' "$err" | tr '\n' ' ')]"
  elif [ "${stdoutNoise:-0}" != "0" ]; then
    create.result 1 "the verdict reached STDOUT ($stdoutNoise line(s)); it belongs on stderr because $(user get basehome) captures stdout"
  else
    create.result 0 "the verdict reaches stderr and the exit status, stdout stays clean"
  fi
  return $(result)
}
test.case - "T83: config.save reports a file it wrote that its own validator rejects" \
  test.config.saveReportsInvalid
expect 0 "the verdict reaches stderr and the exit status, stdout stays clean" \
  "the guard caught card 1's corruption on the first install and the verdict went to /dev/null"

# The six placeholder cases `oo method.new` generated for the
# private.config.derive.* family were removed here, for the same reason as the
# four in card 1: every one of them is a GETTER consumed as $(...), so none sets
# $RESULT, and templates/code/newMethodTest's `expect 0 "<result>"` would have
# compared whatever the PREVIOUS test left behind. Six more tests that cannot
# fail. Their real coverage is T80 above.
#
# This is the second ticket in two days to hit it. The card for a newGetterTest
# template is filed; until it exists, generating a getter means deleting six
# placeholder cases by hand.

# ============================================================================
# T84: a rewrite never drops a required variable the file already carried
# ============================================================================
# Card 3. config.save persists the ENVIRONMENT and truncates with `{ … } >$CONFIG`,
# so a shell that is missing a required variable REWRITES THE FILE WITHOUT IT.
# `oo mode <branch>` is the live example (oo.mode): it sets OOSH_MODE and
# immediately runs `config save oosh OOSH` from that shell — which has OOSH_MODE
# but nothing re-derives OOSH_OS at shell init, so OOSH_OS is dropped.
#
# That is the oscillation measured on the macOS VM across 2026-09-17: OOSH_OS
# present and OOSH_MODE missing at one point, the exact reverse an hour later.
# Card 2 made the config REPAIRABLE; this makes it stop degrading.
#
# Carrying forward is deliberately NOT derivation. Deriving belongs in
# config.init.env (card 2) where it can source `os` and take its time; the
# WRITER only has to refrain from throwing away what it was already holding.
test.config.saveKeepsRequired() {
  local fixture; fixture=$(test.suite.fixture.make test.config.keep) \
    || { create.result 1 "mktemp failed"; return $(result); }
  # A complete oosh.env, as a healthy host has.
  printf 'export OOSH_MODE="dev"\nexport OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' \
    > "$fixture/oosh.env"
  # a switched shared config: OOSH_MODE is per user there
  echo '. $HOME/.config/oosh/user.session.env' > "$fixture/user.env"
  # A shell like the one `oo mode` saves from: OOSH_MODE set, OOSH_OS absent.
  local after
  after=$(
    unset OOSH_OS
    export OOSH_MODE="dev"
    CONFIG_PATH="$fixture" CONFIG_FILE=oosh.env CONFIG="$fixture/oosh.env" \
      config.save oosh OOSH >/dev/null 2>&1
    cat "$fixture/oosh.env" 2>/dev/null
  )
  rm -rf "$fixture" 2>/dev/null

  if printf '%s\n' "$after" | grep -q '^export OOSH_MODE='; then
    create.result 1 "OOSH_MODE is per user and must not land in the shared oosh.env: [$(printf '%s' "$after" | tr '\n' ' ')]"
  elif ! printf '%s\n' "$after" | grep -q '^export OOSH_OS='; then
    create.result 1 "OOSH_OS was in the file and the rewrite dropped it — this is how the VM degraded"
  else
    create.result 0 "a rewrite keeps the required variables the file already carried"
  fi
  return $(result)
}
test.case - "T84: config.save does not drop a required variable the file already had" \
  test.config.saveKeepsRequired
expect 0 "a rewrite keeps the required variables the file already carried" \
  "oo mode saves oosh.env from a shell that has OOSH_MODE and no OOSH_OS, and the file loses OOSH_OS"

# ============================================================================
# T85: the config anchor survives into a GRANDCHILD process
# ============================================================================
# test.suite.config.isolate exports CONFIG_PATH, and a test that reaches a
# subprocess relies on that export surviving. On 2026-09-17 a macOS probe caught
# it NOT surviving: the audit had CONFIG_PATH=<fixture> and `export -p` agreed,
# and the `config` process two levels down had it EMPTY and defaulted to
# ~/config, writing the shared tier (research § 2 / § 5).
#
# That was never reproduced afterwards — see research § 17 for what was ruled
# out — and the chain that produced it no longer runs. But "isolation held the
# last five times I looked" is not a guarantee, and nothing in the suite
# asserted the property at all. This does.
#
# It is deliberately a WRITE test, not a variable-echo test: what matters is not
# that the child can read the anchor but that its writes land in the fixture and
# the real tier is untouched. That is what the canary guards globally and what
# this pins for one explicit, deep call chain.
test.config.anchorSurvivesGrandchild() {
  local fixture; fixture=$(test.suite.fixture.make test.config.anchor) \
    || { create.result 1 "mktemp failed"; return $(result); }
  : > "$fixture/user.env"
  local realTier="${TEST_SUITE_CONFIG_ORIGIN:-$HOME/config}"
  local realBefore realAfter
  realBefore=$(cat "$realTier/oosh.env" 2>/dev/null | cksum)

  # TWO levels: this shell → bash -c → config. The shape the macOS probe caught
  # losing the anchor was audit → oo → config, the same depth.
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    bash -c "\"$OOSH_DIR/config\" save oosh OOSH" >/dev/null 2>&1

  realAfter=$(cat "$realTier/oosh.env" 2>/dev/null | cksum)
  local wroteFixture=0
  [ -s "$fixture/oosh.env" ] && wroteFixture=1
  rm -rf "$fixture" 2>/dev/null

  if [ "$realBefore" != "$realAfter" ]; then
    create.result 1 "a grandchild config.save wrote the REAL tier $realTier — the anchor did not survive"
  elif [ "$wroteFixture" != "1" ]; then
    create.result 1 "the grandchild wrote nothing to the fixture; it did not see CONFIG_PATH at all"
  else
    create.result 0 "the anchor survives two levels down and the write lands in the fixture"
  fi
  return $(result)
}
test.case - "T85: an exported CONFIG_PATH survives into a grandchild process" \
  test.config.anchorSurvivesGrandchild
expect 0 "the anchor survives two levels down and the write lands in the fixture" \
  "a macOS probe once caught a grandchild defaulting to ~/config and writing the shared tier"

# ============================================================================
# The MacStudio config model
# ============================================================================
# user.env: the CONFIG_* anchors, PATH, BASH_FILE, then
# `. $CONFIG_PATH/oosh.env` and `. $CONFIG_PATH/log.env`. oosh.env: EVERY
# OOSH_* variable; log.env: EVERY LOG_* variable, its last line
# `. $HOME/.config/oosh/log.session.env`. ~/config is SHARED between users,
# so a value under the saving user's $HOME is written "$HOME/…" — correct for
# every user of the shared files. Every line is `export X="v"`: pure data.

# T-CONFIG-SAVE-PREFIX-OOSH: every OOSH_* variable, $HOME-relative
test.config.savePrefixOosh() {
  local fx bad="" f; fx=$(test.suite.fixture.make saveprefixoosh); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export OOSH_DIR="$fx/oosh" OOSH_COMPONENTS_DIR="/opt/probe/base" OOSH_PROBE="plain value"
    export OOSH_SHLVL=5 OOSH_STATUS="0: started in shell level: 2" OOSH_PROMPT="oosh " OOSH_CONFIG_NEEDS_SAVE=1
    config.save oosh OOSH ) >/dev/null 2>&1
  f="$fx/config/oosh.env"
  grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$f" 2>/dev/null || bad="$bad OOSH_DIR"
  grep -qxF 'export OOSH_COMPONENTS_DIR="/opt/probe/base"' "$f" 2>/dev/null || bad="$bad OOSH_COMPONENTS_DIR"
  grep -qxF 'export OOSH_PROBE="plain value"' "$f" 2>/dev/null || bad="$bad OOSH_PROBE"
  grep -qE '^export (OOSH_SHLVL|OOSH_STATUS|OOSH_PROMPT|OOSH_CONFIG_NEEDS_SAVE)=' "$f" 2>/dev/null && bad="$bad runtime-reading-saved"
  grep -vqE '^export OOSH_[A-Z0-9_]+=".*"$' "$f" 2>/dev/null && bad="$bad foreign-line=[$(grep -vE '^export OOSH_[A-Z0-9_]+=".*"$' "$f" | head -1)]"
  grep -qF "$fx" "$f" 2>/dev/null && bad="$bad absolute-home-leaked"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oosh.env holds every OOSH_* setting, \$HOME-relative, no runtime reading" || create.result 1 "oosh.env:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-PREFIX-OOSH: config save oosh saves every OOSH_* variable, \$HOME-relative" test.config.savePrefixOosh
expect 0 "oosh.env holds every OOSH_* setting, \$HOME-relative, no runtime reading" "the MacStudio model: config save oosh saves all OOSH_ settings"

# T-CONFIG-SAVE-PREFIX-LOG: every LOG_* variable, then the session chain line
test.config.savePrefixLog() {
  local fx bad="" f; fx=$(test.suite.fixture.make saveprefixlog); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export LOG_LEVEL_RESET="3"
    export LOG_DEVICE="/dev/pts/9" LOG_NAME="probe" LOG_LIVE="$fx/log.live"
    config.save log LOG ) >/dev/null 2>&1
  f="$fx/config/log.env"
  grep -qxF 'export LOG_LEVEL_RESET="3"' "$f" 2>/dev/null || bad="$bad LOG_LEVEL_RESET"
  grep -qE '^export (LOG_DEVICE|LOG_NAME|LOG_LIVE)=' "$f" 2>/dev/null && bad="$bad session-value-saved"
  [ "$(tail -1 "$f" 2>/dev/null)" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad chain-not-last"
  sed '$d' "$f" 2>/dev/null | grep -vqE '^export LOG_[A-Z0-9_]+=".*"$' && bad="$bad foreign-line"
  grep -qF "$fx" "$f" 2>/dev/null && bad="$bad absolute-home-leaked"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "log.env holds every LOG_* setting, not the session values, and ends with the session chain" || create.result 1 "log.env:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-PREFIX-LOG: config save log saves every LOG_* setting, not the session values, the session chain last" test.config.savePrefixLog
expect 0 "log.env holds every LOG_* setting, not the session values, and ends with the session chain" "LOG_NAME/LOG_DEVICE/LOG_LIVE belong in each user's log.session.env"

# T-CONFIG-SAVE-USER-ENV-LAYOUT: the bare config save writes user.env exactly
test.config.saveUserEnvLayout() {
  local fx bad="" expected; fx=$(test.suite.fixture.make saveuserenv); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/usr/bin/bash" ODOCKER_WORKSPACES="$fx/ws" PATH="$fx/.local/bin:/usr/bin:/bin"
    private.config.homes.list() { :; }   # an open gate: no other user
    config.save ) >/dev/null 2>&1
  expected='export CONFIG_PATH="$HOME/config"
export CONFIG_FILE="user.env"
export CONFIG="$HOME/config/user.env"
export BASH_FILE="/usr/bin/bash"
. $CONFIG_PATH/oosh.env
. $CONFIG_PATH/log.env
. $HOME/.config/oosh/user.session.env'
  [ "$(cat "$fx/config/user.env" 2>/dev/null)" = "$expected" ] || bad=" got=[$(tr '\n' '|' < "$fx/config/user.env" 2>/dev/null)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "user.env: anchors, BASH_FILE, then oosh.env, log.env and the user's own session file; ODOCKER_WORKSPACES stays in odocker.env" || create.result 1 "user.env layout:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-USER-ENV-LAYOUT: config save writes user.env in the MacStudio layout" test.config.saveUserEnvLayout
expect 0 "user.env: anchors, BASH_FILE, then oosh.env, log.env and the user's own session file; ODOCKER_WORKSPACES stays in odocker.env" "user.env starts a shell on its own — no boot"

# T-CONFIG-LOG-ENV-CHAIN-LAST: after a full save, and again after a re-save, the chain is last and once
test.config.logEnvChainLast() {
  local fx bad="" f n; fx=$(test.suite.fixture.make logenvchain); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    config.save; config.save ) >/dev/null 2>&1
  f="$fx/config/log.env"
  [ "$(tail -1 "$f" 2>/dev/null)" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad not-last"
  n=$(grep -cxF '. $HOME/.config/oosh/log.session.env' "$f" 2>/dev/null)
  [ "$n" = 1 ] || bad="$bad count=$n"
  grep -q 'log.session.env' "$fx/config/user.env" 2>/dev/null && bad="$bad chained-from-user.env"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "log.env ends with the unguarded session chain, exactly once" || create.result 1 "log.env chain:$bad"
  return $(result)
}
test.case $level "T-CONFIG-LOG-ENV-CHAIN-LAST: log.env ends with the session chain, once, after every save" test.config.logEnvChainLast
expect 0 "log.env ends with the unguarded session chain, exactly once" "the line that went missing in the boot removal"

# T-CONFIG-SESSION-FILE-ENSURE: every user gets ~/.config/oosh/log.session.env, so the chain needs no guard
test.config.sessionFileEnsure() {
  local fx bad="" f; fx=$(test.suite.fixture.make sessionfile)
  f="$fx/.config/oosh/log.session.env"
  private.config.session.file.ensure "$fx" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -f "$f" ] || bad="$bad not-created"
  printf 'export LOG_NAME="kept"\n' > "$f" 2>/dev/null
  private.config.session.file.ensure "$fx" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$(cat "$f" 2>/dev/null)" = 'export LOG_NAME="kept"' ] || bad="$bad existing-content-changed"
  private.config.session.file.ensure "" >/dev/null 2>&1 && bad="$bad empty-home-passed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the session file is created once and never overwritten" || create.result 1 "session file:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SESSION-FILE-ENSURE: config init.user and the install create log.session.env for every user" test.config.sessionFileEnsure
expect 0 "the session file is created once and never overwritten" "log.env chains it unguarded — it must exist for every user"

# T-CONFIG-SAVE-PATH-BASH-DIR: a bash outside /bin and /usr/bin (brew on macOS) is put on
# PATH by user.env itself, right after the oosh dirs — as data, computed at save time.
# boot used to prepend dirname $BASH_FILE on every shell.
test.config.savePathBashDir() {
  local fx bad="" line; fx=$(test.suite.fixture.make savebashdir); mkdir -p "$fx/config" "$fx/oosh/ng" "$fx/brew/bin"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="$fx/brew/bin/bash"
    unset ODOCKER_WORKSPACES; export PATH="/usr/bin:/bin"
    private.config.homes.list() { :; }   # an open gate: no other user
    config.save ) >/dev/null 2>&1
  line=$(grep '^export PATH=' "$fx/.config/oosh/user.session.env" 2>/dev/null)
  [ "$line" = "export PATH=\"$fx/oosh:$fx/oosh/ng:$fx/brew/bin:/usr/bin:/bin\"" ] || bad=" got=[$line]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the user's PATH line puts the brew bash directory after the oosh dirs" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-PATH-BASH-DIR: a brew bash directory is part of user.env's PATH line" test.config.savePathBashDir
expect 0 "the user's PATH line puts the brew bash directory after the oosh dirs" \
  "without boot nothing else puts brew bash ahead of /bin/bash 3.2 on macOS"

# T-CONFIG-SAVE-ANCHORS-CONSTANT: the anchors are the ~/… constants, whatever the saving shell holds
# The installer's shell holds CONFIG_PATH as the RESOLVED sharedConfig — not under
# $HOME, so it was written literally and every user's shell got a physical path
# (found by the first os platform.test on dev.config). CONFIG_PATH, CONFIG,
# OOSH_DIR are always "$HOME/…" (T31, T-CONFIG-PATH-IS-HOME-CONFIG). OOSH_USER_CONFIG_PATH,
# exported by an old shell, is never saved (T44).
test.config.saveAnchorsConstant() {
  local fx shared bad="" f; fx=$(test.suite.fixture.make anchorhome); shared=$(test.suite.fixture.make anchorshared)
  ( export HOME="$fx" CONFIG_PATH="$shared" CONFIG_FILE=user.env CONFIG="$shared/user.env"
    export OOSH_DIR="$shared/tree" OOSH_USER_CONFIG_PATH="$shared/percfg"
    config.save ) >/dev/null 2>&1
  for want in 'export CONFIG_PATH="$HOME/config"' 'export CONFIG="$HOME/config/user.env"'; do
    grep -qxF "$want" "$shared/user.env" 2>/dev/null || bad="$bad user.env-missing=[$want]"
  done
  grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$shared/oosh.env" 2>/dev/null || bad="$bad oosh.env-missing=[OOSH_DIR]"
  grep -q 'OOSH_USER_CONFIG_PATH' "$shared/oosh.env" 2>/dev/null && bad="$bad OOSH_USER_CONFIG_PATH-saved"
  grep -qF "$shared" "$shared/user.env" "$shared/oosh.env" 2>/dev/null && bad="$bad resolved-path-written"
  rm -rf "$fx" "$shared"
  [ -z "$bad" ] && create.result 0 "the anchors are written as the ~/… constants" || create.result 1 "anchors:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-ANCHORS-CONSTANT: config save writes the anchors as the ~/… constants" test.config.saveAnchorsConstant
expect 0 "the anchors are written as the ~/… constants" "the installer's resolved sharedConfig became every user's CONFIG_PATH"

# T-CONFIG-SAVE-LOG-ENSURES-SESSION: whoever writes the chain line makes sure the saver's target exists
# The installing user and root get their config through `config save` only —
# not user.oosh.install / config init.user — so on the first os platform.test
# `test` had no log.session.env and dash failed on log.env's last line.
test.config.saveLogEnsuresSession() {
  local fx bad=""; fx=$(test.suite.fixture.make logensures); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    config.save log LOG ) >/dev/null 2>&1
  [ -f "$fx/.config/oosh/log.session.env" ] || bad=" no-session-file"
  ( export HOME="$fx"; sh -c '. "$HOME/config/log.env"' ) >/dev/null 2>&1 || bad="$bad log.env-not-sourceable"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save log leaves a sourceable log.env and the saver's session file" || create.result 1 "session:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-LOG-ENSURES-SESSION: config save log creates the saving user's log.session.env" test.config.saveLogEnsuresSession
expect 0 "config save log leaves a sourceable log.env and the saver's session file" "dash: .: cannot open …/log.session.env — the installing user had none"

# T-CONFIG-PATH-LINE: user.env's PATH line is a snapshot of the saving shell's PATH, made safe
# The MacStudio model writes the whole PATH. On a SHARED ~/config it must still be
# right for every user: ~/oosh and ~/oosh/ng first, then a bash outside /bin and
# /usr/bin, then the saver's PATH — each segment under $HOME written "$HOME/…",
# trailing slashes dropped, no empty or "." segment (CWE-426), nothing relative,
# nothing transient (/tmp, a .vscode-server CLI), each segment once — and ":$PATH"
# last, so what the system adds after the save still reaches the shell.
test.config.pathLine() {
  local fx bad="" got want; fx=$(test.suite.fixture.make pathline)
  got=$( export HOME="$fx" BASH_FILE="/opt/homebrew/bin/bash"
         PATH="/opt/homebrew/bin/:$fx/.nvm/bin:.::rel/bin:/tmp/test.oo.1/bin:$fx/oosh/:/usr/bin:/usr/bin:$fx/.vscode-server/bin/abc/bin/remote-cli:/bin" \
           private.config.path.line.get 2>/dev/null )
  want='export PATH="$HOME/oosh:$HOME/oosh/ng:/opt/homebrew/bin:$HOME/.nvm/bin:/usr/bin:/bin:$PATH"'
  [ "$got" = "$want" ] || bad=" got=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH line: oosh first, the saver's PATH made safe, :\$PATH last" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-PATH-LINE: user.env's PATH line is the saving shell's PATH, made safe for every user" test.config.pathLine
expect 0 "PATH line: oosh first, the saver's PATH made safe, :\$PATH last" \
  "the MacStudio model writes the whole PATH, but ~/config is shared"

# T-CONFIG-PATH-LINE-NO-CODE: a PATH segment holding code never reaches the shared PATH line
# The $ " \ ` filter applied only to the absolute (per-user) form: in the home
# form a segment like /opt/x$(touch pwned) went verbatim into the PATH line of
# the shared user.env, which every user's shell executes. The line must stay
# pure data, and sourcing it must run nothing.
test.config.pathLineNoCode() {
  local fx bad="" got want; fx=$(test.suite.fixture.make pathlinenocode)
  got=$( export HOME="$fx" BASH_FILE="/usr/bin/bash"
         PATH="/opt/x\$(touch $fx/pwned):$fx/a\`touch $fx/pwned\`:/opt/q\"x:/opt/b\\s:$fx/ok/bin:/usr/bin:/bin" \
           private.config.path.line.get 2>/dev/null )
  want='export PATH="$HOME/oosh:$HOME/oosh/ng:$HOME/ok/bin:/usr/bin:/bin:$PATH"'
  [ "$got" = "$want" ] || bad=" got=[$got]"
  printf '%s\n' "$got" > "$fx/user.env"
  config.validate "$fx/user.env" >/dev/null 2>&1 || bad="$bad not-pure-data"
  ( HOME="$fx"; . "$fx/user.env" ) >/dev/null 2>&1
  [ -e "$fx/pwned" ] && bad="$bad sourcing-ran-code"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH line: segments holding code are dropped in the home form" || create.result 1 "PATH line code:$bad"
  return $(result)
}
test.case $level "T-CONFIG-PATH-LINE-NO-CODE: a PATH segment holding \$(…), a backtick, a quote or a backslash never reaches the shared PATH line" test.config.pathLineNoCode
expect 0 "PATH line: segments holding code are dropped in the home form" \
  "the shared user.env is executed by every user's shell"

# T-CONFIG-PATH-LINE-PHYSICAL-OOSH: the physical folder of ~/oosh is written as $HOME/oosh
# Found in a fresh platform container (2026-10-01): root saved the shared
# user.env while its PATH held the shared tree under its PHYSICAL name
# (…/Once.sh/dev.config, /ng, /su, /init, /external). Those went in literally:
# after `oo mode testing` (~/oosh -> testing) the old branch's su/init/external
# still came first on every user's PATH. The physical folder of ~/oosh — and
# anything below it — is ~/oosh, so it is written "$HOME/oosh…" and merges
# with the oosh entries instead of duplicating them.
test.config.pathLinePhysicalOosh() {
  local fx bad="" got want shared; fx=$(test.suite.fixture.make pathlinephys)
  shared="$fx/shared/Once.sh/dev.config"
  mkdir -p "$shared/ng" "$shared/init" "$fx/home"; ln -s "$shared" "$fx/home/oosh"
  got=$( export HOME="$fx/home" BASH_FILE="/usr/bin/bash"
         PATH="$shared:$shared/ng:$shared/init:/usr/bin:/bin" private.config.path.line.get 2>/dev/null )
  want='export PATH="$HOME/oosh:$HOME/oosh/ng:$HOME/oosh/init:/usr/bin:/bin:$PATH"'
  [ "$got" = "$want" ] || bad=" got=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH line: the physical ~/oosh folder written as \$HOME/oosh, merged" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-PATH-LINE-PHYSICAL-OOSH: the physical folder of ~/oosh is written as \$HOME/oosh" test.config.pathLinePhysicalOosh
expect 0 "PATH line: the physical ~/oosh folder written as \$HOME/oosh, merged" \
  "root's install PATH put the shared tree's physical paths into every user's user.env"

# T-CONFIG-PATH-LINE-LINK-SPELLING: the link's OWN spelling of the oosh folder is ~/oosh too
# Found on a fresh macOS VM (2026-10-01): the ~/oosh link and the installer's
# PATH say /Users/shared/…/dev.config, the canonical path is /Users/Shared/…
# (case-insensitive file system), so matching only the canonical form left the
# physical entries in user.env. Reproduced here with an extra symlink in the
# link target: the link spelling differs from the canonical one in the same way.
test.config.pathLineLinkSpelling() {
  local fx bad="" got want link; fx=$(test.suite.fixture.make pathlinelink)
  mkdir -p "$fx/real/Once.sh/dev.config/ng" "$fx/real/Once.sh/dev.config/init" "$fx/home"
  ln -s "$fx/real" "$fx/alias"; link="$fx/alias/Once.sh/dev.config"; ln -s "$link" "$fx/home/oosh"
  got=$( export HOME="$fx/home" BASH_FILE="/usr/bin/bash"
         PATH="$link:$link/ng:$link/init:/usr/bin:/bin" private.config.path.line.get 2>/dev/null )
  want='export PATH="$HOME/oosh:$HOME/oosh/ng:$HOME/oosh/init:/usr/bin:/bin:$PATH"'
  [ "$got" = "$want" ] || bad=" got=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH line: the link's own spelling of ~/oosh written as \$HOME/oosh" || create.result 1 "PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-PATH-LINE-LINK-SPELLING: the ~/oosh link's own spelling of the folder is written as \$HOME/oosh" test.config.pathLineLinkSpelling
expect 0 "PATH line: the link's own spelling of ~/oosh written as \$HOME/oosh" \
  "macOS: the link says /Users/shared, the canonical path /Users/Shared — the physical entries stayed"

# ============================================================================
# `config save` as a COMMAND — the way a user types it (dev.config, config-save round)
# ============================================================================
# Every other config.save test calls the FUNCTION in the test shell. Typed at
# the prompt, `config` is an executable: a CHILD process that sees only what the
# parent exported, does not re-read user.env, and dispatches through
# config.start / this.start. These cases run the real executable under `env -i`
# with a fixture HOME and only the variables they export.
test.config.cmd.fixture() { # <label> # echo a fixture dir: $fx/home with an empty config/user.env, the anchors a child needs
  local fx; fx=$(test.suite.fixture.make "$1") || return 1
  mkdir -p "$fx/home/config" "$fx/home/.config/oosh"
  : > "$fx/home/config/user.env"
  echo "$fx"
}

# T-CONFIG-CMD-SAVE-OOSH: `config save oosh` writes every exported OOSH_* setting, never a runtime reading
test.config.cmdSaveOosh() {
  local fx bad="" f; fx=$(test.config.cmd.fixture cmdsaveoosh); f="$fx/home/config/oosh.env"
  # a switched shared config: OOSH_MODE is per user there
  echo '. $HOME/.config/oosh/user.session.env' > "$fx/home/config/user.env"
  env -i PATH="$PATH" HOME="$fx/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
    CONFIG_PATH="$fx/home/config" CONFIG_FILE=user.env CONFIG="$fx/home/config/user.env" \
    OOSH_MODE=dev OOSH_PM="apt-get -y install" OOSH_PROBE="plain value" \
    OOSH_SHLVL=5 OOSH_STATUS="0: started in shell level: 2" OOSH_PROMPT="oosh " OOSH_CONFIG_NEEDS_SAVE=1 \
    OOSH_CLEAN_ENV=1 OOSH_APT_UPDATED=1 OOSH_PM_BIN=apt-get OOSH_USER_CONFIG_PATH="$fx/home/.config/oosh" \
    "$OOSH_DIR/config" save oosh >/dev/null 2>&1 </dev/null
  for want in 'export OOSH_PM="apt-get -y install"' 'export OOSH_PROBE="plain value"' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_PM_BIN="apt-get"'; do
    grep -qxF "$want" "$f" 2>/dev/null || bad="$bad missing=[$want]"
  done
  grep -qE '^export (OOSH_MODE|OOSH_SHLVL|OOSH_STATUS|OOSH_PROMPT|OOSH_CONFIG_NEEDS_SAVE|OOSH_CLEAN_ENV|OOSH_APT_UPDATED|OOSH_USER_CONFIG_PATH)=' "$f" 2>/dev/null \
    && bad="$bad runtime=[$(grep -E '^export (OOSH_MODE|OOSH_SHLVL|OOSH_STATUS|OOSH_PROMPT|OOSH_CONFIG_NEEDS_SAVE|OOSH_CLEAN_ENV|OOSH_APT_UPDATED|OOSH_USER_CONFIG_PATH)=' "$f" | tr '\n' ' ')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save oosh: every OOSH_* setting, no runtime reading" || create.result 1 "config save oosh:$bad"
  return $(result)
}
test.case $level "T-CONFIG-CMD-SAVE-OOSH: typed \`config save oosh\` saves every OOSH_* setting and no runtime reading" test.config.cmdSaveOosh
expect 0 "config save oosh: every OOSH_* setting, no runtime reading" \
  "OOSH_SHLVL/OOSH_STATUS/OOSH_PROMPT of one shell were saved and looped into every new shell"

# T-CONFIG-CMD-SAVE-LOG: `config save log` writes the LOG_* settings, not the per-user session values
test.config.cmdSaveLog() {
  local fx bad="" f; fx=$(test.config.cmd.fixture cmdsavelog); f="$fx/home/config/log.env"
  env -i PATH="$PATH" HOME="$fx/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 LOG_LEVEL_RESET=3 \
    CONFIG_PATH="$fx/home/config" CONFIG_FILE=user.env CONFIG="$fx/home/config/user.env" \
    LOG_NAME="saver@host" LOG_DEVICE="/dev/null" LOG_LIVE="$fx/home/.config/oosh/log.live.out" \
    "$OOSH_DIR/config" save log >/dev/null 2>&1 </dev/null
  for want in 'export LOG_LEVEL="1"' 'export LOG_LEVEL_RESET="3"'; do
    grep -qxF "$want" "$f" 2>/dev/null || bad="$bad missing=[$want]"
  done
  grep -qE '^export (LOG_NAME|LOG_DEVICE|LOG_LIVE)=' "$f" 2>/dev/null \
    && bad="$bad session=[$(grep -E '^export (LOG_NAME|LOG_DEVICE|LOG_LIVE)=' "$f" | tr '\n' ' ')]"
  [ "$(tail -1 "$f" 2>/dev/null)" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad chain-not-last"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save log: the LOG_* settings, no session value, the chain last" || create.result 1 "config save log:$bad"
  return $(result)
}
test.case $level "T-CONFIG-CMD-SAVE-LOG: typed \`config save log\` keeps LOG_NAME/LOG_DEVICE/LOG_LIVE out of the shared log.env" test.config.cmdSaveLog
expect 0 "config save log: the LOG_* settings, no session value, the chain last" \
  "a new user inherited the saver's LOG_NAME from the shared log.env"

# T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS: `config save` keeps every chain line user.env had
test.config.cmdSaveUserKeepsChains() {
  local fx bad="" f got want; fx=$(test.config.cmd.fixture cmdsavechains); f="$fx/home/config/user.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' \
    '. $CONFIG_PATH/odocker.env' 'source $CONFIG_PATH/myapp.env' '. $CONFIG_PATH/gone.env' \
    '. $HOME/.config/oosh/user.session.env' > "$f"
  : > "$fx/home/config/odocker.env"; : > "$fx/home/config/myapp.env"
  env -i PATH="$PATH" HOME="$fx/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 BASH_FILE=/usr/bin/bash \
    CONFIG_PATH="$fx/home/config" CONFIG_FILE=user.env CONFIG="$f" \
    "$OOSH_DIR/config" save >/dev/null 2>&1 </dev/null
  got=$(grep -E '^(\.|source) ' "$f" 2>/dev/null)
  want='. $CONFIG_PATH/oosh.env
. $CONFIG_PATH/log.env
. $CONFIG_PATH/odocker.env
. $CONFIG_PATH/myapp.env
. $CONFIG_PATH/gone.env
. $HOME/.config/oosh/user.session.env'
  [ "$got" = "$want" ] || bad=" chains=[$(printf '%s' "$got" | tr '\n' '|')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save keeps every chain, source written as ., each once, after oosh and log, the user's session file last" || create.result 1 "config save:$bad"
  return $(result)
}
test.case $level "T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS: typed \`config save\` keeps odocker.env and every other chain" test.config.cmdSaveUserKeepsChains
expect 0 "config save keeps every chain, source written as ., each once, after oosh and log, the user's session file last" \
  "config save rebuilt user.env and dropped . \$CONFIG_PATH/odocker.env"


# T-CONFIG-CHAIN-NAMES-GET: the chain names of a user.env, `.` and `source` alike, junk ignored
test.config.chainNamesGet() {
  local fx got want; fx=$(test.suite.fixture.make chainnames)
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' '. $CONFIG_PATH/oosh.env' '  . $CONFIG_PATH/log.env  ' \
    'source $CONFIG_PATH/myapp.env' '# . $CONFIG_PATH/commented.env' '. /etc/other.env' \
    '. $CONFIG_PATH/bad name.env' '. $CONFIG_PATH/odocker.env' > "$fx/user.env"
  got=$(private.config.chain.names.get "$fx/user.env" | tr '\n' ' ')
  want='oosh log myapp odocker '
  rm -rf "$fx"
  [ "$got" = "$want" ] && create.result 0 "oosh log myapp odocker" || create.result 1 "got [$got] want [$want]"
  return $(result)
}
test.case $level "T-CONFIG-CHAIN-NAMES-GET: the chain names of a user.env, . and source alike, junk ignored" test.config.chainNamesGet
expect 0 "oosh log myapp odocker" "config save must know every chain before it truncates user.env"

# T-CONFIG-INIT-USER-CALLS: config init.user calls its collaborators with the right arguments, and a second run writes nothing
# config.init.user is what `oo update` and `oo user.fix` run; it was tested only
# by reading its source text. Driven here for the caller's own user and for
# another user, in a fixture base (developking, the shared tree, the homes):
# what leaves the fixture is a recording stub — the migrates and the all-users
# hops (their own tests drive them), ogit trust, the dev group and the trust hop
# as the target. The symlink hop and the .bashrc/session hop run for real, as
# the caller, inside the fixture. The second run makes the same calls, without
# the symlink hop (both links are canonical), and changes no file of the home:
# no second backup, no rewritten link (log.live.out aside — log touches it on
# every source). user.group.add dev <user> is called on EVERY run: whether a
# member is left alone is user.group.add's to decide (T-USER-GROUP-ADD-IDEMPOTENT).
test.config.initUserCalls() {
  local fx bad="" base sharedConfig sharedOosh want u run1 run2 snap1 snap2
  fx=$(test.suite.fixture.make initusercalls); base="$fx/home"
  sharedConfig="$base/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  sharedOosh="$base/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh/dev"
  mkdir -p "$base/developking" "$sharedConfig" "${sharedOosh%/*}"; ln -s "$OOSH_DIR" "$sharedOosh"
  test.config.initUserCalls.run() { # <username> — config.init.user in a child shell; echo its recorded calls, the fixture spelled FX
    rm -f "$fx/calls"
    FX="$fx" U="$1" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      test.config.initUserCalls.record() { printf "%s\n" "$*" >> "$FX/calls"; }
      user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
      private.as.user() {
        case "$*" in
          *symlink.with.backup*)          test.config.initUserCalls.record "as.user $1 symlinks"; shift; "$@" ;;
          *private.user.bashrc.install*)  test.config.initUserCalls.record "as.user $1 bashrc+session"; shift; "$@" ;;
          *safeDirectory.ensure*)         test.config.initUserCalls.record "as.user $1 trust" ;;
          *)                              test.config.initUserCalls.record "as.user $1 other" ;;
        esac
      }
      private.config.log.chain.migrate()         { test.config.initUserCalls.record "log.chain.migrate $*"; }
      private.config.session.files.ensure.all()  { test.config.initUserCalls.record "session.files.ensure.all $*"; }
      private.config.bashrc.ensure.all()         { test.config.initUserCalls.record "bashrc.ensure.all $*"; }
      private.config.user.session.migrate()      { test.config.initUserCalls.record "user.session.migrate $*"; }
      private.config.oosh.session.migrate()      { test.config.initUserCalls.record "oosh.session.migrate $*"; }
      ogit.safeDirectory.ensure()                { test.config.initUserCalls.record "ogit.safeDirectory.ensure $*"; }
      private.user.check.group()                 { return 0; }
      user.group.add()                           { test.config.initUserCalls.record "user.group.add $*"; }
      export OOSH_MODE=dev
      config.init.user "$U" >/dev/null 2>&1; test.config.initUserCalls.record "rc $?"' >/dev/null 2>&1
    sed "s|$fx|FX|g" "$fx/calls" 2>/dev/null
  }
  test.config.initUserCalls.snap() { # <home> — every entry of <home>, link or file, with inode, size and mtime
    (cd "$1" && find . ! -name log.live.out -exec ls -lid {} + 2>/dev/null) | sort
  }
  for u in "$(id -un)" oosh-t-other; do
    mkdir -p "$base/$u/config"; echo "old bashrc" > "$base/$u/.bashrc"   # a real ~/config and a .bashrc of their own
    want="as.user $u symlinks
as.user $u bashrc+session
log.chain.migrate ${sharedConfig/$fx/FX}
session.files.ensure.all ${sharedConfig/$fx/FX} ${sharedOosh/$fx/FX}
bashrc.ensure.all ${sharedConfig/$fx/FX} ${sharedOosh/$fx/FX}
user.session.migrate ${sharedConfig/$fx/FX}
oosh.session.migrate ${sharedConfig/$fx/FX}
ogit.safeDirectory.ensure ${sharedOosh%/*}
as.user $u trust
user.group.add dev $u
rc 0"
    want="${want/ogit.safeDirectory.ensure $fx/ogit.safeDirectory.ensure FX}"
    run1=$(test.config.initUserCalls.run "$u")
    [ "$run1" = "$want" ] || bad="$bad $u-first-run=[$(printf '%s' "$run1" | tr '\n' '|')]"
    [ "$(readlink "$base/$u/config")" = "$sharedConfig" ] && [ "$(readlink "$base/$u/oosh")" = "$sharedOosh" ] || bad="$bad $u-links-not-canonical"
    [ "$(ls -d "$base/$u/config.orig."* 2>/dev/null | grep -c '')" = 1 ] || bad="$bad $u-config-not-kept-once"
    private.this.file.same "$OOSH_DIR/templates/user/bashrcTemplate" "$base/$u/.bashrc" || bad="$bad $u-bashrc-not-installed"
    [ "$(cat "$base/$u/.bashrc.pre-oosh" 2>/dev/null)" = "old bashrc" ] || bad="$bad $u-bashrc-not-kept"
    (cd "$base/$u" && find . ! -type l -exec touch -t 200001010000 {} +)
    snap1=$(test.config.initUserCalls.snap "$base/$u")
    run2=$(test.config.initUserCalls.run "$u")
    [ "$run2" = "${want#*
}" ] || bad="$bad $u-second-run=[$(printf '%s' "$run2" | tr '\n' '|')]"
    snap2=$(test.config.initUserCalls.snap "$base/$u")
    [ "$snap2" = "$snap1" ] || bad="$bad $u-second-run-wrote=[$(printf '%s\n' "$snap2" | grep -vxF -f <(printf '%s\n' "$snap1") | tr '\n' '|')]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config init.user: the right calls, a second run writes nothing" || create.result 1 "init.user:$bad"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-CALLS: config init.user calls its collaborators with the right arguments, and a second run writes nothing" \
  test.config.initUserCalls
expect 0 "config init.user: the right calls, a second run writes nothing" \
  "config.init.user was tested only by reading its source text"

# T-CONFIG-INIT-USER-SYMLINK-HOP-PREAMBLE: config init.user's symlink hop loads the shared tree's this for the target
# The symlink hop sourced "$OOSH_DIR/this" — expanded by the CALLER, so root
# healing another user from /root/oosh (0700) or from a temp clone handed the
# target a path they cannot read: the source failed silently and the hop
# failed. Like its later hops, it goes through private.this.as.user.preamble.get
# (the target's HOME, no leaked anchors, `this` from the SHARED tree). The hop
# is recorded, not run: private.as.user is stubbed and its command text kept.
# The fixture is built and removed with plain mkdir / ln -s / rm -rf inside the
# test.suite.fixture.make directory, as T-CONFIG-INIT-USER-CALLS does: the
# symlink primitive is the code under test, and test.suite has no remover.
test.config.initUserSymlinkHopPreamble() {
  local fx bad="" base sharedConfig sharedOosh u="oosh-t-other" cmd preamble rest
  fx=$(test.suite.fixture.make initusersymlinkhop); base="$fx/home"
  sharedConfig="$base/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  sharedOosh="$base/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh/dev"
  mkdir -p "$base/developking" "$sharedConfig" "${sharedOosh%/*}" "$base/$u/config"; ln -s "$OOSH_DIR" "$sharedOosh"
  FX="$fx" U="$u" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
    private.as.user() { case "$4" in *symlink.with.backup*) printf "%s" "$4" > "$FX/hop" ;; esac; }
    private.config.log.chain.migrate() { :; }; private.config.session.files.ensure.all() { :; }
    private.config.bashrc.ensure.all() { :; }; private.config.user.session.migrate() { :; }
    private.config.oosh.session.migrate() { :; }; ogit.safeDirectory.ensure() { :; }
    private.user.check.group() { return 1; }
    export OOSH_MODE=dev
    config.init.user "$U" >/dev/null 2>&1' >/dev/null 2>&1
  cmd=$(cat "$fx/hop" 2>/dev/null)
  preamble=$(private.this.as.user.preamble.get "$u" "$base/$u" "$sharedOosh")
  [ -n "$cmd" ] || bad="$bad no-symlink-hop"
  case "$cmd" in *"$preamble"*) ;; *) bad="$bad no-preamble" ;; esac
  # After the preamble nothing sources anything — a substring of the caller's
  # $OOSH_DIR would match the fixture's own shared tree when the caller runs
  # from the physical canonical tree (a platform container, the dev folder).
  rest=${cmd#*"$preamble"}
  case "$rest" in *source*) bad="$bad sources-after-preamble" ;; esac
  case "$cmd" in *"cd \"$base/$u\" || {"*"exit 1; }"*) ;; *) bad="$bad no-cd-home" ;; esac
  # each call fail-fast, with the primitive's RESULT on the way out (T-CONFIG-INIT-USER-FAIL-REASON)
  case "$cmd" in *"private.this.symlink.with.backup config '$sharedConfig' '"*"' || { echo \"\$RESULT\"; exit 1; }"*"private.this.symlink.with.backup oosh   '$sharedOosh'   '"*"' || { echo \"\$RESULT\"; exit 1; }"*) ;; *) bad="$bad symlink-lines-changed" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the symlink hop loads the shared tree's this for the target" || create.result 1 "symlink hop:$bad cmd=[$(printf '%s' "$cmd" | tr '\n' '|')]"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-SYMLINK-HOP-PREAMBLE: config init.user's symlink hop loads the shared tree's this for the target user, not the caller's \$OOSH_DIR" \
  test.config.initUserSymlinkHopPreamble
expect 0 "the symlink hop loads the shared tree's this for the target" \
  "root's 0700 /root/oosh or a heal's temp clone was sourced as the target user"

# T-CONFIG-INIT-USER-HOP-OLD-TREE: the symlink hop works with the primitive of an older shared tree
# The hop sources `this` from <sharedOosh> — under `oo heal all` the branch a
# user keeps, an older tree than the caller's. Its private.this.symlink.with.backup
# required a <ts> and the hop passed '' — rc 1, ~/config never linked (the first
# container gate of the heal, the user test). The caller stamps once
# (private.this.orig.stamp.get, free for config and oosh) and hands the stamp
# to both calls, which every version takes. The old tree is a stand-in: the
# real `this` with the strict primitive of the old version.
test.config.initUserHopOldTree.run() { # <fx> <primitiveBody> # config init.user for this user against the stand-in old tree whose private.this.symlink.with.backup runs <primitiveBody>; echo rc|RESULT
  local fx="$1" body="$2" base="$1/home" u
  u=$(id -un)
  local sharedOosh="$base/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh/dev"
  mkdir -p "$base/developking" "$base/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig" "$sharedOosh" "$base/$u"
  printf '%s\n' "source '$OOSH_DIR/this' >/dev/null 2>&1" "private.this.symlink.with.backup() { $body; }" > "$sharedOosh/this"
  FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export HOME="$FX"   # the git trust config.init.user writes lands in the fixture
    user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
    # only the symlink hop runs (as this user: directly); the later hops are not under test
    private.as.user() { case "$4" in *symlink.with.backup*) shift; "$@" ;; esac; }
    private.config.log.chain.migrate() { :; }; private.config.session.files.ensure.all() { :; }
    private.config.bashrc.ensure.all() { :; }; private.config.user.session.migrate() { :; }
    private.config.oosh.session.migrate() { :; }; ogit.safeDirectory.ensure() { :; }
    private.user.check.group() { return 1; }
    export OOSH_MODE=dev LOG_DEVICE="$FX/log.out"
    config.init.user "$(id -un)" >/dev/null 2>&1; echo "$?|$RESULT"' 2>/dev/null
}
test.config.initUserHopOldTree() {
  local fx bad="" got u base sharedConfig sharedOosh
  u=$(id -un)
  fx=$(test.suite.fixture.make inituserhopoldtree); base="$fx/home"
  sharedConfig="$base/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  sharedOosh="$base/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh/dev"
  got=$(test.config.initUserHopOldTree.run "$fx" '[ -n "$3" ] || { create.result 1 "private.this.symlink.with.backup requires <linkPath> <target> <ts>"; return 1; }; ln -s "$2" "$1"')
  case "$got" in 0\|*) ;; *) bad="$bad rc=[$got]" ;; esac
  [ "$(readlink "$base/$u/config")" = "$sharedConfig" ] || bad="$bad config-not-linked"
  [ "$(readlink "$base/$u/oosh")" = "$sharedOosh" ] || bad="$bad oosh-not-linked"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the old tree's primitive got a stamp, both links stand" || create.result 1 "old tree hop:$bad"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-HOP-OLD-TREE: config init.user's symlink hop hands a stamp, so the primitive of an older shared tree links too" \
  test.config.initUserHopOldTree
expect 0 "the old tree's primitive got a stamp, both links stand" \
  "the heal kept the user test on an older branch, its primitive wanted a <ts>, and ~/config was never linked"

# T-CONFIG-INIT-USER-FAIL-REASON: a failing symlink hop is rc 1 with the hop's own reason in RESULT
# The heal printed "config init.user … failed — run it to see why": the reason
# went to the hop's log device. The hop echoes the primitive's RESULT on its
# way out and config.init.user names it in its own RESULT.
test.config.initUserFailReason() {
  local fx bad="" got
  fx=$(test.suite.fixture.make inituserfailreason)
  got=$(test.config.initUserHopOldTree.run "$fx" 'create.result 1 "boom-from-the-hop"; return 1')
  case "$got" in 1\|*boom-from-the-hop*) ;; *) bad="$bad got=[$got]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "rc 1, the hop's reason in RESULT" || create.result 1 "fail reason:$bad"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-FAIL-REASON: a failed symlink hop answers rc 1 and names the hop's own reason" \
  test.config.initUserFailReason
expect 0 "rc 1, the hop's reason in RESULT" \
  "a heal log said only: run it to see why"

# T-CONFIG-LOG-CHAIN-MIGRATE: a host's old log.env chain line is rewritten
# Hosts installed before 2026-10-01 end their shared log.env with
# `. $OOSH_USER_CONFIG_PATH/log.session.env`. Once oosh.env no longer exports the
# variable, that line loads `/log.session.env` and a plain sh stops. config save
# and config.init.user (oo update, oo user.fix) rewrite it, in place.
test.config.logChainMigrate() {
  local fx bad="" f; fx=$(test.suite.fixture.make logchainmigrate); f="$fx/log.env"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $OOSH_USER_CONFIG_PATH/log.session.env' > "$f"
  chmod 664 "$f"
  private.config.log.chain.migrate "$fx" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ "$(cat "$f")" = 'export LOG_LEVEL="1"
. $HOME/.config/oosh/log.session.env' ] || bad="$bad content=[$(tr '\n' '|' < "$f")]"
  [ "$(ls -l "$f" | cut -c1-10)" = "-rw-rw-r--" ] || bad="$bad mode-changed"
  private.config.log.chain.migrate "$fx" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$(grep -c 'log.session.env' "$f")" = 1 ] || bad="$bad not-idempotent"
  rm -f "$f"; private.config.log.chain.migrate "$fx" >/dev/null 2>&1 || bad="$bad missing-file-rc=$?"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the old chain line becomes \$HOME/.config/oosh, in place, once" || create.result 1 "migrate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-LOG-CHAIN-MIGRATE: an old log.env chain line is rewritten to \$HOME/.config/oosh" test.config.logChainMigrate
expect 0 "the old chain line becomes \$HOME/.config/oosh, in place, once" \
  "a host's old log.env would load /log.session.env once oosh.env stops exporting the variable"

# T120: `$(config save …)` captures nothing — config save's own log lines
# (console/stop/important.log, log.device's probe) went to LOG_DEVICE, which
# is fd1 without a tty, and landed in the capture.
test.config.saveCaptureClean() {
  local bad="" fx out; fx=$(test.suite.fixture.make t120) || { create.result 1 "mktemp failed"; return $(result); }
  test.config.generatedUserEnv "$fx" >/dev/null
  out=$( { export CONFIG_PATH="$fx" CONFIG_FILE=user.env CONFIG="$fx/user.env" OOSH_USER_CONFIG_PATH="$fx/pu" OOSH_MODE=dev
           # portability-exception: same process — log classifies /proc/self/fd/1 by NAME as a capture and never opens it
           export LOG_DEVICE=/proc/self/fd/1 LOG_LEVEL=3 T120_X=1
           config.save t120 T120; config.save; } 2>/dev/null )
  [ -z "$out" ] || bad="$bad captured=[$(printf '%s' "$out" | head -3 | tr '\n' ' ')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save prints nothing to stdout" || create.result 1 "capture:$bad"
  return $(result)
}
test.case $level "T120: \$(config save …) captures nothing — its log lines go to stderr" test.config.saveCaptureClean
expect 0 "config save prints nothing to stdout" "config save's log lines landed in a \$() capture"

# ============================================================================
# T95: bashrcTemplate defines its functions without the `function` keyword
# ============================================================================
# config installs it as ~/.bashrc (private.config.bashrc.ensure); same rule as T93.
test.config.bashrcTemplateNoFunctionKeyword() {
  local defs
  defs=$(grep -nE '^[[:space:]]*function[[:space:]]+[A-Za-z_.]+' "$OOSH_DIR/templates/user/bashrcTemplate")
  if [ -n "$defs" ]; then
    create.result 1 "bashrcTemplate uses the function keyword: $(printf '%s' "$defs" | cut -d'(' -f1 | tr '\n' ' ')"
  else
    create.result 0 "bashrcTemplate functions are bare name()"
  fi
  return $(result)
}
test.case - "T95: bashrcTemplate defines its functions without the function keyword" \
  test.config.bashrcTemplateNoFunctionKeyword
expect 0 "bashrcTemplate functions are bare name()" "the template config installs as ~/.bashrc follows the same rule as the scripts"

# ============================================================================
# T93: config defines its methods without the `function` keyword
# ============================================================================
# A method is `script.method() # <params> # description` — templates/code/
# newScript, newMethod and docs/oosh-architecture.md "Signature Format". The
# parsers (c2 get.functions, this.methodNotFound, completion.audit,
# oo method.delete) only see that form: a `function x()` line is invisible to
# help, completion and the audit.
test.config.noFunctionKeyword() {
  local defs
  defs=$(grep -nE '^[[:space:]]*function[[:space:]]+[A-Za-z_.]+' "$OOSH_DIR/config")
  if [ -n "$defs" ]; then
    create.result 1 "config uses the function keyword: $(printf '%s' "$defs" | cut -d'(' -f1 | tr '\n' ' ')"
  else
    create.result 0 "config methods are bare script.method()"
  fi
  return $(result)
}
test.case - "T93: config defines its methods without the function keyword" \
  test.config.noFunctionKeyword
expect 0 "config methods are bare script.method()" \
  "the parsers only see script.method() — a function-keyword method hides from help, completion and the audit"

# ============================================================================
# T94: the deprecated config.path.create / config.folder.create are gone
# ============================================================================
# "(internal deprecated)" and uncalled since 67972c6 removed their last caller,
# config.completion.install.
test.config.deprecatedCreateGone() {
  local left=""
  declare -F config.path.create >/dev/null && left="$left config.path.create"
  declare -F config.folder.create >/dev/null && left="$left config.folder.create"
  if [ -n "$left" ]; then
    create.result 1 "still defined:$left"
  else
    create.result 0 "deprecated create methods removed"
  fi
  return $(result)
}
test.case - "T94: the deprecated config.path.create / config.folder.create are gone" \
  test.config.deprecatedCreateGone
expect 0 "deprecated create methods removed" "dead code since 67972c6 removed their last caller"
# ============================================================================
# T90: config defines no log API of its own
# ============================================================================
# `log` owns console/important/warn/stop/debug/error.log; early bootstrap
# logging (info.log) lives in `this`. config used to redefine the log API at
# file scope as no-op stubs "in case log is not loaded yet" — dead code (the
# only early `source config`, in this's bootstrap case, is guarded) that also
# fooled every `type -t console.log` probe into seeing a loaded log.
test.config.definesNoLogApi() {
  local defs
  defs=$(grep -nE '(^|[^.[:alnum:]_])(console|important|warn|stop|debug|error)\.log\(\)' "$OOSH_DIR/config")
  if [ -n "$defs" ]; then
    create.result 1 "config defines log functions: $(printf '%s' "$defs" | tr '\n' ' ')"
  else
    create.result 0 "config defines no log functions"
  fi
  return $(result)
}
test.case - "T90: config defines no log API — log owns it, this owns bootstrap logging" \
  test.config.definesNoLogApi
expect 0 "config defines no log functions" \
  "a second owner of the log API hides a missing log and drops messages"

# ============================================================================
# T91: a cold `config` run reaches the real log — no stubs needed
# ============================================================================
# config's only file-scope statement is config.start, which sources `this`
# (→ debug → log) before any config method runs. Run it in a bare env against
# a fixture: no "command not found" for a log function.
test.config.coldRunHasLog() {
  local fx; fx=$(test.suite.fixture.make t91) || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fx/pu"; : > "$fx/user.env"
  env -i HOME="$HOME" PATH=/usr/bin:/bin OOSH_DIR="$OOSH_DIR" CONFIG_PATH="$fx" CONFIG="$fx/user.env" CONFIG_FILE=user.env \
      OOSH_USER_CONFIG_PATH="$fx/pu" LOG_DEVICE=/dev/null \
      "$OOSH_DIR/config" >/dev/null 2>"$fx/stderr"
  local err; err=$(grep -E '\.log: command not found' "$fx/stderr")
  rm -rf "$fx"
  if [ -n "$err" ]; then create.result 1 "cold config: $err"; else create.result 0 "cold config has log"; fi
  return $(result)
}
test.case - "T91: a cold ./config run finds the real log functions" \
  test.config.coldRunHasLog
expect 0 "cold config has log" "config.start sources this, and this loads log before any config method runs"

# ============================================================================
# T92: ./log with a pending config save — the ea02bcb bug-2 scenario
# ============================================================================
# `log` sources `this` BEFORE it defines console.log …; this's bootstrap case
# for $0=log must not source config and run config.save in that window. The
# fixture user.env stays empty: no save happened mid-load, and nothing errored.
test.config.logBootDoesNotSaveMidLoad() {
  local fx; fx=$(test.suite.fixture.make t92) || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fx/pu"; : > "$fx/user.env"
  env -i HOME="$HOME" PATH=/usr/bin:/bin OOSH_DIR="$OOSH_DIR" CONFIG_PATH="$fx" CONFIG="$fx/user.env" CONFIG_FILE=user.env \
      OOSH_USER_CONFIG_PATH="$fx/pu" LOG_DEVICE=/dev/null OOSH_CONFIG_NEEDS_SAVE="$fx/user.env" \
      "$OOSH_DIR/log" >/dev/null 2>"$fx/stderr"
  local err size
  err=$(grep -E 'command not found' "$fx/stderr")
  size=$(wc -c <"$fx/user.env")
  rm -rf "$fx"
  if [ -n "$err" ]; then
    create.result 1 "./log bootstrap: $err"
  elif [ "$size" -ne 0 ]; then
    create.result 1 "config.save ran while log was still loading"
  else
    create.result 0 "log bootstrap is clean"
  fi
  return $(result)
}
test.case - "T92: ./log with OOSH_CONFIG_NEEDS_SAVE neither errors nor saves mid-load" \
  test.config.logBootDoesNotSaveMidLoad
expect 0 "log bootstrap is clean" "this's bootstrap save is guarded until the log API exists"

# T-CONFIG-USER-SESSION-PATH-ABSOLUTE: the per-user PATH line is the REAL path
# The shared user.env forks like log.env (boss, 2026-10-02): PATH moves into
# the user's own ~/.config/oosh/user.session.env, written as real absolute
# directories — no $ at all, no :$PATH. The safety rules of the shared line
# stay: oosh first, a bash outside /bin and /usr/bin next, no empty, "." or
# relative segment, nothing transient, each segment once, trailing slashes go.
test.config.userSessionPathAbsolute() {
  local fx bad="" got want; fx=$(test.suite.fixture.make usersessionpath)
  mkdir -p "$fx/oosh/ng" "$fx/brew/bin" "$fx/.nvm/bin"
  got=$( export HOME="$fx" BASH_FILE="$fx/brew/bin/bash"
         PATH="$fx/brew/bin/:$fx/.nvm/bin:.::rel/bin:/tmp/test.oo.1/bin:$fx/oosh/:/usr/bin:/usr/bin:$fx/.vscode-server/bin/abc/bin/remote-cli:/bin" \
           private.config.path.line.absolute.get 2>/dev/null )
  want="export PATH=\"$fx/oosh:$fx/oosh/ng:$fx/brew/bin:$fx/.nvm/bin:/usr/bin:/bin\""
  [ "$got" = "$want" ] || bad=" got=[$got] want=[$want]"
  case "$got" in *'$'*) bad="$bad has-dollar" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "per-user PATH line: real absolute dirs, oosh first, no \$" || create.result 1 "absolute PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-PATH-ABSOLUTE: the per-user PATH line is the real absolute path, no \$ at all" test.config.userSessionPathAbsolute
expect 0 "per-user PATH line: real absolute dirs, oosh first, no \$" \
  "user.session.env belongs to one user, so its PATH is written out in full"

# T-CONFIG-USER-SESSION-PATH-FILTERED: a polluted session does not get saved
# Executing `this` saves the session file, so whatever the shell holds would
# be frozen into the user's PATH: an active virtualenv or conda env, a
# directory that does not exist (or is not searchable — root's dirs seen from
# an as-user hop), and a segment holding $, ", \ or ` (not pure data).
test.config.userSessionPathFiltered() {
  local fx bad="" got want; fx=$(test.suite.fixture.make usersessionpathfilter)
  mkdir -p "$fx/oosh/ng" "$fx/venv/bin" "$fx/conda/bin" "$fx/odd\$dir" "$fx/ok/bin"
  got=$( export HOME="$fx" BASH_FILE="/usr/bin/bash" VIRTUAL_ENV="$fx/venv" CONDA_PREFIX="$fx/conda"
         PATH="$fx/venv/bin:$fx/conda/bin:$fx/missing/bin:$fx/odd\$dir:$fx/ok/bin:/usr/bin:/bin" \
           private.config.path.line.absolute.get 2>/dev/null )
  want="export PATH=\"$fx/oosh:$fx/oosh/ng:$fx/ok/bin:/usr/bin:/bin\""
  [ "$got" = "$want" ] || bad=" got=[$got] want=[$want]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "venv, conda, missing and \$ segments dropped" || create.result 1 "filtered PATH line:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-PATH-FILTERED: venv, conda, missing and \$-holding segments stay out of the saved PATH" test.config.userSessionPathFiltered
expect 0 "venv, conda, missing and \$ segments dropped" \
  "starting this saves the session, so a polluted shell must not be frozen into the user's PATH"

# T-CONFIG-USER-SESSION-PATH-PHYSICAL-OOSH: the physical oosh folder is ~/oosh, absolute
# As in the shared line (T-CONFIG-PATH-LINE-PHYSICAL-OOSH): the shared tree on
# PATH under its physical name is ~/oosh — written as the real ~/oosh path.
test.config.userSessionPathPhysicalOosh() {
  local fx bad="" got want shared; fx=$(test.suite.fixture.make usersessionpathphys)
  shared="$fx/shared/Once.sh/dev.config"
  mkdir -p "$shared/ng" "$shared/init" "$fx/home"; ln -s "$shared" "$fx/home/oosh"
  got=$( export HOME="$fx/home" BASH_FILE="/usr/bin/bash"
         PATH="$shared:$shared/ng:$shared/init:/usr/bin:/bin" private.config.path.line.absolute.get 2>/dev/null )
  want="export PATH=\"$fx/home/oosh:$fx/home/oosh/ng:$fx/home/oosh/init:/usr/bin:/bin\""
  [ "$got" = "$want" ] || bad=" got=[$got] want=[$want]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the physical oosh folder is written as the real ~/oosh" || create.result 1 "physical oosh:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-PATH-PHYSICAL-OOSH: the physical oosh folder is written as the real ~/oosh path" test.config.userSessionPathPhysicalOosh
expect 0 "the physical oosh folder is written as the real ~/oosh" \
  "after oo mode the old branch's physical su/init must not stay first"

# T-CONFIG-USER-SESSION-SAVE: config.session.save writes the user's own session file
# ~/.config/oosh/user.session.env holds exactly the user's real PATH and their
# OOSH_MODE (the branch their ~/oosh points at) — pure data that passes
# config.validate and that a plain sh can source.
test.config.userSessionSave() {
  local fx bad="" f got; fx=$(test.suite.fixture.make usersessionsave)
  mkdir -p "$fx/oosh/ng"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" BASH_FILE="/usr/bin/bash" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin"
    config.session.save >/dev/null 2>&1 ) || bad="$bad rc=$?"
  f="$fx/.config/oosh/user.session.env"
  got=$(cat "$f" 2>/dev/null)
  [ "$got" = "export PATH=\"$fx/oosh:$fx/oosh/ng:/usr/bin:/bin\"
export OOSH_MODE=\"feature/x\"" ] || bad="$bad content=[$(tr '\n' '|' < "$f" 2>/dev/null)]"
  config.validate "$f" >/dev/null 2>&1 || bad="$bad not-pure-data"
  got=$(env -i sh -c ". \"$f\"; echo \"\$PATH|\$OOSH_MODE\"" 2>&1)
  [ "$got" = "$fx/oosh:$fx/oosh/ng:/usr/bin:/bin|feature/x" ] || bad="$bad sh=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the session file holds the real PATH and OOSH_MODE, pure data" || create.result 1 "session save:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-SAVE: config session.save writes the real PATH and OOSH_MODE into the user's own file" test.config.userSessionSave
expect 0 "the session file holds the real PATH and OOSH_MODE, pure data" \
  "each user's PATH and branch live in their own ~/.config/oosh/user.session.env"

# T-CONFIG-USER-SESSION-SAVE-CARRIES-MODE: a shell without OOSH_MODE keeps the saved one
# A writer does not throw away what it held: with no OOSH_MODE in the shell the
# value comes from the user's existing session file, else from a host that
# still keeps it in the shared oosh.env (before the split).
test.config.userSessionSaveCarriesMode() {
  local fx bad="" f; fx=$(test.suite.fixture.make usersessioncarry)
  f="$fx/.config/oosh/user.session.env"; mkdir -p "$fx/.config/oosh" "$fx/config"
  printf '%s\n' 'export PATH="/usr/bin:/bin"' 'export OOSH_MODE="fromSession"' > "$f"
  ( unset OOSH_MODE; export HOME="$fx" CONFIG_PATH="$fx/config" PATH="/usr/bin:/bin"
    config.session.save >/dev/null 2>&1 )
  grep -qx 'export OOSH_MODE="fromSession"' "$f" || bad="$bad session=[$(tr '\n' '|' < "$f")]"
  rm -f "$f" "$fx/.config/oosh/oosh.session.env"; printf '%s\n' 'export OOSH_MODE="fromShared"' > "$fx/config/oosh.env"
  ( unset OOSH_MODE; export HOME="$fx" CONFIG_PATH="$fx/config" PATH="/usr/bin:/bin"
    config.session.save >/dev/null 2>&1 )
  grep -qx 'export OOSH_MODE="fromShared"' "$f" 2>/dev/null || bad="$bad shared=[$(tr '\n' '|' < "$f" 2>/dev/null)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "OOSH_MODE carried from the session file, else the shared oosh.env" || create.result 1 "carry:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-SAVE-CARRIES-MODE: a shell without OOSH_MODE keeps the saved one" test.config.userSessionSaveCarriesMode
expect 0 "OOSH_MODE carried from the session file, else the shared oosh.env" \
  "a save from a shell without OOSH_MODE must not empty the user's branch"

# T-CONFIG-USER-SESSION-SAVE-FOREIGN-HOME: a HOME that is not the caller's is refused
# sudo on macOS keeps the invoking user's HOME: root would write a root-owned
# file into somebody else's ~/.config/oosh. The writer only writes a HOME the
# caller owns ([ -O ]: owned by the EFFECTIVE uid — for root too, root does not
# "own everything"). Root gives a fixture home to uid 65534 (numeric: no user
# of that name needs to exist); a normal user cannot give a file away, so their
# foreign home is /, which root owns. Same assertions for both.
test.config.userSessionSaveForeignHome() {
  local fx home bad="" rc
  fx=$(test.suite.fixture.make usersessionforeign); home="$fx/home"; mkdir -p "$home"
  if [ "$(id -u)" = "0" ]; then chown 65534 "$home" || bad="$bad chown-65534-failed"; else home="/"; fi
  ( export HOME="$home"; config.session.save >/dev/null 2>&1 ); rc=$?
  [ "$rc" = 1 ] || bad="$bad rc=$rc"
  [ -e "$home/.config/oosh/user.session.env" ] && bad="$bad user.session.env-written"
  [ -e "$home/.config/oosh/oosh.session.env" ] && bad="$bad oosh.session.env-written"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a HOME the caller does not own is refused" || create.result 1 "foreign home:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-SAVE-FOREIGN-HOME: a HOME the caller does not own is refused" test.config.userSessionSaveForeignHome
expect 0 "a HOME the caller does not own is refused" "sudo on macOS keeps the user's HOME — root must not write into it"

# T-CONFIG-USER-SESSION-FILE-ENSURE: every user has a user.session.env, so the chain needs no guard
# user.env will chain ~/.config/oosh/user.session.env unguarded (env files are
# pure data), and `.` of a missing file ends a plain sh — so config init.user and
# the install create it for every user, as log.session.env. In the user's OWN
# hop it gets real content: their PATH and the branch THEIR ~/oosh points at.
# For a home that is not the caller's it is only created, never written for
# somebody else. An existing file is never overwritten.
test.config.userSessionFileEnsure() {
  local fx bad="" f got; fx=$(test.suite.fixture.make usersessionensure)
  f="$fx/other/.config/oosh/user.session.env"; mkdir -p "$fx/other"
  private.config.session.file.ensure "$fx/other" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -f "$f" ] || bad="$bad foreign-not-created"
  [ -s "$f" ] && bad="$bad foreign-written"
  [ -f "$fx/other/.config/oosh/log.session.env" ] || bad="$bad log-session-missing"
  printf 'export OOSH_MODE="kept"\n' > "$f"
  private.config.session.file.ensure "$fx/other" >/dev/null 2>&1
  [ "$(cat "$f")" = 'export OOSH_MODE="kept"' ] || bad="$bad overwritten"
  mkdir -p "$fx/branches/featureY/ng" "$fx/own/.config/oosh"; ln -s "$fx/branches/featureY" "$fx/own/oosh"
  : > "$fx/own/.config/oosh/user.session.env"   # an EMPTY own file is filled too
  ( unset OOSH_MODE; export HOME="$fx/own" CONFIG_PATH="$fx/own/config" BASH_FILE="/usr/bin/bash" PATH="/usr/bin:/bin"
    private.config.session.file.ensure "$HOME" >/dev/null 2>&1 )
  got=$(cat "$fx/own/.config/oosh/user.session.env" 2>/dev/null)
  [ "$got" = "export PATH=\"$fx/own/oosh:$fx/own/oosh/ng:/usr/bin:/bin\"
export OOSH_MODE=\"featureY\"" ] || bad="$bad own=[$(printf '%s' "$got" | tr '\n' '|')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "created for every user, filled in their own hop, never overwritten" || create.result 1 "user session file:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-FILE-ENSURE: every user gets a user.session.env, filled in their own hop" test.config.userSessionFileEnsure
expect 0 "created for every user, filled in their own hop, never overwritten" \
  "user.env chains it unguarded — a plain sh ends on a missing file"

# T-CONFIG-SESSION-WRITES-ONCE: ensure only creates and first-fills; content is config.session.save's
# An empty oosh.session.env is legal (no branch derivable: no ~/oosh here), and
# ensure used to call config.session.save whenever user.session.env OR
# oosh.session.env was empty — so every ensure rewrote user.session.env, and a
# full config save (ensure inside `config save log`, then config.session.save at
# its end) wrote both files twice. Counted with a wrapper that records each call
# and then runs the real config.session.save.
test.config.sessionWritesOnce() {
  local fx bad="" n
  fx=$(test.suite.fixture.make sessionwritesonce); mkdir -p "$fx/config" "$fx/.config/oosh"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/usr/bin/bash" PATH="/usr/bin:/bin"; unset OOSH_MODE
    private.config.homes.list() { :; }   # an open gate: no other user
    eval "test.config.realSessionSave() $(declare -f config.session.save | tail -n +2)"
    config.session.save() { echo call >> "$fx/count"; test.config.realSessionSave "$@"; }
    config.save; echo "first=$(wc -l < "$fx/count")" > "$fx/first"; : > "$fx/count"
    config.save; echo "second=$(wc -l < "$fx/count")" > "$fx/second"; : > "$fx/count"
    touch -t 200001010000 "$fx/.config/oosh/user.session.env" "$fx/.config/oosh/oosh.session.env"
    touch -t 200001010001 "$fx/marker"
    private.config.session.file.ensure "$HOME"; private.config.session.file.ensure "$HOME"
  ) >/dev/null 2>&1
  n=$(tr -d ' ' < "$fx/first" 2>/dev/null); [ "$n" = "first=1" ] || bad="$bad fresh-save-$n"
  n=$(tr -d ' ' < "$fx/second" 2>/dev/null); [ "$n" = "second=1" ] || bad="$bad steady-save-$n"
  [ -s "$fx/.config/oosh/user.session.env" ] || bad="$bad user.session-empty"
  [ -s "$fx/.config/oosh/oosh.session.env" ] && bad="$bad oosh.session-not-empty"
  [ -s "$fx/count" ] && bad="$bad ensure-called-save=$(wc -l < "$fx/count" | tr -d ' ')"
  [ "$fx/.config/oosh/user.session.env" -nt "$fx/marker" ] && bad="$bad ensure-rewrote-user.session"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "one config save writes the session files once; ensure rewrites nothing" || create.result 1 "session writes:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SESSION-WRITES-ONCE: one config save writes each session file once; a second ensure rewrites nothing" test.config.sessionWritesOnce
expect 0 "one config save writes the session files once; ensure rewrites nothing" \
  "an empty oosh.session.env is legal — ensure rewrote user.session.env on every call"

# T-CONFIG-USER-SESSION-SPLIT: user.env forks like log.env — shared values shared, the user's own last
# The boss's split (2026-10-02): the shared user.env keeps the anchors and
# BASH_FILE in their $HOME form and has NO PATH line; its LAST line chains the
# user's own ~/.config/oosh/user.session.env, which holds their real PATH and
# their OOSH_MODE. The shared oosh.env no longer carries OOSH_MODE (the last
# saver's branch won for every user). Twice, so the chain stays exactly once.
test.config.userSessionSplit() {
  local fx bad="" u s; fx=$(test.suite.fixture.make usersessionsplit); mkdir -p "$fx/config" "$fx/oosh/ng" "$fx/.config/oosh"
  : > "$fx/.config/oosh/log.session.env"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/usr/bin/bash" OOSH_MODE="dev" PATH="$fx/oosh:/usr/bin:/bin"
    private.config.homes.list() { :; }   # an open gate: no other user
    config.save; config.save ) >/dev/null 2>&1
  u="$fx/config/user.env"; s="$fx/.config/oosh/user.session.env"
  grep -q '^export PATH=' "$u" 2>/dev/null && bad="$bad path-in-user.env"
  [ "$(tail -n 1 "$u" 2>/dev/null)" = '. $HOME/.config/oosh/user.session.env' ] || bad="$bad chain-not-last=[$(tail -n 1 "$u" 2>/dev/null)]"
  [ "$(grep -c 'user.session.env' "$u" 2>/dev/null)" = 1 ] || bad="$bad chain-count=$(grep -c 'user.session.env' "$u" 2>/dev/null)"
  grep -q '^export OOSH_MODE=' "$fx/config/oosh.env" 2>/dev/null && bad="$bad mode-in-shared-oosh.env"
  [ "$(cat "$s" 2>/dev/null)" = "export PATH=\"$fx/oosh:$fx/oosh/ng:/usr/bin:/bin\"" ] || bad="$bad session=[$(tr '\n' '|' < "$s" 2>/dev/null)]"
  [ "$(tail -n 1 "$fx/config/oosh.env" 2>/dev/null)" = '. $HOME/.config/oosh/oosh.session.env' ] || bad="$bad oosh-chain-not-last"
  [ "$(cat "$fx/.config/oosh/oosh.session.env" 2>/dev/null)" = 'export OOSH_MODE="dev"' ] || bad="$bad oosh.session=[$(tr '\n' '|' < "$fx/.config/oosh/oosh.session.env" 2>/dev/null)]"
  config.validate "$u" >/dev/null 2>&1 || bad="$bad user.env-not-pure-data"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "shared user.env without PATH, the user's session file chained last" || create.result 1 "split:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-SPLIT: the shared user.env has no PATH and chains the user's own session file last" test.config.userSessionSplit
expect 0 "shared user.env without PATH, the user's session file chained last" \
  "one shared user.env gave every user the saver's PATH and branch"

# T-CONFIG-USER-SESSION-DASH-START: a plain sh starts from the split config
# The chain is pure data and unguarded: with HOME set, `. ~/config/user.env` in a
# plain sh yields the user's real PATH and OOSH_MODE, with nothing on stderr.
test.config.userSessionDashStart() {
  local fx bad="" got; fx=$(test.suite.fixture.make usersessiondash); mkdir -p "$fx/config" "$fx/oosh/ng" "$fx/.config/oosh"
  : > "$fx/.config/oosh/log.session.env"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/usr/bin/bash" OOSH_MODE="dev" PATH="$fx/oosh:/usr/bin:/bin"
    private.config.homes.list() { :; }   # an open gate: no other user
    config.save ) >/dev/null 2>&1
  got=$(env -i HOME="$fx" sh -c ". \"$fx/config/user.env\"; echo \"\$PATH|\$OOSH_MODE\"" 2>&1)
  [ "$got" = "$fx/oosh:$fx/oosh/ng:/usr/bin:/bin|dev" ] || bad=" got=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a plain sh gets the real PATH and OOSH_MODE from the split config" || create.result 1 "sh start:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-DASH-START: a plain sh starts from the split config" test.config.userSessionDashStart
expect 0 "a plain sh gets the real PATH and OOSH_MODE from the split config" "user.env chains user.session.env unguarded, as pure data"

# T-CONFIG-USER-SESSION-GATE: the shared user.env switches only when nobody would be left without a file
# The chain to ~/.config/oosh/user.session.env is unguarded, and a plain sh ends
# on `.` of a missing file. So the switch waits until every OTHER user linked to
# the same shared config has a filled file; a home linked elsewhere does not
# count; an empty file does not count; a home the caller cannot look into is
# not proven (0750 homes — only root can switch a multi-user host).
test.config.userSessionGate() {
  local fx bad=""; fx=$(test.suite.fixture.make usersessiongate)
  mkdir -p "$fx/shared" "$fx/other" "$fx/a/.config/oosh" "$fx/b" "$fx/c"
  ln -s "$fx/shared" "$fx/a/config"; ln -s "$fx/shared" "$fx/b/config"; ln -s "$fx/other" "$fx/c/config"
  printf 'export PATH="/usr/bin"\n' > "$fx/a/.config/oosh/user.session.env"
  ( private.config.homes.list() { printf '%s\n' "$fx/a" "$fx/c"; }
    private.config.session.chain.ready "$fx/shared" ) || bad="$bad ready-refused"
  ( private.config.homes.list() { printf '%s\n' "$fx/a" "$fx/b" "$fx/c"; }
    private.config.session.chain.ready "$fx/shared" ) && bad="$bad missing-accepted"
  mkdir -p "$fx/b/.config/oosh"; : > "$fx/b/.config/oosh/user.session.env"
  ( private.config.homes.list() { printf '%s\n' "$fx/a" "$fx/b"; }
    private.config.session.chain.ready "$fx/shared" ) && bad="$bad empty-accepted"
  if [ "$(id -u)" != "0" ]; then
    mkdir -p "$fx/d"; chmod 000 "$fx/d"
    ( private.config.homes.list() { printf '%s\n' "$fx/a" "$fx/d"; }
      private.config.session.chain.ready "$fx/shared" ) && bad="$bad uninspectable-accepted"
    chmod 755 "$fx/d"
  fi
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the switch waits for every linked user's filled file" || create.result 1 "gate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-GATE: the shared user.env switches only when every linked user has a filled user.session.env" test.config.userSessionGate
expect 0 "the switch waits for every linked user's filled file" \
  "switching while another user has no session file breaks their plain-sh start"

# T-CONFIG-USER-SESSION-MIGRATE: an old shared config switches in place, once
# A host whose shared files were written before the split: PATH leaves user.env,
# OOSH_MODE leaves oosh.env, the user's own file is chained last — in place
# (owner, group and mode kept), idempotent; and nothing changes while the gate
# is closed.
test.config.userSessionMigrate() {
  local fx bad="" u o before; fx=$(test.suite.fixture.make usersessionmigrate)
  mkdir -p "$fx/shared" "$fx/b"; u="$fx/shared/user.env"; o="$fx/shared/oosh.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export PATH="$HOME/oosh:$HOME/oosh/ng:$PATH"' \
    'export BASH_FILE="/usr/bin/bash"' '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' > "$u"
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_MODE="dev"' 'export OOSH_OS="linux-gnu"' > "$o"
  chmod 664 "$u" "$o"
  ln -s "$fx/shared" "$fx/b/config"
  before=$(cat "$u" "$o")
  ( private.config.homes.list() { echo "$fx/b"; }
    private.config.user.session.migrate "$fx/shared" ) && bad="$bad closed-gate-migrated"
  [ "$(cat "$u" "$o")" = "$before" ] || bad="$bad closed-gate-changed"
  ( private.config.homes.list() { :; }
    private.config.user.session.migrate "$fx/shared" ) || bad="$bad rc=$?"
  [ "$(cat "$u")" = 'export CONFIG_PATH="$HOME/config"
export BASH_FILE="/usr/bin/bash"
. $CONFIG_PATH/oosh.env
. $CONFIG_PATH/log.env
. $HOME/.config/oosh/user.session.env' ] || bad="$bad user.env=[$(tr '\n' '|' < "$u")]"
  [ "$(cat "$o")" = 'export OOSH_DIR="$HOME/oosh"
export OOSH_OS="linux-gnu"' ] || bad="$bad oosh.env=[$(tr '\n' '|' < "$o")]"
  [ "$(ls -l "$u" | cut -c1-10)" = "-rw-rw-r--" ] || bad="$bad mode-changed"
  before=$(cat "$u" "$o")
  ( private.config.homes.list() { :; }
    private.config.user.session.migrate "$fx/shared" ) || bad="$bad second-rc=$?"
  [ "$(cat "$u" "$o")" = "$before" ] || bad="$bad not-idempotent"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "PATH and OOSH_MODE leave the shared files, the session chain comes last, once, in place" || create.result 1 "migrate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-MIGRATE: an old shared config switches to the forked user.env in place, once" test.config.userSessionMigrate
expect 0 "PATH and OOSH_MODE leave the shared files, the session chain comes last, once, in place" \
  "existing hosts must reach the forked user.env without a reinstall"

# T-CONFIG-USER-SESSION-SAVE-GATED: config save keeps the old layout while the gate is closed
# Until every linked user has their own file, a full config save writes the
# shared user.env as before (its PATH line, no session chain) and keeps
# OOSH_MODE in the shared oosh.env — other users' shells still read it there.
# The saver's own session file is written either way.
test.config.userSessionSaveGated() {
  local fx bad=""; fx=$(test.suite.fixture.make usersessiongated)
  mkdir -p "$fx/config" "$fx/oosh/ng" "$fx/.config/oosh" "$fx/b"; : > "$fx/.config/oosh/log.session.env"
  ln -s "$fx/config" "$fx/b/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"
    export BASH_FILE="/usr/bin/bash" OOSH_MODE="dev" PATH="$fx/oosh:/usr/bin:/bin"
    private.config.homes.list() { echo "$fx/b"; }
    config.save ) >/dev/null 2>&1
  grep -q '^export PATH=' "$fx/config/user.env" 2>/dev/null || bad="$bad no-path-line"
  grep -q 'user.session.env' "$fx/config/user.env" 2>/dev/null && bad="$bad chained-too-early"
  grep -q '^export OOSH_MODE="dev"' "$fx/config/oosh.env" 2>/dev/null || bad="$bad mode-left-shared-oosh.env"
  grep -q '^export OOSH_MODE="dev"' "$fx/.config/oosh/user.session.env" 2>/dev/null || bad="$bad own-file-not-written"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "closed gate: the old shared layout, the saver's own file written" || create.result 1 "gated save:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-SAVE-GATED: config save keeps the old shared layout while another user has no session file" test.config.userSessionSaveGated
expect 0 "closed gate: the old shared layout, the saver's own file written" \
  "a non-root save on a multi-user host must not switch the shared user.env"

# T-BASHRC-THIS-FIRST: .bashrc follows the boot order — an old bash hands over, then `this`
# `env -i sh`, then `bash`: no HOME. The .bashrc used to source ~/config/user.env
# first, so every $HOME/… became /config, /oosh. The order is now bash → this →
# log → debug → config: after the interactive guard, the bash-3.2 handover
# (before any bash-4 syntax), then `unset CONFIG; source ~/oosh/this` (tilde,
# HOME may be empty); no `source "$CONFIG"` of its own.
test.config.bashrcThisFirst() {
  local t="$OOSH_DIR/templates/user/bashrcTemplate" bad="" guard hand unset src quote
  guard=$(grep -n '^\*) return ;;' "$t" | head -1 | cut -d: -f1)
  hand=$(grep -n 'BASH_VERSINFO\[0\]' "$t" | head -1 | cut -d: -f1)
  unset=$(grep -n '^unset CONFIG$' "$t" | head -1 | cut -d: -f1)
  src=$(grep -n '^  source ~/oosh/this$' "$t" | head -1 | cut -d: -f1)
  quote=$(grep -n '^private.quoteAll()' "$t" | head -1 | cut -d: -f1)
  [ -n "$guard" ] && [ -n "$hand" ] && [ -n "$unset" ] && [ -n "$src" ] && [ -n "$quote" ] || bad="$bad missing=[guard:$guard hand:$hand unset:$unset this:$src quote:$quote]"
  [ -z "$bad" ] && { [ "$guard" -lt "$hand" ] && [ "$hand" -lt "$unset" ] && [ "$unset" -lt "$src" ] && [ "$src" -lt "$quote" ]; } \
    || bad="$bad order=[guard:$guard hand:$hand unset:$unset this:$src quote:$quote]"
  grep -q 'source "\$CONFIG"' "$t" && bad="$bad sources-CONFIG-itself"
  [ -z "$bad" ] && create.result 0 "guard, bash handover, this, then the rest" || create.result 1 "bashrc order:$bad"
  return $(result)
}
test.case $level "T-BASHRC-THIS-FIRST: the .bashrc hands an old bash over, then loads this before anything else" test.config.bashrcThisFirst
expect 0 "guard, bash handover, this, then the rest" \
  "env -i sh, then bash: the config was read before anything derived HOME"

# T-BASHRC-ENV-I-INTERACTIVE: `env -i sh`, then `bash` — an oosh shell
# The user's scenario, behaviourally: an interactive bash in an EMPTY
# environment (no HOME) starting from the .bashrc template comes up with the
# real home, the config, ~/oosh first on PATH and the log API. Uses the real
# ~/oosh of the user running the test; the runner puts their session files back.
test.config.bashrcEnvIInteractive() {
  local home out want
  home=$(eval echo ~"$(id -un)")
  if [ ! -f "$home/oosh/this" ]; then
    create.result 0 "an empty shell's bash is an oosh shell (no ~/oosh here — nothing to start)"
    return $(result)
  fi
  # The question comes as INPUT, as a person types it: on macOS `env -i` finds
  # /bin/bash 3.2, whose .bashrc execs the newer bash `-i` — a `-c` command
  # would be lost in that handover; stdin goes along (macOS VM, 2026-10-06).
  out=$(cd / && printf '%s\n' 'printf "\nRESULT %s|%s|%s|%s\n" "$HOME" "$CONFIG" "${PATH%%:*}" "$(type -t log.level)"' 'exit' \
    | env -i bash --rcfile "$OOSH_DIR/templates/user/bashrcTemplate" -i 2>/dev/null \
    | sed -n 's/^RESULT //p')
  want="$home|$home/config/user.env|$home/oosh|function"
  [ "$out" = "$want" ] && create.result 0 "an empty shell's bash is an oosh shell" \
                       || create.result 1 "env -i bash -i: got [$out] want [$want]"
  return $(result)
}
test.case $level "T-BASHRC-ENV-I-INTERACTIVE: env -i, then an interactive bash, comes up as an oosh shell" test.config.bashrcEnvIInteractive
expect 0 "an empty shell's bash is an oosh shell" \
  "env -i sh, then bash: /config/oosh.env: No such file or directory"

# T-BASHRC-LOG-ONCE: a shell started from the .bashrc template loads log once and leaves an unchanged log.session.env alone
# `source ~/oosh/this` loads log (this → debug → log); the template sourced
# log a second time and rewrote log.session.env on every interactive shell.
# A fixture home: ~/oosh is the tree entry by entry, its log a wrapper that
# counts each source; the config is generated into it. Two shells: each has
# the log API with ONE source of log in its own process (a script it starts,
# like line init, has its own), and the second leaves the session file
# as the first wrote it (inode and mtime). The shell is "$BASH", the bash the
# suite runs under (4+): PATH's `bash` is /bin/bash 3.2 on macOS, whose
# hand-over to the newer bash drops --rcfile, so no template would run.
test.config.bashrcLogOnce() {
  local fx bad="" entry out before after
  fx=$(test.suite.fixture.make test.config.bashrcLogOnce); mkdir -p "$fx/oosh" "$fx/config"
  for entry in "$OOSH_DIR"/*; do
    [ "${entry##*/}" = log ] || ln -s "$entry" "$fx/oosh/${entry##*/}"
  done
  printf '%s\n' 'echo "$$" >> "$HOME/log.sourced"' "source '$OOSH_DIR/log' \"\$@\"" > "$fx/oosh/log"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env" OOSH_MODE=dev
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1 ) >/dev/null 2>&1
  test.config.bashrcLogOnce.shell() { # — one interactive shell from the template in the fixture home; echo what it reports
    rm -f "$fx/log.sourced"
    (cd / && printf '%s\n' 'printf "\nRESULT %s|%s\n" "$(type -t log.level)" "$(grep -c "^$$\$" "$HOME/log.sourced")"' 'exit' \
      | env -i HOME="$fx" PATH="/usr/bin:/bin" "$BASH" --rcfile "$OOSH_DIR/templates/user/bashrcTemplate" -i 2>/dev/null \
      | sed -n 's/^RESULT //p')
  }
  out=$(test.config.bashrcLogOnce.shell)
  [ "$out" = "function|1" ] || bad="$bad first-shell=[$out]"
  touch -t 200001010000 "$fx/.config/oosh/log.session.env"; before=$(ls -li "$fx/.config/oosh/log.session.env" 2>&1)
  out=$(test.config.bashrcLogOnce.shell)
  [ "$out" = "function|1" ] || bad="$bad second-shell=[$out]"
  after=$(ls -li "$fx/.config/oosh/log.session.env" 2>&1)
  [ "$after" = "$before" ] || bad="$bad session-rewritten=[$before]->[$after]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "log loaded once per shell; an unchanged log.session.env left alone" || create.result 1 "bashrc log:$bad"
  return $(result)
}
test.case $level "T-BASHRC-LOG-ONCE: a shell from the .bashrc template loads log once and leaves an unchanged log.session.env alone" test.config.bashrcLogOnce
expect 0 "log loaded once per shell; an unchanged log.session.env left alone" \
  "every interactive shell sourced log twice and rewrote log.session.env"

# T-BASHRC-LOG-DEVICE-KEPT: a file chosen with `log device` survives the next terminal; a terminal is never saved
# The owner's rule: a terminal's log device is never saved, only a file you
# chose with `log device <file>` is remembered. But every new terminal's
# .bashrc ran log.session.save with ITS terminal device, the line was left out,
# and the file was rewritten WITHOUT the chosen device — so a process without a
# terminal (`sh -c '. ~/config/user.env; …'`, cron), the only reader the saved
# value is for, never saw it. Real starts, as T-BASHRC-LOG-ONCE ("$BASH"): a fixture home,
# shells from the .bashrc template (their device is their own output, a
# session device). (1) log.device <file> + log.name in the shell, then a new
# terminal: the line is still there, the terminal uses its own device; (2) a
# tty-less sh reads the file; (3) the typed `log device <file>` (a child
# process — the only thing it can change is the saved line) saves it; (4)
# `log device /dev/stderr` (a terminal) removes the line; (5) two more
# terminals leave the file alone and write no LOG_DEVICE line.
test.config.bashrcLogDeviceKept() {
  local fx bad="" entry out f before after
  fx=$(test.suite.fixture.make test.config.bashrcLogDeviceKept); mkdir -p "$fx/oosh" "$fx/config"; f="$fx/.config/oosh/log.session.env"
  for entry in "$OOSH_DIR"/*; do ln -s "$entry" "$fx/oosh/${entry##*/}"; done
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env" OOSH_MODE=dev
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1 ) >/dev/null 2>&1
  test.config.bashrcLogDeviceKept.shell() { # <commands> — one interactive shell from the template in the fixture home; echo its LOG_DEVICE after <commands>
    (cd / && printf '%s\n' "$1" 'printf "\nRESULT %s\n" "$LOG_DEVICE"' 'exit' \
      | env -i HOME="$fx" PATH="/usr/bin:/bin" "$BASH" --rcfile "$OOSH_DIR/templates/user/bashrcTemplate" -i 2>/dev/null \
      | sed -n 's/^RESULT //p')
  }
  test.config.bashrcLogDeviceKept.line() { grep '^export LOG_DEVICE=' "$f" 2>/dev/null; }
  # The functions, in the shell itself: the device of THIS shell is the file
  # when log.name saves (the typed `log …` is a child process, below).
  test.config.bashrcLogDeviceKept.shell "log.device $fx/x.log >/dev/null 2>&1; log.name me@box >/dev/null 2>&1" >/dev/null
  [ "$(test.config.bashrcLogDeviceKept.line)" = "export LOG_DEVICE=\"$fx/x.log\"" ] || bad="$bad chosen-not-saved=[$(test.config.bashrcLogDeviceKept.line)]"
  out=$(test.config.bashrcLogDeviceKept.shell ":")
  [ "$(test.config.bashrcLogDeviceKept.line)" = "export LOG_DEVICE=\"$fx/x.log\"" ] || bad="$bad next-terminal-erased=[$(test.config.bashrcLogDeviceKept.line)]"
  [ -n "$out" ] && [ "$out" != "$fx/x.log" ] || bad="$bad terminal-not-its-own=[$out]"
  grep -qx 'export LOG_NAME="me@box"' "$f" || bad="$bad name-lost"
  out=$(env -i HOME="$fx" PATH="/usr/bin:/bin" sh -c ". \"$fx/config/user.env\" >/dev/null 2>&1; printf '%s' \"\$LOG_DEVICE\"" </dev/null 2>/dev/null)
  [ "$out" = "$fx/x.log" ] || bad="$bad tty-less=[$out]"
  test.config.bashrcLogDeviceKept.shell "log device $fx/y.log >/dev/null 2>&1" >/dev/null
  [ "$(test.config.bashrcLogDeviceKept.line)" = "export LOG_DEVICE=\"$fx/y.log\"" ] || bad="$bad log-device-alone-not-saved=[$(test.config.bashrcLogDeviceKept.line)]"
  test.config.bashrcLogDeviceKept.shell "log device /dev/stderr >/dev/null 2>&1" >/dev/null
  [ -z "$(test.config.bashrcLogDeviceKept.line)" ] || bad="$bad terminal-choice-kept=[$(test.config.bashrcLogDeviceKept.line)]"
  test.config.bashrcLogDeviceKept.shell ":" >/dev/null
  touch -t 200001010000 "$f"; before=$(ls -li "$f" 2>&1)
  test.config.bashrcLogDeviceKept.shell ":" >/dev/null
  after=$(ls -li "$f" 2>&1)
  [ "$after" = "$before" ] || bad="$bad two-terminals-rewrote=[$before]->[$after]"
  [ -z "$(test.config.bashrcLogDeviceKept.line)" ] || bad="$bad terminal-saved=[$(test.config.bashrcLogDeviceKept.line)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a chosen file survives new terminals and reaches a tty-less sh; a terminal choice removes it" || create.result 1 "log device kept:$bad"
  return $(result)
}
test.case $level "T-BASHRC-LOG-DEVICE-KEPT: a file chosen with log device survives the next terminal; a terminal is never saved" test.config.bashrcLogDeviceKept
expect 0 "a chosen file survives new terminals and reaches a tty-less sh; a terminal choice removes it" \
  "the next terminal's .bashrc rewrote log.session.env without the chosen device"

# T-CONFIG-USER-SESSION-PATH-NO-SU: a user's PATH never holds ~/oosh/su — root's tools
# `this` puts ~/oosh/su on PATH for root only. The as-user hops of root
# (sudo oo update → private.config.session.files.ensure.all) keep root's PATH,
# so every user's user.session.env got …/oosh/su (macOS VM, 2026-10-02).
# A save by a user who is not root drops it.
test.config.userSessionPathNoSu() {
  local fx bad="" got want
  if [ "$(id -u)" = "0" ]; then create.result 0 "a user's saved PATH has no ~/oosh/su"; return $(result); fi
  fx=$(test.suite.fixture.make usersessionnosu); mkdir -p "$fx/oosh/ng" "$fx/oosh/su" "$fx/oosh/init"
  got=$( export HOME="$fx" BASH_FILE="/usr/bin/bash"
         PATH="$fx/oosh/su:$fx/oosh:$fx/oosh/init:/usr/bin:/bin" private.config.path.line.absolute.get 2>/dev/null )
  want="export PATH=\"$fx/oosh:$fx/oosh/ng:$fx/oosh/init:/usr/bin:/bin\""
  [ "$got" = "$want" ] || bad=" got=[$got] want=[$want]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a user's saved PATH has no ~/oosh/su" || create.result 1 "su on a user's PATH:$bad"
  return $(result)
}
test.case $level "T-CONFIG-USER-SESSION-PATH-NO-SU: a user's saved PATH never holds root's ~/oosh/su" test.config.userSessionPathNoSu
expect 0 "a user's saved PATH has no ~/oosh/su" "root's PATH leaked into every user's user.session.env through the as-user hops"

# T-CONFIG-OOSH-SESSION-SAVE: OOSH_MODE goes into the user's own oosh.session.env
# OOSH_MODE belongs to the oosh family: the shared oosh.env chains each user's
# ~/.config/oosh/oosh.session.env, as log.env chains log.session.env. Once the
# shared oosh.env chains it, user.session.env holds the PATH only; before that
# (the transition) OOSH_MODE goes into both, so no shell loses its branch.
test.config.ooshSessionSave() {
  local fx bad="" u o; fx=$(test.suite.fixture.make ooshsessionsave)
  mkdir -p "$fx/oosh/ng" "$fx/config"; u="$fx/.config/oosh/user.session.env"; o="$fx/.config/oosh/oosh.session.env"
  printf '%s\n' 'export OOSH_OS="linux-gnu"' '. $HOME/.config/oosh/oosh.session.env' > "$fx/config/oosh.env"
  # BASH_FILE pinned: on macOS the saved PATH carries the newer bash's folder
  # (/opt/homebrew/bin) — right there, but not what this test is about.
  ( export HOME="$fx" CONFIG_PATH="$fx/config" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" BASH_FILE="/usr/bin/bash"
    config.session.save >/dev/null 2>&1 ) || bad="$bad rc=$?"
  [ "$(cat "$o" 2>/dev/null)" = 'export OOSH_MODE="feature/x"' ] || bad="$bad oosh.session=[$(tr '\n' '|' < "$o" 2>/dev/null)]"
  [ "$(cat "$u" 2>/dev/null)" = "export PATH=\"$fx/oosh:$fx/oosh/ng:/usr/bin:/bin\"" ] || bad="$bad user.session=[$(tr '\n' '|' < "$u" 2>/dev/null)]"
  config.validate "$o" >/dev/null 2>&1 || bad="$bad not-pure-data"
  printf '%s\n' 'export OOSH_OS="linux-gnu"' > "$fx/config/oosh.env"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" BASH_FILE="/usr/bin/bash"
    config.session.save >/dev/null 2>&1 )
  grep -qx 'export OOSH_MODE="feature/x"' "$u" 2>/dev/null || bad="$bad transition-mode-missing-in-user.session"
  grep -qx 'export OOSH_MODE="feature/x"' "$o" 2>/dev/null || bad="$bad transition-mode-missing-in-oosh.session"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "OOSH_MODE in oosh.session.env, PATH alone in user.session.env once oosh.env chains it" || create.result 1 "oosh session save:$bad"
  return $(result)
}
test.case $level "T-CONFIG-OOSH-SESSION-SAVE: OOSH_MODE goes into the user's own oosh.session.env" test.config.ooshSessionSave
expect 0 "OOSH_MODE in oosh.session.env, PATH alone in user.session.env once oosh.env chains it" \
  "OOSH_MODE is an oosh variable — config list user.session showed it"

# T-CONFIG-OOSH-SESSION-CARRIES-MODE: a shell without OOSH_MODE keeps the saved one, oosh.session.env first
test.config.ooshSessionCarriesMode() {
  local fx bad=""; fx=$(test.suite.fixture.make ooshsessioncarry); mkdir -p "$fx/.config/oosh" "$fx/config"
  printf 'export OOSH_MODE="fromOosh"\n' > "$fx/.config/oosh/oosh.session.env"
  printf '%s\n' 'export PATH="/usr/bin:/bin"' 'export OOSH_MODE="fromUser"' > "$fx/.config/oosh/user.session.env"
  ( unset OOSH_MODE; export HOME="$fx" CONFIG_PATH="$fx/config" PATH="/usr/bin:/bin"
    config.session.save >/dev/null 2>&1 )
  grep -qx 'export OOSH_MODE="fromOosh"' "$fx/.config/oosh/oosh.session.env" || bad="$bad oosh.session=[$(tr '\n' '|' < "$fx/.config/oosh/oosh.session.env")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "OOSH_MODE carried from oosh.session.env first" || create.result 1 "carry:$bad"
  return $(result)
}
test.case $level "T-CONFIG-OOSH-SESSION-CARRIES-MODE: a shell without OOSH_MODE keeps the one in oosh.session.env" test.config.ooshSessionCarriesMode
expect 0 "OOSH_MODE carried from oosh.session.env first" "a save from a shell without OOSH_MODE must not empty the user's branch"

# T-CONFIG-OOSH-SESSION-FILE-ENSURE: every user has an oosh.session.env, filled in their own hop
test.config.ooshSessionFileEnsure() {
  local fx bad=""; fx=$(test.suite.fixture.make ooshsessionensure); mkdir -p "$fx/other"
  private.config.session.file.ensure "$fx/other" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -f "$fx/other/.config/oosh/oosh.session.env" ] || bad="$bad foreign-not-created"
  [ -s "$fx/other/.config/oosh/oosh.session.env" ] && bad="$bad foreign-written"
  mkdir -p "$fx/branches/featureY/ng" "$fx/own/config"; ln -s "$fx/branches/featureY" "$fx/own/oosh"
  ( unset OOSH_MODE; export HOME="$fx/own" CONFIG_PATH="$fx/own/config" BASH_FILE="/usr/bin/bash" PATH="/usr/bin:/bin"
    private.config.session.file.ensure "$HOME" >/dev/null 2>&1 )
  [ "$(cat "$fx/own/.config/oosh/oosh.session.env" 2>/dev/null)" = 'export OOSH_MODE="featureY"' ] || bad="$bad own=[$(tr '\n' '|' < "$fx/own/.config/oosh/oosh.session.env" 2>/dev/null)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oosh.session.env created for every user, filled in their own hop" || create.result 1 "oosh session file:$bad"
  return $(result)
}
test.case $level "T-CONFIG-OOSH-SESSION-FILE-ENSURE: every user gets an oosh.session.env, filled in their own hop" test.config.ooshSessionFileEnsure
expect 0 "oosh.session.env created for every user, filled in their own hop" "oosh.env chains it unguarded — a plain sh ends on a missing file"

# T-CONFIG-OOSH-SESSION-GATE: the oosh.env chain waits for every linked user's oosh.session.env
test.config.ooshSessionGate() {
  local fx bad=""; fx=$(test.suite.fixture.make ooshsessiongate)
  mkdir -p "$fx/shared" "$fx/a/.config/oosh" "$fx/b/.config/oosh"
  ln -s "$fx/shared" "$fx/a/config"; ln -s "$fx/shared" "$fx/b/config"
  : > "$fx/a/.config/oosh/oosh.session.env"
  ( private.config.homes.list() { printf '%s\n' "$fx/a" "$fx/b"; }
    private.config.session.chain.ready "$fx/shared" oosh ) && bad="$bad missing-accepted"
  : > "$fx/b/.config/oosh/oosh.session.env"
  ( private.config.homes.list() { printf '%s\n' "$fx/a" "$fx/b"; }
    private.config.session.chain.ready "$fx/shared" oosh ) || bad="$bad ready-refused"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the oosh chain waits for every linked user's oosh.session.env" || create.result 1 "oosh gate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-OOSH-SESSION-GATE: oosh.env chains oosh.session.env only when every linked user has one" test.config.ooshSessionGate
expect 0 "the oosh chain waits for every linked user's oosh.session.env" "a user without the file would lose their plain-sh start"

# T-CONFIG-OOSH-SESSION-MIGRATE: a switched config gets the oosh.env chain in place, once
test.config.ooshSessionMigrate() {
  local fx bad="" o before; fx=$(test.suite.fixture.make ooshsessionmigrate); mkdir -p "$fx/shared" "$fx/b"
  o="$fx/shared/oosh.env"
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_MODE="dev"' 'export OOSH_OS="linux-gnu"' > "$o"; chmod 664 "$o"
  ln -s "$fx/shared" "$fx/b/config"
  before=$(cat "$o")
  ( private.config.homes.list() { echo "$fx/b"; }
    private.config.oosh.session.migrate "$fx/shared" ) && bad="$bad closed-gate-migrated"
  [ "$(cat "$o")" = "$before" ] || bad="$bad closed-gate-changed"
  ( private.config.homes.list() { :; }
    private.config.oosh.session.migrate "$fx/shared" ) || bad="$bad rc=$?"
  [ "$(cat "$o")" = 'export OOSH_DIR="$HOME/oosh"
export OOSH_OS="linux-gnu"
. $HOME/.config/oosh/oosh.session.env' ] || bad="$bad oosh.env=[$(tr '\n' '|' < "$o")]"
  [ "$(ls -l "$o" | cut -c1-10)" = "-rw-rw-r--" ] || bad="$bad mode-changed"
  before=$(cat "$o")
  ( private.config.homes.list() { :; }; private.config.oosh.session.migrate "$fx/shared" )
  [ "$(cat "$o")" = "$before" ] || bad="$bad not-idempotent"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oosh.env chains oosh.session.env last, once, in place; OOSH_MODE out" || create.result 1 "oosh migrate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-OOSH-SESSION-MIGRATE: a shared oosh.env gets the oosh.session.env chain in place, once" test.config.ooshSessionMigrate
expect 0 "oosh.env chains oosh.session.env last, once, in place; OOSH_MODE out" "existing hosts reach the oosh session file without a reinstall"

# T-CONFIG-OOSH-CHAIN-KEPT: config save oosh keeps the oosh.session.env chain last, once
test.config.ooshChainKept() {
  local fx bad="" o; fx=$(test.suite.fixture.make ooshchainkept); mkdir -p "$fx/config"; o="$fx/config/oosh.env"
  printf '%s\n' 'export OOSH_OS="linux-gnu"' '. $HOME/.config/oosh/oosh.session.env' > "$o"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=oosh.env CONFIG="$o" OOSH_PROBE="kept"
    config.save oosh OOSH; config.save oosh OOSH ) >/dev/null 2>&1
  [ "$(tail -n 1 "$o")" = '. $HOME/.config/oosh/oosh.session.env' ] || bad="$bad chain-not-last=[$(tail -n 1 "$o")]"
  [ "$(grep -c 'oosh.session.env' "$o")" = 1 ] || bad="$bad chain-count=$(grep -c 'oosh.session.env' "$o")"
  grep -qx 'export OOSH_PROBE="kept"' "$o" || bad="$bad probe-missing"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "config save oosh keeps the oosh.session.env chain last, once" || create.result 1 "oosh chain:$bad"
  return $(result)
}
test.case $level "T-CONFIG-OOSH-CHAIN-KEPT: config save oosh keeps the oosh.session.env chain last, once" test.config.ooshChainKept
expect 0 "config save oosh keeps the oosh.session.env chain last, once" "oo mode saves oosh.env — the chain must survive it"

# T-CONFIG-ODOCKER-SG-NOT-SAVED: the sg re-run marker of odocker is never persisted
# odocker re-runs a call under `sg` with ODOCKER_SG=1 exported; a
# `config save odocker ODOCKER` inside that run (workspace.set) must not store it —
# nor ODOCKER_SOCKET, the test/override knob of private.odocker.socket.get.
test.config.odockerSgNotSaved() {
  local fx bad=""; fx=$(test.suite.fixture.make odockersg); mkdir -p "$fx/config"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=odocker.env CONFIG="$fx/config/odocker.env"
    export ODOCKER_WORKSPACES="/x/DockerWorkspaces" ODOCKER_SG=1 ODOCKER_SOCKET=/x/test.sock
    config.save odocker ODOCKER ) >/dev/null 2>&1
  grep -q '^export ODOCKER_SG=' "$fx/config/odocker.env" 2>/dev/null && bad="$bad sg-saved"
  grep -q '^export ODOCKER_SOCKET=' "$fx/config/odocker.env" 2>/dev/null && bad="$bad socket-saved"
  grep -q '^export ODOCKER_WORKSPACES=' "$fx/config/odocker.env" 2>/dev/null || bad="$bad workspaces-missing"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "ODOCKER_WORKSPACES saved, ODOCKER_SG and ODOCKER_SOCKET never" || create.result 1 "odocker save:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ODOCKER-SG-NOT-SAVED: odocker's sg re-run marker is never persisted" test.config.odockerSgNotSaved
expect 0 "ODOCKER_WORKSPACES saved, ODOCKER_SG and ODOCKER_SOCKET never" "a runtime marker or a test knob saved would come back into every shell"

# T-CONFIG-HOST-NAME-GET: the name of this computer for oosh
# The prompt showed a container's ID ([oosh 2a1023f6d45b], 2026-10-05); the boss
# wants its name (jolly_gagarin). Order: a given name, a container's Docker
# name (through the mounted socket), macOS' LocalHostName, the short host name.
test.config.hostNameGet() {
  local bad="" got
  test.config.hostNameGet.run() { # <os> <hostname> <docker answer|-> <?given>
    OS="$1" HN="$2" DA="$3" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export OOSH_OS="$OS"
      hostname() { echo "$HN"; }
      scutil()   { echo "Hannes-MacBook-Pro"; }
      docker()   { [ "$DA" = "-" ] && return 1; [ "$1 $2 $5" = "container inspect $HN" ] && echo "$DA"; }
      private.config.host.name.get "$1"' -- "$4" 2>/dev/null
  }
  got=$(test.config.hostNameGet.run linux-gnu 2a1023f6d45b "2a1023f6d45bfe00aa /jolly_gagarin")
  [ "$got" = "jolly_gagarin" ] || bad="$bad container=[$got]"
  got=$(test.config.hostNameGet.run linux-gnu hannesn-VirtualBox -)
  [ "$got" = "hannesn-VirtualBox" ] || bad="$bad bare=[$got]"
  got=$(test.config.hostNameGet.run linux-gnu web1 "9f00aa /web1")
  [ "$got" = "web1" ] || bad="$bad other-id=[$got]"
  got=$(test.config.hostNameGet.run darwin Hannes-MacBook-Pro.fritz.box -)
  [ "$got" = "Hannes-MacBook-Pro" ] || bad="$bad mac=[$got]"
  got=$(test.config.hostNameGet.run linux-gnu 2a1023f6d45b "2a1023f6d45bfe00aa /jolly_gagarin" myserver)
  [ "$got" = "myserver" ] || bad="$bad given=[$got]"
  [ -z "$bad" ] && create.result 0 "given, container name, macOS name, short host name" || create.result 1 "host name:$bad"
  return $(result)
}
test.case $level "T-CONFIG-HOST-NAME-GET: a container is named by its Docker name, a computer by its own name" test.config.hostNameGet
expect 0 "given, container name, macOS name, short host name" "the prompt showed a container's ID instead of its name"

# T-CONFIG-HOST-NAME-NO-HOSTNAME: without the hostname program the name comes from $HOSTNAME
# AlmaLinux 9's minimal image has no `hostname`: in exactly the container case
# the container getter gave up and the name fell back to "localhost". bash
# always has $HOSTNAME.
test.config.hostNameNoHostname() {
  local bad="" got
  test.config.hostNameNoHostname.run() { # <hostname value> <docker answer|->
    HN="$1" DA="$2" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export OOSH_OS=linux-gnu; HOSTNAME="$HN"
      command()  { [ "$1 $2" = "-v hostname" ] && return 1; builtin command "$@"; }
      hostname() { return 127; }   # the program is not there
      docker()   { [ "$DA" = "-" ] && return 1; [ "$1 $2 $5" = "container inspect $HN" ] && echo "$DA"; }
      private.config.host.name.get' 2>/dev/null
  }
  got=$(test.config.hostNameNoHostname.run abc123def456 "abc123def456ff00 /jolly_gagarin")
  [ "$got" = "jolly_gagarin" ] || bad="$bad container=[$got]"
  got=$(test.config.hostNameNoHostname.run web1.fritz.box -)
  [ "$got" = "web1" ] || bad="$bad bare=[$got]"
  [ -z "$bad" ] && create.result 0 "without hostname: the container name, else the short HOSTNAME" || create.result 1 "no hostname:$bad"
  return $(result)
}
test.case $level "T-CONFIG-HOST-NAME-NO-HOSTNAME: without the hostname program the computer is named from \$HOSTNAME, never localhost" test.config.hostNameNoHostname
expect 0 "without hostname: the container name, else the short HOSTNAME" \
  "AlmaLinux minimal has no hostname program — a container was called localhost"

# T-CONFIG-HOST-NAME-REFRESH: a guessed name that is wrong now is corrected, a chosen one kept
# Wrong now: a container ID, the raw host name, another container's name (an
# image cloned from a container carries the old name in its shared config).
test.config.hostNameRefresh() {
  local fx bad="" got
  fx=$(test.suite.fixture.make hostnamerefresh); mkdir -p "$fx/config"
  test.config.hostNameRefresh.run() { # <saved>
    printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' "export OOSH_SSH_CONFIG_HOST=\"$1\"" > "$fx/config/oosh.env"
    FX="$fx" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export CONFIG_PATH="$FX/config" OOSH_OS=linux-gnu
      hostname() { echo "2a1023f6d45b"; }
      docker() {
        case "$1 $2 $5" in
          "container inspect 2a1023f6d45b")    echo "2a1023f6d45bfe00aa /jolly_gagarin" ;;
          "container inspect pensive_mcnulty") echo "223278b798a3ee11 /pensive_mcnulty" ;;
          *) return 1 ;;
        esac; }
      private.config.host.name.refresh >/dev/null 2>&1' >/dev/null 2>&1
    sed -n 's/^export OOSH_SSH_CONFIG_HOST="\(.*\)"$/\1/p' "$fx/config/oosh.env"
  }
  got=$(test.config.hostNameRefresh.run 2a1023f6d45b);     [ "$got" = "jolly_gagarin" ] || bad="$bad id=[$got]"
  got=$(test.config.hostNameRefresh.run pensive_mcnulty);  [ "$got" = "jolly_gagarin" ] || bad="$bad clone=[$got]"
  got=$(test.config.hostNameRefresh.run "");               [ "$got" = "jolly_gagarin" ] || bad="$bad empty=[$got]"
  got=$(test.config.hostNameRefresh.run myserver);         [ "$got" = "myserver" ]      || bad="$bad chosen=[$got]"
  grep -q '^export OOSH_DIR="$HOME/oosh"$' "$fx/config/oosh.env" || bad="$bad other-lines-changed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "ID, empty and a cloned name corrected; a chosen name kept" || create.result 1 "host name refresh:$bad"
  return $(result)
}
test.case $level "T-CONFIG-HOST-NAME-REFRESH: a guessed name that is wrong now is corrected, a chosen one kept" test.config.hostNameRefresh
expect 0 "ID, empty and a cloned name corrected; a chosen name kept" "a container ID or a cloned image's old name stayed in the prompt"

# T-CONFIG-HOST-NAME-REFRESH-TWICE: a second refresh writes nothing
# Every config save asks private.config.host.name.refresh. The first run of a
# guessed name corrects it; the second finds the saved name right and leaves
# oosh.env alone — same content, same inode, the old mtime kept.
test.config.hostNameRefreshTwice() {
  local fx bad="" before after
  fx=$(test.suite.fixture.make hostnamerefreshtwice); mkdir -p "$fx/config"
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_SSH_CONFIG_HOST="2a1023f6d45b"' > "$fx/config/oosh.env"
  test.config.hostNameRefreshTwice.run() {
    FX="$fx" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export CONFIG_PATH="$FX/config" OOSH_OS=linux-gnu
      hostname() { echo "2a1023f6d45b"; }
      docker() { [ "$1 $2 $5" = "container inspect 2a1023f6d45b" ] && echo "2a1023f6d45bfe00aa /jolly_gagarin"; }
      private.config.host.name.refresh >/dev/null 2>&1' >/dev/null 2>&1
  }
  test.config.hostNameRefreshTwice.run
  grep -qx 'export OOSH_SSH_CONFIG_HOST="jolly_gagarin"' "$fx/config/oosh.env" || bad="$bad first-not-corrected=[$(tr '\n' '|' < "$fx/config/oosh.env")]"
  touch -t 200001010000 "$fx/config/oosh.env"; before="$(ls -li "$fx/config/oosh.env") $(cksum < "$fx/config/oosh.env")"
  test.config.hostNameRefreshTwice.run
  after="$(ls -li "$fx/config/oosh.env") $(cksum < "$fx/config/oosh.env")"
  [ "$after" = "$before" ] || bad="$bad second-run-wrote=[$before]->[$after]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "corrected once, the second refresh writes nothing" || create.result 1 "host name refresh twice:$bad"
  return $(result)
}
test.case $level "T-CONFIG-HOST-NAME-REFRESH-TWICE: a second host name refresh leaves oosh.env alone" test.config.hostNameRefreshTwice
expect 0 "corrected once, the second refresh writes nothing" "a second config save must change nothing"

# T-CONFIG-HOST-CONTAINER-NAME-GET: a container is named by the container whose ID starts with its host name
# docker and the host name are stubbed. A container: its host name is the start
# of its ID, the name comes back. A computer merely named like some container:
# the ID does not start with the host name, nothing (rc 1). No docker: nothing.
test.config.hostContainerNameGet() {
  local bad="" got rc
  test.config.hostContainerNameGet.run() { # <hostName> <noDocker:0|1>
    ( hostName="$1"; hostname() { echo "$hostName"; }
      docker() {
        case "$1 $2 $5" in
          "container inspect 2a1023f6d45b") echo "2a1023f6d45bfe00aa /jolly_gagarin" ;;
          "container inspect web1")         echo "77aa0011bb22cc33dd /web1" ;;
          *) return 1 ;;
        esac; }
      if [ "$2" = 1 ]; then
        unset -f docker
        command() { [ "$1 $2" = "-v docker" ] && return 1; builtin command "$@"; }
      fi
      private.config.host.container.name.get )
  }
  got=$(test.config.hostContainerNameGet.run 2a1023f6d45b 0); rc=$?
  [ "$rc/$got" = "0/jolly_gagarin" ] || bad="$bad container=[$rc/$got]"
  got=$(test.config.hostContainerNameGet.run web1 0); rc=$?
  [ "$rc/$got" = "1/" ] || bad="$bad same-name-computer=[$rc/$got]"
  got=$(test.config.hostContainerNameGet.run 2a1023f6d45b 1); rc=$?
  [ "$rc/$got" = "1/" ] || bad="$bad no-docker=[$rc/$got]"
  [ -z "$bad" ] && create.result 0 "a container gets its name; a namesake computer and no docker get nothing" || create.result 1 "container name:$bad"
  return $(result)
}
test.case $level "T-CONFIG-HOST-CONTAINER-NAME-GET: only a container whose ID starts with the host name gives its name" test.config.hostContainerNameGet
expect 0 "a container gets its name; a namesake computer and no docker get nothing" \
  "a computer named like some container was given that container's name"

# T-CONFIG-LINKED-HOMES-GET: the homes linked to a shared config, and an honest rc
# A home whose ~/config links to the shared config is listed with its owner; one
# linked elsewhere is not; one a normal caller cannot look into (mode 000) is
# left out and makes the rc 1 — root can search it, so for root it is listed
# and the rc is 0. An empty shared config cannot be resolved: rc 1, nothing.
test.config.linkedHomesGet() {
  local fx bad="" out rc me
  fx=$(test.suite.fixture.make linkedhomesget)
  mkdir -p "$fx/shared" "$fx/other" "$fx/home/linked" "$fx/home/unlinked" "$fx/home/closed"
  ln -s "$fx/shared" "$fx/home/linked/config"; ln -s "$fx/other" "$fx/home/unlinked/config"; ln -s "$fx/shared" "$fx/home/closed/config"
  me=$(private.this.path.stat.get "$fx/home/linked" owner)
  out=$( private.config.homes.list() { printf '%s\n' "$FX/home/linked" "$FX/home/unlinked"; }
         FX="$fx" private.config.linked.homes.get "$fx/shared" ); rc=$?
  [ "$rc|$out" = "0|$fx/home/linked $me" ] || bad="$bad open=[$rc|$out]"
  chmod 000 "$fx/home/closed"
  out=$( private.config.homes.list() { printf '%s\n' "$FX/home/linked" "$FX/home/unlinked" "$FX/home/closed"; }
         FX="$fx" private.config.linked.homes.get "$fx/shared" ); rc=$?
  chmod 755 "$fx/home/closed"
  # Root looks into every directory, mode 000 too: for root no home is closed,
  # it is listed and the rc is 0. Each runner has its one exact answer.
  if [ "$(id -u)" = "0" ]; then
    [ "$rc|$out" = "0|$fx/home/linked $me"$'\n'"$fx/home/closed $me" ] || bad="$bad closed-as-root=[$rc|$out]"
  else
    [ "$rc|$out" = "1|$fx/home/linked $me" ] || bad="$bad closed=[$rc|$out]"
  fi
  out=$(private.config.linked.homes.get ""); rc=$?
  [ "$rc|$out" = "1|" ] || bad="$bad unresolved=[$rc|$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "linked homes listed with their owner; a closed home is rc 1, for root listed" || create.result 1 "linked homes:$bad"
  return $(result)
}
test.case $level "T-CONFIG-LINKED-HOMES-GET: the homes linked to a shared config with their owners; a home a normal user cannot look into is rc 1, root sees it" test.config.linkedHomesGet
expect 0 "linked homes listed with their owner; a closed home is rc 1, for root listed" \
  "the one place that decides linked is what the gate and the as-user hops ask"

# T-CONFIG-SESSION-FILES-ENSURE-ALL: as root, one hop per linked user whose session files are not complete
# A linked user without a filled user.session.env (or without oosh.session.env)
# gets one hop AS them that ensures the files of THEIR home; a linked user whose
# files are complete gets none, nor does a home linked elsewhere. Not root:
# no hop at all. The hops are recorded, not run.
test.config.sessionFilesEnsureAll() {
  local fx bad="" me calls u
  fx=$(test.suite.fixture.make sessionfilesensureall); mkdir -p "$fx/shared" "$fx/other"
  for u in a b c; do mkdir -p "$fx/home/$u/.config/oosh"; done
  ln -s "$fx/shared" "$fx/home/a/config"; ln -s "$fx/shared" "$fx/home/b/config"; ln -s "$fx/other" "$fx/home/c/config"
  printf 'export PATH="/usr/bin"\n' > "$fx/home/b/.config/oosh/user.session.env"; : > "$fx/home/b/.config/oosh/oosh.session.env"
  me=$(private.this.path.stat.get "$fx/home/a" owner)
  test.config.sessionFilesEnsureAll.run() { # <uid> — echo the recorded hops, the fixture spelled FX
    rm -f "$fx/calls"
    FX="$fx" UID0="$1" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      id() { if [ "$1" = -u ]; then echo "$UID0"; else builtin command id "$@"; fi; }
      private.config.homes.list() { printf "%s\n" "$FX/home/a" "$FX/home/b" "$FX/home/c"; }
      private.as.user() { local h; for h in a b c; do case "$4" in *"session.file.ensure \"$FX/home/$h\""*) echo "hop $1 $h" >> "$FX/calls" ;; esac; done; }
      private.config.session.files.ensure.all "$FX/shared" "$OOSH_DIR" >/dev/null 2>&1' >/dev/null 2>&1
    cat "$fx/calls" 2>/dev/null
  }
  calls=$(test.config.sessionFilesEnsureAll.run 0)
  [ "$calls" = "hop $me a" ] || bad="$bad root=[$(printf '%s' "$calls" | tr '\n' '|')]"
  calls=$(test.config.sessionFilesEnsureAll.run 1000)
  [ -z "$calls" ] || bad="$bad not-root=[$(printf '%s' "$calls" | tr '\n' '|')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "one hop for the linked user without session files, none for the rest" || create.result 1 "session files ensure all:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SESSION-FILES-ENSURE-ALL: as root, one hop per linked user whose session files are not complete" test.config.sessionFilesEnsureAll
expect 0 "one hop for the linked user without session files, none for the rest" \
  "root's oo update gives every linked user their session files, as them"

# T-CONFIG-BASHRC-ALL: root's oo update renews the oosh .bashrc of every user of the shared config
# `oo update` renewed only the .bashrc of the user running it, so a new prompt
# ([oosh jolly_gagarin] bash-user@jolly_gagarin, 2026-10-05) needed an
# `oo update` by every user. As root, each user linked to the shared config gets
# the template, AS them; a home linked elsewhere is left alone.
test.config.bashrcAll() {
  local fx bad="" t="$OOSH_DIR/templates/user/bashrcTemplate"
  fx=$(test.suite.fixture.make bashrcall); mkdir -p "$fx/sharedConfig" "$fx/other" "$fx/home/a" "$fx/home/b" "$fx/home/c"
  ln -s "$fx/sharedConfig" "$fx/home/a/config"; ln -s "$fx/sharedConfig" "$fx/home/b/config"; ln -s "$fx/other" "$fx/home/c/config"
  local u; for u in a b c; do ln -s "$OOSH_DIR" "$fx/home/$u/oosh"; done   # like every installed user's ~/oosh
  echo "old a" > "$fx/home/a/.bashrc"; echo "old c" > "$fx/home/c/.bashrc"
  FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    id() { if [ "$1" = -u ]; then echo 0; else builtin command id "$@"; fi; }
    private.config.homes.list() { printf "%s\n" "$FX/home/a" "$FX/home/b" "$FX/home/c"; }
    private.as.user() { shift; "$@"; }
    private.config.bashrc.ensure.all "$FX/sharedConfig" "$OOSH_DIR" >/dev/null 2>&1' >/dev/null 2>&1
  cmp -s "$t" "$fx/home/a/.bashrc" || bad="$bad a-not-renewed"
  cmp -s "$t" "$fx/home/b/.bashrc" || bad="$bad b-not-installed"
  [ "$(cat "$fx/home/c/.bashrc")" = "old c" ] || bad="$bad c-touched"
  [ "$(cat "$fx/home/a/.bashrc.pre-oosh" 2>/dev/null)" = "old a" ] || bad="$bad a-original-not-kept"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "every user of the shared config gets the oosh .bashrc, others untouched" || create.result 1 "bashrc all:$bad"
  return $(result)
}
test.case $level "T-CONFIG-BASHRC-ALL: root's oo update renews the oosh .bashrc of every user of the shared config" test.config.bashrcAll
expect 0 "every user of the shared config gets the oosh .bashrc, others untouched" \
  "a new prompt needed an oo update by every user"

# T-CONFIG-BASHRC-ALL-OWN-BRANCH: each user gets the .bashrc template of the branch THEIR ~/oosh points at
# Root's oo update gave every user the template of ROOT's branch; a user on
# another branch (testing) wrote theirs back with their own next oo update — a
# ping-pong. The template comes from the canonical target of the user's own
# ~/oosh; root's tree only for a user who has no ~/oosh yet. The hops are
# recorded, not run.
test.config.bashrcAllOwnBranch() {
  local fx bad="" own root u calls
  fx=$(test.suite.fixture.make bashrcallown); own="$fx/testing"; root=$(private.this.path.canonical "$OOSH_DIR")
  mkdir -p "$fx/sharedConfig" "$own/templates/user"
  echo "# the template of the testing branch" > "$own/templates/user/bashrcTemplate"
  for u in a b c d; do mkdir -p "$fx/home/$u"; ln -s "$fx/sharedConfig" "$fx/home/$u/config"; done
  ln -s "$OOSH_DIR" "$fx/home/a/oosh"; ln -s "$own" "$fx/home/b/oosh"; ln -s "$own" "$fx/home/c/oosh"
  echo "old a" > "$fx/home/a/.bashrc"; echo "old b" > "$fx/home/b/.bashrc"; echo "old d" > "$fx/home/d/.bashrc"
  cp "$own/templates/user/bashrcTemplate" "$fx/home/c/.bashrc"   # already their own branch's template
  FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    id() { if [ "$1" = -u ]; then echo 0; else builtin command id "$@"; fi; }
    private.config.homes.list() { printf "%s\n" "$FX/home/a" "$FX/home/b" "$FX/home/c" "$FX/home/d"; }
    private.as.user() { printf "%s\n" "$4" | grep "private.user.bashrc.install \"" >> "$FX/calls"; }
    private.config.bashrc.ensure.all "$FX/sharedConfig" "$OOSH_DIR" >/dev/null 2>&1' >/dev/null 2>&1
  calls=$(cat "$fx/calls" 2>/dev/null)
  case "$calls" in *"install \"$fx/home/a\" \"$root\""*) ;; *) bad="$bad a-not-root-branch" ;; esac
  case "$calls" in *"install \"$fx/home/b\" \"$own\""*) ;; *) bad="$bad b-not-own-branch" ;; esac
  case "$calls" in *"\"$fx/home/c\""*) bad="$bad c-own-template-overwritten" ;; esac
  case "$calls" in *"install \"$fx/home/d\" \"$OOSH_DIR\""*) ;; *) bad="$bad d-no-fallback" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "each user gets the template of their own branch" || create.result 1 "bashrc own branch:$bad calls=[$(printf '%s' "$calls" | tr '\n' '|')]"
  return $(result)
}
test.case $level "T-CONFIG-BASHRC-ALL-OWN-BRANCH: each user gets the .bashrc template of the branch their own ~/oosh points at" test.config.bashrcAllOwnBranch
expect 0 "each user gets the template of their own branch" \
  "root's oo update gave every user the .bashrc of root's branch — a ping-pong with their own update"

# T-CONFIG-BASHRC-ALL-NO-CMP: without cmp an identical .bashrc is still left alone
# cmp is diffutils, which AlmaLinux minimal does not ship: rc 127 read as
# "differs", so every oo update hopped into every user and re-copied the file.
test.config.bashrcAllNoCmp() {
  local fx bad=""; fx=$(test.suite.fixture.make bashrcallnocmp)
  mkdir -p "$fx/sharedConfig" "$fx/home/a"; ln -s "$fx/sharedConfig" "$fx/home/a/config"; ln -s "$OOSH_DIR" "$fx/home/a/oosh"
  cp "$OOSH_DIR/templates/user/bashrcTemplate" "$fx/home/a/.bashrc"
  FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    command() { [ "$1 $2" = "-v cmp" ] && return 1; builtin command "$@"; }
    cmp() { return 127; }   # the program is not there
    id() { if [ "$1" = -u ]; then echo 0; else builtin command id "$@"; fi; }
    private.config.homes.list() { echo "$FX/home/a"; }
    private.as.user() { echo "hop $1" >> "$FX/calls"; }
    private.config.bashrc.ensure.all "$FX/sharedConfig" "$OOSH_DIR" >/dev/null 2>&1' >/dev/null 2>&1
  [ -s "$fx/calls" ] && bad="$bad identical-bashrc-reinstalled"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "an identical .bashrc is left alone without cmp" || create.result 1 "bashrc no cmp:$bad"
  return $(result)
}
test.case $level "T-CONFIG-BASHRC-ALL-NO-CMP: without cmp an identical .bashrc is left alone" test.config.bashrcAllNoCmp
expect 0 "an identical .bashrc is left alone without cmp" \
  "AlmaLinux minimal has no cmp — every oo update re-copied every user's .bashrc"


console.log "
Test: private.config.env.lines.drop
===================================================================="

# test.config.writeFails <file> <command…>: run <command> while <file> cannot
# be written, and echo one word per way it still answered rc 0. Two ways: mode
# 444 (a caller not in group dev — root ignores the mode, so only as a normal
# user) and a file-size limit of 0 (a full disk: root cannot write either).
# <file>'s content is put back after each run.
test.config.writeFails() {
  local f="$1" saved out=""; shift
  saved=$(cat "$f")
  if [ "$(id -u)" != "0" ]; then
    chmod 444 "$f"
    ( "$@" ) >/dev/null 2>&1 && out="$out mode444-rc0"
    chmod 664 "$f"; printf '%s\n' "$saved" > "$f"
  fi
  ( trap '' XFSZ; ulimit -f 0; "$@" ) >/dev/null 2>&1 && out="$out full-disk-rc0"
  printf '%s\n' "$saved" > "$f"
  echo "$out"
}

# T-CONFIG-ENV-LINES-DROP: one method drops env lines by prefix — in place, idempotent, honest
# The migrates of the shared env files each had their own read-drop-printf loop
# whose write error went to /dev/null: a caller not in group dev was told it
# had migrated. Pure data stays pure data; a rerun does not even rewrite.
test.config.envLinesDrop() {
  local fx bad="" f got; fx=$(test.suite.fixture.make envlinesdrop); f="$fx/x.env"
  printf '%s\n' 'export A="1"' 'export PATH="/x"' 'PATH=/y' 'export B="2"' > "$f"; chmod 664 "$f"
  private.config.env.lines.drop "$f" 'export PATH=' 'PATH=' >/dev/null 2>&1 || bad="$bad rc=$?"
  [ "$(cat "$f")" = 'export A="1"
export B="2"' ] || bad="$bad content=[$(tr '\n' '|' < "$f")]"
  [ "$(ls -l "$f" | cut -c1-10)" = "-rw-rw-r--" ] || bad="$bad mode-changed"
  config.validate "$f" >/dev/null 2>&1 || bad="$bad not-pure-data"
  touch -t 200001010000 "$f"; touch -t 200001010001 "$fx/marker"
  private.config.env.lines.drop "$f" 'export PATH=' 'PATH=' >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$f" -nt "$fx/marker" ] && bad="$bad unchanged-file-rewritten"
  printf '%s\n' 'export A="1"' 'export PATH="/x"' > "$f"
  got=$(test.config.writeFails "$f" private.config.env.lines.drop "$f" 'export PATH=')
  [ -z "$got" ] || bad="$bad unwritable:$got"
  ( chmod 444 "$f"; private.config.env.lines.drop "$f" 'export PATH=' >/dev/null 2>&1; rc=$?; chmod 664 "$f"
    [ "$(id -u)" = "0" ] || { [ "$rc" = 1 ] && [ -n "$RESULT" ]; } ) || bad="$bad no-rc1-RESULT"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "env lines dropped" || create.result 1 "env lines drop:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ENV-LINES-DROP: matching lines go in place, a rerun rewrites nothing, an unwritable file is rc 1" \
   test.config.envLinesDrop
expect 0 "env lines dropped" "a migrate said it had written a shared file it could not write"

# T-CONFIG-MIGRATE-WRITE-FAIL: a migrate that cannot write a shared env file answers rc 2
# log.chain.migrate, user.session.migrate and oosh.session.migrate rewrote the
# shared files with `printf … > "$f" 2>/dev/null` and returned 0 whatever
# happened. And a migrate that has run leaves the file alone on the next run —
# not even rewritten.
test.config.migrateWriteFail() {
  local fx bad="" got f homesList
  homesList=$(declare -f private.config.homes.list)
  fx=$(test.suite.fixture.make migratewritefail); mkdir -p "$fx/shared"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $OOSH_USER_CONFIG_PATH/log.session.env' > "$fx/shared/log.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export PATH="$HOME/oosh:$PATH"' '. $CONFIG_PATH/oosh.env' > "$fx/shared/user.env"
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_MODE="dev"' > "$fx/shared/oosh.env"
  chmod 664 "$fx/shared/"*.env
  private.config.homes.list() { :; }   # an open gate: no other user
  got=$(test.config.writeFails "$fx/shared/log.env" private.config.log.chain.migrate "$fx/shared")
  [ -z "$got" ] || bad="$bad log.chain:$got"
  got=$(test.config.writeFails "$fx/shared/user.env" private.config.user.session.migrate "$fx/shared")
  [ -z "$got" ] || bad="$bad user.session:$got"
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_MODE="dev"' > "$fx/shared/oosh.env"
  got=$(test.config.writeFails "$fx/shared/oosh.env" private.config.oosh.session.migrate "$fx/shared")
  [ -z "$got" ] || bad="$bad oosh.session:$got"
  # A failed write is rc 2 with RESULT naming the file — rc 1 is the closed
  # gate only, so a caller tells the two apart (T-CONFIG-INIT-USER-WRITE-FAIL).
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_MODE="dev"' > "$fx/shared/oosh.env"
  for f in log.chain:log.env user.session:user.env oosh.session:oosh.env; do
    got=$( ( trap '' XFSZ; ulimit -f 0; "private.config.${f%%:*}.migrate" "$fx/shared" >/dev/null 2>&1; echo "$?|$RESULT" ) )
    case "$got" in "2|"*"cannot write $fx/shared/${f#*:}"*) ;; *) bad="$bad ${f%%:*}-not-rc2=[$got]" ;; esac
  done
  printf '%s\n' 'export LOG_LEVEL="1"' '. $OOSH_USER_CONFIG_PATH/log.session.env' > "$fx/shared/log.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export PATH="$HOME/oosh:$PATH"' '. $CONFIG_PATH/oosh.env' > "$fx/shared/user.env"
  # Writable now: each migrates once, then a rerun leaves every file alone.
  printf '%s\n' 'export LOG_LEVEL="1"' '. $OOSH_USER_CONFIG_PATH/log.session.env' > "$fx/shared/log.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export PATH="$HOME/oosh:$PATH"' '. $CONFIG_PATH/oosh.env' > "$fx/shared/user.env"
  printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' 'export OOSH_MODE="dev"' > "$fx/shared/oosh.env"
  private.config.log.chain.migrate "$fx/shared" >/dev/null 2>&1 || bad="$bad log.chain-rc=$?"
  private.config.user.session.migrate "$fx/shared" >/dev/null 2>&1 || bad="$bad user.session-rc=$?"
  private.config.oosh.session.migrate "$fx/shared" >/dev/null 2>&1 || bad="$bad oosh.session-rc=$?"
  [ "$(tail -n 1 "$fx/shared/log.env")" = '. $HOME/.config/oosh/log.session.env' ] || bad="$bad log.env=[$(tr '\n' '|' < "$fx/shared/log.env")]"
  [ "$(cat "$fx/shared/user.env")" = 'export CONFIG_PATH="$HOME/config"
. $CONFIG_PATH/oosh.env
. $HOME/.config/oosh/user.session.env' ] || bad="$bad user.env=[$(tr '\n' '|' < "$fx/shared/user.env")]"
  [ "$(cat "$fx/shared/oosh.env")" = 'export OOSH_DIR="$HOME/oosh"
. $HOME/.config/oosh/oosh.session.env' ] || bad="$bad oosh.env=[$(tr '\n' '|' < "$fx/shared/oosh.env")]"
  touch -t 200001010000 "$fx/shared/"*.env; touch -t 200001010001 "$fx/marker"
  private.config.log.chain.migrate "$fx/shared" >/dev/null 2>&1
  private.config.user.session.migrate "$fx/shared" >/dev/null 2>&1
  private.config.oosh.session.migrate "$fx/shared" >/dev/null 2>&1
  for f in "$fx/shared/"*.env; do
    [ "$f" -nt "$fx/marker" ] && bad="$bad rerun-rewrote-${f##*/}"
  done
  eval "$homesList"   # the real private.config.homes.list again
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "an unwritable shared file is rc 2; a rerun rewrites nothing" || create.result 1 "migrate:$bad"
  return $(result)
}
test.case $level "T-CONFIG-MIGRATE-WRITE-FAIL: a migrate that cannot write a shared env file answers rc 2, and a rerun rewrites nothing" \
   test.config.migrateWriteFail
expect 0 "an unwritable shared file is rc 2; a rerun rewrites nothing" "the write error went to /dev/null and the migrate answered 0"

# T-CONFIG-INIT-USER-WRITE-FAIL: config init.user says which shared file it could not write
# The migrates answered a failed write with rc 1 + RESULT, but config.init.user
# ignored the log.chain one and reported ANY rc 1 of the session migrates as
# "keeps its PATH line … run: sudo oo update" at info level — the wrong cause,
# invisible at the default level, the file never named. Collaborators recorded
# as in T-CONFIG-INIT-USER-CALLS; the migrates answer their contract: rc 2 +
# "cannot write <file>" for a failed write, rc 1 for a closed gate.
test.config.initUserWriteFail() {
  local fx bad="" base sharedConfig sharedOosh u got
  fx=$(test.suite.fixture.make inituserwritefail); base="$fx/home"; u=$(id -un)
  sharedConfig="$base/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  sharedOosh="$base/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh/dev"
  mkdir -p "$base/developking" "$base/$u" "$sharedConfig" "${sharedOosh%/*}"; ln -s "$OOSH_DIR" "$sharedOosh"
  test.config.initUserWriteFail.run() { # <write|gate> — config.init.user in a child shell; echo its stderr, then "rc <n>|<RESULT>"
    FX="$fx" U="$u" MODE="$1" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
      private.as.user() { :; }
      private.config.session.files.ensure.all()  { :; }
      private.config.bashrc.ensure.all()         { :; }
      ogit.safeDirectory.ensure()                { :; }
      private.user.check.group()                 { return 1; }
      private.config.log.chain.migrate() {
        [ "$MODE" = write ] || return 0
        create.result 2 "cannot write $1/log.env — line not appended"; return 2; }
      private.config.user.session.migrate() {
        [ "$MODE" = write ] && { create.result 2 "cannot write $1/user.env — line not appended"; return 2; }
        return 1; }
      private.config.oosh.session.migrate()      { return 0; }
      export OOSH_MODE=dev LOG_LEVEL=4 LOG_DEVICE=/dev/stderr LOG_LIVE= LOG_INSTALL=
      config.init.user "$U" >/dev/null; echo "rc $?|$RESULT" >&2' 2>&1 >/dev/null | sed "s|$fx|FX|g"
  }
  local cfg="${sharedConfig/$fx/FX}"
  got=$(test.config.initUserWriteFail.run write)
  case "$got" in *"WARNING> "*"cannot write $cfg/log.env"*) ;; *) bad="$bad log.env-not-warned" ;; esac
  case "$got" in *"WARNING> "*"cannot write $cfg/user.env"*) ;; *) bad="$bad user.env-not-warned" ;; esac
  case "$got" in *"run: sudo oo update"*) bad="$bad gate-message-for-a-write" ;; esac
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 1|"*"could not be written"*"cannot write $cfg/log.env"*) ;; *) bad="$bad result=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  got=$(test.config.initUserWriteFail.run gate)
  case "$got" in *"keeps its PATH line"*"run: sudo oo update"*) ;; *) bad="$bad gate-message-missing" ;; esac
  case "$got" in *"cannot write"*) bad="$bad gate-called-a-write" ;; esac
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 0|"*) ;; *) bad="$bad gate-rc=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a failed write is warned with its file; a closed gate keeps its message" || create.result 1 "init.user write fail:$bad"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-WRITE-FAIL: config init.user warns which shared file it could not write, and keeps the gate message for a closed gate" \
  test.config.initUserWriteFail
expect 0 "a failed write is warned with its file; a closed gate keeps its message" \
  "a failed write was reported as a closed gate, at info level, without its file"

# T-CONFIG-SAVE-MIGRATE-WRITE-FAIL: config save does not stay silent when log.env cannot be migrated
# config.save ran private.config.log.chain.migrate and ignored its answer. A
# full disk (file-size limit 0 — root cannot write either) on a log.env with the
# old chain line: the save says which file it could not write.
test.config.saveMigrateWriteFail() {
  local fx got; fx=$(test.suite.fixture.make savemigratewritefail); mkdir -p "$fx/config"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $OOSH_USER_CONFIG_PATH/log.session.env' > "$fx/config/log.env"
  got=$( ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=oosh.env CONFIG="$fx/config/oosh.env" \
                  LOG_LEVEL=2 LOG_DEVICE=/dev/stderr LOG_LIVE= LOG_INSTALL=
           trap '' XFSZ; ulimit -f 0; config.save oosh OOSH ) 2>&1 >/dev/null )
  rm -rf "$fx"
  case "$got" in
    *"WARNING> "*"cannot write $fx/config/log.env"*) create.result 0 "config save warns that log.env could not be written" ;;
    *) create.result 1 "config save stayed silent: [$(printf '%s' "$got" | tr '\n' '|')]" ;;
  esac
  return $(result)
}
test.case $level "T-CONFIG-SAVE-MIGRATE-WRITE-FAIL: config save warns when the shared log.env cannot be migrated" test.config.saveMigrateWriteFail
expect 0 "config save warns that log.env could not be written" "config.save ignored the answer of the log.env migrate"


console.log "
Test: private.config.env.line.append
===================================================================="

# T-CONFIG-ENV-LINE-APPEND: a chain line goes onto a shared env file once, honestly
# The migrates appended the session chain with the same unchecked printf.
test.config.envLineAppend() {
  local fx bad="" f got chain='. $HOME/.config/oosh/user.session.env'
  fx=$(test.suite.fixture.make envlineappend); f="$fx/user.env"
  printf '%s\n' 'export A="1"' > "$f"; chmod 664 "$f"
  private.config.env.line.append "$f" "$chain" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ "$(cat "$f")" = "export A=\"1\"
$chain" ] || bad="$bad content=[$(tr '\n' '|' < "$f")]"
  [ "$(ls -l "$f" | cut -c1-10)" = "-rw-rw-r--" ] || bad="$bad mode-changed"
  touch -t 200001010000 "$f"; touch -t 200001010001 "$fx/marker"
  private.config.env.line.append "$f" "$chain" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$f" -nt "$fx/marker" ] && bad="$bad present-line-rewritten"
  printf '%s\n' 'export A="1"' > "$f"
  got=$(test.config.writeFails "$f" private.config.env.line.append "$f" "$chain")
  [ -z "$got" ] || bad="$bad unwritable:$got"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "env line appended once" || create.result 1 "env line append:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ENV-LINE-APPEND: the line is appended once, a rerun rewrites nothing, an unwritable file is rc 1" \
   test.config.envLineAppend
expect 0 "env line appended once" "the migrates appended the chain line with an unchecked write"

# T-CONFIG-BRANCH-NO-ALIAS: config init.user asks ogit.branch.get — it works without this.git.branch.short
# this.git.branch.short was a second name for ogit.branch.get; the owner
# decided it goes. The branch line of config.init.user (the fallback when
# neither OOSH_MODE nor a shared clone names one) is run with the alias unset
# on a fixture repository and gives its branch; the ogit load stands before
# it; no call of the alias is left in config.
test.config.branchNoAlias() {
  local fx bad="" body site got hits loadAt siteAt branch
  fx=$(test.suite.fixture.make configbranchnoalias)
  git init -q -b feature-x "$fx/repo"; git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q --allow-empty -m seed
  private.this.script.load ogit ogit.branch.get
  body=$(declare -f config.init.user)
  site=$(printf '%s\n' "$body" | grep -m1 'ogit\.branch\.get "\$OOSH_DIR"')
  if [ -z "$site" ]; then bad="$bad no-ogit-site"; else
    loadAt=$(printf '%s\n' "$body" | grep -n -m1 'private\.this\.script\.load ogit ogit\.branch\.get' | cut -d: -f1)
    siteAt=$(printf '%s\n' "$body" | grep -n -m1 'ogit\.branch\.get "\$OOSH_DIR"' | cut -d: -f1)
    { [ -n "$loadAt" ] && [ "$loadAt" -lt "$siteAt" ]; } || bad="$bad ogit-not-loaded-before"
    got=$( unset -f this.git.branch.short; OOSH_DIR="$fx/repo"; branch=""; eval "${site#"${site%%[! ]*}"}"; echo "$branch" )
    [ "$got" = feature-x ] || bad="$bad branch=[$got]"
  fi
  hits=$(grep -n 'this\.git\.branch\.short' "$OOSH_DIR/config" | cut -d: -f1 | tr '\n' ' ')
  [ -z "$hits" ] || bad="$bad alias-callers=[$hits]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the branch comes from ogit.branch.get, the alias is not called" || create.result 1 "branch alias:$bad"
  return $(result)
}
test.case $level "T-CONFIG-BRANCH-NO-ALIAS: config init.user asks ogit.branch.get — it works without this.git.branch.short" test.config.branchNoAlias
expect 0 "the branch comes from ogit.branch.get, the alias is not called" "one getter had two names"


# T-CONFIG-SAVE-LAYOUT-ARGS: the layout travels to private.config.save, never through the public config.save
# A person types `config save oosh OOSH`; the layout (sessionSplit, ooshSplit) is
# what a full save hands its nested oosh save, so only the private worker takes it.
test.config.saveLayoutArgs() {
  local fx bad="" o; fx=$(test.suite.fixture.make savelayoutargs); mkdir -p "$fx/config"; o="$fx/config/oosh.env"
  printf '%s\n' 'export OOSH_OS="linux-gnu"' > "$o"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=oosh.env CONFIG="$o" OOSH_PROBE="layout"
    config.save oosh OOSH yes yes ) >/dev/null 2>&1
  grep -q 'oosh.session.env' "$o" && bad="$bad public-took-layout"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=oosh.env CONFIG="$o" OOSH_PROBE="layout"
    private.config.save oosh OOSH no yes ) >/dev/null 2>&1
  [ "$(tail -n 1 "$o")" = '. $HOME/.config/oosh/oosh.session.env' ] || bad="$bad private-ignored-layout=[$(tail -n 1 "$o")]"
  grep -qx 'export OOSH_PROBE="layout"' "$o" || bad="$bad probe-missing"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the layout reaches private.config.save only" || create.result 1 "save layout:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SAVE-LAYOUT-ARGS: a nested oosh save takes the layout it is handed; config save takes none" test.config.saveLayoutArgs
expect 0 "the layout reaches private.config.save only" "the public config.save keeps <?name> <?ENV_PREFIX>"

# T-CONFIG-WRITER-VALIDATOR-AGREE: whatever the writer accepts, config.validate accepts
# private.this.env.export.line.get escaped `$(` and a backtick inside double
# quotes, config.validate rejects every line holding one, and config.save
# validates what it just wrote: `export OOSH_FOO='a$(b)'; config save` wrote a
# correct line and then said INVALID. Env files are pure data and the validator
# gets no exception, so the writer gives way. For each nasty value: written →
# the file validates and reads back as given; refused → not in the file.
test.config.writerValidatorAgree() {
  local fx bad="" o i v got n=0
  fx=$(test.suite.fixture.make writervalidatoragree); mkdir -p "$fx/config"; o="$fx/config/oosh.env"
  local values=( 'plain' 'two  spaces' '$HOME/x' '${HOME}' 'a"q' "a'b" 'back\slash' '(paren)' '$ (x)'
                 'a$(id)' 'a`id`' '\$(x)' '$(' 'a
b' "a$(printf '\t')b" )
  for i in "${!values[@]}"; do export "OOSH_NASTY_$i=${values[$i]}"; done
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG_FILE=oosh.env CONFIG="$o" LOG_DEVICE=/dev/stderr LOG_LEVEL=1
    config.save oosh OOSH ) >/dev/null 2>"$fx/stderr"
  for i in "${!values[@]}"; do unset "OOSH_NASTY_$i"; done
  config.validate "$o" >/dev/null 2>&1 || bad="$bad oosh.env-invalid=[$(config.validate "$o" 2>&1 | tr '\n' '|')]"
  grep -q 'OOSH_NASTY_9 is not saved' "$fx/stderr" || bad="$bad refusal-silent"
  grep -q 'export ' "$o" || bad="$bad no-lines"
  for i in "${!values[@]}"; do
    v=${values[$i]}
    if grep -q "^export OOSH_NASTY_$i=" "$o"; then
      n=$((n + 1))
      got=$(HOME="$fx" sh -c ". \"$o\" 2>/dev/null; printf '%s' \"\$OOSH_NASTY_$i\"")
      [ "$got" = "$v" ] || bad="$bad read-back[$i]=[$got]"
    else
      case "$v" in *'$('*|*'`'*|*[[:cntrl:]]*) ;; *) bad="$bad refused[$i]=[$v]" ;; esac
    fi
  done
  [ "$n" = 9 ] || bad="$bad written=$n"
  # The same rule through log.session.save (the per-user session file).
  for v in 'a$(id)' 'a`id`'; do
    ( export HOME="$fx" LOG_NAME="$v" LOG_DEVICE=/dev/null LOG_LIVE="$fx/live.out"; log.session.save >/dev/null 2>&1 )
    [ -f "$fx/.config/oosh/log.session.env" ] && ! config.validate "$fx/.config/oosh/log.session.env" >/dev/null 2>&1 && bad="$bad session-invalid=[$v]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "what the writer accepts the validator accepts; what it refuses is not written" || create.result 1 "writer/validator:$bad"
  return $(result)
}
test.case $level "T-CONFIG-WRITER-VALIDATOR-AGREE: whatever the env writer accepts, config.validate accepts" test.config.writerValidatorAgree
expect 0 "what the writer accepts the validator accepts; what it refuses is not written" \
  "config save wrote an escaped \$( and then reported its own file INVALID"

# T-CONFIG-INIT-USER-SHARED-OOSH-PARAM: config init.user takes the shared-oosh target, the heal names the branch folder
# `oo heal <branch>` heals a user to <base>/<branch>, but config.init.user
# preferred the link that was there: a user whose ~/oosh links <base>/testing
# stayed on testing after `heal dev`. The second parameter names the target and
# wins over that preference; it must be a branch folder directly under the
# components base — anything else is refused (rc 1) and no link is touched.
# Without it the old preference stands. The rule of "a branch folder" has one
# owner, private.ogit.base.folders.list — the list the completion offers — so a
# symlink in the base, a folder without .git, a deeper path or one outside is
# refused, and a completion candidate fed back is accepted: both take their
# base from private.config.shared.oosh.base.get. Collaborators are stubbed as
# in T-CONFIG-INIT-USER-CALLS; the symlink lines of the hop run for real inside
# the fixture (the preamble is not: the fixture's branch folders hold no oosh).
test.config.initUserSharedOoshParam() {
  local fx bad="" base sharedConfig ooshBase u got cand p
  fx=$(test.suite.fixture.make initusersharedoosh); base="$fx/home"; u=$(id -un)
  # config.init.user trusts the branch folders of the base (ogit.safeDirectory.ensure,
  # loaded by private.this.script.load over a stub): the fixture's went into the
  # real ~/.gitconfig — dead entries the next oo heal pruned (second-heal=1)
  local gitconfigBefore; gitconfigBefore=$(cksum < "$HOME/.gitconfig" 2>/dev/null)
  sharedConfig="$base/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  ooshBase="$base/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"
  mkdir -p "$base/developking" "$base/$u" "$sharedConfig" "$fx/elsewhere" \
    "$ooshBase/dev/.git" "$ooshBase/testing/.git" "$ooshBase/dev/x/.git" "$ooshBase/plain"
  ln -s "$fx/elsewhere" "$ooshBase/link"
  ln -s "$sharedConfig" "$base/$u/config"; ln -s "$ooshBase/testing" "$base/$u/oosh"
  test.config.initUserSharedOoshParam.run() { # <?sharedOosh> — config.init.user in a child shell; echo "rc <n>|<RESULT>"
    FX="$fx" U="$u" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export HOME="$FX"   # the git trust config.init.user writes lands in the fixture
      user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
      private.as.user() { case "$4" in *symlink.with.backup*) ( eval "$(printf "%s\n" "$4" | grep -E "^ *(cd |private.this.symlink.with.backup )")" ) ;; esac; }
      private.config.log.chain.migrate() { :; }; private.config.session.files.ensure.all() { :; }
      private.config.bashrc.ensure.all() { :; }; private.config.user.session.migrate() { :; }
      private.config.oosh.session.migrate() { :; }; ogit.safeDirectory.ensure() { :; }
      private.user.check.group() { return 1; }
      export OOSH_MODE=dev
      config.init.user "$U" "$@" >/dev/null 2>&1; echo "rc $?|$RESULT"' _ "$@" 2>/dev/null | sed "s|$fx|FX|g"
  }
  got=$(test.config.initUserSharedOoshParam.run)
  case "$got" in "rc 0|"*) ;; *) bad="$bad no-param=[$got]" ;; esac
  [ "$(readlink "$base/$u/oosh")" = "$ooshBase/testing" ] || bad="$bad no-param-moved=[$(readlink "$base/$u/oosh")]"
  for p in "$fx/elsewhere" "$ooshBase/.." "$ooshBase/nonesuch" "$ooshBase/link" "$ooshBase/plain" "$ooshBase/dev/x"; do
    got=$(test.config.initUserSharedOoshParam.run "$p")
    case "$got" in "rc 1|"*"not a branch folder"*) ;; *) bad="$bad ${p##*/}=[$got]" ;; esac
  done
  [ "$(readlink "$base/$u/oosh")" = "$ooshBase/testing" ] || bad="$bad refused-but-moved=[$(readlink "$base/$u/oosh")]"
  got=$(FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
    config.init.user.completion.sharedOosh' 2>/dev/null | tr '\n' ' ')
  [ "$got" = "$ooshBase/dev $ooshBase/testing " ] || bad="$bad completion=[$got]"
  cand="${got%% *}"
  got=$(test.config.initUserSharedOoshParam.run "$cand")
  case "$got" in "rc 0|"*) ;; *) bad="$bad candidate=[$got]" ;; esac
  [ "$(readlink "$base/$u/oosh")" = "$ooshBase/dev" ] || bad="$bad dev-not-linked=[$(readlink "$base/$u/oosh")]"
  got=$(test.config.initUserSharedOoshParam.run "$ooshBase/testing/")
  [ "$(readlink "$base/$u/oosh")" = "$ooshBase/testing" ] || bad="$bad trailing-slash=[$got]"
  [ "$(readlink "$base/$u/config")" = "$sharedConfig" ] || bad="$bad config-moved"
  [ "$(cksum < "$HOME/.gitconfig" 2>/dev/null)" = "$gitconfigBefore" ] || bad="$bad real-gitconfig-written"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the named branch folder wins, a folder outside the base is refused, no name keeps the link" || create.result 1 "init.user sharedOosh:$bad"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-SHARED-OOSH-PARAM: config init.user <user> <sharedOosh> links ~/oosh to the named branch folder, refuses one outside the base" \
  test.config.initUserSharedOoshParam
expect 0 "the named branch folder wins, a folder outside the base is refused, no name keeps the link" \
  "oo heal dev left a user on <base>/testing: init.user preferred the link that was there"


console.log "
Test: private.config.orig.import
===================================================================="

# T-CONFIG-ORIG-IMPORT-ALLOWLIST: only the allow-listed values reach the empty shared values, nothing is sourced, a second run changes nothing
# A real ~/config (the boss's Mac: 95 files in an old format) is kept aside as
# config.orig.<ts> when the heal links ~/config to the shared config. A short
# allow-list of its values is carried over — LOG_LEVEL (a valid level) into
# log.env, the computer name into oosh.env — and only into an EMPTY shared
# value. The never-list (PATH with its ".", HOME, LOG_DEVICE, OOSH_DIR,
# OOSH_MODE, CONFIG_CHAIN_*) is never carried; any other name is reported. The
# old folder is DATA: a `$(…)` value and a bare command line prove it is never
# sourced, and nothing in it changes. The shared files stay pure data with
# their chain line last; a second run writes nothing; a value already there
# is kept. A shared log.env without a LOG_LEVEL line gets it before its chain.
# A Mac's name loses its router domain. Code in an allow-listed value
# (`$(touch …)`, `"3"; touch …`) is skipped with its reason and never runs. The
# log device on stdout at LOG_LEVEL 4 changes nothing. A shared file that
# cannot be written is rc 2, "cannot write <file>" (the migrates' convention).
test.config.origImport() {
  local fx bad="" o c got want
  fx=$(test.suite.fixture.make origimport); o="$fx/config.orig.20261007-120000"
  mkdir -p "$o" "$fx/sharedConfig"
  printf '%s\n' '#!/bin/bash' \
    'export PATH=".:$HOME/oosh:/usr/bin"' \
    'export HOME="/Users/boss"' \
    'declare -x LOG_DEVICE="/dev/stdout"' \
    'export CONFIG_CHAIN_LOG=1' \
    'export LOG_LEVEL="3"' \
    'export OOSH_MODE="mcdonges.latest"' \
    'export OOSH_DIR="/Users/boss/oosh"' \
    'export OOSH_SSH_CONFIG_HOST="bossmac.fritz.box"' \
    "export FOO_STAMP=\"\$(touch $fx/sourced)\"" \
    "touch \"$fx/sourced.bare\"" \
    'export FOO="bar"' > "$o/user.env"
  printf '%s\n' 'export LOG_LEVEL_RESET="5"' > "$o/log.env"
  test.config.origImport.shared() { # <logLevelLine|-> <hostValue> — a fresh shared config in $fx/sharedConfig
    c="$fx/sharedConfig"
    printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export CONFIG_FILE="user.env"' \
      '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' '. $HOME/.config/oosh/user.session.env' > "$c/user.env"
    printf '%s\n' 'export OOSH_OS="linux-gnu"' "export OOSH_SSH_CONFIG_HOST=\"$2\"" '. $HOME/.config/oosh/oosh.session.env' > "$c/oosh.env"
    { [ "$1" = - ] || printf '%s\n' "$1"; printf '%s\n' 'export LOG_LEVEL_RESET="1"' '. $HOME/.config/oosh/log.session.env'; } > "$c/log.env"
  }
  test.config.origImport.run() { # <?origDir:$o> <?logDevice:/dev/stderr> — the import in a child shell at LOG_LEVEL 4; echo its log, then "rc <n>|<RESULT>"
    FX="$fx" O="${1:-$o}" DEV="${2:-/dev/stderr}" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export HOME="$FX" LOG_LEVEL=4 LOG_DEVICE="$DEV" LOG_LIVE= LOG_INSTALL=
      private.config.orig.import "$O" "$FX/sharedConfig" >/dev/null; echo "rc $?|$RESULT" >&2' 2>&1 >/dev/null
  }
  test.config.origImport.sums() { (cd "$1" && cksum * 2>/dev/null); }
  local origSums sharedSums
  origSums=$(test.config.origImport.sums "$o")
  test.config.origImport.shared 'export LOG_LEVEL=""' hostA
  got=$(test.config.origImport.run)
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 0|imported: LOG_LEVEL | skipped: 10") ;; *) bad="$bad result=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  want='export LOG_LEVEL_RESET="1"
export LOG_LEVEL="3"
. $HOME/.config/oosh/log.session.env'
  [ "$(cat "$c/log.env")" = "$want" ] || bad="$bad log.env=[$(tr '\n' '|' < "$c/log.env")]"
  grep -qx 'export OOSH_SSH_CONFIG_HOST="hostA"' "$c/oosh.env" || bad="$bad host-not-kept"
  grep -qE '^(export |declare -x )?(PATH|HOME|LOG_DEVICE|OOSH_DIR|OOSH_MODE|CONFIG_CHAIN_[A-Z_]*|FOO|FOO_STAMP)=' "$c"/*.env && bad="$bad never-list-carried"
  case "$got" in *"skipped FOO (not carried over)"*) ;; *) bad="$bad FOO-not-reported" ;; esac
  case "$got" in *"skipped LOG_LEVEL_RESET (not carried over)"*) ;; *) bad="$bad log.env-not-read" ;; esac
  case "$got" in *"skipped PATH"*|*"skipped HOME"*) bad="$bad never-list-reported-singly" ;; esac
  case "$got" in *"never carried over: PATH HOME LOG_DEVICE CONFIG_CHAIN_LOG OOSH_MODE OOSH_DIR"*) ;; *) bad="$bad no-never-list-summary" ;; esac
  for f in user oosh log; do config.validate "$c/$f.env" >/dev/null 2>&1 || bad="$bad $f.env-invalid"; done
  [ -e "$fx/sourced" ] || [ -e "$fx/sourced.bare" ] && bad="$bad orig-was-sourced"
  [ "$(test.config.origImport.sums "$o")" = "$origSums" ] || bad="$bad orig-changed"
  sharedSums=$(test.config.origImport.sums "$c")
  got=$(test.config.origImport.run)
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 0|imported: none | skipped: 11") ;; *) bad="$bad second-result=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  [ "$(test.config.origImport.sums "$c")" = "$sharedSums" ] || bad="$bad second-run-wrote"
  test.config.origImport.shared 'export LOG_LEVEL="1"' hostA
  sharedSums=$(test.config.origImport.sums "$c")
  test.config.origImport.run >/dev/null
  [ "$(test.config.origImport.sums "$c")" = "$sharedSums" ] || bad="$bad level-1-not-kept=[$(tr '\n' '|' < "$c/log.env")]"
  # No LOG_LEVEL line at all, an empty computer name: both carried, each chain stays last.
  test.config.origImport.shared - ""
  got=$(test.config.origImport.run)
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 0|imported: LOG_LEVEL OOSH_SSH_CONFIG_HOST | skipped: 9") ;; *) bad="$bad empty-result=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  [ "$(tail -n 2 "$c/log.env" | tr '\n' '|')" = 'export LOG_LEVEL="3"|. $HOME/.config/oosh/log.session.env|' ] || bad="$bad missing-level=[$(tr '\n' '|' < "$c/log.env")]"
  [ "$(tr '\n' '|' < "$c/oosh.env")" = 'export OOSH_OS="linux-gnu"|export OOSH_SSH_CONFIG_HOST="bossmac"|. $HOME/.config/oosh/oosh.session.env|' ] || bad="$bad host=[$(tr '\n' '|' < "$c/oosh.env")]"
  for f in oosh log; do config.validate "$c/$f.env" >/dev/null 2>&1 || bad="$bad empty-$f.env-invalid"; done
  # A level log.level does not offer is not carried.
  sed -i.bak 's/^export LOG_LEVEL="3"$/export LOG_LEVEL="verbose"/' "$o/user.env"; rm -f "$o/user.env.bak"
  test.config.origImport.shared 'export LOG_LEVEL=""' hostA
  got=$(test.config.origImport.run)
  grep -qx 'export LOG_LEVEL=""' "$c/log.env" || bad="$bad invalid-level-carried"
  case "$got" in *"skipped LOG_LEVEL (not a valid value: verbose)"*) ;; *) bad="$bad invalid-level-reason" ;; esac
  # The log device on stdout at LOG_LEVEL 4: a log line inside $(…) must not
  # become the value read — the import still happens.
  sed -i.bak 's/^export LOG_LEVEL="verbose"$/export LOG_LEVEL="3"/' "$o/user.env"; rm -f "$o/user.env.bak"
  test.config.origImport.shared 'export LOG_LEVEL=""' hostA
  got=$(test.config.origImport.run "$o" /dev/stdout)
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 0|imported: LOG_LEVEL | skipped: 10") ;; *) bad="$bad stdout-result=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  grep -qx 'export LOG_LEVEL="3"' "$c/log.env" || bad="$bad stdout-not-imported=[$(tr '\n' '|' < "$c/log.env")]"
  # Code in an allow-listed value: skipped, nothing runs, nothing written.
  mkdir -p "$fx/config.orig.inject"
  printf '%s\n' "export OOSH_SSH_CONFIG_HOST=\"\$(touch $fx/host.touched)\"" "export LOG_LEVEL=\"3\"; touch $fx/level.touched" > "$fx/config.orig.inject/user.env"
  test.config.origImport.shared 'export LOG_LEVEL=""' ""
  sharedSums=$(test.config.origImport.sums "$c")
  got=$(test.config.origImport.run "$fx/config.orig.inject")
  case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 0|imported: none | skipped: 2") ;; *) bad="$bad inject-result=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
  case "$got" in *"skipped OOSH_SSH_CONFIG_HOST (not a valid value: "*"skipped LOG_LEVEL (not a valid value: "*) ;; *) bad="$bad inject-reasons" ;; esac
  [ -e "$fx/host.touched" ] || [ -e "$fx/level.touched" ] && bad="$bad inject-ran"
  [ "$(test.config.origImport.sums "$c")" = "$sharedSums" ] || bad="$bad inject-wrote"
  # A shared file that cannot be written: rc 1 naming it, the file unchanged
  # (root writes a read-only file — not checked as root).
  if [ "$(id -u)" != 0 ]; then
    sed -i.bak 's/^export LOG_LEVEL="verbose"$/export LOG_LEVEL="3"/' "$o/user.env"; rm -f "$o/user.env.bak"
    test.config.origImport.shared 'export LOG_LEVEL=""' hostA; chmod a-w "$c/log.env"
    sharedSums=$(test.config.origImport.sums "$c")
    got=$(test.config.origImport.run)
    case "$(printf '%s\n' "$got" | tail -n 1)" in "rc 2|cannot write $c/log.env"*) ;; *) bad="$bad write-fail=[$(printf '%s\n' "$got" | tail -n 1)]" ;; esac
    [ "$(test.config.origImport.sums "$c")" = "$sharedSums" ] || bad="$bad write-fail-changed"
    chmod u+w "$c/log.env"
  fi
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "imported: LOG_LEVEL | skipped: 10" || create.result 1 "orig.import:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ORIG-IMPORT-ALLOWLIST: only the allow-listed values reach the empty shared values, nothing is sourced, a second run changes nothing" \
   test.config.origImport
expect 0 "imported: LOG_LEVEL | skipped: 10" \
  "a kept-aside ~/config must give the shared config only its allow-listed values, and only where they are empty"


console.log "
Test: private.config.shared.oosh.base.get
===================================================================="

# T-CONFIG-SHARED-OOSH-BASE-GET: the base under the parent of developking's home
# config.init.user validated its <sharedOosh> against a base built from
# developking's home while its completion asked oo.mode.base.get — two answers
# (on macOS /Users/shared vs /Users/Shared) and a candidate the method refused.
# One getter now serves both. developking stubbed: the base under the parent
# of their home; no developking: nothing, rc 1.
test.config.sharedOoshBaseGet() {
  local fx bad="" got
  fx=$(test.suite.fixture.make sharedooshbase); mkdir -p "$fx/home/developking"
  test.config.sharedOoshBaseGet.run() { # <devHome|-> — the getter in a child shell; echo "<out>|rc <n>"
    FX="$fx" DH="$1" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      user.get() { [ "$1 $2" = "home developking" ] && [ "$DH" != - ] && echo "$DH"; }
      out=$(private.config.shared.oosh.base.get); echo "$out|rc $?"' 2>/dev/null
  }
  got=$(test.config.sharedOoshBaseGet.run "$fx/home/developking")
  [ "$got" = "$fx/home/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh|rc 0" ] || bad="$bad base=[$got]"
  got=$(test.config.sharedOoshBaseGet.run -)
  [ "$got" = "|rc 1" ] || bad="$bad no-developking=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the base under the parent of developking's home; none without developking" || create.result 1 "shared oosh base:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SHARED-OOSH-BASE-GET: the base under the parent of developking home" \
   test.config.sharedOoshBaseGet
expect 0 "the base under the parent of developking's home; none without developking" \
  "config init.user and its completion asked two places for the base"


console.log "
Test: private.config.env.line.set
===================================================================="

# T-CONFIG-ENV-LINE-SET: the line goes before the trailing chain block in one write
# The writer of one definition in a shared env file: its old lines (export and
# the legacy export declare form, declare -x, runs of spaces — the shapes
# private.config.env.value.read reads) leave, the new line goes in before the chain
# lines at the end — a `. file` with a tab too — so a chain is never off the
# file, not even between two writes. In place: same inode, mode kept. A second
# set rewrites nothing; a file without a chain gets the line last, a last line
# without its newline is not glued; a read-only file is rc 1 and unchanged.
test.config.envLineSet() {
  local fx bad="" f before after got
  fx=$(test.suite.fixture.make envlineset); f="$fx/log.env"
  printf '%s\n' 'export A="1"' 'export LOG_LEVEL=""' 'export declare LOG_LEVEL="x"' 'declare -x LOG_LEVEL="y"' 'export  LOG_LEVEL="z"' 'export LOG_LEVEL_RESET="1"' \
    '. $HOME/.config/oosh/log.session.env' ".	\$CONFIG_PATH/tab.env" > "$f"
  chmod 640 "$f"; before=$(ls -i "$f" | cut -d' ' -f1)
  private.config.env.line.set "$f" LOG_LEVEL 'export LOG_LEVEL="3"' >/dev/null 2>&1 || bad="$bad rc=[$RESULT]"
  [ "$(cat "$f")" = "$(printf '%s\n' 'export A="1"' 'export LOG_LEVEL_RESET="1"' 'export LOG_LEVEL="3"' \
    '. $HOME/.config/oosh/log.session.env' ".	\$CONFIG_PATH/tab.env")" ] || bad="$bad content=[$(tr '\n' '|' < "$f")]"
  [ "$(ls -i "$f" | cut -d' ' -f1)" = "$before" ] || bad="$bad not-in-place"
  [ "$(private.this.path.stat.get "$f" mode)" = 640 ] || bad="$bad mode=[$(private.this.path.stat.get "$f" mode)]"
  touch -t 200001010000 "$f"; before="$(ls -l "$f") $(cksum < "$f")"
  private.config.env.line.set "$f" LOG_LEVEL 'export LOG_LEVEL="3"' >/dev/null 2>&1
  [ "$(ls -l "$f") $(cksum < "$f")" = "$before" ] || bad="$bad second-set-wrote"
  printf '%s' 'export A="1"' > "$f"
  private.config.env.line.set "$f" B 'export B="2"' >/dev/null 2>&1
  [ "$(tr '\n' '|' < "$f")" = 'export A="1"|export B="2"|' ] || bad="$bad no-chain=[$(tr '\n' '|' < "$f")]"
  private.config.env.line.set "$f" "" "" >/dev/null 2>&1 && bad="$bad no-args-rc0"
  if [ "$(id -u)" != 0 ]; then
    chmod a-w "$f"; after=$(cksum < "$f")
    private.config.env.line.set "$f" C 'export C="3"' >/dev/null 2>&1; got=$?
    { [ "$got" = 1 ] && [ "${RESULT#cannot write $f}" != "$RESULT" ]; } || bad="$bad read-only=[rc $got|$RESULT]"
    [ "$(cksum < "$f")" = "$after" ] || bad="$bad read-only-changed"
    chmod u+w "$f"
  fi
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "set before the chain block, in place, once" || create.result 1 "env line set:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ENV-LINE-SET: the line goes before the trailing chain block in one write" \
   test.config.envLineSet
expect 0 "set before the chain block, in place, once" \
  "dropping the chain first lost the session chain for every user when the append failed"


console.log "
Test: private.config.env.value.read
===================================================================="

# T-CONFIG-ENV-VALUE-READ: the last value as data, nothing sourced
# The one reader of a value in an env file that may hold code (a kept-aside
# ~/config) or is shared (the empty-value check of private.config.orig.import).
# Only `export NAME=`, `export declare NAME=` and `declare -x NAME=` at the
# start of a line count — no indented, bare or `declare -a` line; the last one
# wins; enclosing quotes go, anything after them stays (a `"3"; touch …` is
# not 3). Silent at LOG_LEVEL 4 with the log device on stdout: config.get's
# info line inside $(…) became part of the value and nothing was imported.
test.config.envDataFixture() { # <dir> — an old-format env file with code in it: <dir>/user.env
  printf '%s\n' '#!/bin/bash' \
    'export PATH=".:/usr/bin"' \
    '  export INDENT="no"' \
    'BARE="no"' \
    'declare -a ARR="x"' \
    'declare -x LOG_DEVICE="/dev/stdout"' \
    'export LOG_LEVEL="3"' \
    "export INJ=\"3\"; touch $1/touched" \
    'export LOG_LEVEL="2"' \
    "export Q='single'" \
    "export STAMP=\"\$(touch $1/sourced)\"" \
    "touch $1/bare.touched" \
    'export declare OLD="legacy"' > "$1/user.env"
}
test.config.envValueRead() {
  local fx bad="" f got n
  fx=$(test.suite.fixture.make envvalueread); f="$fx/user.env"; test.config.envDataFixture "$fx"
  test.config.envValueRead.get() { # <name> — the reader in a child at LOG_LEVEL 4 with the log on stdout; echo "<out>|rc <n>"
    F="$f" N="$1" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      export LOG_LEVEL=4 LOG_DEVICE=/dev/stdout LOG_LIVE= LOG_INSTALL=
      out=$(private.config.env.value.read "$F" "$N"); echo "$out|rc $?"' 2>/dev/null
  }
  for n in "LOG_LEVEL|2|rc 0" "LOG_DEVICE|/dev/stdout|rc 0" "Q|single|rc 0" "OLD|legacy|rc 0" "PATH|.:/usr/bin|rc 0" \
           "INJ|\"3\"; touch $fx/touched|rc 0" "STAMP|\$(touch $fx/sourced)|rc 0" \
           "INDENT||rc 1" "BARE||rc 1" "ARR||rc 1" "NOSUCH||rc 1"; do
    got=$(test.config.envValueRead.get "${n%%|*}")
    [ "$got" = "${n#*|}" ] || bad="$bad ${n%%|*}=[$got]"
  done
  got=$(test.config.envValueRead.get "")
  [ "$got" = "|rc 1" ] || bad="$bad no-name=[$got]"
  ls "$fx" | grep -qE 'touched|sourced' && bad="$bad sourced"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the last value, as data, silent" || create.result 1 "env value read:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ENV-VALUE-READ: the last value as data, nothing sourced, silent at LOG_LEVEL 4" \
   test.config.envValueRead
expect 0 "the last value, as data, silent" \
  "config.get's info line landed inside \$(…) and nothing was ever imported"


console.log "
Test: private.config.env.names.read
===================================================================="

# T-CONFIG-ENV-NAMES-READ: every assigned name once, in order
# The names a kept-aside ~/config assigns — by the same line shapes as
# private.config.env.value.read, read as data, each once.
test.config.envNamesRead() {
  local fx bad="" got
  fx=$(test.suite.fixture.make envnamesread); test.config.envDataFixture "$fx"
  got=$(private.config.env.names.read "$fx/user.env" 2>/dev/null | tr '\n' ' ')
  [ "$got" = "PATH LOG_DEVICE LOG_LEVEL INJ Q STAMP OLD " ] || bad="$bad names=[$got]"
  got=$(private.config.env.names.read "$fx/none.env" 2>/dev/null)
  [ -z "$got" ] || bad="$bad missing-file=[$got]"
  ls "$fx" | grep -qE 'touched|sourced' && bad="$bad sourced"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "every assigned name once, in order" || create.result 1 "env names read:$bad"
  return $(result)
}
test.case $level "T-CONFIG-ENV-NAMES-READ: every assigned name once, in order" \
   test.config.envNamesRead
expect 0 "every assigned name once, in order" "the names of a kept-aside ~/config must be read as data"


console.log "
Test: private.config.host.name.valid
===================================================================="

# T-CONFIG-HOST-NAME-VALID: a host-name shape, no dot, no code
# The computer name of oosh is the prompt, the log name and the ssh alias:
# letters, digits, - and _ (a Docker name like jolly_gagarin), no dot (a Mac's
# router domain is taken off before, as private.config.host.name.get does),
# at most 63 characters.
test.config.hostNameValid() {
  local bad="" n long
  long=$(printf 'a%.0s' $(seq 1 64))
  for n in bossmac jolly_gagarin MacStudio-2 a1; do
    private.config.host.name.valid "$n" || bad="$bad refused=[$n]"
  done
  for n in "" bossmac.fritz.box -x _x '$(touch x)' 'a b' 'bad;rm' "$long"; do
    private.config.host.name.valid "$n" && bad="$bad accepted=[$n]"
  done
  [ -z "$bad" ] && create.result 0 "a host-name shape, no dot, no code" || create.result 1 "host name valid:$bad"
  return $(result)
}
test.case $level "T-CONFIG-HOST-NAME-VALID: a host-name shape, no dot, no code" \
   test.config.hostNameValid
expect 0 "a host-name shape, no dot, no code" "a value of a kept-aside ~/config became the computer name unchecked"


console.log "
Test: private.config.shared.config.get
===================================================================="

# T-CONFIG-SHARED-CONFIG-GET: the shared config in the file system letter case
# config.init.user built sharedConfig from a literal lowercase `shared`, while
# the oosh base is case-canonical: on macOS (/Users/Shared) ~/config was linked
# as /Users/shared/… and install and heal relinked it on every run. One getter,
# the sibling of private.config.shared.oosh.base.get. macOS is played by a
# private.this.path.case.get that answers the fixture's real letter case.
test.config.sharedConfigGet() {
  local fx bad="" got
  fx=$(test.suite.fixture.make sharedconfigget)
  mkdir -p "$fx/home/developking" "$fx/home/Shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  test.config.sharedConfigGet.run() { # <devHome|-> <getter> — the getter in a child shell on a case-insensitive "Mac"; echo "<out>|rc <n>"
    FX="$fx" DH="$1" G="$2" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
      user.get() { [ "$1 $2" = "home developking" ] && [ "$DH" != - ] && echo "$DH"; }
      private.this.path.case.get() { printf "%s\n" "${1/#$FX\/home\/shared\//$FX/home/Shared/}"; }
      out=$($G); echo "$out|rc $?"' 2>/dev/null
  }
  got=$(test.config.sharedConfigGet.run "$fx/home/developking" private.config.shared.config.get)
  [ "$got" = "$fx/home/Shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig|rc 0" ] || bad="$bad config=[$got]"
  got=$(test.config.sharedConfigGet.run "$fx/home/developking" private.config.shared.oosh.base.get)
  [ "$got" = "$fx/home/Shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh|rc 0" ] || bad="$bad oosh-base=[$got]"
  got=$(test.config.sharedConfigGet.run - private.config.shared.config.get)
  [ "$got" = "|rc 1" ] || bad="$bad no-developking=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the shared config and the oosh base in the file system letter case" || create.result 1 "shared config get:$bad"
  return $(result)
}
test.case $level "T-CONFIG-SHARED-CONFIG-GET: the shared config in the file system letter case" \
   test.config.sharedConfigGet
expect 0 "the shared config and the oosh base in the file system letter case" \
  "a literal lowercase shared made macOS relink ~/config every run"

# T-CONFIG-INIT-USER-CASE-STABLE: on a case-insensitive file system a canonical user is not relinked
# The user's links already name the real letter case (/Users/Shared/…): a
# second config.init.user must find them canonical and run no symlink hop.
# Collaborators stubbed as in T-CONFIG-INIT-USER-SHARED-OOSH-PARAM.
test.config.initUserCaseStable() {
  local fx bad="" base u sc ob got
  fx=$(test.suite.fixture.make initusercasestable); base="$fx/home"; u=$(id -un)
  sc="$base/Shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  ob="$base/Shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"
  mkdir -p "$base/developking" "$base/$u" "$sc" "$ob/dev/.git"
  ln -s "$sc" "$base/$u/config"; ln -s "$ob/dev" "$base/$u/oosh"
  got=$(FX="$fx" U="$u" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    user.get() { [ "$1" = home ] && echo "$FX/home/$2"; }
    private.this.path.case.get() { printf "%s\n" "${1/#$FX\/home\/shared\//$FX/home/Shared/}"; }
    private.as.user() { case "$4" in *symlink.with.backup*) echo "symlink-hop" >> "$FX/hops" ;; esac; }
    private.config.log.chain.migrate() { :; }; private.config.session.files.ensure.all() { :; }
    private.config.bashrc.ensure.all() { :; }; private.config.user.session.migrate() { :; }
    private.config.oosh.session.migrate() { :; }; ogit.safeDirectory.ensure() { :; }
    private.user.check.group() { return 1; }
    export OOSH_MODE=dev
    config.init.user "$U" >/dev/null 2>&1; echo "rc $?"' 2>/dev/null)
  [ "$got" = "rc 0" ] || bad="$bad rc=[$got]"
  [ -e "$fx/hops" ] && bad="$bad relinked"
  [ "$(readlink "$base/$u/config")" = "$sc" ] && [ "$(readlink "$base/$u/oosh")" = "$ob/dev" ] || bad="$bad links-changed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "canonical links in the real letter case are left alone" || create.result 1 "init.user case:$bad"
  return $(result)
}
test.case $level "T-CONFIG-INIT-USER-CASE-STABLE: on a case-insensitive file system a canonical user is not relinked" \
   test.config.initUserCaseStable
expect 0 "canonical links in the real letter case are left alone" \
  "install and heal relinked ~/config on every run on macOS"


# T-CONFIG-ENV-EXPORT-NAMES-GET: the names an env file exports, chains and
# comments ignored — the vocabulary config.init.env's refuse-to-worsen compares.
test.config.envExportNamesGet() {
  local fx got
  fx=$(test.suite.fixture.make test.config.exportnames)
  printf '%s\n' '# export NOT="comment"' 'export A="1"' 'export declare B="2"' '  export C_3="x"' '. $CONFIG_PATH/log.env' 'D="no export"' > "$fx/e.env"
  got=$(private.config.env.export.names.get "$fx/e.env" | tr '\n' ' ')$(private.config.env.export.names.get "$fx/missing")
  rm -rf "$fx"
  [ "$got" = "A B C_3 " ] && create.result 0 "A B C_3" || create.result 1 "names=[$got]"
  return $(result)
}
test.case - "T-CONFIG-ENV-EXPORT-NAMES-GET: the exported names of an env file, nothing for a missing one" \
  test.config.envExportNamesGet
expect 0 "A B C_3" "a comment, a chain and a plain assignment are no exports"

### test.method

test.suite.save.results
