#!/usr/bin/env bash
# Comprehensive tests for the config script
# Tests: init, file, save, list, get, set, add, update, clean, delete, discover

#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
info.log "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

# This file dispatches `config` as a COMMAND in several probes, and a
# non-sourced `log.level` / `config save` persists to whatever CONFIG_PATH it
# inherits. Isolate before sourcing config. Possible only since T7 made
# config.init honour the anchor it is given — until then config.start re-ran
# config.init and moved the anchor back from inside this very file.
test.suite.config.isolate test.config >/dev/null || exit 1

source $OOSH_DIR/config

log.level $level

# Save original config state
ORIGINAL_CONFIG=$CONFIG
ORIGINAL_CONFIG_PATH=$CONFIG_PATH
ORIGINAL_CONFIG_FILE=$CONFIG_FILE

# Test directory for isolation
TEST_CONFIG_PATH="/tmp/test.config.$(id -u).$$"
mkdir -p "$TEST_CONFIG_PATH"

# Cleanup function
cleanup_test_config() {
  rm -rf "$TEST_CONFIG_PATH" 2>/dev/null
  export CONFIG=$ORIGINAL_CONFIG
  export CONFIG_PATH=$ORIGINAL_CONFIG_PATH
  export CONFIG_FILE=$ORIGINAL_CONFIG_FILE
}

# Setup test environment
setup_test_config() {
  export CONFIG_PATH="$TEST_CONFIG_PATH"
  export CONFIG_FILE="test.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  touch "$CONFIG"
}

# ============================================================================
# T1: Test config.init sets up CONFIG variables
# ============================================================================
test.case - "T1: config.init creates CONFIG_PATH and sets CONFIG" \
  config.init

if [ -d "$CONFIG_PATH" ] && [ -n "$CONFIG" ]; then
  create.result 0 "CONFIG initialized"
else
  create.result 1 "CONFIG_PATH=$CONFIG_PATH CONFIG=$CONFIG"
fi
expect 0 "CONFIG initialized" "config.init sets up environment"

# Reset to test environment
setup_test_config

# ============================================================================
# T2: Test config.file without args returns current file
# ============================================================================
test.case - "T2: config.file returns current file" \
  echo "checking"

CURRENT_FILE=$(config.file)
if [ "$CURRENT_FILE" = "$CONFIG_FILE" ]; then
  create.result 0 "file returned"
else
  create.result 1 "got: $CURRENT_FILE expected: $CONFIG_FILE"
fi
expect 0 "file returned" "config.file returns current file"

# ============================================================================
# T3: Test config.file sets new file
# ============================================================================
test.case - "T3: config.file sets new file" \
  config.file newtest.env

if [ "$CONFIG_FILE" = "newtest.env" ]; then
  create.result 0 "file changed"
else
  create.result 1 "CONFIG_FILE=$CONFIG_FILE"
fi
expect 0 "file changed" "config.file sets new file"

# Reset
setup_test_config

# ============================================================================
# T4: Test config.file.check with existing file
# ============================================================================
touch "$CONFIG_PATH/exists.env"
test.case - "T4: config.file.check finds existing file" \
  config.file.check exists

if [ "$RETURN_VALUE" -eq 0 ]; then
  create.result 0 "found exists.env"
else
  create.result 1 "not found"
fi
expect 0 "found exists.env" "config.file.check finds existing file"

# ============================================================================
# T5: Test config.save creates config file
# ============================================================================
export TEST_CONFIG_VAR1="value1"
export TEST_CONFIG_VAR2="value2"
setup_test_config

test.case - "T5: config.save creates file" \
  config.save testcfg TEST_CONFIG

if [ -f "$CONFIG_PATH/testcfg.env" ]; then
  create.result 0 "testcfg.env created"
else
  create.result 1 "testcfg.env missing"
fi
expect 0 "testcfg.env created" "config.save creates file"

# ============================================================================
# T6: Test config.save captures prefixed variables
# ============================================================================
test.case - "T6: config.save captures prefixed variables" \
  echo "checking saved content"

SAVED_CONTENT=$(cat "$CONFIG_PATH/testcfg.env" 2>/dev/null)
if echo "$SAVED_CONTENT" | grep -q "TEST_CONFIG_VAR1" && \
   echo "$SAVED_CONTENT" | grep -q "TEST_CONFIG_VAR2"; then
  create.result 0 "variables saved"
else
  create.result 1 "variables missing"
fi
expect 0 "variables saved" "config.save captures prefixed variables"

# ============================================================================
# T7: Test config.list shows config content
# ============================================================================
setup_test_config
echo 'export TEST_LIST_VAR="listvalue"' > "$CONFIG_PATH/listtest.env"

test.case - "T7: config.list shows content" \
  echo "checking list"

config.file listtest.env
LIST_OUTPUT=$(config.list listtest 2>/dev/null)
if echo "$LIST_OUTPUT" | grep -q "TEST_LIST_VAR"; then
  create.result 0 "list shows content"
else
  create.result 1 "list output: $LIST_OUTPUT"
fi
expect 0 "list shows content" "config.list shows variables"

# ============================================================================
# T8: Test config.set adds new variable
# ============================================================================
setup_test_config
echo '# empty config' > "$CONFIG"

test.case - "T8: config.set adds new variable" \
  config.set NEW_VAR "newvalue"

if grep -q 'NEW_VAR="newvalue"' "$CONFIG"; then
  create.result 0 "NEW_VAR added"
else
  create.result 1 "NEW_VAR missing in $CONFIG"
fi
expect 0 "NEW_VAR added" "config.set adds new variable"

# ============================================================================
# T9: Test config.set updates existing variable
# ============================================================================
setup_test_config
echo 'export EXISTING_VAR="oldvalue"' > "$CONFIG"

test.case - "T9: config.set updates existing variable" \
  config.set EXISTING_VAR "updatedvalue"

if grep -q 'EXISTING_VAR="updatedvalue"' "$CONFIG"; then
  create.result 0 "EXISTING_VAR updated"
else
  create.result 1 "EXISTING_VAR not updated"
fi
expect 0 "EXISTING_VAR updated" "config.set updates existing variable"

# ============================================================================
# T10: config.get reads value from the file (not from shell env)
# ============================================================================
setup_test_config
echo 'export GET_TEST_VAR="getvalue"' > "$CONFIG"
unset GET_TEST_VAR

test.case - "T10: config.get reads value from file" \
  echo "checking get"

GET_RESULT=$(config.get GET_TEST_VAR 2>/dev/null)
if [ "$GET_RESULT" = "getvalue" ]; then
  create.result 0 "got value"
else
  create.result 1 "got: $GET_RESULT"
fi
expect 0 "got value" "config.get reads value from file (not shell env)"

# ============================================================================
# T11: Test config.add appends source line
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
touch "$CONFIG_PATH/addon.env"

test.case - "T11: config.add appends source line" \
  config.add addon

# config.add calls config.clean which sorts the file
if grep -qE '(source|\.) \$CONFIG_PATH/addon\.env' "$CONFIG"; then
  create.result 0 "source added"
else
  create.result 1 "source missing in: $(cat $CONFIG)"
fi
expect 0 "source added" "config.add appends source line"

# ============================================================================
# T12: Test config.clean removes duplicates
# ============================================================================
setup_test_config
cat > "$CONFIG" << 'EOF'
export DUP_VAR="value"
export DUP_VAR="value"
export UNIQUE_VAR="unique"
export DUP_VAR="value"
EOF

test.case - "T12: config.clean removes duplicates" \
  config.clean

LINE_COUNT=$(grep -c "DUP_VAR" "$CONFIG" 2>/dev/null || echo "0")
if [ "$LINE_COUNT" -eq 1 ]; then
  create.result 0 "duplicates removed"
else
  create.result 1 "duplicates remain: $LINE_COUNT"
fi
expect 0 "duplicates removed" "config.clean removes duplicates"

# ============================================================================
# T13: Test config.delete removes config file
# ============================================================================
setup_test_config
touch "$CONFIG_PATH/todelete.env"
config.file todelete.env

test.case - "T13: config.delete removes file" \
  config.delete todelete

if [ ! -f "$CONFIG_PATH/todelete.env" ]; then
  create.result 0 "file deleted"
else
  create.result 1 "file still exists"
fi
expect 0 "file deleted" "config.delete removes file"

# ============================================================================
# T14: Test config.discover lists config files
# ============================================================================
setup_test_config
touch "$CONFIG_PATH/discover1.env"
touch "$CONFIG_PATH/discover2.env"

test.case - "T14: config.discover lists files" \
  echo "checking discover"

DISCOVER_OUTPUT=$(config.discover 2>/dev/null)
if echo "$DISCOVER_OUTPUT" | grep -q "discover1.env"; then
  create.result 0 "discover1 found"
else
  create.result 1 "output: $DISCOVER_OUTPUT"
fi
expect 0 "discover1 found" "config.discover lists files"

# ============================================================================
# T15: Test config.string.quote handles special chars
# ============================================================================
test.case - "T15: config.string.quote returns quoted string" \
  echo "checking quote"

QUOTED=$(config.string.quote "hello world")
if [ -n "$QUOTED" ]; then
  create.result 0 "string quoted"
else
  create.result 1 "quote failed"
fi
expect 0 "string quoted" "config.string.quote returns quoted string"

# ============================================================================
# T16: Test config.file reset restores defaults
# ============================================================================
config.file someother.env

test.case - "T16: config.file reset restores user.env" \
  config.file reset

if [ "$CONFIG_FILE" = "user.env" ]; then
  create.result 0 "file reset"
else
  create.result 1 "CONFIG_FILE=$CONFIG_FILE"
fi
expect 0 "file reset" "config.file reset restores user.env"

# Reset for remaining tests
setup_test_config

# ============================================================================
# T17: Test config.update saves and adds
# ============================================================================
export TEST_UPDATE_VAR="updateval"
setup_test_config
echo '# main config' > "$CONFIG"

test.case - "T17: config.update saves and adds" \
  config.update updatetest TEST_UPDATE

# Check file was created and source line added
if [ -f "$CONFIG_PATH/updatetest.env" ] && grep -qE '(source|\.) \$CONFIG_PATH/updatetest\.env' "$CONFIG"; then
  create.result 0 "update complete"
else
  create.result 1 "file exists: $(test -f $CONFIG_PATH/updatetest.env && echo yes || echo no) source: $(grep updatetest $CONFIG)"
fi
expect 0 "update complete" "config.update saves and adds"

# ============================================================================
# T18: Test config.get with missing variable
# ============================================================================
unset NONEXISTENT_VAR

test.case - "T18: config.get returns empty for missing var" \
  echo "checking missing"

GET_MISSING=$(config.get NONEXISTENT_VAR 2>/dev/null)
if [ -z "$GET_MISSING" ]; then
  create.result 0 "empty for missing"
else
  create.result 1 "returned: $GET_MISSING"
fi
expect 0 "empty for missing" "config.get returns empty for missing var"

# ============================================================================
# T19: Test config.set with empty value
# ============================================================================
setup_test_config
echo 'export EMPTY_TEST="hasvalue"' > "$CONFIG"

test.case - "T19: config.set allows empty value" \
  config.set EMPTY_TEST ""

if grep -q 'EMPTY_TEST=""' "$CONFIG"; then
  create.result 0 "set to empty"
else
  create.result 1 "config content: $(cat $CONFIG)"
fi
expect 0 "set to empty" "config.set allows empty value"

# ============================================================================
# T20: config.set + config.get round-trip
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
unset ROUND_TRIP_VAR

test.case - "T20: config.set then config.get round-trips through the file" \
  echo "checking round-trip"

config.set ROUND_TRIP_VAR foo >/dev/null
ROUND_TRIP_RESULT=$(config.get ROUND_TRIP_VAR 2>/dev/null)
if [ "$ROUND_TRIP_RESULT" = "foo" ]; then
  create.result 0 "round-trip worked"
else
  create.result 1 "got: $ROUND_TRIP_RESULT (config: $(cat $CONFIG))"
fi
expect 0 "round-trip worked" "config.set + config.get round-trip via file"

# ============================================================================
# T21: config.set + config.get preserves quoted spaces
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
unset SPACE_RT_VAR

test.case - "T21: config.set + config.get preserves quoted spaces" \
  echo "checking spaces"

config.set SPACE_RT_VAR "hello world" >/dev/null
SPACE_RT_RESULT=$(config.get SPACE_RT_VAR 2>/dev/null)
if [ "$SPACE_RT_RESULT" = "hello world" ]; then
  create.result 0 "spaces preserved"
else
  create.result 1 "got: '$SPACE_RT_RESULT'"
fi
expect 0 "spaces preserved" "config.set/get preserves quoted spaces"

# ============================================================================
# T22: config.set does NOT leak the full config to stdout on append
# ============================================================================
setup_test_config
echo '# user config' > "$CONFIG"
unset LEAK_CHECK_VAR

test.case - "T22: config.set does not leak full config on append" \
  echo "checking no leak"

LEAK_OUT=$(config.set LEAK_CHECK_VAR x 2>&1)
LEAK_LINES=$(printf '%s' "$LEAK_OUT" | grep -c '.' )
if [ "$LEAK_LINES" -le 1 ]; then
  create.result 0 "no leak"
else
  create.result 1 "leaked $LEAK_LINES lines: $LEAK_OUT"
fi
expect 0 "no leak" "config.set must not print the full config on append"

# ============================================================================
# T23: config.get tolerates legacy "export declare X=" malformed lines
# ============================================================================
setup_test_config
echo 'export declare LEGACY_VAR="legacy"' > "$CONFIG"
unset LEGACY_VAR

test.case - "T23: config.get reads legacy 'export declare X=' lines" \
  echo "checking legacy form"

LEGACY_RESULT=$(config.get LEGACY_VAR 2>/dev/null)
if [ "$LEGACY_RESULT" = "legacy" ]; then
  create.result 0 "legacy form readable"
else
  create.result 1 "got: '$LEGACY_RESULT' (file: $(cat $CONFIG))"
fi
expect 0 "legacy form readable" "config.get tolerates malformed export-declare line"

# ============================================================================
# T24: config.set normalizes malformed lines on update
# ============================================================================
setup_test_config
echo 'export declare NORMALIZE_VAR="old"' > "$CONFIG"
unset NORMALIZE_VAR

test.case - "T24: config.set normalizes 'export declare X=' to clean form" \
  echo "checking normalization"

config.set NORMALIZE_VAR "new" >/dev/null
NORMALIZE_RESULT=$(config.get NORMALIZE_VAR 2>/dev/null)
if [ "$NORMALIZE_RESULT" = "new" ] && grep -q '^export NORMALIZE_VAR=' "$CONFIG" && ! grep -q 'export declare NORMALIZE_VAR' "$CONFIG"; then
  create.result 0 "normalized"
else
  create.result 1 "got '$NORMALIZE_RESULT', file: $(cat $CONFIG)"
fi
expect 0 "normalized" "config.set normalizes legacy export-declare lines on update"

# ============================================================================
# Cleanup
# ============================================================================
cleanup_test_config

# Unset test variables
unset TEST_CONFIG_VAR1
unset TEST_CONFIG_VAR2
unset TEST_UPDATE_VAR

# ============================================================================
# Completion function tests
# ============================================================================

test.case $level "config.parameter.completion.configfile exists" \
  type -t config.parameter.completion.configfile
if type -t config.parameter.completion.configfile &>/dev/null; then
  expect.pass "config.parameter.completion.configfile function exists"
else
  expect.fail "config.parameter.completion.configfile should exist"
fi

test.case $level "config.parameter.completion.envVariable exists" \
  type -t config.parameter.completion.envVariable
if type -t config.parameter.completion.envVariable &>/dev/null; then
  expect.pass "config.parameter.completion.envVariable function exists"
else
  expect.fail "config.parameter.completion.envVariable should exist"
fi

test.case $level "config.parameter.completion.name returns values" \
  config.parameter.completion.name ""
COMP_OUTPUT=$(config.parameter.completion.name "" 2>/dev/null)
if [ -n "$COMP_OUTPUT" ]; then
  expect.pass "config.parameter.completion.name returns config names"
else
  expect.pass "config.parameter.completion.name runs (may be empty if no configs)"
fi

test.case $level "config.parameter.completion.sshConfigName exists" \
  type -t config.parameter.completion.sshConfigName
if type -t config.parameter.completion.sshConfigName &>/dev/null; then
  expect.pass "config.parameter.completion.sshConfigName function exists"
else
  expect.fail "config.parameter.completion.sshConfigName should exist"
fi

# ============================================================================
# T21: config.save excludes INSTALL variables
# ============================================================================
test.config.saveExcludesInstall() {
  local FIXTURE="/tmp/test.config.install.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="install_test.env" CONFIG="$FIXTURE/install_test.env"
  touch "$CONFIG"
  export LOG_INSTALL="/tmp/test_install_log"
  config.save install_test LOG
  if grep -q 'LOG_INSTALL' "$FIXTURE/install_test.env" 2>/dev/null; then
    create.result 1 "LOG_INSTALL found in saved config (should be excluded)"
  else
    create.result 0 "INSTALL variables excluded"
  fi
  unset LOG_INSTALL
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  rm -rf "$FIXTURE"
}
test.case - "T21: config.save excludes INSTALL variables" \
  test.config.saveExcludesInstall
expect 0 "INSTALL variables excluded" "config.save excludes INSTALL variables"

# ============================================================================
# T22: config.save preserves non-INSTALL variables
# ============================================================================
test.config.savePreservesNonInstall() {
  local FIXTURE="/tmp/test.config.preserve.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="preserve_test.env" CONFIG="$FIXTURE/preserve_test.env"
  touch "$CONFIG"
  export OOSH_TEST_PRESERVE="keepme"
  config.save preserve_test OOSH_TEST
  if grep -q 'OOSH_TEST_PRESERVE' "$FIXTURE/preserve_test.env" 2>/dev/null; then
    create.result 0 "non-INSTALL variables preserved"
  else
    create.result 1 "OOSH_TEST_PRESERVE missing from saved config"
  fi
  unset OOSH_TEST_PRESERVE
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  rm -rf "$FIXTURE"
}
test.case - "T22: config.save preserves non-INSTALL variables" \
  test.config.savePreservesNonInstall
expect 0 "non-INSTALL variables preserved" "config.save preserves non-INSTALL variables"

# ============================================================================
# T23: config saves BASH_FILE to oosh.env
# ============================================================================
test.config.savesBashFile() {
  local SRC
  SRC=$(declare -f config.save 2>/dev/null)
  if echo "$SRC" | grep -q 'BASH_FILE'; then
    create.result 0 "BASH_FILE referenced in config.save"
  else
    create.result 1 "BASH_FILE not found in config.save"
  fi
}
test.case - "T23: config saves BASH_FILE to oosh.env" \
  test.config.savesBashFile
expect 0 "BASH_FILE referenced in config.save" "config saves BASH_FILE"

# ============================================================================
# T74: sourcing boot TWICE does not grow PATH (was a second, unfalsifiable T24)
# ============================================================================
# This replaces a test that ALSO called itself T24 and could not fail: it
# grepped boot for '":$PATH:"' and '":$OOSH_DIR:"', both of which appear in
# boot's own COMMENT at boot:101 — so it passed with the `case` statements
# deleted. Nothing anywhere sourced boot and looked at the resulting PATH.
#
# BEHAVIOURAL instead: source boot twice in a clean sub-shell and inspect what
# comes out. $OOSH_DIR must appear exactly once, and the second source must not
# lengthen PATH at all.
#
# Scope note: this pins the OOSH_DIR block (boot:103-109), which is
# segment-idempotent. The $BASH_FILE block (boot:110-117) is deliberately
# front-anchored — brew bash must beat the /bin/bash that macOS path_helper
# appends — so it CAN grow PATH by one entry, and BASH_FILE is therefore unset
# here. See docs/boot.md § Idempotent.
test.config.bootDoubleSourceDoesNotGrowPath() {
  local once twice segments
  once=$(env -u BASH_FILE HOME="$HOME" bash -c '. "$HOME/oosh/boot" >/dev/null 2>&1; printf "%s" "$PATH"')
  twice=$(env -u BASH_FILE HOME="$HOME" bash -c '. "$HOME/oosh/boot" >/dev/null 2>&1; . "$HOME/oosh/boot" >/dev/null 2>&1; printf "%s" "$PATH"')
  segments=$(printf '%s' "$once" | tr ':' '\n' | grep -c -x -F "$HOME/oosh")
  if [ "$once" != "$twice" ]; then
    create.result 1 "the second source changed PATH: [$once] vs [$twice]"
  elif [ "$segments" != "1" ]; then
    create.result 1 "\$OOSH_DIR appears $segments time(s) in PATH, expected exactly 1"
  else
    create.result 0 "idempotent"
  fi
  return $(result)
}
test.case - "T74: re-sourcing boot never grows PATH, and \$OOSH_DIR appears once" \
  test.config.bootDoubleSourceDoesNotGrowPath
expect 0 "idempotent" "the colon-anchored guard is an exact-SEGMENT test, not a substring one"

# ============================================================================
# T25: config.string.quote handles spaces
# ============================================================================
test.config.stringQuoteSpaces() {
  local RESULT_QUOTE
  RESULT_QUOTE=$(config.string.quote "hello world")
  if echo "$RESULT_QUOTE" | grep -q "hello world"; then
    create.result 0 "spaces preserved in quoted string"
  else
    create.result 1 "got: $RESULT_QUOTE"
  fi
}
test.case - "T25: config.string.quote handles spaces" \
  test.config.stringQuoteSpaces
expect 0 "spaces preserved in quoted string" "config.string.quote handles spaces"

# ============================================================================
# T26: config.string.quote handles double quotes
# ============================================================================
test.config.stringQuoteDoubleQuotes() {
  local RESULT_QUOTE
  RESULT_QUOTE=$(config.string.quote 'say "hello"')
  if echo "$RESULT_QUOTE" | grep -q 'hello'; then
    create.result 0 "double-quote string quoted"
  else
    create.result 1 "quote returned empty or mangled"
  fi
}
test.case - "T26: config.string.quote handles double quotes" \
  test.config.stringQuoteDoubleQuotes
expect 0 "double-quote string quoted" "config.string.quote handles double quotes"

# ============================================================================
# T27: config.set handles value with spaces
# ============================================================================
test.config.setHandlesSpaces() {
  local FIXTURE="/tmp/test.config.spaces.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="spaces_test.env" CONFIG="$FIXTURE/spaces_test.env"
  echo '# empty config' > "$CONFIG"
  config.set SPACE_VAR "hello world test"
  if grep -q 'SPACE_VAR=.*hello world test' "$CONFIG"; then
    create.result 0 "value with spaces stored"
  else
    create.result 1 "config content: $(cat "$CONFIG")"
  fi
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  rm -rf "$FIXTURE"
}
test.case - "T27: config.set handles value with spaces" \
  test.config.setHandlesSpaces
expect 0 "value with spaces stored" "config.set handles value with spaces"

# ============================================================================
# T28: config.save does not capture variables whose VALUE contains the prefix
# ============================================================================
# T28: grep pattern [_=] matches var NAMES with prefix but not VALUES containing prefix
test.case - "T28: config grep pattern excludes value-only matches" \
  echo "checking"

# Simulate declare -p output with a false-positive value match
TEST_DECLARE='declare -x OOSH_DIR="/path"
declare -- COMMANDS="save oosh OOSH"
declare -x OOSH_PROMPT="oosh "'
MATCHED=$(echo "$TEST_DECLARE" | grep " OOSH[_=]")
if echo "$MATCHED" | grep -q "OOSH_DIR" && \
   echo "$MATCHED" | grep -q "OOSH_PROMPT" && \
   ! echo "$MATCHED" | grep -q "COMMANDS"; then
  create.result 0 "pattern correct"
else
  create.result 1 "got: $MATCHED"
fi
expect 0 "pattern correct" "grep ' PREFIX[_=]' matches names not values"

# ============================================================================
# T29: config.save excludes per-user absolute-path leaks
# ============================================================================
# CONFIG_PATH/CONFIG/OOSH_DIR/OOSH_COMPONENTS_DIR/LOG_LIVE are all dynamically
# rebuilt from $HOME at every shell init (this:209, this:40-49, log:21-23).
# Persisting their saving-user absolute values into shared config causes
# EACCES leaks when a different user later sources it.
test.config.saveExcludesAbsolutePathLeaks() {
  local FIXTURE="/tmp/test.config.leaks.$$"
  mkdir -p "$FIXTURE"
  local ORIG_CP="$CONFIG_PATH" ORIG_CF="$CONFIG_FILE" ORIG_C="$CONFIG"

  # Pin all five candidates to obviously-absolute paths the test can grep for.
  local SAVED_CONFIG_PATH="$CONFIG_PATH" SAVED_CONFIG="$CONFIG"
  local SAVED_OOSH_DIR="$OOSH_DIR" SAVED_OOSH_COMP="$OOSH_COMPONENTS_DIR"
  local SAVED_LOG_LIVE="$LOG_LIVE"
  export OOSH_COMPONENTS_DIR="/tmp/leak-oosh-comp"
  export LOG_LIVE="/tmp/leak-log-live"

  # Now point CONFIG_PATH/CONFIG at the fixture; persist with three prefixes
  # to cover all the leaking name families.
  export CONFIG_PATH="$FIXTURE" CONFIG_FILE="leaks_test.env" CONFIG="$FIXTURE/leaks_test.env"
  touch "$CONFIG"

  # Accumulate after EACH save. config.save truncates $CONFIG (`} >$CONFIG`),
  # so reading the file once at the end only ever sees the LAST prefix — which
  # made four of the six assertions below unfallible: CONFIG_PATH=, CONFIG=,
  # OOSH_DIR= and OOSH_COMPONENTS_DIR= could not appear in a LOG-only file.
  local content=""
  config.save leaks_test CONFIG > /dev/null; content="$content$(cat "$CONFIG" 2>/dev/null)"$'\n'
  config.save leaks_test OOSH   > /dev/null; content="$content$(cat "$CONFIG" 2>/dev/null)"$'\n'
  config.save leaks_test LOG    > /dev/null; content="$content$(cat "$CONFIG" 2>/dev/null)"$'\n'
  local fail=0
  # OOSH_BRANCH is not an absolute path; it is on this list for the other
  # reason the exclusion case exists — it is install INPUT, not state. Persist
  # it and the config feeds it back to the next shell, which feeds it back to
  # the config, and nothing in that loop ever looks at the checkout. That is T7.
  for leaker in CONFIG_PATH= 'CONFIG=' OOSH_DIR= OOSH_COMPONENTS_DIR= LOG_LIVE= LOG_DEVICE= OOSH_BRANCH=; do
    if echo "$content" | grep -q "$leaker"; then
      fail=1
      important.log "leaked: $leaker found in saved config"
    fi
  done
  if [ "$fail" -eq 0 ]; then
    create.result 0 "absolute-path leaks excluded"
  else
    create.result 1 "saved config: $content"
  fi

  # Restore.
  export CONFIG_PATH="$ORIG_CP" CONFIG_FILE="$ORIG_CF" CONFIG="$ORIG_C"
  export OOSH_COMPONENTS_DIR="$SAVED_OOSH_COMP"
  export LOG_LIVE="$SAVED_LOG_LIVE"
  rm -rf "$FIXTURE"
}
test.case - "T29: config.save excludes per-user absolute-path leaks" \
  test.config.saveExcludesAbsolutePathLeaks
expect 0 "absolute-path leaks excluded" "config.save excludes the derived per-user paths and the install input OOSH_BRANCH"

# ============================================================================
# T30: config.save generates a CODE-FREE user.env (values + source chain, no logic)
# ============================================================================
# "NEVER logic in ENV FILES": user.env holds config values + the `source *.env`
# chain (composition, allowed) but NO logic — no self-anchor `: ${…}`, no `{ } &&`,
# no `if`. Fixture-based (config.init.env into a temp dir), independent of the
# live host.
test.config.userEnvSelfAnchors() {
  local fixture="/tmp/test.config.pure.$(id -u).$$"; mkdir -p "$fixture"
  echo "# bogus" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1
  local rc=$?
  # forbid actual logic (self-anchor / brace-group / if); the source chain is fine
  local code; code=$(grep -nE '^[[:space:]]*(:[[:space:]]|\{|if[[:space:]])' "$fixture/user.env" 2>/dev/null | head -1)
  # and it must carry the source chain (proves it's the full config, not 2 lines)
  local haschain=1; grep -qE '(source|\.) .*oosh\.env' "$fixture/user.env" || haschain=0
  rm -rf "$fixture" 2>/dev/null
  if [ "$rc" -eq 0 ] && [ -z "$code" ] && [ "$haschain" = "1" ]; then
    create.result 0 "user.env is code-free with source chain"
  else
    create.result 1 "user.env wrong (validate rc=$rc, code line: $code, chain=$haschain)"
  fi
}
test.case - "T30: config.save generates code-free user.env (values + source chain)" \
  test.config.userEnvSelfAnchors
expect 0 "user.env is code-free with source chain" "user.env has no logic but keeps the source chain"

# ============================================================================
# T31: boot IS the single setter for BOTH path anchors, and sets them literal
# ============================================================================
# Neither anchor is defined inside the env files any more. $OOSH_DIR/boot sets
# OOSH_DIR to ~/oosh and CONFIG_PATH to ~/config — the symlink paths THEMSELVES,
# never their resolved targets, never oo.mode.base.get, never a BASH_SOURCE
# walk. That is the boss ruling "OOSH_DIR is always ~/oosh", and CONFIG_PATH
# follows it for the same reason; because the values are then constants, boot is
# the ONE place that assigns them. The tree-wide sweep is owned by
# this.anchor.validate (covered by test.this T-OOSH-DIR-* / T-CONFIG-PATH-*) —
# delegated to here rather than re-implemented.
test.config.ooshDirSelfAnchors() {
  local ok=1 ooshLine configLine
  ooshLine=$(grep -F 'export OOSH_DIR=' "$OOSH_DIR/boot" | head -1)
  configLine=$(grep -F 'export CONFIG_PATH=' "$OOSH_DIR/boot" | head -1)
  # each assignment must be the literal constant — no resolution, no derivation
  printf '%s' "$ooshLine"   | grep -Fqx 'export OOSH_DIR="$HOME/oosh"'     || ok=0
  printf '%s' "$configLine" | grep -Fqx 'export CONFIG_PATH="$HOME/config"' || ok=0
  # and no ACTUAL (non-comment) line may derive OOSH_DIR from oo.mode.base.get
  if grep 'mode.base.get' "$OOSH_DIR/boot" 2>/dev/null | grep -vqE '^[[:space:]]*#'; then
    ok=0
  fi
  # tree-wide, both anchors: delegate to the owning method
  local verdict okLines
  verdict=$(this.anchor.validate all "$OOSH_DIR" 2>/dev/null)
  # LOG_DEVICE may not be a tty here, so error.log lines can share the capture
  okLines=$(printf '%s\n' "$verdict" | grep -c "0 violations")
  [ "$okLines" -eq 2 ] || ok=0
  if [ "$ok" = "1" ]; then
    create.result 0 "boot sets both anchors literal"
  else
    create.result 1 "oosh: $ooshLine | config: $configLine | tree: $verdict"
  fi
}
test.case - "T31: boot sets the constants OOSH_DIR=\$HOME/oosh and CONFIG_PATH=\$HOME/config" \
  test.config.ooshDirSelfAnchors
expect 0 "boot sets both anchors literal" "both anchors are always the ~/… symlinks themselves"

# ============================================================================
# T32: private.ensure.sharedTree drops self-referential symlinks
# ============================================================================
# Fixture: a temp dir with a symlink that points back to itself (the exact
# bug pattern observed under sharedConfig/sharedConfig on tampered VMs).
test.config.selfLoopRemoved() {
  local fixture="/tmp/test.config.fixture.$(id -u).$$"
  mkdir -p "$fixture"
  ln -s "$fixture" "$fixture/loop"
  private.ensure.sharedTree "$fixture" >/dev/null 2>&1
  if [ -L "$fixture/loop" ] || [ -e "$fixture/loop" ]; then
    create.result 1 "self-loop survived"
  else
    create.result 0 "self-loop removed"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T32: private.ensure.sharedTree removes self-loop symlinks" \
  test.config.selfLoopRemoved
expect 0 "self-loop removed" "self-referential symlink is detected and dropped"

# ============================================================================
# T33: private.ensure.sharedTree is idempotent (re-run produces no further change)
# ============================================================================
# Capture the dir's metadata, re-run, compare. If the helper is idempotent
# the second run is a no-op observable in the metadata snapshot.
test.config.sharedTreeIdempotent() {
  local fixture="/tmp/test.config.idem.$(id -u).$$"
  mkdir -p "$fixture/sub"
  touch "$fixture/file"
  private.ensure.sharedTree "$fixture" >/dev/null 2>&1
  local snap1
  snap1=$(find "$fixture" -printf "%M %g %p\n" 2>/dev/null | sort)
  private.ensure.sharedTree "$fixture" >/dev/null 2>&1
  local snap2
  snap2=$(find "$fixture" -printf "%M %g %p\n" 2>/dev/null | sort)
  if [ "$snap1" = "$snap2" ]; then
    create.result 0 "idempotent"
  else
    create.result 1 "second run changed metadata"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T33: private.ensure.sharedTree is idempotent" \
  test.config.sharedTreeIdempotent
expect 0 "idempotent" "re-running produces no further metadata change"

# ============================================================================
# T34: config.init.check is silent (returns 0, no failure) on a healthy shell
# ============================================================================
# We can't assert *no warnings* without parsing log output, so just verify
# the return code: check is documented as diagnostic-only and must always
# return 0 regardless of state.
test.config.checkAlwaysSucceeds() {
  config.init.check "$USER" >/dev/null 2>&1
  create.result $? "check returned"
}
test.case - "T34: config.init.check is non-blocking (always returns 0)" \
  test.config.checkAlwaysSucceeds
expect 0 "check returned" "config.init.check never fails the caller"

# ============================================================================
# T35: completion functions for username parameter exist and are callable
# ============================================================================
# config.init.user/.check/.full all delegate username completion to user.list.
# We assert the functions are defined; verifying user.list output requires
# sourcing dev/user, which this test file deliberately does not (test isolation
# pattern matches T18-T20 above which use `type -t`).
test.config.completionsExist() {
  if [ "$(type -t config.init.user.completion.username)"  = "function" ] \
  && [ "$(type -t config.init.check.completion.username)" = "function" ] \
  && [ "$(type -t config.init.full.completion.username)"  = "function" ]; then
    create.result 0 "completions defined"
  else
    create.result 1 "missing: user/[$(type -t config.init.user.completion.username)] check/[$(type -t config.init.check.completion.username)] full/[$(type -t config.init.full.completion.username)]"
  fi
}
test.case - "T35: config.init.* username completion functions are defined" \
  test.config.completionsExist
expect 0 "completions defined" "all three username completions exist"

# ============================================================================
# T36: config.init.full is defined and callable as a function
# ============================================================================
# Function-existence smoke test only — invoking config.init.full for real
# would call config.init.shared which mutates the live sharedConfig (chgrp,
# chmod) and prompts for sudo on a fresh shell. That's the right behaviour
# in production but bad for unit tests. We assert the dispatcher exists;
# real end-to-end coverage lives in the manual verification block in the
# plan (running ./config init.full on .149 + diffing snapshots).
test.config.fullExists() {
  if [ "$(type -t config.init.full)" = "function" ]; then
    create.result 0 "full defined"
  else
    create.result 1 "config.init.full is not a function"
  fi
}
test.case - "T36: config.init.full is a defined function (dispatcher smoke test)" \
  test.config.fullExists
expect 0 "full defined" "config.init.full exists and is callable"

# ============================================================================
# T37: config.init.env regenerates oosh.env as PURE data
# ============================================================================
# Mirrors what install does. After init.env, oosh.env must be pure data (only
# export/comment/blank) — no OOSH_DIR self-anchor, no PATH block, no source-log
# line. config.validate is the guard.
test.config.initEnvRegensOoshEnv() {
  local fixture="/tmp/test.config.env.$(id -u).$$"
  mkdir -p "$fixture"
  # Seed with deliberately-wrong content (the boss-tamper pattern)
  echo "# bogus content" > "$fixture/oosh.env"
  echo "# bogus user" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  CONFIG_PATH="$fixture" config.validate oosh >/dev/null 2>&1
  local rc=$?
  rm -rf "$fixture" 2>/dev/null
  if [ "$rc" -eq 0 ]; then
    create.result 0 "oosh.env is pure data after regen"
  else
    create.result 1 "oosh.env not pure after regen"
  fi
}
test.case - "T37: config.init.env regenerates oosh.env as pure data" \
  test.config.initEnvRegensOoshEnv
expect 0 "oosh.env is pure data after regen" "config.init.env writes pure-data oosh.env"

# ============================================================================
# T38: config.init.env regenerates user.env as PURE data
# ============================================================================
test.config.initEnvRegensUserEnv() {
  local fixture="/tmp/test.config.userenv.$(id -u).$$"
  mkdir -p "$fixture"
  echo "# bogus content" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1
  local rc=$?
  rm -rf "$fixture" 2>/dev/null
  if [ "$rc" -eq 0 ]; then
    create.result 0 "user.env is pure data after regen"
  else
    create.result 1 "user.env not pure after regen"
  fi
}
test.case - "T38: config.init.env regenerates user.env as pure data" \
  test.config.initEnvRegensUserEnv
expect 0 "user.env is pure data after regen" "config.init.env writes pure-data user.env"

# ============================================================================
# T39: config.init.env backs up user.env to user.env.bak.<ts> before regen
# ============================================================================
test.config.initEnvBacksUpUserEnv() {
  local fixture="/tmp/test.config.bak.$(id -u).$$"
  mkdir -p "$fixture"
  local sentinel="MARKER_$(date +%s%N)"
  echo "$sentinel" > "$fixture/user.env"
  CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
    config.init.env >/dev/null 2>&1
  if ls "$fixture"/user.env.bak.* >/dev/null 2>&1 \
     && grep -q "$sentinel" "$fixture"/user.env.bak.* 2>/dev/null; then
    create.result 0 "user.env backup created with original content"
  else
    create.result 1 "no backup or sentinel missing: $(ls "$fixture")"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T39: config.init.env backs up user.env before regenerating" \
  test.config.initEnvBacksUpUserEnv
expect 0 "user.env backup created with original content" "user.env is preserved as user.env.bak.<ts>"

# ============================================================================
# T40: boot is POSIX-sh clean (env -i sh can boot correctly)
# ============================================================================
# The bootstrap logic lives in $OOSH_DIR/boot, which must parse under a bare
# POSIX shell (dash `ossh exec`, `env -i sh`), not just bash — that is what
# makes "env -i sh … shall boot correctly" true. Pure-data env files sourced
# via `.` also parse under sh.
test.config.fallbackPrecedesSourceLines() {
  if ! sh -n "$OOSH_DIR/boot" 2>/dev/null; then
    create.result 1 "boot fails sh -n: $(sh -n "$OOSH_DIR/boot" 2>&1 | head -1)"
    return
  fi
  # ash too (Alpine/busybox is a supported ossh.exec target — see T52, which
  # proves it RUNS; this only proves it PARSES, and runs everywhere busybox is).
  if command -v busybox >/dev/null 2>&1 && ! busybox ash -n "$OOSH_DIR/boot" 2>/dev/null; then
    create.result 1 "boot fails ash -n: $(busybox ash -n "$OOSH_DIR/boot" 2>&1 | head -1)"
    return
  fi
  # `-n` alone is blind to `[[`, `local`, `source` … — to dash they are valid
  # COMMAND NAMES and only fail at run time. Grep the common bashisms out
  # explicitly (the same guard T-BOOTPATH-PROFILED-CONTENT-IS-POSIX applies).
  local bashism
  bashism=$(grep -nE '^[^#]*(^|[[:space:];&|(])(\[\[|\(\(|local|source|declare|typeset)([[:space:]]|$)' "$OOSH_DIR/boot" | head -1)
  if [ -n "$bashism" ]; then
    create.result 1 "boot contains a bashism: $bashism"
    return $(result)
  fi
  create.result 0 "boot is POSIX sh"
  return $(result)
}
test.case - "T40: boot parses under POSIX sh and ash (env -i sh bootable)" \
  test.config.fallbackPrecedesSourceLines
expect 0 "boot is POSIX sh" "boot has no bashisms; env -i sh can source it"

# ============================================================================
# T41: config.validate rejects logic lines (the "NEVER logic in ENV FILES" guard)
# ============================================================================
# config.validate is the enforcement that keeps the pure-data invariant from
# silently regressing. It must ACCEPT export/comment/blank lines and REJECT any
# logic (self-anchor `: ${…}`, `source …`, `if …`).
test.config.fallbackRedirectsMisderivedPath() {
  local fixture="/tmp/test.config.val.$(id -u).$$"; mkdir -p "$fixture"
  local fail=0
  # pure file → accept (rc 0)
  printf '%s\n' '# comment' '' 'export FOO="bar"' 'export BAZ=1' > "$fixture/user.env"
  CONFIG_PATH="$fixture" config.validate user >/dev/null 2>&1 || { fail=1; important.log "validate rejected a pure file"; }
  # planted logic → reject (rc 1)
  printf '%s\n' 'export FOO="bar"' ': ${OOSH_DIR:=$HOME/oosh}' 'source $CONFIG_PATH/oosh.env' > "$fixture/oosh.env"
  if CONFIG_PATH="$fixture" config.validate oosh >/dev/null 2>&1; then
    fail=1; important.log "validate accepted a file containing logic"
  fi
  # D5: an INDENTED self-anchor with a trailing comment must NOT pass as a comment
  printf '%s\n' '  : ${OOSH_DIR:=/x} # guarded' > "$fixture/ind.env"
  if CONFIG_PATH="$fixture" config.validate ind >/dev/null 2>&1; then
    fail=1; important.log "validate accepted an indented self-anchor (comment bypass)"
  fi
  # D5: command substitution in a value EXECUTES on source — must be rejected
  printf '%s\n' 'export FOO="$(echo hi)"' > "$fixture/cmdsub.env"
  if CONFIG_PATH="$fixture" config.validate cmdsub >/dev/null 2>&1; then
    fail=1; important.log "validate accepted command substitution in a value"
  fi
  # and backtick form
  printf '%s\n' 'export BAR=`id`' > "$fixture/bt.env"
  if CONFIG_PATH="$fixture" config.validate bt >/dev/null 2>&1; then
    fail=1; important.log "validate accepted backtick substitution in a value"
  fi
  rm -rf "$fixture" 2>/dev/null
  if [ "$fail" = "0" ]; then
    create.result 0 "validate accepts pure, rejects logic"
  else
    create.result 1 "config.validate misbehaved"
  fi
}
test.case - "T41: config.validate accepts pure data, rejects logic lines" \
  test.config.fallbackRedirectsMisderivedPath
expect 0 "validate accepts pure, rejects logic" \
  "config.validate enforces the NEVER-logic-in-env-files invariant"

# ============================================================================
# T42: config.list reads the per-user tier (~/.config/oosh) by name
# ============================================================================
# `config list log` reads the SHARED ~/config/log.env; `config list log.session`
# must read the PER-USER ~/.config/oosh/log.session.env. Read-only fallback:
# a name present only in the per-user tier resolves there; delete/edit/save
# semantics (which operate on $CONFIG_PATH) are unaffected.
test.config.listReadsPerUserTier() {
  local pu="$HOME/.config/oosh"; mkdir -p "$pu"
  local sess="$pu/log.session.env"
  local backup=""
  [ -f "$sess" ] && backup="$(cat "$sess")"
  printf '%s\n' 'export LOG_NAME="t42@host"' 'export LOG_DEVICE="/dev/pts/9"' > "$sess"
  local out; out="$(config.list log.session 2>/dev/null)"
  # restore original
  if [ -n "$backup" ]; then printf '%s\n' "$backup" > "$sess"; else rm -f "$sess"; fi
  if printf '%s' "$out" | grep -q 'LOG_NAME="t42@host"'; then
    create.result 0 "config list log.session reads per-user tier"
  else
    create.result 1 "config list log.session returned: $out"
  fi
}
test.case - "T42: config.list reads per-user ~/.config/oosh by name" \
  test.config.listReadsPerUserTier
expect 0 "config list log.session reads per-user tier" \
  "config list <name> falls back to the per-user ~/.config/oosh tier"

# ============================================================================
# T43: config.list.completion.name offers names from BOTH tiers
# ============================================================================
test.config.completionOffersPerUser() {
  local pu="$HOME/.config/oosh"; mkdir -p "$pu"
  local sess="$pu/log.session.env"
  local existed=1; [ -f "$sess" ] || { existed=0; : > "$sess"; }
  local out; out="$(config.list.completion.name 2>/dev/null)"
  [ "$existed" = "0" ] && rm -f "$sess"
  if printf '%s\n' "$out" | grep -qx "log.session"; then
    create.result 0 "completion offers log.session"
  else
    create.result 1 "completion names: $(printf '%s' "$out" | tr '\n' ' ')"
  fi
}
test.case - "T43: config list completion offers per-user names" \
  test.config.completionOffersPerUser
expect 0 "completion offers log.session" \
  "config.list.completion.name enumerates the per-user ~/.config/oosh tier"

# ============================================================================
# T44: the bootstrap exports OOSH_USER_CONFIG_PATH (single source of truth)
# ============================================================================
# The per-user (non-shared) oosh config dir is anchored ONCE by the bootstrap
# (this.init and boot) as $OOSH_USER_CONFIG_PATH, so log/config/oo reference the
# variable instead of re-spelling ~/.config/oosh. Both bootstrap paths must set
# it, and it must resolve to the live runtime value.
test.config.userConfigPathAnchored() {
  local ok=1
  # this.init sets the default
  grep -Eq 'OOSH_USER_CONFIG_PATH:=\$HOME/\.config/oosh' "$OOSH_DIR/this" || ok=0
  # boot sets it too (the minimal POSIX entry point)
  grep -Eq 'export OOSH_USER_CONFIG_PATH="\$HOME/\.config/oosh"' "$OOSH_DIR/boot" || ok=0
  # and it is live in this shell, pointing into the user's HOME
  case "$OOSH_USER_CONFIG_PATH" in "$HOME"/*) ;; *) ok=0 ;; esac
  if [ "$ok" = "1" ]; then
    create.result 0 "OOSH_USER_CONFIG_PATH anchored ($OOSH_USER_CONFIG_PATH)"
  else
    create.result 1 "OOSH_USER_CONFIG_PATH not anchored correctly (live='$OOSH_USER_CONFIG_PATH')"
  fi
}
test.case - "T44: bootstrap exports OOSH_USER_CONFIG_PATH" \
  test.config.userConfigPathAnchored
expect 0 "OOSH_USER_CONFIG_PATH anchored ($OOSH_USER_CONFIG_PATH)" \
  "this.init and boot anchor the per-user config dir as a single source of truth"

# ============================================================================
# T45: boot ensures log.session.env exists before sourcing the config chain
# ============================================================================
# log.env chains `source $OOSH_USER_CONFIG_PATH/log.session.env`; that file is
# written by log.session.save LATER in boot, so boot must touch it first or the
# first-ever shell errors with "No such file". Assert boot has the touch-guard
# ahead of the `. user.env` chain source.
test.config.bootTouchGuardsSession() {
  local ok=1
  # the guard line exists
  grep -Eq '\[ -f "\$OOSH_USER_CONFIG_PATH/log\.session\.env" \] \|\| : >' "$OOSH_DIR/boot" || ok=0
  # and it comes BEFORE the user.env chain source (so the chain finds the file)
  local guardLn chainLn
  guardLn=$(grep -nF 'log.session.env" ] || : >' "$OOSH_DIR/boot" | head -1 | cut -d: -f1)
  chainLn=$(grep -nF '. "$CONFIG_PATH/user.env"' "$OOSH_DIR/boot" | head -1 | cut -d: -f1)
  [ -n "$guardLn" ] && [ -n "$chainLn" ] && [ "$guardLn" -lt "$chainLn" ] || ok=0
  if [ "$ok" = "1" ]; then
    create.result 0 "boot touch-guards log.session.env before the chain"
  else
    create.result 1 "guard=$guardLn chain=$chainLn (guard must precede chain)"
  fi
}
test.case - "T45: boot touch-guards log.session.env before the config chain" \
  test.config.bootTouchGuardsSession
expect 0 "boot touch-guards log.session.env before the chain" \
  "boot ensures the per-user session file exists before log.env sources it"

# ============================================================================
# T46: sourcing a generated log.env LOADS the per-user session values
# ============================================================================
# End-to-end: generate config into a fixture, write a per-user session file with
# a custom LOG_NAME, then source the generated log.env with OOSH_USER_CONFIG_PATH
# pointed at the fixture — the custom LOG_NAME must come through the chain.
test.config.logEnvLoadsSession() {
  local fx="/tmp/test.config.chain.$(id -u).$$"; mkdir -p "$fx/pu"
  # generate a shared config (incl. log.env with the session chain line) into $fx
  bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export CONFIG_PATH="'"$fx"'" CONFIG_FILE=user.env CONFIG="'"$fx"'/user.env"
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
  ' >/dev/null 2>&1
  # a per-user session file with a distinctive LOG_NAME
  printf '%s\n' 'export LOG_NAME="chained@fixturehost"' > "$fx/pu/log.session.env"
  # source the generated log.env with the chain resolving into $fx/pu
  local got
  got=$(bash -c '
    export OOSH_USER_CONFIG_PATH="'"$fx"'/pu"
    . "'"$fx"'/log.env" 2>/dev/null
    echo "$LOG_NAME"
  ' 2>/dev/null)
  rm -rf "$fx"
  if [ "$got" = "chained@fixturehost" ]; then
    create.result 0 "log.env chain loaded LOG_NAME"
  else
    create.result 1 "LOG_NAME after sourcing log.env: '$got'"
  fi
}
test.case - "T46: sourcing generated log.env loads per-user session values" \
  test.config.logEnvLoadsSession
expect 0 "log.env chain loaded LOG_NAME" \
  "the log.env session chain actually loads the per-user LOG_NAME at shell init"

# ============================================================================
# T47: a GENERATED user.env sources cleanly under dash (POSIX `.`, no `source`)
# ============================================================================
# $OOSH_DIR/boot must parse under dash/ash (/bin/sh login shells, `ossh exec` on
# Debian). The env files it sources therefore must use POSIX `.`, not the bash
# `source` builtin. Generate a full config and source the resulting user.env
# (which chains oosh.env/log.env, and log.env chains log.session.env) under dash.
test.config.dashSourcesGeneratedUserEnv() {
  local fx="/tmp/test.config.dash.$(id -u).$$"; mkdir -p "$fx/pu"
  bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
    export CONFIG_PATH="'"$fx"'" CONFIG_FILE=user.env CONFIG="'"$fx"'/user.env"
    export OOSH_MODE=dev
    : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
  ' >/dev/null 2>&1
  : > "$fx/pu/log.session.env"
  local out
  out=$(dash -c '
    export CONFIG_PATH="'"$fx"'" OOSH_USER_CONFIG_PATH="'"$fx"'/pu"
    . "'"$fx"'/user.env"
    echo "MODE=[$OOSH_MODE]"
  ' 2>&1)
  rm -rf "$fx"
  if echo "$out" | grep -q "not found"; then
    create.result 1 "dash choked on generated env files (bashism?): $out"
  elif echo "$out" | grep -q 'MODE=\[dev\]'; then
    create.result 0 "dash sourced the generated chain cleanly"
  else
    create.result 1 "unexpected dash output: $out"
  fi
}
# Skip-guard (docs/python.md § Tests that exercise the Python paths): a host
# without dash cannot assert this, and "skipped" is not the expected literal —
# so the guard sits OUTSIDE the case, or the skip is scored as a FAIL (seen on
# alpine and almalinux platform runs, 2026-09-15).
if command -v dash >/dev/null 2>&1; then
test.case - "T47: generated user.env sources cleanly under dash" \
  test.config.dashSourcesGeneratedUserEnv
expect 0 "dash sourced the generated chain cleanly" \
  "generated env files use POSIX . so boot parses under dash/ash"
else
  expect.pass "T47 skipped: dash not installed on this host (T52 covers busybox ash)"
fi

# ============================================================================
# T48: config.list (per-user tier) does NOT mutate the global $CONFIG
# ============================================================================
# The per-user fallback must resolve read-only via private.config.file.resolve;
# it must never leave $CONFIG repointed at the per-user file for the rest of the
# shell (which would make a later config.add/clean append to / rm the wrong file).
test.config.listNoGlobalMutation() {
  local pu="$HOME/.config/oosh"; mkdir -p "$pu"
  local sess="$pu/log.session.env"
  local existed=1; [ -f "$sess" ] || { existed=0; printf 'export LOG_NAME="t48@h"\n' > "$sess"; }
  local before="$CONFIG"
  config.list log.session >/dev/null 2>&1
  local after="$CONFIG"
  [ "$existed" = "0" ] && rm -f "$sess"
  if [ "$before" = "$after" ]; then
    create.result 0 "\$CONFIG unchanged after config.list log.session"
  else
    create.result 1 "\$CONFIG mutated: before=$before after=$after"
  fi
}
test.case - "T48: config.list per-user view does not mutate \$CONFIG" \
  test.config.listNoGlobalMutation
expect 0 "\$CONFIG unchanged after config.list log.session" \
  "config.list resolves the per-user tier read-only (no global side effect)"

# ============================================================================
# T49: boot-repointed callers degrade gracefully when boot is absent (D3)
# ============================================================================
# boot lives only on dev; testing/prod/main have no boot. Callers that source it
# must still work there: ossh.exec/exec.tty and the user rootkey pushes carry a
# `|| export PATH=~/oosh...` fallback, and bashrcTemplate has an `elif` that puts
# ~/oosh on PATH. Structural check (same style as T31/T44).
test.config.bootAbsentFallbacks() {
  local ok=1 miss=""
  grep -Eq '\|\| export PATH=~/oosh' "$OOSH_DIR/ossh" || { ok=0; miss="$miss ossh"; }
  grep -Eq '\|\| export PATH=~/oosh' "$OOSH_DIR/user" || { ok=0; miss="$miss user"; }
  grep -Eq 'elif \[ -d "\$HOME/oosh" \]' "$OOSH_DIR/templates/user/bashrcTemplate" || { ok=0; miss="$miss bashrcTemplate"; }
  # no ACTIVE (non-comment) rootkey ssh call may still be the old unguarded
  # `. /root/oosh/boot; ...` (the `^[^#]*` anchor skips the commented-out variant)
  if grep -Eq '^[^#]*ssh .*"\. /root/oosh/boot; ' "$OOSH_DIR/user"; then ok=0; miss="$miss unguarded-rootkey"; fi
  if [ "$ok" = "1" ]; then
    create.result 0 "boot-absent fallbacks present"
  else
    create.result 1 "missing boot-absent fallback in:$miss"
  fi
}
test.case - "T49: boot-repointed callers have a boot-absent fallback" \
  test.config.bootAbsentFallbacks
expect 0 "boot-absent fallbacks present" \
  "ossh.exec*/rootkey/bashrcTemplate still work when boot is absent (non-dev branches)"

# ============================================================================
# T50: boot EXITS 0 on a successful boot — in every shell (T3)
# ============================================================================
# boot's status is a contract: ossh.exec / ossh.exec.tty and the three `user`
# rootkey pushes all do `[ -f ~/oosh/boot ] && . ~/oosh/boot || <degrade>`
# (see T49, which asserts those fallbacks exist). So the LAST statement in boot
# must never be a conditional list. It used to be
#   [ -n "$BASH_VERSION" ] && type log.session.save … && log.session.save …
# and under sh/dash/ash $BASH_VERSION is always empty, so a perfectly good boot
# returned 1 and every one of those callers took its degrade branch ON SUCCESS.
test.config.bootExitsZeroOnSuccess() {
  local failed="" shell rc
  for shell in sh dash bash; do
    command -v "$shell" >/dev/null 2>&1 || continue
    env -i HOME="$HOME" "$shell" -c ". \"$OOSH_DIR/boot\"" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || failed="$failed $shell(rc=$rc)"
  done
  if command -v busybox >/dev/null 2>&1; then
    env -i HOME="$HOME" busybox ash -c ". \"$OOSH_DIR/boot\"" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || failed="$failed busybox-ash(rc=$rc)"
  fi
  if [ -z "$failed" ]; then
    create.result 0 "boot exits 0 in every shell"
  else
    create.result 1 "boot returned non-zero in:$failed — a conditional list is the last statement again; ossh.exec and the user rootkey pushes now degrade on success"
  fi
}
test.case - "T50: boot exits 0 on success (sh/dash/ash/bash)" \
  test.config.bootExitsZeroOnSuccess
expect 0 "boot exits 0 in every shell" \
  "boot's exit status is a contract — callers branch on it"

# ============================================================================
# T51: boot refuses when no home can be derived AT ALL
# ============================================================================
# The companion to T65. T65 proves boot RECOVERS $HOME (getent -> dscl ->
# /etc/passwd). This proves the last resort still works: when all three come up
# empty there is nothing safe to anchor to, so boot must refuse rather than
# invent a path — and refuse by `return`, because it is SOURCED and `exit`
# would close the user's shell.
#
# All three lookups are defeated by putting `id` out of reach: without a
# username there is nothing to look up. An absolute path to sh is required
# precisely because PATH is emptied.
test.config.bootRefusesWhenHomeUndiscoverable() {
  local shPath out
  shPath=$(command -v sh 2>/dev/null)
  if [ ! -x "$shPath" ]; then
    create.result 0 "skipped: no sh on PATH"
    return $(result)
  fi
  out=$(cd /tmp && env -i PATH=/nonexistent "$shPath" -c ". \"$OOSH_DIR/boot\" && echo BOOTED; echo SHELL-ALIVE" 2>&1)
  if echo "$out" | grep -q BOOTED; then
    create.result 1 "boot continued with no derivable home: $out"
  elif ! echo "$out" | grep -q 'HOME'; then
    create.result 1 "boot stopped but gave no HOME diagnostic: $out"
  elif ! echo "$out" | grep -q 'SHELL-ALIVE'; then
    create.result 1 "boot used exit, not return — it killed the sourcing shell: $out"
  else
    create.result 0 "boot refused undiscoverable home"
  fi
  # A literal expectation below, so refused and skipped are not the same answer.
  return $(result)
}
test.case - "T51: boot refuses when \$HOME cannot be derived at all" \
  test.config.bootRefusesWhenHomeUndiscoverable
if [ "$RESULT" = "skipped: no sh on PATH" ]; then
  expect.pass "T51 skipped — no sh on PATH"
else
  expect 0 "boot refused undiscoverable home" \
    "no getent/dscl//etc/passwd answer — refuse rather than anchor on /oosh"
fi

# ============================================================================
# T52: busybox ash boots correctly (companion to T47's dash)
# ============================================================================
# Alpine/busybox is a supported shell for `ossh exec`. T40 lints boot under sh
# and ash; this proves ash actually RUNS it and comes out with both anchors and
# ~/oosh on PATH.
test.config.ashBootsCorrectly() {
  if ! command -v busybox >/dev/null 2>&1; then
    create.result 0 "skipped: busybox absent"; return $(result)
  fi
  local out
  out=$(env -i HOME="$HOME" busybox ash -c "
    . \"$OOSH_DIR/boot\"
    echo \"D=[\$OOSH_DIR] C=[\$CONFIG_PATH]\"
    case \":\$PATH:\" in *\":\$HOME/oosh:\"*) echo PATHOK ;; *) echo PATHBAD ;; esac
  " 2>&1)
  if ! echo "$out" | grep -Fq "D=[$HOME/oosh]"; then
    create.result 1 "ash: wrong OOSH_DIR: $out"
  elif ! echo "$out" | grep -Fq "C=[$HOME/config]"; then
    create.result 1 "ash: wrong CONFIG_PATH: $out"
  elif ! echo "$out" | grep -q PATHOK; then
    create.result 1 "ash: ~/oosh not on PATH: $out"
  else
    create.result 0 "ash boots correctly"
  fi
}
test.case - "T52: busybox ash sources boot and gets both anchors + PATH" \
  test.config.ashBootsCorrectly
if [ "$RESULT" = "skipped: busybox absent" ]; then
  expect.pass "T52 skipped — busybox not installed on this host"
else
  expect 0 "ash boots correctly" \
    "boot runs under ash (Alpine/busybox), not just dash and bash"
fi

# ============================================================================
# T65: boot RECOVERS $HOME rather than demanding it
# ============================================================================
# `env -i` drops HOME, and every anchor hangs off it. boot used to refuse.
# The card (T3) is "env -i sh … shall boot correctly", so it must recover:
# getent -> dscl -> /etc/passwd, mirroring private.get.home.darwin in `user`.
test.config.bootRecoversHome() {
  local bad="" out home
  home=$(test.suite.home.passwd)
  # every shell, from nothing — the shared harness (test.suite)
  bad=$(test.suite.boot.anchors.check ". \"$OOSH_DIR/boot\"")
  # a STALE HOME (set, but not a directory) is the same broken input
  out=$(cd /tmp && env -i HOME=/nonexistent/removed-user sh -c ". \"$OOSH_DIR/boot\"; echo \"[\$HOME]\"" 2>&1 | tail -1)
  [ "$out" = "[$home]" ] || bad="$bad stale-HOME=>$out"
  # an explicitly GOOD HOME must never be overridden
  out=$(cd /tmp && env -i HOME=/tmp sh -c ". \"$OOSH_DIR/boot\"; echo \"[\$HOME]\"" 2>&1 | tail -1)
  [ "$out" = "[/tmp]" ] || bad="$bad good-HOME-overridden=>$out"
  if [ -z "$bad" ]; then
    create.result 0 "HOME recovered in every shell"
  else
    create.result 1 "expected [$home|$home/oosh|$home/config] —$bad"
  fi
}
test.case - "T65: boot recovers \$HOME under env -i (every shell)" \
  test.config.bootRecoversHome
expect 0 "HOME recovered in every shell" \
  "the T3 card: env -i sh must boot correctly, not refuse"

# ============================================================================
# T66: the DOCUMENTED recovery command works — not just an absolute path
# ============================================================================
# T65 sources boot via "$OOSH_DIR/boot", a path the test builds itself. That
# can stay green forever while the command a human is told to type is broken,
# and it was: docs/boot.md gives `. ~/oosh/boot`, and with HOME unset dash and
# ash leave `~` LITERAL (POSIX leaves it undefined), so the documented form
# fails in exactly the empty-environment case boot exists to survive. bash
# falls back to the password database and expands it anyway, which is why this
# went unnoticed — everyone tests in bash.
#
# boot cannot fix this from inside: the shell resolves the path before boot
# runs. So docs/boot.md documents a getent one-liner for the no-HOME case, and
# THAT is what this test runs, verbatim. Both halves are asserted:
#   1. the documented one-liner really works, in every shell;
#   2. the bare `~` form really does NOT work under sh — pinned deliberately,
#      so that if shell behaviour ever changes, docs/boot.md's tilde caveat
#      gets revisited on purpose rather than drifting back into overclaiming.
#
# The fixed absolute path this used to be waiting for HAS landed: T9 gives
# every host `. /etc/oosh/boot`, and T67 below covers it. That does not retire
# this test. The caveat is still true — `~` is still unusable under sh with
# HOME unset, which is the whole reason the fixed path had to exist — and the
# getent form is still the portable fallback docs/boot.md keeps for hosts that
# have no /etc/oosh/boot: a user-rights-only (20-lane) install never reaches
# state 34, and a host installed before T9 has not run `oo boot.fix` yet.
test.config.bootDocumentedRecovery() {
  local bad="" out home oneliner
  home=$(test.suite.home.passwd)
  # verbatim from docs/boot.md's portable-fallback line — if you change it
  # there, change it here. Same getent | head -1 | cut lookup boot itself does,
  # which is why it works in every shell.
  oneliner='. "$(getent passwd "$(id -un)" | head -1 | cut -d: -f6)/oosh/boot"'
  if command -v getent >/dev/null 2>&1; then
    bad=$(test.suite.boot.anchors.check "$oneliner")
  fi
  # The caveat itself: `~` must still be unusable under sh with HOME unset.
  # This is the defect `. /etc/oosh/boot` (T9/T67) exists to route around, not
  # one that got fixed. If it ever starts working, docs/boot.md's tilde caveat
  # is stale. Only where `sh` is NOT bash: bash expands `~` from the password
  # database even with HOME unset, and on macOS and the RHEL family /bin/sh IS
  # bash — there the caveat is moot and this half is skipped, not failed.
  if [ -z "$(env -i sh -c 'echo ${BASH_VERSION:+bash}' 2>/dev/null)" ]; then
    out=$(cd /tmp && env -i sh -c '. ~/oosh/boot' 2>&1 | tail -1)
    case "$out" in
      *"$home/oosh"*|"") bad="$bad tilde-now-works:$out" ;;
    esac
  fi
  if [ -z "$bad" ]; then
    create.result 0 "documented recovery works, tilde caveat still true"
  else
    create.result 1 "documented recovery broken —$bad"
  fi
  return $(result)
}
test.case - "T66: the recovery command docs/boot.md gives actually works" \
  test.config.bootDocumentedRecovery
expect 0 "documented recovery works, tilde caveat still true" \
  "a test that builds its own path cannot catch a broken instruction"

# ============================================================================
# T67: the FIXED system path — one command, any user, any shell, no environment
# ============================================================================
# T9 (docs/plans/2026-09-14-fixed-system-boot-path.md). T66 pins the defect:
# with HOME unset, `~` is literal under dash/ash, so `. ~/oosh/boot` cannot be
# REACHED in exactly the empty-environment case boot exists to survive. The fix
# is a host-wide symlink /etc/oosh/boot into the shared tree, created by install
# state 34 (root.boot.path.installed) and healed by `oo boot.fix`.
#
# Proves the MECHANISM only: sourcing a symlink-to-boot under `env -i` in EVERY
# shell yields THIS caller's anchors. Whether the real /etc/oosh/boot exists, is
# a symlink, does not dangle and is readable by this user is a POST-INSTALL
# invariant checked against the real path in test.platform.boot.system.path.invariant
# — a fixture this test built one line earlier cannot fail those, so they are
# not asserted here.
#
# Deliberately failable: it ends with `return $(result)` (without it
# create.result only sets $RETURN_VALUE and the function returns 0 whatever
# happened — the defect annotated at T51 above) and the assertion matches a
# LITERAL success string, not `expect 0 "*"`, which would make the comparison
# tautological. So every failure path — and the pre-state-34 skip path — fails
# the comparison and surfaces its own recovery command.
test.config.bootFixedSystemPath() { # <?systemPath:/etc/oosh>
  local systemPath="${1:-/etc/oosh}"
  local link="$systemPath/boot"

  if [ ! -L "$link" ] && [ ! -e "$link" ]; then
    create.result 0 "skipped: $link absent — host installed before state 34; run \`oo boot.fix\`"
    return $(result)
  fi
  # The promise: one command, every shell, no environment at all.
  local bad="" home
  home=$(test.suite.home.passwd)
  bad=$(test.suite.boot.anchors.check ". $link")

  if [ -z "$bad" ]; then
    create.result 0 "fixed system path boots every shell"
  else
    create.result 1 "expected [$home|$home/oosh|$home/config] —$bad"
  fi
  return $(result)
}
# Driven against a FIXTURE, not against the host's real /etc/oosh.
#
# The real path is a POST-INSTALL invariant, and this repo puts those in
# TEST_CATEGORY=platform (test.platform.boot.system.path.invariant), not in
# core. Pointing a core test at /etc/oosh/boot would make `test.suite core 1`
# permanently red on every dev box until someone runs `oo boot.fix` with sudo
# — and a suite that is always red is a suite people stop reading. Worse, the
# skip branch returns rc 0 with a DIFFERENT string, so `expect 0 "<literal>"`
# fails on it anyway: the absent case could not be expressed as a pass.
#
# So core proves the MECHANISM (a symlink to boot really does boot every
# shell from an empty environment) and the platform suite proves the
# DEPLOYMENT (the link exists, points into the shared tree, and is readable
# through by non-root users on a real installed machine).
test.config.bootFixedSystemPathFixture() {
  local fixture rc
  fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t67.XXXXXX") || {
    create.result 1 "could not create fixture dir"; return $(result); }
  ln -sfn "$OOSH_DIR/boot" "$fixture/boot"
  test.config.bootFixedSystemPath "$fixture"
  rc=$?
  rm -rf "$fixture"
  return $rc
}
test.case - "T67: a fixed-path symlink boots any shell under env -i" \
  test.config.bootFixedSystemPathFixture
expect 0 "fixed system path boots every shell" \
  "the one command that needs no HOME, no PATH and no branch knowledge"

# ============================================================================
# T68: the $ENV route — automatic recovery for a shell that HAS an rc hook
# ============================================================================
# T67 proves `. /etc/oosh/boot` works. This is about not having to TYPE it.
# Measured, and this is the whole table:
#
#   env -i sh                      -> NO.  $ENV is a non-login POSIX sh's ONLY
#                                          rc hook and `env -i` is precisely
#                                          what erased it. Nothing can recover
#                                          this — say so, never imply otherwise.
#   env -i ENV=/etc/oosh/boot sh   -> YES. The hook, handed back.
#   env -i sh -l                   -> the /etc/profile.d/oosh.sh drop-in (T9B
#                                          in test.oo; deployment proved by
#                                          test.platform.boot.system.path.invariant).
#
# Two things this pins that are easy to get wrong in the docs:
#
#   * $ENV is honoured by INTERACTIVE shells only. `env -i ENV=… sh -c '…'`
#     does NOT source it — so the documented command must not grow a `-c`.
#   * bash under its OWN name ignores $ENV entirely (it is a POSIX-mode-only
#     feature there). Invoked as `sh` it DOES read $ENV — and, crucially, it
#     enters POSIX mode only AFTER the startup file is read, so boot's dotted
#     function names still parse. That is the RHEL/Alma case, where /bin/sh IS
#     bash, so it is asserted here with a `sh -> bash` symlink.
#     `bash --posix` reads $ENV with posix mode ALREADY active, so it recovers
#     the anchors but gets no log functions — boot skips `log` there on purpose.
#     It used to be worse: boot sourced `log` anyway, bash rejected every dotted
#     function name, and the shell DIED. That is T70 below, and it is what macOS
#     /bin/sh (bash 3.2 in posix mode) hit for real.
#
# Driven against a FIXTURE symlink, never the host's real /etc/oosh — same
# split as T67: core proves the mechanism, platform proves the deployment.
test.config.bootEnvHookRecovery() {
  local fixture bad="" expected out shell
  fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t68.XXXXXX") || {
    create.result 1 "could not create fixture dir"; return $(result); }
  ln -sfn "$OOSH_DIR/boot" "$fixture/boot"
  expected="<[$HOME|$HOME/oosh|$HOME/config]>"
  local probe='echo "<[$HOME|$OOSH_DIR|$CONFIG_PATH]>"'
  # An interactive shell reading from a pipe still runs $ENV; the prompt it
  # writes is why the marker is fished out with grep rather than compared whole.

  # --- the POSITIVE claim: every shell that HAS the $ENV hook recovers ------
  for shell in sh dash; do
    command -v "$shell" >/dev/null 2>&1 || continue
    out=$(cd /tmp && printf '%s\n' "$probe" | env -i ENV="$fixture/boot" "$shell" -i 2>/dev/null | grep -o '<\[[^]]*\]>' | tail -1)
    [ "$out" = "$expected" ] || bad="$bad ENV:$shell=>${out:-<none>}"
  done
  if command -v busybox >/dev/null 2>&1; then
    out=$(cd /tmp && printf '%s\n' "$probe" | env -i ENV="$fixture/boot" busybox ash -i 2>/dev/null | grep -o '<\[[^]]*\]>' | tail -1)
    [ "$out" = "$expected" ] || bad="$bad ENV:busybox-ash=>${out:-<none>}"
  fi
  # bash INVOKED AS sh — the RHEL/Alma /bin/sh. Verified, not assumed.
  if command -v bash >/dev/null 2>&1; then
    mkdir -p "$fixture/bin"
    ln -sf "$(command -v bash)" "$fixture/bin/sh"
    out=$(cd /tmp && printf '%s\n' "$probe" | env -i ENV="$fixture/boot" "$fixture/bin/sh" -i 2>/dev/null | grep -o '<\[[^]]*\]>' | tail -1)
    [ "$out" = "$expected" ] || bad="$bad ENV:bash-as-sh=>${out:-<none>}"
  fi

  # --- the NEGATIVE claims, so the docs cannot quietly overclaim ------------
  # (a) bare `env -i sh` cannot self-recover. There is no hook left.
  out=$(cd /tmp && printf '%s\n' "$probe" | env -i sh -i 2>/dev/null | grep -o '<\[[^]]*\]>' | tail -1)
  case "$out" in
    *"$HOME/oosh"*) bad="$bad bare-env-i-sh-now-recovers:$out" ;;
  esac
  # (b) $ENV is interactive-only: with -c it is ignored, so the documented
  #     command must never grow a `-c`.
  out=$(cd /tmp && env -i ENV="$fixture/boot" sh -c "$probe" 2>/dev/null | tail -1)
  case "$out" in
    *"$HOME/oosh"*) bad="$bad ENV-with--c-now-works:$out" ;;
  esac

  rm -rf "$fixture" 2>/dev/null
  if [ -z "$bad" ]; then
    create.result 0 "ENV hook recovers every shell that has one"
  else
    create.result 1 "expected $expected —$bad"
  fi
  return $(result)
}
test.case - "T68: \`env -i ENV=<path>/boot sh\` comes up recovered" \
  test.config.bootEnvHookRecovery
expect 0 "ENV hook recovers every shell that has one" \
  "the fixed path is only automatic if a shell has an rc hook to point at it"

# ============================================================================
# T69: test.tilde runs from a CLEAN ENVIRONMENT
# ============================================================================
# 815d14d gave test/test.tilde `#!/usr/bin/env -iS HOME=${HOME} bash` — the
# sibling commit to 8c277f4, which did the same for init/oosh. 075b4a3 removed
# that shebang from BOTH (BusyBox `env` has no -S) and nothing replaced the
# guarantee. init/oosh got it back as an in-file re-exec (the OOSH_CLEAN_ENV block);
# test.tilde did not, and has since inherited whatever the caller happened to
# have.
#
# It passes either way — which is exactly the problem. A test whose entire
# subject is `~` versus $HOME, run with an arbitrary inherited environment, is
# green for a reason unrelated to what it asserts. Same shape as a mode check
# that never looked at the mode.
#
# Pinned here, all observable from OUTSIDE the file:
#   1. a variable planted by the caller does NOT survive into it;
#   2. the re-exec really happened;
#   3. the sentinel is HONOURED — preset, the file must NOT re-exec. That is
#      what makes an exec loop impossible, and it is asserted rather than
#      assumed. Every invocation is wrapped in `timeout` where available, so a
#      regression that DOES loop fails this test instead of hanging the suite.
#   4. it still does its actual job, and still exits 0.
test.config.tildeRunsInCleanEnvironment() {
  local tilde="$OOSH_DIR/test/test.tilde" out cleanOut rc bad="" to="" tmp
  # The child now sources this + test.suite and saves ITS results to
  # $CONFIG_PATH/testresult.env — give it a throwaway one, never the parent's.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t69.XXXXXX") || { create.result 1 "mktemp failed"; return $(result); }
  command -v timeout >/dev/null 2>&1 && to="timeout 20"
  if [ ! -x "$tilde" ]; then
    rm -rf "$tmp"
    create.result 1 "$tilde is not executable — test.suite runs it as a bare \$file (kernel exec)"
    return $(result)
  fi
  bash -n "$tilde" 2>/dev/null || bad="$bad lint:$(bash -n "$tilde" 2>&1 | head -1)"

  # 1 + 2 — plant a canary; it must not survive, and the sentinel must be set.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CANARY=leaked OOSH_TILDE_CLEAN_ENV= $to "$tilde" 1 2>&1); rc=$?
  cleanOut="$out"
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc"
  case "$out" in
    *"Environment                                : clean, canary absent"*) : ;;
    *INHERITED*) bad="$bad canary-survived (test.tilde did not re-exec with env -i — the 075b4a3 regression)" ;;
    *) bad="$bad no-environment-line:$(echo "$out" | head -1)" ;;
  esac

  # 3 — sentinel honoured: preset, it must NOT re-exec (so the canary DOES
  #     survive) and must still terminate.
  out=$(cd /tmp && CONFIG_PATH="$tmp" OOSH_TILDE_CLEAN_ENV=1 OOSH_TILDE_CANARY=leaked $to "$tilde" 1 2>&1); rc=$?
  if [ "$rc" -eq 124 ]; then
    bad="$bad sentinel-LOOPED (timed out — the re-exec guard does not stop)"
  else
    [ "$rc" -eq 0 ] || bad="$bad sentinel-rc=$rc"
    case "$out" in
      *INHERITED*) : ;;
      *"clean, canary absent"*) bad="$bad sentinel-ignored (it re-execs even when already clean; nothing but luck prevents a loop)" ;;
      *) bad="$bad sentinel-check-inconclusive (no Environment line at all)" ;;
    esac
  fi

  # 4 — it must still be the test it was: on the CLEAN run, its own assertions
  #     ran through the framework and none failed.
  case "$cleanOut" in
    *"T-TILDE-HOME"*"T-TILDE-FILE-TEST"*) : ;;
    *) bad="$bad tilde-assertions-missing:$(echo "$cleanOut" | tr '\n' ' ' | cut -c1-120)" ;;
  esac
  case "$cleanOut" in
    *"✗ FAIL"*) bad="$bad tilde-assertion-failed:$(echo "$cleanOut" | grep -F "✗ FAIL" | head -1 | cut -c1-100)" ;;
  esac
  rm -rf "$tmp"

  if [ -z "$bad" ]; then
    create.result 0 "test.tilde runs clean and cannot loop"
  else
    create.result 1 "test.tilde clean-environment guarantee broken —$bad"
  fi
  return $(result)
}
test.case - "T69: test/test.tilde runs from a clean environment and cannot loop" \
  test.config.tildeRunsInCleanEnvironment
expect 0 "test.tilde runs clean and cannot loop" \
  "a tilde test that inherits the caller's environment is green for the wrong reason"

# ============================================================================
# T70: POSIX-MODE bash must survive sourcing boot (the macOS /bin/sh case)
# ============================================================================
# boot's section-4 guard used to ask only "is this bash?" ([ -n "$BASH_VERSION" ])
# before sourcing $OOSH_DIR/log. That question is not the one that matters.
#
# On macOS /bin/sh IS bash 3.2 — $BASH_VERSION is SET — but it runs in POSIX
# mode, where a dotted function name is not a valid identifier. `log` is built
# from dotted names (log.device, log.level, …), so the old guard let boot source
# a file that cannot parse, and a PARSE ERROR IN A SOURCED FILE UNDER POSIX MODE
# KILLS THE SHELL. Measured on a macOS 15.7.3 arm64 VM:
#
#   env -i /bin/sh   -c '. /etc/oosh/boot; echo REACHED'
#     -> /Users/admin/oosh/log: line 73: `log.device': not a valid identifier
#     -> rc 2, REACHED never printed — the shell was dead.
#   env -i /bin/bash -c '. /etc/oosh/boot; …'   -> rc 0, all anchors set.
#
# Same binary, same file; only POSIX mode differs. It is the same failure class
# T3 fixed (a sourced boot killing its caller) reached by another route, and it
# is also the `bash --posix` breakage T68's comment used to record as unclaimed.
#
# `bash --posix` REPRODUCES IT ON LINUX, which is what this test uses — no Mac
# needed. The right guard is "bash AND NOT in POSIX mode", detected through
# SHELLOPTS (":$SHELLOPTS:" contains ":posix:" under sh/--posix, not under bash)
# with a `case`, which dash/ash parse fine so T40's four-shell lint still holds.
#
# The correct behaviour under POSIX mode is to SKIP log and carry on: every
# anchor is set before section 4, so recovery still succeeds and boot still
# returns 0. Losing the log functions is the right trade; killing the shell is
# not. Hence assertion 5 — a plain (non-POSIX) bash must STILL get them, so an
# over-broad "never source log" fix cannot pass this.
test.config.bootSurvivesPosixModeBash() {
  local bad="" out bashPath probe
  bashPath=$(command -v bash 2>/dev/null)
  if [ ! -x "$bashPath" ]; then
    create.result 0 "skipped (no bash on PATH)"
    return $(result)
  fi
  # `type log.device` is how "did log get sourced" is asked without assuming it
  # did; ALIVE is the liveness marker — under POSIX mode a parse error in the
  # sourced file ends the shell, so it simply never prints.
  probe='. "'"$OOSH_DIR"'/boot"; echo "RC=$?"; echo "<[$HOME|$OOSH_DIR|$CONFIG_PATH|$OOSH_USER_CONFIG_PATH]>"; if type log.device >/dev/null 2>&1; then echo LOGFN=yes; else echo LOGFN=no; fi; echo ALIVE'

  # --- 1..4: bash --posix, i.e. macOS /bin/sh -----------------------------
  out=$(cd /tmp && env -i "$bashPath" --posix -c "$probe" 2>&1)
  case "$out" in
    *ALIVE*) : ;;
    *) bad="$bad posix-shell-died:$(echo "$out" | tr '\n' ' ' | cut -c1-140)" ;;
  esac
  case "$out" in
    *"not a valid identifier"*) bad="$bad posix-sourced-log-anyway (dotted names rejected)" ;;
  esac
  case "$out" in
    *RC=0*) : ;;
    *) bad="$bad posix-boot-rc-not-0:$(echo "$out" | grep -o 'RC=[0-9]*' | tail -1)" ;;
  esac
  case "$out" in
    *"<[$HOME|$HOME/oosh|$HOME/config|$HOME/.config/oosh]>"*) : ;;
    *) bad="$bad posix-anchors:$(echo "$out" | grep -o '<\[[^]]*\]>' | tail -1)" ;;
  esac

  # `set -o posix` turned on at RUNTIME is the same shell state by another door
  # (a user's rc, or a caller that set it); it must be just as survivable.
  out=$(cd /tmp && env -i "$bashPath" -c "set -o posix; $probe" 2>&1)
  case "$out" in
    *ALIVE*) : ;;
    *) bad="$bad set-o-posix-shell-died:$(echo "$out" | tr '\n' ' ' | cut -c1-140)" ;;
  esac

  # --- 5: the trade is SKIP LOG, not NEVER LOG ----------------------------
  # A plain bash must still come out WITH the log functions, or section 4 has
  # been thrown away rather than guarded.
  out=$(cd /tmp && env -i "$bashPath" -c "$probe" 2>&1)
  case "$out" in
    *LOGFN=yes*) : ;;
    *) bad="$bad plain-bash-lost-log:$(echo "$out" | grep -o 'LOGFN=[a-z]*' | tail -1)" ;;
  esac
  case "$out" in
    *ALIVE*) : ;;
    *) bad="$bad plain-bash-died:$(echo "$out" | tr '\n' ' ' | cut -c1-140)" ;;
  esac

  if [ -z "$bad" ]; then
    create.result 0 "POSIX-mode bash survives boot"
  else
    create.result 1 "POSIX-mode bash broken —$bad"
  fi
  return $(result)
}
test.case - "T70: POSIX-mode bash (macOS /bin/sh) sources boot and stays alive" \
  test.config.bootSurvivesPosixModeBash
expect 0 "POSIX-mode bash survives boot" \
  "\$BASH_VERSION answers the wrong question — /bin/sh on macOS is bash in POSIX mode"

# ============================================================================
# Save results
# ============================================================================
# ============================================================================
# T71: a generated config does not carry OOSH_BRANCH into the next shell
# ============================================================================
# The drift loop, end to end. oosh.env seeds a shell with OOSH_BRANCH; that
# shell reaches a config save; the save writes OOSH_BRANCH straight back. On
# this host it has been saying "prod" against a dev checkout for weeks, which
# makes private.oo.install.branch.get — "the one rule behind state 31, state 34
# and oo boot.fix" — answer prod on a dev box.
#
# OOSH_BRANCH is the install INPUT: the branch the operator asked for. It is
# meaningful for the length of one install and meaningless afterwards, so it
# must not survive into a shell. The branch a box is ON is derived from the
# checkout, never remembered.
test.config.branchIsInputNotState() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t71.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local out
  # Generate a config from a shell that carries the install input, then source
  # the generated chain in a CLEAN child and ask what it inherited.
  out=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
            OOSH_USER_CONFIG_PATH="$fixture/pu" OOSH_BRANCH=prod OOSH_MODE=dev \
        bash -c '
          mkdir -p "$OOSH_USER_CONFIG_PATH"; : > "$OOSH_USER_CONFIG_PATH/log.session.env"
          source "$OOSH_DIR/this" >/dev/null 2>&1
          source "$OOSH_DIR/config" >/dev/null 2>&1
          : > "$CONFIG"; config.save >/dev/null 2>&1
          grep -h OOSH_BRANCH "$CONFIG_PATH"/*.env 2>/dev/null | tr -d " \t"
        ')
  rm -rf "$fixture" 2>/dev/null

  if [ -n "$out" ]; then
    create.result 1 "the install input was persisted into the config: [$out]"
  else
    create.result 0 "OOSH_BRANCH is install input and never reaches the config"
  fi
  return $(result)
}
test.case - "T71: config.save does not persist the install input OOSH_BRANCH" \
  test.config.branchIsInputNotState
expect 0 "OOSH_BRANCH is install input and never reaches the config" \
  "persisting it closes a loop that never consults the checkout — the T7 drift"

# ============================================================================
# T72: config.init honours the anchor it was given, and defaults when given none
# ============================================================================
# config.init did an UNCONDITIONAL `export CONFIG_PATH=~/config`, and
# config.start re-runs it whenever $CONFIG is not a file — so any fixture was
# undone from inside the file under test. That is why test.config and
# test.completion.audit had to declare TEST_SHARED_TIER_WRITER instead of
# isolating: they source `config`, and sourcing it moved the anchor back.
#
# The conditional form is not a bend of the anchor rule, it is the rule:
# private.this.anchor.validate.one classifies `: ${CONFIG_PATH:=~/config}` as
# CONFORMING, and `this`, `log` and `ossh` already use exactly that shape for
# this exact variable.
test.config.initHonoursGivenAnchor() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t72.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local given defaulted
  # (a) given an anchor, keep it
  given=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              CONFIG_PATH="$fixture" CONFIG_FILE=user.env CONFIG="$fixture/user.env" \
          bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                   source "$OOSH_DIR/config" >/dev/null 2>&1
                   config.init >/dev/null 2>&1
                   printf "%s|%s" "$CONFIG_PATH" "$CONFIG"')
  # (b) given none, produce the constant
  defaulted=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
              bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                       source "$OOSH_DIR/config" >/dev/null 2>&1
                       config.init >/dev/null 2>&1
                       printf "%s" "$CONFIG_PATH"')
  rm -rf "$fixture" 2>/dev/null

  if [ "${given%%|*}" != "$fixture" ]; then
    create.result 1 "config.init clobbered the anchor it was given: [${given%%|*}] wanted [$fixture]"
  elif [ "${given#*|}" != "$fixture/user.env" ]; then
    create.result 1 "\$CONFIG did not follow the given anchor: [${given#*|}]"
  elif [ "$defaulted" != "$HOME/config" ]; then
    create.result 1 "with no anchor given, config.init did not produce \$HOME/config: [$defaulted]"
  else
    create.result 0 "config.init honours a given anchor and defaults to the constant"
  fi
  return $(result)
}
test.case - "T72: config.init keeps an inherited CONFIG_PATH and still defaults to ~/config" \
  test.config.initHonoursGivenAnchor
expect 0 "config.init honours a given anchor and defaults to the constant" \
  "config.start re-runs config.init, so an unconditional export undoes a fixture from inside"

# ============================================================================
# T73: config validate required — names what is missing, and reports drift
# ============================================================================
# The card asks for two things this tree had neither of: a declared set of
# variables a config must carry for a branch version, and something that
# notices when the persisted branch disagrees with the checkout.
#
# config.init only ever created a directory and three variables, so on a
# missing config it succeeded emptily. config.validate checks line SHAPE and
# knows no variable name at all. config.init.check never opens an env file.
test.config.requiredFixture() { # <dir> <oosh-branch> <?omit> # a config tier plus a ~/oosh symlink on <oosh-branch>
  local dir="$1" branch="$2" omit="$3"
  mkdir -p "$dir/home" "$dir/base/$branch"
  ln -sfn "$dir/base/$branch" "$dir/home/oosh"
  printf 'export BASH_FILE="/usr/bin/bash"\nexport CONFIG_FILE="user.env"\n' > "$dir/user.env"
  printf 'export LOG_LEVEL="1"\n' > "$dir/log.env"
  [ "$omit" = "omit" ] && return 0
  printf 'export OOSH_MODE="%s"\nexport OOSH_OS="linux-gnu"\nexport OOSH_PM="apt-get -y install"\n' \
    "${4:-$branch}" > "$dir/oosh.env"
}

test.config.requiredRun() { # <dir> # run `config validate required` against <dir> in a pinned child; echo "rc|verdict"
  local out rc
  out=$(env -i PATH="$PATH" HOME="$1/home" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
            CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
        bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1
                 source "$OOSH_DIR/config" >/dev/null 2>&1
                 config.validate.required 2>/dev/null'); rc=$?
  printf '%s|%s' "$rc" "$(printf '%s' "$out" | tr '\n' ' ')"
}

test.config.validateRequired() {
  local base; base=$(mktemp -d "${TMPDIR:-/tmp}/oosh.t73.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }

  test.config.requiredFixture "$base/ok" dev
  local ok; ok=$(test.config.requiredRun "$base/ok")

  test.config.requiredFixture "$base/gone" dev omit          # no oosh.env at all
  local gone; gone=$(test.config.requiredRun "$base/gone")

  test.config.requiredFixture "$base/drift" dev "" prod      # persisted prod, checkout dev
  local drift; drift=$(test.config.requiredRun "$base/drift")
  rm -rf "$base" 2>/dev/null

  if [ "${ok%%|*}" != "0" ]; then
    create.result 1 "a complete config was rejected: [$ok]"
  elif [ "${gone%%|*}" = "0" ]; then
    create.result 1 "a config with no oosh.env was accepted — succeeding emptily is the bug"
  elif [ "${gone#*OOSH_MODE}" = "$gone" ] || [ "${gone#*OOSH_PM}" = "$gone" ]; then
    create.result 1 "the missing variables were not all named: [$gone]"
  elif [ "${drift%%|*}" = "0" ]; then
    create.result 1 "persisted prod against a dev checkout was accepted: [$drift]"
  elif [ "${drift#*prod}" = "$drift" ] || [ "${drift#*dev}" = "$drift" ]; then
    create.result 1 "the drift report names neither side: [$drift]"
  else
    create.result 0 "missing variables are named and branch drift is reported"
  fi
  return $(result)
}
test.case - "T73: config validate required names every missing variable and reports branch drift" \
  test.config.validateRequired
expect 0 "missing variables are named and branch drift is reported" \
  "config.init succeeded emptily on a missing config, and nothing compared the persisted branch to the checkout"

# ============================================================================
# T75: config.save survives a bash-3.2 `declare -p` stream
# ============================================================================
# THE BUG THIS PINS (docs/research/2026-09-17-config-save-bash32.md):
# on macOS /bin/bash 3.2.57, `declare -p` with NO NAMES is `set`-style — no
# `declare -x` prefix — and it ALSO prints every function body, verbatim and
# multi-line, into the same stream config.save filters. The filter derived a
# "variable name" with three string-strips and never checked it was one, so a
# function-body line with no `=` survived `${_vn%%=*}` whole and glob-matched
# `OOSH_*`. Rows of private.config.required.variables.get's heredoc became
# lines in ~/config/oosh.env, and every login printed
# "OOSH_MODE: command not found".
#
# Linux runs bash 5, where `declare -p` prints no functions — so this cannot
# be reproduced here, it has to be INJECTED. A shell function shadows a
# builtin, so the stub below reproduces 3.2's BROKEN no-argument output while
# delegating the CORRECT named form (`declare -p NAME`, measured right on 3.2)
# to the real builtin. Same move as T28's fixture, but wired to the real code
# path instead of to a grep.
test.config.bash32Save() { # <fixture> # run config.save under a simulated bash-3.2 `declare -p`; echo the file it generated
  (
    declare() {
      if [ "$1" = "-p" ] && [ $# -eq 1 ]; then
        # The four lines that really landed on the VM.
        printf '%s\n' "OOSH_PM='brew install'" \
                      "OOSH_PROMPT='oosh '" \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      'OOSH_OS oosh.env $OSTYPE, via os'
        return 0
      fi
      builtin declare "$@"
    }
    export OOSH_PM="brew install" OOSH_PROMPT="oosh "
    CONFIG_PATH="$1" CONFIG_FILE="bash32.env" CONFIG="$1/bash32.env" \
      config.save bash32 OOSH >/dev/null 2>&1
    cat "$1/bash32.env" 2>/dev/null
  )
}
test.config.saveSurvivesBash32Stream() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.bash32.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }
  local generated; generated=$(test.config.bash32Save "$fixture")
  rm -rf "$fixture" 2>/dev/null

  local junk unexported total
  # A junk row is NAME followed by a FILENAME — never an assignment. Anchoring
  # on "a word then a space" alone was wrong: `export OOSH_MODE="released"` is
  # also a word then a space, so the first version of this check failed on the
  # CORRECT output. Watched failing both ways, which is the point.
  junk=$(printf '%s\n' "$generated" | grep -c -E '^(export )?[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[a-z]+\.env[[:space:]]' 2>/dev/null)
  total=$(printf '%s\n' "$generated" | grep -c -E '[^[:space:]]' 2>/dev/null)
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if [ "${total:-0}" = "0" ]; then
    create.result 1 "config.save wrote nothing at all"
  elif [ "${junk:-0}" != "0" ]; then
    create.result 1 "$junk function-body row(s) were written as if they were variables: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported line(s) carry no 'export' — the sed cannot match bash 3.2 output: [$generated]"
  elif ! printf '%s\n' "$generated" | grep -q 'OOSH_PM='; then
    create.result 1 "OOSH_PM did not survive the save: [$generated]"
  else
    create.result 0 "every generated line is an export assignment"
  fi
  return $(result)
}
test.case - "T75: config.save survives a bash-3.2 declare -p stream" \
  test.config.saveSurvivesBash32Stream
expect 0 "every generated line is an export assignment" \
  "bash 3.2 declare -p is set-style AND dumps function bodies — rows of the required-variables table became lines in oosh.env"

# ============================================================================
# T76: private.config.variables.list emits variable NAMES, never anything else
# ============================================================================
# The unit-level pin for the shape gate. compgen -v can only produce valid
# identifiers, so the gate is belt-and-braces in production — this drives it
# directly, with compgen stubbed, which is the only way to see it work.
test.config.variablesListShapeGate() {
  local listed
  listed=$(
    compgen() {
      if [ "$1" = "-v" ]; then
        printf '%s\n' 'OOSH_TEST_MODE' \
                      'OOSH_MODE oosh.env basename of the canonical ~/oosh' \
                      '9BAD' 'OOSH-DASH'
        return 0
      fi
      builtin compgen "$@"
    }
    private.config.variables.list OOSH 2>/dev/null
  )
  if [ "$listed" = "OOSH_TEST_MODE" ]; then
    create.result 0 "only a valid variable name survives the gate"
  else
    create.result 1 "expected just OOSH_TEST_MODE, got: [$listed]"
  fi
  return $(result)
}
test.case - "T76: private.config.variables.list returns names, not whatever starts with the prefix" \
  test.config.variablesListShapeGate
expect 0 "only a valid variable name survives the gate" \
  "the old filter took three string-strips as a variable name and never checked it was one"

# ============================================================================
# T77: private.config.variable.export.line — fidelity, and the dash promise
# ============================================================================
# The value must survive a round trip through EVERY shell that sources the
# generated file. $OOSH_DIR/boot is sourced by /bin/sh on Debian login shells,
# so bash alone is not enough (review-2026-09-09 § D1).
test.config.exportLineRoundTrip() {
  export OOSH_T77='a    b $HOME `x` "q" back\slash'
  local line; line=$(private.config.variable.export.line OOSH_T77 2>/dev/null)
  case "$line" in
    export\ OOSH_T77=*) ;;
    *) create.result 1 "not an export line: [$line]"; return $(result) ;;
  esac

  # Every available POSIX shell must reproduce the value byte for byte.
  local shellBin bin got broken=""
  for shellBin in sh dash ash bash busybox; do
    bin=$(command -v "$shellBin" 2>/dev/null) || continue
    [ -n "$bin" ] || continue
    if [ "$shellBin" = "busybox" ]; then bin="$bin sh"; fi
    got=$($bin -c "$line"'; printf %s "$OOSH_T77"' 2>/dev/null)
    [ "$got" = "$OOSH_T77" ] || broken="$broken $shellBin"
  done
  if [ -n "$broken" ]; then
    create.result 1 "the value did not survive:$broken — line was [$line]"
    return $(result)
  fi

  # A value bash renders as $'…' is a BASHISM that dash reads literally, so it
  # is refused rather than written as a line half the loaders mis-parse.
  export OOSH_T77_MULTI="line1
line2"
  local multi multiRc
  multi=$(private.config.variable.export.line OOSH_T77_MULTI 2>/dev/null); multiRc=$?
  # An array has no single-line export form.
  OOSH_T77_ARR=(a b)
  local arr arrRc
  arr=$(private.config.variable.export.line OOSH_T77_ARR 2>/dev/null); arrRc=$?
  # An unset name is not an error to report, just nothing to write.
  local gone goneRc
  gone=$(private.config.variable.export.line OOSH_T77_NEVER_SET 2>/dev/null); goneRc=$?
  unset OOSH_T77 OOSH_T77_MULTI OOSH_T77_ARR

  if [ "$multiRc" = "0" ] || [ -n "$multi" ]; then
    create.result 1 "a newline-bearing value was written as [$multi] — dash mis-parses \$'…'"
  elif [ "$arrRc" = "0" ] || [ -n "$arr" ]; then
    create.result 1 "an array was written as [$arr]"
  elif [ "$goneRc" = "0" ] || [ -n "$gone" ]; then
    create.result 1 "an unset name produced [$gone]"
  else
    create.result 0 "the value round-trips through every shell, and the unwritable cases are refused"
  fi
  return $(result)
}
test.case - "T77: private.config.variable.export.line round-trips through every POSIX shell" \
  test.config.exportLineRoundTrip
expect 0 "the value round-trips through every shell, and the unwritable cases are refused" \
  "boot sources these files under /bin/sh — a bash-only rendering breaks Debian login shells"

# ============================================================================
# T78: a trailing "_" in the prefix does not silence the sweep
# ============================================================================
# `backup config.save global` passes BACKUP_ (backup:262). The old gate was
# `${name}|${name}_*` — with the underscore already there that reads
# `BACKUP_|BACKUP__*`, which BACKUP_TARGET matches neither, so backup.env has
# been written empty all along.
test.config.variablesListTrailingUnderscore() {
  export BACKUP_TARGET="/some/where"
  local listed; listed=$(private.config.variables.list BACKUP_ 2>/dev/null)
  unset BACKUP_TARGET
  if printf '%s\n' "$listed" | grep -qx 'BACKUP_TARGET'; then
    create.result 0 "a trailing underscore in the prefix is tolerated"
  else
    create.result 1 "BACKUP_ found nothing; BACKUP_TARGET was set. got: [$listed]"
  fi
  return $(result)
}
test.case - "T78: config.save prefix tolerates a trailing underscore" \
  test.config.variablesListTrailingUnderscore
expect 0 "a trailing underscore in the prefix is tolerated" \
  "backup passes BACKUP_ and has been writing an empty backup.env ever since"

# The four placeholder cases `oo method.new` generated for
# private.config.variables.list / .variable.export.line / .variables.export /
# .string.upper were removed here, deliberately: all four are GETTERS consumed
# as $(...), so none calls create.result, and the template's
# `expect 0 "<result>"` would have compared whatever $RESULT the PREVIOUS test
# left behind — a test that cannot fail, which is the exact defect the
# "Tests that cannot fail" card is about. Their real coverage is T75-T78 above.
#
# templates/code/newMethodTest assumes a create.result method. A getter needs a
# different shape (assert on stdout, not on $RESULT). Recorded as a card —
# there is no newGetterTest template and this is not the last getter the tree
# will grow.

# ============================================================================
# T79: every generated line is an export assignment, and a one-argument
#      `config save <file>` derives its prefix without ${var^^}
# ============================================================================
# A REGRESSION GUARD, not a red-first test, and labelled so: on bash 5 the old
# code already produced export lines, and `${file^^}` already worked. Both
# halves fail only on macOS /bin/bash 3.2 — the first silently (no `export` on
# any line), the second fatally (a "bad substitution" that EXITS the shell).
# This pins the shapes so the fix cannot quietly come undone.
test.config.saveShapeAndPrefix() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.config.shape.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }

  # The upper-caser itself.
  local upper; upper=$(private.config.string.upper "myApp")
  if [ "$upper" != "MYAPP" ]; then
    rm -rf "$fixture" 2>/dev/null
    create.result 1 "private.config.string.upper myApp gave [$upper]"
    return $(result)
  fi

  # One argument: `config save myapp` must derive MYAPP and harvest MYAPP_*.
  export MYAPP_TOKEN="a value with spaces"
  (
    CONFIG_PATH="$fixture" CONFIG_FILE="myapp.env" CONFIG="$fixture/myapp.env" \
      config.save myapp >/dev/null 2>&1
  )
  local generated; generated=$(cat "$fixture/myapp.env" 2>/dev/null)
  unset MYAPP_TOKEN
  rm -rf "$fixture" 2>/dev/null

  local unexported
  unexported=$(printf '%s\n' "$generated" | grep -E '[^[:space:]]' 2>/dev/null \
               | grep -c -v -E '^export [A-Za-z_][A-Za-z0-9_]*=' 2>/dev/null)

  if ! printf '%s\n' "$generated" | grep -q '^export MYAPP_TOKEN='; then
    create.result 1 "the one-argument form derived no prefix: [$generated]"
  elif [ "${unexported:-0}" != "0" ]; then
    create.result 1 "$unexported generated line(s) are not export assignments: [$generated]"
  else
    create.result 0 "the prefix is derived and every line is an export assignment"
  fi
  return $(result)
}
test.case - "T79: config save <file> derives its prefix, and writes only export lines" \
  test.config.saveShapeAndPrefix
expect 0 "the prefix is derived and every line is an export assignment" \
  "on bash 3.2 the derivation was a fatal bad substitution and no line ever carried export"

### test.method

test.suite.save.results
