#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

# NO config isolation any more, deliberately. path.append / prepend / remove
# used to end in private.update.config, whose body was a NO-ARG `config save`:
# that truncated $CONFIG_PATH/user.env and then cascaded `config save oosh
# OOSH` and `config save log LOG`, regenerating oosh.env and log.env from the
# current process env. ~/config is a site-wide sharedConfig sourced by every
# user at login, so this one file rewrote three shared files eight times per
# `test.suite core 1` run, for everyone on the box.
#
# T8 deleted private.update.config. These methods are session-local now and
# write no file at all, so the fixture has nothing left to protect. The
# runner's shared-tier canary is the proof: if this file ever writes ~/config
# again, the run names it.

source path

log.level $level

# Save original PATH for restoration
ORIGINAL_PATH="$PATH"

# Create temp directories for testing (use /tmp for multi-user compatibility)
TEST_PATH_TMP="/tmp/oosh-test-path-$$"
TEST_DIR_1="$TEST_PATH_TMP/test_path_dir_1"
TEST_DIR_2="$TEST_PATH_TMP/test_path_dir_2"
TEST_DIR_3="$TEST_PATH_TMP/test_path_dir_3"
mkdir -p "$TEST_DIR_1" "$TEST_DIR_2" "$TEST_DIR_3"

# Helper to reset PATH
reset_path() {
  export PATH="$ORIGINAL_PATH"
}

# ============================================================================
# Test path.list
# ============================================================================

test.case $level "path.list - lists PATH entries line by line" \
  path.list

# Verify output contains at least /usr/bin
RESULT=$(path.list | grep -c "/usr/bin" || echo "0")
if [ "$RESULT" -ge 1 ]; then
  expect.pass "path.list contains /usr/bin"
else
  expect.fail "path.list should contain /usr/bin"
fi

# ============================================================================
# Test path.env
# ============================================================================

test.case $level "path.env - returns PATH as export statement" \
  path.env

# Verify RESULT contains export PATH=
if [[ "$RESULT" == *"export PATH="* ]]; then
  expect.pass "path.env returns proper export statement"
else
  expect.fail "path.env should return 'export PATH=...'"
fi

# ============================================================================
# Test path.append
# ============================================================================

reset_path
test.case $level "path.append - appends directory to PATH" \
  path.append "$TEST_DIR_1"

# Verify TEST_DIR_1 is at the end of PATH
if [[ "$PATH" == *":$TEST_DIR_1" ]]; then
  expect.pass "path.append added directory at end of PATH"
else
  expect.fail "path.append should add directory at end of PATH"
fi

# Test that duplicate append doesn't create duplicates
reset_path
path.append "$TEST_DIR_1" 2>/dev/null
path.append "$TEST_DIR_1" 2>/dev/null
DUPLICATE_COUNT=$(echo "$PATH" | tr ':' '\n' | grep -c "^${TEST_DIR_1}$" || echo "0")
if [ "$DUPLICATE_COUNT" -eq 1 ]; then
  expect.pass "path.append does not create duplicates"
else
  expect.fail "path.append should not create duplicates (found $DUPLICATE_COUNT)"
fi

# ============================================================================
# Test path.prepend
# ============================================================================

reset_path
test.case $level "path.prepend - prepends directory to PATH" \
  path.prepend "$TEST_DIR_1"

# Verify TEST_DIR_1 is at the beginning of PATH
if [[ "$PATH" == "$TEST_DIR_1:"* ]]; then
  expect.pass "path.prepend added directory at beginning of PATH"
else
  expect.fail "path.prepend should add directory at beginning of PATH"
fi

# Test that duplicate prepend doesn't create duplicates
reset_path
path.prepend "$TEST_DIR_1" 2>/dev/null
path.prepend "$TEST_DIR_1" 2>/dev/null
DUPLICATE_COUNT=$(echo "$PATH" | tr ':' '\n' | grep -c "^${TEST_DIR_1}$" || echo "0")
if [ "$DUPLICATE_COUNT" -eq 1 ]; then
  expect.pass "path.prepend does not create duplicates"
else
  expect.fail "path.prepend should not create duplicates (found $DUPLICATE_COUNT)"
fi

# ============================================================================
# Test path.remove
# ============================================================================

reset_path
path.append "$TEST_DIR_1" 2>/dev/null
test.case $level "path.remove - removes directory from PATH" \
  path.remove "$TEST_DIR_1"

# Verify TEST_DIR_1 is no longer in PATH
if [[ "$PATH" != *"$TEST_DIR_1"* ]]; then
  expect.pass "path.remove removed directory from PATH"
else
  expect.fail "path.remove should remove directory from PATH"
fi

# ============================================================================
# T-PATH-REMOVE-EXACT: `path remove /usr` must not take /usr/bin with it
# ============================================================================
# The old body used line.remove — `grep -v "$1"`, a SUBSTRING match — so
# removing a prefix removed every path under it. This is the assertion the
# shrink exists for.
test.path.removeIsWholeSegment() {
  # The REAL PATH is kept and /usr appended to it — a synthetic PATH would
  # leave grep, sed and xargs unresolvable, and path.remove runs a line.*
  # pipeline. The real PATH already carries /usr/bin, /usr/local/bin and
  # /usr/sbin, which is exactly what the old substring match destroyed.
  local saved="$PATH" after bare kept
  export PATH="$PATH:/usr"
  path.remove "/usr" >/dev/null 2>&1
  after="$PATH"
  export PATH="$saved"
  bare=$(printf "%s" ":$after:" | grep -c ":/usr:")
  kept=$(printf "%s" ":$after:" | grep -c ":/usr/bin:")
  if [ "$bare" = "0" ] && [ "$kept" != "0" ]; then
    create.result 0 "whole segment only"
  else
    create.result 1 "bare=$bare kept=$kept in: $after"
  fi
  return $(result)
}
test.case $level "path.remove - removes the whole segment only, not everything under it" \
  test.path.removeIsWholeSegment
expect 0 "whole segment only" "line.remove is a substring match: it deleted /usr/bin, /usr/local/bin and /usr/sbin too"

# The same substring bug on the de-dupe side: appending /opt/x dropped /opt/xy.
test.path.appendDeDupeIsWholeSegment() {
  local saved="$PATH" after
  export PATH="$PATH:/opt/xy"
  path.append "/opt/x" >/dev/null 2>&1
  after="$PATH"
  export PATH="$saved"
  case ":$after:" in
    *":/opt/xy:"*) create.result 0 "neighbour kept" ;;
    *)             create.result 1 "the de-dupe pass ate /opt/xy: $after" ;;
  esac
  return $(result)
}
test.case $level "path.append - de-dupes by whole segment, so /opt/xy survives adding /opt/x" \
  test.path.appendDeDupeIsWholeSegment
expect 0 "neighbour kept" "line.filter matched a substring, so the de-dupe pass ate the neighbour"

# Nothing here may persist: the login PATH is data in ~/config/user.env, and these methods
# are session-local. The docstrings used to claim "and saves config".
test.path.mutatorsPersistNothing() {
  local saved="$PATH" before after session verb
  session=$(private.config.user.session.file.get)
  before=$(cat "$CONFIG" "$session" 2>/dev/null | cksum)
  for verb in prepend append remove put push add rm; do
    path.$verb "/tmp/oosh-test-path-persistence" >/dev/null 2>&1
  done
  after=$(cat "$CONFIG" "$session" 2>/dev/null | cksum)
  export PATH="$saved"
  if [ "$before" != "$after" ] || grep -q "oosh-test-path-persistence" "$CONFIG" "$session" 2>/dev/null; then
    create.result 1 "a path mutator wrote to $CONFIG or $session"
  else
    create.result 0 "nothing written"
  fi
  return $(result)
}
test.case $level "path mutators (and their aliases) - write nothing to the config tier or the session file" \
  test.path.mutatorsPersistNothing
expect 0 "nothing written" "private.update.config ran a no-arg config save from a child process — the login PATH is data in ~/config/user.env"


# ============================================================================
# Test path.parameter.completion.dir - completion function
# ============================================================================

test.case $level "path.parameter.completion.dir - function exists" \
  this.functionExists path.parameter.completion.dir

if [ $RETURN_VALUE -eq 0 ]; then
  expect.pass "path.parameter.completion.dir function exists"
else
  expect.fail "path.parameter.completion.dir function should exist"
fi

# Test that completion returns directories
test.case $level "path.parameter.completion.dir - returns matching dirs" \
  path.parameter.completion.dir "$OOSH_DIR/te"

COMPLETION_RESULT=$(path.parameter.completion.dir "$OOSH_DIR/te")
if [[ "$COMPLETION_RESULT" == *"$OOSH_DIR/test"* ]]; then
  expect.pass "returns matching directories"
else
  expect.fail "should return matching directories, got: $COMPLETION_RESULT"
fi

# Test completion with /usr prefix
test.case $level "path.parameter.completion.dir - handles /usr prefix" \
  path.parameter.completion.dir "/usr"

COMPLETION_RESULT=$(path.parameter.completion.dir "/usr")
if [[ "$COMPLETION_RESULT" == *"/usr"* ]]; then
  expect.pass "handles /usr prefix"
else
  expect.fail "should handle /usr prefix"
fi

# Test completion for test tmp directories we created
test.case $level "path.parameter.completion.dir - returns test directories" \
  path.parameter.completion.dir "$TEST_PATH_TMP/test_path"

COMPLETION_RESULT=$(path.parameter.completion.dir "$TEST_PATH_TMP/test_path")
if [[ "$COMPLETION_RESULT" == *"test_path_dir"* ]]; then
  expect.pass "returns our test directories"
else
  expect.fail "should return test directories, got: $COMPLETION_RESULT"
fi

# ============================================================================
# Test path.usage
# ============================================================================

# The old assertion was `[[ "$RESULT" == *"Usage"* ]] || [ $RETURN_VALUE -eq 0 ]`
# — the second disjunct is satisfied by almost any outcome, so it could not
# fail. What matters is that the text no longer advertises verbs that do not
# exist: `add`, `push`, `put` and `rm` all reach this.methodNotFound, and the
# table is rendered by this.help from the docstrings now (add, push, put and rm
# are real aliases again, so they are no longer ghosts).
test.path.usageAdvertisesOnlyRealVerbs() {
  local out
  out=$(path.usage 2>/dev/null)
  local ghost
  for ghost in " status " " file.global" " file.user"; do
    case "$out" in *"$ghost"*) create.result 1 "usage still advertises '$ghost'"; return $(result) ;; esac
  done
  case "$out" in
    *"Usage"*) create.result 0 "usage is honest" ;;
    *)         create.result 1 "usage printed no command table" ;;
  esac
  return $(result)
}
test.case $level "path.usage - advertises only verbs that exist" \
  test.path.usageAdvertisesOnlyRealVerbs
expect 0 "usage is honest" "the hand-maintained table advertised four verbs that have never existed"

# ============================================================================
# Cleanup
# ============================================================================

echo ""
echo -e "\e[90mCleanup: Removing test directories and restoring PATH\e[0m"

rm -rf "$TEST_PATH_TMP" 2>/dev/null
export PATH="$ORIGINAL_PATH"

# ============================================================================
# Test Summary
# ============================================================================


console.log "
Test: T-PATH-VALIDATE-TREE
===================================================================="

# ============================================================================
# T-PATH-VALIDATE-TREE: the shipped tree obeys the rule
# ============================================================================
test.path.validateTree() {
  local out
  out=$(path.validate "$OOSH_DIR" 2>/dev/null)
  local rc=$?
  case "$out" in
    *"OK:"*"0 violations"*) [ "$rc" -eq 0 ] && create.result 0 "tree conforms" || create.result 1 "verdict OK but rc=$rc" ;;
    *)                      create.result 1 "rc=$rc $out" ;;
  esac
  return $(result)
}
test.case $level "T-PATH-VALIDATE-TREE: every PATH= in the tree carries a marker" \
  test.path.validateTree
expect 0 "tree conforms" "no unmarked PATH writer escapes the rule"

# ============================================================================
# T-PATH-VALIDATE-* : the guard can actually FAIL
# ============================================================================
# A guard that never fails guards nothing. Plant each shape in a throwaway git
# repo — `git grep` only sees TRACKED files, so `git add` is required — using
# the same mechanism as test.this's anchor-validator tests (:463-534).
PV_FIXTURE=$(mktemp -d "${TMPDIR:-/tmp}/test.path.validate.XXXXXX")
git -c init.defaultBranch=main init "$PV_FIXTURE" >/dev/null 2>&1

private.test.path.validate.plant() { # <file> <content...> # write + track <file>, echo the verdict
  local name="$1"; shift
  printf '%s\n' "$@" > "$PV_FIXTURE/$name"
  git -C "$PV_FIXTURE" add "$name" >/dev/null 2>&1
  # LOG_DEVICE is not always a tty (test.suite core redirects), so error.log
  # lines can share this capture with the verdict — match on SUBSTRINGS.
  path.validate "$PV_FIXTURE" 2>/dev/null
}
private.test.path.validate.clear() { # # drop every planted file
  git -C "$PV_FIXTURE" rm -q -f --ignore-unmatch '*' >/dev/null 2>&1
  rm -f "$PV_FIXTURE"/* 2>/dev/null
}

test.path.validateRejects() {
  private.test.path.validate.clear
  local out
  out=$(private.test.path.validate.plant offender '#!/usr/bin/env bash' \
        'export PATH="/somewhere:$PATH"')
  case "$out" in
    *"INVALID:"*"1 violation"*) create.result 0 "unmarked writer rejected" ;;
    *)                          create.result 1 "expected 1 violation, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PATH-VALIDATE-REJECTS: an unmarked PATH= is a violation" \
  test.path.validateRejects
expect 0 "unmarked writer rejected" "no file builds PATH; every writer declares itself"

test.path.validateBootIsNoException() {
  private.test.path.validate.clear
  local out
  out=$(private.test.path.validate.plant boot '#!/usr/bin/env sh' \
        '  *) PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH" ;;')
  case "$out" in
    *"INVALID:"*"1 violation"*) create.result 0 "a file named boot is no exception" ;;
    *)                          create.result 1 "expected 1 violation, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PATH-VALIDATE-NO-OWNER: no file is the implicit PATH builder — boot is gone" \
  test.path.validateBootIsNoException
expect 0 "a file named boot is no exception" "the PATH line is data in ~/config/user.env; every writer in the tree declares itself"

test.path.validateHonoursMarker() {
  private.test.path.validate.clear
  local out
  out=$(private.test.path.validate.plant degrade '#!/usr/bin/env bash' \
        '# path-exception: fixture — boot has not run on the far side of this ssh' \
        'export PATH="/somewhere:$PATH"')
  case "$out" in
    *"OK:"*"1 exception"*) create.result 0 "marker honoured" ;;
    *)                     create.result 1 "expected 1 exception, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PATH-VALIDATE-MARKER: an in-code # path-exception: is honoured" \
  test.path.validateHonoursMarker
expect 0 "marker honoured" "the marker may sit on the line or in the few lines above it"

test.path.validateHonoursFileMarker() {
  private.test.path.validate.clear
  local out
  out=$(private.test.path.validate.plant installer '#!/usr/bin/env sh' \
        '# path-exception-file: fixture — runs before ~/oosh exists' \
        'export PATH="/a:$PATH"' \
        'PATH="/b:$PATH"')
  case "$out" in
    *"OK:"*"2 exception"*) create.result 0 "file marker honoured" ;;
    *)                     create.result 1 "expected 2 exceptions, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PATH-VALIDATE-FILE-MARKER: # path-exception-file: exempts the whole file" \
  test.path.validateHonoursFileMarker
expect 0 "file marker honoured" "an installer that runs before ~/oosh exists cannot delegate to boot"

test.path.validateIgnoresOtherPathVars() {
  private.test.path.validate.clear
  local out
  out=$(private.test.path.validate.plant neighbours '#!/usr/bin/env bash' \
        'export CONFIG_PATH="$HOME/config"' \
        'OSSH_CONTROL_PATH="/tmp/ossh-%r@%h:%p"' \
        'echo "$PATH"')
  case "$out" in
    *"OK:"*"0 violations"*) create.result 0 "only PATH itself" ;;
    *)                      create.result 1 "a <SOMETHING>_PATH= was read as PATH=, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PATH-VALIDATE-SCOPE: CONFIG_PATH= and OSSH_CONTROL_PATH= are not PATH=" \
  test.path.validateIgnoresOtherPathVars
expect 0 "only PATH itself" "the leading character class excludes '_', so no <X>_PATH= is swept in"

# T-PATH-VALIDATE-BLIND: a tree git lists no tracked file in is a failure, not OK.
# ogit.repo.grep discards stderr, so a folder that is no repository, a
# repository with nothing tracked and git's "dubious ownership" refusal all
# came back as an empty sweep — and path.validate printed OK, 0 violations.
test.path.validateRefusesBlind() {
  local bad="" out rc fx
  fx=$(test.suite.fixture.make test.path.validate.blind)
  printf '%s\n' 'export PATH="/somewhere:$PATH"' > "$fx/loose"      # a file, no repository
  out=$(path.validate "$fx" 2>/dev/null); rc=$?
  [ "$rc" -ne 0 ] || bad="$bad no-repo-rc=$rc"
  case "$out" in *"INVALID:"*"no tracked files visible"*) ;; *) bad="$bad no-repo=[$out]" ;; esac
  private.test.path.validate.clear                                  # a repository, nothing tracked
  out=$(path.validate "$PV_FIXTURE" 2>/dev/null); rc=$?
  [ "$rc" -ne 0 ] || bad="$bad nothing-tracked-rc=$rc"
  case "$out" in *"INVALID:"*"no tracked files visible"*) ;; *) bad="$bad nothing-tracked=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "blind sweep refused" || create.result 1 "path.validate:$bad"
  return $(result)
}
test.case $level "T-PATH-VALIDATE-BLIND: a tree git lists no tracked file in is a failure, not a clean result" \
  test.path.validateRefusesBlind
expect 0 "blind sweep refused" "an empty git grep looks exactly like a conforming tree"

rm -rf "$PV_FIXTURE"
unset PV_FIXTURE

# ─────────────────────────────────────────────────────────────────────────────
# T-PATH-ONCE-INIT-IDEMPOTENT: init/once must not re-prepend $OOSH_DIR
#
# init/once carries `# path-exception-file:` ("the SUPERSEDED ONCE installer,
# kept only for history"), which exempts the whole file from path.validate.
# But it is NOT only history: the SETUP_SERVER install runs `once init` at
# state 60 (private.check.once.setup.started in oo). Its init branch used to
# do an unconditional
#     PATH="$OOSH_DIR:~/init:$(dirname …):.:~/scripts:$PATH"
# while $OOSH_DIR was already on PATH from this.path.add — so every fresh
# install ended with $OOSH_DIR twice. once.hibernate then FROZE that PATH into
# ~/.once, and bashrcTemplate sources ~/.once in every interactive shell, so
# the duplicate outlived the install forever. Reproduced in a naked
# ubuntu:24.04 2026-09-21; test.config T74 is what goes red.
#
# The file-level exception means path.validate can never catch a regression
# here, so this is the guard. Structural on purpose: the real behaviour needs
# a full install, which no fixture can stand in for.
# ─────────────────────────────────────────────────────────────────────────────
test.path.onceInitDoesNotDuplicateOoshDir() {
  local onceScript="$OOSH_DIR/init/once"
  if [ ! -f "$onceScript" ]; then
    create.result 0 "no init/once in this tree — nothing to guard"
    return $(result)
  fi
  # The offending shape: a PATH= assignment that interpolates $OOSH_DIR with no
  # colon-anchored segment test around it.
  local bare
  bare=$(grep -nE '(^|[^A-Za-z0-9_])PATH="\$OOSH_DIR:' "$onceScript" \
         | grep -v '^[[:space:]]*#' | grep -v '#.*PATH="\$OOSH_DIR:')
  if [ -n "$bare" ]; then
    create.result 1 "init/once prepends \$OOSH_DIR unconditionally — a fresh install ends with it on PATH twice, frozen into ~/.once: [$(printf '%s' "$bare" | tr '\n' ' ')]"
    return $(result)
  fi
  # And the init branch must still put the directories on PATH some way.
  if ! grep -qE '\*":\$_oncePathDir:"\*' "$onceScript"; then
    create.result 1 "init/once no longer has the colon-anchored PATH guard — did the fix get reverted?"
    return $(result)
  fi
  # `.` on PATH is CWE-426; it was removed from `this` (:1256) for exactly this
  # reason and must not come back through the ONCE installer either.
  local dotOnPath
  dotOnPath=$(grep -nE '(^|[^A-Za-z0-9_])PATH="[^"]*:\.:' "$onceScript" | grep -v ':[[:space:]]*#')
  if [ -n "$dotOnPath" ]; then
    create.result 1 "init/once puts '.' on PATH — CWE-426 untrusted search path: [$(printf '%s' "$dotOnPath" | tr '\n' ' ')]"
    return $(result)
  fi
  create.result 0 "init/once adds its directories idempotently"
  return $(result)
}
test.case $level "T-PATH-ONCE-INIT-IDEMPOTENT: init/once cannot put \$OOSH_DIR on PATH twice" \
  test.path.onceInitDoesNotDuplicateOoshDir
expect 0 "init/once adds its directories idempotently" \
  "a fresh install ended with \$OOSH_DIR twice on PATH, frozen into ~/.once and inherited by every shell (test.config T74)"

# T-PATH-ONCE-HIBERNATE-NO-PATH: ONCE does not freeze a PATH into ~/.once
# once.hibernate wrote `PATH="$PATH"` into ~/.once — the installing shell's
# PATH, frozen. The .bashrc sources ~/.once last, so it overwrote the user's
# own PATH from ~/.config/oosh/user.session.env: root's shells started with
# ~/oosh/su (platform run, 2026-10-02). PATH lives only in user.session.env;
# ~/.once keeps ONCE's own variables.
test.path.onceHibernateNoPath() {
  local onceScript="$OOSH_DIR/init/once" frozen
  if [ ! -f "$onceScript" ]; then
    create.result 0 "no init/once in this tree — nothing to guard"
    return $(result)
  fi
  frozen=$(grep -nE 'PATH=.*>>? *~/\.once' "$onceScript" | grep -vE '^[0-9]+:[[:space:]]*#')
  if [ -n "$frozen" ]; then
    create.result 1 "init/once writes a PATH into ~/.once: [$(printf '%s' "$frozen" | tr '\n' ' ')]"
  else
    create.result 0 "ONCE writes no PATH into ~/.once"
  fi
  return $(result)
}
test.case $level "T-PATH-ONCE-HIBERNATE-NO-PATH: once.hibernate does not freeze a PATH into ~/.once" \
  test.path.onceHibernateNoPath
expect 0 "ONCE writes no PATH into ~/.once" \
  "the .bashrc sources ~/.once last — its frozen PATH overwrote the user's own"

# ============================================================================
# path save / saved / load / edit / aliases
# ============================================================================
# HARD RULE: nothing here may touch the real ~/.config/oosh or ~/config. Every
# case that saves or loads runs in a SUBSHELL whose HOME and CONFIG_PATH are a
# fixture (test.config T-CONFIG-USER-SESSION-SAVE is the pattern), and the
# fixture is removed at the end of the case.
test.path.fixture.make() { # <label> # echo a fixture HOME: oosh -> this tree, a user.env that chains user.session.env last, bin1 and bin2 directories
  local fx tree; fx=$(test.suite.fixture.make "$1") || return 1
  tree=$(private.this.path.canonical "$OOSH_DIR")
  ln -s "$tree" "$fx/oosh"
  git config --file "$fx/.gitconfig" --add safe.directory "$tree"
  mkdir -p "$fx/config" "$fx/.config/oosh" "$fx/bin1" "$fx/bin2"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export CONFIG_FILE="user.env"' \
    'export CONFIG="$HOME/config/user.env"' 'export PATH="$HOME/oosh:$HOME/oosh/ng:$PATH"' \
    'export BASH_FILE="/usr/bin/bash"' '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' \
    '. $HOME/.config/oosh/user.session.env' > "$fx/config/user.env"
  printf '%s\n' 'export OOSH_PROBE="from-oosh.env"' > "$fx/config/oosh.env"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $HOME/.config/oosh/log.session.env' > "$fx/config/log.env"
  : > "$fx/.config/oosh/log.session.env"
  : > "$fx/.config/oosh/user.session.env"
  echo "$fx"
}

test.path.fixture.saved() { # <fx> # echo the saved PATH of the fixture home, read as data
  ( . "$1/.config/oosh/user.session.env"; echo "$PATH" )
}

# T-PATH-SAVE-WRITES-SESSION: path save puts this shell's PATH, as real directories, into the user's own file
test.path.saveWritesSession() {
  local fx bad="" got; fx=$(test.path.fixture.make pathsave) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:$fx/bin1:$fx/bin2:/usr/bin:/bin"
    path.save >/dev/null 2>&1 ) || bad="$bad rc=$?"
  got=$(test.path.fixture.saved "$fx")
  [ "$got" = "$fx/oosh:$fx/oosh/ng:$fx/bin1:$fx/bin2:/usr/bin:/bin" ] || bad="$bad saved=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "path save wrote the real PATH into user.session.env" || create.result 1 "path save:$bad"
  return $(result)
}
test.case $level "T-PATH-SAVE-WRITES-SESSION: path save writes this PATH into the user's user.session.env" test.path.saveWritesSession
expect 0 "path save wrote the real PATH into user.session.env" "path save is the user's front for config.session.save"

# T-PATH-SAVE-FILTERS: the segment filter of config.session.save decides what is written
test.path.saveFilters() {
  local fx bad="" got; fx=$(test.path.fixture.make pathsavefilter) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:.:rel/dir:/tmp/oosh-no-such-dir:$fx/missing:$fx/bin1:/usr/bin:/bin"
    path.save >/dev/null 2>&1 )
  got=$(test.path.fixture.saved "$fx")
  [ "$got" = "$fx/oosh:$fx/oosh/ng:$fx/bin1:/usr/bin:/bin" ] || bad="$bad saved=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "dot, relative, /tmp and missing directories are not saved" || create.result 1 "filter:$bad"
  return $(result)
}
test.case $level "T-PATH-SAVE-FILTERS: ., relative, /tmp and missing directories are not saved" test.path.saveFilters
expect 0 "dot, relative, /tmp and missing directories are not saved" "a polluted shell must not be frozen into the login PATH"

# T-PATH-SAVED-LISTS: path saved lists the saved PATH, one directory per line, and writes nothing
test.path.savedLists() {
  local fx bad="" got want before after; fx=$(test.path.fixture.make pathsaved) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  printf '%s\n' "export PATH=\"$fx/bin1:$fx/bin2:/usr/bin\"" > "$fx/.config/oosh/user.session.env"
  before=$(cksum < "$fx/.config/oosh/user.session.env")
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" PATH="$fx/oosh:/usr/bin:/bin"; path.saved 2>/dev/null )
  want="$fx/bin1
$fx/bin2
/usr/bin"
  [ "$got" = "$want" ] || bad="$bad listed=[$(printf '%s' "$got" | tr '\n' '|')]"
  after=$(cksum < "$fx/.config/oosh/user.session.env")
  [ "$before" = "$after" ] || bad="$bad file-changed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the saved PATH is listed one directory per line" || create.result 1 "saved:$bad"
  return $(result)
}
test.case $level "T-PATH-SAVED-LISTS: path saved lists the saved PATH one directory per line" test.path.savedLists
expect 0 "the saved PATH is listed one directory per line" "path saved is read-only"

# T-PATH-LOAD-SOURCED: sourced, path load sets this shell's PATH from the saved file, without duplicates
test.path.loadSourced() {
  local fx bad="" got dup; fx=$(test.path.fixture.make pathload) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  printf '%s\n' "export PATH=\"$fx/bin1:$fx/bin2:/usr/bin:$fx/bin1:/bin\"" > "$fx/.config/oosh/user.session.env"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" PATH="$fx/oosh:/usr/bin:/bin"; path.load >/dev/null 2>&1; echo "$PATH" )
  [ "$got" = "$fx/bin1:$fx/bin2:/usr/bin:/bin" ] || bad="$bad PATH=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "path load set PATH from the saved file, de-duplicated" || create.result 1 "load:$bad"
  return $(result)
}
test.case $level "T-PATH-LOAD-SOURCED: sourced, path load sets PATH from the saved file and de-duplicates" test.path.loadSourced
expect 0 "path load set PATH from the saved file, de-duplicated" "a sourced function can change the calling shell"

# T-PATH-LOAD-COMMAND-NOOP: as a command, path load changes nothing and says what to do
test.path.loadCommandNoop() {
  local fx bad="" out rc; fx=$(test.path.fixture.make pathloadcmd) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  printf '%s\n' "export PATH=\"$fx/bin1:/usr/bin:/bin\"" > "$fx/.config/oosh/user.session.env"
  out=$(env -i OOSH_NO_INSTALL=1 HOME="$fx" USER="$USER" PATH="/usr/bin:/bin" "$BASH" -c '"$HOME/oosh/path" load; rc=$?; printf "\nRC %s PATH %s\n" "$rc" "$PATH"' 2>/dev/null)
  case "$out" in *"open a new shell"*) ;; *) bad="$bad no-hint=[$out]" ;; esac
  case "$out" in *"source path; path.load"*) ;; *) bad="$bad no-source-hint" ;; esac
  case "$out" in *"RC 0 PATH /usr/bin:/bin"*) ;; *) bad="$bad rc-or-path=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "as a command path load changes nothing and points to a new shell" || create.result 1 "noop:$bad"
  return $(result)
}
test.case $level "T-PATH-LOAD-COMMAND-NOOP: as a command, path load changes nothing and says to open a new shell" test.path.loadCommandNoop
expect 0 "as a command path load changes nothing and points to a new shell" "a command cannot change its parent shell"

# T-PATH-LOAD-OLD-PATHS-FILE: an old ~/paths (one directory per line) loads, and path save then keeps it
test.path.loadOldPathsFile() {
  local fx bad="" got; fx=$(test.path.fixture.make pathloadold) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  printf '%s\n' "$fx/bin2" "" "$fx/bin1" "/usr/bin" "/bin" > "$fx/paths"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin"
         path.load "$fx/paths" >/dev/null 2>&1; echo "$PATH"; path.save >/dev/null 2>&1 )
  [ "$(printf '%s' "$got" | head -1)" = "$fx/bin2:$fx/bin1:/usr/bin:/bin" ] || bad="$bad loaded=[$got]"
  got=$(test.path.fixture.saved "$fx")
  [ "$got" = "$fx/oosh:$fx/oosh/ng:$fx/bin2:$fx/bin1:/usr/bin:/bin" ] || bad="$bad saved=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "an old paths file loads and saves" || create.result 1 "old paths:$bad"
  return $(result)
}
test.case $level "T-PATH-LOAD-OLD-PATHS-FILE: path load <file> reads an old ~/paths and path save keeps it" test.path.loadOldPathsFile
expect 0 "an old paths file loads and saves" "the one-time migration for test/mcdonges.latest users"

# T-PATH-EDIT-ROUNDTRIP: path edit saves the edited list; a bad line never reaches the file
test.path.editRoundtrip() {
  local fx bad="" got ed; fx=$(test.path.fixture.make pathedit) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  ed="$fx/editor"
  # the "editor": drop /bin, add bin2 and a directory that does not exist
  printf '%s\n' '#!/bin/sh' "sed -i.bak -e '/^\\/bin\$/d' \"\$1\"" "printf '%s\\n' '$fx/bin2' '$fx/nope' >> \"\$1\"" > "$ed"
  chmod +x "$ed"
  printf '%s\n' "export PATH=\"$fx/oosh:$fx/bin1:/usr/bin:/bin\"" > "$fx/.config/oosh/user.session.env"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" EDITOR="$ed"
    path.edit >/dev/null 2>&1 ) || bad="$bad rc=$?"
  got=$(test.path.fixture.saved "$fx")
  [ "$got" = "$fx/oosh:$fx/oosh/ng:$fx/bin1:/usr/bin:$fx/bin2" ] || bad="$bad saved=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the edited list was saved through the filter" || create.result 1 "edit:$bad"
  return $(result)
}
test.case $level "T-PATH-EDIT-ROUNDTRIP: path edit saves the edited list, the filter drops a missing directory" test.path.editRoundtrip
expect 0 "the edited list was saved through the filter" "no hand-written line reaches the env file"

# T-PATH-ALIASES: add/push append, put prepends, rm removes
test.path.aliases() {
  local fx bad="" saved="$PATH"; fx=$(test.path.fixture.make pathaliases) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  path.add "$fx/bin1" >/dev/null 2>&1;  [[ "$PATH" == *":$fx/bin1" ]] || bad="$bad add"
  path.push "$fx/bin2" >/dev/null 2>&1; [[ "$PATH" == *":$fx/bin2" ]] || bad="$bad push"
  path.put "$fx/bin1" >/dev/null 2>&1;  [[ "$PATH" == "$fx/bin1:"* ]] || bad="$bad put"
  path.rm "$fx/bin1" >/dev/null 2>&1;   [[ "$PATH" != *"$fx/bin1"* ]] || bad="$bad rm"
  export PATH="$saved"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the aliases reach append, prepend and remove" || create.result 1 "aliases:$bad"
  return $(result)
}
test.case $level "T-PATH-ALIASES: add and push append, put prepends, rm removes" test.path.aliases
expect 0 "the aliases reach append, prepend and remove" "the verbs people know from test/mcdonges.latest"

# T-PATH-SAVE-SURVIVES-LOGIN: a saved PATH is in the next shell, which reads only the files
test.path.saveSurvivesLogin() {
  local fx bad="" out; fx=$(test.path.fixture.make pathlogin) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  mkdir -p "$fx/extra"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin"
    path.append "$fx/extra" >/dev/null 2>&1; path.save >/dev/null 2>&1 )
  # An interactive bash from the .bashrc template in the fixture home; the
  # question comes as input, as a person types it (see T-BASHRC-LOG-ONCE).
  out=$(cd / && printf '%s\n' 'printf "\nRESULT %s\n" "$PATH"' 'exit' \
    | env -i OOSH_NO_INSTALL=1 HOME="$fx" PATH="/usr/bin:/bin" "$BASH" --rcfile "$OOSH_DIR/templates/user/bashrcTemplate" -i 2>/dev/null \
    | sed -n 's/^RESULT //p')
  case ":$out:" in *":$fx/extra:"*) ;; *) bad="$bad PATH=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the next shell carries the saved directory" || create.result 1 "login:$bad"
  return $(result)
}
test.case $level "T-PATH-SAVE-SURVIVES-LOGIN: a new interactive shell has the directory path save wrote" test.path.saveSurvivesLogin
expect 0 "the next shell carries the saved directory" "this is what the user wants from path save"


# T-PATH-LOAD-AWKWARD-DIRS: a directory with a space or an apostrophe survives load and edit
test.path.awkwardDirs() {
  local fx bad="" got ed d1 d2; fx=$(test.path.fixture.make pathawkward) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  d1="$fx/my dir"; d2="$fx/it's"; mkdir -p "$d1" "$d2"
  printf '%s\n' "$d1" "$d2" "/usr/bin" "/bin" > "$fx/paths"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" PATH="$fx/oosh:/usr/bin:/bin"
         path.load "$fx/paths" >/dev/null 2>&1; echo "$PATH" )
  [ "$got" = "$d1:$d2:/usr/bin:/bin" ] || bad="$bad load=[$got]"
  ed="$fx/editor"; printf '%s\n' '#!/bin/sh' "printf '%s\\n' '$d1' \"$d2\" /usr/bin /bin > \"\$1\"" > "$ed"; chmod +x "$ed"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" EDITOR="$ed"
    path.edit >/dev/null 2>&1 ) || bad="$bad edit-rc=$?"
  got=$(test.path.fixture.saved "$fx")
  [ "$got" = "$fx/oosh:$fx/oosh/ng:$d1:$d2:/usr/bin:/bin" ] || bad="$bad edit=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "space and apostrophe survive" || create.result 1 "awkward:$bad"
  return $(result)
}
test.case $level "T-PATH-LOAD-AWKWARD-DIRS: a directory with a space or an apostrophe survives path load and path edit" test.path.awkwardDirs
expect 0 "space and apostrophe survive" "line.join goes through xargs, which splits on blanks and dies on a quote"

# T-PATH-LOAD-REFUSES: nothing saved, no PATH line, or a file without a directory leaves PATH untouched
test.path.loadRefuses() {
  local fx bad="" got rc; fx=$(test.path.fixture.make pathloadrefuse) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  rm -f "$fx/.config/oosh/user.session.env"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" PATH="$fx/oosh:/usr/bin:/bin"
         path.load >/dev/null 2>&1; echo "$? $PATH" )
  [ "$got" = "1 $fx/oosh:/usr/bin:/bin" ] || bad="$bad no-file=[$got]"
  printf '%s\n' 'export OOSH_MODE="feature/x"' > "$fx/.config/oosh/user.session.env"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" PATH="$fx/oosh:/usr/bin:/bin"
         path.load >/dev/null 2>&1; echo "$? $PATH" )
  [ "$got" = "1 $fx/oosh:/usr/bin:/bin" ] || bad="$bad mode-only=[$got]"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" PATH="$fx/oosh:/usr/bin:/bin"
         path.saved 2>/dev/null )
  [ -z "$got" ] || bad="$bad saved-listed=[$got]"
  printf '%s\n' '.' 'rel/dir' '' > "$fx/empty"
  got=$( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" PATH="$fx/oosh:/usr/bin:/bin"
         path.load "$fx/empty" >/dev/null 2>&1; echo "$? $PATH" )
  [ "$got" = "1 $fx/oosh:/usr/bin:/bin" ] || bad="$bad dot-relative-only=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "path load refuses and keeps PATH" || create.result 1 "refuse:$bad"
  return $(result)
}
test.case $level "T-PATH-LOAD-REFUSES: no saved file, a file without a PATH line or without a usable directory leaves PATH unchanged" test.path.loadRefuses
expect 0 "path load refuses and keeps PATH" "the message went to stdout and became the PATH; a file without a PATH line echoed the inherited one"

# T-PATH-EDIT-GUARDS: an aborted editor and a list without a shell save nothing and leave no temp file
test.path.editGuards() {
  local fx bad="" got before after ed; fx=$(test.path.fixture.make pathedit2) && [ -n "$fx" ] || { create.result 1 "no fixture"; return $(result); }
  printf '%s\n' "export PATH=\"$fx/oosh:$fx/bin1:/usr/bin:/bin\"" > "$fx/.config/oosh/user.session.env"
  before=$(cksum < "$fx/.config/oosh/user.session.env")
  ed="$fx/abort"; printf '%s\n' '#!/bin/sh' "echo $fx/bin2 >> \"\$1\"" 'exit 1' > "$ed"; chmod +x "$ed"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" EDITOR="$ed"
    path.edit >/dev/null 2>&1 ) && bad="$bad abort-rc0"
  ed="$fx/noshell"; printf '%s\n' '#!/bin/sh' "printf '%s\\n' '$fx/bin1' > \"\$1\"" > "$ed"; chmod +x "$ed"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" EDITOR="$ed"
    path.edit >/dev/null 2>&1 ) && bad="$bad noshell-rc0"
  ( export HOME="$fx" CONFIG_PATH="$fx/config" CONFIG="$fx/config/user.env" TMPDIR="$fx" OOSH_MODE="feature/x" PATH="$fx/oosh:/usr/bin:/bin" EDITOR="$fx/no-such-editor"
    path.edit >/dev/null 2>&1 ) && bad="$bad missing-editor-rc0"
  after=$(cksum < "$fx/.config/oosh/user.session.env")
  [ "$before" = "$after" ] || bad="$bad file-changed"
  got=$(ls "$fx" | grep -c '^oosh.path.edit')
  [ "$got" = "0" ] || bad="$bad tmp-left=$got"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "edit refuses and cleans up" || create.result 1 "edit guards:$bad"
  return $(result)
}
test.case $level "T-PATH-EDIT-GUARDS: an aborted or missing editor and a list without a shell save nothing and leave no temp file" test.path.editGuards
expect 0 "edit refuses and cleans up" "a quit-without-saving editor must not save, and a list without /usr/bin breaks every new login"


### test.method

test.suite.save.results
