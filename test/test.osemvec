#!/usr/bin/env bash
# Tests for the osemvec script — semvec-guarded claudeCode provisioner.
#
# SAFETY: the suite NEVER runs `osemvec install` (heavy pip) and NEVER spawns a
# live claudeCode. The critical assertion is that `osemvec new` DEFAULTS to
# dry-run: it provisions files but leaves the pane count UNCHANGED. semvec/venv-
# dependent cases are skip-guarded. Project state is isolated under /tmp.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source osemvec

log.level $level

# ── Isolation ────────────────────────────────────────────────────────────────
TEST_ROOT="/tmp/test.osemvec.$$"
PROJ="$TEST_ROOT/proj"
mkdir -p "$PROJ"
cleanup_test_osemvec() { rm -rf "$TEST_ROOT" 2>/dev/null; }

# A real, resolvable role for the valid-path tests.
# Resolve a real role via osemvec's OWN canonical (cwd-independent, filtered)
# helper — so the suite is green from ANY clean cwd, not just the workspace.
VALID_ROLE=$(private.osemvec.knownRoles | grep -x 'oosh-expert' || private.osemvec.knownRoles | head -1)

# ============================================================================
# T1: .mcp.json template is valid JSON and points at the venv python
# ============================================================================
test.case - "T1: mcp.json template valid + venv python" \
  echo "checking"
MCP=$(private.osemvec.mcpJson /venv/py)
if echo "$MCP" | python3 -m json.tool >/dev/null 2>&1 && echo "$MCP" | grep -q '/venv/py'; then
  create.result 0 "valid mcp"
else
  create.result 1 "invalid mcp json"
fi
expect 0 "valid mcp" "mcp.json is valid JSON with the venv interpreter baked in"

# ============================================================================
# T2: settings.json valid + has SessionStart/PreCompact + PreToolUse guard
# ============================================================================
test.case - "T2: settings.json valid + guard wired" \
  echo "checking"
SET=$(private.osemvec.settingsJson /venv/py)
if echo "$SET" | python3 -m json.tool >/dev/null 2>&1 \
   && echo "$SET" | grep -q 'SessionStart' \
   && echo "$SET" | grep -q 'PreCompact' \
   && echo "$SET" | grep -q 'PreToolUse'; then
  create.result 0 "valid settings"
else
  create.result 1 "settings missing hooks or invalid"
fi
expect 0 "valid settings" "settings.json valid with SessionStart/PreCompact + PreToolUse guard"

# ============================================================================
# T3: venvPython path composition honors OPY_VENVS + venv name
# ============================================================================
test.case - "T3: venvPython honors OPY_VENVS" \
  echo "checking"
EXPECT_PY="${OPY_VENVS:-$HOME/.opy/venvs}/$(private.osemvec.venvName)/bin/python"
if [ "$(private.osemvec.venvPython)" = "$EXPECT_PY" ]; then
  create.result 0 "path ok"
else
  create.result 1 "got: $(private.osemvec.venvPython)"
fi
expect 0 "path ok" "venvPython is deterministic from OPY_VENVS"

# ============================================================================
# T4: check → allow (exit 0) even when semvec absent (fail-open, never bricks)
# ============================================================================
test.case - "T4: check fails open to allow" \
  osemvec.check "$PROJ"
create.result "$RETURN_VALUE" "allow"
expect 0 "allow" "check returns allow (0) when guard infra absent"

# ============================================================================
# T5: SAFETY — new DEFAULTS to dry-run: provisions but does NOT spawn a pane
# ============================================================================
PANES_BEFORE=$(tmux list-panes -a 2>/dev/null | wc -l | tr -d ' ')
test.case - "T5: new (no policy) is dry-run" \
  osemvec.new "$VALID_ROLE" "$PROJ"
NEW_RC="$RETURN_VALUE"
PANES_AFTER=$(tmux list-panes -a 2>/dev/null | wc -l | tr -d ' ')
if [ "$NEW_RC" -eq 0 ] && [ "$PANES_BEFORE" = "$PANES_AFTER" ] \
   && [ -f "$PROJ/.mcp.json" ] && [ -f "$PROJ/.claude/settings.json" ]; then
  create.result 0 "dry-run provisioned"
else
  create.result 1 "rc=$NEW_RC panes $PANES_BEFORE->$PANES_AFTER"
fi
expect 0 "dry-run provisioned" "new defaults to dry-run: files staged, NO live spawn"

# ============================================================================
# T6: provisioned settings.json is valid + carries the PreToolUse guard
# ============================================================================
test.case - "T6: provisioned settings valid + guarded" \
  echo "checking"
if python3 -m json.tool "$PROJ/.claude/settings.json" >/dev/null 2>&1 \
   && grep -q 'PreToolUse' "$PROJ/.claude/settings.json"; then
  create.result 0 "guarded"
else
  create.result 1 "bad provisioned settings"
fi
expect 0 "guarded" "provisioned project carries a valid guarded settings.json"

# ============================================================================
# T7: new rejects an unknown role (when the registry lists roles)
# ============================================================================
if [ -n "$(hiveMind role.list 2>/dev/null | head -1)" ]; then
  test.case - "T7: new rejects unknown role" \
    osemvec.new not_a_real_role_xyz "$PROJ"
  [ "$RETURN_VALUE" -ne 0 ] && create.result 0 "rejected" || create.result 1 "should reject"
  expect 0 "rejected" "new rejects an unknown role"
else
  important.log "SKIP T7 — hiveMind role.list empty on this host"
fi

# ============================================================================
# T8: new rejects a malformed role name
# ============================================================================
test.case - "T8: new rejects malformed role" \
  osemvec.new "9 bad name" "$PROJ"
[ "$RETURN_VALUE" -ne 0 ] && create.result 0 "rejected" || create.result 1 "should reject"
expect 0 "rejected" "new rejects a malformed role"

# ============================================================================
# T9: new rejects a missing projectDir
# ============================================================================
test.case - "T9: new rejects missing projectDir" \
  osemvec.new "$VALID_ROLE" "$TEST_ROOT/does-not-exist"
[ "$RETURN_VALUE" -ne 0 ] && create.result 0 "rejected" || create.result 1 "should reject"
expect 0 "rejected" "new rejects a missing projectDir"

# ============================================================================
# T10: guard rejects a non-pane target (human error, non-zero)
# ============================================================================
test.case - "T10: guard rejects non-pane target" \
  osemvec.guard "not-a-pane"
[ "$RETURN_VALUE" -ne 0 ] && create.result 0 "rejected" || create.result 1 "should reject"
expect 0 "rejected" "guard rejects a non-pane target"

# ============================================================================
# T11: index rejects a missing directory
# ============================================================================
test.case - "T11: index rejects missing dir" \
  osemvec.index "$TEST_ROOT/nope"
[ "$RETURN_VALUE" -ne 0 ] && create.result 0 "rejected" || create.result 1 "should reject"
expect 0 "rejected" "index rejects a missing directory"

# ============================================================================
# T12: status runs and reports health (venv NOT BUILT in test env)
# ============================================================================
test.case - "T12: status runs" \
  osemvec.status
create.result "$RETURN_VALUE" "ran"
expect 0 "ran" "status succeeds and reports semvec health"

# ── semvec/venv-dependent (skip-guarded) ─────────────────────────────────────
# Precondition matches what osemvec.index actually REQUIRES: not just a runnable
# venv python (venvReady), but semvec importable in it — a half-installed venv
# would otherwise FALSE-FAIL this case. index is cheap + hermetic here: it only
# mkdir's "$PROJ/.semvec" (inside the isolated TEST_ROOT, removed by teardown);
# the heavy ~9s-embedder path is private.osemvec.pss, which this case never hits.
# Deliberately NOT isolating OPY_VENVS — index writes nothing into the venv, so
# reusing the real venv gives genuine coverage at zero pollution cost.
OSV_PY="$(private.osemvec.venvPython)"
if private.osemvec.venvReady && [ -x "$OSV_PY" ] && "$OSV_PY" -c 'import semvec' >/dev/null 2>&1; then
  test.case - "T13: index builds when venv present" \
    osemvec.index "$PROJ"
  create.result "$RETURN_VALUE" "indexed"
  expect 0 "indexed" "index succeeds with a built (semvec-ready) venv"
else
  important.log "SKIP T13 — osemvec venv/semvec not ready (run 'osemvec install')"
fi

# ============================================================================
# ── Tasks 23-25: running-instance inventory (list) + lifecycle stop ──────────
# Hermetic: NO real serve start, NO real kill. Assert discovery parse + the stop
# auth-gate defaults to dry-run + ownership verification refuses others' procs.
# ============================================================================

# T14: list (human table) is read-only and succeeds
test.case - "T14: osemvec.list runs" \
  osemvec.list
create.result "$RETURN_VALUE" "ran"
expect 0 "ran" "list is read-only and succeeds"

# T14b (task 26): osemvec.list renders a human-readable header row
test.case - "T14b: osemvec.list renders headers/columns" \
  echo "checking"
HDR=$(osemvec.list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')
if echo "$HDR" | grep -q 'TYPE' && echo "$HDR" | grep -q 'PID' && echo "$HDR" | grep -q 'STATUS'; then
  create.result 0 "table"
else
  create.result 1 "no header row"
fi
expect 0 "table" "list renders an aligned table with TYPE/PID/STATUS headers"

# T15 (task 26): osemvec.list.raw keeps the EXACT pipe format (machine consumers)
test.case - "T15: osemvec.list.raw is pipe-delimited" \
  echo "checking"
BAD=$(osemvec.list.raw 2>/dev/null | grep -vE '^(serve|guarded)\|' | grep -v '^$' | head -1)
[ -z "$BAD" ] && create.result 0 "well-formed" || create.result 1 "bad line: $BAD"
expect 0 "well-formed" "list.raw emits only serve|/guarded| pipe lines"

# T16 (skip-guard): a live serve server parses to a numeric port via list.raw
if pgrep -f 'semvec\.api\.cli serve' >/dev/null 2>&1; then
  test.case - "T16: serve discovery parses pid+port" \
    echo "checking"
  SPORT=$(osemvec.list.raw 2>/dev/null | awk -F'|' '$1=="serve"{print $3;exit}')
  case "$SPORT" in ''|*[!0-9]*) create.result 1 "bad port: $SPORT" ;; *) create.result 0 "parsed" ;; esac
  expect 0 "parsed" "serve discovery yields a numeric port"
  # T16b (task 26): stop completion still resolves the target from raw
  test.case - "T16b: stop.completion resolves via raw" \
    echo "checking"
  if osemvec.stop.completion.target 2>/dev/null | grep -qx "$SPORT"; then
    create.result 0 "resolves"
  else
    create.result 1 "completion lost the target"
  fi
  expect 0 "resolves" "stop.completion still resolves targets after the table change"
else
  important.log "SKIP T16/T16b — no live semvec serve server to discover"
fi

# T17: stop with no target → usage (non-zero), no kill
test.case - "T17: stop requires a target" \
  osemvec.stop
[ "$RETURN_VALUE" -ne 0 ] && create.result 0 "usage" || create.result 1 "should fail"
expect 0 "usage" "stop requires <target>"

# T18: stop bogus target → error (no match, nothing killed)
test.case - "T18: stop bogus target errors" \
  osemvec.stop no-such-target-zzz
[ "$RETURN_VALUE" -ne 0 ] && create.result 0 "no match" || create.result 1 "should fail"
expect 0 "no match" "stop rejects an unknown target without killing anything"

# T19: guarded-instance stop is auth-gated — DEFAULTS to refuse (=> dry-run)
test.case - "T19: stop auth-gate default-refuse" \
  echo "checking"
if ! private.osemvec.stopAuthorized "" && private.osemvec.stopAuthorized authorized; then
  create.result 0 "gated"
else
  create.result 1 "auth gate wrong"
fi
expect 0 "gated" "stop of a guarded instance is auth-gated (default dry-run)"

# T20: ownership verification never signals a process the user does not own
if [ "$(id -u)" -ne 0 ]; then
  test.case - "T20: ownsProcess guards by uid" \
    echo "checking"
  if private.osemvec.ownsProcess $$ && ! private.osemvec.ownsProcess 1; then
    create.result 0 "owned-only"
  else
    create.result 1 "ownership check wrong"
  fi
  expect 0 "owned-only" "stop only ever signals user-owned processes"
else
  important.log "SKIP T20 — running as root, uid ownership check is trivial"
fi

# ── Teardown ─────────────────────────────────────────────────────────────────
cleanup_test_osemvec

test.suite.save.results
