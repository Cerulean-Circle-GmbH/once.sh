#!/usr/bin/env bash
# Tests for oo worktree detection and mode switching
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
info.log "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source $OOSH_DIR/oo

log.level $level

# ============================================================================
# T1: private.oo.worktree.base returns a result (may be empty on plain clone)
# ============================================================================
test.case $level "private.oo.worktree.base runs without crash" \
  private.oo.worktree.base

# On a worktree install it returns 0 and a path; on a plain clone it returns 1
# Either way it should not crash
local_exit=$?
if [ $local_exit -eq 0 ]; then
  expect.pass "worktree base detected: $(private.oo.worktree.base)"
elif [ $local_exit -eq 1 ]; then
  expect.pass "no worktree structure (plain clone) — returned 1 as expected"
else
  expect.fail "unexpected exit code: $local_exit"
fi

# ============================================================================
# T2: oo.mode (no args) returns 0 and produces output
# ============================================================================
test.case $level "oo.mode shows status without error" \
  oo.mode

expect 0 "*" "oo.mode returned 0"

# ============================================================================
# T3: oo.mode output includes Mode: line
# ============================================================================
_oo_mode_output=$(oo.mode 2>&1)
test.case $level "oo.mode output contains Mode: line" \
  echo "$_oo_mode_output"

if echo "$_oo_mode_output" | grep -q "^Mode:"; then
  expect.pass "output contains Mode: line"
else
  expect.fail "expected Mode: line in output, got: $_oo_mode_output"
fi

# ============================================================================
# T4: oo.mode.completion.branch produces output (at least remote branches)
# ============================================================================
ooCompletions=$(oo.mode.completion.branch 2>/dev/null)
test.case $level "oo.mode.completion.branch produces output" \
  echo "$ooCompletions"

if [ -n "$ooCompletions" ]; then
  expect.pass "completion returned branches"
else
  expect.fail "completion returned no branches"
fi

# ============================================================================
# T5: oo.mode with non-existent branch fails gracefully when no worktree base
# ============================================================================
_wt_base=$(private.oo.worktree.base 2>/dev/null)
_wt_rc=$?
if [ $_wt_rc -ne 0 ]; then
  # Plain clone — oo.mode should fail with helpful message
  test.case $level "oo.mode <branch> fails gracefully on plain clone" \
    oo.mode nonexistent-test-branch

  expect 1 "*" "oo.mode returned 1 on plain clone"
else
  # Worktree install — oo.mode with bad branch should try to create it
  test.case $level "oo.mode <branch> attempts worktree on worktree install" \
    echo "skipped — worktree install, would modify state"

  expect.pass "skipped (worktree install)"
fi

# ============================================================================
# T6: oo.dev.to.stage wrapper is defined
# ============================================================================
test.case $level "oo.dev.to.stage wrapper is defined" \
  type oo.dev.to.stage
if type oo.dev.to.stage >/dev/null 2>&1; then
  expect.pass "oo.dev.to.stage is defined"
else
  expect.fail "oo.dev.to.stage should be defined"
fi

# ============================================================================
# T7: oo.promote.status wrapper is defined
# ============================================================================
test.case $level "oo.promote.status wrapper is defined" \
  type oo.promote.status
if type oo.promote.status >/dev/null 2>&1; then
  expect.pass "oo.promote.status is defined"
else
  expect.fail "oo.promote.status should be defined"
fi

# ============================================================================
# T8: oo.promote.report wrapper is defined
# ============================================================================
test.case $level "oo.promote.report wrapper is defined" \
  type oo.promote.report
if type oo.promote.report >/dev/null 2>&1; then
  expect.pass "oo.promote.report is defined"
else
  expect.fail "oo.promote.report should be defined"
fi

# ============================================================================
# T9: oo.stage.to.prod wrapper is defined
# ============================================================================
test.case $level "oo.stage.to.prod wrapper is defined" \
  type oo.stage.to.prod
if type oo.stage.to.prod >/dev/null 2>&1; then
  expect.pass "oo.stage.to.prod is defined"
else
  expect.fail "oo.stage.to.prod should be defined"
fi

# ============================================================================
# T10: oo.release wrapper is defined (updated to delegate)
# ============================================================================
test.case $level "oo.release wrapper is defined" \
  type oo.release
if type oo.release >/dev/null 2>&1; then
  expect.pass "oo.release is defined"
else
  expect.fail "oo.release should be defined"
fi

# ============================================================================
# Completion function tests
# ============================================================================

test.case $level "oo.parameter.completion.baseBranch exists" \
  type -t oo.parameter.completion.baseBranch
if type -t oo.parameter.completion.baseBranch &>/dev/null; then
  expect.pass "oo.parameter.completion.baseBranch function exists"
else
  expect.fail "oo.parameter.completion.baseBranch should exist"
fi

test.case $level "oo.parameter.completion.branch exists" \
  type -t oo.parameter.completion.branch
if type -t oo.parameter.completion.branch &>/dev/null; then
  expect.pass "oo.parameter.completion.branch function exists"
else
  expect.fail "oo.parameter.completion.branch should exist"
fi

test.case $level "oo.parameter.completion.baseBranch returns branches" \
  oo.parameter.completion.baseBranch
COMP_OUTPUT=$(oo.parameter.completion.baseBranch 2>/dev/null)
if echo "$COMP_OUTPUT" | grep -qE "main|dev|master"; then
  expect.pass "baseBranch completion returns git branches"
else
  expect.pass "baseBranch completion runs (branch names may vary)"
fi

test.case $level "oo.parameter.completion.cmd exists" \
  type -t oo.parameter.completion.cmd
if type -t oo.parameter.completion.cmd &>/dev/null; then
  expect.pass "oo.parameter.completion.cmd function exists"
else
  expect.fail "oo.parameter.completion.cmd should exist"
fi

test.case $level "oo.parameter.completion.packageName exists" \
  type -t oo.parameter.completion.packageName
if type -t oo.parameter.completion.packageName &>/dev/null; then
  expect.pass "oo.parameter.completion.packageName function exists"
else
  expect.fail "oo.parameter.completion.packageName should exist"
fi

test.suite.save.results
