# ============================================================================
# T-SHIM-5..8: findLatest edge cases (own fixture, ooShim already sourced above)
# ============================================================================

SHIM_FIXTURE="/tmp/test.oo.shim.$$"
SAVE_SHIM_HOME="$HOME"

# ============================================================================
# T-SHIM-5: findLatest picks most recently modified git dir
# ============================================================================
test.oo.shim.mostRecent() {
  mkdir -p "$SHIM_FIXTURE/base/main" "$SHIM_FIXTURE/base/older" "$SHIM_FIXTURE/base/newer"
  git init "$SHIM_FIXTURE/base/older" >/dev/null 2>&1
  git init "$SHIM_FIXTURE/base/main"  >/dev/null 2>&1
  git init "$SHIM_FIXTURE/base/newer" >/dev/null 2>&1
  # Make older/ the oldest by mtime
  touch -t 202501010000 "$SHIM_FIXTURE/base/older"
  # Make newer/ the most recent
  sleep 1
  touch "$SHIM_FIXTURE/base/newer"

  HOME="$SHIM_FIXTURE/base"
  # Create oosh symlink pointing into the base so dirname resolves to base/
  ln -sf "$SHIM_FIXTURE/base/main" "$SHIM_FIXTURE/base/oosh"

  local result
  result=$(private.oo.shim.findLatest)
  HOME="$SAVE_SHIM_HOME"

  local name
  name=$(basename "$result")
  if [ "$name" = "newer" ]; then
    create.result 0 "$name"
  else
    create.result 1 "expected newer got $name"
  fi
}
test.case - "T-SHIM-5: findLatest picks most recently modified git dir" \
  test.oo.shim.mostRecent
expect 0 "newer" "findLatest returns the most recently modified git directory"
rm -rf "$SHIM_FIXTURE"

# ============================================================================
# T-SHIM-6: findLatest returns ooshReal when no valid dirs
# ============================================================================
test.oo.shim.noValidDirs() {
  mkdir -p "$SHIM_FIXTURE/base/main" "$SHIM_FIXTURE/base/dirA" "$SHIM_FIXTURE/base/dirB"
  # main/ exists so the loop runs, but no dir has .git
  ln -sf "$SHIM_FIXTURE/base/main" "$SHIM_FIXTURE/base/oosh"
  HOME="$SHIM_FIXTURE/base"

  local result
  result=$(private.oo.shim.findLatest)
  HOME="$SAVE_SHIM_HOME"

  # Should fall back to ooshReal (resolved symlink target = base/main)
  if [ "$result" = "$SHIM_FIXTURE/base/main" ]; then
    create.result 0 "$result"
  else
    create.result 1 "expected $SHIM_FIXTURE/base/main got $result"
  fi
}
test.case - "T-SHIM-6: findLatest returns ooshReal when no valid dirs" \
  test.oo.shim.noValidDirs
expect 0 "*" "findLatest falls back to ooshReal when no .git dirs found"
rm -rf "$SHIM_FIXTURE"

# ============================================================================
# T-SHIM-7: findLatest skips dirs without .git
# ============================================================================
test.oo.shim.skipNonGit() {
  mkdir -p "$SHIM_FIXTURE/base/main" "$SHIM_FIXTURE/base/nogit" "$SHIM_FIXTURE/base/hasgit"
  git init "$SHIM_FIXTURE/base/main"   >/dev/null 2>&1
  git init "$SHIM_FIXTURE/base/hasgit" >/dev/null 2>&1
  # nogit has no .git — make it the newest to prove it gets skipped
  sleep 1
  touch "$SHIM_FIXTURE/base/nogit"

  ln -sf "$SHIM_FIXTURE/base/main" "$SHIM_FIXTURE/base/oosh"
  HOME="$SHIM_FIXTURE/base"

  local result
  result=$(private.oo.shim.findLatest)
  HOME="$SAVE_SHIM_HOME"

  local name
  name=$(basename "$result")
  # Should be hasgit or main, never nogit
  if [ "$name" = "hasgit" ] || [ "$name" = "main" ]; then
    create.result 0 "$name"
  else
    create.result 1 "expected hasgit or main, got $name"
  fi
}
test.case - "T-SHIM-7: findLatest skips dirs without .git" \
  test.oo.shim.skipNonGit
expect 0 "*" "findLatest only returns directories containing .git"
rm -rf "$SHIM_FIXTURE"

# T-SHIM-SPACE-IN-BASE: findLatest keeps a base path with a space whole
# The loop was `for dir in $(ls -dt "$base"/*/)`: a base like
# "/Users/x/My Components/Once.sh" (common on macOS) split into words, and no
# folder matched. A glob loop with -nt keeps the newest-folder choice.
test.oo.shim.spaceInBase() {
  local fx base result
  fx=$(test.suite.fixture.make shimspace); base="$fx/my base"
  mkdir -p "$base/main/.git" "$base/older/.git" "$base/newer/.git"
  touch -t 202001010000 "$base/main" "$base/older"; touch -t 202101010000 "$base/newer"
  ln -s "$base/main" "$fx/oosh"
  result=$(HOME="$fx" private.oo.shim.findLatest)
  rm -rf "$fx"
  [ "$result" = "$base/newer" ] && create.result 0 "newer" || create.result 1 "expected $base/newer got [$result]"
  return $(result)
}
test.case - "T-SHIM-SPACE-IN-BASE: findLatest picks the newest folder of a base with a space" \
  test.oo.shim.spaceInBase
expect 0 "newer" "a base path with a space split into words"

# ============================================================================
# T-SHIM-8 retired (2026-09-28): the OOSH_WORKTREE_BASE fallback is gone with the
# worktree layout — the clone layout always has main/ (T-SHIM-4 covers no main/).

# ============================================================================
# T-SETUP-1..4: oo.mode.setup tests
# ============================================================================

SETUP_FIXTURE="/tmp/test.oo.setup.$$"
# Canonicalised for the same reason as MODE_FIXTURE above: on macOS /tmp is a
# symlink, so a resolved path never equals this literal. No-op on Linux.
mkdir -p "$SETUP_FIXTURE"
SETUP_FIXTURE=$(private.this.path.canonical "$SETUP_FIXTURE")
SAVE_SETUP_OOSH_DIR="$OOSH_DIR"
SAVE_SETUP_OOSH_MODE="$OOSH_MODE"
SAVE_SETUP_OOSH_COMPONENTS_DIR="$OOSH_COMPONENTS_DIR"
SAVE_SETUP_PATH="$PATH"
SAVE_SETUP_HOME="$HOME"

# ============================================================================
# T-SETUP-1: oo.mode.setup function exists
# ============================================================================
test.oo.setup.functionExists() {
  if type -t oo.mode.setup &>/dev/null; then
    create.result 0 "oo.mode.setup is defined"
  else
    create.result 1 "oo.mode.setup not found"
  fi
  return $(result)
}
test.case - "T-SETUP-1: oo.mode.setup function exists" \
  test.oo.setup.functionExists
expect 0 "oo.mode.setup is defined" "oo.mode.setup function exists"

# ============================================================================
# T-SETUP-2: mode.setup refuses a directory with no branch
# ============================================================================
# This used to be called "rejects non-git directory" and mode.setup had no git
# check — the rc 1 it saw came from the empty-branch path, so any unrelated
# future rc-1 kept it green. It also used `expect 1 "*"`, which is vacuous, and
# an `expect.error 1` that is inert here (that sets EXPECTED_RETURN_VALUE for
# the onError trap, while test.case keys on TEST_EXPECTING_ERROR). The rewrite
# gives the refusal a real RESULT, so both halves of the assertion now bite.
test.oo.setup.nonGit() {
  mkdir -p "$SETUP_FIXTURE/nogit"
  export OOSH_DIR="$SETUP_FIXTURE/nogit"
  export OOSH_COMPONENTS_DIR="$SETUP_FIXTURE"
  oo.mode.setup "$SETUP_FIXTURE" >/dev/null 2>&1
  return $(result)
}
test.case - "T-SETUP-2: mode.setup refuses a directory with no detectable branch" \
  test.oo.setup.nonGit
expect 1 "no branch detected in $SETUP_FIXTURE/nogit" "a plain directory is not a clone, and the refusal says so"
rm -rf "$SETUP_FIXTURE"
export OOSH_DIR="$SAVE_SETUP_OOSH_DIR"
export OOSH_MODE="$SAVE_SETUP_OOSH_MODE"
export OOSH_COMPONENTS_DIR="$SAVE_SETUP_OOSH_COMPONENTS_DIR"
export PATH="$SAVE_SETUP_PATH"

# ============================================================================
# T-SETUP-3: mode.setup detects an already-canonical layout
# ============================================================================
# The fixture is the CANONICAL shape: main/ and the branch folder, both real
# clones (test.oo.base). Done means BOTH — main/ alone is a run whose branch
# clone failed (T-SETUP-SAFE-SWAP); the fixture before that was a bare
# `mkdir base/main/.git base/dev`.
test.oo.setup.alreadyExists() {
  local base; base=$(test.oo.base test.oo.setup.exists clone) || { create.result 1 "fixture failed"; return $(result); }
  export OOSH_DIR="$base/dev"
  export OOSH_COMPONENTS_DIR="$base"
  local output
  output=$(oo.mode.setup "$base" 2>&1)
  local rc=$?
  rm -rf "${base%/*}"
  if [ $rc -eq 0 ] && echo "$output" | grep -qi "already exists"; then
    create.result 0 "already exists detected"
  else
    create.result 1 "rc=$rc output=$output"
  fi
  return $(result)
}
test.case - "T-SETUP-3: mode.setup detects an already-canonical layout" \
  test.oo.setup.alreadyExists
expect 0 "already exists detected" "the guard is main/ with a real .git, not any subdir holding one"
rm -rf "$SETUP_FIXTURE"
export OOSH_DIR="$SAVE_SETUP_OOSH_DIR"
export OOSH_MODE="$SAVE_SETUP_OOSH_MODE"
export OOSH_COMPONENTS_DIR="$SAVE_SETUP_OOSH_COMPONENTS_DIR"
export PATH="$SAVE_SETUP_PATH"
config save oosh OOSH 2>/dev/null

# ============================================================================
# T-SETUP-4: the acceptance criterion — a converted clone is DETECTABLE
# ============================================================================
# The old post-condition was `[ -d "$BASE_DIR/dev" ]`, which a bare `mkdir`
# would satisfy. It never checked the one thing the ticket is about: that
# oo.mode.base.get can find the base afterwards in a shell with no
# OOSH_COMPONENTS_DIR — which is every shell but the one that ran setup.
# It also ran the SUT inside $( ), hiding its exports.
test.oo.setup.producesDetectableLayout() {
  local BASE_DIR="$SETUP_FIXTURE/base"
  local CLONE_DIR="$BASE_DIR/oosh-clone"
  mkdir -p "$BASE_DIR"
  git init --initial-branch=main -q "$CLONE_DIR" >/dev/null 2>&1
  # Pushed, with upstreams: the source is consumed only after ogit's gate
  # (T-SETUP-SOURCE-GATE), and a clone with no origin would be refused.
  git init -q --bare -b main "$SETUP_FIXTURE/origin.git" >/dev/null 2>&1
  (
    cd "$CLONE_DIR"
    git config user.email "test@test.local"
    git config user.name "test"
    git commit --allow-empty -q -m init
    git remote add origin "$SETUP_FIXTURE/origin.git"
    git push -q -u origin main
    git checkout -q -b dev
    git push -q -u origin dev
  ) >/dev/null 2>&1

  export OOSH_DIR="$CLONE_DIR"
  export OOSH_COMPONENTS_DIR=""
  HOME="$BASE_DIR"
  ln -sfn "$CLONE_DIR" "$BASE_DIR/oosh"

  oo.mode.setup "$BASE_DIR" >/dev/null 2>&1
  local rc=$?
  HOME="$SAVE_SETUP_HOME"

  # The base as a shell WITHOUT OOSH_COMPONENTS_DIR would resolve it.
  local detected
  detected=$( unset OOSH_COMPONENTS_DIR; OOSH_DIR="$BASE_DIR/dev"; oo.mode.base.get 2>/dev/null )

  if [ "$rc" -ne 0 ]; then
    create.result 1 "mode.setup returned $rc"
  elif [ ! -d "$BASE_DIR/main/.git" ]; then
    create.result 1 "main/ is not a repository"
  elif [ ! -d "$BASE_DIR/dev/.git" ]; then
    create.result 1 "dev/ is not an independent clone (.git is not a directory)"
  elif [ -e "$CLONE_DIR" ]; then
    create.result 1 "the original clone is still there"
  elif [ "$(readlink "$BASE_DIR/oosh")" != "$BASE_DIR/dev" ]; then
    create.result 1 "the symlink points at $(readlink "$BASE_DIR/oosh")"
  elif [ "$detected" != "$BASE_DIR" ]; then
    create.result 1 "base.get without OOSH_COMPONENTS_DIR returned '${detected:-nothing}'"
  else
    create.result 0 "detectable layout"
  fi
  return $(result)
}
test.case - "T-SETUP-4: a converted clone is canonical, consumed, linked and DETECTABLE" \
  test.oo.setup.producesDetectableLayout
expect 0 "detectable layout" "the point of the ticket: oo.mode.base.get must find the base in a shell that has no OOSH_COMPONENTS_DIR"

# ============================================================================
# T-SETUP-SAFE-SWAP: oo mode.setup never leaves ~/oosh dangling
# ============================================================================
# private.oo.shared.tree.from.local (consume=yes) copied the source to main/,
# removed the source — the tree ~/oosh points at — and only THEN cloned the
# branch folder. A failed clone left ~/oosh dangling, and the fast path
# ("main/.git exists → already set up") hid it on every re-run. Fixture HOME,
# a local bare origin; ogit.repo.clone is a recording stand-in that fails while
# FAIL_CLONE is set and otherwise runs the real clone.
test.oo.setupSafeSwap.run() { # <home> <failClone:yes|no> # run oo.mode.setup <base> in a pinned child shell; echo its rc
  local home="$1" fail="$2"
  (
    private.this.script.load ogit ogit.branch.get
    eval "test.oo.realRepoClone() $(declare -f ogit.repo.clone | tail -n +2)"
    ogit.repo.clone() {
      echo "$*" >> "$TEST_OO_SWAP_FX/clone.calls"
      if [ "$TEST_OO_SWAP_FAIL" = yes ]; then create.result 1 "clone failed (stand-in)"; return 1; fi
      test.oo.realRepoClone "$@"
    }
    HOME="$home"; GIT_CONFIG_GLOBAL="$home/.gitconfig"; TEST_OO_SWAP_FAIL="$fail"
    export HOME GIT_CONFIG_GLOBAL
    unset OOSH_COMPONENTS_DIR
    OOSH_DIR="$home/oosh"
    oo.mode.setup "$TEST_OO_SWAP_FX/layout" >/dev/null 2>&1
    echo "$?"
  )
}
test.oo.setupSafeSwap() {
  local origin fx home lay bad="" rc calls; origin=$(test.oo.base test.oo.setup.swap clone) || { create.result 1 "fixture failed"; return $(result); }
  fx="${origin%/*}"; home="$fx/home"; lay="$fx/layout"; mkdir -p "$home" "$lay"
  git clone -q -b dev "$fx/origin.git" "$lay/oosh-clone" >/dev/null 2>&1
  ln -s "$lay/oosh-clone" "$home/oosh"
  TEST_OO_SWAP_FX="$fx"
  # (a) the branch clone fails: the source is still there and ~/oosh resolves
  rc=$(test.oo.setupSafeSwap.run "$home" yes)
  [ "$rc" != 0 ] || bad="$bad failed-run-rc0"
  [ -d "$lay/oosh-clone/.git" ] || bad="$bad source-gone"
  [ -d "$home/oosh/.git" ] || bad="$bad oosh-dangling"
  # (b) a re-run with a working clone completes the layout
  rc=$(test.oo.setupSafeSwap.run "$home" no)
  [ "$rc" = 0 ] || bad="$bad rerun-rc=$rc"
  [ -d "$lay/main/.git" ] && [ -d "$lay/dev/.git" ] || bad="$bad layout-incomplete=[$(ls "$lay" | tr '\n' ' ')]"
  [ "$(readlink "$home/oosh")" = "$lay/dev" ] || bad="$bad link=[$(readlink "$home/oosh")]"
  [ -e "$lay/oosh-clone" ] && bad="$bad source-kept"
  # (c) a second complete run changes nothing: no clone, same link, rc 0
  calls=$(grep -c . "$fx/clone.calls" 2>/dev/null)
  rc=$(test.oo.setupSafeSwap.run "$home" no)
  [ "$rc" = 0 ] || bad="$bad third-rc=$rc"
  [ "$(grep -c . "$fx/clone.calls" 2>/dev/null)" = "$calls" ] || bad="$bad third-cloned"
  [ "$(readlink "$home/oosh")" = "$lay/dev" ] || bad="$bad third-link=[$(readlink "$home/oosh")]"
  unset TEST_OO_SWAP_FX
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a failed branch clone keeps the source; a re-run completes; a third run changes nothing" || create.result 1 "mode.setup:$bad"
  return $(result)
}
test.case $level "T-SETUP-SAFE-SWAP: oo mode.setup never leaves ~/oosh dangling, and a re-run finishes a half-made layout" test.oo.setupSafeSwap
expect 0 "a failed branch clone keeps the source; a re-run completes; a third run changes nothing" \
  "the source was removed before the branch clone, and the fast path hid the failure"

# ============================================================================
# T-SETUP-LAYOUT-EXISTS / T-SETUP-SOURCE-GATE: mode.setup never deletes a layout folder
# ============================================================================
# "Already set up" keyed on the BRANCH checked out in ~/oosh's folder: a
# finished layout with branch hotfix checked out inside prod/ missed it, cloned
# hotfix/ and then consumed — rm -rf — prod/ with its uncommitted work. A
# detached HEAD refused, and an older linked-worktree layout (.git is a FILE)
# was redone on every run. A plain source tree was consumed without the gate
# ogit owns for exactly that (stash, unpushed commits). Fixture HOME and base,
# a local bare origin; ogit.repo.clone and ogit.folder.finish are recording
# wrappers that run the real methods.
test.oo.setupLayout.run() { # <home> <base> # run oo.mode.setup <base> in a pinned child shell; RESULT into $TEST_OO_LAYOUT_FX/result; echo its rc
  local home="$1" base="$2"
  (
    private.this.script.load ogit ogit.branch.get
    eval "test.oo.realRepoClone() $(declare -f ogit.repo.clone | tail -n +2)"
    eval "test.oo.realFolderFinish() $(declare -f ogit.folder.finish | tail -n +2)"
    ogit.repo.clone() { echo "$*" >> "$TEST_OO_LAYOUT_FX/clone.calls"; test.oo.realRepoClone "$@"; }
    ogit.folder.finish() { echo "$*" >> "$TEST_OO_LAYOUT_FX/finish.calls"; test.oo.realFolderFinish "$@"; }
    HOME="$home"; GIT_CONFIG_GLOBAL="$home/.gitconfig"
    export HOME GIT_CONFIG_GLOBAL
    unset OOSH_COMPONENTS_DIR
    OOSH_DIR="$home/oosh"
    oo.mode.setup "$base" >/dev/null 2>&1
    local rc=$?
    echo "$RESULT" > "$TEST_OO_LAYOUT_FX/result"
    echo "$rc"
  )
}
test.oo.setupLayout.case() { # <label> <shape:clone|worktree> <folder> <prepare> # build a layout, point a fixture ~/oosh at <base>/<folder>, run <prepare> <base>/<folder>, run mode.setup; echo the problems found
  local base fx home rc bad=""
  base=$(test.oo.base "test.oo.setup.$1" "$2") || { echo " fixture-failed"; return 0; }
  fx="${base%/*}"; home="$fx/home"; mkdir -p "$home"
  ln -s "$base/$3" "$home/oosh"
  "$4" "$base/$3" "$base"
  printf 'work\n' > "$base/$3/work.txt"
  TEST_OO_LAYOUT_FX="$fx"
  rc=$(test.oo.setupLayout.run "$home" "$base")
  [ "$rc" = 0 ] || bad="$bad $1:rc=$rc[$(cat "$fx/result")]"
  [ -f "$base/$3/work.txt" ] || bad="$bad $1:$3-or-its-work-gone"
  [ "$(readlink "$home/oosh")" = "$base/$3" ] || bad="$bad $1:link=[$(readlink "$home/oosh")]"
  [ -s "$fx/clone.calls" ] && bad="$bad $1:cloned=[$(tr '\n' ' ' < "$fx/clone.calls")]"
  [ -s "$fx/finish.calls" ] && bad="$bad $1:re-shared=[$(tr '\n' ' ' < "$fx/finish.calls")]"
  unset TEST_OO_LAYOUT_FX
  rm -rf "$fx"
  echo "$bad"
}
test.oo.setupLayout.hotfix() { # <folder> <base> # check out a pushed branch hotfix inside <folder>; main/ knows origin/hotfix
  git -C "$1" checkout -q -b hotfix
  git -C "$1" push -q origin hotfix >/dev/null 2>&1
  git -C "$2/main" fetch -q origin >/dev/null 2>&1
}
test.oo.setupLayout.detach() { # <folder> <base> # detach the HEAD of <folder>
  git -C "$1" checkout -q --detach
}
test.oo.setupLayout.none() { # <folder> <base> # leave <folder> as it is
  return 0
}
test.oo.setupLayoutExists() {
  local bad=""
  bad="$bad$(test.oo.setupLayout.case hotfix clone prod test.oo.setupLayout.hotfix)"
  bad="$bad$(test.oo.setupLayout.case detached clone prod test.oo.setupLayout.detach)"
  bad="$bad$(test.oo.setupLayout.case worktrees worktree dev test.oo.setupLayout.none)"
  [ -z "$bad" ] && create.result 0 "a finished layout is left alone, whatever is checked out in it" || create.result 1 "mode.setup:$bad"
  return $(result)
}
test.case $level "T-SETUP-LAYOUT-EXISTS: a finished layout is left alone — another branch, a detached HEAD, linked worktrees" test.oo.setupLayoutExists
expect 0 "a finished layout is left alone, whatever is checked out in it" \
  "already set up keyed on the branch name: prod/ with hotfix checked out was rm -rf'd"

test.oo.setupGate.case() { # <label> <prepare> # a plain source tree beside a fixture ~/oosh, made unsafe to delete by <prepare> <source>; echo the problems found
  local origin fx home lay rc bad="" stashes
  origin=$(test.oo.base "test.oo.setup.gate.$1" clone) || { echo " fixture-failed"; return 0; }
  fx="${origin%/*}"; home="$fx/home"; lay="$fx/layout"; mkdir -p "$home" "$lay"
  git clone -q -b dev "$fx/origin.git" "$lay/oosh-clone" >/dev/null 2>&1
  ln -s "$lay/oosh-clone" "$home/oosh"
  "$2" "$lay/oosh-clone"
  stashes=$(git -C "$lay/oosh-clone" stash list | grep -c .)
  TEST_OO_LAYOUT_FX="$fx"
  rc=$(test.oo.setupLayout.run "$home" "$lay")
  [ "$rc" != 0 ] || bad="$bad $1:rc0"
  grep -q "oosh-clone" "$fx/result" || bad="$bad $1:result-names-no-folder=[$(cat "$fx/result")]"
  [ -d "$lay/oosh-clone/.git" ] || bad="$bad $1:source-gone"
  [ "$(git -C "$lay/oosh-clone" stash list 2>/dev/null | grep -c .)" = "$stashes" ] || bad="$bad $1:stash-lost"
  [ -e "$lay/main" ] && bad="$bad $1:main-built"
  [ -d "$home/oosh/.git" ] || bad="$bad $1:oosh-dangling"
  unset TEST_OO_LAYOUT_FX
  rm -rf "$fx"
  echo "$bad"
}
test.oo.setupGate.stash() { # <source> # leave a stash in <source>
  printf 'stashed\n' >> "$1/file"
  git -C "$1" -c user.email=t@t -c user.name=t stash -q
}
test.oo.setupGate.unpushed() { # <source> # leave an unpushed commit in <source>
  printf 'unpushed\n' >> "$1/file"
  git -C "$1" -c user.email=t@t -c user.name=t commit -q -am unpushed
}
test.oo.setupSourceGate() {
  local bad=""
  bad="$bad$(test.oo.setupGate.case stash test.oo.setupGate.stash)"
  bad="$bad$(test.oo.setupGate.case unpushed test.oo.setupGate.unpushed)"
  [ -z "$bad" ] && create.result 0 "a source holding a stash or an unpushed commit is refused and left intact" || create.result 1 "mode.setup:$bad"
  return $(result)
}
test.case $level "T-SETUP-SOURCE-GATE: a plain source tree is consumed only after the ogit gate" test.oo.setupSourceGate
expect 0 "a source holding a stash or an unpushed commit is refused and left intact" \
  "the source was rm -rf'd with its stash and unpushed commit"

# ============================================================================
# T-BASE-GET-*: oo.mode.base.get without OOSH_COMPONENTS_DIR
# ============================================================================
# Nothing exercised these. Every existing fixture exports OOSH_COMPONENTS_DIR
# and short-circuits on strategy 1, and T1 above is unfalsifiable on both
# halves — so the four checks that actually run on every real host (strategies
# 2, 3, 4a, 4b, all of which key on a directory literally named `main`) had no
# coverage at all. Asserted by BEHAVIOUR rather than by strategy number: what
# matters is whether a layout is detectable, not which branch of the function
# noticed.
private.test.oo.base.get.canonical() { # <baseDir> # build main/ + dev/ in <baseDir> in the clone layout: dev/ an independent clone of main/
  mkdir -p "$1"
  ( cd "$1" \
    && git init --initial-branch=main -q main \
    && cd main \
    && git config user.email "test@test.local" \
    && git config user.name "test" \
    && git commit --allow-empty -q -m seed \
    && git branch dev \
    && cd .. \
    && git clone -q -b dev main dev ) >/dev/null 2>&1
}
private.test.oo.base.get.probe() { # <ooshDir> # base.get with OOSH_COMPONENTS_DIR unset; echoes the base
  ( unset OOSH_COMPONENTS_DIR; OOSH_DIR="$1"; oo.mode.base.get 2>/dev/null )
}

test.oo.baseGetFromWorktree() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.baseget.wt) \
    || { create.result 1 "mktemp failed"; return $(result); }
  private.test.oo.base.get.canonical "$fixture/base"
  local got; got=$(private.test.oo.base.get.probe "$fixture/base/dev")
  if [ ! -d "$fixture/base/dev/.git" ]; then
    create.result 1 "fixture: dev/ is not a clone (.git is not a directory)"
  elif [ "$got" = "$fixture/base" ]; then
    create.result 0 "resolved from the branch clone"
  else
    create.result 1 "got '${got:-nothing}', expected $fixture/base"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-BASE-GET-WORKTREE: a branch clone beside main/ resolves its base with no OOSH_COMPONENTS_DIR" \
  test.oo.baseGetFromWorktree
expect 0 "resolved from the branch clone" "this is the shape every real install runs in (the clone layout since 2026-09-23)"

test.oo.baseGetFromMain() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.baseget.main) \
    || { create.result 1 "mktemp failed"; return $(result); }
  private.test.oo.base.get.canonical "$fixture/base"
  local got; got=$(private.test.oo.base.get.probe "$fixture/base/main")
  if [ "$got" = "$fixture/base" ]; then
    create.result 0 "resolved from main"
  else
    create.result 1 "got '${got:-nothing}', expected $fixture/base"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-BASE-GET-MAIN: the repository directory itself resolves its base" \
  test.oo.baseGetFromMain
expect 0 "resolved from main" "oo mode / oo use can be invoked from main as easily as from a branch"

test.oo.baseGetSiblingMain() {
  # A plain clone that merely SITS beside a main/ — strategy 4b, the loosest
  # check. private.oo.shared.tree.from.local's own comment relies on it when
  # origin/main was never fetched.
  local fixture; fixture=$(test.suite.fixture.make test.oo.baseget.sib) \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/base/main"
  git init --initial-branch=dev -q "$fixture/base/dev" >/dev/null 2>&1
  local got; got=$(private.test.oo.base.get.probe "$fixture/base/dev")
  if [ "$got" = "$fixture/base" ]; then
    create.result 0 "sibling main is enough"
  else
    create.result 1 "got '${got:-nothing}', expected $fixture/base"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-BASE-GET-SIBLING: a sibling main/ is enough, even when it is not a repository" \
  test.oo.baseGetSiblingMain
expect 0 "sibling main is enough" "the loosest of the four checks — and the one the tree-builder falls back on"

test.oo.baseGetRefusesDevOnly() {
  # The measurement behind this whole ticket: the layout oo.mode.setup USED to
  # build — <base>/dev with no main/ — is undetectable the moment
  # OOSH_COMPONENTS_DIR is gone, which is every shell after the one that ran it.
  local fixture; fixture=$(test.suite.fixture.make test.oo.baseget.devonly) \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/base"
  git init --initial-branch=dev -q "$fixture/base/dev" >/dev/null 2>&1
  local got; got=$(private.test.oo.base.get.probe "$fixture/base/dev")
  if [ -z "$got" ]; then
    create.result 0 "undetectable"
  else
    create.result 1 "it resolved '$got' from a layout with no main/"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-BASE-GET-DEV-ONLY: <base>/dev with no main/ is undetectable" \
  test.oo.baseGetRefusesDevOnly
expect 0 "undetectable" "this is what oo.mode.setup used to produce, and why item 7 exists"

