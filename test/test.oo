rm -rf "$SETUP_FIXTURE"
export OOSH_DIR="$SAVE_SETUP_OOSH_DIR"
export OOSH_MODE="$SAVE_SETUP_OOSH_MODE"
export OOSH_COMPONENTS_DIR="$SAVE_SETUP_OOSH_COMPONENTS_DIR"
export PATH="$SAVE_SETUP_PATH"
HOME="$SAVE_SETUP_HOME"
config save oosh OOSH 2>/dev/null

# ============================================================================
# T-BRANCH-1: oo.branch.list local returns branches in current environment
# ============================================================================
test.oo.branchList.local() {
  local branches
  branches=$(oo.branch.list local 2>/dev/null)
  if [ -n "$branches" ]; then
    create.result 0 "$branches"
  else
    create.result 1 "no branches returned"
  fi
}
test.case - "T-BRANCH-1: branch.list local returns branches" \
  test.oo.branchList.local
expect 0 "*" "oo.branch.list local returns at least one branch"

# ============================================================================
# T-BRANCH-2: oo.branch.list local includes worktree directories
# ============================================================================
test.oo.branchList.worktrees() {
  local base
  base=$(oo.mode.base.get 2>/dev/null)
  if [ $? -ne 0 ] || [ -z "$base" ]; then
    # No worktree structure — skip by passing
    create.result 0 "no worktrees to test"
    return
  fi
  local branches
  branches=$(oo.branch.list local 2>/dev/null)
  # At minimum, "dev" or "main" should appear from worktree dirs
  if echo "$branches" | grep -qE '^(dev|main)$'; then
    create.result 0 "worktree dirs included"
  else
    create.result 1 "expected dev or main in: $branches"
  fi
}
test.case - "T-BRANCH-2: branch.list local includes worktree dirs" \
  test.oo.branchList.worktrees
expect 0 "*" "oo.branch.list local includes worktree directories"

# ============================================================================
# T-BRANCH-3: oo.branch.list deduplicates results
# ============================================================================
test.oo.branchList.dedup() {
  local branches
  branches=$(oo.branch.list local 2>/dev/null)
  if [ -z "$branches" ]; then
    create.result 1 "no branches returned"
    return
  fi
  local total
  total=$(echo "$branches" | wc -l)
  local unique
  unique=$(echo "$branches" | sort -u | wc -l)
  if [ "$total" -eq "$unique" ]; then
    create.result 0 "no duplicates ($total branches)"
  else
    create.result 1 "duplicates found: total=$total unique=$unique"
  fi
}
test.case - "T-BRANCH-3: branch.list deduplicates results" \
  test.oo.branchList.dedup
expect 0 "*" "oo.branch.list returns no duplicate entries"

# ============================================================================
# T-BRANCH-4: oo.branch.list remote includes remote branches
# ============================================================================
test.oo.branchList.remote() {
  local branches
  branches=$(oo.branch.list remote 2>/dev/null)
  if [ -n "$branches" ]; then
    create.result 0 "$branches"
  else
    create.result 1 "no remote branches returned"
  fi
}
test.case - "T-BRANCH-4: branch.list remote returns remote branches" \
  test.oo.branchList.remote
expect 0 "*" "oo.branch.list remote returns at least one remote branch"

# ============================================================================
# T-BRANCH-5: oo.branch.list with invalid source returns error
# ============================================================================
test.oo.branchList.invalidSource() {
  oo.branch.list "invalidSource$$" 2>/dev/null
}
test.case - "T-BRANCH-5: branch.list rejects invalid source" \
  test.oo.branchList.invalidSource
expect 1 "*" "oo.branch.list rejects invalid source parameter"

# ============================================================================
# T-COMP-1: oo.use.completion.branch returns branches, not file listings
# ============================================================================
test.oo.comp.useBranch() {
  local output
  output=$(oo.use.completion.branch 2>/dev/null)
  if [ -z "$output" ]; then
    create.result 1 "empty output"
    return
  fi
  # Should NOT contain typical directory listing entries
  if echo "$output" | grep -qE '^\.\.' ; then
    create.result 1 "contains directory listing (grunge): $output"
  elif echo "$output" | grep -qE '^\./'; then
    create.result 1 "contains path prefix (grunge): $output"
  else
    create.result 0 "$output"
  fi
}
test.case - "T-COMP-1: oo.use.completion.branch returns branches not grunge" \
  test.oo.comp.useBranch
expect 0 "*" "oo.use.completion.branch returns branch names"

# ============================================================================
# T-COMP-2: oo.checkout.completion.version returns remote branches
# ============================================================================
test.oo.comp.checkoutVersion() {
  local output
  output=$(oo.checkout.completion.version 2>/dev/null)
  if [ -z "$output" ] || [ "$output" = ";" ]; then
    create.result 1 "no remote branches returned"
    return
  fi
  # Should contain known branches like dev, main, prod, or stage
  if echo "$output" | grep -qE '^(dev|main|prod|stage)$'; then
    create.result 0 "remote branches found"
  else
    # Still valid if it has any content (repo may have different branches)
    create.result 0 "$output"
  fi
}
test.case - "T-COMP-2: oo.checkout.completion.version returns remote branches" \
  test.oo.comp.checkoutVersion
expect 0 "*" "oo.checkout.completion.version returns remote branch names"

# ============================================================================
# Consistency check fixture
# ============================================================================
CONSIST_FIXTURE="/tmp/test.oo.consist.$$"
SAVE_CONSIST_HOME="$HOME"
SAVE_CONSIST_OOSH_DIR="$OOSH_DIR"
SAVE_CONSIST_OOSH_MODE="$OOSH_MODE"
SAVE_CONSIST_COMPONENTS="$OOSH_COMPONENTS_DIR"

mkdir -p "$CONSIST_FIXTURE/dev" "$CONSIST_FIXTURE/main"
git init "$CONSIST_FIXTURE/dev" >/dev/null 2>&1
(cd "$CONSIST_FIXTURE/dev" && git -c user.email="test@test" -c user.name="test" commit --allow-empty -m "init" >/dev/null 2>&1)
# Ensure 'dev' branch exists (git init may create 'master' or 'main' depending on config)
(cd "$CONSIST_FIXTURE/dev" && git checkout -B dev >/dev/null 2>&1)
git init "$CONSIST_FIXTURE/main" >/dev/null 2>&1
(cd "$CONSIST_FIXTURE/main" && git -c user.email="test@test" -c user.name="test" commit --allow-empty -m "init" >/dev/null 2>&1)

# ============================================================================
# T-CONSIST-1: oo.mode detects git branch vs directory name mismatch
# ============================================================================
test.oo.consist.mismatch() {
  HOME="$CONSIST_FIXTURE"
  export OOSH_COMPONENTS_DIR="$CONSIST_FIXTURE"
  export OOSH_DIR="$CONSIST_FIXTURE/dev"
  ln -sf "$CONSIST_FIXTURE/dev" "$CONSIST_FIXTURE/oosh"

  # Create a new branch 'prod' and switch to it inside the 'dev' directory
  (cd "$CONSIST_FIXTURE/dev" && git checkout -b prod >/dev/null 2>&1)

  local output
  output=$(oo.mode 2>&1)

  # Restore git state
  (cd "$CONSIST_FIXTURE/dev" && git checkout dev 2>/dev/null || git checkout -b dev 2>/dev/null) >/dev/null 2>&1

  HOME="$SAVE_CONSIST_HOME"
  export OOSH_DIR="$SAVE_CONSIST_OOSH_DIR"
  export OOSH_MODE="$SAVE_CONSIST_OOSH_MODE"
  export OOSH_COMPONENTS_DIR="$SAVE_CONSIST_COMPONENTS"

  if echo "$output" | grep -q "Git branch is"; then
    create.result 0 "mismatch detected"
  else
    create.result 1 "no warning in output: $output"
  fi
}
test.case - "T-CONSIST-1: oo.mode detects branch/directory mismatch" \
  test.oo.consist.mismatch
expect 0 "mismatch detected" "oo.mode warns when git branch differs from directory name"

# ============================================================================
# T-CONSIST-2: oo.mode shows no warning when aligned
# ============================================================================
test.oo.consist.aligned() {
  HOME="$CONSIST_FIXTURE"
  export OOSH_COMPONENTS_DIR="$CONSIST_FIXTURE"
  export OOSH_DIR="$CONSIST_FIXTURE/dev"
  ln -sf "$CONSIST_FIXTURE/dev" "$CONSIST_FIXTURE/oosh"

  # Ensure git branch is 'dev' to match directory
  (cd "$CONSIST_FIXTURE/dev" && git checkout dev 2>/dev/null || git checkout -b dev 2>/dev/null) >/dev/null 2>&1

  local output
  output=$(oo.mode 2>&1)

  HOME="$SAVE_CONSIST_HOME"
  export OOSH_DIR="$SAVE_CONSIST_OOSH_DIR"
  export OOSH_MODE="$SAVE_CONSIST_OOSH_MODE"
  export OOSH_COMPONENTS_DIR="$SAVE_CONSIST_COMPONENTS"

  if echo "$output" | grep -q "Git branch is"; then
    create.result 1 "false positive warning: $output"
  else
    create.result 0 "no warning"
  fi
}
test.case - "T-CONSIST-2: oo.mode no warning when aligned" \
  test.oo.consist.aligned
expect 0 "no warning" "oo.mode shows no warning when git branch matches directory"

# ============================================================================
# T-ALIGN-1: oo.mode.align fixes mismatch
# ============================================================================
test.oo.align.fix() {
  HOME="$CONSIST_FIXTURE"
  export OOSH_COMPONENTS_DIR="$CONSIST_FIXTURE"
  export OOSH_DIR="$CONSIST_FIXTURE/dev"
  ln -sf "$CONSIST_FIXTURE/dev" "$CONSIST_FIXTURE/oosh"

  # Create mismatch: dir is 'dev' but git branch is 'prod'
  (cd "$CONSIST_FIXTURE/dev" && git checkout prod 2>/dev/null || git checkout -b prod 2>/dev/null) >/dev/null 2>&1

  oo.mode.align >/dev/null 2>&1
  local rc=$?

  local gitBranch
  gitBranch=$(git -C "$CONSIST_FIXTURE/dev" branch --show-current 2>/dev/null)

  # Restore
  HOME="$SAVE_CONSIST_HOME"
  export OOSH_DIR="$SAVE_CONSIST_OOSH_DIR"
  export OOSH_MODE="$SAVE_CONSIST_OOSH_MODE"
  export OOSH_COMPONENTS_DIR="$SAVE_CONSIST_COMPONENTS"

  if [ $rc -eq 0 ] && [ "$gitBranch" = "dev" ]; then
    create.result 0 "aligned to dev"
  else
    create.result 1 "rc=$rc gitBranch=$gitBranch"
  fi
}
test.case - "T-ALIGN-1: oo.mode.align fixes branch/directory mismatch" \
  test.oo.align.fix
expect 0 "aligned to dev" "oo.mode.align checks out correct branch"

# ============================================================================
# T-ALIGN-2: oo.mode.align reports already aligned
# ============================================================================
test.oo.align.noOp() {
  HOME="$CONSIST_FIXTURE"
  export OOSH_COMPONENTS_DIR="$CONSIST_FIXTURE"
  export OOSH_DIR="$CONSIST_FIXTURE/dev"
  ln -sf "$CONSIST_FIXTURE/dev" "$CONSIST_FIXTURE/oosh"

  # Ensure aligned
  (cd "$CONSIST_FIXTURE/dev" && git checkout dev 2>/dev/null || git checkout -b dev 2>/dev/null) >/dev/null 2>&1

  oo.mode.align >/dev/null 2>&1
  local rc=$?

  HOME="$SAVE_CONSIST_HOME"
  export OOSH_DIR="$SAVE_CONSIST_OOSH_DIR"
  export OOSH_MODE="$SAVE_CONSIST_OOSH_MODE"
  export OOSH_COMPONENTS_DIR="$SAVE_CONSIST_COMPONENTS"

  if [ $rc -eq 0 ]; then
    create.result 0 "already aligned"
  else
    create.result 1 "rc=$rc"
  fi
}
test.case - "T-ALIGN-2: oo.mode.align reports already aligned" \
  test.oo.align.noOp
expect 0 "already aligned" "oo.mode.align succeeds when no mismatch"

# Consistency fixture teardown
rm -rf "$CONSIST_FIXTURE"
export OOSH_DIR="$SAVE_CONSIST_OOSH_DIR"
export OOSH_MODE="$SAVE_CONSIST_OOSH_MODE"
export OOSH_COMPONENTS_DIR="$SAVE_CONSIST_COMPONENTS"
HOME="$SAVE_CONSIST_HOME"
config save oosh OOSH 2>/dev/null

# ============================================================================
# Checkout tests — use current environment
# ============================================================================

# ============================================================================
# T-CHECKOUT-1: oo.checkout rejects missing version argument
# ============================================================================
test.oo.checkout.missingArg() {
  oo.checkout 2>/dev/null
}
test.case - "T-CHECKOUT-1: oo.checkout rejects missing argument" \
  test.oo.checkout.missingArg
expect 1 "*" "oo.checkout requires version argument"

# ============================================================================
# T-CHECKOUT-2: oo.checkout derives correct directory name from version
# ============================================================================
test.oo.checkout.dirName() {
  # Prefix stripping and slash-to-dot conversion, on a fixture base (it used
  # to run against the real host's base and could only ever pass): a branch
  # feature/my/test exists on the fixture origin and must land in
  # <base>/my.test. Global git config sandboxed — the clone is trusted.
  private.this.script.load ogit ogit.branch.get
  local base fx rc
  base=$(test.oo.base test.oo.checkout.dirname clone) || { create.result 1 "fixture failed"; return $(result); }
  fx=$(dirname "$base")
  git -C "$base/main" branch -q feature/my/test main && git -C "$base/main" push -q origin feature/my/test
  local GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  local OOSH_COMPONENTS_DIR="$base"; export OOSH_COMPONENTS_DIR
  local OOSH_DIR="$base/dev"; export OOSH_DIR
  oo.checkout feature/my/test >/dev/null 2>&1; rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "oo.checkout feature/my/test returned $rc: $RESULT"
  elif [ "$(git -C "$base/my.test" rev-parse --abbrev-ref HEAD 2>/dev/null)" != feature/my/test ]; then
    create.result 1 "no clone of feature/my/test at $base/my.test"
  else
    create.result 0 "feature/my/test cloned as <base>/my.test"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case - "T-CHECKOUT-2: oo.checkout strips prefix from version" \
  test.oo.checkout.dirName
expect 0 "feature/my/test cloned as <base>/my.test" "oo.checkout derives directory name correctly"

# ============================================================================
# T-CHECKOUT-NO-PULL: oo.checkout MUST NOT pull/merge
# ----------------------------------------------------------------------------
# The OOSH merge contract: pulls live ONLY in `oo update` (explicit user
# refresh) and merges live ONLY in `promote` / `oo stage` (the canonical
# promotion pipeline). `oo.checkout` previously ran `git pull` whenever
# the target worktree already existed and was aligned (in oo.checkout),
# which silently fetched + merged origin — surprising for a command whose
# job is "make the target worktree exist", not "refresh it". Lock the
# contract in with a structural assertion so a future refactor doesn't
# silently re-introduce a pull/merge in checkout.
# ============================================================================
test.case $level "oo.checkout body contains no \`git pull\`" \
  bash -c "! type oo.checkout | grep -qE 'git[[:space:]]+pull'"
if type oo.checkout 2>/dev/null | grep -qE 'git[[:space:]]+pull'; then
  expect.fail "oo.checkout body contains \`git pull\` — pulls belong in \`oo update\`, not \`oo checkout\`"
else
  expect.pass "oo.checkout body has no \`git pull\` — pulls only in \`oo update\`"
fi

test.case $level "oo.checkout body contains no \`git merge\`" \
  bash -c "! type oo.checkout | grep -qE 'git[[:space:]]+merge[[:space:]]'"
if type oo.checkout 2>/dev/null | grep -qE 'git[[:space:]]+merge[[:space:]]'; then
  expect.fail "oo.checkout body contains \`git merge\` — merges belong in \`promote\` / \`oo stage\`, not \`oo checkout\`"
else
  expect.pass "oo.checkout body has no \`git merge\` — merges only in \`promote\` / \`oo stage\`"
fi

# ============================================================================
# T-CHECKOUT-CLONES-UNDER-BASE: oo.checkout <branch> clones it as
# <base>/<branch> — a .git DIRECTORY, core.sharedRepository=group, and a
# safe.directory entry (clone layout, 2026-09-23 design; spec § 4)
# ============================================================================
test.oo.checkout.clonesUnderBase() {
  # load ogit BEFORE re-pointing OOSH_DIR: the loader sources "$OOSH_DIR/ogit"
  private.this.script.load ogit ogit.branch.get
  local base fx bad="" rc
  base=$(test.oo.base test.oo.checkout.clone clone) || { create.result 1 "fixture failed"; return $(result); }
  fx=$(dirname "$base")
  rm -rf "$base/prod"
  # local + export: this function's values, the caller's come back on return
  local GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  local OOSH_COMPONENTS_DIR="$base"; export OOSH_COMPONENTS_DIR
  local OOSH_DIR="$base/dev"; export OOSH_DIR
  oo.checkout prod >/dev/null 2>&1; rc=$?
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc result=[$RESULT]"
  [ -d "$base/prod/.git" ] || bad="$bad prod/.git-not-a-directory"
  [ "$(git -C "$base/prod" rev-parse --abbrev-ref HEAD 2>/dev/null)" = prod ] || bad="$bad not-on-prod"
  [ "$(git -C "$base/prod" config --local --get core.sharedRepository 2>/dev/null)" = group ] || bad="$bad not-shared"
  ogit.safeDirectory.list | grep -qFx "$base/prod" || bad="$bad not-trusted"
  rm -rf "$fx"
  if [ -n "$bad" ]; then create.result 1 "oo.checkout prod:$bad"
  else create.result 0 "prod cloned under the base, shared and trusted"; fi
  return $(result)
}
test.case $level "T-CHECKOUT-CLONES-UNDER-BASE: oo.checkout clones a branch as <base>/<branch>, shared and trusted" \
  test.oo.checkout.clonesUnderBase
expect 0 "prod cloned under the base, shared and trusted" "clone layout: oo checkout never adds a linked worktree"

# T-CHECKOUT-WORKTREE-SHARED: a folder made by oo checkout is finished by ogit folder.finish
# oo.checkout (like oo.mode, the local tree builder and state 31) spelled half
# of the finish by hand — ogit repo.share (.git) plus safeDirectory.add — and
# left the WORKING TREE at the caller's umask: the next dev-group user could not
# edit a checked-out file. Under umask 022, with a dev group the caller is in, a
# working-tree file is group dev + g+w and the folder setgid afterwards; on a
# host where that cannot be shown, a recording ogit.folder.finish proves the
# call with the folder.
test.oo.checkout.worktreeShared() {
  private.this.script.load ogit ogit.branch.get
  local base fx bad="" member=no
  base=$(test.oo.base checkoutshared clone) || { create.result 1 "fixture failed"; return $(result); }
  fx=$(dirname "$base"); rm -rf "$base/prod"
  case " $(id -nG 2>/dev/null) " in *" dev "*) private.this.group.exists dev && member=yes ;; esac
  bad=$(
    umask 022
    GIT_CONFIG_GLOBAL="$fx/gitconfig"; OOSH_COMPONENTS_DIR="$base"; OOSH_DIR="$base/dev"
    export GIT_CONFIG_GLOBAL OOSH_COMPONENTS_DIR OOSH_DIR
    [ "$member" = yes ] || ogit.folder.finish() { printf '%s\n' "$1" >> "$fx/finish.calls"; create.result 0 recorded; return 0; }
    oo.checkout prod >/dev/null 2>&1 || printf ' rc=%s' "$?"
    if [ "$member" = yes ]; then
      case "$(ls -ld "$base/prod/file")" in ?????w*) ;; *) printf ' file-not-g+w' ;; esac
      [ "$(ls -ld "$base/prod/file" | awk '{print $4}')" = dev ] || printf ' file-not-group-dev'
      case "$(ls -ld "$base/prod")" in ??????[sS]*) ;; *) printf ' folder-not-setgid' ;; esac
    else
      grep -qFx "$base/prod" "$fx/finish.calls" 2>/dev/null || printf ' finish-not-called'
    fi
    true
  )
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the checked-out working tree is finished for the dev group" || create.result 1 "oo.checkout prod (member=$member):$bad"
  return $(result)
}
test.case $level "T-CHECKOUT-WORKTREE-SHARED: oo checkout finishes the new folder with ogit folder.finish — the working tree too" \
  test.oo.checkout.worktreeShared
expect 0 "the checked-out working tree is finished for the dev group" "files of a folder made by oo checkout stayed at the caller's umask"

# ============================================================================
# T-CHECKOUT-NO-BASE: with no components base oo.checkout fails loud and
# names the fix — it no longer drops a clone beside whatever $OOSH_DIR is
# ============================================================================
test.oo.checkout.noBase() {
  private.this.script.load ogit ogit.branch.get
  local fx rc bad=""
  fx=$(test.suite.fixture.make test.oo.checkout.nobase) || { create.result 1 "fixture failed"; return $(result); }
  git init -q -b dev "$fx/oosh" >/dev/null 2>&1
  local OOSH_COMPONENTS_DIR=""; export OOSH_COMPONENTS_DIR
  local OOSH_DIR="$fx/oosh"; export OOSH_DIR
  oo.checkout prod >/dev/null 2>&1; rc=$?
  [ "$rc" -ne 0 ] || bad="$bad rc=0"
  case "$RESULT" in *"oo mode.setup"*) ;; *) bad="$bad result=[$RESULT]" ;; esac
  [ -e "$fx/prod" ] && bad="$bad made-$fx/prod"
  rm -rf "$fx"
  if [ -n "$bad" ]; then create.result 1 "oo.checkout without a base:$bad"
  else create.result 0 "refused, naming oo mode.setup"; fi
  return $(result)
}
test.case $level "T-CHECKOUT-NO-BASE: without a components base oo.checkout refuses and names oo mode.setup" \
  test.oo.checkout.noBase
expect 0 "refused, naming oo mode.setup" "one layout: no plain-clone fallback beside \$OOSH_DIR"

# ============================================================================
# T-UPDATE-ENSURES-TRUST: after oo.update every repository folder under the
# base is in the caller's safe.directory list (spec § 4 — oo update repairs
# trust). The pull, the symlink heal and every step that leaves the fixture
# are stand-ins in a subshell with a fixture HOME; the global git config is
# sandboxed; a recording sudo that fails must never be called.
# ============================================================================
test.oo.update.ensuresTrust() {
  private.this.script.load ogit ogit.branch.get
  local base fx bad="" rc missing="" d
  base=$(test.oo.base test.oo.update.trust clone) || { create.result 1 "fixture failed"; return $(result); }
  fx=$(dirname "$base")
  local GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  local OOSH_COMPONENTS_DIR="$base"; export OOSH_COMPONENTS_DIR
  local OOSH_DIR="$base/dev"; export OOSH_DIR
  # A sudo that records and fails: nothing in this test may reach the real one.
  mkdir -p "$fx/home" "$fx/bin"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  (
    HOME="$fx/home"; PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"
    private.oo.update.pull() { create.result 0 mocked; }
    private.oo.update.heal.symlinks() { :; }
    # The steps that leave the fixture — /etc/profile.d, /usr/local/bin, the
    # real ~/.once, and as root the shared odocker.env and the computer's
    # name — are recording stand-ins: this test is about trust.
    private.oo.dropin.remove()           { echo dropin.remove >> "$fx/steps"; }
    private.oo.install.launcher()        { echo install.launcher >> "$fx/steps"; }
    private.oo.once.path.migrate()       { echo once.path.migrate >> "$fx/steps"; }
    private.odocker.workspaces.install() { echo odocker.workspaces.install >> "$fx/steps"; }
    private.config.host.name.refresh()   { echo config.host.name.refresh >> "$fx/steps"; }
    oo.update >/dev/null 2>&1
  ); rc=$?
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc"
  [ -s "$fx/sudo.calls" ] && bad="$bad sudo-called=[$(tr '\n' '|' < "$fx/sudo.calls")]"
  grep -qx config.host.name.refresh "$fx/steps" 2>/dev/null || bad="$bad update-did-not-finish=[$(tr '\n' '|' < "$fx/steps" 2>/dev/null)]"
  for d in "$base"/*/; do
    d="${d%/}"
    ogit.safeDirectory.list | grep -qFx "$d" || missing="$missing ${d##*/}"
  done
  [ -z "$missing" ] || bad="$bad untrusted:$missing"
  rm -rf "$fx"
  if [ -n "$bad" ]; then create.result 1 "oo.update:$bad"
  else create.result 0 "every folder under the base is trusted after oo update"; fi
  return $(result)
}
test.case $level "T-UPDATE-ENSURES-TRUST: oo.update ensures safe.directory for every folder under the base" \
  test.oo.update.ensuresTrust
expect 0 "every folder under the base is trusted after oo update" "oo update is the repair for a folder that lost its trust"

# ============================================================================
# T-UPDATE-NO-BASE-QUIET: before state 31 there is no components base (the
# installer's first `oo update` runs in root's plain ~/oosh clone). The trust
# step must skip quietly there — it printed ERROR> + WARNING> on every install.
# ============================================================================
test.oo.update.noBaseQuiet() {
  private.this.script.load ogit ogit.branch.get
  local fx out rc bad=""
  fx=$(test.suite.fixture.make test.oo.update.nobase)
  git init -q -b dev "$fx/work"
  local GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  local OOSH_COMPONENTS_DIR=""; export OOSH_COMPONENTS_DIR
  local OOSH_DIR="$fx/work"; export OOSH_DIR
  # The log goes to a FILE: oo.update calls the ensure with >/dev/null, so a
  # stdout LOG_DEVICE would swallow exactly the lines this case looks for; level
  # 3 so the WARNING> shows too (a real install logs to the terminal).
  (
    LOG_DEVICE="$fx/log.out"; LOG_LEVEL=3
    private.oo.update.pull() { create.result 0 mocked; }
    private.oo.update.heal.symlinks() { :; }
    oo.update >/dev/null 2>&1
  ); rc=$?
  out=$(cat "$fx/log.out" 2>/dev/null)
  [ "$rc" -eq 0 ] || bad="$bad rc=$rc"
  case "$out" in *"no base"*|*"ERROR>"*) bad="$bad noisy=[$(printf '%s' "$out" | grep -E 'no base|ERROR>' | head -2 | tr '\n' ' ')]" ;; esac
  rm -rf "$fx"
  if [ -n "$bad" ]; then create.result 1 "oo.update:$bad"
  else create.result 0 "no base yet: the trust step is skipped quietly"; fi
  return $(result)
}
test.case $level "T-UPDATE-NO-BASE-QUIET: oo.update skips the trust step quietly when there is no components base" \
  test.oo.update.noBaseQuiet
expect 0 "no base yet: the trust step is skipped quietly" "the installer's first oo update runs before state 31 builds the base"

# ============================================================================
# T-USE-1: oo.use rejects missing arguments
# ============================================================================
test.oo.use.missingArgs() {
  oo.use 2>/dev/null
}
test.case - "T-USE-1: oo.use rejects missing arguments" \
  test.oo.use.missingArgs
expect 1 "*" "oo.use requires branch and command arguments"

# ============================================================================
# T-USE-2: oo.use rejects non-existent branch
# ============================================================================
test.oo.use.badBranch() {
  oo.use "nonexistent_branch_$$" "somecommand" 2>/dev/null
}
test.case - "T-USE-2: oo.use rejects non-existent branch" \
  test.oo.use.badBranch
expect 1 "*" "oo.use rejects branch that does not exist"

# ============================================================================
# T-USE-3: oo.use finds branch via sibling directory fallback
# ============================================================================
test.oo.use.siblingFallback() {
  # Create a temp sibling dir with an executable script
  local parentDir
  parentDir=$(dirname "${OOSH_DIR:-$HOME/oosh}")
  local testBranch="testUseSibling$$"
  local testDir="$parentDir/$testBranch"

  mkdir -p "$testDir"
  echo '#!/usr/bin/env bash' > "$testDir/testCmd"
  echo 'echo "sibling-ok"' >> "$testDir/testCmd"
  chmod +x "$testDir/testCmd"

  # Temporarily unset OOSH_COMPONENTS_DIR to force sibling fallback
  local saveComponents="$OOSH_COMPONENTS_DIR"
  unset OOSH_COMPONENTS_DIR

  local output
  output=$(oo.use "$testBranch" "testCmd" 2>/dev/null)
  local rc=$?

  export OOSH_COMPONENTS_DIR="$saveComponents"
  rm -rf "$testDir"

  if [ $rc -eq 0 ] && [ "$output" = "sibling-ok" ]; then
    create.result 0 "sibling fallback worked"
  else
    create.result 1 "rc=$rc output=$output"
  fi
}
test.case - "T-USE-3: oo.use finds branch via sibling directory" \
  test.oo.use.siblingFallback
expect 0 "sibling fallback worked" "oo.use falls back to sibling directories"

# ─────────────────────────────────────────────────────────────────────────────
# T-OO-PREREQS-INSTALL : the local `oo prereqs.install` command exists AND
# delegates to `oo cmd` (doesn't reinvent package-install logic).
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-OO-PREREQS-INSTALL-PRESENT: oo.prereqs.install is defined in oo script" \
  echo "(grep)"
if grep -qE '^oo\.prereqs\.install\(\)' "$OOSH_DIR/oo"; then
  expect.pass "oo.prereqs.install is defined"
else
  expect.fail "oo.prereqs.install missing — local prereq-fix command not wired"
fi

test.case - "T-OO-PREREQS-INSTALL-DELEGATES-TO-CMD: uses oo cmd, doesn't reinvent" \
  echo "(grep oo.prereqs.install body for 'oo cmd')"
# Read the function body from the file directly (sourcing oo would load the
# whole script). Awk from `^oo.prereqs.install() ...` to the first `^}` line.
_OO_BODY=$(awk '/^oo\.prereqs\.install\(\)/{in_fn=1} in_fn{print} in_fn && /^}/{exit}' "$OOSH_DIR/oo")
if printf "%s" "$_OO_BODY" | grep -qE '[[:space:]]oo[[:space:]]+cmd[[:space:]]'; then
  expect.pass "oo.prereqs.install delegates to 'oo cmd'"
else
  expect.fail "oo.prereqs.install reinvents package install — must use 'oo cmd'"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-THIS-SUDO-SELF-HEAL : the SUDO block at the top of this sets $SUDO based on id -u when not already
# set. bashrcTemplate exports $SUDO for shells that source bashrc; this self-
# heals for ssh-with-command paths on distros without Debian's
# SSH_SOURCE_BASHRC bash patch (Alpine/musl). Both defenses are needed —
# they cover disjoint code paths.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-THIS-SUDO-SELF-HEAL: this self-heals \$SUDO for ssh-with-command on non-Debian distros" \
  echo "(grep this for the self-heal block)"
THIS_BODY=$(cat "$OOSH_DIR/this" 2>/dev/null)
if printf "%s" "$THIS_BODY" | grep -qE '\[ -z "\$\{SUDO\+x\}" \]' \
   && printf "%s" "$THIS_BODY" | grep -qE 'export SUDO=""' \
   && printf "%s" "$THIS_BODY" | grep -qE 'export SUDO="sudo "'; then
  expect.pass "this:\$SUDO self-heal block present (sets \"\" for root, \"sudo \" otherwise)"
else
  expect.fail "this missing \$SUDO self-heal — Alpine ssh-with-command will hit empty \$SUDO and useradd will fail"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-OO-PRIVILEGES-ROUTE-WITHOUT-USER : install state 13
# (private.check.priviledges.checked) routes root vs user on `[ "$USER" = root ]`.
# Bash does NOT set USER, and init/oosh's clean re-exec (env -i) erases it, so
# a root install with no later sudo hop (ssh root@host, `sudo ./init/oosh`)
# arrived here with USER empty and was routed to [20] user.rights.only.
# Simulated as root: a stub `id` first on PATH answers 0 / root, HOME is a
# fresh dir (no ~/.sudo_as_admin_successful), USER is UNSET. The only thing
# that can produce 30 is `this` healing USER from `id -un`.
# ─────────────────────────────────────────────────────────────────────────────
test.oo.privilegesRouteWithoutUser() {
  local stubDir got
  stubDir=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.idstub.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  printf '%s\n' '#!/bin/sh' 'case "$*" in *-un*|*-nu*) echo root ;; *-u*) echo 0 ;; *) command -p id "$@" ;; esac' > "$stubDir/id"
  chmod +x "$stubDir/id"
  mkdir -p "$stubDir/home"
  got=$(env -i PATH="$stubDir:$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=0 bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1
    source "$OOSH_DIR/oo"   >/dev/null 2>&1
    HOME="$1"
    private.check.priviledges.checked >/dev/null 2>&1
    printf "%s" "$RESULT"' _ "$stubDir/home")
  rm -rf "$stubDir"
  if [ "$got" = "30" ]; then
    create.result 0 "root routed to 30 without an inherited USER"
  else
    create.result 1 "routed to [$got] (expected 30) — with USER erased by the clean re-exec a root install lands in the user lane; this must heal USER from id -un"
  fi
  return $(result)
}
test.case - "T-OO-PRIVILEGES-ROUTE-WITHOUT-USER: state 13 routes root to [30] even when USER is not inherited" \
  test.oo.privilegesRouteWithoutUser
expect 0 "root routed to 30 without an inherited USER" \
  "ssh root@host / sudo ./init/oosh: the clean re-exec erases USER; routing must not depend on inheriting it"

# ─────────────────────────────────────────────────────────────────────────────
# T-THIS-INIT-LOG-LIVE-PRESERVED : this.init's source $CONFIG re-imports
# user.env mid-session, which transitively sources shared log.env. Without
# preservation, LOG_LIVE gets clobbered to whatever absolute path was last
# persisted (often a different user's). Mirrors the existing PATH preservation
# block in this.init.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-THIS-INIT-LOG-LIVE-PRESERVED: this.init save/restores LOG_LIVE around source \$CONFIG" \
  echo "(grep this for savedLogLive)"
if printf "%s" "$THIS_BODY" | grep -qE 'local savedPath="\$PATH" savedLogLive=' \
   && printf "%s" "$THIS_BODY" | grep -qE 'export LOG_LIVE="\$savedLogLive"'; then
  expect.pass "this.init preserves LOG_LIVE across \$CONFIG re-source"
else
  expect.fail "this.init missing LOG_LIVE preservation — multi-user installs will hit cross-user permission errors"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-CONFIG-SAVE-LOG-NO-SESSION-VALUES : config.save keeps the per-user session
# log values (LOG_NAME/LOG_DEVICE/LOG_LIVE) OUT of the shared log.env — they
# live in each user's own log.session.env, which log.env chains last. In the
# shared file a new user inherited the saver's values (LOG_NAME=hannesn@host).
# The settings (LOG_LEVEL, LOG_LEVEL_RESET) are saved. LOGNAME must never match.
# Write-side complement to T-THIS-INIT-LOG-LIVE-PRESERVED (read-side).
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-CONFIG-SAVE-LOG-NO-SESSION-VALUES: config.save keeps LOG_NAME/LOG_DEVICE/LOG_LIVE out of the shared log.env" \
  echo "(generate log.env with the per-user LOG_* values set; verify they stay out)"
_llfix="/tmp/test.oo.loglive.$(id -u).$$"; mkdir -p "$_llfix"
bash -c '
  export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
  source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
  export HOME="'"$_llfix"'" CONFIG_PATH="'"$_llfix"'" CONFIG_FILE=user.env CONFIG="'"$_llfix"'/user.env"
  export LOG_LEVEL=3 LOG_LEVEL_RESET=3 LOG_LIVE="$HOME/config/log.live.out"
  export LOG_NAME="someuser@somehost" LOG_DEVICE="/dev/pts/7"
  : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
' >/dev/null 2>&1
_lf="$_llfix/log.env"
if grep -qxF 'export LOG_LEVEL_RESET="3"' "$_lf" 2>/dev/null \
   && ! grep -qE '^export (LOG_NAME|LOG_DEVICE|LOG_LIVE|LOGNAME)=' "$_llfix"/{user,oosh,log}.env \
   && ! grep -qF "$_llfix" "$_llfix"/{user,oosh,log}.env; then
  expect.pass "config.save keeps the per-user session values out of the shared log.env; LOGNAME never matches"
else
  expect.fail "log.env: $(tr '\n' '|' < "$_lf" 2>/dev/null)"
fi
# the fixture stays: T-CONFIG-SAVE-CHAINS-LOG-SESSION reads its log.env, then removes it

# ─────────────────────────────────────────────────────────────────────────────
# T-CONFIG-SAVE-CHAINS-LOG-SESSION : generated log.env must CHAIN the per-user
# session file (. $HOME/.config/oosh/log.session.env), UNEXPANDED so
# each user loads their own. This is what makes `config list log` show session
# and loads the saved per-user LOG_NAME/DEVICE/LIVE at shell init. Complement to
# the exclusion test: the values stay out of log.env, but the chain points to
# where they DO live. The var must be literal ($-prefixed), not expanded.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-CONFIG-SAVE-CHAINS-LOG-SESSION: log.env sources the per-user session file" \
  echo "(verify log.env chains log.session.env with the unexpanded var)"
if grep -qE '^[[:space:]]*(source|\.)[[:space:]]+\$HOME/\.config/oosh/log\.session\.env[[:space:]]*$' "$_llfix/log.env" 2>/dev/null; then
  expect.pass "log.env chains \$HOME/.config/oosh/log.session.env"
else
  expect.fail "log.env missing per-user session chain: $(grep -n 'session' "$_llfix/log.env" 2>/dev/null | tr '\n' ' ')"
fi
rm -rf "$_llfix"

# ─────────────────────────────────────────────────────────────────────────────
# T-OO-CHECKOUT-COMPLETION-LOCAL-FALLBACK : oo.checkout.completion.version
# must fall back to locally-cached remote-tracking branches when `git ls-remote
# origin` fails (origin unreachable: VM without 2cuGitHub SSH alias, offline
# laptop, expired token). Without this, the completion silently returns
# nothing and c2's parameter-default fallback leaks the literal
# "addDefaultValue" placeholder as the lone completion suggestion — observed
# on a fresh tart_sequoia VM where git can't resolve `2cuGitHub`. Pin both
# the canonical ls-remote query (ogit.remote.branch.list) and the local
# remote-tracking fallback (ogit.branch.list remote) — ogit plan Task 15.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-OO-CHECKOUT-COMPLETION-LOCAL-FALLBACK: oo.checkout.completion.version falls back to local remote-tracking refs when ls-remote fails" \
  echo "(grep)"
OO_CHECKOUT_BODY=$(sed -n '/^oo\.checkout\.completion\.version()/,/^}/p' "$OOSH_DIR/oo")
if printf "%s" "$OO_CHECKOUT_BODY" | grep -qE 'ogit\.remote\.branch\.list' \
   && printf "%s" "$OO_CHECKOUT_BODY" | grep -qE 'ogit\.branch\.list remote'; then
  expect.pass "oo.checkout.completion.version has both ogit.remote.branch.list (primary) and ogit.branch.list remote (local fallback)"
else
  expect.fail "oo.checkout.completion.version missing local fallback — 'oo checkout <Tab>' will silently return nothing on offline / unreachable-origin hosts"
fi

# ============================================================================
# T-SHARED-TREE-FROM-LOCAL-CREATES-MAIN-AND-CLONE: helper produces the
# canonical Once.sh/{main, <branch>} CLONE layout (2026-09-23 design) from a
# local git clone: <branch>/ is an independent clone (.git a directory) whose
# origin is main/'s origin, in group-shared mode. Reproduces state-31's
# fallback path.
# ============================================================================
# The fixture origin URL is never contacted: every clone here is from a local
# path, and the helper only COPIES main/'s origin URL onto the new clone.
TEST_OO_STREE_ORIGIN="git@github.com:example/once.sh.git"

private.test.oo.stree.cloneShape() { # <fixtureTarget> <branch> # RESULT = "clone" when <target>/<branch> has the clone shape, else what is wrong
  local t="$1" b="$2" mainUrl devUrl shared
  mainUrl=$(git -C "$t/main" remote get-url origin 2>/dev/null)
  devUrl=$(git -C "$t/$b" remote get-url origin 2>/dev/null)
  shared=$(git -C "$t/$b" config --get core.sharedRepository 2>/dev/null)
  if [ ! -d "$t/main/.git" ]; then
    create.result 1 "main/ is not a repository"
  elif [ ! -d "$t/$b/.git" ]; then
    create.result 1 "$b/.git is not a directory — not an independent clone ($( [ -f "$t/$b/.git" ] && echo 'a worktree file' || echo missing))"
  elif [ -z "$mainUrl" ] || [ "$devUrl" != "$mainUrl" ]; then
    create.result 1 "origin of $b/ is '$devUrl', main/'s is '$mainUrl'"
  elif [ "$(git -C "$t/$b" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$b" ]; then
    create.result 1 "$b/ is not on branch $b"
  elif [ "$shared" != "group" ]; then
    create.result 1 "core.sharedRepository of $b/ is '$shared', not group"
  else
    create.result 0 "clone"
  fi
  return $(result)
}

test.oo.sharedTreeFromLocalCreatesLayout() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.stree) || { create.result 1 "fixture failed"; return 1; }
  local HOME XDG_CONFIG_HOME GIT_CONFIG_GLOBAL; test.oo.gitconfig.isolate "$fixture"
  mkdir -p "$fixture/source" "$fixture/target"
  # Build a minimal source clone: init repo, commit on main, branch dev.
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo "seed" > README.md
    git add README.md
    git commit -q -m "seed"
    git branch dev
    git checkout -q dev
    git config receive.denyCurrentBranch warn
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc=$?

  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "main/ + dev/ clone layout produced"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-SHARED-TREE-FROM-LOCAL-CREATES-MAIN-AND-CLONE: helper produces main/ + dev/ clone layout" \
  test.oo.realGitconfigUntouched test.oo.sharedTreeFromLocalCreatesLayout
expect 0 "main/ + dev/ clone layout produced" "private.oo.shared.tree.from.local creates the canonical clone layout: dev/.git a directory, origin = main/'s origin, core.sharedRepository=group"

# T-SHARED-TREE-FROM-LOCAL-ORIGIN-FALLBACK: the source is a clone of ANOTHER
# branch, so main/ holds only origin/<branch>, no local <branch>. A clone from
# a local path sees only main/'s local heads — the helper must create the local
# <branch> from origin/<branch> first (the fallback the old worktree-add pair
# had), and leave main/ on main.
test.oo.sharedTreeFromLocalOriginFallback() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.stree.fb) || { create.result 1 "fixture failed"; return 1; }
  local HOME XDG_CONFIG_HOME GIT_CONFIG_GLOBAL; test.oo.gitconfig.isolate "$fixture"
  mkdir -p "$fixture/source" "$fixture/target"
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo "seed" > README.md && git add . && git commit -q -m "seed"
    git checkout -q -b dev
    echo "on dev" > dev.txt && git add . && git commit -q -m "dev work"
    git update-ref refs/remotes/origin/dev dev
    git checkout -q main
    git branch -q -D dev
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc=$?

  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif ! private.test.oo.stree.cloneShape "$fixture/target" dev; then
    :
  elif [ ! -f "$fixture/target/dev/dev.txt" ]; then
    create.result 1 "dev/ does not hold origin/dev's commit"
  elif [ "$(git -C "$fixture/target/main" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "main" ]; then
    create.result 1 "main/ was left on $(git -C "$fixture/target/main" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  else
    create.result 0 "cloned from origin/dev"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-FROM-LOCAL-ORIGIN-FALLBACK: main/ without a local dev still yields the dev clone" \
  test.oo.realGitconfigUntouched test.oo.sharedTreeFromLocalOriginFallback
expect 0 "cloned from origin/dev" "the origin/<branch> fallback survives the move from worktree add to clone"

# T-SHARED-TREE-FROM-LOCAL-IDEMPOTENT: second invocation must be a no-op
# (fast-path returns when main/ already exists) and leaves the clone as it was.
test.oo.sharedTreeFromLocalIdempotent() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.stree.idem) || { create.result 1 "fixture failed"; return 1; }
  local HOME XDG_CONFIG_HOME GIT_CONFIG_GLOBAL; test.oo.gitconfig.isolate "$fixture"
  mkdir -p "$fixture/source" "$fixture/target"
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo "seed" > README.md && git add . && git commit -q -m "seed"
    git branch dev && git checkout -q dev
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local hash1
  hash1=$(find "$fixture/target" -printf '%p %m\n' 2>/dev/null | sort | sha256sum)

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc2=$?
  local hash2
  hash2=$(find "$fixture/target" -printf '%p %m\n' 2>/dev/null | sort | sha256sum)

  if [ "$rc2" -ne 0 ]; then
    create.result 1 "second call returned $rc2"
  elif [ "$hash1" != "$hash2" ]; then
    create.result 1 "hash mismatch: '$hash1' vs '$hash2'"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "second call no-op"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-SHARED-TREE-FROM-LOCAL-IDEMPOTENT: second invocation is a no-op and keeps the clone" \
  test.oo.realGitconfigUntouched test.oo.sharedTreeFromLocalIdempotent
expect 0 "second call no-op" "private.oo.shared.tree.from.local is idempotent (fast-path on main/ presence), rc 0, the clone untouched"

# T-SHARED-TREE-FROM-LOCAL-BRANCH-MAIN: when branch arg IS main, only main/
# is created (no worktree-add for ../main).
test.oo.sharedTreeFromLocalBranchMain() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.stree.main.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  mkdir -p "$fixture/source" "$fixture/target"
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    echo "seed" > README.md && git add . && git commit -q -m "seed"
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" main ) >/dev/null 2>&1
  local rc=$?

  # main/ should exist; no sibling "main/main" or similar weirdness.
  local extra_dirs
  extra_dirs=$(find "$fixture/target" -maxdepth 1 -mindepth 1 -type d -not -name main -not -name source 2>/dev/null | wc -l)
  if [ "$rc" -eq 0 ] && [ -d "$fixture/target/main/.git" ] && [ "$extra_dirs" -eq 0 ]; then
    create.result 0 "only main/ created"
  else
    create.result 1 "rc=$rc; extra dirs: $(ls $fixture/target 2>&1)"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T-SHARED-TREE-FROM-LOCAL-BRANCH-MAIN: branch=main creates only main/, no spurious worktree" \
  test.oo.sharedTreeFromLocalBranchMain
expect 0 "only main/ created" "private.oo.shared.tree.from.local skips worktree-add when branch == main"

# ============================================================================
# T-SHARED-TREE-CONSUME-*: the <?consumeSource:no> parameter
# ============================================================================
# `oo mode.setup` needs the source removed BETWEEN the copy and the
# branch clone: when the plain clone already sits at <base>/<branch>, the
# clone into <base>/<branch> collides with it (ogit repo.clone refuses a
# non-empty target). Doing it inside the helper
# keeps ONE layout builder and puts the destructive step next to the rc checks
# that already guard the copy. Default `no`, which is what pins install state
# 31's call.
private.test.oo.consume.fixture() { # <fixtureRoot> # a source clone on dev, both branches pushed to a local bare origin + an empty target
  # Pushed with upstreams: consume runs ogit's gate first (T-SETUP-SOURCE-GATE),
  # and a source with unpushed work is kept.
  mkdir -p "$1/source" "$1/target"
  git init -q --bare -b main "$1/origin.git" >/dev/null 2>&1
  (
    cd "$1/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$1/origin.git"
    echo seed > README.md
    git add README.md
    git commit -q -m seed
    git push -q -u origin main
    git branch dev
    git checkout -q dev
    git push -q -u origin dev
  ) >/dev/null 2>&1
}

test.oo.sharedTreeConsumeDefaultKeepsSource() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.consume.keep) || { create.result 1 "fixture failed"; return 1; }
  local HOME XDG_CONFIG_HOME GIT_CONFIG_GLOBAL; test.oo.gitconfig.isolate "$fixture"
  private.test.oo.consume.fixture "$fixture"
  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif [ ! -d "$fixture/source" ]; then
    create.result 1 "the default removed the source — state 31 would lose ~/oosh"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "source kept"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-DEFAULT: without the flag the source survives" \
  test.oo.realGitconfigUntouched test.oo.sharedTreeConsumeDefaultKeepsSource
expect 0 "source kept" "install state 31 passes no third argument — its source is \$HOME/oosh"

test.oo.sharedTreeConsumeRemovesSource() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.consume.yes) || { create.result 1 "fixture failed"; return 1; }
  local HOME XDG_CONFIG_HOME GIT_CONFIG_GLOBAL; test.oo.gitconfig.isolate "$fixture"
  private.test.oo.consume.fixture "$fixture"
  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev yes ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif [ -d "$fixture/source" ]; then
    create.result 1 "the source is still there"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "source consumed"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-YES: the source is removed and the clone layout still lands" \
  test.oo.realGitconfigUntouched test.oo.sharedTreeConsumeRemovesSource
expect 0 "source consumed" "the removal happens between the copy and the branch clone, which is the only safe ordering"

test.oo.sharedTreeConsumeRefusesBadMain() {
  # A source that is NOT a git repository: the copy succeeds, main/.git is
  # absent, and the helper must refuse rather than delete the only copy.
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.consume.bad.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/source" "$fixture/target"
  echo "not a repo" > "$fixture/source/README.md"
  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev yes ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success with a main/ that is not a repository"
  elif [ ! -d "$fixture/source" ]; then
    create.result 1 "it removed the source anyway — the only copy is gone"
  else
    create.result 0 "refused"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-REFUSES: a main/ that is not a repository is not a licence to delete" \
  test.oo.sharedTreeConsumeRefusesBadMain
expect 0 "refused" "verify before destroying — the source may be the only copy"

# The case the parameter exists for: the clone ALREADY sits where the branch
# clone has to go. Without consuming it first, ogit repo.clone refuses an
# existing non-empty path and the whole layout fails. The rebuilt dev/ is the
# helper's own clone: group-shared, which the staged source never was.
test.oo.sharedTreeConsumeSourceInTheWay() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.consume.inway) || { create.result 1 "fixture failed"; return 1; }
  local HOME XDG_CONFIG_HOME GIT_CONFIG_GLOBAL; test.oo.gitconfig.isolate "$fixture"
  mkdir -p "$fixture/base"
  private.test.oo.consume.fixture "$fixture/staging"
  mv "$fixture/staging/source" "$fixture/base/dev"

  ( cd "$fixture/base" && private.oo.shared.tree.from.local "$fixture/base/dev" dev yes ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc with the source in the way"
  elif private.test.oo.stree.cloneShape "$fixture/base" dev; then
    create.result 0 "rebuilt in place"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-IN-THE-WAY: a clone sitting at <base>/<branch> is replaced by the layout's own clone" \
  test.oo.realGitconfigUntouched test.oo.sharedTreeConsumeSourceInTheWay
expect 0 "rebuilt in place" "this is the ordering the parameter exists for — copy, verify, remove, then clone"

# ============================================================================
# T-OO-STATE-34*: install state 34 is the retired login drop-in's cleanup now
# ============================================================================
# boot is gone (dev.config Round 5), and with it private.oo.boot.path.ensure,
# oo boot.fix, oo boot.status and their tests. State 34 keeps its name and its
# number; its check removes the drop-in (T-OO-DROPIN-REMOVE).

# --- T-OO-STATE-34-CHECK-DEFINED ---------------------------------------------------
test.oo.bootPathCheckDefined() {
  if [ "$(type -t private.check.root.boot.path.installed)" = "function" ]; then
    create.result 0 "state 34 guard is defined"
  else
    create.result 1 "private.check.root.boot.path.installed is not a function"
  fi
  return $(result)
}
test.case - "T-OO-STATE-34-CHECK-DEFINED: install state 34's guard (the drop-in cleanup) exists" \
  test.oo.bootPathCheckDefined
expect 0 "state 34 guard is defined" \
  "state.next [34] dispatches to private.check.<stateName> — no guard, no transition"


# ============================================================================
# T-OO-STATE-34: `34 root.boot.path.installed` stays registered, and RENUMBERS NOTHING
# ============================================================================
# state.add treats a NUMERIC argument as a transition marker that jumps the
# index; every other argument takes the current index and then increments it.
# So inserting a named state after `root.installation.done` lands it at 34 and
# pushes only the `state.add 40` MARKER to index 35 — every existing state
# NUMBER, including the ones hard-coded in comments across `oo` and `ossh`, is
# unchanged.
#
# The host's own machine is frozen at first install, so this DECLARES a fresh
# one under a throwaway CONFIG_PATH (state.machine.create + the very state.add
# calls of private.oo.state.machine.create, run on it) and lets the
# real `state` number it — nothing transitions, so no private.check.* runs and
# the shared current.state.machine.env is never touched. A declared-but-never-
# STARTED machine keeps the template placeholder `next.custom.state` after the
# last add (state.machine.start turns it into the 99 transition), hence slot 62.
# ([[project-state-check-resources-script]]).
test.oo.stateMachineNumbering() {
  local tmp adds map expected
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.state34.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  # The states come from private.oo.state.machine.create — the one list
  # private.init.state.machine and oo heal both create the machine from.
  map=$(
    export CONFIG_PATH="$tmp"; mkdir -p "$tmp/stateMachines"
    source "$OOSH_DIR/state" >/dev/null 2>&1
    LOG_LEVEL=0
    private.oo.state.machine.create T34 >/dev/null 2>&1
    # shellcheck disable=SC1090
    source "$tmp/stateMachines/T34.states.env" 2>/dev/null
    for i in "${!T34_STATES[@]}"; do [ "$i" -ge 11 ] && echo "$i=${T34_STATES[$i]}"; done | sort -n
  )
  rm -rf "$tmp"
  # The FULL expected map. Any renumbering of any state breaks this literally.
  expected="11=remote.install.started
12=local.install.started
13=priviledges.checked
14=20
20=user.rights.only
21=user.installation.done
22=user.mode.release
23=user.mode.dev
24=30
30=root.rights
31=root.shared.dev.folder.created
32=root.dev.keys.installed
33=root.installation.done
34=root.boot.path.installed
35=40
40=user.shared.dev.folder.linked
41=user.state.machine.synced.with.root
42=50
50=headless.setup.started
51=headless.setup.finished
52=60
60=once.setup.started
61=once.setup.finished
62=next.custom.state
99=finished
100=6"
  if [ "$map" = "$expected" ]; then
    create.result 0 "state 34 registered, no state renumbered"
  else
    create.result 1 "state map drifted: $(diff <(echo "$expected") <(echo "$map") | tr '\n' ' ')"
  fi
  return $(result)
}
test.case - "T-OO-STATE-34: root.boot.path.installed stays state 34 (the drop-in cleanup) and nothing else moves" \
  test.oo.stateMachineNumbering
expect 0 "state 34 registered, no state renumbered" \
  "state numbers are hard-coded in comments across oo and ossh — they must not shift"


# ============================================================================
# T-OO-PATH-SUDO-GET — the one privilege rule private.oo.dropin.remove removes with
# ============================================================================

# --- T-OO-PATH-SUDO-GET ------------------------------------------------------------
# The one privilege rule: writable -> no prefix; root ($SUDO "") -> no
# prefix; otherwise $SUDO, or `sudo -n ` in quiet mode (never a password
# prompt). The "not writable" answer comes from the collaborator
# private.oo.path.writable.is, stubbed here: root may write anything, so a
# chmod 500 fixture cannot say no to root — the old version of this test
# compared "" with "" as root and asserted nothing there.
test.oo.pathSudoGet() {
  local fx bad="" got; fx=$(test.suite.fixture.make sudoget)
  got=$(SUDO="sudo "; private.oo.path.sudo.get "$fx");             [ -z "$got" ] || bad="$bad writable=[$got]"
  got=$(SUDO="sudo "; private.oo.path.sudo.get "$fx/new/deeper");  [ -z "$got" ] || bad="$bad missing-under-writable=[$got]"
  got=$(SUDO="sudo "; private.oo.path.writable.is() { return 1; }; private.oo.path.sudo.get "$fx");        [ "$got" = "sudo " ] || bad="$bad user=[$got]"
  got=$(SUDO="sudo "; private.oo.path.writable.is() { return 1; }; private.oo.path.sudo.get "$fx" quiet);  [ "$got" = "sudo -n " ] || bad="$bad user-quiet=[$got]"
  got=$(SUDO="";      private.oo.path.writable.is() { return 1; }; private.oo.path.sudo.get "$fx");        [ -z "$got" ] || bad="$bad root=[$got]"
  got=$(SUDO="";      private.oo.path.writable.is() { return 1; }; private.oo.path.sudo.get "$fx" quiet);  [ -z "$got" ] || bad="$bad root-quiet=[$got]"
  rm -rf "$fx"
  if [ -z "$bad" ]; then
    create.result 0 "sudo prefix follows writability and \$SUDO; quiet is sudo -n"
  else
    create.result 1 "private.oo.path.sudo.get wrong:$bad"
  fi
  return $(result)
}
test.case - "T-OO-PATH-SUDO-GET: private.oo.path.sudo.get prefixes only what this user cannot write" \
  test.oo.pathSudoGet
expect 0 "sudo prefix follows writability and \$SUDO; quiet is sudo -n" \
  "the drop-in cleanup removes with ONE privilege rule, built on \$SUDO"

# --- T-OO-PRIVILEGE-QUIET ----------------------------------------------------
# One oo update, one privilege rule: the drop-in cleanup and the launcher
# install both ask private.oo.path.sudo.get in quiet mode — `sudo -n`, never a
# password prompt. The drop-in used plain `sudo ` and asked a normal user for a
# password on a host that still had /etc/profile.d/oosh.sh; the launcher had a
# writability walk of its own. A recording sudo that fails; the "cannot
# write" answer is the stubbed collaborator, so root and a user see the same.
test.oo.privilegeQuiet() {
  local fx bad="" calls; fx=$(test.suite.fixture.make privquiet); mkdir -p "$fx/bin" "$fx/profiled"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  printf '%s\n' '# oosh — host-wide login-shell bootstrap. MANAGED FILE: written by install' > "$fx/profiled/oosh.sh"
  ( PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"
    private.oo.path.writable.is() { return 1; }
    private.oo.dropin.remove "$fx/etcoosh" "$fx/profiled"
    private.oo.install.launcher "$OOSH_DIR" "$fx/usrlocalbin/this" ) >/dev/null 2>&1
  calls=$(tr '\n' '|' < "$fx/sudo.calls" 2>/dev/null)
  case "|$calls" in (*"|-n rm -f $fx/profiled/oosh.sh|"*) ;; (*) bad="$bad dropin=[$calls]" ;; esac
  case "|$calls" in (*"|-n mkdir -p $fx/usrlocalbin|"*) ;; (*) bad="$bad launcher=[$calls]" ;; esac
  grep -v '^-n ' "$fx/sudo.calls" 2>/dev/null | grep -q . && bad="$bad may-prompt=[$(grep -v '^-n ' "$fx/sudo.calls" | tr '\n' '|')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "drop-in cleanup and launcher install both use sudo -n" || create.result 1 "privilege:$bad"
  return $(result)
}
test.case $level "T-OO-PRIVILEGE-QUIET: oo update's drop-in cleanup and launcher install never prompt for a password" test.oo.privilegeQuiet
expect 0 "drop-in cleanup and launcher install both use sudo -n" \
  "private.oo.dropin.remove used plain sudo and prompted a normal user during oo update"



# ============================================================================
# T-CMD-* — oo.cmd's result contract
# ============================================================================
# oo.cmd reported success unconditionally: its last statement was a bare
# `RETURN=$1` assignment, so its exit status was that of a variable assignment
# — always 0, whatever the package manager did. `oo cmd mc` shelled out and
# reported success when the package did not exist, the network was down, sudo
# was denied, or OOSH_PM was empty. Three callers check the status and could
# never fire.
#
# Driven through a PATH shim that LOGS ITS ARGV, so "the PM was never invoked"
# is an assertion with a diagnostic rather than a bare sentinel. OOSH_PM is
# pinned in every case: left empty, oo.cmd calls oo.pm.discover, which does a
# real `config save` (the apt refresh is T-OO-CMD-REFRESH-ONCE's, on a fixture).
# CONFIG_PATH is passed through from this file's fixture (test.suite.config.isolate
# at the top), never env -i'd away, so the child cannot reach the shared tier.

test.oo.cmd.fixture() { # <stubDir> # a fake package manager that records every call and exits $PM_RC
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' 'exit ${PM_RC:-0}' > "$1/fakepm"
  chmod +x "$1/fakepm"
}

test.oo.cmd.fixture.apt() { # <stubDir> # a fake apt-get that records its ARGV *and* the debconf-relevant env
  # Named apt-get on purpose, so `case "$OOSH_PM" in apt-get*)` inside oo.cmd
  # actually fires — the fakepm stub the other T-CMD cases pin deliberately
  # does not match it, which is why this needs its own stub rather than a
  # tweak to test.oo.cmd.fixture (six cases depend on that one unchanged).
  printf '%s\n' '#!/bin/sh' \
    'echo "argv=$*" >> "$PM_LOG"' \
    'echo "DEBIAN_FRONTEND=[${DEBIAN_FRONTEND-unset}]" >> "$PM_LOG"' \
    'exit ${PM_RC:-0}' > "$1/apt-get"
  chmod +x "$1/apt-get"
}

test.oo.cmd.fixture.brew() { # <stubDir> # a fake brew that records its ARGV *and* HOMEBREW_NO_ASK
  # Named brew on purpose: oo.cmd's brew branch calls `brew install` by name,
  # not through $OOSH_PM, so only a stub called brew is ever reached.
  printf '%s\n' '#!/bin/sh' \
    'echo "argv=$*" >> "$PM_LOG"' \
    'echo "HOMEBREW_NO_ASK=[${HOMEBREW_NO_ASK-unset}]" >> "$PM_LOG"' \
    'exit ${PM_RC:-0}' > "$1/brew"
  chmod +x "$1/brew"
}

test.oo.cmd.run() { # <stubDir> <pmRc> <noPm> <args...> # run oo.cmd in a pinned child; echo "rc|RESULT"
  local stub="$1" pmRc="$2" noPm="$3"; shift 3
  local pmPin='OOSH_PM="fakepm install"'
  [ "$noPm" = "noPm" ] && pmPin='OOSH_PM=""; oo.pm.discover() { :; }'
  [ "$noPm" = "aptPm" ] && pmPin='OOSH_PM="apt-get -y install"'
  # SUDO_USER unset pins oo.cmd's direct brew branch. With it set (root's leg
  # of the platform test) oo.cmd hops through `sudo -u`, whose secure_path
  # drops $stub from PATH and the fake brew is never reached.
  [ "$noPm" = "brewPm" ] && pmPin='OOSH_PM="brew install"; unset SUDO_USER'
  # TEST_OO_CMD_OVERRIDE, when set, is spliced in AFTER the real oo is sourced.
  # The negative controls below use it to plant the ORIGINAL defect as an
  # oo.cmd override and prove the test function above catches it.
  # These tests ARE about installing (with a stand-in package manager): the
  # test run's OOSH_NO_INSTALL is lifted (T-CMD-NO-INSTALL).
  env -u OOSH_NO_INSTALL PATH="$stub:$PATH" HOME="$HOME" LOG_LEVEL=0 SUDO="" \
      PM_LOG="$stub/pm.calls" PM_RC="$pmRc" \
      CONFIG_PATH="$CONFIG_PATH" CONFIG="$CONFIG" CONFIG_FILE="$CONFIG_FILE" \
      bash -c '
        source "$OOSH_DIR/this" >/dev/null 2>&1
        source "$OOSH_DIR/oo"   >/dev/null 2>&1
        '"$pmPin"'
        '"${TEST_OO_CMD_OVERRIDE:-:}"'
        oo.cmd "$@" >/dev/null 2>&1
        printf "%s|%s" "$?" "$RESULT"' _ "$@"
}

test.oo.cmd.control() { # <caseName> <plantedOverride> <testFunction> <expectedFailurePrefix> # negative control: with the defect planted as an oo.cmd override, the test function must FAIL with the named diagnosis
  # Runs its own test.case + expect (the T-OSSH-PREREQS-* idiom) because
  # test.case word-splits $testArguments — a quoted override with spaces cannot
  # travel through it as one argument.
  local name="$1" fn="$3" want="$4" rc res
  test.case $level "$name" echo "(negative control: plant the original defect, expect the test above to catch it)"
  TEST_OO_CMD_OVERRIDE="$2"
  $fn; rc=$?; res="$RESULT"
  unset TEST_OO_CMD_OVERRIDE
  if [ "$rc" -ne 0 ] && [ "${res#"$want"}" != "$res" ]; then
    expect.pass "control caught: $want"
  else
    expect.fail "planted defect NOT caught by $fn (rc=$rc RESULT=[$res])"
  fi
}

# --- T-CMD-PM-FAILS ---------------------------------------------------------
test.oo.cmdPmFails() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.fail.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  local got; got=$(test.oo.cmd.run "$stub" 1 withPm ooshNoSuchTool)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "reported success though the package manager exited 1 (RESULT=[$res])"
  elif [ "${res#*ooshNoSuchTool}" = "$res" ]; then
    create.result 1 "failed but \$RESULT does not name the tool: [$res]"
  else
    create.result 0 "a failing package manager is reported"
  fi
  return $(result)
}
test.case $level "T-CMD-PM-FAILS: a failing package manager is reported, and names the tool" \
  test.oo.cmdPmFails
expect 0 "a failing package manager is reported" \
  "oo cmd reported success unconditionally — three callers check its status and could never fire"

# --- T-CMD-VERIFY-AFTER-INSTALL --------------------------------------------
test.oo.cmdVerifyAfterInstall() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.verify.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  # PM exits 0 but installs nothing — the command is still absent afterwards
  local got; got=$(test.oo.cmd.run "$stub" 0 withPm ooshNoSuchTool)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "package manager said OK and the command is still absent, but oo.cmd reported success (RESULT=[$res])"
  else
    create.result 0 "installing without landing the command is a failure"
  fi
  return $(result)
}
test.case $level "T-CMD-VERIFY-AFTER-INSTALL: PM says OK but the command is still missing" \
  test.oo.cmdVerifyAfterInstall
expect 0 "installing without landing the command is a failure" \
  "the post-condition oo.cmd's own comment deferred to ossh.prereqs.install for"

# --- T-CMD-ALREADY-PRESENT --------------------------------------------------
test.oo.cmdAlreadyPresent() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.present.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  local got; got=$(test.oo.cmd.run "$stub" 0 withPm sh)
  local rc="${got%%|*}"
  local calls=""; [ -s "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ -n "$calls" ]; then
    create.result 1 "invoked the package manager for an already-present command: [$calls]"
  elif [ "$rc" != "0" ]; then
    create.result 1 "an already-present command reported rc=$rc"
  else
    create.result 0 "already present is success, PM never invoked"
  fi
  return $(result)
}
test.case $level "T-CMD-ALREADY-PRESENT: no work, no package manager, rc 0" \
  test.oo.cmdAlreadyPresent
expect 0 "already present is success, PM never invoked" \
  "idempotency is the documented contract — every caller relies on it"

# --- T-CMD-NO-PM ------------------------------------------------------------
test.oo.cmdNoPm() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.nopm.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  local got; got=$(test.oo.cmd.run "$stub" 0 noPm ooshNoSuchTool)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "no package manager at all, yet reported success (RESULT=[$res])"
  else
    create.result 0 "no package manager is a failure"
  fi
  return $(result)
}
test.case $level "T-CMD-NO-PM: nothing can be installed, so nothing succeeded" \
  test.oo.cmdNoPm
expect 0 "no package manager is a failure" \
  "it used to console.log 'no package manger' and exit 0"

# --- T-CMD-TWO-ARG ----------------------------------------------------------
test.oo.cmdTwoArg() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.twoarg.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  # <cmd> <packageName> — the documented two-argument form
  test.oo.cmd.run "$stub" 0 withPm ooshNoSuchTool ooshNoSuchPackage >/dev/null
  local calls=""; [ -f "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ "${calls#*ooshNoSuchPackage}" = "$calls" ]; then
    create.result 1 "the package name never reached the package manager: [$calls]"
  else
    create.result 0 "the package name reaches the package manager"
  fi
  return $(result)
}
test.case $level "T-CMD-TWO-ARG: oo.cmd <cmd> <packageName> installs the PACKAGE" \
  test.oo.cmdTwoArg
expect 0 "the package name reaches the package manager" \
  "the second argument was shifted away and lost — oo.cmd installs nothing"

# --- T-CMD-NO-INSTALL -------------------------------------------------------
# test.suite exports OOSH_NO_INSTALL=1 for every test file. oo.cmd is the one
# door every install goes through, so it is the one that refuses: no package
# manager, no sudo, rc 1. Without the variable (the control) the same call
# reaches the package manager through sudo.
test.oo.cmdNoInstall() { # <noInstall:1|lifted> # echo "rc|RESULT|pm calls|sudo calls" of oo.cmd ooshNoSuchTool
  local fx; fx=$(test.suite.fixture.make cmdnoinstall)
  test.oo.cmd.fixture "$fx"
  printf '%s\n' '#!/bin/sh' 'echo "sudo $*" >> "$SUDO_LOG"' 'exec "$@"' > "$fx/sudo"; chmod +x "$fx/sudo"
  local lift="-u OOSH_NO_INSTALL" set=""
  [ "$1" = 1 ] && { lift=""; set="OOSH_NO_INSTALL=1"; }
  local got; got=$(env $lift $set PATH="$fx:$PATH" HOME="$HOME" LOG_LEVEL=0 SUDO="sudo " \
      PM_LOG="$fx/pm.calls" SUDO_LOG="$fx/sudo.calls" \
      CONFIG_PATH="$CONFIG_PATH" CONFIG="$CONFIG" CONFIG_FILE="$CONFIG_FILE" \
      bash -c '
        source "$OOSH_DIR/this" >/dev/null 2>&1
        source "$OOSH_DIR/oo"   >/dev/null 2>&1
        OOSH_PM="fakepm install"
        oo.cmd ooshNoSuchTool >/dev/null 2>&1
        printf "%s|%s" "$?" "$RESULT"' </dev/null)
  printf '%s|%s|%s' "$got" "$(tr '\n' ' ' < "$fx/pm.calls" 2>/dev/null)" "$(tr '\n' ' ' < "$fx/sudo.calls" 2>/dev/null)"
  rm -rf "$fx"
}
test.oo.cmdNoInstallCheck() {
  local bad="" got
  got=$(test.oo.cmdNoInstall 1)
  [ "$got" = "1|ooshNoSuchTool missing — a test run installs nothing||" ] || bad="$bad noInstall=[$got]"
  got=$(test.oo.cmdNoInstall lifted)
  case "$got" in
    (*"|install ooshNoSuchTool |sudo fakepm install ooshNoSuchTool ") ;;
    (*) bad="$bad control=[$got]" ;;
  esac
  [ -z "$bad" ] && create.result 0 "under OOSH_NO_INSTALL oo.cmd calls no package manager and no sudo" || create.result 1 "no install:$bad"
  return $(result)
}
test.case $level "T-CMD-NO-INSTALL: under OOSH_NO_INSTALL oo.cmd refuses — no package manager, no sudo, rc 1" \
  test.oo.cmdNoInstallCheck
expect 0 "under OOSH_NO_INSTALL oo.cmd calls no package manager and no sudo" \
  "state (oo cmd vim), config and ossh.prereqs.install installed and ran sudo during a test run"

# --- T-CMD-APT-NONINTERACTIVE -----------------------------------------------
# `oo cmd vim` on a naked ubuntu:24.04 hung forever: apt pulled tzdata, and
# tzdata's debconf postinst blocked in anon_pipe_read waiting for an answer to
# "Geographic area:" that no unattended installer can give. The install wedged
# with no output after "no vim", and a 5-minute watcher timed out rather than
# ever seeing the end banner.
#
# `-y` does not cover this — -y answers apt's own prompt, debconf is a separate
# questioner inside the maintainer script. And the variable has to cross the
# sudo boundary via `env`: $SUDO is "sudo ", and sudo's env_reset drops a plain
# shell-assignment prefix, so `DEBIAN_FRONTEND=x $SUDO apt-get …` would never
# reach apt at all.
test.oo.cmdAptNonInteractive() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.apt.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture.apt "$stub"
  test.oo.cmd.run "$stub" 0 aptPm ooshNoSuchTool ooshNoSuchPackage >/dev/null
  local calls=""; [ -f "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ -z "$calls" ]; then
    create.result 1 "the apt-get stub was never invoked — the guard or the stub PATH is wrong"
  elif [ "${calls#*DEBIAN_FRONTEND=\[noninteractive\]}" = "$calls" ]; then
    create.result 1 "DEBIAN_FRONTEND did not reach apt — tzdata will hang the install: [$calls]"
  elif [ "${calls#*ooshNoSuchPackage}" = "$calls" ]; then
    create.result 1 "the env prefix swallowed the package name: [$calls]"
  else
    create.result 0 "an apt-like PM is invoked non-interactively, with the package intact"
  fi
  return $(result)
}
test.case $level "T-CMD-APT-NONINTERACTIVE: apt-like package managers are invoked with DEBIAN_FRONTEND set" \
  test.oo.cmdAptNonInteractive
expect 0 "an apt-like PM is invoked non-interactively, with the package intact" \
  "oo cmd vim wedged forever on tzdata's 'Geographic area' prompt in a naked ubuntu:24.04"

# --- T-CMD-BREW-NONINTERACTIVE ----------------------------------------------
# `brew install bash` on a virgin Sequoia tart VM stopped at "Do you want to
# proceed? [y/n]" and waited forever. Homebrew 6 made ask mode the default for
# install/upgrade/reinstall: it prompts when there is a TTY and the plan pulls
# in dependencies (bash does). HOMEBREW_NO_ASK=1 is the documented opt-out.
# NONINTERACTIVE=1 is NOT — only Homebrew's bootstrap install.sh reads it.
# GHA runners never saw this: they ship bash 5, so no brew install ran.
# Only the direct branch is exercised (the brewPm pin unsets SUDO_USER); the
# root -> `sudo -u $SUDO_USER` branch resets PATH, so no stub can reach it.
# Its init/oosh twin is pinned by grep in test/test.install instead.
test.oo.cmdBrewNonInteractive() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.brew.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture.brew "$stub"
  test.oo.cmd.run "$stub" 0 brewPm ooshNoSuchTool ooshNoSuchPackage >/dev/null
  local calls=""; [ -f "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ -z "$calls" ]; then
    create.result 1 "the brew stub was never invoked — the guard or the stub PATH is wrong"
  elif [ "${calls#*HOMEBREW_NO_ASK=\[1\]}" = "$calls" ]; then
    create.result 1 "HOMEBREW_NO_ASK did not reach brew — a fresh macOS waits on 'proceed? [y/n]': [$calls]"
  elif [ "${calls#*ooshNoSuchPackage}" = "$calls" ]; then
    create.result 1 "the env prefix swallowed the package name: [$calls]"
  else
    create.result 0 "brew is invoked with ask mode off, with the package intact"
  fi
  return $(result)
}
test.case $level "T-CMD-BREW-NONINTERACTIVE: brew install runs with HOMEBREW_NO_ASK set" \
  test.oo.cmdBrewNonInteractive
expect 0 "brew is invoked with ask mode off, with the package intact" \
  "a fresh Sequoia install hung forever on brew's default ask-mode prompt"

# --- T-PM-ENV-GET -----------------------------------------------------------
# One table for the non-interactive prefix, shared by oo.cmd and
# oo.prereqs.install (init/oosh keeps a POSIX twin — it cannot source oo).
# A getter consumed as $(...), so it is judged on what it ECHOES: the
# method.new scaffold's `expect 0 "<value>"` compares $RESULT, which a getter
# never sets, and would pass whatever the table said.
test.oo.pmEnvGet() {
  local got bad=""
  got=$(private.oo.pm.env.get "apt-get -y install")
  # LC_ALL / DEBCONF_NOWARNINGS: a login's LANG the system lacks made perl
  # warn on every install, debconf noted apt-utils (Debian 12, 2026-10-06).
  [ "$got" = "env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes" ] || bad="$bad apt=[$got]"
  got=$(private.oo.pm.env.get "brew install")
  [ "$got" = "env HOMEBREW_NO_ASK=1" ] || bad="$bad brew=[$got]"
  got=$(private.oo.pm.env.get "apk add")
  [ -z "$got" ] || bad="$bad apk=[$got]"
  got=$(OOSH_PM="brew install"; private.oo.pm.env.get)
  [ "$got" = "env HOMEBREW_NO_ASK=1" ] || bad="$bad default=[$got]"
  if [ -n "$bad" ]; then
    create.result 1 "wrong prefix:$bad"
  else
    create.result 0 "apt and brew get their prefix, other PMs none, \$OOSH_PM is the default"
  fi
  return $(result)
}
test.case $level "T-PM-ENV-GET: private.oo.pm.env.get maps each PM to its non-interactive prefix" \
  test.oo.pmEnvGet
expect 0 "apt and brew get their prefix, other PMs none, \$OOSH_PM is the default" \
  "the prefix table lived in two places in oo and a third in init/oosh"

# --- T-PREREQS-BASH-NONINTERACTIVE -------------------------------------------
# oo.prereqs.install's bash-4 upgrade bypasses oo.cmd (whose existence check
# would no-op on macOS's /bin/bash 3.2), so it needs the prefix itself. The
# apt arm had none: the tzdata hang of 899358e, one function over. Structural,
# because the branch only runs under bash < 4 and BASH_VERSINFO is readonly.
test.oo.prereqsBashNonInteractive() {
  local body; body=$(declare -f oo.prereqs.install)
  local calls; calls=$(printf '%s\n' "$body" | grep -E '\$OOSH_PM bash')
  if [ -z "$calls" ]; then
    create.result 1 "no \$OOSH_PM bash call found — the test no longer sees the upgrade"
  elif printf '%s\n' "$calls" | grep -vq 'private.oo.pm.install.prefix.get'; then
    create.result 1 "a bash upgrade runs without the non-interactive prefix: $(printf '%s' "$calls" | tr '\n' ' ')"
  else
    create.result 0 "every PM arm of the bash upgrade takes its prefix from private.oo.pm.install.prefix.get"
  fi
  return $(result)
}
test.case $level "T-PREREQS-BASH-NONINTERACTIVE: oo.prereqs.install upgrades bash non-interactively on every PM" \
  test.oo.prereqsBashNonInteractive
expect 0 "every PM arm of the bash upgrade takes its prefix from private.oo.pm.install.prefix.get" \
  "the apt arm of the bash upgrade had no DEBIAN_FRONTEND — tzdata would hang it"

# --- T-CMD-DEAD-BRANCH ------------------------------------------------------
test.oo.cmdDeadBranch() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.dead.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  # mkcert delegates to once.su.mkcert.install, which is defined nowhere
  local got; got=$(test.oo.cmd.run "$stub" 0 withPm mkcert)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "a branch whose installer does not exist reported success (RESULT=[$res])"
  else
    create.result 0 "a branch that cannot work says so"
  fi
  return $(result)
}
test.case $level "T-CMD-DEAD-BRANCH: mkcert delegates to a command that does not exist" \
  test.oo.cmdDeadBranch
expect 0 "a branch that cannot work says so" \
  "once, private.stage and once.su.mkcert.install are defined nowhere in this tree"

# --- T-CMD-CONTROL-* — one negative control per T-CMD assertion ------------
# Each plants the ORIGINAL defect as an oo.cmd override in the same shim and
# asserts the test function above goes red with its specific diagnosis. A test
# nobody has watched fail is not a test (standing verification bar).
test.oo.cmd.control "T-CMD-CONTROL-PM-FAILS: a bare RETURN=\$1 tail (always rc 0) is caught" \
  'oo.cmd() { $OOSH_PM "$1"; RETURN=$1; }' \
  test.oo.cmdPmFails "reported success though the package manager exited 1"

test.oo.cmd.control "T-CMD-CONTROL-VERIFY: trusting the PM without re-verifying is caught" \
  'oo.cmd() { $OOSH_PM "$1" && create.result 0 "installed"; return $(result); }' \
  test.oo.cmdVerifyAfterInstall "package manager said OK and the command is still absent"

test.oo.cmd.control "T-CMD-CONTROL-PRESENT: dropping the already-present short-circuit is caught" \
  'oo.cmd() { $OOSH_PM "$1"; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdAlreadyPresent "invoked the package manager for an already-present command"

test.oo.cmd.control "T-CMD-CONTROL-NO-PM: the old console.log-and-exit-0 on a missing PM is caught" \
  'oo.cmd() { create.result 0 "no package manger"; return $(result); }' \
  test.oo.cmdNoPm "no package manager at all, yet reported success"

test.oo.cmd.control "T-CMD-CONTROL-TWO-ARG: the double shift that lost the package name is caught" \
  'oo.cmd() { shift; shift; $OOSH_PM "$1"; create.result 1 "x"; return $(result); }' \
  test.oo.cmdTwoArg "the package name never reached the package manager"

test.oo.cmd.control "T-CMD-CONTROL-DEAD-BRANCH: calling an undefined installer and reporting success is caught" \
  'oo.cmd() { once.su.mkcert.install; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdDeadBranch "a branch whose installer does not exist reported success"

test.oo.cmd.control "T-CMD-CONTROL-APT-INTERACTIVE: the bare \$SUDO \$OOSH_PM call that hung on tzdata is caught" \
  'oo.cmd() { $SUDO $OOSH_PM "$2"; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdAptNonInteractive "DEBIAN_FRONTEND did not reach apt"

test.oo.cmd.control "T-CMD-CONTROL-BREW-ASK: the bare brew install that hung on a fresh macOS is caught" \
  'oo.cmd() { brew install "$2"; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdBrewNonInteractive "HOMEBREW_NO_ASK did not reach brew"

# ============================================================================
# T-METHOD-* — `oo method.new` actually produces a usable method
# ============================================================================
# The project mandates template-driven method creation
# (docs/first-principles.md, docs/command-creation.md), but every method in
# this tree is hand-written because the tool was half-broken: it shipped the
# template's placeholder docstring, mangled the usage table to
# `<method>------`, dropped every name segment after the second, and emitted
# no completion function. The docstring is the metadata this.help renders and
# c2 completes from, so a method born without it is broken by the project's
# own Method Structure Standard.

test.oo.method.probe.clean() { # <probe> # remove a throwaway script, its test, and any transaction leftovers
  rm -f "$OOSH_DIR/$1" "$OOSH_DIR/$1.new" "$OOSH_DIR/$1.bak" \
        "$OOSH_DIR/test/test.$1" "$OOSH_DIR/test/test.$1.new" "$OOSH_DIR/test/test.$1.bak" 2>/dev/null
}

test.oo.method.probe.make() { # <probe> # a throwaway script + test from the templates, via the real oo.new
  test.oo.method.probe.clean "$1"
  ( LOG_LEVEL=1 oo.new "$1" ) >/dev/null 2>&1
  [ -f "$OOSH_DIR/$1" ] && [ -f "$OOSH_DIR/test/test.$1" ]
}

# --- T-METHOD-NEW-DOCSTRING -------------------------------------------------
test.oo.methodNewWritesDocstring() {
  local probe="probeMethodNewScript" pwdBefore="$PWD"
  # oo.new and private.oo.new.test both `cd`, so the caller's directory has to
  # be put back by hand.
  if ! test.oo.method.probe.make "$probe"; then
    cd "$pwdBefore"; test.oo.method.probe.clean "$probe"
    create.result 1 "oo.new did not create $probe and its test"
    return $(result)
  fi
  printf '%s\n' '<branch> <?force:no>' 'switches to a branch, safely' \
                 'a probe test' 'probeArg' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "$probe.probeThing" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local docline mangled untouchedExamples stub testcase
  docline=$(grep -F "$probe.probeThing()" "$OOSH_DIR/$probe" 2>/dev/null | head -1)
  # The mangling signature is a NAME run straight into dashes — `probeThing------`
  # — produced by the first-match-anywhere sed that used to chew the Examples
  # block. The template's own plain dashed rule is not residue: the tool does
  # not touch the usage table at all any more, so that line must survive intact.
  mangled=$(grep -c -E '^[[:space:]]*[A-Za-z][A-Za-z0-9.]*-{3,}' "$OOSH_DIR/$probe" 2>/dev/null)
  untouchedExamples=$(grep -c -E '^[[:space:]]*-{4,}[[:space:]]*$' "$OOSH_DIR/$probe" 2>/dev/null)
  stub=$(grep -c "^$probe.probeThing.completion.branch()" "$OOSH_DIR/$probe" 2>/dev/null)
  testcase=$(grep -c 'a probe test' "$OOSH_DIR/test/test.$probe" 2>/dev/null)
  test.oo.method.probe.clean "$probe"

  if ! echo "$docline" | grep -Fq '# <branch> <?force:no> # switches to a branch, safely #'; then
    create.result 1 "the typed metadata never reached the docstring: [$docline]"
  elif [ "$mangled" != "0" ]; then
    create.result 1 "the usage/Examples block was mangled ($mangled line(s) of the probeThing------ shape)"
  elif [ "$untouchedExamples" = "0" ]; then
    create.result 1 "the template's Examples rule is gone — the tool is still editing the usage table"
  elif [ "$stub" = "0" ]; then
    create.result 1 "no completion function for <branch> — the method cannot tab-complete"
  elif [ "$testcase" = "0" ]; then
    create.result 1 "the test case was not written into test.$probe"
  else
    create.result 0 "docstring, completion and test case all carry the typed metadata"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-DOCSTRING: the typed parameters and description land in the docstring, with a completion stub" \
  test.oo.methodNewWritesDocstring
expect 0 "docstring, completion and test case all carry the typed metadata" \
  "the docstring is what this.help renders and c2 completes from — it must never ship a placeholder"

# --- T-METHOD-NEW-MULTISEGMENT ----------------------------------------------
test.oo.methodNewMultiSegment() {
  local probe="probeMultiSegScript" pwdBefore="$PWD"
  if ! test.oo.method.probe.make "$probe"; then
    cd "$pwdBefore"; test.oo.method.probe.clean "$probe"
    create.result 1 "oo.new did not create $probe and its test"
    return $(result)
  fi
  printf '%s\n' '<host>' 'updates the certificates for a host' \
                 'a probe test' 'probeHost' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "$probe.certificates.update.run" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local full truncated
  full=$(grep -c "^$probe.certificates.update.run()" "$OOSH_DIR/$probe" 2>/dev/null)
  truncated=$(grep -c "^$probe.certificates()" "$OOSH_DIR/$probe" 2>/dev/null)
  test.oo.method.probe.clean "$probe"

  if [ "$truncated" != "0" ]; then
    create.result 1 "the name was truncated to $probe.certificates() — every segment after the second was dropped"
  elif [ "$full" != "1" ]; then
    create.result 1 "$probe.certificates.update.run() was not created (found $full)"
  else
    create.result 0 "every dot segment survives into the method name"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-MULTISEGMENT: oo method.new <script>.a.b.c creates a.b.c, not a" \
  test.oo.methodNewMultiSegment
expect 0 "every dot segment survives into the method name" \
  "deep hierarchy is explicitly blessed by the naming standard — hiveMind.team.context.status()"

# --- T-DOCS-NAME-DRIFT ------------------------------------------------------
# 2fe5133 renamed oo.new.method to oo.method.new in March 2026 and updated two
# documentation lines. Seventeen references stayed wrong for six months, so the
# documented route into this tooling did not dispatch for anyone who followed it.
test.oo.docsNameNoDrift() {
  local missing="" doc cmd method
  for doc in "$OOSH_DIR"/docs/*.md; do
    [ -f "$doc" ] || continue
    for cmd in $(grep -ohE '(^[[:space:]]*([0-9]+\.[[:space:]]*)?\.?/?oo |`\.?/?oo )[a-z][a-zA-Z0-9]*(\.[a-zA-Z0-9]+)*' "$doc" 2>/dev/null \
                 | sed -E 's/.*oo //' | sort -u); do
      method="oo.$cmd"
      grep -qE "^(private\.)?${method//./\.}\(\)" "$OOSH_DIR/oo" || missing="$missing
    $(basename "$doc"): oo $cmd"
    done
  done
  if [ -z "$(echo "$missing" | tr -d '[:space:]')" ]; then
    create.result 0 "every documented oo command exists"
  else
    create.result 1 "docs name commands that oo does not define:$missing"
  fi
  return $(result)
}
test.case $level "T-DOCS-NAME-DRIFT: every oo command named in docs/ is actually defined" \
  test.oo.docsNameNoDrift
expect 0 "every documented oo command exists" \
  "a rename must update the docs — 2fe5133 did not, and it went unnoticed for six months"

# ============================================================================
# T-MODE-RELEASE-* — the release lane asks about the branch, not a mode word
# ============================================================================
# OOSH_MODE carried two kinds of value: a branch name, written by `oo mode`,
# and the literal word "released", written by promote AFTER it had already
# checked the tree back out to dev. Its sibling lane asserts "dev", so a box
# could satisfy only one of the two — and on a genuinely released box, where
# `oo mode prod` had set the branch name, the release lane failed anyway.
#
# A released install is one sitting on the prod branch. The lane keeps its
# purpose and asks the right question; promote's write is gone, because it was
# recording a developer-box event into a variable that describes an installed
# machine.
test.oo.modeRelease() { # <modeValue> # rc of private.check.user.mode.release with OOSH_MODE=<modeValue>
  local saved="$OOSH_MODE"
  export OOSH_MODE="$1"
  private.check.user.mode.release >/dev/null 2>&1
  local rc=$?
  export OOSH_MODE="$saved"
  return $rc
}

test.oo.modeReleaseChecksProd() {
  if ! test.oo.modeRelease prod; then
    create.result 1 "a prod box is not accepted as released"
  elif test.oo.modeRelease dev; then
    create.result 1 "a dev box was accepted as released"
  elif test.oo.modeRelease released; then
    create.result 1 "the old mode word 'released' still satisfies the check — OOSH_MODE is meant to be a branch now"
  else
    create.result 0 "released means: on the prod branch"
  fi
  return $(result)
}
test.case $level "T-MODE-RELEASE-CHECKS-PROD: the release lane accepts prod, rejects dev and the old mode word" \
  test.oo.modeReleaseChecksProd
expect 0 "released means: on the prod branch" \
  "OOSH_MODE is the branch the host is on; 'released' was an event recorded in the wrong variable"


# ============================================================================
# T-METHOD-DELETE — the counterpart of oo method.new
# ============================================================================
# oo had `oo new`, `oo test.new` and `oo method.new`, and nothing that removed
# a method. Deleting one by hand takes the body and leaves the docstring's
# completion functions behind — which is how `path` came to carry completion
# functions for verbs it no longer had. The fixture is a throwaway script in
# $OOSH_DIR, because the tool addresses scripts as $OOSH_DIR/<script>.
MD_SCRIPT="testMethodDeleteFixture$$"   # dot-free: <script.method> splits on the FIRST dot
MD_FILE="$OOSH_DIR/$MD_SCRIPT"

private.test.oo.method.delete.fixture() { # # write the throwaway script under test
  cat > "$MD_FILE" <<FIXTURE
#!/usr/bin/env bash

$MD_SCRIPT.keep() # <dir> # a method that must survive
{
  echo keep
}
$MD_SCRIPT.keep.completion.dir() { echo "/tmp"; }

$MD_SCRIPT.victim() # <dir> <?force:no> # the method under test
{
  local brace="}"      # NOT the end of the block
  echo victim
}
$MD_SCRIPT.victim.completion.dir() {
  echo "/tmp"
}
$MD_SCRIPT.victim.completion.force() { echo "yes"; echo "no"; }
FIXTURE
}

test.oo.methodDeleteRemovesMethodAndCompletions() {
  private.test.oo.method.delete.fixture
  "$OOSH_DIR/oo" method.delete "$MD_SCRIPT.victim" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "oo method.delete returned $rc"
  elif grep -q "victim" "$MD_FILE"; then
    create.result 1 "something named victim survived: $(grep -n victim "$MD_FILE" | tr '\n' ' ')"
  elif ! grep -q "^$MD_SCRIPT.keep() " "$MD_FILE" || ! grep -q "^$MD_SCRIPT.keep.completion.dir" "$MD_FILE"; then
    create.result 1 "the neighbouring method or its completion was taken too: $(cat "$MD_FILE")"
  else
    create.result 0 "removed"
  fi
  return $(result)
}
test.case $level "T-METHOD-DELETE: the method, its docstring and both completion functions go together" \
  test.oo.methodDeleteRemovesMethodAndCompletions
expect 0 "removed" "a one-line completion function has no closing brace LINE — the block form alone would run past it"

# A method that is not there must be refused, not silently reported as done.
test.oo.methodDeleteRefusesUnknown() {
  private.test.oo.method.delete.fixture
  "$OOSH_DIR/oo" method.delete "$MD_SCRIPT.neverExisted" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success for a method that does not exist"
  elif ! grep -q "^$MD_SCRIPT.victim() " "$MD_FILE"; then
    create.result 1 "it edited the file anyway"
  else
    create.result 0 "refused"
  fi
  return $(result)
}
test.case $level "T-METHOD-DELETE-UNKNOWN: an absent method is refused and the file is untouched" \
  test.oo.methodDeleteRefusesUnknown
expect 0 "refused" "silently succeeding would hide a typo in the method name"

rm -f "$MD_FILE" "$MD_FILE.bak" "$MD_FILE.new"
unset MD_SCRIPT MD_FILE

# ============================================================================
# T-STATE31-SSH-SNAPSHOT-FIRST: the snapshot precedes the first ~/.ssh write
# ============================================================================
# State 31 is the first thing in the whole install that writes the installing
# user's ~/.ssh — `mkdir -p "$HOME/.ssh"`, the Host github.com block, the
# ssh-keyscan into known_hosts, the developking copy into ids/. That is why
# ossh.install.continue.local's old "ssh.original" backup was nothing of the
# kind: it ran after `oo state`, by which point this state had already run.
#
# Structural, not behavioural: state.check re-sources $stateScript on every
# advancement, which kills in-shell function mocks, so an end-to-end mock of
# `user ssh.backup` cannot survive. The ORDER is the invariant that matters,
# and the platform gate proves the behaviour.
test.oo.state31SnapshotsBeforeWriting() {
  local body snapshotLine mkdirLine
  body=$(declare -f private.check.root.shared.dev.folder.created 2>/dev/null)
  if [ -z "$body" ]; then
    create.result 1 "private.check.root.shared.dev.folder.created is not defined"
    return $(result)
  fi
  snapshotLine=$(printf '%s\n' "$body" | grep -n 'ssh\.backup pre-install' | head -1 | cut -d: -f1)
  mkdirLine=$(printf '%s\n' "$body" | grep -n 'mkdir -p "\$HOME/\.ssh"' | head -1 | cut -d: -f1)
  if [ -z "$snapshotLine" ]; then
    create.result 1 "state 31 takes no pre-install ssh snapshot"
  elif [ -z "$mkdirLine" ]; then
    create.result 1 "could not find the mkdir -p \$HOME/.ssh this test anchors on"
  elif [ "$snapshotLine" -ge "$mkdirLine" ]; then
    create.result 1 "the snapshot is at line $snapshotLine, the first write at $mkdirLine — too late"
  else
    create.result 0 "snapshot first"
  fi
  return $(result)
}
test.case $level "T-STATE31-SSH-SNAPSHOT-FIRST: state 31 archives ~/.ssh before it writes to it" \
  test.oo.state31SnapshotsBeforeWriting
expect 0 "snapshot first" "the state that does the work owns the snapshot — a backup taken afterwards is not a backup"
# --- T-METHOD-NEW-PRIVATE ---------------------------------------------------
# A private method is named private.<script>.<verb>, so the SCRIPT it belongs
# to is the SECOND segment. Splitting on the first sent the tool at a file
# called `private` and it refused with rc 3 — so the tool this project MANDATES
# for method creation could not create a single private method, and every one
# in the tree was hand-written. That is the standing methodology violation.
test.oo.methodNewPrivate() {
  local probe="probePrivateScript" pwdBefore="$PWD"
  if ! test.oo.method.probe.make "$probe"; then
    cd "$pwdBefore"; test.oo.method.probe.clean "$probe"
    create.result 1 "oo.new did not create $probe and its test"
    return $(result)
  fi
  printf '%s\n' '<envPrefix>' 'lists the persistable variable names' \
                 'a probe test' 'OOSH' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "private.$probe.variables.list" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local created stray stubs testcase
  created=$(grep -c "^private\.$probe\.variables\.list()" "$OOSH_DIR/$probe" 2>/dev/null)
  # The old split aimed at $OOSH_DIR/private. Nothing should ever create it.
  stray=0; [ -e "$OOSH_DIR/private" ] && stray=1
  # A private method is never dispatched from the command line, so a completion
  # function for it is dead code — test/test.completion.audit skips `private*`
  # for exactly that reason, and the tool must not generate one.
  stubs=$(grep -c "^private\.$probe\.variables\.list\.completion\." "$OOSH_DIR/$probe" 2>/dev/null)
  testcase=$(grep -c "private\.$probe\.variables\.list" "$OOSH_DIR/test/test.$probe" 2>/dev/null)
  test.oo.method.probe.clean "$probe"

  if [ "$stray" != "0" ]; then
    create.result 1 "the tool created \$OOSH_DIR/private — the script is the SECOND segment of a private name"
  elif [ "$created" != "1" ]; then
    create.result 1 "private.$probe.variables.list() was not created in $probe (found $created)"
  elif [ "$stubs" != "0" ]; then
    create.result 1 "a private method got $stubs completion stub(s) — dead code the audit skips"
  elif [ "$testcase" = "0" ]; then
    create.result 1 "no test case was written for the private method"
  else
    create.result 0 "a private method lands in its own script, with no dead completion stub"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-PRIVATE: oo method.new private.<script>.<verb> writes to <script>" \
  test.oo.methodNewPrivate
expect 0 "a private method lands in its own script, with no dead completion stub" \
  "private methods are a large share of every script; the mandated tool could not create one"

# --- T-CHECK-PM-NO-CLOBBER --------------------------------------------------
# private.check.pm does `export OS_CMD_GROUP_ADD=$3` and
# `export OS_CMD_USER_ADD=$4` unconditionally, then persists the set with
# `config save os.commands "OS_CMD"`. Four of the eight call sites pass those
# arguments; `brew` — the macOS one — passes NEITHER (see private.check.all.pm), as do dpkg,
# pkg and pacman. So on macOS the pair is written as the EMPTY STRING and
# saved, which is why a clean Sequoia install carries
#
#   export OS_CMD_GROUP_ADD=""
#   export OS_CMD_USER_ADD=""
#
# while Linux carries real values. private.user.init already knows the darwin
# answers (`dseditgroup -o create -q`, `sysadminctl -addUser`, in private.user.init),
# so the fix is NOT to duplicate them here — it is for check.pm to stop writing
# a variable it was never given, and let the heal fill them.
#
# The consequences were three, all measured on a clean VM 2026-09-17:
#   - user.create fails ("ooshTestC should exist with no password hash");
#   - private.this.group.create has no working route on darwin;
#   - the cache can never go healthy, so private.user.init's persist branch —
#     `config save os.commands` + `oo pm.discover` — runs on EVERY invocation,
#     and that cascade is what wrote the shared config tier from an isolated
#     test. See docs/research/2026-09-17-shared-tier-leak-macos.md.
test.oo.checkPmDoesNotClobber() {
  # A subshell: check.pm exports into its caller, and OOSH_PM must be empty for
  # it to do anything at all. `true` stands in for a package manager because
  # `command -v true` succeeds everywhere and installing nothing is safe — the
  # apt-get branch (it only records the manager; oo.cmd refreshes) is not reached.
  local observed
  observed=$(
    export OOSH_PM=""
    export OS_CMD_GROUP_ADD="SENTINEL_GROUP"
    export OS_CMD_USER_ADD="SENTINEL_USER"
    private.check.pm ls "ls install" >/dev/null 2>&1
    echo "$OS_CMD_GROUP_ADD|$OS_CMD_USER_ADD"
  )
  if [ "$observed" = "SENTINEL_GROUP|SENTINEL_USER" ]; then
    create.result 0 "a two-argument check.pm leaves the OS_CMD pair alone"
  else
    create.result 1 "check.pm overwrote the pair with [$observed] — a call that passes no group/user command must not write one"
  fi
  return $(result)
}
test.case $level "T-CHECK-PM-NO-CLOBBER: a PM with no group/user command does not blank the cached pair" \
  test.oo.checkPmDoesNotClobber
expect 0 "a two-argument check.pm leaves the OS_CMD pair alone" \
  "brew passes neither, so macOS persisted two empty strings and user.create has never worked there"

# --- T-PM-TABLES-AGREE -------------------------------------------------------
# The package-manager map exists FOUR times in this tree, and they had drifted.
#
#   init/oosh           oosh_pm_detect       POSIX sh, standalone by necessity —
#                                             it runs from a curl one-liner before
#                                             any oosh exists to source.
#   oo                  private.check.all.pm the local installer's call table
#   ossh                ossh.pm.discover     a string executed on a REMOTE host
#                                             that may have no oosh at all
#   config              private.config.pm.command.get   added 2026-09-17 by card 2,
#                                             because oo pm.discover is not a
#                                             detector (it ran sudo apt-get update)
#
# Three of the four CANNOT be merged: init/oosh must be self-contained POSIX,
# and ossh's runs on a machine that has nothing of ours on it. What can be done
# is pin that they AGREE — which is what this test is, and what nothing did
# before. The drift it was written to catch:
#
#   pacman   init/oosh, ossh, config: "pacman -S --noconfirm"    oo: "pacman -S"
#   pkg      init/oosh, ossh, config: "pkg install -y"           oo: "pkg install"
#
# Both of oo's are INTERACTIVE. `oo cmd <tool>` runs them during an install, so
# on Arch or FreeBSD the install would sit on a confirmation prompt — the same
# failure mode as the sudo prompt oo pm.discover caused on 2026-09-17.
test.oo.pmTablesAgree() {
  local pm mismatches="" fromOo fromInit fromConfig
  for pm in brew apt-get dnf yum apk pacman pkg; do
    fromOo=$(grep -oE "private\.check\.pm $pm \"[^\"]+\"" "$OOSH_DIR/oo" 2>/dev/null \
             | head -1 | sed 's/.*"\(.*\)"/\1/')
    fromInit=$(grep -E "^[[:space:]]+$pm\)" "$OOSH_DIR/init/oosh" 2>/dev/null \
               | head -1 | sed 's/.*OOSH_PM="\([^"]*\)".*/\1/')
    fromConfig=$(grep -E "^[[:space:]]+$pm\)" "$OOSH_DIR/config" 2>/dev/null \
                 | head -1 | sed 's/.*echo "\([^"]*\)".*/\1/')
    [ -n "$fromOo" ] && [ -n "$fromInit" ] && [ "$fromOo" != "$fromInit" ] \
      && mismatches="$mismatches
    $pm: oo=[$fromOo] init/oosh=[$fromInit]"
    [ -n "$fromConfig" ] && [ -n "$fromInit" ] && [ "$fromConfig" != "$fromInit" ] \
      && mismatches="$mismatches
    $pm: config=[$fromConfig] init/oosh=[$fromInit]"
  done
  if [ -z "$(printf '%s' "$mismatches" | tr -d '[:space:]')" ]; then
    create.result 0 "every copy of the package-manager map agrees"
  else
    create.result 1 "the package-manager maps disagree:$mismatches"
  fi
  return $(result)
}
test.case $level "T-PM-TABLES-AGREE: the four copies of the package-manager map say the same thing" \
  test.oo.pmTablesAgree
expect 0 "every copy of the package-manager map agrees" \
  "oo's pacman and pkg entries lack their non-interactive flags, so an install on Arch or FreeBSD would sit on a prompt"

# --- T-METHOD-NEW-DOTTED-SCRIPT ---------------------------------------------
# A script whose own NAME contains a dot — `test.suite` is the one that matters
# — cannot be extended by the tool this project mandates. `${name%%.*}` takes
# everything before the FIRST dot, so `oo method.new test.suite.portability.validate`
# resolves the script to `test`, which is a DIRECTORY, and the insertion has
# nowhere to go.
#
# The boundary between script and method is not "the first dot". It is "the
# longest leading prefix that names a file that exists", which is the only
# definition that can tell `test.suite.x` from `config.x` without a list.
test.oo.methodNewDottedScript() {
  local probe="probeDotted.name" pwdBefore="$PWD"
  printf '#!/usr/bin/env bash\n\n### new.method\n' > "$OOSH_DIR/$probe"
  printf '#!/usr/bin/env bash\nTEST_CATEGORY=core\n\n### test.method\n' > "$OOSH_DIR/test/test.$probe"
  printf '%s\n' '<thing>' 'does a thing' 'a probe test' 'x' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "$probe.deep.verb" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local created stray testcase
  created=$(grep -c "^$probe\.deep\.verb()" "$OOSH_DIR/$probe" 2>/dev/null)
  # The old split aimed at `probeDotted`; nothing should ever create it.
  stray=0; [ -e "$OOSH_DIR/probeDotted" ] && stray=1
  testcase=$(grep -c "$probe\.deep\.verb" "$OOSH_DIR/test/test.$probe" 2>/dev/null)
  rm -f "$OOSH_DIR/$probe" "$OOSH_DIR/$probe".bak "$OOSH_DIR/$probe".new \
        "$OOSH_DIR/test/test.$probe" "$OOSH_DIR/test/test.$probe".bak \
        "$OOSH_DIR/test/test.$probe".new "$OOSH_DIR/probeDotted" 2>/dev/null

  if [ "$stray" != "0" ]; then
    create.result 1 "the tool created \$OOSH_DIR/probeDotted — the script is the LONGEST existing prefix, not the first segment"
  elif [ "$created" != "1" ]; then
    create.result 1 "$probe.deep.verb() was not created in $probe (found $created)"
  elif [ "$testcase" = "0" ]; then
    create.result 1 "no test case was written for a dotted-script method"
  else
    create.result 0 "a script whose name contains a dot can be extended"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-DOTTED-SCRIPT: oo method.new resolves a script name containing a dot" \
  test.oo.methodNewDottedScript
expect 0 "a script whose name contains a dot can be extended" \
  "test.suite is such a script, and the mandated tool could not add a method to it"



console.log "
Test: T-OO-TEST-PLATFORM-NEW
===================================================================="

test.oo.testPlatformNew() {
  local fx bad="" t; fx=$(test.suite.fixture.make platformnew)
  mkdir -p "$fx/templates/code" "$fx/test"
  cp "$OOSH_DIR/templates/code/newPlatformInvariantTest" "$fx/templates/code/"
  local OOSH_DIR="$fx"
  t="$fx/test/test.platform.fx.layout.invariant"
  oo.test.platform.new fx layout >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -x "$t" ] || bad="$bad not-created"
  grep -q '^TEST_CATEGORY=platform' "$t" 2>/dev/null || bad="$bad category"
  grep -q 'platform\.fx\.layout:' "$t" 2>/dev/null || bad="$bad not-substituted"
  grep -qE '<scope>|<aspect>' "$t" 2>/dev/null && bad="$bad placeholder-left"
  printf 'mine\n' > "$t"
  oo.test.platform.new fx layout >/dev/null 2>&1 && bad="$bad overwrite-passed"
  [ "$(cat "$t")" = mine ] || bad="$bad overwrote-existing"
  oo.test.platform.new 'fx/x' layout >/dev/null 2>&1 && bad="$bad bad-name-passed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "test.platform.new: generated from the template, refuses to overwrite or a bad name" || create.result 1 "test.platform.new:$bad"
  return $(result)
}
test.case $level "T-OO-TEST-PLATFORM-NEW: oo test.platform.new generates a platform invariant test" test.oo.testPlatformNew
expect 0 "test.platform.new: generated from the template, refuses to overwrite or a bad name" "platform invariants come from the template, not by hand"

# --- T-METHOD-NEW-SYMLINKED-SCRIPT -------------------------------------------
# Top-level `c2` is a symlink to `ng/c2`. method.new and method.delete edit
# $OOSH_DIR/<script>; they must edit the link's TARGET and leave the link a link
# (replace commit refuses a symlink — T-REPLACE-COMMIT-REFUSES-SYMLINK).
test.oo.methodNewSymlinkedScript() {
  local fx bad=""; fx=$(test.suite.fixture.make symlinkscript)
  mkdir -p "$fx/ng" "$fx/test" "$fx/templates/code"
  cp "$OOSH_DIR/templates/code/newMethod" "$OOSH_DIR/templates/code/newMethodTest" "$fx/templates/code/"
  printf '#!/usr/bin/env bash\n\n### new.method\n' > "$fx/ng/probeLinked"; chmod +x "$fx/ng/probeLinked"
  ln -s ng/probeLinked "$fx/probeLinked"
  printf '#!/usr/bin/env bash\nTEST_CATEGORY=core\n\n### test.method\n' > "$fx/test/test.probeLinked"
  printf '%s\n' '<thing>' 'does a thing' 'a probe test' 'x' 'probe_ok' \
    | ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.new probeLinked.thing.do ) >/dev/null 2>&1
  [ -L "$fx/probeLinked" ] || bad="$bad new-replaced-link"
  grep -q '^probeLinked\.thing\.do()' "$fx/ng/probeLinked" || bad="$bad new-not-in-target"
  [ -x "$fx/ng/probeLinked" ] || bad="$bad new-target-lost-exec"
  grep -q 'probeLinked\.thing\.do' "$fx/test/test.probeLinked" || bad="$bad new-no-test-case"
  ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete probeLinked.thing.do ) >/dev/null 2>&1
  [ -L "$fx/probeLinked" ] || bad="$bad delete-replaced-link"
  grep -q '^probeLinked\.thing\.do()' "$fx/ng/probeLinked" && bad="$bad delete-left-method"
  [ -x "$fx/ng/probeLinked" ] || bad="$bad delete-target-lost-exec"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "method.new and method.delete edit the link target; the link stays a link" || create.result 1 "symlinked script:$bad"
  return $(result)
}
test.case $level "T-METHOD-NEW-SYMLINKED-SCRIPT: oo method.new / method.delete edit a symlinked script through its target" \
  test.oo.methodNewSymlinkedScript
expect 0 "method.new and method.delete edit the link target; the link stays a link" \
  "c2 -> ng/c2: the mandated tool must be able to extend c2"



console.log "
Test: T-OO-METHOD-NAME-RESOLVE
===================================================================="

test.oo.methodNameResolve() {
  local fx bad="" got; fx=$(test.suite.fixture.make nameresolve)
  : > "$fx/probe"; : > "$fx/probe.dotted"
  got=$( OOSH_DIR="$fx"; private.oo.method.name.resolve probe.thing.do )
  [ "$got" = "probe thing.do" ] || bad="$bad public=[$got]"
  got=$( OOSH_DIR="$fx"; private.oo.method.name.resolve private.probe.helper.get )
  [ "$got" = "probe helper.get" ] || bad="$bad private=[$got]"
  got=$( OOSH_DIR="$fx"; private.oo.method.name.resolve probe.dotted.verb )
  [ "$got" = "probe.dotted verb" ] || bad="$bad dotted-script=[$got]"
  got=$( OOSH_DIR="$fx"; private.oo.method.name.resolve newScript.first )
  [ "$got" = "newScript first" ] || bad="$bad fallback=[$got]"
  got=$( OOSH_DIR="$fx"; private.oo.method.name.resolve probe )
  [ "$got" = "probe " ] || bad="$bad no-method=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "method.name.resolve: private, dotted-script, fallback and no-method names resolve" || create.result 1 "method.name.resolve:$bad"
  return $(result)
}
test.case $level "T-OO-METHOD-NAME-RESOLVE: one rule for oo method.new and oo method.delete" test.oo.methodNameResolve
expect 0 "method.name.resolve: private, dotted-script, fallback and no-method names resolve" \
  "method.delete split on the FIRST dot, so private.<script>.x looked for a file called private"

# T-METHOD-DELETE-PRIVATE: method.delete reaches private.<script>.<verb> and a dotted script name
test.oo.methodDeletePrivate() {
  local fx bad=""; fx=$(test.suite.fixture.make methoddeleteprivate)
  mkdir -p "$fx/test"
  printf '%s\n' '#!/usr/bin/env bash' '' \
    'probeDel.keep() # # survives' '{' '  echo keep' '}' '' \
    'private.probeDel.victim() # <x> # the private method under test' '{' '  echo victim' '}' '' \
    'private.probeDel.victim.longer() # # a longer name sharing the prefix survives' '{' '  echo longer' '}' > "$fx/probeDel"
  printf '%s\n' '#!/usr/bin/env bash' '' 'probe.dotted.gone() # # in a script whose name has a dot' '{' '  echo gone' '}' > "$fx/probe.dotted"
  ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete private.probeDel.victim ) >/dev/null 2>&1 || bad="$bad private-rc=$?"
  grep -q '^private\.probeDel\.victim()' "$fx/probeDel" && bad="$bad private-left"
  grep -q '^probeDel\.keep()' "$fx/probeDel" || bad="$bad keep-taken"
  grep -q '^private\.probeDel\.victim\.longer()' "$fx/probeDel" || bad="$bad longer-taken"
  ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete probe.dotted.gone ) >/dev/null 2>&1 || bad="$bad dotted-rc=$?"
  grep -q '^probe\.dotted\.gone()' "$fx/probe.dotted" && bad="$bad dotted-left"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "method.delete removes private.<script>.x and a method of a dotted script" || create.result 1 "method.delete:$bad"
  return $(result)
}
test.case $level "T-METHOD-DELETE-PRIVATE: oo method.delete reaches private.<script>.<verb> and a dotted script" test.oo.methodDeletePrivate
expect 0 "method.delete removes private.<script>.x and a method of a dotted script" \
  "Round 5 removes private.oo.boot.* with oo method.delete"

# T-METHOD-DELETE-ONE-LINE: a one-line method, or a signature with a one-line
# body `{ …; }` under it, is removed alone — the neighbour before and after,
# every completion stub of another method and the marker survive byte-for-byte.
# `oo method.delete private.oo.safeDirectory.add` (signature line + `{ …; }`)
# ran on to the next `}` LINE and took oo.remote.update with it.
test.oo.methodDeleteOneLine() {
  local fx bad="" victim; fx=$(test.suite.fixture.make methoddeleteoneline)
  mkdir -p "$fx/test"
  local head=('#!/usr/bin/env bash' '' \
    'probeOne.before() # <x> # a multi-line neighbour before' '{' '  echo before' '}' \
    'probeOne.before.completion.x() { echo x; }' '')
  local twoLine=('private.probeOne.twoLine() # <x> # signature line, then a one-line body' '{ echo twoLine; }')
  local middle=('' 'probeOne.after() # <x> # a multi-line neighbour after' '{' '  echo after' '}' \
    'probeOne.after.completion.x() {' '  echo x' '}' '')
  local oneLine=('probeOne.oneLine() { echo oneLine; }')
  local tail=('probeOne.last() # # a multi-line neighbour after the one-liner' '{' '  echo last' '}' '' '### new.method')
  printf '%s\n' "${head[@]}" "${twoLine[@]}" "${middle[@]}" "${oneLine[@]}" "${tail[@]}" > "$fx/probeOne"
  printf '%s\n' "${head[@]}" "${middle[@]}" "${oneLine[@]}" "${tail[@]}" > "$fx/expect.twoLine"
  # `replace line … by ""` leaves the one-liner's line empty (the block form drops it).
  printf '%s\n' "${head[@]}" "${middle[@]}" '' "${tail[@]}" > "$fx/expect.both"
  ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete private.probeOne.twoLine ) >/dev/null 2>&1 || bad="$bad twoLine-rc=$?"
  cmp -s "$fx/probeOne" "$fx/expect.twoLine" || bad="$bad twoLine-left:[$(tr '\n' '|' < "$fx/probeOne")]"
  ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete probeOne.oneLine ) >/dev/null 2>&1 || bad="$bad oneLine-rc=$?"
  cmp -s "$fx/probeOne" "$fx/expect.both" || bad="$bad oneLine-left:[$(tr '\n' '|' < "$fx/probeOne")]"
  # The other order: the one-liners AFTER a multi-line method, last before the marker.
  printf '%s\n' "${head[@]}" "${middle[@]}" "${oneLine[@]}" "${twoLine[@]}" '' '### new.method' > "$fx/probeOne"
  printf '%s\n' "${head[@]}" "${middle[@]}" '' '' '### new.method' > "$fx/expect.after"
  for victim in private.probeOne.twoLine probeOne.oneLine; do
    ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete "$victim" ) >/dev/null 2>&1 || bad="$bad after-$victim-rc=$?"
  done
  cmp -s "$fx/probeOne" "$fx/expect.after" || bad="$bad after-left:[$(tr '\n' '|' < "$fx/probeOne")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "method.delete removes a one-line method alone" || create.result 1 "method.delete:$bad"
  return $(result)
}
test.case $level "T-METHOD-DELETE-ONE-LINE: oo method.delete removes a one-line method and nothing next to it" test.oo.methodDeleteOneLine
expect 0 "method.delete removes a one-line method alone" \
  "a signature with a { …; } body ran on to the next } line and took oo.remote.update"

# ============================================================================
# T-OO-DROPIN-REMOVE: the retired login drop-in goes — only oosh's, idempotent
# ============================================================================
# boot is gone (dev.config Round 5): a shell starts from ~/config/user.env.
# Hosts installed earlier still carry <profileDir>/oosh.sh (sourcing
# <systemPath>/boot) and the <systemPath>/boot symlink, which now points at
# nothing. private.oo.dropin.remove takes both away — and only an oosh.sh
# that IS oosh's (it names <systemPath>/boot); a foreign one of that name stays.
test.oo.dropinRemove() {
  local fx sys prof bad=""; fx=$(test.suite.fixture.make dropin); sys="$fx/etcoosh"; prof="$fx/profiled"
  mkdir -p "$sys" "$prof"
  ln -s "$fx/nowhere/boot" "$sys/boot"
  printf '%s\n' "[ -r $sys/boot ] && . $sys/boot" > "$prof/oosh.sh"
  printf 'other\n' > "$prof/other.sh"
  private.oo.dropin.remove "$sys" "$prof" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -e "$prof/oosh.sh" ] && bad="$bad dropin-left"
  { [ -L "$sys/boot" ] || [ -e "$sys/boot" ]; } && bad="$bad boot-link-left"
  [ -d "$sys" ] && bad="$bad system-path-left"
  [ -f "$prof/other.sh" ] || bad="$bad other-profile-file-taken"
  private.oo.dropin.remove "$sys" "$prof" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  printf 'someone else\n' > "$prof/oosh.sh"
  private.oo.dropin.remove "$sys" "$prof" >/dev/null 2>&1
  [ -f "$prof/oosh.sh" ] || bad="$bad foreign-oosh.sh-taken"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "dropin.remove: oosh's drop-in and the boot link gone, foreign files kept, idempotent" || create.result 1 "dropin.remove:$bad"
  return $(result)
}
test.case $level "T-OO-DROPIN-REMOVE: private.oo.dropin.remove takes the retired login drop-in away" test.oo.dropinRemove
expect 0 "dropin.remove: oosh's drop-in and the boot link gone, foreign files kept, idempotent" \
  "/etc/profile.d/oosh.sh sources a boot that no longer exists"

# T-OO-DROPIN-CLEANUP-CALLERS: existing hosts never re-run state 34 (a host's
# state list is frozen at its first install), so `oo update` runs the cleanup
# (behavioural: T-OO-UPDATE-CALLS); state 34 runs it on a fresh install.
test.oo.dropinCleanupCallers() {
  local bad=""
  sed -n '/^private\.check\.root\.boot\.path\.installed()/,/^}/p' "$OOSH_DIR/oo" | grep -q 'private\.oo\.dropin\.remove' || bad="$bad state-34"
  [ -z "$bad" ] && create.result 0 "state 34 removes the drop-in" || create.result 1 "not called by:$bad"
  return $(result)
}
test.case $level "T-OO-DROPIN-CLEANUP-CALLERS: state 34 runs the drop-in cleanup" test.oo.dropinCleanupCallers
expect 0 "state 34 removes the drop-in" \
  "an existing host never re-runs state 34"

# T-OO-DROPIN-REMOVE-MANAGED: the LATER drop-in goes too. 2fbcf1b made it a
# template (templates/user/profile.d.oosh.sh) that no longer names
# <systemPath>/boot — it sources ~/config/user.env itself — so the boot-path
# rule missed it and it stayed on hosts that ran that version (this computer,
# found by platform.shared.configLayout invariant 5). It is recognised by its
# own first line; a foreign oosh.sh still stays.
test.oo.dropinRemoveManaged() {
  local fx sys prof bad=""; fx=$(test.suite.fixture.make dropinmanaged); sys="$fx/etcoosh"; prof="$fx/profiled"
  mkdir -p "$prof"
  printf '%s\n' '# oosh — host-wide login-shell bootstrap. MANAGED FILE: written by install' \
    'if [ -n "${HOME-}" ] && [ -f "$HOME/config/user.env" ]; then' '  . "$HOME/config/user.env"' 'fi' > "$prof/oosh.sh"
  private.oo.dropin.remove "$sys" "$prof" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -e "$prof/oosh.sh" ] && bad="$bad managed-dropin-left"
  printf '%s\n' '# my own oosh.sh — host-wide login-shell bootstrap' > "$prof/oosh.sh"
  private.oo.dropin.remove "$sys" "$prof" >/dev/null 2>&1
  [ -f "$prof/oosh.sh" ] || bad="$bad foreign-oosh.sh-taken"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "dropin.remove: the managed drop-in gone, a foreign oosh.sh kept" || create.result 1 "dropin.remove:$bad"
  return $(result)
}
test.case $level "T-OO-DROPIN-REMOVE-MANAGED: private.oo.dropin.remove also takes the later, boot-less drop-in away" test.oo.dropinRemoveManaged
expect 0 "dropin.remove: the managed drop-in gone, a foreign oosh.sh kept" \
  "/etc/profile.d/oosh.sh from 2fbcf1b does not name the boot path and stayed behind"

# ============================================================================
# T-BRANCH-CLONE-ENSURE-*: private.oo.branch.clone.ensure — the clone step of
# install state 31 and of private.oo.shared.tree.from.local, idempotent
# ============================================================================
# State 31 itself cannot be driven end to end (state.check re-sources the
# script and kills mocks), so the branch-clone decision lives in this helper
# and is tested here against fixtures: absent → clone; a clone on the branch →
# kept (a re-run is not a failure although ogit repo.clone refuses a non-empty
# target); an old-install WORKTREE → left alone, rc 0, pointing at
# `sudo ogit worktree.remove`; anything else → refused, never deleted.
private.test.oo.branchClone.origin() { # <fixture> # $fixture/origin: a repository with main + dev
  (
    mkdir -p "$1/origin" && cd "$1/origin" || exit 1
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    echo seed > README.md && git add . && git commit -q -m seed
    git branch dev
  ) >/dev/null 2>&1
}

test.oo.branchCloneEnsureClonesAndKeeps() {
  local fx; fx=$(test.suite.fixture.make oo.branchclone) || { create.result 1 "fixture failed"; return $(result); }
  private.test.oo.branchClone.origin "$fx"
  mkdir -p "$fx/base"
  local rc1 rc2
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc1=$?
  echo "local work" > "$fx/base/dev/untracked.txt"
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc2=$?
  if [ "$rc1" -ne 0 ]; then
    create.result 1 "first call returned $rc1"
  elif [ ! -d "$fx/base/dev/.git" ]; then
    create.result 1 "dev/.git is not a directory"
  elif [ "$(git -C "$fx/base/dev" rev-parse --abbrev-ref HEAD 2>/dev/null)" != dev ]; then
    create.result 1 "dev/ is not on dev"
  elif [ "$rc2" -ne 0 ]; then
    create.result 1 "the re-run returned $rc2 — a re-run of state 31 would halt"
  elif [ ! -f "$fx/base/dev/untracked.txt" ]; then
    create.result 1 "the re-run replaced the existing clone"
  else
    create.result 0 "cloned, then kept"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-BRANCH-CLONE-ENSURE-IDEMPOTENT: clones an absent branch folder, keeps it on a re-run" \
  test.oo.branchCloneEnsureClonesAndKeeps
expect 0 "cloned, then kept" "state 31 re-runs over an existing clone of the right branch with rc 0"

test.oo.branchCloneEnsureLeavesWorktree() {
  local fx; fx=$(test.suite.fixture.make oo.branchclone.wt) || { create.result 1 "fixture failed"; return $(result); }
  private.test.oo.branchClone.origin "$fx"
  mkdir -p "$fx/base"
  git clone -q -b main "$fx/origin" "$fx/base/main" >/dev/null 2>&1
  git -C "$fx/base/main" worktree add -q "$fx/base/dev" dev >/dev/null 2>&1
  local rc
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc=$?
  if [ ! -f "$fx/base/main/.git/worktrees/dev/HEAD" ] && [ ! -f "$fx/base/dev/.git" ]; then
    create.result 1 "fixture: no linked worktree was made"
  elif [ "$rc" -ne 0 ]; then
    create.result 1 "returned $rc on an old-install worktree"
  elif [ ! -f "$fx/base/dev/.git" ]; then
    create.result 1 "the worktree was replaced — it must be left alone"
  elif ! printf '%s' "$RESULT" | grep -q 'ogit worktree.remove'; then
    create.result 1 "RESULT does not point at ogit worktree.remove: $RESULT"
  else
    create.result 0 "worktree left alone"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-BRANCH-CLONE-ENSURE-WORKTREE: an old-install worktree is left alone with a pointer to ogit worktree.remove" \
  test.oo.branchCloneEnsureLeavesWorktree
expect 0 "worktree left alone" "the conversion is ogit worktree.remove's job (gated, carries ignored files) — never the install's"

test.oo.branchCloneEnsureRefusesOther() {
  local fx; fx=$(test.suite.fixture.make oo.branchclone.other) || { create.result 1 "fixture failed"; return $(result); }
  private.test.oo.branchClone.origin "$fx"
  mkdir -p "$fx/base"
  git clone -q -b main "$fx/origin" "$fx/base/dev" >/dev/null 2>&1
  local rc
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "accepted a clone of main sitting at dev/"
  elif [ "$(git -C "$fx/base/dev" rev-parse --abbrev-ref HEAD 2>/dev/null)" != main ]; then
    create.result 1 "the folder was changed"
  else
    create.result 0 "refused"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-BRANCH-CLONE-ENSURE-REFUSES: a folder on another branch is refused, not replaced" \
  test.oo.branchCloneEnsureRefusesOther
expect 0 "refused" "the install never deletes a folder it did not make"

# ============================================================================
# T-STATE31-CLONE-LAYOUT: state 31 produces clones with per-folder permissions
# ============================================================================
# Structural (state.check re-sources $stateScript — end-to-end mocks die):
# the branch folder comes from the clone helper, never from worktree add; the
# permission block runs PER repository folder under the base (repo.share +
# safe.directory of the case-canonical path); the BASE gets group dev + setgid
# so folders added later inherit the group; no recursive chown of the base.
test.oo.state31CloneLayout() {
  local body bad=""
  body=$(declare -f private.check.root.shared.dev.folder.created 2>/dev/null)
  if [ -z "$body" ]; then
    create.result 1 "private.check.root.shared.dev.folder.created is not defined"
    return $(result)
  fi
  # main/ and the branch folder come from ONE helper that keeps an existing
  # clone (T-SHARED-TREE-ENSURE drives it); a bare ogit repo.clone of main here
  # took a re-run's "target not empty" for an SSH failure.
  printf '%s\n' "$body" | grep -q 'private.oo.shared.tree.ensure ' || bad="$bad no-shared.tree.ensure"
  printf '%s\n' "$body" | grep -q 'ogit.repo.clone git@' && bad="$bad main-cloned-by-hand"
  printf '%s\n' "$body" | grep -q 'worktree.add' && bad="$bad still-worktree.add"
  printf '%s\n' "$body" | grep -q 'private.ogit.base.folders.list "$onceShBase"' || bad="$bad no-per-folder-loop"
  # One finish per folder: .git AND working tree shared, trusted (ogit folds the case).
  printf '%s\n' "$body" | grep -q 'ogit.folder.finish "$_wt"' || bad="$bad no-per-folder-finish"
  printf '%s\n' "$body" | grep -q 'private.this.path.case.get' && bad="$bad hand-folded-case"
  # The base: group dev + setgid through private.oo.shared.base.share (oo heal calls it too).
  printf '%s\n' "$body" | grep -q 'private.oo.shared.base.share "$onceShBase"' || bad="$bad base-not-shared"
  printf '%s\n' "$body" | grep -qE 'chown -R[^;]*onceShBase' && bad="$bad recursive-chown-of-base"
  printf '%s\n' "$body" | grep -q 'onceShBase/main/.git' && bad="$bad main-only-permissions"
  if [ -z "$bad" ]; then
    create.result 0 "clone layout, per-folder permissions, setgid base"
  else
    create.result 1 "state 31:$bad"
  fi
  return $(result)
}
test.case $level "T-STATE31-CLONE-LAYOUT: state 31 clones the branch and shares + trusts every folder, base setgid, no recursive chown" \
  test.oo.state31CloneLayout
expect 0 "clone layout, per-folder permissions, setgid base" "spec § 2 + § 4: each folder is its own repository"

# --- T-MODE-BASE-WORDING ------------------------------------------------------
# `oo mode` printed "Worktree base: …" on a host with no worktrees left (the user,
# 2026-09-25, after the migration). The base is the components base whatever the
# layout; oo.mode's own names (WORKTREE_BASE, hasWorktrees — also an uppercase
# local) and messages say so.
test.oo.modeBaseWording() {
  local base fx out bad=""
  base=$(test.oo.base modewording clone); fx=$(dirname "$base")
  mkdir -p "$fx/home"; ln -s "$base/dev" "$fx/home/oosh"
  out=$( HOME="$fx/home"; OOSH_COMPONENTS_DIR="$base"; export HOME OOSH_COMPONENTS_DIR; oo.mode 2>&1 )
  printf '%s\n' "$out" | grep -qx "Base: $base" || bad="$bad no-base-line=[$(printf '%s' "$out" | grep -i base | head -1)]"
  printf '%s\n' "$out" | grep -qi 'worktree' && bad="$bad says-worktree"
  declare -f oo.mode | grep -qE 'WORKTREE_BASE|hasWorktrees|No worktree structure' && bad="$bad old-names-in-oo.mode"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oo mode reports the components base, not a worktree base" || create.result 1 "oo mode wording:$bad"
  return $(result)
}
test.case $level "T-MODE-BASE-WORDING: oo mode reports 'Base:', never 'Worktree base', on the clone layout" \
  test.oo.modeBaseWording
expect 0 "oo mode reports the components base, not a worktree base" "the host has no worktrees left, but oo mode still said Worktree base"

# T-SHIM-NO-WORKTREE-BASE: the worktree layout is history — nothing reads OOSH_WORKTREE_BASE
# The clone layout always has main/ beside ~/oosh, so the shim's fallback to a
# separate worktree base, and the installer's sed that rewrote it, are gone
# (33595a4, shim half; its config half — never persisting the variable — comes
# with the config work).
test.oo.shimNoWorktreeBase() {
  local hits
  hits=$(grep -n 'OOSH_WORKTREE_BASE' "$OOSH_DIR/templates/user/ooShim" "$OOSH_DIR/oo" 2>/dev/null
         grep -Hni 'worktree' "$OOSH_DIR/templates/user/ooShim" 2>/dev/null)
  [ -z "$hits" ] && create.result 0 "neither ooShim nor oo reads OOSH_WORKTREE_BASE" \
                 || create.result 1 "still read: $(printf '%s\n' "$hits" | cut -d: -f1,2 | tr '\n' ' ')"
  return $(result)
}
test.case $level "T-SHIM-NO-WORKTREE-BASE: neither ooShim nor oo reads OOSH_WORKTREE_BASE" test.oo.shimNoWorktreeBase
expect 0 "neither ooShim nor oo reads OOSH_WORKTREE_BASE" "the worktree layout is history"

# T-SHIM-BASHRC-SETTLES: the shim install and the .bashrc writer leave each other alone
# private.oo.install.shim (oo mode, oo mode.setup) appended a line that sources
# ~/.config/oosh/oo-func.bash to ~/.bashrc; private.user.bashrc.install (the ONE
# .bashrc writer) then saw "differs" and overwrote it — and the next oo mode
# appended again, forever. The template sources the shim itself now: after both
# writers .bashrc is the template, a second round of both changes nothing (not
# even the mtime), and the template line loads oo() from oo-func.bash.
test.oo.shimBashrcSettles() {
  local fx bad="" t="$OOSH_DIR/templates/user/bashrcTemplate" line
  fx=$(test.suite.fixture.make shimbashrc)
  # A sudo on the fixture PATH that records and fails: nothing here may reach
  # the real one (asserted below).
  mkdir -p "$fx/bin"
  printf '#!/bin/sh\necho "sudo $*" >> "%s/sudo.calls"\nexit 1\n' "$fx" > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  bad=$(
    PATH="$fx/bin:$PATH"; export PATH
    # Sourcing user self-heals a missing OS_CMD_* cache through oo pm.discover,
    # which used to run "$SUDO apt-get update" — the isolated config has no cache.
    # Give it the four values.
    export OS_CMD_USER_ADD=useradd OS_CMD_USER_DEL=userdel OS_CMD_USER_MOD=usermod OS_CMD_GROUP_ADD=groupadd
    private.this.script.load user private.user.bashrc.install || { printf ' user-not-loadable'; exit 0; }
    HOME="$fx"; export HOME
    private.user.bashrc.install "$fx" "$OOSH_DIR" >/dev/null 2>&1
    private.oo.install.shim "$OOSH_DIR" >/dev/null 2>&1
    cmp -s "$t" "$fx/.bashrc" || printf ' first-round-differs'
    [ -f "$fx/.config/oosh/oo-func.bash" ] || printf ' no-oo-func.bash'
    touch -t 202001010000 "$fx/.bashrc"; touch -t 202001010100 "$fx/stamp"
    private.user.bashrc.install "$fx" "$OOSH_DIR" >/dev/null 2>&1
    private.oo.install.shim "$OOSH_DIR" >/dev/null 2>&1
    cmp -s "$t" "$fx/.bashrc" || printf ' second-round-differs'
    [ "$fx/.bashrc" -nt "$fx/stamp" ] && printf ' second-round-rewrote'
    true
  )
  line=$(grep -x '.*\.config/oosh/oo-func\.bash.*' "$t")
  if [ "$(printf '%s\n' "$line" | grep -c .)" != 1 ]; then
    bad="$bad template-lines=$(printf '%s\n' "$line" | grep -c .)"
  else
    printf '%s\n' "$line" | bash -n || bad="$bad line-not-valid-bash"
    ( HOME="$fx"; unset -f oo; eval "$line"; declare -F oo >/dev/null ) || bad="$bad line-does-not-load-oo"
  fi
  [ -s "$fx/sudo.calls" ] && bad="$bad sudo-called=[$(head -1 "$fx/sudo.calls")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 ".bashrc stays the template, the template loads oo()" || create.result 1 "shim/bashrc:$bad"
  return $(result)
}
test.case $level "T-SHIM-BASHRC-SETTLES: the shim install leaves .bashrc the template; the template loads oo()" test.oo.shimBashrcSettles
expect 0 ".bashrc stays the template, the template loads oo()" "oo mode appended, oo update overwrote, forever"


# T-METHOD-TEST-BANNER: a generated test names its test — no "Test 1" placeholder
# templates/code/newMethodTest hard-coded the banner "Test 1" and oo method.new
# never substituted it, so every generated case kept the placeholder (686e877).
# The banner is now "Test: newScript.newMethod", which oo method.new's sed fills in.
test.oo.methodTestBanner.left() { # <testDir> # echo the test files in <testDir> that hold a numbered banner line (Test <number>)
  grep -lxE 'Test [0-9]+ *' "$1"/test.* 2>/dev/null
}
test.oo.methodTestBanner() {
  local bad="" t="$OOSH_DIR/templates/code/newMethodTest" left fx
  grep -qx 'Test: newScript.newMethod' "$t" || bad="$bad template-banner"
  sed 's/newScript\.newMethod/x.y/' "$t" | grep -qx 'Test: x.y' || bad="$bad not-substituted"
  left=$(test.oo.methodTestBanner.left "$OOSH_DIR/test")
  [ -z "$left" ] || bad="$bad placeholder-in:$(printf '%s\n' "$left" | sed 's|.*/||' | tr '\n' ' ')"
  # Any number, not only 1: fifteen "Test 2" … "Test 18" banners in test.ogit
  # went unnoticed. Planted in a fixture copy, never in the real tree.
  fx=$(test.suite.fixture.make bannerplant)
  printf 'console.log "\nTest 12\n====="\n' > "$fx/test.planted"
  [ "$(test.oo.methodTestBanner.left "$fx")" = "$fx/test.planted" ] || bad="$bad planted-Test-12-missed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "every method test names its test" || create.result 1 "banner:$bad"
  return $(result)
}
test.case $level "T-METHOD-TEST-BANNER: a generated test names its test — no Test 1 placeholder" test.oo.methodTestBanner
expect 0 "every method test names its test" "every test made by oo method.new said Test 1"

# T-OO-INSTALL-LAUNCHER: the launcher is installed once, executable, and kept up to date
# private.oo.install.launcher copies templates/user/thisLauncher to the target
# (default /usr/local/bin/this) only when it differs, mode 755; a stale copy
# is replaced. Driven against a fixture target the caller may write.
test.oo.installLauncher() {
  local fx bad="" t; fx=$(test.suite.fixture.make oolauncher); t="$fx/bin/this"
  private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1 || bad="$bad rc=$?"
  cmp -s "$OOSH_DIR/templates/user/thisLauncher" "$t" || bad="$bad not-installed"
  [ -x "$t" ] || bad="$bad not-executable"
  private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1
  case "$RESULT" in *"up to date"*) ;; *) bad="$bad second-run=[$RESULT]" ;; esac
  echo "old" > "$t"
  private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1
  cmp -s "$OOSH_DIR/templates/user/thisLauncher" "$t" || bad="$bad stale-kept"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "installed once, executable, a stale copy replaced" || create.result 1 "install launcher:$bad"
  return $(result)
}
test.case $level "T-OO-INSTALL-LAUNCHER: the launcher is installed once, executable, and kept up to date" test.oo.installLauncher
expect 0 "installed once, executable, a stale copy replaced" "install, oo update and oo user.fix put this on the system PATH"

# T-OO-INSTALL-LAUNCHER-NO-CMP: without cmp an identical launcher is left alone
# cmp is diffutils, which AlmaLinux minimal does not ship: its rc 127 read as
# "differs", and every oo update copied the launcher again (through sudo -n for
# a user). The comparison is the kernel's private.this.file.same.
test.oo.installLauncherNoCmp() {
  local fx bad="" t inode out; fx=$(test.suite.fixture.make oolaunchernocmp); t="$fx/bin/this"
  mkdir -p "$fx/bin"; cp "$OOSH_DIR/templates/user/thisLauncher" "$t"; chmod 755 "$t"
  touch -t 202001010000 "$t"; touch -t 202001010100 "$fx/stamp"; inode=$(ls -i "$t" | cut -d' ' -f1)
  out=$(
    command() { [ "$1 $2" = "-v cmp" ] && return 1; builtin command "$@"; }
    cmp() { return 127; }   # the program is not there
    private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1; echo "rc=$? $RESULT")
  case "$out" in "rc=0 "*"up to date"*) ;; *) bad="$bad result=[$out]" ;; esac
  [ "$t" -nt "$fx/stamp" ] && bad="$bad rewritten"
  [ "$(ls -i "$t" | cut -d' ' -f1)" = "$inode" ] || bad="$bad new-inode"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "an identical launcher is left alone without cmp" || create.result 1 "launcher no cmp:$bad"
  return $(result)
}
test.case $level "T-OO-INSTALL-LAUNCHER-NO-CMP: without cmp an identical launcher is left alone" test.oo.installLauncherNoCmp
expect 0 "an identical launcher is left alone without cmp" \
  "AlmaLinux minimal has no cmp — every oo update copied the launcher again"

# T-OO-LAUNCHER-LINK-GET: BusyBox's empty shell has no /usr/local/bin
# `env -i sh` on Alpine searches /sbin:/usr/sbin:/bin:/usr/bin only, so the
# launcher in /usr/local/bin was "not found" (rc 127, the boot invariant of
# the alpine_3_19 heal gate). The second name is /usr/bin/this there, and
# nothing where the empty PATH holds the launcher's directory (glibc, macOS).
test.oo.launcherLinkGet() {
  local bad="" got
  got=$(private.oo.launcher.link.get /usr/local/bin/this "/sbin:/usr/sbin:/bin:/usr/bin"); [ "$got" = /usr/bin/this ] || bad="$bad busybox=[$got]"
  got=$(private.oo.launcher.link.get /usr/local/bin/this "/usr/local/bin:/usr/bin"); [ -z "$got" ] || bad="$bad alma=[$got]"
  got=$(private.oo.launcher.link.get /usr/local/bin/this "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"); [ -z "$got" ] || bad="$bad debian=[$got]"
  got=$(private.oo.launcher.link.get /opt/bin/this "/sbin:/usr/sbin:/bin:/usr/bin"); [ -z "$got" ] || bad="$bad not-local-bin=[$got]"
  [ -z "$bad" ] && create.result 0 "/usr/bin/this where the empty shell lacks /usr/local/bin, nothing elsewhere" || create.result 1 "launcher.link.get:$bad"
  return $(result)
}
test.case $level "T-OO-LAUNCHER-LINK-GET: an empty shell without /usr/local/bin on its PATH needs /usr/bin/this" test.oo.launcherLinkGet
expect 0 "/usr/bin/this where the empty shell lacks /usr/local/bin, nothing elsewhere" "BusyBox sh has no /usr/local/bin on its default PATH"

# T-OO-INSTALL-LAUNCHER-LINK: the second name is a link to the launcher
# A fixture <root>/usr/local/bin/this is never on the empty PATH, so its
# second name <root>/usr/bin/this is made: a link, kept on the next run; a real
# file there is not replaced (rc 1, named).
test.oo.installLauncherLink() {
  local fx bad="" t l; fx=$(test.suite.fixture.make oolauncherlink); t="$fx/usr/local/bin/this"; l="$fx/usr/bin/this"
  private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -L "$l" ] && [ "$(readlink "$l")" = "$t" ] || bad="$bad no-link"
  private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$(readlink "$l")" = "$t" ] || bad="$bad link-lost"
  rm -f "$l"; echo "someone else" > "$l"
  private.oo.install.launcher "$OOSH_DIR" "$t" >/dev/null 2>&1 && bad="$bad foreign-file-rc0"
  [ "$(cat "$l")" = "someone else" ] || bad="$bad foreign-file-replaced"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "linked, kept, a foreign file left" || create.result 1 "launcher link:$bad"
  return $(result)
}
test.case $level "T-OO-INSTALL-LAUNCHER-LINK: where the empty shell lacks the launcher dir, a link in its /usr/bin is made and kept" test.oo.installLauncherLink
expect 0 "linked, kept, a foreign file left" "env -i sh on Alpine finds this through /usr/bin"

# T-OO-ONCE-PATH-MIGRATE: oo update takes the frozen PATH line out of an existing ~/.once
# A ~/.once written before ONCE stopped freezing PATH keeps its
# `PATH="…"` line, which the .bashrc sources last. oo update removes only that
# line — ONCE's own lines stay — in place (owner and mode kept), once; a home
# without ~/.once is fine.
test.oo.oncePathMigrate() {
  local fx bad="" f; fx=$(test.suite.fixture.make oncepath); f="$fx/.once"
  printf '%s\n' 'export ONCE_DEFAULT_SCENARIO=/x/latestServer' '. $ONCE_DEFAULT_SCENARIO/.once' \
    'PATH="/root/oosh/su:/root/oosh:/usr/bin:/bin"' > "$f"
  chmod 640 "$f"
  private.oo.once.path.migrate "$fx" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ "$(cat "$f")" = 'export ONCE_DEFAULT_SCENARIO=/x/latestServer
. $ONCE_DEFAULT_SCENARIO/.once' ] || bad="$bad content=[$(tr '\n' '|' < "$f")]"
  [ "$(ls -l "$f" | cut -c1-10)" = "-rw-r-----" ] || bad="$bad mode-changed"
  private.oo.once.path.migrate "$fx" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  [ "$(grep -c '' "$f")" = 2 ] || bad="$bad not-idempotent"
  rm -f "$f"; private.oo.once.path.migrate "$fx" >/dev/null 2>&1 || bad="$bad missing-file-rc=$?"
  [ -e "$f" ] && bad="$bad created"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "only the frozen PATH line leaves ~/.once, in place, once" || create.result 1 "once PATH migrate:$bad"
  return $(result)
}
test.case $level "T-OO-ONCE-PATH-MIGRATE: oo update takes the frozen PATH line out of an existing ~/.once" test.oo.oncePathMigrate
expect 0 "only the frozen PATH line leaves ~/.once, in place, once" \
  "an old ~/.once kept overwriting the user's own PATH at the end of every .bashrc"

# T-OO-INSTALL-WRITES-ODOCKER-ENV: the install and a root oo update write odocker.env
test.oo.installWritesOdockerEnv() {
  local bad=""
  case "$(declare -f private.check.root.installation.done)" in *private.odocker.workspaces.install*) ;; *) bad="$bad install-state" ;; esac
  [ -z "$bad" ] && create.result 0 "the install writes odocker.env" || create.result 1 "odocker.env not written by:$bad"
  return $(result)
}
# The root oo update half is behavioural now: T-OO-UPDATE-CALLS.
test.case $level "T-OO-INSTALL-WRITES-ODOCKER-ENV: the install writes odocker.env" test.oo.installWritesOdockerEnv
expect 0 "the install writes odocker.env" "every install must carry ~/config/odocker.env, as the host does"

# T-OO-UPDATE-REFRESHES-HOST-NAME (an installed container kept its ID in the
# prompt) and T-OO-UPDATE-ODOCKER-ENV-INSTALLED-ONLY (the install's first oo
# update ran before the shared config existed — "ERROR> no Docker workspaces
# root could be derived", 2026-10-06; an INSTALLED computer is one whose
# ~/config links to the shared config, a user.env is no sign) read the source
# of oo.update. T-OO-UPDATE-CALLS runs it: the refresh is called, odocker.env
# only as root once ~/config is a link.

# ============================================================================
# T-OO-UPDATE-CALLS: oo update runs its steps — which, in which order, the same
# on a second run
# ============================================================================
# oo update was tested by reading its source (`declare -f oo.update` for the
# host-name refresh, the odocker.env write, the drop-in cleanup). Here it RUNS,
# every collaborator a recording stand-in, in a fixture HOME; root or not is
# the `id -u` it asks (a stand-in function), a computer is installed when its
# ~/config is a link.
test.oo.updateCalls.run() { # <fx> <uid> # run oo.update with recording stand-ins; echo the calls, one per line, then rc=<n>
  local fx="$1"
  : > "$fx/calls"
  (
    private.this.script.load ogit ogit.branch.get
    HOME="$fx/home"; OOSH_DIR="$fx/home"; TEST_OO_UID="$2"
    id() { if [ "$1" = -u ]; then echo "$TEST_OO_UID"; else command id "$@"; fi; }
    test.oo.updateCalls.record() { echo "$*" >> "$fx/calls"; }
    private.oo.update.pull()            { test.oo.updateCalls.record update.pull; }
    oo.mode.base.get()                  { echo "$fx/base"; }
    ogit.safeDirectory.ensure()         { test.oo.updateCalls.record "ogit.safeDirectory.ensure ${1#$fx/}"; }
    private.oo.update.heal.symlinks()   { test.oo.updateCalls.record heal.symlinks; }
    ogit.safeDirectory.prune()          { test.oo.updateCalls.record safeDirectory.prune; }
    private.user.bashrc.install()       { test.oo.updateCalls.record bashrc.install; }
    private.config.session.file.ensure() { test.oo.updateCalls.record session.file.ensure; }
    private.oo.dropin.remove()          { test.oo.updateCalls.record dropin.remove; }
    private.oo.install.launcher()       { test.oo.updateCalls.record install.launcher; }
    private.oo.once.path.migrate()      { test.oo.updateCalls.record once.path.migrate; }
    private.odocker.workspaces.install() { test.oo.updateCalls.record odocker.workspaces.install; }
    private.config.host.name.refresh() { test.oo.updateCalls.record config.host.name.refresh; }
    oo.update >/dev/null 2>&1
    echo "rc=$?" >> "$fx/calls"
  )
  tr '\n' ' ' < "$fx/calls"
}
test.oo.updateCalls() {
  local fx bad="" got first; fx=$(test.suite.fixture.make updatecalls); mkdir -p "$fx/home" "$fx/base" "$fx/sharedConfig"
  # heal.symlinks, then the shell step oo heal shares (private.oo.heal.shell):
  # trust, prune, .bashrc, session files, drop-in, launcher, ~/.once.
  local shell="ogit.safeDirectory.ensure base safeDirectory.prune bashrc.install session.file.ensure dropin.remove install.launcher once.path.migrate"
  local user="update.pull heal.symlinks $shell config.host.name.refresh rc=0 "
  local root="update.pull heal.symlinks $shell odocker.workspaces.install config.host.name.refresh rc=0 "
  got=$(test.oo.updateCalls.run "$fx" 1000); [ "$got" = "$user" ] || bad="$bad user=[$got]"
  # root, not installed yet (~/config no link): odocker.env is not written
  got=$(test.oo.updateCalls.run "$fx" 0);    [ "$got" = "$user" ] || bad="$bad root-not-installed=[$got]"
  ln -s "$fx/sharedConfig" "$fx/home/config"
  first=$(test.oo.updateCalls.run "$fx" 0);  [ "$first" = "$root" ] || bad="$bad root=[$first]"
  got=$(test.oo.updateCalls.run "$fx" 0);    [ "$got" = "$first" ] || bad="$bad second-run=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oo update calls its steps in order, odocker.env only as root on an installed computer, the same on a second run" || create.result 1 "oo update:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-CALLS: oo update runs its steps in order, the same on a second run" test.oo.updateCalls
expect 0 "oo update calls its steps in order, odocker.env only as root on an installed computer, the same on a second run" \
  "oo update was tested only by reading its source"

# T-OO-HEAL-SHELL-SHARED-WITH-UPDATE: oo update runs the shell step of oo heal, once
# Owner decision 8: the shell step (trust, .bashrc, session files, drop-in,
# launcher, ~/.once) is ONE method, private.oo.heal.shell, for oo update and
# oo heal; the other steps of oo update stay its own.
test.oo.healShellSharedWithUpdate() {
  local fx got; fx=$(test.suite.fixture.make healshell); mkdir -p "$fx/home"
  (
    private.this.script.load ogit ogit.branch.get
    HOME="$fx/home"; OOSH_DIR="$fx/home"; LOG_DEVICE="$fx/log.out"
    private.oo.update.pull()            { create.result 0 pulled; }
    private.oo.update.heal.symlinks()   { echo "symlinks" >> "$fx/calls"; }
    private.oo.heal.shell()             { echo "shell[$1|$2|$3]" >> "$fx/calls"; }
    private.config.host.name.refresh()  { echo "hostname" >> "$fx/calls"; }
    oo.update >/dev/null 2>&1 )
  got=$(tr '\n' ' ' < "$fx/calls" 2>/dev/null)
  rm -rf "$fx"
  [ "$got" = "symlinks shell[$fx/home||yes] hostname " ] && create.result 0 "oo update calls private.oo.heal.shell once" || create.result 1 "calls=[$got]"
  return $(result)
}
test.case $level "T-OO-HEAL-SHELL-SHARED-WITH-UPDATE: oo update runs private.oo.heal.shell once" test.oo.healShellSharedWithUpdate
expect 0 "oo update calls private.oo.heal.shell once" "oo update and oo heal had two copies of the shell step"

# T-OO-CMD-NO-NOISE: oo cmd does not print "no <command>" before installing it
# `odocker list` printed "no docker", "no column" between its own lines
# (Alpine, 2026-10-06) — the install announcement says it already.
test.oo.cmdNoNoise() {
  case "$(declare -f oo.cmd)" in
    *'console.log "no $current"'*) create.result 1 "oo cmd still prints no <command>" ;;
    *) create.result 0 "no noise line" ;;
  esac
  return $(result)
}
test.case $level "T-OO-CMD-NO-NOISE: oo cmd does not print no <command> before installing it" test.oo.cmdNoNoise
expect 0 "no noise line" "odocker list printed no docker, no column"

console.log "
Test: private.oo.shared.tree.ensure
===================================================================="

# T-SHARED-TREE-ENSURE: install state 31 heals a half-made first run
# State 31 cloned main with ogit repo.clone, which (rightly) refuses a non-empty
# target — so on a re-run main/ "failed", the log blamed SSH, the local
# fallback returned at its main/-present fast path and the branch folder was
# never made. private.oo.shared.tree.ensure keeps an existing clone of main and
# makes the branch folder in every case where main/ is there; the local copy
# of ~/oosh runs only when main/ could really not be cloned. Driven on a
# fixture base with a local bare origin; the log goes to a file.
test.oo.sharedTreeEnsure() {
  local base fx bad="" rc out
  base=$(test.oo.base sharedtree clone); fx=$(dirname "$base")
  mkdir -p "$fx/home"
  test.oo.sharedTreeEnsure.run() { # <url> <base> <branch> # run it with HOME and LOG_DEVICE in the fixture; rc of the call
    ( HOME="$fx/home"; LOG_DEVICE="$fx/log.out"; LOG_LEVEL=3; export HOME
      private.oo.shared.tree.ensure "$@" >/dev/null 2>&1 )
  }
  # 1. A half-made first run: main/ there, dev/ missing.
  rm -rf "$base/dev"; : > "$fx/log.out"
  test.oo.sharedTreeEnsure.run "$fx/origin.git" "$base" dev; rc=$?
  out=$(cat "$fx/log.out" 2>/dev/null)
  [ "$rc" = 0 ] || bad="$bad heal-rc=$rc"
  [ "$(git -C "$base/dev" symbolic-ref --short HEAD 2>/dev/null)" = dev ] || bad="$bad dev-not-made"
  case "$out" in *"falling back"*|*"SSH clone failed"*) bad="$bad blamed-ssh" ;; esac
  # 2. A second run changes nothing.
  local d
  touch -t 202001010000 "$base" "$base/main" "$base/dev" "$base/main/.git" "$base/dev/.git"
  touch -t 202001010100 "$fx/stamp"; : > "$fx/log.out"
  test.oo.sharedTreeEnsure.run "$fx/origin.git" "$base" dev; rc=$?
  out=$(cat "$fx/log.out" 2>/dev/null)
  [ "$rc" = 0 ] || bad="$bad rerun-rc=$rc"
  for d in "$base" "$base/main" "$base/dev" "$base/main/.git" "$base/dev/.git"; do
    [ "$d" -nt "$fx/stamp" ] && bad="$bad rerun-changed:${d#$fx/}"
  done
  case "$out" in *"falling back"*) bad="$bad rerun-fell-back" ;; esac
  # 3. A first run on an empty base: main/ and the branch folder are cloned.
  mkdir -p "$fx/empty"
  test.oo.sharedTreeEnsure.run "$fx/origin.git" "$fx/empty" prod; rc=$?
  [ "$rc" = 0 ] || bad="$bad fresh-rc=$rc"
  [ "$(git -C "$fx/empty/main" symbolic-ref --short HEAD 2>/dev/null)" = main ] || bad="$bad fresh-no-main"
  [ "$(git -C "$fx/empty/prod" symbolic-ref --short HEAD 2>/dev/null)" = prod ] || bad="$bad fresh-no-prod"
  # 4. main cannot be cloned: the local copy of ~/oosh builds the layout.
  ln -s "$base/dev" "$fx/home/oosh"; mkdir -p "$fx/offline"; : > "$fx/log.out"
  test.oo.sharedTreeEnsure.run "$fx/nowhere.git" "$fx/offline" dev; rc=$?
  out=$(cat "$fx/log.out" 2>/dev/null)
  [ "$rc" = 0 ] || bad="$bad fallback-rc=$rc"
  [ -d "$fx/offline/main/.git" ] || bad="$bad fallback-no-main"
  [ "$(git -C "$fx/offline/dev" symbolic-ref --short HEAD 2>/dev/null)" = dev ] || bad="$bad fallback-no-dev"
  case "$out" in *"falling back"*) ;; *) bad="$bad fallback-not-logged" ;; esac
  # 5. <localSource> names the tree to copy offline — oo heal's own tree, not
  # $HOME/oosh, which in a heal can be the broken one.
  git clone -q -b dev "$fx/origin.git" "$fx/tree" 2>/dev/null
  printf 'x\n' > "$fx/tree/from.tree"; printf 'x\n' > "$base/dev/from.home"; mkdir -p "$fx/offline2"
  test.oo.sharedTreeEnsure.run "$fx/nowhere.git" "$fx/offline2" dev "$fx/tree"; rc=$?
  [ "$rc" = 0 ] || bad="$bad localsource-rc=$rc"
  [ -f "$fx/offline2/main/from.tree" ] || bad="$bad localsource-not-copied"
  [ -f "$fx/offline2/main/from.home" ] && bad="$bad home-oosh-copied"
  unset -f test.oo.sharedTreeEnsure.run
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "main kept, branch folder made, second run changes nothing" || create.result 1 "shared.tree.ensure:$bad"
  return $(result)
}
test.case $level "T-SHARED-TREE-ENSURE: install state 31 heals a half-made first run" test.oo.sharedTreeEnsure
expect 0 "main kept, branch folder made, second run changes nothing" "a re-run blamed SSH and never made the branch folder"

# T-BASE-FOLDERS-ONE-LOOP: oo's folder lists agree with private.ogit.base.folders.list
# oo.mode.list, oo.branch.list and private.oo.completion.worktree.branches each
# had a hand copy of the folder loop (skip a symlink, need .git, skip a
# dot-name); private.ogit.base.folders.list owns those rules. On a base with a
# symlinked folder, a folder whose .git is a FILE, a dot-folder with a .git and
# a folder without one, all three name exactly the owner's folders.
test.oo.baseFoldersOneLoop() {
  private.this.script.load ogit ogit.branch.get
  local base fx bad="" want got
  base=$(test.oo.base basefolders clone); fx=$(dirname "$base")
  ln -s "$base/main" "$base/lnk"
  mkdir -p "$base/.hidden/.git" "$base/plain" "$base/wt"
  printf 'gitdir: %s\n' "$base/main/.git/worktrees/wt" > "$base/wt/.git"
  mkdir -p "$fx/none"
  want=$(private.ogit.base.folders.list "$base" | sed 's|.*/||' | sort | tr '\n' ' ')
  [ "$want" = "dev main prod wt " ] || bad="$bad owner=[$want]"
  got=$( OOSH_COMPONENTS_DIR="$base"; OOSH_DIR="$fx/none"; export OOSH_COMPONENTS_DIR OOSH_DIR
         private.oo.completion.worktree.branches | sort | tr '\n' ' ' )
  [ "$got" = "$want" ] || bad="$bad completion=[$got]"
  got=$( OOSH_COMPONENTS_DIR="$base"; OOSH_DIR="$fx/none"; export OOSH_COMPONENTS_DIR OOSH_DIR
         oo.branch.list local 2>/dev/null | sort | tr '\n' ' ' )
  [ "$got" = "$want" ] || bad="$bad branch.list=[$got]"
  got=$( OOSH_COMPONENTS_DIR="$base"; OOSH_DIR="$fx/none"; export OOSH_COMPONENTS_DIR OOSH_DIR
         oo.mode.list 2>/dev/null | awk '{print $1}' | sort | tr '\n' ' ' )
  [ "$got" = "$want" ] || bad="$bad mode.list=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the three folder lists are the owner's" || create.result 1 "folder lists:$bad"
  return $(result)
}
test.case $level "T-BASE-FOLDERS-ONE-LOOP: oo.mode.list, oo.branch.list and the completion name the folders private.ogit.base.folders.list names" \
  test.oo.baseFoldersOneLoop
expect 0 "the three folder lists are the owner's" "three hand copies of the folder loop"


console.log "
Test: private.oo.method.end.get
===================================================================="

test.oo.methodEndGet() {
  local fx bad="" got; fx=$(test.suite.fixture.make methodendget)
  printf '%s\n' 'one() { echo one; }' 'two() # # doc' '{ echo two; }' 'three() # # doc' '{' '  local b="}"' '  echo three' '}' \
    'open() # # doc, never closed' '{' '  echo open' 'next() # # doc' '{' '}' 'tail() # # doc' '{' '  echo tail' '### new.method' > "$fx/probe"
  got=$(private.oo.method.end.get "$fx/probe" 'one() { echo one; }');  [ "$got" = 'one() { echo one; }' ] || bad="$bad one=[$got]"
  got=$(private.oo.method.end.get "$fx/probe" 'two() # # doc');        [ "$got" = '{ echo two; }' ] || bad="$bad two=[$got]"
  got=$(private.oo.method.end.get "$fx/probe" 'three() # # doc');      [ "$got" = '}' ] || bad="$bad three=[$got]"
  got=$(private.oo.method.end.get "$fx/probe" 'open() # # doc, never closed'); [ -z "$got" ] || bad="$bad open=[$got]"
  got=$(private.oo.method.end.get "$fx/probe" 'tail() # # doc');       [ -z "$got" ] || bad="$bad tail=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "one-line, two-line and block ends found; an unclosed one is refused" || create.result 1 "method.end.get:$bad"
  return $(result)
}
test.case - "T-OO-METHOD-END-GET: the closing line of a one-line, a two-line and a block definition" \
   test.oo.methodEndGet
expect 0 "one-line, two-line and block ends found; an unclosed one is refused" \
  "the first } line alone ran a { …; } body into the next method"


console.log "
Test: private.oo.path.writable.is
===================================================================="

test.oo.pathWritableIs() {
  # Only the "may write" half: root may write anything, so the "may not"
  # answer cannot be produced the same way for root and a user — the callers'
  # tests stub this predicate for it (T-OO-PATH-SUDO-GET, T-OO-PRIVILEGE-QUIET).
  local fx bad=""; fx=$(test.suite.fixture.make pathwritable); : > "$fx/file"
  private.oo.path.writable.is "$fx" || bad="$bad dir"
  private.oo.path.writable.is "$fx/file" || bad="$bad file"
  private.oo.path.writable.is "$fx/not/yet/there" || bad="$bad missing-under-writable"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a writable path, and a missing one under it, are writable" || create.result 1 "writable.is:$bad"
  return $(result)
}
test.case - "T-OO-PATH-WRITABLE-IS: a writable path and a missing one under it answer rc 0" \
   test.oo.pathWritableIs
expect 0 "a writable path, and a missing one under it, are writable" \
  "the launcher walked to the nearest existing directory, the drop-in cleanup did not"


console.log "
Test: private.oo.pm.install.prefix.get
===================================================================="

test.oo.pmInstallPrefixGet() {
  # Root or not is driven through $SUDO — the variable oo.cmd decides with
  # ("" for root, "sudo " for a user; `this` sets it) — never the real id.
  # A getter: judged on what it ECHOES.
  local bad="" got aptEnv="env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes"
  test.oo.pmInstallPrefixGet.one() { # <SUDO> <SUDO_USER> <pmCmd> <want>
    got=$(SUDO="$1"; SUDO_USER="$2"; private.oo.pm.install.prefix.get "$3")
    [ "$got" = "$4" ] || bad="$bad [$1|$2|$3]=[$got]"
  }
  test.oo.pmInstallPrefixGet.one "sudo " ""    "apt-get -y install" "sudo $aptEnv"
  test.oo.pmInstallPrefixGet.one ""      ""    "apt-get -y install" "$aptEnv"
  test.oo.pmInstallPrefixGet.one "sudo " ""    "dnf -y install"     "sudo"
  test.oo.pmInstallPrefixGet.one ""      ""    "dnf -y install"     ""
  test.oo.pmInstallPrefixGet.one "sudo " ""    "apk add"            "sudo"
  test.oo.pmInstallPrefixGet.one ""      ""    "apk add"            ""
  # Homebrew refuses root: never sudo in front; root reached through sudo
  # hops back to the person who typed it.
  test.oo.pmInstallPrefixGet.one "sudo " ""    "brew install"       "env HOMEBREW_NO_ASK=1"
  test.oo.pmInstallPrefixGet.one ""      ""    "brew install"       "env HOMEBREW_NO_ASK=1"
  test.oo.pmInstallPrefixGet.one ""      alice "brew install"       "sudo -u alice -H env HOMEBREW_NO_ASK=1"
  got=$(SUDO="sudo "; OOSH_PM="dnf -y install"; private.oo.pm.install.prefix.get); [ "$got" = "sudo" ] || bad="$bad default=[$got]"
  unset -f test.oo.pmInstallPrefixGet.one
  [ -z "$bad" ] && create.result 0 "sudo none for brew and root, else \$SUDO; apt and brew get their env" || create.result 1 "install prefix:$bad"
  return $(result)
}
test.case - "T-OO-PM-INSTALL-PREFIX-GET: apt-get, dnf, apk and brew as root and as a user" \
   test.oo.pmInstallPrefixGet
expect 0 "sudo none for brew and root, else \$SUDO; apt and brew get their env" \
  "how to call a package manager existed three times: oo.cmd, oo.prereqs.install, ossh.cmd"

# test.oo.pmHost <fx> <pm…>: a fixture host whose package managers are exactly
# <pm…> — recording stubs on <fx>/bin, as is sudo (it records, then runs the
# command). An install stub puts the package on <fx>/bin, so oo.cmd's verify
# finds it. Config, HOME and every record live in <fx>.
test.oo.pmHost() {
  local fx="$1" pm; shift
  mkdir -p "$fx/bin" "$fx/config/stateMachines" "$fx/home"
  : > "$fx/calls"; : > "$fx/config/user.env"; : > "$fx/config/result.env"; : > "$fx/config/error.txt"
  printf '#!/bin/sh\necho "sudo $*" >> "$FX/calls"; exec "$@"\n' > "$fx/bin/sudo"
  for pm; do
    printf '#!/bin/sh\necho "%s $*" >> "$FX/calls"\ncase " $* " in *" install "*|*" add "*) for p; do :; done; printf "#!/bin/sh\\n" > "$FX/bin/$p"; chmod +x "$FX/bin/$p" ;; esac\nexit 0\n' "$pm" > "$fx/bin/$pm"
  done
  chmod +x "$fx/bin/"*
}
# test.oo.pmHost.run <fx> <code>: run <code> after sourcing this and oo, in a
# child that sees only the fixture's package managers (every other one is
# hidden from `command -v`, also in child processes), with an isolated config,
# a fixture HOME, SUDO="sudo " and nothing of this shell's package manager state.
test.oo.pmHost.run() {
  FX="$1" CODE="$2" env -u OOSH_NO_INSTALL -u OOSH_PM -u OOSH_PM_UPDATED -u OOSH_APT_UPDATED \
    -u OS_CMD_USER_ADD -u OS_CMD_USER_DEL -u OS_CMD_USER_MOD -u OS_CMD_GROUP_ADD \
    PATH="$1/bin:$PATH" HOME="$1/home" CONFIG_PATH="$1/config" CONFIG_FILE=user.env CONFIG="$1/config/user.env" \
    ${TEST_OO_PM_ENV:-} bash -c '
      command() {
        if [ "$1" = -v ]; then
          case "$2" in brew|apt-get|dnf|yum|apk|dpkg|pkg|pacman) [ -x "$FX/bin/$2" ] && echo "$FX/bin/$2"; return ;; esac
        fi
        builtin command "$@"
      }
      export -f command
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/oo" >/dev/null 2>&1
      export SUDO="sudo "
      eval "$CODE"' </dev/null >/dev/null 2>&1
  tr '\n' '|' < "$1/calls"
}

# T-OO-PM-DISCOVER-RECORDS: discovering the package manager runs nothing — no sudo, no apt-get update
# private.check.pm ran "$SUDO apt-get update" the moment it found apt-get, and
# private.user.init runs oo pm.discover whenever os.commands.env is incomplete:
# merely sourcing user asked for a sudo password on an apt host (a new user's
# first shell, every test with an isolated config — 2026-10-06).
test.oo.pmDiscoverRecords() {
  local fx bad="" got; fx=$(test.suite.fixture.make oopmdiscover)
  test.oo.pmHost "$fx" apt-get
  got=$(test.oo.pmHost.run "$fx" 'oo.pm.discover; echo "pm=[$OOSH_PM]" >> "$FX/calls"')
  [ "$got" = "pm=[apt-get -y install]|" ] || bad="$bad apt=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "discovery records apt-get and calls nothing" || create.result 1 "discover:$bad"
  return $(result)
}
test.case $level "T-OO-PM-DISCOVER-RECORDS: discovering the package manager runs nothing — no sudo, no apt-get update" test.oo.pmDiscoverRecords
expect 0 "discovery records apt-get and calls nothing" \
  "sourcing user on an apt host ran sudo apt-get update — a password prompt in a new shell and in a test run"

# T-OO-CMD-REFRESH-ONCE: the first real install refreshes the package lists once, before it
# A fresh apt image has empty package lists: the first real install must be
# preceded by apt-get update — once, also for a second install in the same
# shell, never for a tool that is there, never in a test run.
test.oo.cmdRefreshOnce() {
  local fx bad="" got; fx=$(test.suite.fixture.make oocmdrefresh)
  test.oo.pmHost "$fx" apt-get
  got=$(test.oo.pmHost.run "$fx" 'oo.cmd ooshtoolone; echo "rc=$?" >> "$FX/calls"; oo.cmd ooshtooltwo; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "sudo apt-get update|apt-get update|sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes apt-get -y install ooshtoolone|apt-get -y install ooshtoolone|rc=0|sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes apt-get -y install ooshtooltwo|apt-get -y install ooshtooltwo|rc=0|" ] \
    || bad="$bad install=[$got]"
  test.oo.pmHost "$fx" apt-get
  got=$(test.oo.pmHost.run "$fx" 'oo.cmd sh; echo "rc=$? pm=[$OOSH_PM]" >> "$FX/calls"')
  [ "$got" = "rc=0 pm=[]|" ] || bad="$bad present=[$got]"
  test.oo.pmHost "$fx" apt-get
  got=$(TEST_OO_PM_ENV="OOSH_NO_INSTALL=1" test.oo.pmHost.run "$fx" 'oo.cmd ooshtoolthree; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "rc=1|" ] || bad="$bad no-install=[$got]"
  test.oo.pmHost "$fx" apt-get
  got=$(TEST_OO_PM_ENV="OOSH_APT_UPDATED=1" test.oo.pmHost.run "$fx" 'oo.cmd ooshtoolfour; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes apt-get -y install ooshtoolfour|apt-get -y install ooshtoolfour|rc=0|" ] || bad="$bad init-refreshed=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "one refresh before the first real install, none otherwise" || create.result 1 "refresh:$bad"
  return $(result)
}
test.case $level "T-OO-CMD-REFRESH-ONCE: the first real install refreshes the package lists once, before it" test.oo.cmdRefreshOnce
expect 0 "one refresh before the first real install, none otherwise" \
  "a fresh apt image has empty package lists — the install must still refresh them, once"

# T-OO-CMD-REFRESH-MARKER: the "refreshed" marker is set only after a refresh that worked, and config save never harvests it
# OOSH_PM_UPDATED was a plain global, assigned BEFORE the refresh ran: a failed
# refresh was never retried, and `config save` (it lists every OOSH_* of the
# saving shell) wrote it into the shared oosh.env — install state 31 runs
# oo.cmd and then config save in one process — so every later shell answered
# "already updated" and installed on stale lists.
test.oo.cmdRefreshMarker() {
  local fx bad="" got; fx=$(test.suite.fixture.make oocmdrefreshmarker)
  test.oo.pmHost "$fx" apt-get
  got=$(test.oo.pmHost.run "$fx" 'oo.cmd ooshtoolone >/dev/null; private.this.script.load config private.config.variables.list; private.config.variables.list OOSH no > "$FX/harvest"')
  case "$got" in (*"apt-get update"*) ;; (*) bad="$bad no-refresh=[$got]" ;; esac
  grep -q -e OOSH_PM_UPDATED -e OOSH_APT_UPDATED "$fx/harvest" && bad="$bad harvested=[$(grep -e OOSH_PM_UPDATED -e OOSH_APT_UPDATED "$fx/harvest" | tr '\n' ' ')]"
  grep -q OOSH_ "$fx/harvest" || bad="$bad harvest-empty-probe-broken"
  printf '#!/bin/sh\necho "apt-get $*" >> "$FX/calls"\ncase " $* " in *" update "*) exit 1 ;; esac\nexit 0\n' > "$fx/bin/apt-get"
  : > "$fx/calls"
  got=$(test.oo.pmHost.run "$fx" 'oo.cmd ooshtoolfive; oo.cmd ooshtoolsix')
  [ "$(printf '%s' "$got" | tr '|' '\n' | grep -c '^apt-get update')" = 2 ] || bad="$bad failed-refresh-not-retried=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the marker follows a refresh that worked and is never harvested" || create.result 1 "refresh marker:$bad"
  return $(result)
}
test.case $level "T-OO-CMD-REFRESH-MARKER: a failed refresh is retried, and config save never harvests the marker" test.oo.cmdRefreshMarker
expect 0 "the marker follows a refresh that worked and is never harvested" \
  "OOSH_PM_UPDATED was set before the refresh ran and config save wrote it into the shared oosh.env"

# T-CMD-NO-INSTALL-BUSYBOX: the BusyBox-wget upgrade passes the same refusal (T-CMD-NO-INSTALL)
# A BusyBox wget is present, so oo.cmd wget took the "already present" branch —
# and inside it discovered the package manager and installed full wget, before
# the OOSH_NO_INSTALL refusal; with no package manager known it ran `sudo wget`.
# Here on the pmHost fixture (discovery sees only the fixture's tools).
test.oo.cmdBusyboxWget() { # <fx> # put a BusyBox wget stub into <fx>/bin
  printf '#!/bin/sh\ncase "$1" in --help) echo "BusyBox v1.36.1 multi-call binary."; exit 0 ;; esac\necho "wget $*" >> "$FX/calls"\n' > "$1/bin/wget"
  chmod +x "$1/bin/wget"
}
test.oo.cmdNoInstallBusybox() {
  local fx bad="" got; fx=$(test.suite.fixture.make oocmdbusybox)
  test.oo.pmHost "$fx" apt-get; test.oo.cmdBusyboxWget "$fx"
  got=$(TEST_OO_PM_ENV="OOSH_NO_INSTALL=1" test.oo.pmHost.run "$fx" 'oo.cmd wget; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "rc=0|" ] || bad="$bad no-install=[$got]"
  rm -f "$fx/bin/apt-get"; test.oo.pmHost "$fx"; test.oo.cmdBusyboxWget "$fx"
  got=$(test.oo.pmHost.run "$fx" 'oo.cmd wget; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "rc=0|" ] || bad="$bad no-pm=[$got]"
  test.oo.pmHost "$fx" apt-get; test.oo.cmdBusyboxWget "$fx"
  got=$(test.oo.pmHost.run "$fx" 'oo.cmd wget; echo "rc=$?" >> "$FX/calls"')
  case "$got" in (*"|apt-get -y install wget|rc=0|") ;; (*) bad="$bad control=[$got]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a BusyBox wget is upgraded only outside a test run and only by a known package manager" || create.result 1 "busybox:$bad"
  return $(result)
}
test.case $level "T-CMD-NO-INSTALL-BUSYBOX: the BusyBox-wget upgrade installs nothing in a test run and nothing without a package manager" test.oo.cmdNoInstallBusybox
expect 0 "a BusyBox wget is upgraded only outside a test run and only by a known package manager" \
  "oo cmd wget under OOSH_NO_INSTALL installed full wget through sudo; with no package manager it ran sudo wget"

# T-OO-PM-OTHER-UNCHANGED: dnf and apk — discovery and install call what they called before
# Discovery never refreshed dnf, yum or apk; oo.cmd installs on them without a
# refresh. Recorded on the code before the apt-get change.
test.oo.pmOtherUnchanged() {
  local fx bad="" got pm; fx=$(test.suite.fixture.make oopmother)
  test.oo.pmHost "$fx" dnf
  got=$(test.oo.pmHost.run "$fx" 'oo.pm.discover; echo "pm=[$OOSH_PM]" >> "$FX/calls"; oo.cmd ooshtoolone; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "pm=[dnf -y install]|sudo dnf -y install ooshtoolone|dnf -y install ooshtoolone|rc=0|" ] || bad="$bad dnf=[$got]"
  rm -rf "$fx/bin"; test.oo.pmHost "$fx" apk
  got=$(test.oo.pmHost.run "$fx" 'oo.pm.discover; echo "pm=[$OOSH_PM]" >> "$FX/calls"; oo.cmd ooshtoolone; echo "rc=$?" >> "$FX/calls"')
  [ "$got" = "pm=[apk add]|sudo apk add ooshtoolone|apk add ooshtoolone|rc=0|" ] || bad="$bad apk=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "dnf and apk: no refresh, one install" || create.result 1 "other pms:$bad"
  return $(result)
}
test.case $level "T-OO-PM-OTHER-UNCHANGED: dnf and apk — discovery and install call what they called before" test.oo.pmOtherUnchanged
expect 0 "dnf and apk: no refresh, one install" "the apt-get fix must not change dnf, yum, apk or brew"

# T-OO-BRANCH-NO-ALIAS: oo and user ask ogit.branch.get — they work without this.git.branch.short
# this.git.branch.short was a second name for ogit.branch.get; the owner
# decided it goes. The install branch is asked with the alias gone; the other
# sites (oo update, oo mode.setup, user.oosh.install) need a real install or a
# clone, so for them the source is asked: no call of the alias is left.
test.oo.branchNoAlias() {
  local fx bad="" got want hits
  fx=$(test.suite.fixture.make oobranchnoalias); ln -s "$OOSH_DIR" "$fx/oosh"; test.oo.homeTrust "$fx" "$OOSH_DIR"
  private.this.script.load ogit ogit.branch.get; want=$(ogit.branch.get "$OOSH_DIR")
  got=$( unset -f this.git.branch.short; unset OOSH_BRANCH; HOME="$fx"; private.oo.install.branch.get 2>/dev/null )
  [ "$got" = "${want:-main}" ] || bad="$bad install.branch=[$got]-want=[${want:-main}]"
  hits=$(grep -n 'this\.git\.branch\.short' "$OOSH_DIR/oo" "$OOSH_DIR/user" | cut -d: -f1,2 | tr '\n' ' ')
  [ -z "$hits" ] || bad="$bad alias-callers=[$hits]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the branch comes from ogit.branch.get, the alias is not called" || create.result 1 "branch alias:$bad"
  return $(result)
}
test.case $level "T-OO-BRANCH-NO-ALIAS: oo and user ask ogit.branch.get — they work without this.git.branch.short" test.oo.branchNoAlias
expect 0 "the branch comes from ogit.branch.get, the alias is not called" "one getter had two names"


console.log "
Test: private.oo.layout.folder.check
===================================================================="

test.oo.layoutFolderCheck() { # # prod/ with a detached HEAD is a layout folder; a plain clone beside main/ is not, and not under byBranch no once its branch folder stands
  local base fx bad=""
  base=$(test.oo.base test.oo.layout.folder clone) || { create.result 1 "fixture failed"; return $(result); }
  fx="${base%/*}"
  git -C "$base/prod" checkout -q --detach
  git clone -q -b dev "$fx/origin.git" "$base/oosh-clone" >/dev/null 2>&1
  private.oo.layout.folder.check "$base/oosh-clone" "$base" >/dev/null || bad="$bad beside-dev-not-layout[$RESULT]"
  private.oo.layout.folder.check "$base/oosh-clone" "$base" no >/dev/null && bad="$bad source-is-layout[$RESULT]"
  private.oo.layout.folder.check "$fx/origin.git" "$base" >/dev/null && bad="$bad outside-is-layout[$RESULT]"
  private.oo.layout.folder.check "$base/prod" "$base" >/dev/null
  local rc=$? res="$RESULT"
  rm -rf "$fx"
  [ -z "$bad" ] || { create.result 1 "layout.folder.check:$bad"; return $(result); }
  create.result "$rc" "$res"
  return $(result)
}
test.case - "T-OO-LAYOUT-FOLDER-CHECK: a layout folder is recognised whatever is checked out in it" \
   test.oo.layoutFolderCheck
expect 0 "prod is a folder of the layout"


console.log "
Test: private.oo.source.consume.gate
===================================================================="

test.oo.sourceConsumeGate() { # # a clean pushed clone passes; one with an uncommitted change is refused by name
  local origin fx src bad=""
  origin=$(test.oo.base test.oo.source.gate clone) || { create.result 1 "fixture failed"; return $(result); }
  fx="${origin%/*}"; src="$fx/oosh-clone"
  git clone -q -b dev "$fx/origin.git" "$src" >/dev/null 2>&1
  private.oo.source.consume.gate "$src" "$src" >/dev/null
  local rc=$? res="$RESULT"
  printf 'dirty\n' >> "$src/file"
  if private.oo.source.consume.gate "$src" "$src" >/dev/null; then bad="$bad dirty-passed"
  else case "$RESULT" in (*"$src"*uncommitted*) ;; (*) bad="$bad dirty-result=[$RESULT]" ;; esac; fi
  rm -rf "$fx"
  [ -z "$bad" ] || { create.result 1 "source.consume.gate:$bad"; return $(result); }
  create.result "$rc" "$res"
  return $(result)
}
test.case - "T-OO-SOURCE-CONSUME-GATE: a clean pushed source passes the gate" \
   test.oo.sourceConsumeGate
expect 0 "oosh-clone holds no ref of its own"

console.log "
Test: private.oo.shared.base.ensure
===================================================================="

# T-OO-SHARED-BASE-ENSURE: install state 31's shared base, on a fixture basehome
# The base directories (dev/Workspaces, the Scenarios and Components Once.sh
# folders) come from one method the state and the heal call. A sudo that
# records and fails stands in: nothing here may reach the real one.
test.oo.sharedBaseEnsure.run() { # <fx> <basehome> <?owner> # run private.oo.shared.base.ensure with the recording sudo; echo rc=<n> RESULT=<result>
  local fx="$1"; shift
  ( PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"; LOG_DEVICE="$fx/log.out"
    private.oo.shared.base.ensure "$@" >/dev/null 2>&1
    echo "rc=$? RESULT=$RESULT" )
}
test.oo.sharedBaseEnsure() {
  local fx bad="" got d onceSh="EAM/1_infrastructure/Once.sh"
  fx=$(test.suite.fixture.make sharedbase); mkdir -p "$fx/bin" "$fx/basehome"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  got=$(test.oo.sharedBaseEnsure.run "$fx" "$fx/basehome" "$USER")
  case "$got" in rc=0*) ;; *) bad="$bad first=[$got]" ;; esac
  for d in dev/Workspaces "EAMD.ucp/Scenarios/localhost/$onceSh" "EAMD.ucp/Components/com/ceruleanCircle/$onceSh"; do
    [ -d "$fx/basehome/shared/$d" ] || bad="$bad missing:$d"
  done
  got=$(test.oo.sharedBaseEnsure.run "$fx" "$fx/basehome" "$USER")
  case "$got" in rc=0*) ;; *) bad="$bad rerun=[$got]" ;; esac
  got=$(test.oo.sharedBaseEnsure.run "$fx" "")
  case "$got" in rc=1*"requires <basehome>"*) ;; *) bad="$bad no-basehome=[$got]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the shared base directories are there, a second run too" || create.result 1 "shared.base.ensure:$bad"
  return $(result)
}
test.case $level "T-OO-SHARED-BASE-ENSURE: the shared base directories of state 31 are created under the basehome" test.oo.sharedBaseEnsure
expect 0 "the shared base directories are there, a second run too" "state 31 made its base inline — no test could drive it"

# T-OO-SHARED-BASE-NOT-RECURSIVE: a pre-existing shared/ keeps its owner, group and modes
# State 31 ran chown -R <user>:dev and chmod -R g+w over <basehome>/shared — on
# macOS /Users/Shared, the boss's whole workspace (D1). The base is created
# segment by segment now: only what oosh creates gets group dev and 2775. A
# shared/ that is there with a foreign folder and a 644 file of the caller's
# own group stays as it was. Group dev is asserted where the caller is in it.
test.oo.state31SharedNotRecursive() {
  local fx bad="" got d sh onceSh="EAM/1_infrastructure/Once.sh" ownGroup inDev=no
  fx=$(test.suite.fixture.make sharednotrec); mkdir -p "$fx/bin" "$fx/basehome/shared/foreign"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  sh="$fx/basehome/shared"; ownGroup=$(id -gn)
  printf 'mine\n' > "$sh/foreign/file"; chmod 644 "$sh/foreign/file"; chmod 755 "$sh" "$sh/foreign"
  chgrp "$ownGroup" "$sh" "$sh/foreign" "$sh/foreign/file"
  case " $(id -nG) " in *" dev "*) inDev=yes ;; esac
  got=$(test.oo.sharedBaseEnsure.run "$fx" "$fx/basehome" "$USER")
  case "$got" in rc=0*) ;; *) bad="$bad rc=[$got]" ;; esac
  [ "$(private.this.path.stat.get "$sh/foreign/file" mode)" = 644 ] || bad="$bad file-mode=$(private.this.path.stat.get "$sh/foreign/file" mode)"
  for d in "$sh" "$sh/foreign" "$sh/foreign/file"; do
    [ "$(private.this.path.stat.get "$d" group)" = "$ownGroup" ] || bad="$bad regrouped:${d#$fx/}"
  done
  for d in "$sh" "$sh/foreign"; do
    [ "$(private.this.path.stat.get "$d" mode)" = 755 ] || bad="$bad remoded:${d#$fx/}"
  done
  for d in EAMD.ucp EAMD.ucp/Scenarios "EAMD.ucp/Scenarios/localhost/$onceSh" "EAMD.ucp/Components/com/ceruleanCircle/$onceSh" dev dev/Workspaces; do
    [ -g "$sh/$d" ] || bad="$bad no-setgid:$d"
    case "$(private.this.path.stat.get "$sh/$d" mode)" in *775) ;; *) bad="$bad mode:$d=$(private.this.path.stat.get "$sh/$d" mode)" ;; esac
    if [ "$inDev" = yes ]; then
      [ "$(private.this.path.stat.get "$sh/$d" group)" = dev ] || bad="$bad group:$d=$(private.this.path.stat.get "$sh/$d" group)"
    fi
  done
  [ -s "$fx/sudo.calls" ] && bad="$bad sudo-called=[$(tr '\n' '|' < "$fx/sudo.calls")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the shared folder kept its owner, group and modes; the created chain is group dev, 2775" || create.result 1 "state 31:$bad"
  return $(result)
}
test.case $level "T-OO-SHARED-BASE-NOT-RECURSIVE: private.oo.shared.base.ensure never re-owns a pre-existing shared directory" test.oo.state31SharedNotRecursive
expect 0 "the shared folder kept its owner, group and modes; the created chain is group dev, 2775" \
  "D1: state 31 ran chown -R and chmod -R over /Users/Shared"

console.log "
Test: private.oo.shared.dir.ensure
===================================================================="

# T-OO-SHARED-DIR-ENSURE: the dev-group policy of a shared directory, in one method
# A missing directory gets group dev (where the caller is in it) and 2775; one
# that is there is not touched and the RESULT says exists.
test.oo.sharedDirEnsure() {
  local fx bad="" res
  fx=$(test.suite.fixture.make shareddir); mkdir -p "$fx/there" "$fx/bin"; chmod 700 "$fx/there"
  # A sudo that records and fails: private.this.dir.ensure elevates when the
  # owner is another user ($USER is not always id -un) — never a password prompt.
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  ( LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"
    private.oo.shared.dir.ensure "$fx/there" >/dev/null 2>&1; echo "$?:$RESULT" > "$fx/there.out" )
  [ "$(cat "$fx/there.out")" = "0:exists" ] || bad="$bad there=[$(cat "$fx/there.out")]"
  [ "$(private.this.path.stat.get "$fx/there" mode)" = 700 ] || bad="$bad there-remoded"
  ( LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"
    private.oo.shared.dir.ensure "$fx/new/sub" "$(id -un)" >/dev/null 2>&1; echo "$?:$RESULT" > "$fx/new.out" )
  [ "$(cat "$fx/new.out")" = "0:$fx/new $fx/new/sub" ] || bad="$bad new=[$(cat "$fx/new.out")]"
  [ -g "$fx/new/sub" ] || bad="$bad no-setgid"
  case " $(id -nG) " in *" dev "*) [ "$(private.this.path.stat.get "$fx/new/sub" group)" = dev ] || bad="$bad not-dev" ;; esac
  [ -s "$fx/sudo.calls" ] && bad="$bad sudo-called=[$(tr '\n' '|' < "$fx/sudo.calls")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "exists untouched; created segments group dev, 2775" || create.result 1 "shared.dir.ensure:$bad"
  return $(result)
}
test.case $level "T-OO-SHARED-DIR-ENSURE: only the created segments get group dev and mode 2775" test.oo.sharedDirEnsure
expect 0 "exists untouched; created segments group dev, 2775" "state 31 had no one method for the dev-group directory policy"

# T-RECURSIVE-REPO-CLEAN: oo has no undeclared recursive chown/chgrp/chmod
# this.recursive.validate over the tree; only the lines of oo count here (other
# scripts are swept by their owners). The violations go to the log, so the log
# is a file.
test.oo.recursiveRepoClean() {
  local fx hits
  fx=$(test.suite.fixture.make recursiveclean)
  local rc verdict checked
  verdict=$( LOG_DEVICE="$fx/log.out"; LOG_LEVEL=1; this.recursive.validate "$OOSH_DIR" 2>/dev/null ); rc=$?
  hits=$(grep -E 'this.recursive.validate: oo:[0-9]+:' "$fx/log.out" | sed 's/.*this.recursive.validate: //' | tr '\n' '|')
  rm -rf "$fx"
  # rc 2 is a sweep that read nothing — that proves nothing about oo.
  checked=$(printf '%s\n' "$verdict" | sed -n 's/.* \([0-9][0-9]*\) checked.*/\1/p' | head -1)
  case "$rc" in 0|1) ;; *) create.result 1 "the validator did not sweep: rc=$rc [$verdict]"; return $(result) ;; esac
  [ "${checked:-0}" -gt 0 ] || { create.result 1 "the validator checked no line: [$verdict]"; return $(result); }
  [ -z "$hits" ] && create.result 0 "no undeclared recursive call in oo" || create.result 1 "oo:[$hits]"
  return $(result)
}
test.case $level "T-RECURSIVE-REPO-CLEAN: every recursive chown/chgrp/chmod in oo is declared" test.oo.recursiveRepoClean
expect 0 "no undeclared recursive call in oo" "D1: a recursive change of /Users/Shared hid among the install steps"

console.log "
Test: private.oo.shared.config.ensure
===================================================================="

test.oo.sharedConfigEnsure.run() { # <fx> <args...> # run private.oo.shared.config.ensure with the log in the fixture and a sudo that records and fails; echo rc=<n>
  local fx="$1"; shift
  mkdir -p "$fx/bin"; printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  ( LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"
    private.oo.shared.config.ensure "$@" >/dev/null 2>&1; echo "rc=$?" )
  [ -s "$fx/sudo.calls" ] && echo " sudo-called=[$(tr '\n' '|' < "$fx/sudo.calls")]"
}
test.oo.sharedConfigEnsure.list() { # <dir> # echo the entries under <dir>, relative, sorted, on one line
  ( cd "$1" 2>/dev/null && find . -mindepth 1 | sort | tr '\n' ' ' )
}

# T-OO-SHARED-CONFIG-ENSURE: a fresh sharedConfig is seeded from the root config
# State 31 ran `cp -r ~/config sharedConfig`: a fresh one is a copy of root's
# config, its stateMachines the installing user's. Seeded from the ENTRIES (no
# sharedConfig/config inside), the user config a link to it.
test.oo.sharedConfigEnsure() {
  local fx bad="" got sc
  fx=$(test.suite.fixture.make sharedconfig); sc="$fx/shared/sharedConfig"
  mkdir -p "$fx/shared" "$fx/root/config/stateMachines" "$fx/user/config/stateMachines"
  printf 'root\n' > "$fx/root/config/user.env"; printf 'r\n' > "$fx/root/config/stateMachines/root.sm"
  printf 'u\n' > "$fx/user/config/stateMachines/user.sm"
  got=$(test.oo.sharedConfigEnsure.run "$fx" "$sc" "$fx/root/config" "$fx/user/config")
  [ "$got" = rc=0 ] || bad="$bad $got"
  # The root's stateMachines came along with the entries; the installing
  # user's replace them and the copy is kept, never deleted.
  got=$(test.oo.sharedConfigEnsure.list "$sc" | sed 's/stateMachines\.orig\.[0-9-]*/stateMachines.orig.TS/g')
  [ "$got" = "./stateMachines ./stateMachines.orig.TS ./stateMachines.orig.TS/root.sm ./stateMachines/user.sm ./user.env " ] || bad="$bad seeded=[$got]"
  [ -L "$fx/user/config" ] && [ "$(readlink "$fx/user/config")" = "$sc" ] || bad="$bad user-config-not-linked"
  ls -d "$fx/user/config.orig."* >/dev/null 2>&1 || bad="$bad user-config-not-kept"
  [ -d "$fx/root/config" ] && [ ! -L "$fx/root/config" ] || bad="$bad root-config-moved"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "seeded from the root config, stateMachines from the user, user config linked" || create.result 1 "shared.config.ensure:$bad"
  return $(result)
}
test.case $level "T-OO-SHARED-CONFIG-ENSURE: a missing sharedConfig is created and seeded from the root config, the user config becomes a link" test.oo.sharedConfigEnsure
expect 0 "seeded from the root config, stateMachines from the user, user config linked" "state 31 seeded sharedConfig inline with cp -r"

# T-OO-SHARED-CONFIG-STATE-CARRY: a re-run carries the installing state machine into an existing sharedConfig
# An existing sharedConfig was kept as it was — its stateMachines and
# current.state.machine.env too, an old version's or at state 99. oo.state
# reads them right after CONFIG_PATH switches to the sharedConfig: the
# install at 31 jumped to the stale state. The installing config's state
# machine is carried over, the old one kept as .orig.<ts>; `state next`
# across the switch goes 31 → 32.
test.oo.sharedConfigStateCarry.machine() { # <configDir> <state> # write a SETUP_SERVER state machine standing at <state> into <configDir>
  mkdir -p "$1/stateMachines"
  printf '%s\n' 'declare -ax SETUP_SERVER_STATES=([0]="not.installed" [1]="initialized" [30]="root.rights" [31]="root.shared.dev.folder.created" [32]="root.dev.keys.installed" [33]="root.installation.done" [99]="finished")' \
    "SETUP_SERVER_STATE_ID=$2" 'SETUP_SERVER_CUSTOM_SCRIPT=oo' > "$1/stateMachines/SETUP_SERVER.states.env"
  printf '%s\n' machine=SETUP_SERVER stateID=SETUP_SERVER_STATE_ID "state=$2" "stateName=SETUP_SERVER_STATES[$2]" stateValue=x \
    stateFound= stateLast= stateScript=oo 'stateList=SETUP_SERVER_STATES[@]' \
    'stateFile=$CONFIG_PATH/stateMachines/SETUP_SERVER.states.env' 'source $CONFIG_PATH/stateMachines/SETUP_SERVER.states.env' > "$1/current.state.machine.env"
}
test.oo.sharedConfigStateCarry() {
  local fx bad="" got sc now
  fx=$(test.suite.fixture.make stateCarry); sc="$fx/shared/sharedConfig"
  test.oo.sharedConfigStateCarry.machine "$sc" 99; printf 'shared\n' > "$sc/user.env"
  test.oo.sharedConfigStateCarry.machine "$fx/root/config" 31
  got=$(test.oo.sharedConfigEnsure.run "$fx" "$sc" "$fx/root/config")
  [ "$got" = rc=0 ] || bad="$bad $got"
  [ "$(sed -n 's/^state=//p' "$sc/current.state.machine.env" 2>/dev/null)" = 31 ] || bad="$bad current-not-carried"
  grep -q '^SETUP_SERVER_STATE_ID=31$' "$sc/stateMachines/SETUP_SERVER.states.env" 2>/dev/null || bad="$bad machines-not-carried"
  # the carried folder follows the dev-group policy of the shared tree (2775, setgid)
  if private.this.group.exists dev; then
    [ -g "$sc/stateMachines" ] || bad="$bad stateMachines-no-setgid"
    case "$(private.this.path.stat.get "$sc/stateMachines" mode)" in *775) ;; *) bad="$bad stateMachines-mode=$(private.this.path.stat.get "$sc/stateMachines" mode)" ;; esac
  fi
  grep -q '^state=99$' "$sc/current.state.machine.env.orig."* 2>/dev/null || bad="$bad old-current-not-kept"
  grep -q '^SETUP_SERVER_STATE_ID=99$' "$sc/stateMachines.orig."*/SETUP_SERVER.states.env 2>/dev/null || bad="$bad old-machines-not-kept"
  [ "$(cat "$sc/user.env")" = shared ] || bad="$bad user.env-changed"
  [ "$(readlink "$fx/root/config")" = "$sc" ] || bad="$bad not-linked"
  # the switch: CONFIG_PATH is the sharedConfig, state next goes 31 → 32
  now=$( CONFIG_PATH="$sc"; LOG_DEVICE="$fx/log.out"; source "$OOSH_DIR/state" >/dev/null 2>&1
         state next SETUP_SERVER >/dev/null 2>&1; source "$sc/current.state.machine.env" >/dev/null 2>&1; echo "$state" )
  [ "$now" = 32 ] || bad="$bad state-next=$now"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the installing state machine carried, the old one kept, state next 31 -> 32" || create.result 1 "state carry:$bad"
  return $(result)
}
test.case $level "T-OO-SHARED-CONFIG-STATE-CARRY: a re-run carries the installing state machine into an existing sharedConfig" test.oo.sharedConfigStateCarry
expect 0 "the installing state machine carried, the old one kept, state next 31 -> 32" \
  "an existing sharedConfig kept a stale state machine that oo.state read after the switch"

# T-STATE-31-CONFIG-ORIG-TIMESTAMPED: a real ~/config is kept as config.orig.<ts>; an existing sharedConfig is never copied into
# State 31 copied ~/config INTO an existing sharedConfig (cp -r of a directory
# onto a directory: sharedConfig/config), removed its stateMachines and moved
# a real ~/config to ~/config.initial — a second run nested the second one
# inside the first (D7). Two runs, each with a real config: two stamps, nothing
# nested, sharedConfig as it was.
test.oo.state31ConfigOrigTimestamped() {
  local fx bad="" got sc before n d
  fx=$(test.suite.fixture.make configorig); sc="$fx/shared/sharedConfig"
  mkdir -p "$sc/stateMachines" "$fx/home/config/stateMachines"
  printf 'shared\n' > "$sc/user.env"; printf 's\n' > "$sc/stateMachines/shared.sm"
  printf 'one\n' > "$fx/home/config/mine"; printf 'h\n' > "$fx/home/config/stateMachines/home.sm"
  # The state machine is carried on every run (T-OO-SHARED-CONFIG-STATE-CARRY);
  # everything else in the sharedConfig stays as it was.
  before=$(test.oo.sharedConfigEnsure.list "$sc" | tr ' ' '\n' | grep -v stateMachines | tr '\n' ' ')
  got=$(test.oo.sharedConfigEnsure.run "$fx" "$sc" "$fx/home/config"); [ "$got" = rc=0 ] || bad="$bad first-$got"
  rm -f "$fx/home/config"; mkdir -p "$fx/home/config"; printf 'two\n' > "$fx/home/config/mine"
  got=$(test.oo.sharedConfigEnsure.run "$fx" "$sc" "$fx/home/config"); [ "$got" = rc=0 ] || bad="$bad second-$got"
  [ "$(test.oo.sharedConfigEnsure.list "$sc" | tr ' ' '\n' | grep -v stateMachines | tr '\n' ' ')" = "$before" ] || bad="$bad sharedConfig-changed=[$(test.oo.sharedConfigEnsure.list "$sc")]"
  [ -f "$sc/stateMachines/home.sm" ] || bad="$bad state-machine-not-carried"
  [ "$(readlink "$fx/home/config")" = "$sc" ] || bad="$bad config-not-linked"
  n=$(ls -d "$fx/home/config.orig."* 2>/dev/null | grep -c '')
  [ "$n" = 2 ] || bad="$bad stamps=$n"
  ls -d "$fx/home/config.orig."* 2>/dev/null | grep -Eq '\.orig\.[0-9]{8}-[0-9]{6}' || bad="$bad ts-format"
  for d in "$fx/home/config.orig."*; do
    [ -e "$d/config" ] && bad="$bad nested:${d##*/}"
  done
  [ "$(cat "$fx/home/config.orig."*/mine 2>/dev/null | sort | tr '\n' ' ')" = "one two " ] || bad="$bad contents"
  [ -e "$fx/home/config.initial" ] && bad="$bad config.initial"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "two runs, two config.orig.<ts>, nothing nested, sharedConfig untouched" || create.result 1 "state 31:$bad"
  return $(result)
}
test.case $level "T-STATE-31-CONFIG-ORIG-TIMESTAMPED: a real ~/config is kept as config.orig.<ts>, an existing sharedConfig is never copied into" test.oo.state31ConfigOrigTimestamped
expect 0 "two runs, two config.orig.<ts>, nothing nested, sharedConfig untouched" \
  "D7: state 31 copied into an existing sharedConfig and nested a second config.initial"

console.log "
Test: private.oo.update.pull.gate / private.oo.update.pull
===================================================================="

# Fixture of the pull gate: a bare origin with dev, a seed clone that pushes to
# it, one clone per case; HOME, the global git config and OOSH_REPO in the
# fixture (no network).
test.oo.pullGate.commit() { # <dir> <file> <text> # commit <text> as <file> in <dir>
  printf '%s\n' "$3" > "$1/$2"
  git -C "$1" add "$2" && git -C "$1" -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q -m "$2: $3"
}
test.oo.pullGate.sha() { # <dir> # echo the commit HEAD of <dir> is on
  ogit.commit.log.show HEAD 1 %H "$1" 2>/dev/null
}
test.oo.pullGate.update() { # <fx> <dir> <?repo:<fx>/origin.git> # run oo.update on <dir> with the steps after the pull as recording stand-ins, OOSH_REPO=<repo>; echo rc=<n> RESULT=<result>
  local fx="$1" dir="$2"
  : > "$fx/steps"
  (
    HOME="$fx/home"; OOSH_DIR="$dir"; OOSH_REPO="${3:-$fx/origin.git}"; LOG_DEVICE="$fx/log.out"
    test.oo.pullGate.record() { echo "$*" >> "$fx/steps"; }
    oo.mode.base.get()                   { echo "$fx/base"; }
    ogit.safeDirectory.ensure()          { test.oo.pullGate.record safeDirectory.ensure; }
    ogit.safeDirectory.prune()           { test.oo.pullGate.record safeDirectory.prune; }
    private.user.bashrc.install()        { test.oo.pullGate.record bashrc.install; }
    private.config.session.file.ensure() { test.oo.pullGate.record session.file.ensure; }
    private.oo.update.heal.symlinks()    { test.oo.pullGate.record heal.symlinks; }
    private.oo.dropin.remove()           { test.oo.pullGate.record dropin.remove; }
    private.oo.install.launcher()        { test.oo.pullGate.record install.launcher; }
    private.oo.once.path.migrate()       { test.oo.pullGate.record once.path.migrate; }
    private.odocker.workspaces.install() { test.oo.pullGate.record odocker.workspaces.install; }
    private.config.host.name.refresh()   { test.oo.pullGate.record config.host.name.refresh; }
    oo.update >/dev/null 2>&1
    echo "rc=$? RESULT=$RESULT"
  )
}
test.oo.pullGate.make() { # <label> # echo a fixture: origin.git with dev, seed/ pushing to it, a clone per case, then a second commit on origin
  local fx c
  fx=$(test.suite.fixture.make "$1"); mkdir -p "$fx/home" "$fx/base"
  # The fixture is built with the fixture's HOME and global git config (a
  # subshell: nothing leaks), never the developer's.
  HOME="$fx/home"; GIT_CONFIG_GLOBAL="$fx/gitconfig"; export HOME GIT_CONFIG_GLOBAL; : > "$GIT_CONFIG_GLOBAL"
  ogit.repo.init "$fx/origin.git" yes dev >/dev/null 2>&1
  git clone -q "$fx/origin.git" "$fx/seed" 2>/dev/null
  git -C "$fx/seed" checkout -q -b dev
  test.oo.pullGate.commit "$fx/seed" file one
  git -C "$fx/seed" push -q -u origin dev 2>/dev/null
  for c in behind merge dirty detached diverged markers; do
    git clone -q -b dev "$fx/origin.git" "$fx/$c" 2>/dev/null
  done
  test.oo.pullGate.commit "$fx/seed" file two
  git -C "$fx/seed" push -q origin dev 2>/dev/null
  echo "$fx"
}

# T-OO-UPDATE-PULL-GATE: oo update pulls only through a gate
# A plain `git pull` merged origin into a Mac's diverged tree (D5). The pull is
# a fetch and a fast-forward now, behind a gate that refuses a merge in
# progress, committed conflict markers, a dirty tree, a detached HEAD and a
# diverged branch — each with the ONE command to run — and leaves HEAD alone.
test.oo.updatePullGate() {
  private.this.script.load ogit ogit.branch.get
  local fx bad="" got before c want
  local GIT_CONFIG_GLOBAL; fx=$(test.oo.pullGate.make pullgate); GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  test.oo.pullGate.commit "$fx/merge" file mine
  git -C "$fx/merge" fetch -q origin 2>/dev/null; git -C "$fx/merge" -c user.email=t@t -c user.name=t merge -q origin/dev >/dev/null 2>&1
  printf 'dirt\n' >> "$fx/dirty/file"
  git -C "$fx/detached" checkout -q --detach
  test.oo.pullGate.commit "$fx/diverged" local.txt mine; git -C "$fx/diverged" fetch -q origin 2>/dev/null
  test.oo.pullGate.commit "$fx/markers" conflict.txt "$(printf '%s\n%s\n%s\n%s' '<<<<<<< HEAD' a ======= '>>>>>>> other')"
  # clean and behind: fetched and fast-forwarded
  got=$(test.oo.pullGate.update "$fx" "$fx/behind")
  case "$got" in rc=0*) ;; *) bad="$bad behind=[$got]" ;; esac
  [ "$(test.oo.pullGate.sha "$fx/behind")" = "$(test.oo.pullGate.sha "$fx/seed")" ] || bad="$bad behind-not-forwarded"
  for c in merge dirty detached diverged markers; do
    case "$c" in
      merge)    want="ogit merge.abort $fx/merge" ;;
      dirty)    want="ogit status.show short $fx/dirty" ;;
      detached) want="ogit branch.checkout dev $fx/detached" ;;
      diverged) want="diverged*oo heal" ;;
      markers)  want="conflict markers*oo heal" ;;
    esac
    before=$(test.oo.pullGate.sha "$fx/$c")
    got=$(test.oo.pullGate.update "$fx" "$fx/$c")
    case "$got" in rc=1*$want*) ;; *) bad="$bad $c=[$got]" ;; esac
    [ "$(test.oo.pullGate.sha "$fx/$c")" = "$before" ] || bad="$bad $c-HEAD-moved"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "behind is fast-forwarded; merge, dirty, detached, diverged and markers are refused with the one command, HEAD unchanged" || create.result 1 "pull gate:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-PULL-GATE: oo update fast-forwards a clean clone and refuses the five unsafe states with the one command to run" test.oo.updatePullGate
expect 0 "behind is fast-forwarded; merge, dirty, detached, diverged and markers are refused with the one command, HEAD unchanged" \
  "D5: a plain pull merged into the Mac's diverged tree"

# T-OO-UPDATE-HEALS-WHEN-REFUSED: a refused pull still runs every step after it
# The symlink heal, the trust, the drop-in cleanup, the launcher, the ~/.once
# migration and the host name are what a broken computer needs most — they run
# whether the pull went through or not; oo update returns the gate's rc 1.
test.oo.updateHealsWhenRefused() {
  private.this.script.load ogit ogit.branch.get
  local fx bad="" got steps
  local GIT_CONFIG_GLOBAL; fx=$(test.oo.pullGate.make pullrefused); GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  printf 'dirt\n' >> "$fx/dirty/file"
  got=$(test.oo.pullGate.update "$fx" "$fx/dirty")
  case "$got" in rc=1*) ;; *) bad="$bad rc=[$got]" ;; esac
  steps=$(tr '\n' ' ' < "$fx/steps")
  [ "$steps" = "heal.symlinks safeDirectory.ensure safeDirectory.prune bashrc.install session.file.ensure dropin.remove install.launcher once.path.migrate config.host.name.refresh " ] || bad="$bad steps=[$steps]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the pull was refused, every heal step ran, rc 1" || create.result 1 "refused update:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-HEALS-WHEN-REFUSED: a refused pull still runs the heal steps" test.oo.updateHealsWhenRefused
expect 0 "the pull was refused, every heal step ran, rc 1" "a failed pull returned before the symlink heal"

# T-OO-UPDATE-MARKERS-NO-LOAD: a refusal for committed markers loads no script of the tree
# The markers are in the tree's own scripts: loading config, user or odocker
# from it (the symlink heal, the odocker.env write, the host name) would fail
# with syntax errors. Those steps are skipped for that refusal; the steps oo
# itself holds still run, rc stays 1.
test.oo.updateMarkersNoLoad() {
  private.this.script.load ogit ogit.branch.get
  local fx bad="" got steps
  local GIT_CONFIG_GLOBAL; fx=$(test.oo.pullGate.make pullmarkers); GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  test.oo.pullGate.commit "$fx/markers" conflict.txt "$(printf '%s\n%s\n%s\n%s' '<<<<<<< HEAD' a ======= '>>>>>>> other')"
  got=$(test.oo.pullGate.update "$fx" "$fx/markers")
  case "$got" in rc=1*"conflict markers"*) ;; *) bad="$bad rc=[$got]" ;; esac
  steps=$(tr '\n' ' ' < "$fx/steps")
  [ "$steps" = "safeDirectory.ensure safeDirectory.prune dropin.remove install.launcher once.path.migrate " ] || bad="$bad steps=[$steps]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "markers refused, no script of the tree loaded, rc 1" || create.result 1 "markers update:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-MARKERS-NO-LOAD: a refusal for committed markers skips the steps that load scripts of the tree" test.oo.updateMarkersNoLoad
expect 0 "markers refused, no script of the tree loaded, rc 1" "the heal steps sourced config and odocker with conflict markers in them"

# T-OO-UPDATE-MARKERS-ALL-THREE: one marker-like line is no conflict
# A document that shows a `<<<<<<< ` line (docs about merges) refused every
# update. A conflict is the three kinds in one file: `<<<<<<< `, `=======`,
# `>>>>>>> `.
test.oo.updateMarkersAllThree() {
  private.this.script.load ogit ogit.branch.get
  local fx bad="" got
  local GIT_CONFIG_GLOBAL; fx=$(test.oo.pullGate.make pullmarkerdoc); GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  git clone -q -b dev "$fx/origin.git" "$fx/doc" 2>/dev/null
  test.oo.pullGate.commit "$fx/doc" merge.md "$(printf '%s\n%s' 'A conflict starts with:' '<<<<<<< HEAD')"
  git -C "$fx/doc" push -q origin dev 2>/dev/null
  got=$(test.oo.pullGate.update "$fx" "$fx/doc")
  case "$got" in rc=0*) ;; *) bad="$bad doc=[$got]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a lone marker-like line is pulled" || create.result 1 "markers probe:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-MARKERS-ALL-THREE: a file needs all three marker kinds to refuse the pull" test.oo.updateMarkersAllThree
expect 0 "a lone marker-like line is pulled" "a doc line showing <<<<<<< refused every update"

# T-OO-UPDATE-PULL-FALLBACK: the SSH remote fails → OOSH_REPO; both fail → rc 1, the steps still run
# The shared clone fetches over an SSH alias a user may not have: the branch
# is fetched from OOSH_REPO into FETCH_HEAD and fast-forwarded to it. When
# both fail, rc 1 "could not fetch", and every heal step still ran.
test.oo.updatePullFallback() {
  private.this.script.load ogit ogit.branch.get
  local fx bad="" got steps
  local GIT_CONFIG_GLOBAL; fx=$(test.oo.pullGate.make pullfallback); GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  ogit.remote.url.set "$fx/nowhere.git" origin "$fx/behind" >/dev/null 2>&1
  got=$(test.oo.pullGate.update "$fx" "$fx/behind")
  case "$got" in rc=0*FETCH_HEAD*) ;; *) bad="$bad fallback=[$got]" ;; esac
  [ "$(test.oo.pullGate.sha "$fx/behind")" = "$(test.oo.pullGate.sha "$fx/seed")" ] || bad="$bad fallback-not-forwarded"
  ogit.remote.url.set "$fx/nowhere.git" origin "$fx/dirty" >/dev/null 2>&1
  got=$(test.oo.pullGate.update "$fx" "$fx/dirty" "$fx/nowhere2.git")
  case "$got" in rc=1*"could not fetch"*) ;; *) bad="$bad both=[$got]" ;; esac
  steps=$(tr '\n' ' ' < "$fx/steps")
  [ "$steps" = "heal.symlinks safeDirectory.ensure safeDirectory.prune bashrc.install session.file.ensure dropin.remove install.launcher once.path.migrate config.host.name.refresh " ] || bad="$bad steps=[$steps]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "fallback fast-forwards to FETCH_HEAD; both failing is rc 1 and the steps run" || create.result 1 "pull fallback:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-PULL-FALLBACK: a failed SSH fetch falls back to OOSH_REPO; both failing is rc 1 with every step run" test.oo.updatePullFallback
expect 0 "fallback fast-forwards to FETCH_HEAD; both failing is rc 1 and the steps run" "the HTTPS fallback of oo update had no test"

# T-OO-UPDATE-NO-ORIGIN-BRANCH: a branch origin does not have is said so, not "diverged"
test.oo.updateNoOriginBranch() {
  private.this.script.load ogit ogit.branch.get
  local fx bad="" got
  local GIT_CONFIG_GLOBAL; fx=$(test.oo.pullGate.make pullnobranch); GIT_CONFIG_GLOBAL="$fx/gitconfig"; export GIT_CONFIG_GLOBAL
  git -C "$fx/behind" checkout -q -b lonely 2>/dev/null
  got=$(test.oo.pullGate.update "$fx" "$fx/behind")
  case "$got" in rc=1*"origin has no branch lonely"*) ;; *) bad="$bad [$got]" ;; esac
  case "$got" in *diverged*) bad="$bad said-diverged" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "origin has no branch lonely, rc 1" || create.result 1 "no origin branch:$bad"
  return $(result)
}
test.case $level "T-OO-UPDATE-NO-ORIGIN-BRANCH: a branch origin lacks is refused as such" test.oo.updateNoOriginBranch
expect 0 "origin has no branch lonely, rc 1" "a branch origin lacked was reported as diverged — run: oo heal"

console.log "
Test: private.oo.answer.get / oo.deinstall
===================================================================="

# T-OO-ANSWER-GET: one line from the device; end of input or no device is rc 1
test.oo.answerGet() {
  local fx bad="" got
  fx=$(test.suite.fixture.make answerget); printf 'deinstall\nmore\n' > "$fx/typed"
  got=$(private.oo.answer.get "type it:" "$fx/typed") || bad="$bad typed-rc"
  [ "$got" = deinstall ] || bad="$bad typed=[$got]"
  # the prompt goes to a terminal only — never into a file read as the device
  [ "$(cat "$fx/typed")" = "$(printf 'deinstall\nmore')" ] || bad="$bad prompt-written-into-file"
  got=$(private.oo.answer.get "type it:" /dev/null) && bad="$bad eof-rc0"
  [ -z "$got" ] || bad="$bad eof=[$got]"
  got=$(private.oo.answer.get "type it:" "$fx/none" 2>/dev/null) && bad="$bad no-device-rc0"
  [ -e "$fx/none" ] && bad="$bad no-device-created"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "one line read; end of input and no device are rc 1" || create.result 1 "answer.get:$bad"
  return $(result)
}
test.case $level "T-OO-ANSWER-GET: an answer is read from the device, end of input is rc 1" test.oo.answerGet
expect 0 "one line read; end of input and no device are rc 1" "oo deinstall asked nothing"

# T-OO-DEINSTALL-CONFIRM: oo deinstall asks, and keeps everything
# It printed "are you sure?", did not wait, and ran rm -Rf ~/oosh ~/config,
# rm ~/.once ~/.bashrc (D6). Now: the word deinstall (or --yes); end of input
# or another word is rc 1 with nothing changed; links are removed, real
# entries kept as .orig.<ts>, the .bashrc kept and .bashrc.pre-oosh restored.
# The answer comes from the stand-in reading stdin (T-OO-ANSWER-GET reads a device).
test.oo.deinstallConfirm.home() { # <fx> # echo a fixture home: oosh and init links, a real config, .once, an oosh .bashrc and its .bashrc.pre-oosh
  local fx="$1" h="$1/home"
  mkdir -p "$h/config" "$fx/tree/init"; printf 'mine\n' > "$h/config/user.env"; printf 'installer\n' > "$fx/tree/init/oosh"
  ln -s "$fx/tree" "$h/oosh"; ln -s "$fx/tree/init" "$h/init"
  printf 'once\n' > "$h/.once"; printf 'oosh bashrc\n' > "$h/.bashrc"; printf 'old bashrc\n' > "$h/.bashrc.pre-oosh"
  chmod 600 "$h/.bashrc.pre-oosh"; printf 'an older installer\n' > "$h/install.oosh"
}
test.oo.deinstallConfirm.run() { # <fx> <stdinFile> <args...> # run oo.deinstall in the fixture home; echo rc=<n>
  local fx="$1" in="$2"; shift 2
  ( HOME="$fx/home"; OOSH_DIR="$fx/tree"; LOG_DEVICE="$fx/log.out"
    private.oo.answer.get() { local a; read -r a || return 1; echo "$a"; }
    oo.deinstall "$@" < "$in" >/dev/null 2>&1; echo "rc=$?" )
}
test.oo.deinstallConfirm.list() { # <dir> # echo the entries of <dir> with their kind, one line
  ( cd "$1" && for e in .[!.]* *; do [ -L "$e" ] && echo "$e@" || echo "$e"; done | sort | tr '\n' ' ' )
}
test.oo.deinstallConfirm() {
  local fx bad="" got before
  fx=$(test.suite.fixture.make deinstall); test.oo.deinstallConfirm.home "$fx"; printf 'no\n' > "$fx/no"
  before=$(test.oo.deinstallConfirm.list "$fx/home")
  got=$(test.oo.deinstallConfirm.run "$fx" /dev/null); [ "$got" = rc=1 ] || bad="$bad eof-$got"
  got=$(test.oo.deinstallConfirm.run "$fx" "$fx/no"); [ "$got" = rc=1 ] || bad="$bad no-$got"
  [ "$(test.oo.deinstallConfirm.list "$fx/home")" = "$before" ] || bad="$bad changed-without-yes=[$(test.oo.deinstallConfirm.list "$fx/home")]"
  got=$(test.oo.deinstallConfirm.run "$fx" /dev/null --yes); [ "$got" = rc=0 ] || bad="$bad yes-$got"
  { [ -e "$fx/home/oosh" ] || [ -L "$fx/home/oosh" ] || [ -L "$fx/home/init" ]; } && bad="$bad links-left"
  [ -d "$fx/tree/init" ] || bad="$bad link-target-deleted"
  [ "$(cat "$fx/home/config.orig."*/user.env 2>/dev/null)" = mine ] || bad="$bad config-not-kept"
  [ "$(cat "$fx/home/.once.orig."* 2>/dev/null)" = once ] || bad="$bad once-not-kept"
  [ "$(cat "$fx/home/.bashrc.orig."* 2>/dev/null)" = "oosh bashrc" ] || bad="$bad bashrc-not-kept"
  [ "$(cat "$fx/home/.bashrc" 2>/dev/null)" = "old bashrc" ] || bad="$bad bashrc-not-restored"
  [ -f "$fx/home/.bashrc.pre-oosh" ] || bad="$bad pre-oosh-gone"
  [ "$(cat "$fx/home/install.oosh" 2>/dev/null)" = installer ] || bad="$bad no-install.oosh"
  [ "$(cat "$fx/home/install.oosh.orig."* 2>/dev/null)" = "an older installer" ] || bad="$bad older-installer-not-kept"
  [ "$(private.this.path.stat.get "$fx/home/.bashrc" mode)" = 600 ] || bad="$bad bashrc-mode=$(private.this.path.stat.get "$fx/home/.bashrc" mode)"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "refused without the word, --yes removes links and keeps every real entry" || create.result 1 "deinstall:$bad"
  return $(result)
}
test.case $level "T-OO-DEINSTALL-CONFIRM: oo deinstall asks for the word deinstall (or --yes) and deletes nothing" test.oo.deinstallConfirm
expect 0 "refused without the word, --yes removes links and keeps every real entry" \
  "D6: oo deinstall deleted ~/oosh ~/config ~/.bashrc without asking"

# T-OO-DEINSTALL-OOSH-LAST: ~/oosh is moved last
# The scripts deinstall still needs come through ~/oosh; it goes after config,
# init, .once and .bashrc. Every move is the kernel's private.this.entry.aside.
test.oo.deinstallOoshLast() {
  local fx got
  fx=$(test.suite.fixture.make deinstalllast); test.oo.deinstallConfirm.home "$fx"
  ( HOME="$fx/home"; OOSH_DIR="$fx/tree"; LOG_DEVICE="$fx/log.out"
    private.this.entry.aside() { echo "${1##*/}" >> "$fx/order"; create.result 0 nothing; return 0; }
    oo.deinstall --yes >/dev/null 2>&1 )
  got=$(tr '\n' ' ' < "$fx/order" 2>/dev/null)
  rm -rf "$fx"
  [ "$got" = "install.oosh config init .once .bashrc oosh " ] && create.result 0 "oosh last, through the kernel aside" || create.result 1 "order=[$got]"
  return $(result)
}
test.case $level "T-OO-DEINSTALL-OOSH-LAST: oo deinstall moves ~/oosh last, through private.this.entry.aside" test.oo.deinstallOoshLast
expect 0 "oosh last, through the kernel aside" "deinstall removed ~/oosh first and lost the scripts it still needed"

console.log "
Test: oo heal
===================================================================="

# The heal fixtures: test.oo.base (a bare origin with main, dev, prod and their
# clones under <fx>/Once.sh), a sharedConfig and homes inside the fixture, a
# sudo that records and fails, the log in a file — no network, no real home.
test.oo.heal.stubTree() { # <dir> # make <dir> a tree of links to this tree's files whose oo prints what the clean process got
  local f; mkdir -p "$1"
  for f in "$OOSH_DIR"/*; do ln -s "$f" "$1/${f##*/}"; done
  rm -f "$1/oo"
  printf '%s\n' '#!/usr/bin/env bash' 'source this >/dev/null 2>&1' \
    'echo "OOSH_DIR=$OOSH_DIR"' 'echo "PATH=$PATH"' 'echo "CONFIG=$CONFIG"' 'echo "EVIL=$HEAL_EVIL"' 'echo "ARGS=$*"' \
    'echo "PROXY=$https_proxy"' 'echo "LOGIN=$OOSH_HEAL_LOGIN"' 'echo "SUDOUSER=$SUDO_USER"' > "$1/oo"
  chmod +x "$1/oo"
}
test.oo.heal.sudo() { # <fx> # put a sudo into <fx>/bin that records its arguments into <fx>/sudo.calls and fails
  mkdir -p "$1/bin"
  printf '%s\n' '#!/bin/sh' "echo \"\$*\" >> '$1/sudo.calls'" 'exit 1' > "$1/bin/sudo"; chmod +x "$1/bin/sudo"
}

# T-OO-HEAL-STATUS-KINDS: the five kinds of ~/oosh, read-only
# canonical (a link into the base), foreign (a link outside it), worktree (a
# real folder whose .git is a file), plain-clone (a real folder with .git),
# none. Nothing in the fixture is written; rc 1 unless the home is canonical.
test.oo.healStatusKinds() {
  local base fx bad="" k out written
  # Loading a script runs `this`, which writes the CALLER's own session files:
  # loaded here, before HOME points into the fixture — the diagnosis is what is
  # watched for writes.
  private.this.script.load ogit ogit.branch.get; private.this.script.load user user.ssh.backup.status
  private.this.script.load config private.config.env.names.read
  private.oo.heal.login.shell.check root >/dev/null 2>&1   # loads what user.get shell sources (os)
  base=$(test.oo.base healkinds clone); fx=$(dirname "$base")
  mkdir -p "$fx/sharedConfig" "$fx/foreign/x"
  for k in canonical foreign worktree plain-clone none; do mkdir -p "$fx/homes/$k"; done
  ln -s "$base/dev" "$fx/homes/canonical/oosh"; ln -s "$fx/sharedConfig" "$fx/homes/canonical/config"
  cp "$OOSH_DIR/templates/user/bashrcTemplate" "$fx/homes/canonical/.bashrc"
  ln -s "$fx/foreign/x" "$fx/homes/foreign/oosh"; ln -s "$fx/foreign/x" "$fx/foreign/x/oosh"
  mkdir -p "$fx/homes/worktree/oosh" "$fx/homes/plain-clone/oosh/.git"
  printf 'gitdir: %s\n' "$base/main/.git/worktrees/x" > "$fx/homes/worktree/oosh/.git"
  # The loggers append to the CALLER's own live log under $HOME (the test
  # points HOME into each fixture home): that file is there before the stamp,
  # its appends are not the diagnosis writing.
  for k in canonical foreign worktree plain-clone none; do mkdir -p "$fx/homes/$k/.config/oosh"; : > "$fx/homes/$k/.config/oosh/log.live.out"; done
  : > "$fx/stamp"; find "$fx" -exec touch -h -t 202001010000 {} + 2>/dev/null; touch -t 202001010100 "$fx/stamp"
  for k in canonical foreign worktree plain-clone none; do
    out=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/homes/$k"
           private.oo.heal.path.get() { case "$2" in (base) echo "$base" ;; (sharedConfig) echo "$fx/sharedConfig" ;; esac; }
           private.oo.heal.user.diagnose "$k" "$fx/homes/$k" "$base" dev 2>/dev/null; echo "rc=$?" )
    case "$out" in *"~/oosh: $k"*) ;; *) bad="$bad $k-kind=[$(echo "$out" | head -1)]" ;; esac
    # a foreign tree is never touched: its self-link is reported, not healed
    [ "$k" = foreign ] && { echo "$out" | grep -q '\[left\] foreign self-link' || bad="$bad foreign-self-link-not-left"; }
    if [ "$k" = canonical ]; then
      case "$out" in *rc=0) ;; *) bad="$bad canonical-not-rc0=[$(echo "$out" | grep -v '\[ok\]' | tr '\n' '|')]" ;; esac
    else
      case "$out" in *rc=1) ;; *) bad="$bad $k-not-rc1" ;; esac
    fi
  done
  out=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/homes/canonical"; TEST_BASE="$base"
         private.oo.heal.basehome.get() { echo "$fx/bh"; }
         private.oo.heal.path.get() { case "$2" in (base) echo "$TEST_BASE" ;; (sharedConfig) echo "$fx/sharedConfig" ;; esac; }
         private.oo.heal.system.diagnose() { :; }
         user.get() { case "$1" in (shell) echo /bin/bash ;; (*) echo "$fx/homes/canonical" ;; esac; }
         oo.heal.status dev canonical > "$fx.status.out" 2>&1; echo "rc=$? $RESULT" )
  case "$out" in "rc=0 canonical"*) ;; *) bad="$bad status=[$out: $(grep -v '\[ok\]' "$fx.status.out" | tr '\n' '|')]" ;; esac
  # git status may refresh a .git/index: the repositories' own .git is not the home.
  written=$(find "$fx" -newer "$fx/stamp" ! -path '*/.git/*' ! -name .git ! -name log.out ! -name stamp ! -name log.live.out 2>/dev/null | tr '\n' ' ')
  [ -z "$written" ] || bad="$bad written=[$written]"
  rm -rf "$fx" "$fx.status.out"
  [ -z "$bad" ] && create.result 0 "five kinds told apart, nothing written, rc 1 unless canonical" || create.result 1 "heal status:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-STATUS-KINDS: oo heal status tells the five kinds of ~/oosh apart and writes nothing" test.oo.healStatusKinds
expect 0 "five kinds told apart, nothing written, rc 1 unless canonical" "the MacStudio ran an old branch from a foreign folder and nothing said so"

# T-OO-HEAL-FOLDER-GATE: keep, fastforward, aside, missing, worktree, occupied
test.oo.healFolderGate() {
  private.this.script.load ogit ogit.branch.get
  local base fx bad="" got want
  base=$(test.oo.base healgate clone); fx=$(dirname "$base")
  # behind: origin's prod moves on, the prod clone fetched it
  printf 'new\n' > "$base/main/new.txt"; git -C "$base/main" add new.txt
  git -C "$base/main" -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q -m new
  git -C "$base/main" push -q origin main:prod 2>/dev/null; git -C "$base/prod" fetch -q 2>/dev/null
  git clone -q -b dev "$fx/origin.git" "$fx/dirty" 2>/dev/null; printf 'dirt\n' >> "$fx/dirty/file"
  mkdir -p "$fx/empty" "$fx/wt" "$fx/occupied"; printf 'gitdir: x\n' > "$fx/wt/.git"; printf 'x\n' > "$fx/occupied/file"
  ln -s "$base/dev" "$fx/link"
  for want in "keep $base/dev dev" "fastforward $base/prod prod" "aside $fx/dirty dev" "aside $base/prod dev" \
              "missing $fx/none dev" "missing $fx/empty dev" "worktree $fx/wt dev" "occupied $fx/occupied dev" "aside $fx/link dev"; do
    set -- $want
    got=$( LOG_DEVICE="$fx/log.out"; private.oo.heal.folder.gate "$2" "$3" )
    [ "$got" = "$1" ] || bad="$bad ${2#$fx/}($3)=[$got]-want-$1"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "keep, fastforward, aside, missing, worktree, occupied" || create.result 1 "folder gate:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-FOLDER-GATE: the gate tells what oo heal does with a canonical folder" test.oo.healFolderGate
expect 0 "keep, fastforward, aside, missing, worktree, occupied" "a broken canonical folder was pulled into or reused"

# T-OO-HEAL-ASIDE-NEVER-DELETES: a broken folder goes to <base>.aside/<name>.<ts>, whole
test.oo.healAsideNeverDeletes() {
  local base fx bad="" one two
  base=$(test.oo.base healaside clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  printf 'one\n' > "$base/dev/mine.txt"
  one=$( LOG_DEVICE="$fx/log.out"; OOSH_DIR="$fx/tree"; PATH="$fx/bin:$PATH"; SUDO="sudo "
         private.oo.heal.folder.aside "$base/dev" >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$one" in "0|$base.aside/dev.orig."*) ;; *) bad="$bad first=[$one]" ;; esac
  one="${one#0|}"
  [ "$(cat "$one/mine.txt" 2>/dev/null)" = one ] && [ -d "$one/.git" ] || bad="$bad first-not-whole"
  [ -e "$base/dev" ] && bad="$bad dev-still-there"
  mkdir -p "$base/dev"; printf 'two\n' > "$base/dev/mine.txt"
  two=$( LOG_DEVICE="$fx/log.out"; OOSH_DIR="$fx/tree"; PATH="$fx/bin:$PATH"; SUDO="sudo "
         private.oo.heal.folder.aside "$base/dev" >/dev/null 2>&1; echo "$?|$RESULT" ); two="${two#0|}"
  [ "$two" != "$one" ] && [ "$(cat "$two/mine.txt" 2>/dev/null)" = two ] || bad="$bad second=[$two]"
  [ "$(cat "$one/mine.txt" 2>/dev/null)" = one ] || bad="$bad first-lost"
  [ -s "$fx/sudo.calls" ] && bad="$bad sudo-called"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "moved whole to <base>.aside/<name>.orig.<ts>, a second run a second stamp" || create.result 1 "aside:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-ASIDE-NEVER-DELETES: a broken canonical folder is moved to <base>.aside, never deleted" test.oo.healAsideNeverDeletes
expect 0 "moved whole to <base>.aside/<name>.orig.<ts>, a second run a second stamp" "owner decision 6: moved aside, never deleted"

# T-OO-HEAL-NOT-OWN-TREE: the tree oo heal runs from is never moved
test.oo.healNotOwnTree() {
  local base fx bad="" got
  base=$(test.oo.base healowntree clone); fx=$(dirname "$base"); mkdir -p "$base/main/sub"
  got=$( LOG_DEVICE="$fx/log.out"; OOSH_DIR="$base/prod"; private.oo.heal.folder.aside "$base/prod" >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "1|"*"curl form"*) ;; *) bad="$bad self=[$got]" ;; esac
  got=$( LOG_DEVICE="$fx/log.out"; OOSH_DIR="$base/main/sub"; private.oo.heal.folder.aside "$base/main" >/dev/null 2>&1; echo "$?" )
  [ "$got" = 1 ] || bad="$bad inside=[$got]"
  [ -d "$base/prod/.git" ] && [ -d "$base/main/.git" ] || bad="$bad moved"
  [ -e "$base.aside" ] && bad="$bad aside-made"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the running tree is refused, nothing moved" || create.result 1 "own tree:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-NOT-OWN-TREE: oo heal never moves the tree it runs from" test.oo.healNotOwnTree
expect 0 "the running tree is refused, nothing moved" "a heal that moves its own tree away loses its scripts"

# T-OO-HEAL-CODE-LOCAL-SOURCE: offline, the code step copies the tree running the heal, not ~/oosh
test.oo.healCodeLocalSource() {
  local base fx bad="" got
  base=$(test.oo.base healcode clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  git clone -q -b dev "$fx/origin.git" "$fx/tree" 2>/dev/null; printf 'x\n' > "$fx/tree/from.tree"
  mkdir -p "$fx/home" "$fx/newbase"; ln -s "$base/prod" "$fx/home/oosh"; printf 'x\n' > "$base/prod/from.home"
  got=$( HOME="$fx/home"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/nowhere.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "
         ogit.folder.finish() { create.result 0 finished; }
         private.oo.heal.code "$fx/newbase" dev >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "0|"*) ;; *) bad="$bad rc=[$got]" ;; esac
  [ -f "$fx/newbase/main/from.tree" ] || bad="$bad tree-not-copied"
  [ -f "$fx/newbase/main/from.home" ] && bad="$bad home-oosh-copied"
  [ "$(git -C "$fx/newbase/dev" symbolic-ref --short HEAD 2>/dev/null)" = dev ] || bad="$bad no-dev"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "offline the heal's own tree is the source" || create.result 1 "code local source:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-LOCAL-SOURCE: offline, the code step copies the tree oo heal runs from" test.oo.healCodeLocalSource
expect 0 "offline the heal's own tree is the source" "the offline fallback copied ~/oosh — in a heal the broken tree"

# T-OO-HEAL-CODE-ASIDE-RECLONE: a dirty branch folder is moved aside and cloned again; rc 1 says so
test.oo.healCodeAsideReclone() {
  local base fx bad="" got
  base=$(test.oo.base healreclone clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  printf 'dirt\n' >> "$base/dev/file"
  got=$( HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "
         ogit.folder.finish() { create.result 0 finished; }
         private.oo.heal.code "$base" dev >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "1|"*"moved to $base.aside/dev.orig."*) ;; *) bad="$bad rc=[$got]" ;; esac
  ogit.status.check "$base/dev" || bad="$bad dev-not-clean"
  grep -q dirt "$base.aside"/dev.orig.*/file 2>/dev/null || bad="$bad dirt-lost"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the dirty folder kept aside, a clean clone in its place, rc 1" || create.result 1 "code reclone:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-ASIDE-RECLONE: a broken branch folder is moved aside and cloned again" test.oo.healCodeAsideReclone
expect 0 "the dirty folder kept aside, a clean clone in its place, rc 1" "owner decision 6: a broken canonical folder is re-cloned"

# T-OO-HEAL-CODE-BUNDLE-ORIGIN: the source can be a bundle; the origin is always the canonical URL
# ossh heal ships the tree as a bundle in OOSH_REPO: the clones came from it
# and their origin named it — a dangling origin once the bundle was removed.
# The SOURCE is ${OOSH_REPO:-<canonical>}; a path or bundle origin is
# re-pointed to https://github.com/Cerulean-Circle-GmbH/once.sh.git.
test.oo.healCodeBundleOrigin() {
  local base fx bad="" got d canonical=https://github.com/Cerulean-Circle-GmbH/once.sh.git
  base=$(test.oo.base healbundle clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  git -C "$fx/origin.git" bundle create "$fx/oosh.bundle" --all >/dev/null 2>&1
  mkdir -p "$fx/newbase"
  got=$( HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/oosh.bundle"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "
         ogit.folder.finish() { create.result 0 finished; }
         private.oo.heal.code "$fx/newbase" dev >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "0|"*) ;; *) bad="$bad rc=[$got]" ;; esac
  for d in main dev; do
    [ "$(git -C "$fx/newbase/$d" remote get-url origin 2>/dev/null)" = "$canonical" ] || bad="$bad $d-origin=[$(git -C "$fx/newbase/$d" remote get-url origin 2>/dev/null)]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "cloned from the bundle, origin the canonical URL" || create.result 1 "bundle origin:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-BUNDLE-ORIGIN: a bundle source leaves the canonical URL as origin" test.oo.healCodeBundleOrigin
expect 0 "cloned from the bundle, origin the canonical URL" "the origin named the removed bundle"

# T-OO-HEAL-CODE-MAIN-ALSO-DEV: healing to main also ensures dev/ — the oosh invariant wants two siblings
test.oo.healCodeMainAlsoDev() {
  local base fx bad="" got
  base=$(test.oo.base healmain clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"; mkdir -p "$fx/newbase"
  got=$( HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "
         ogit.folder.finish() { create.result 0 finished; }
         private.oo.heal.code "$fx/newbase" main >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "0|"*) ;; *) bad="$bad rc=[$got]" ;; esac
  [ "$(git -C "$fx/newbase/main" symbolic-ref --short HEAD 2>/dev/null)" = main ] || bad="$bad no-main"
  [ "$(git -C "$fx/newbase/dev" symbolic-ref --short HEAD 2>/dev/null)" = dev ] || bad="$bad no-dev"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "main and dev" || create.result 1 "main heal:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-MAIN-ALSO-DEV: oo heal main ensures main/ and dev/" test.oo.healCodeMainAlsoDev
expect 0 "main and dev" "a heal to main left one folder, and oo mode had nothing to switch to"

# T-OO-HEAL-BASE-CASE: macOS letter case — /Users/shared and /Users/Shared are one folder, two strings
# path.get kept the typed case while config.init.user writes the file
# system's: a canonical link was reported as foreign. Simulated: the case
# getter maps /shared to /Shared, the canonical getter keeps the string.
test.oo.healBaseCase() {
  local fx bad="" out once=EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh
  fx=$(test.suite.fixture.make healcase); mkdir -p "$fx/Shared/$once/dev" "$fx/Shared/$once/main" "$fx/home"
  ln -s "$fx/Shared" "$fx/shared"; ln -s "$fx/Shared/$once/dev" "$fx/home/oosh"
  out=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/home"; TEST_FX="$fx"
         private.this.path.case.get() { echo "${1//\/shared/\/Shared}"; }
         private.this.path.canonical() { if [ -L "$1" ]; then readlink "$1"; else echo "$1"; fi; }
         private.oo.heal.basehome.get() { echo "$TEST_FX"; }
         private.oo.heal.system.diagnose() { :; }
         user.get() { [ "$2" = developking ] || echo "$TEST_FX/home"; }
         oo.heal.status dev tester 2>/dev/null )
  case "$out" in *"~/oosh: canonical"*) ;; *) bad="$bad [$(echo "$out" | grep '~/oosh')]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the base is in the file system letter case" || create.result 1 "case:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-BASE-CASE: the base is spelled in the file system letter case" test.oo.healBaseCase
expect 0 "the base is in the file system letter case" "macOS: a canonical ~/oosh was reported as foreign"

# T-OO-HEAL-RELOGIN: group dev takes effect after a re-login — said in the summary, never a FAIL
test.oo.healRelogin() {
  local fx bad="" out
  fx=$(test.suite.fixture.make healrelogin); mkdir -p "$fx/home/oosh/test" "$fx/base/dev" "$fx/sc"
  for out in configLayout layout boot oosh; do : > "$fx/home/oosh/test/test.platform.shared.$out.invariant"; done
  out=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/home"; TEST_FX="$fx"; healNotes=""; healRc=0
         id() { case "$1 $2" in
                  ("-nG tester") [ -e "$TEST_FX/added" ] && echo "staff dev" || echo staff ;;
                  ("-nG ")       echo staff ;;
                  ("-un ")       echo tester ;;
                  ("-u ")        echo 1000 ;;
                  (*)            command id "$@" ;;
                esac; }
         user.get() { echo "$TEST_FX/home"; }
         config.init.user() { : > "$TEST_FX/added"; }
         private.as.user() { echo "  ✗ FAIL: x — run something"; return 1; }
         private.oo.heal.state.finish() { create.result 0 s; }
         private.oo.heal.user tester "$fx/base" dev "$fx/sc" >/dev/null 2>&1
         private.oo.heal.verify tester "$fx/home"; echo "verify-rc=$?"
         private.oo.heal.summary )
  [ "$(echo "$out" | grep -c 'NOT CHECKED .* tester: group dev takes effect after a re-login')" = 4 ] || bad="$bad verify=[$(echo "$out" | grep -v '^ *$' | head -2 | tr '\n' '|')]"
  echo "$out" | grep -qx 'verify-rc=0' || bad="$bad verify-failed"
  echo "$out" | grep -q 'healed  relogin tester: .*log out and in once (group dev)' || bad="$bad no-relogin-line=[$(echo "$out" | grep relogin)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "pending group: NOT CHECKED, the summary asks for one re-login" || create.result 1 "relogin:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-RELOGIN: a new group dev member is told to log in again, the checks wait" test.oo.healRelogin
expect 0 "pending group: NOT CHECKED, the summary asks for one re-login" "a self-heal failed invariants that only a re-login could pass"

# T-OO-HEAL-DEVELOPKING-FACT: a developking the heal creates is named in the summary with its password
test.oo.healDevelopkingFact() {
  local fx got
  fx=$(test.suite.fixture.make healdevking)
  got=$( LOG_DEVICE="$fx/log.out"; TEST_FX="$fx"
         private.oo.heal.root.check()   { return 0; }
         private.this.group.exists()    { return 0; }
         private.this.group.create()    { return 0; }
         user.get()                     { [ -e "$TEST_FX/made" ] && echo "$TEST_FX/developking"; }
         user.create()                  { : > "$TEST_FX/made"; create.result 1 "oosh not installed for developking (no base yet)"; return 1; }
         user.group.add()               { return 0; }
         private.user.home.ensure()     { create.result 0 exists; }
         private.oo.shared.base.ensure() { create.result 0 exists; }
         private.oo.shared.base.share() { create.result 0 exists; }
         private.oo.install.launcher()  { create.result 0 ok; }
         private.oo.dropin.remove()     { create.result 0 ok; }
         private.oo.heal.system dev >/dev/null 2>&1; echo "$?|$RESULT" )
  rm -rf "$fx"
  case "$got" in "0|"*"developking created (admin, password = developking — state 31 precedent)"*) create.result 0 "named" ;; *) create.result 1 "system=[$got]" ;; esac
  return $(result)
}
test.case $level "T-OO-HEAL-DEVELOPKING-FACT: the summary names a developking the heal created, with its password" test.oo.healDevelopkingFact
expect 0 "named" "a developking admin account appeared on the Mac and nothing said so"

# T-OO-HEAL-CONFIG-GUARD: loading config in the clean process keeps CONFIG on the file that is not there
test.oo.healConfigGuard() {
  local got
  got=$( OOSH_HEAL_CLEAN=1; OOSH_DIR=/tmp/heal.guard.tree; CONFIG=/elsewhere/user.env
         private.oo.heal.config.load config.init.user >/dev/null 2>&1; echo "$CONFIG" )
  [ "$got" = /tmp/heal.guard.tree/.heal.noconfig ] && create.result 0 "CONFIG stays the guard" || create.result 1 "CONFIG=[$got]"
  return $(result)
}
test.case $level "T-OO-HEAL-CONFIG-GUARD: config.init never points the heal at ~/config/user.env" test.oo.healConfigGuard
expect 0 "CONFIG stays the guard" "config.init sets CONFIG=~/config/user.env when config is loaded"

# T-OO-HEAL-RC: 0 healed and verified, 1 something left, 2 cannot — every step a stand-in
test.oo.healRc.run() { # <fx> <uid> <who> <systemRc> <userRc> <?info> # run oo.heal dev <who> with recording stand-ins (info: the user step adds an informational left note); echo the calls, then rc=<n>
  local fx="$1"
  : > "$fx/calls"
  (
    HOME="$fx/home"; OOSH_HEAL_CLEAN=1; LOG_DEVICE="$fx/log.out"
    TEST_UID="$2"; TEST_SYS="$4"; TEST_USER="$5"; TEST_INFO="$6"
    id() { case "$1" in -u) echo "$TEST_UID" ;; -un) echo tester ;; *) command id "$@" ;; esac; }
    test.oo.healRc.record() { echo "$1" >> "$fx/calls"; }
    oo.heal.status()                 { test.oo.healRc.record status; }
    private.oo.heal.privilege.ensure() { :; }
    private.oo.heal.root.need()      { :; }
    private.oo.heal.basehome.get()   { echo "$fx/bh"; }
    private.oo.heal.system()         { test.oo.healRc.record system; create.result "$TEST_SYS" sys; return "$TEST_SYS"; }
    private.oo.heal.code()           { test.oo.healRc.record code; create.result 0 code; }
    private.oo.heal.config()         { test.oo.healRc.record config; create.result 0 config; }
    private.oo.heal.users.list()     { echo a; echo b; }
    private.oo.heal.user()           { test.oo.healRc.record "user.$1"
                                       [ -n "$TEST_INFO" ] && private.oo.heal.note 1 "ssh $1" "legacy ssh.* folders" info
                                       create.result "$TEST_USER" user; return "$TEST_USER"; }
    private.oo.heal.env()            { test.oo.healRc.record env; create.result 0 env; }
    private.oo.heal.verify()         { test.oo.healRc.record "verify.$1"; create.result 0 verify; }
    private.oo.heal.state.finish()   { test.oo.healRc.record state99; create.result 0 s; }
    user.get()                       { echo "$fx/home"; }
    oo.heal dev "$3" >/dev/null 2>&1
    echo "rc=$?" >> "$fx/calls"
  )
  tr '\n' ' ' < "$fx/calls"
}
test.oo.healRc() {
  local fx bad="" got; fx=$(test.suite.fixture.make healrc); mkdir -p "$fx/home"
  got=$(test.oo.healRc.run "$fx" 1000 tester 0 0)
  [ "$got" = "status system code config user.tester env verify.tester state99 rc=0 " ] || bad="$bad green=[$got]"
  got=$(test.oo.healRc.run "$fx" 1000 tester 0 1)
  [ "$got" = "status system code config user.tester env verify.tester rc=1 " ] || bad="$bad left=[$got]"
  got=$(test.oo.healRc.run "$fx" 1000 tester 2 0)
  [ "$got" = "status system rc=2 " ] || bad="$bad cannot=[$got]"
  # an informational left item (legacy ssh.*): rc 1, and state 99 all the same
  got=$(test.oo.healRc.run "$fx" 1000 tester 0 0 info)
  [ "$got" = "status system code config user.tester env verify.tester state99 rc=1 " ] || bad="$bad info=[$got]"
  got=$(test.oo.healRc.run "$fx" 1000 all 0 0)
  [ "$got" = "rc=2 " ] || bad="$bad all-not-root=[$got]"
  got=$(test.oo.healRc.run "$fx" 0 all 0 0)
  [ "$got" = "status system code config user.a user.b env verify.a verify.b state99 rc=0 " ] || bad="$bad all-root=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "rc 0 with state 99, rc 1 left, rc 2 stops; state 99 when steps and verify are green; all only as root" || create.result 1 "heal rc:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-RC: oo heal ends 0 healed, 1 left for you, 2 cannot heal" test.oo.healRc
expect 0 "rc 0 with state 99, rc 1 left, rc 2 stops; state 99 when steps and verify are green; all only as root" "one command must say whether the computer is healed"

# T-OO-HEAL-NO-SUDO-WHEN-NOT-NEEDED: healing one's own canonical account asks sudo nothing
# privilege.ensure ran before root.need: a user healing their own account got
# a prompt, a non-sudoer typed a password and failed. Root is asked only when
# a step needs it.
test.oo.healNoSudoWhenNotNeeded() {
  local fx got
  fx=$(test.suite.fixture.make healnosudo); mkdir -p "$fx/home"; test.oo.heal.sudo "$fx"
  got=$( HOME="$fx/home"; OOSH_HEAL_CLEAN=1; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; TEST_FX="$fx"
         unset OOSH_HEAL_ROOT OOSH_HEAL_INTERACTIVE
         id() { case "$1" in (-u) echo 1000 ;; (-un) echo tester ;; (*) command id "$@" ;; esac; }
         oo.heal.status()               { :; }
         private.oo.heal.root.need()    { :; }
         private.oo.heal.basehome.get() { echo "$TEST_FX/bh"; }
         private.oo.heal.system()       { create.result 0 s; }
         private.oo.heal.code()         { create.result 0 c; }
         private.oo.heal.config()       { create.result 0 c; }
         private.oo.heal.user()         { create.result 0 u; }
         private.oo.heal.env()          { create.result 0 e; }
         private.oo.heal.verify()       { create.result 0 v; }
         private.oo.heal.state.finish() { create.result 0 s; }
         user.get()                     { echo "$TEST_FX/home"; }
         oo.heal dev tester < /dev/null >/dev/null 2>&1; echo "rc=$?" )
  if [ "$got" = rc=0 ] && [ ! -s "$fx/sudo.calls" ]; then create.result 0 "rc 0, no sudo call"
  else create.result 1 "got=[$got] sudo=[$(tr '\n' '|' < "$fx/sudo.calls" 2>/dev/null)]"; fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-OO-HEAL-NO-SUDO-WHEN-NOT-NEEDED: oo heal asks for root only when a step needs it" test.oo.healNoSudoWhenNotNeeded
expect 0 "rc 0, no sudo call" "a user healing their own canonical account was asked for the sudo password"

# T-OO-HEAL-NO-SCRATCH-CONFIG: the clean process never writes into ~/config before the user step
# config.init (run when config is loaded) did mkdir $CONFIG_PATH and touch
# error.txt: a missing ~/config of the healer was created and then kept aside
# as a fake config.orig; a real one got error.txt before it was kept aside.
# The clean process has its own scratch CONFIG_PATH inside its tree copy.
test.oo.healNoScratchConfig() {
  local fx bad="" out
  fx=$(test.suite.fixture.make healscratch); mkdir -p "$fx/none" "$fx/real/config"; printf 'mine\n' > "$fx/real/config/user.env"
  test.oo.heal.stubTree "$fx/tree"
  printf '%s\n' 'echo "CONFIG_PATH=$CONFIG_PATH"' 'private.this.script.load config config.init >/dev/null 2>&1' >> "$fx/tree/oo"
  out=$( HOME="$fx/none"; LOG_DEVICE="$fx/log.out"; private.oo.heal.env.clean dev tester "$fx/tree" 2>/dev/null )
  { [ -e "$fx/none/config" ] || [ -L "$fx/none/config" ]; } && bad="$bad config-created"
  case "$(echo "$out" | sed -n 's/^CONFIG_PATH=//p')" in /tmp/oosh-heal.*/t/.heal.config) ;; *) bad="$bad config-path=[$(echo "$out" | grep '^CONFIG_PATH=')]" ;; esac
  out=$( HOME="$fx/real"; LOG_DEVICE="$fx/log.out"; private.oo.heal.env.clean dev tester "$fx/tree" 2>/dev/null )
  [ "$(ls -A "$fx/real/config" | tr '\n' ' ')" = "user.env " ] || bad="$bad real-config-written=[$(ls -A "$fx/real/config" | tr '\n' ' ')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "no ~/config made, a real one untouched" || create.result 1 "scratch:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-NO-SCRATCH-CONFIG: the heal never creates or writes ~/config before the user step" test.oo.healNoScratchConfig
expect 0 "no ~/config made, a real one untouched" "a fake config.orig was made from the heal's own scratch folder"

# T-OO-HEAL-ZSH-REPORTED: a login shell other than bash is reported, never changed
test.oo.healZshReported() {
  local fx out
  fx=$(test.suite.fixture.make healzsh); mkdir -p "$fx/home" "$fx/base"
  out=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/home"
         user.get() { case "$1" in (shell) echo /bin/zsh ;; (*) echo "$HOME" ;; esac; }
         private.oo.heal.user.diagnose tester "$fx/home" "$fx/base" dev 2>/dev/null )
  rm -rf "$fx"
  case "$out" in *"[left] tester login shell /bin/zsh — oo lives in bash: type bash first, or chsh -s "*) create.result 0 "reported" ;; *) create.result 1 "out=[$(echo "$out" | grep -i shell)]" ;; esac
  return $(result)
}
test.case $level "T-OO-HEAL-ZSH-REPORTED: a zsh login shell is reported with the way into bash" test.oo.healZshReported
expect 0 "reported" "the boss logs in to zsh and oo lives in bash"

# T-OO-HEAL-NONINTERACTIVE-NO-PROMPT: a run without a terminal never asks for a password
# The idempotence invariant hung the shared pane: `oo heal` without
# passwordless sudo prompted on /dev/tty at the launcher (sudo mkdir) with
# stdin closed. Root is decided once, up front: non-interactive is sudo -n or
# rc 2 before anything changes. The stub sudo records and fails.
test.oo.healNonInteractive() {
  local fx bad="" got
  fx=$(test.suite.fixture.make healnoprompt); mkdir -p "$fx/home"; test.oo.heal.sudo "$fx"
  got=$( HOME="$fx/home"; OOSH_HEAL_CLEAN=1; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; TEST_FX="$fx"
         unset OOSH_HEAL_ROOT OOSH_HEAL_INTERACTIVE OOSH_NO_INSTALL
         id() { case "$1" in (-u) echo 1000 ;; (-un) echo tester ;; (*) command id "$@" ;; esac; }
         test.oo.healNonInteractive.record() { echo "$1" >> "$TEST_FX/calls"; }
         oo.heal.status()               { :; }
         private.this.group.exists()    { return 1; }
         private.oo.heal.basehome.get() { echo "$TEST_FX/bh"; }
         private.oo.heal.system()       { test.oo.healNonInteractive.record system; }
         private.oo.heal.code()         { test.oo.healNonInteractive.record code; }
         private.oo.heal.config()       { test.oo.healNonInteractive.record config; }
         private.oo.heal.user()         { test.oo.healNonInteractive.record user; }
         private.oo.heal.state.finish() { test.oo.healNonInteractive.record state; }
         oo.heal dev tester < /dev/null >/dev/null 2>&1; echo "rc=$? $RESULT" )
  case "$got" in "rc=2 "*"needs root"*) ;; *) bad="$bad rc=[$got]" ;; esac
  [ -e "$fx/calls" ] && bad="$bad changed=[$(tr '\n' ' ' < "$fx/calls")]"
  grep -q -- '-n true' "$fx/sudo.calls" 2>/dev/null || bad="$bad no-sudo-n"
  grep -qv -- '^-n ' "$fx/sudo.calls" 2>/dev/null && bad="$bad prompting-sudo=[$(tr '\n' '|' < "$fx/sudo.calls")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "rc 2 before any change, only sudo -n asked" || create.result 1 "no prompt:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-NONINTERACTIVE-NO-PROMPT: without a terminal oo heal asks sudo -n only and stops with rc 2" test.oo.healNonInteractive
expect 0 "rc 2 before any change, only sudo -n asked" "oo heal prompted for a password in a non-interactive run and hung the pane"

# T-OO-HEAL-NO-USERENV-READ: the clean process never reads an old ~/config/user.env
# The Mac's ~/config/user.env exports PATH with `.`, HOME and LOG_DEVICE. The
# heal re-runs itself through env -i with CONFIG naming a file that is not
# there: a poisoned user.env (OOSH_DIR=/evil, PATH=.) changes nothing. The
# tree is a fixture whose oo prints what `this` left.
test.oo.healNoUserenvRead() {
  local fx bad="" out od
  fx=$(test.suite.fixture.make healclean); mkdir -p "$fx/home/config"
  printf '%s\n' 'export OOSH_DIR=/evil' 'export PATH=.' 'export HEAL_EVIL=yes' > "$fx/home/config/user.env"
  test.oo.heal.stubTree "$fx/tree"
  out=$( HOME="$fx/home"; LOG_DEVICE="$fx/log.out"; HEAL_EVIL=""; export https_proxy=http://proxy.invalid:3128 SUDO_USER=alice
         private.oo.heal.env.clean dev tester "$fx/tree" 2>/dev/null )
  # It runs from a world-readable copy of its tree under /tmp (T-OO-HEAL-RUNS-FROM-COPY).
  od=$(echo "$out" | sed -n 's/^OOSH_DIR=//p')
  case "$od" in /tmp/oosh-heal.*/t) ;; *) bad="$bad oosh-dir=[$od]" ;; esac
  case "$(echo "$out" | grep '^PATH=')" in "PATH=$od:"*) ;; *) bad="$bad path=[$(echo "$out" | grep '^PATH=')]" ;; esac
  case ":$(echo "$out" | sed -n 's/^PATH=//p'):" in *:.:*) bad="$bad dot-on-path" ;; esac
  echo "$out" | grep -qx "CONFIG=$od/.heal.noconfig" || bad="$bad config=[$(echo "$out" | grep '^CONFIG=')]"
  echo "$out" | grep -qx "EVIL=" || bad="$bad user.env-read"
  echo "$out" | grep -qx "ARGS=heal dev tester" || bad="$bad args=[$(echo "$out" | grep '^ARGS=')]"
  echo "$out" | grep -qx "PROXY=http://proxy.invalid:3128" || bad="$bad proxy-dropped"
  echo "$out" | grep -qx "LOGIN=alice" || bad="$bad login=[$(echo "$out" | grep '^LOGIN=')]"
  echo "$out" | grep -qx "SUDOUSER=" || bad="$bad sudo-user-carried"
  [ -n "$od" ] && [ -e "$od" ] && bad="$bad copy-left"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the clean process keeps the tree's OOSH_DIR and PATH, never reads user.env" || create.result 1 "env.clean:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-NO-USERENV-READ: oo heal runs in one clean process that never reads ~/config/user.env" test.oo.healNoUserenvRead
expect 0 "the clean process keeps the tree's OOSH_DIR and PATH, never reads user.env" "the Mac's user.env exports PATH with . and LOG_DEVICE=/dev/stdout"

# T-OO-HEAL-RUNS-FROM-COPY: oo heal typed from a private tree runs from a world-readable copy
# root in once_dev runs /root/oosh, a real folder under a 0700 home: the user
# step moves ~/oosh (its own running tree) and the as-user hops cannot read
# it. The clean process runs from a copy under /tmp/oosh-heal.*, the layout of
# the curl form; the tree it came from is untouched; the copy goes afterwards.
test.oo.healRunsFromCopy() {
  local fx bad="" out od written
  fx=$(test.suite.fixture.make healcopy); mkdir -p "$fx/home"
  test.oo.heal.stubTree "$fx/home/oosh"; chmod 700 "$fx/home"
  : > "$fx/stamp"; find "$fx/home" -exec touch -h -t 202001010000 {} + 2>/dev/null; touch -t 202001010100 "$fx/stamp"
  out=$( HOME="$fx/home"; LOG_DEVICE="$fx/log.out"; private.oo.heal.env.clean dev tester "$fx/home/oosh" 2>/dev/null )
  od=$(echo "$out" | sed -n 's/^OOSH_DIR=//p')
  case "$od" in /tmp/oosh-heal.*/t) ;; *) bad="$bad oosh-dir=[$od]" ;; esac
  # the tree it came from; the home itself gets the stub's session files from `this`
  written=$(find "$fx/home/oosh" -newer "$fx/stamp" 2>/dev/null | tr '\n' ' ')
  [ -z "$written" ] || bad="$bad original-written=[$written]"
  [ -n "$od" ] && [ -e "$od" ] && bad="$bad copy-left"
  chmod 755 "$fx/home"; rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "ran from a /tmp copy, the private tree untouched" || create.result 1 "copy:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-RUNS-FROM-COPY: oo heal runs from a world-readable copy of its own tree" test.oo.healRunsFromCopy
expect 0 "ran from a /tmp copy, the private tree untouched" "oo heal from /root/oosh moved its own running tree and the hops could not read it"

# T-OO-HEAL-REEXEC-ARGS: oo heal hands only <branch> <who> to the clean process
test.oo.healReexecArgs() {
  local got
  got=$( unset OOSH_HEAL_CLEAN; private.oo.heal.env.clean() { echo "$#:$*"; }; oo.start heal dev all extra 2>/dev/null )
  [ "$got" = "2:dev all" ] && create.result 0 "only <branch> <who>" || create.result 1 "args=[$got]"
  return $(result)
}
test.case $level "T-OO-HEAL-REEXEC-ARGS: a third word never becomes the tree of the clean process" test.oo.healReexecArgs
expect 0 "only <branch> <who>" "oo.start passed every word, the third became <tree>"

# T-OO-HEAL-USER-REAL-CONFIG: a real ~/config is kept as config.orig.<ts> and imported from
test.oo.healUserRealConfig.run() { # <fx> # heal user tester (init.user and the hop stand-ins), then the env step (its fresh process a stand-in that writes the env files as config init.env does); echo rc|RESULT of both
  local fx="$1" h="$1/home"
  ( LOG_DEVICE="$fx/log.out"; HOME="$h"; TEST_HOME="$h"; healOrigs=""
    user.get() { echo "$TEST_HOME"; }
    config.init.user() { rm -f "$TEST_HOME/config"; ln -s "$fx/sc" "$TEST_HOME/config"; echo "$*" > "$fx/init.args"; }
    private.as.user() { echo "$1" > "$fx/hop.user"; }
    private.oo.heal.fresh.run() {
      case "$2" in
        *init.env*) [ -f "$fx/sc/log.env" ] || printf '%s\n' 'export LOG_DEVICE="/dev/tty"' '. $HOME/.config/oosh/log.session.env' > "$fx/sc/log.env"
                    [ -f "$fx/sc/oosh.env" ] || printf '%s\n' 'export OOSH_DIR="$HOME/oosh"' '. $HOME/.config/oosh/oosh.session.env' > "$fx/sc/oosh.env" ;;
      esac
      echo "$2" >> "$fx/fresh.calls"; return 0; }
    private.oo.heal.user tester "$fx/base" dev "$fx/sc" >/dev/null 2>&1; echo -n "$?|$RESULT "
    private.oo.heal.env "$fx/sc" >/dev/null 2>&1; echo "$?|$RESULT" )
}
test.oo.healUserRealConfig() {
  local fx bad="" got orig
  fx=$(test.suite.fixture.make healuserconfig); mkdir -p "$fx/home/config" "$fx/base/dev" "$fx/sc"
  printf 'export LOG_LEVEL=2\n' > "$fx/home/config/log.env"; printf 'export OOSH_SSH_CONFIG_HOST=macstudio\n' > "$fx/home/config/oosh.env"
  got=$(test.oo.healUserRealConfig.run "$fx")
  case "$got" in "0|"*" 0|"*) ;; *) bad="$bad rc=[$got]" ;; esac
  orig=$(ls -d "$fx/home/config.orig."* 2>/dev/null)
  [ -n "$orig" ] && [ -f "$orig/log.env" ] || bad="$bad not-kept"
  [ "$(cat "$fx/init.args" 2>/dev/null)" = "tester $fx/base/dev" ] || bad="$bad init.user=[$(cat "$fx/init.args" 2>/dev/null)]"
  [ "$(cat "$fx/hop.user" 2>/dev/null)" = tester ] || bad="$bad no-hop"
  # the REAL import, after init.env made the files, before validate required
  private.this.script.load config private.config.env.value.read
  [ "$(private.config.env.value.read "$fx/sc/log.env" LOG_LEVEL)" = 2 ] || bad="$bad LOG_LEVEL-not-imported=[$(cat "$fx/sc/log.env" | tr '\n' '|')]"
  [ "$(private.config.env.value.read "$fx/sc/oosh.env" OOSH_SSH_CONFIG_HOST)" = macstudio ] || bad="$bad host-not-imported"
  [ "$(tr '\n' '|' < "$fx/fresh.calls" 2>/dev/null)" = "config init.env|config validate required|" ] || bad="$bad order=[$(tr '\n' '|' < "$fx/fresh.calls" 2>/dev/null)]"
  : > "$fx/fresh.calls"; rm -f "$fx/init.args"
  got=$(test.oo.healUserRealConfig.run "$fx")
  [ "$(ls -d "$fx/home/config.orig."* 2>/dev/null | grep -c '')" = 1 ] || bad="$bad a-link-kept-again"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "real config kept, linked; LOG_LEVEL and the host name imported after init.env, before validate" || create.result 1 "heal user:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-USER-REAL-CONFIG: a real ~/config is kept as config.orig.<ts> and the allow-list imported" test.oo.healUserRealConfig
expect 0 "real config kept, linked; LOG_LEVEL and the host name imported after init.env, before validate" "owner decision 2: a real ~/config is kept and an allow-listed few values carried"

# T-OO-HEAL-ALL-LIST: root, developking and every user with ~/oosh or ~/config
# — of its OWN: operator (AlmaLinux: uid 11, home /root, /sbin/nologin) saw
# root's ~/oosh, was healed and failed its shell step, and the second heal of
# the almalinux_9 gate ended rc 1 (private.user.account.heals.is).
test.oo.healAllList.world() { # # the passwd world of T-OO-HEAL-ALL-LIST; call inside the $( ) that uses it
  user.list() { printf '%s\n' alice bob carol root dave operator; }
  user.get() {
    case "$2" in
      operator) [ "$1" = shell ] && echo /sbin/nologin || echo "$fx/root" ;;
      *)        [ "$1" = shell ] && echo /bin/bash || echo "$fx/$2" ;;
    esac
  }
  user.id() { [ "$2" = operator ] && echo 11 || echo 1001; }
  private.this.path.stat.get() { [ "$1" = "$fx/root" ] && echo root || basename "$1"; }
  private.user.uid.min.get.linux() { echo 1000; }
  private.user.uid.min.get.darwin() { echo 1000; }
  OOSH_HEAL_LOGIN=dave
}
test.oo.healAllList() {
  local fx got
  private.this.script.load user private.user.account.heals.is
  fx=$(test.suite.fixture.make healall); mkdir -p "$fx/alice" "$fx/bob/config" "$fx/carol" "$fx/root"
  ln -s "$fx/nowhere" "$fx/alice/oosh"; ln -s "$fx/nowhere" "$fx/root/oosh"
  mkdir -p "$fx/dave"
  got=$( test.oo.healAllList.world
         private.oo.heal.users.list | tr '\n' ' ' )
  rm -rf "$fx"
  [ "$got" = "root developking alice bob dave " ] && create.result 0 "root developking alice bob dave" || create.result 1 "users=[$got]"
  return $(result)
}
test.case $level "T-OO-HEAL-ALL-LIST: oo heal all heals root, developking, every user with ~/oosh or ~/config of its own and the login that ran sudo — never a system account in root's home" test.oo.healAllList
expect 0 "root developking alice bob dave" "all must reach every installed user, a dangling link included, and no system account"

# T-OO-HEAL-ALL-SKIP: the accounts all passes over that DO see ~/oosh or
# ~/config are named once, with why; an account without either is not.
test.oo.healAllSkip() {
  local fx got
  private.this.script.load user private.user.account.heals.is
  fx=$(test.suite.fixture.make healallskip); mkdir -p "$fx/alice" "$fx/bob/config" "$fx/carol" "$fx/root" "$fx/dave"
  ln -s "$fx/nowhere" "$fx/alice/oosh"; ln -s "$fx/nowhere" "$fx/root/oosh"
  got=$( test.oo.healAllList.world
         private.oo.heal.users.list skip )
  rm -rf "$fx"
  [ "$got" = "  [skip] operator: system account (uid 11, /sbin/nologin, home $fx/root)" ] && create.result 0 "operator skipped, named once" || create.result 1 "skip=[$got]"
  return $(result)
}
test.case $level "T-OO-HEAL-ALL-SKIP: the diagnosis names a system account that sees ~/oosh once as [skip], with uid, shell and home" test.oo.healAllSkip
expect 0 "operator skipped, named once" "a skipped account is said, not silently dropped"

# T-OO-HEAL-VERIFY-NOT-CHECKED: an invariant this branch does not carry is NOT CHECKED, not FAIL
test.oo.healVerifyNotChecked() {
  local fx got
  fx=$(test.suite.fixture.make healverify); mkdir -p "$fx/home/oosh"
  got=$( LOG_DEVICE="$fx/log.out"; private.oo.heal.verify "$(id -un)" "$fx/home"; echo "rc=$?" )
  rm -rf "$fx"
  if [ "$(echo "$got" | grep -c 'NOT CHECKED')" = 4 ] && [ "$(echo "$got" | tail -1)" = rc=0 ]; then
    create.result 0 "four NOT CHECKED, rc 0"
  else
    create.result 1 "verify=[$(echo "$got" | tr '\n' '|')]"
  fi
  return $(result)
}
test.case $level "T-OO-HEAL-VERIFY-NOT-CHECKED: an invariant that cannot run is NOT CHECKED, with the reason" test.oo.healVerifyNotChecked
expect 0 "four NOT CHECKED, rc 0" "a heal on an older branch must not fail for invariants it does not carry"

# T-OO-HEAL-STATE-99: the install state machine is created when missing and set to 99
test.oo.healState99() {
  local fx got
  fx=$(test.suite.fixture.make healstate); mkdir -p "$fx/config/stateMachines"
  got=$( CONFIG_PATH="$fx/scratch"; LOG_DEVICE="$fx/log.out"; LOG_LEVEL=0
         private.oo.heal.state.finish "$fx/config" >/dev/null 2>&1; echo "$?|$(sed -n 's/^machine=//p;s/^state=//p' "$fx/config/current.state.machine.env" 2>/dev/null | tr '\n' ' ')" )
  rm -rf "$fx"
  [ "$got" = "0|SETUP_SERVER 99 " ] && create.result 0 "SETUP_SERVER at 99" || create.result 1 "state=[$got]"
  return $(result)
}
test.case $level "T-OO-HEAL-STATE-99: a green heal leaves SETUP_SERVER at 99, created when missing" test.oo.healState99
expect 0 "SETUP_SERVER at 99" "owner decision 10: ossh install's skip and oo state agree after a heal"

# T-OO-HEAL-USER-INIT-REASON: a failed config init.user is left with ITS reason, never "run it to see why"
# The first container gate: "config init.user test … failed — run it to see why"
# — a heal log that hides the cause. config.init.user names it in RESULT;
# private.oo.heal.user carries that RESULT into its own.
test.oo.healUserInitReason() {
  local fx got bad=""
  fx=$(test.suite.fixture.make healuserreason); mkdir -p "$fx/home" "$fx/base/dev" "$fx/sc"
  got=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/home"; healOrigs=""
         user.get() { echo "$fx/home"; }
         config.init.user() { create.result 1 "config.init.user: boom-the-real-reason"; return 1; }
         private.as.user() { :; }
         private.oo.heal.user tester "$fx/base" dev "$fx/sc" >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in 1\|*boom-the-real-reason*) ;; *) bad="$bad got=[$got]" ;; esac
  case "$got" in *"see why"*) bad="$bad still-see-why" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "rc 1 with config init.user's own reason" || create.result 1 "init reason:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-USER-INIT-REASON: a failed config init.user is left with its own reason" test.oo.healUserInitReason
expect 0 "rc 1 with config init.user's own reason" "the heal log said: run it to see why"

# T-OO-HEAL-USER-KEEP-HEALER-LOGIN: under all, a canonical user keeps their branch — the healer and the login move
# oo heal dev.heal all left root and the sudo login test on dev — and the
# second heal, run from root's ~/oosh, found no oo heal (coordinator decision
# 2026-10-07): the one who heals and the one who ran sudo move to the branch
# they named, every other canonical user keeps theirs.
test.oo.healUserKeepHealerLogin() {
  local fx got bad="" u me
  me=$(id -un)
  fx=$(test.suite.fixture.make healkeep); mkdir -p "$fx/base/dev" "$fx/base/old" "$fx/sc"
  for u in "$me" login other; do mkdir -p "$fx/homes/$u"; ln -s "$fx/base/old" "$fx/homes/$u/oosh"; done
  got=$( LOG_DEVICE="$fx/log.out"; HOME="$fx/homes/$me"; healOrigs=""; OOSH_HEAL_LOGIN=login
         user.get() { echo "$fx/homes/$2"; }
         config.init.user() { echo "$1 $2" >> "$fx/init.args"; create.result 0 linked; }
         private.as.user() { :; }
         for u in "$me" login other; do private.oo.heal.user "$u" "$fx/base" dev "$fx/sc" yes >/dev/null 2>&1; done
         tr '\n' '|' < "$fx/init.args" )
  [ "$got" = "$me $fx/base/dev|login $fx/base/dev|other $fx/base/old|" ] || bad="$bad init.user=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the healer and the login to dev, the other user keeps old" || create.result 1 "keep:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-USER-KEEP-HEALER-LOGIN: under all the healer and the login that ran sudo move to the branch, another canonical user keeps theirs" test.oo.healUserKeepHealerLogin
expect 0 "the healer and the login to dev, the other user keeps old" "root stayed on dev after oo heal dev.heal all and had no oo heal for the second run"

# T-OO-HEAL-CODE-SHARED: every folder the code step clones is group-shared with setgid, as the layout invariant reads it
# The first container gate's layout invariant failed for the user test with
# "dev.heal is not group-shared with setgid"; root's passed. The code step's
# ogit.folder.finish shares what it clones — proven here through the real
# finish and ogit layout.status, the invariant's own reading. Needs group dev
# and this user in it (ogit repo.share): else NOT CHECKED.
test.oo.healCodeShared() {
  local base fx bad="" got line
  case " $(id -nG 2>/dev/null) " in *" dev "*) ;; *)
    create.result 0 "NOT CHECKED: $(id -un) is not in group dev"; return $(result) ;; esac
  private.this.script.load ogit ogit.layout.status
  base=$(test.oo.base healshared clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"; mkdir -p "$fx/newbase"
  # no SUDO_USER: under sudo ogit.folder.finish would trust the fixture in the real login's ~/.gitconfig
  got=$( HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; unset SUDO_USER
         private.oo.heal.code "$fx/newbase" dev >/dev/null 2>&1; echo "$?|$RESULT"
         ogit.layout.status "$fx/newbase" 2>/dev/null )
  case "$got" in 0\|*) ;; *) bad="$bad rc=[$(echo "$got" | head -1)]" ;; esac
  for line in main dev; do
    echo "$got" | grep -q "^$line .*shared=group setgid=yes" || bad="$bad $line-not-shared=[$(echo "$got" | grep "^$line " | tr -s ' ')]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "main and dev shared=group setgid=yes" || create.result 1 "code shared:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-SHARED: the folders the code step clones are shared=group setgid=yes" test.oo.healCodeShared
expect 0 "main and dev shared=group setgid=yes" "the layout invariant found a cloned folder not group-shared"

# T-OO-HEAL-STATUS-DEVHOME-MISSING: developking without a home is the system step's to make, not "left"
# Gate 3 (2026-10-07): the diagnosis printed "[heal] developking has no home — created" and
# then "[left] developking: no home known — not healed", although the system step made the
# home and developking was healed and verified green. The diagnosis runs before any step:
# for developking a missing home (or a missing user) is [heal]; another user without a home
# stays [left].
test.oo.healStatusDevhomeMissing() {
  local fx bad="" out
  private.this.script.load ogit ogit.branch.get; private.this.script.load user user.get
  fx=$(test.suite.fixture.make healdevhome); mkdir -p "$fx/base"
  for who in developking someone; do
    out=$( LOG_DEVICE="$fx/log.out"; TEST_FX="$fx"
           private.oo.heal.basehome.get()    { echo "$TEST_FX/bh"; }
           private.oo.heal.path.get()        { echo "$TEST_FX/base"; }
           private.oo.heal.system.diagnose() { :; }
           private.oo.heal.user.diagnose()   { echo "  [ok]   diagnosed $1"; }
           user.get() { echo "$TEST_FX/bh/$2"; }
           oo.heal.status dev "$who" 2>/dev/null; echo "rc=$?" )
    case "$who" in
      developking)
        echo "$out" | grep -q '\[left\] developking' && bad="$bad developking-left=[$(echo "$out" | grep left)]"
        echo "$out" | grep -q '\[heal\] developking: .*system step' || bad="$bad developking-not-heal" ;;
      someone)
        echo "$out" | grep -q '\[left\] someone: no home known' || bad="$bad someone-not-left" ;;
    esac
    case "$out" in *rc=1) ;; *) bad="$bad $who-rc" ;; esac
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "developking without a home is [heal] (the system step makes it), another user [left]" || create.result 1 "devhome status:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-STATUS-DEVHOME-MISSING: oo heal status names developking's missing home a heal, not a left" test.oo.healStatusDevhomeMissing
expect 0 "developking without a home is [heal] (the system step makes it), another user [left]" "gate 3: [left] developking although the heal made its home"

# T-OO-HEAL-CODE-WORKTREE-UPSTREAM: a linked worktree that tracks nothing but whose branch origin
# has is given that upstream and converted; one on a branch origin lacks stays and is left with
# the gate's reason. Gate 3 (2026-10-07): testing tracked nothing, ogit worktree.remove refused it
# and the layout invariant failed for every user.
test.oo.healCodeWorktreeUpstream() {
  local base fx bad="" got
  base=$(test.oo.base healwtup clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  git -C "$base/main" push -q origin main:testing
  git -C "$base/main" worktree add -q -f -B testing "$base/testing" origin/testing >/dev/null 2>&1
  git -C "$base/testing" branch -q --unset-upstream
  got=$( HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; unset SUDO_USER
         ogit.folder.finish() { create.result 0 finished; }
         private.oo.heal.code "$base" dev </dev/null >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "0|"*) ;; *) bad="$bad tracked-rc=[$got]" ;; esac
  [ -d "$base/testing/.git" ] || bad="$bad testing-not-a-clone"
  [ "$(git -C "$base/testing" symbolic-ref --short HEAD 2>/dev/null)" = testing ] || bad="$bad testing-branch"
  rm -rf "$fx"
  base=$(test.oo.base healwtsolo clone); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  git -C "$base/main" worktree add -q -b solo "$base/solo" main >/dev/null 2>&1
  got=$( HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; unset SUDO_USER
         ogit.folder.finish() { create.result 0 finished; }
         private.oo.heal.code "$base" dev </dev/null >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "1|"*"solo tracks no upstream"*) ;; *) bad="$bad solo-rc=[$got]" ;; esac
  [ -f "$base/solo/.git" ] || bad="$bad solo-converted"
  [ -s "$fx/sudo.calls" ] && bad="$bad sudo-called"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "testing tracked and converted; solo, which origin lacks, left with the gate's reason" || create.result 1 "code worktree upstream:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-WORKTREE-UPSTREAM: the code step sets a worktree's missing upstream when origin has the branch, then converts it" test.oo.healCodeWorktreeUpstream
expect 0 "testing tracked and converted; solo, which origin lacks, left with the gate's reason" "gate 3: testing tracks no upstream — the heal left the worktree and every layout invariant failed"

# T-OO-HEAL-CODE-WORKTREE-NO-ROOT: without a terminal the worktree conversion of a shared base runs
# through sudo -n when that works, and is left for the user with the one command when it does not —
# never a password prompt. Gate 3's pipe heal (one user, stdin a pipe) said "enter your password if asked".
test.oo.healCodeWorktreeNoRoot() {
  local base fx bad="" got
  base=$(test.oo.base healwtroot); fx=$(dirname "$base"); test.oo.heal.sudo "$fx"
  got=$( { HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "
           unset SUDO_USER OOSH_HEAL_ROOT OOSH_HEAL_INTERACTIVE OOSH_NO_INSTALL
           id() { case "$1" in (-u) echo 1000 ;; (-un) echo tester ;; (*) command id "$@" ;; esac; }   # a user: the platform test runs this suite as root too
           private.ogit.root.check() { return 0; }
           ogit.folder.finish() { create.result 0 finished; }
           private.oo.heal.privilege.ensure worktrees
           private.oo.heal.code "$base" dev >/dev/null 2>&1; echo "$?|$RESULT"; } </dev/null )
  case "$got" in "1|"*"sudo -H ogit worktree.remove $base"*) ;; *) bad="$bad no-root=[$got]" ;; esac
  [ -f "$base/prod/.git" ] || bad="$bad converted-without-root"
  grep -qv -- '^-n ' "$fx/sudo.calls" 2>/dev/null && bad="$bad prompting-sudo=[$(tr '\n' '|' < "$fx/sudo.calls")]"
  grep -q -- 'worktree.remove' "$fx/sudo.calls" 2>/dev/null && bad="$bad converter-tried-sudo"
  # sudo -n works: the converter re-runs through it, with -n
  rm -f "$fx/sudo.calls"
  printf '%s\n' '#!/bin/sh' "echo \"\$*\" >> '$fx/sudo.calls'" 'exit 0' > "$fx/bin/sudo"
  got=$( { HOME="$fx"; OOSH_DIR="$fx/tree"; OOSH_REPO="$fx/origin.git"; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "
           unset SUDO_USER OOSH_HEAL_ROOT OOSH_HEAL_INTERACTIVE OOSH_NO_INSTALL
           id() { case "$1" in (-u) echo 1000 ;; (-un) echo tester ;; (*) command id "$@" ;; esac; }   # a user: the platform test runs this suite as root too
           private.ogit.root.check() { return 0; }
           ogit.folder.finish() { create.result 0 finished; }
           private.oo.heal.privilege.ensure worktrees
           private.oo.heal.code "$base" dev >/dev/null 2>&1; echo "$?|$RESULT"; } </dev/null )
  grep -q -- '^-n .*ogit worktree.remove' "$fx/sudo.calls" 2>/dev/null || bad="$bad no-sudo-n-rerun=[$(tr '\n' '|' < "$fx/sudo.calls" 2>/dev/null)]"
  grep -qv -- '^-n ' "$fx/sudo.calls" 2>/dev/null && bad="$bad prompting-sudo-2"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "no root: left with sudo -H ogit worktree.remove; with sudo -n: re-run through sudo -n; never a prompt" || create.result 1 "worktree no root:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-CODE-WORKTREE-NO-ROOT: a non-interactive heal converts worktrees through sudo -n or leaves the command, never prompts" test.oo.healCodeWorktreeNoRoot
expect 0 "no root: left with sudo -H ogit worktree.remove; with sudo -n: re-run through sudo -n; never a prompt" "gate 3: the pipe heal tried sudo for the worktree conversion"

# T-OO-HEAL-WORKTREES-NEED-SOFT: a one-user heal that needs root only for linked worktrees goes on
# without root (the code step leaves the conversion for the user); any other root need still stops
# with rc 2 before a change.
test.oo.healWorktreesNeedSoft() {
  local fx bad="" got need
  fx=$(test.suite.fixture.make healwtsoft); mkdir -p "$fx/home"; test.oo.heal.sudo "$fx"
  for need in worktrees "launcher worktrees"; do
    rm -f "$fx/calls"
    got=$( { HOME="$fx/home"; OOSH_HEAL_CLEAN=1; LOG_DEVICE="$fx/log.out"; PATH="$fx/bin:$PATH"; SUDO="sudo "; TEST_FX="$fx"; TEST_NEED="$need"
             unset OOSH_HEAL_ROOT OOSH_HEAL_INTERACTIVE OOSH_NO_INSTALL
             id() { case "$1" in (-u) echo 1000 ;; (-un) echo tester ;; (*) command id "$@" ;; esac; }
             test.oo.healWorktreesNeedSoft.record() { echo "$1" >> "$TEST_FX/calls"; create.result 0 "$1 done"; }
             oo.heal.status()               { :; }
             private.oo.heal.root.need()    { echo "$TEST_NEED"; }
             private.oo.heal.basehome.get() { echo "$TEST_FX/bh"; }
             private.oo.heal.system()       { test.oo.healWorktreesNeedSoft.record system; }
             private.oo.heal.code()         { test.oo.healWorktreesNeedSoft.record code; }
             private.oo.heal.config()       { test.oo.healWorktreesNeedSoft.record config; }
             private.oo.heal.user()         { test.oo.healWorktreesNeedSoft.record user; }
             private.oo.heal.env()          { test.oo.healWorktreesNeedSoft.record env; }
             private.oo.heal.verify()       { test.oo.healWorktreesNeedSoft.record verify; }
             private.oo.heal.state.finish() { test.oo.healWorktreesNeedSoft.record state; }
             oo.heal dev tester >/dev/null 2>&1; echo "rc=$? $RESULT"; } </dev/null )
    case "$need" in
      worktrees)
        grep -qx code "$fx/calls" 2>/dev/null || bad="$bad worktrees-stopped=[$got]" ;;
      *)
        case "$got" in "rc=2 "*"needs root"*) ;; *) bad="$bad launcher-not-stopped=[$got]" ;; esac
        [ -e "$fx/calls" ] && bad="$bad launcher-changed=[$(tr '\n' ' ' < "$fx/calls")]" ;;
    esac
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "worktrees alone: the heal goes on; launcher too: rc 2 before a change" || create.result 1 "worktrees soft:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-WORKTREES-NEED-SOFT: needing root only for worktrees does not stop a one-user heal" test.oo.healWorktreesNeedSoft
expect 0 "worktrees alone: the heal goes on; launcher too: rc 2 before a change" "a user heal stopped at rc 2 for a conversion it can leave to the user"

# T-OO-HEAL-FOLDER-FINISH-NOT-OWNER: a non-root heal never shares a folder it does not own
# Gate 3's pipe heal (as the user test) ran ogit repo.share on root's main/ and dev.heal/:
# "ERROR> ogit.repo.share: could not set group mode". Not the owner and not root: trust only;
# a folder its owner shared already is fine, one not shared is left with the owner's command.
test.oo.healFolderFinishNotOwner() {
  local base fx bad="" got
  base=$(test.oo.base healfinish clone); fx=$(dirname "$base"); chmod g+s "$base/dev/.git"
  for want in "dev 0" "other 1" "mine 0"; do
    set -- $want; rm -f "$fx/calls"
    got=$( LOG_DEVICE="$fx/log.out"; TEST_FX="$fx"; TEST_GROUP="$1"; TEST_ME=someone-else
           [ "$1" = mine ] && TEST_ME=owner-x
           id() { case "$1" in (-u) echo 1000 ;; (-un) echo "$TEST_ME" ;; (*) command id "$@" ;; esac; }
           private.this.group.exists() { return 0; }
           private.this.path.stat.get() { case "$2" in (owner) echo owner-x ;; (group) echo "$TEST_GROUP" ;; esac; }
           ogit.folder.finish()     { echo finish >> "$TEST_FX/calls"; create.result 0 finished; }
           ogit.repo.share()        { echo share >> "$TEST_FX/calls"; create.result 1 shared; }
           ogit.safeDirectory.add() { echo "trust" >> "$TEST_FX/calls"; create.result 0 trusted; }
           private.oo.heal.folder.finish "$base/dev" >/dev/null 2>&1; echo "$?|$RESULT" )
    case "$1" in
      dev)   case "$got" in 0\|*) ;; *) bad="$bad shared-rc=[$got]" ;; esac
             [ "$(tr '\n' ' ' < "$fx/calls" 2>/dev/null)" = "trust " ] || bad="$bad shared-calls=[$(tr '\n' ' ' < "$fx/calls" 2>/dev/null)]" ;;
      other) case "$got" in 1\|*"ogit repo.share $base/dev"*) ;; *) bad="$bad unshared-rc=[$got]" ;; esac
             grep -qx -e finish -e share "$fx/calls" 2>/dev/null && bad="$bad unshared-shared" ;;
      mine)  grep -qx finish "$fx/calls" 2>/dev/null || bad="$bad own-not-finished" ;;
    esac
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "not the owner: trust only, an unshared folder left with its owner's command; the owner finishes" || create.result 1 "folder finish:$bad"
  return $(result)
}
test.case $level "T-OO-HEAL-FOLDER-FINISH-NOT-OWNER: a non-root heal trusts a folder it does not own and never shares it" test.oo.healFolderFinishNotOwner
expect 0 "not the owner: trust only, an unshared folder left with its owner's command; the owner finishes" "gate 3: the pipe heal tried to share root's folders and logged ERRORs"

# T-OO-REAL-GITCONFIG-UNTOUCHED: after every test above, the developer's real
# ~/.gitconfig is what this file found at its start.
test.oo.gitconfigUntouchedAtEnd() {
  if [ "$(test.oo.gitconfig.cksum)" = "$TEST_OO_GITCONFIG_AT_START" ]; then
    create.result 0 "real ~/.gitconfig unchanged"
  else
    create.result 1 "the real ~/.gitconfig changed during this file: $TEST_OO_GITCONFIG_AT_START -> $(test.oo.gitconfig.cksum)"
  fi
  return $(result)
}
test.case - "T-OO-REAL-GITCONFIG-UNTOUCHED: the whole file leaves the real ~/.gitconfig as it found it" \
  test.oo.gitconfigUntouchedAtEnd
expect 0 "real ~/.gitconfig unchanged" "a test never writes outside its fixture"



console.log "
Test: oo.tmp.cleanup.testing
===================================================================="

# T-OO-TMP-CLEANUP-REFUSES: the destructive oo tmp.cleanup.testing refuses and runs nothing
# It ran sudo rm -rf, userdel -r developking and mv config.initial config; a
# sudo that records shows nothing is run, the RESULT names oo deinstall.
test.oo.tmpCleanupRefuses() {
  local fx got
  fx=$(test.suite.fixture.make tmpcleanup); mkdir -p "$fx/bin" "$fx/home"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SUDO_LOG"' 'exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  got=$( HOME="$fx/home"; PATH="$fx/bin:$PATH"; SUDO="sudo "; export SUDO_LOG="$fx/sudo.calls"; LOG_DEVICE="$fx/log.out"
         oo.tmp.cleanup.testing >/dev/null 2>&1; echo "rc=$? $RESULT" )
  [ -s "$fx/sudo.calls" ] && got="$got sudo-called=[$(tr '\n' '|' < "$fx/sudo.calls")]"
  rm -rf "$fx"
  case "$got" in "rc=1 "*"oo deinstall"*) case "$got" in *sudo-called*) ;; *) create.result 0 "refused, nothing run, oo deinstall named"; return $(result) ;; esac ;; esac
  create.result 1 "tmp.cleanup.testing: [$got]"
  return $(result)
}
test.case $level "T-OO-TMP-CLEANUP-REFUSES: oo tmp.cleanup.testing refuses and runs nothing" test.oo.tmpCleanupRefuses
expect 0 "refused, nothing run, oo deinstall named" "a Tab-completed verb ran sudo rm -rf and userdel -r developking"



































