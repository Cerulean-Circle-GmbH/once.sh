#!/usr/bin/env bash
# Tests for oo worktree detection and mode switching
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source $OOSH_DIR/oo

log.level $level

# ============================================================================
# T1: private.oo.worktree.base returns a result (may be empty on plain clone)
# ============================================================================
test.case $level "private.oo.worktree.base runs without crash" \
  private.oo.worktree.base

# On a worktree install it returns 0 and a path; on a plain clone it returns 1
# Either way it should not crash
local_exit=$?
if [ $local_exit -eq 0 ]; then
  expect.pass "worktree base detected: $(private.oo.worktree.base)"
elif [ $local_exit -eq 1 ]; then
  expect.pass "no worktree structure (plain clone) — returned 1 as expected"
else
  expect.fail "unexpected exit code: $local_exit"
fi

# ============================================================================
# T2: oo.mode (no args) returns 0 and produces output
# ============================================================================
test.case $level "oo.mode shows status without error" \
  oo.mode

expect 0 "*" "oo.mode returned 0"

# ============================================================================
# T3: oo.mode output includes Mode: line
# ============================================================================
_oo_mode_output=$(oo.mode 2>&1)
test.case $level "oo.mode output contains Mode: line" \
  echo "$_oo_mode_output"

if echo "$_oo_mode_output" | grep -q "^Mode:"; then
  expect.pass "output contains Mode: line"
else
  expect.fail "expected Mode: line in output, got: $_oo_mode_output"
fi

# ============================================================================
# T4: oo.mode.completion.branch produces output (at least remote branches)
# ============================================================================
_oo_completions=$(oo.mode.completion.branch 2>/dev/null)
test.case $level "oo.mode.completion.branch produces output" \
  echo "$_oo_completions"

if [ -n "$_oo_completions" ]; then
  expect.pass "completion returned branches"
else
  expect.fail "completion returned no branches"
fi

# ============================================================================
# T5: oo.mode with non-existent branch fails gracefully when no worktree base
# ============================================================================
_wt_base=$(private.oo.worktree.base 2>/dev/null)
_wt_rc=$?
if [ $_wt_rc -ne 0 ]; then
  # Plain clone — oo.mode should fail with helpful message
  test.case $level "oo.mode <branch> fails gracefully on plain clone" \
    oo.mode nonexistent-test-branch

  expect 1 "*" "oo.mode returned 1 on plain clone"
else
  # Worktree install — oo.mode with bad branch should try to create it
  test.case $level "oo.mode <branch> attempts worktree on worktree install" \
    echo "skipped — worktree install, would modify state"

  expect.pass "skipped (worktree install)"
fi

test.suite.save.results
