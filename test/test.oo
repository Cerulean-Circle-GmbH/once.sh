test.oo.use.missingArgs() {
  oo.use 2>/dev/null
}
test.case - "T-USE-1: oo.use rejects missing arguments" \
  test.oo.use.missingArgs
expect 1 "*" "oo.use requires branch and command arguments"

# ============================================================================
# T-USE-2: oo.use rejects non-existent branch
# ============================================================================
test.oo.use.badBranch() {
  oo.use "nonexistent_branch_$$" "somecommand" 2>/dev/null
}
test.case - "T-USE-2: oo.use rejects non-existent branch" \
  test.oo.use.badBranch
expect 1 "*" "oo.use rejects branch that does not exist"

# ============================================================================
# T-USE-3: oo.use finds branch via sibling directory fallback
# ============================================================================
test.oo.use.siblingFallback() {
  # Create a temp sibling dir with an executable script
  local parentDir
  parentDir=$(dirname "${OOSH_DIR:-$HOME/oosh}")
  local testBranch="testUseSibling$$"
  local testDir="$parentDir/$testBranch"

  mkdir -p "$testDir"
  echo '#!/usr/bin/env bash' > "$testDir/testCmd"
  echo 'echo "sibling-ok"' >> "$testDir/testCmd"
  chmod +x "$testDir/testCmd"

  # Temporarily unset OOSH_COMPONENTS_DIR to force sibling fallback
  local saveComponents="$OOSH_COMPONENTS_DIR"
  unset OOSH_COMPONENTS_DIR

  local output
  output=$(oo.use "$testBranch" "testCmd" 2>/dev/null)
  local rc=$?

  export OOSH_COMPONENTS_DIR="$saveComponents"
  rm -rf "$testDir"

  if [ $rc -eq 0 ] && [ "$output" = "sibling-ok" ]; then
    create.result 0 "sibling fallback worked"
  else
    create.result 1 "rc=$rc output=$output"
  fi
}
test.case - "T-USE-3: oo.use finds branch via sibling directory" \
  test.oo.use.siblingFallback
expect 0 "sibling fallback worked" "oo.use falls back to sibling directories"

# ─────────────────────────────────────────────────────────────────────────────
# T-OO-PREREQS-INSTALL : the local `oo prereqs.install` command exists AND
# delegates to `oo cmd` (doesn't reinvent package-install logic).
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-OO-PREREQS-INSTALL-PRESENT: oo.prereqs.install is defined in oo script" \
  echo "(grep)"
if grep -qE '^oo\.prereqs\.install\(\)' "$OOSH_DIR/oo"; then
  expect.pass "oo.prereqs.install is defined"
else
  expect.fail "oo.prereqs.install missing — local prereq-fix command not wired"
fi

test.case - "T-OO-PREREQS-INSTALL-DELEGATES-TO-CMD: uses oo cmd, doesn't reinvent" \
  echo "(grep oo.prereqs.install body for 'oo cmd')"
# Read the function body from the file directly (sourcing oo would load the
# whole script). Awk from `^oo.prereqs.install() ...` to the first `^}` line.
_OO_BODY=$(awk '/^oo\.prereqs\.install\(\)/{in_fn=1} in_fn{print} in_fn && /^}/{exit}' "$OOSH_DIR/oo")
if printf "%s" "$_OO_BODY" | grep -qE '[[:space:]]oo[[:space:]]+cmd[[:space:]]'; then
  expect.pass "oo.prereqs.install delegates to 'oo cmd'"
else
  expect.fail "oo.prereqs.install reinvents package install — must use 'oo cmd'"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-THIS-SUDO-SELF-HEAL : the file-scope $SUDO block in this sets $SUDO based on id -u when not already
# set. bashrcTemplate exports $SUDO for shells that source bashrc; this self-
# heals for ssh-with-command paths on distros without Debian's
# SSH_SOURCE_BASHRC bash patch (Alpine/musl). Both defenses are needed —
# they cover disjoint code paths.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-THIS-SUDO-SELF-HEAL: this self-heals \$SUDO for ssh-with-command on non-Debian distros" \
  echo "(grep this for the self-heal block)"
THIS_BODY=$(cat "$OOSH_DIR/this" 2>/dev/null)
if printf "%s" "$THIS_BODY" | grep -qE '\[ -z "\$\{SUDO\+x\}" \]' \
   && printf "%s" "$THIS_BODY" | grep -qE 'export SUDO=""' \
   && printf "%s" "$THIS_BODY" | grep -qE 'export SUDO="sudo "'; then
  expect.pass "this:\$SUDO self-heal block present (sets \"\" for root, \"sudo \" otherwise)"
else
  expect.fail "this missing \$SUDO self-heal — Alpine ssh-with-command will hit empty \$SUDO and useradd will fail"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-OO-PRIVILEGES-ROUTE-WITHOUT-USER : install state 13
# (private.check.priviledges.checked) routes root vs user on `[ "$USER" = root ]`.
# Bash does NOT set USER, and init/oosh's clean re-exec (env -i) erases it, so
# a root install with no later sudo hop (ssh root@host, `sudo ./init/oosh`)
# arrived here with USER empty and was routed to [20] user.rights.only.
# Simulated as root: a stub `id` first on PATH answers 0 / root, HOME is a
# fresh dir (no ~/.sudo_as_admin_successful), USER is UNSET. The only thing
# that can produce 30 is `this` healing USER from `id -un`.
# ─────────────────────────────────────────────────────────────────────────────
test.oo.privilegesRouteWithoutUser() {
  local stubDir got
  stubDir=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.idstub.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  printf '%s\n' '#!/bin/sh' 'case "$*" in *-un*|*-nu*) echo root ;; *-u*) echo 0 ;; *) command -p id "$@" ;; esac' > "$stubDir/id"
  chmod +x "$stubDir/id"
  mkdir -p "$stubDir/home"
  got=$(env -i PATH="$stubDir:$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=0 bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1
    source "$OOSH_DIR/oo"   >/dev/null 2>&1
    HOME="$1"
    private.check.priviledges.checked >/dev/null 2>&1
    printf "%s" "$RESULT"' _ "$stubDir/home")
  rm -rf "$stubDir"
  if [ "$got" = "30" ]; then
    create.result 0 "root routed to 30 without an inherited USER"
  else
    create.result 1 "routed to [$got] (expected 30) — with USER erased by the clean re-exec a root install lands in the user lane; this must heal USER from id -un"
  fi
  return $(result)
}
test.case - "T-OO-PRIVILEGES-ROUTE-WITHOUT-USER: state 13 routes root to [30] even when USER is not inherited" \
  test.oo.privilegesRouteWithoutUser
expect 0 "root routed to 30 without an inherited USER" \
  "ssh root@host / sudo ./init/oosh: the clean re-exec erases USER; routing must not depend on inheriting it"

# ─────────────────────────────────────────────────────────────────────────────
# T-THIS-INIT-LOG-LIVE-PRESERVED : this.init's source $CONFIG re-imports
# user.env mid-session, which transitively sources shared log.env. Without
# preservation, LOG_LIVE gets clobbered to whatever absolute path was last
# persisted (often a different user's). Mirrors the existing PATH preservation
# block in this.init.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-THIS-INIT-LOG-LIVE-PRESERVED: this.init save/restores LOG_LIVE around source \$CONFIG" \
  echo "(grep this for _savedLogLive)"
if printf "%s" "$THIS_BODY" | grep -qE '_savedLogLive' \
   && printf "%s" "$THIS_BODY" | grep -qE 'export LOG_LIVE="\$_savedLogLive"'; then
  expect.pass "this.init preserves LOG_LIVE across \$CONFIG re-source"
else
  expect.fail "this.init missing LOG_LIVE preservation — multi-user installs will hit cross-user permission errors"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-CONFIG-SAVE-EXCLUDES-LOG-LIVE : config.save (config:261) must filter
# LOG_LIVE= out of saved log.env — same hygiene as INSTALL_LOG/LOG_INSTALL.
# LOG_LIVE is per-user (~/config/log.live.out) and the value at save-time is
# the SAVING user's absolute path; persisting it pollutes shared log.env.
# Write-side complement to T-THIS-INIT-LOG-LIVE-PRESERVED (read-side).
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-CONFIG-SAVE-EXCLUDES-LOG-LIVE: config.save filters LOG_LIVE out of saved log.env" \
  echo "(generate log.env with LOG_LIVE set; verify excluded)"
_llfix="/tmp/test.oo.loglive.$(id -u).$$"; mkdir -p "$_llfix"
bash -c '
  export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
  source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/config" >/dev/null 2>&1
  export CONFIG_PATH="'"$_llfix"'" CONFIG_FILE=user.env CONFIG="'"$_llfix"'/user.env"
  export LOG_LEVEL=3 LOG_LEVEL_RESET=3 LOG_LIVE="/home/someuser/config/log.live.out"
  export LOG_NAME="someuser@somehost" LOG_DEVICE="/dev/pts/7"
  export OOSH_USER_CONFIG_PATH="/home/someuser/.config/oosh"
  : > "$CONFIG"; LOG_LEVEL=1 config.save >/dev/null 2>&1
' >/dev/null 2>&1
# behavior check, robust to how the filter is expressed. Also guards LOGNAME
# (name=LOG must NOT match LOGNAME — the [_=] boundary), which leaked once.
# LOG_NAME (OOSH's per-user identity), LOG_DEVICE (per-session tty) and
# OOSH_USER_CONFIG_PATH (per-user dir) must also stay out of the SHARED config —
# they are per-user, living in $OOSH_USER_CONFIG_PATH/log.session.env.
# Match only a leaked EXPORT ASSIGNMENT of these vars — NOT the legitimate
# `source $OOSH_USER_CONFIG_PATH/log.session.env` chain line log.env now carries.
# SPLIT, deliberately. The three historically-leaking LOG_* vars plus LOGNAME
# keep their UNCONDITIONAL guard — no assignment of them belongs in the shared
# config in any form, `$`-prefixed included (a persisted
# LOG_DEVICE="$OOSH_USER_CONFIG_PATH/…" would still be a leak).
# OOSH_USER_CONFIG_PATH is the one exception, because user.env now carries
# `export OOSH_USER_CONFIG_PATH="$HOME/.config/oosh"` as boot DATA — written
# UNEXPANDED, so it is right for every user on the host and is the opposite of
# a leak. For that ONE variable the value decides: a first character other than
# `$` means the saving user's path was baked in. Both quoted and bare forms are
# spelled out, because `="?[^$]` would let `[^$]` match the quote itself.
_leakpat='^[[:space:]]*export[[:space:]]+(LOG_LIVE|LOG_NAME|LOG_DEVICE|LOGNAME)=|^[[:space:]]*export[[:space:]]+OOSH_USER_CONFIG_PATH=("[^$"]|[^$"])'
if [ -f "$_llfix/log.env" ] && ! grep -qE "$_leakpat" "$_llfix"/*.env 2>/dev/null; then
  expect.pass "config.save excludes per-user log vars from saved config"
else
  expect.fail "config.save leaked into config: $(grep -hE "$_leakpat" "$_llfix"/*.env 2>/dev/null | tr '\n' ' ')"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-CONFIG-SAVE-NO-LOG-SESSION-CHAIN : the generated log.env must carry NO
# per-user chain line. It used to source $OOSH_USER_CONFIG_PATH/log.session.env,
# but log.env is SHARED and the per-user file is not guaranteed to exist — dash
# ABORTS on `.` of a missing file, so a single user who never saved a session
# broke every dash shell on the host. `log` now creates and sources that file
# itself (test.config T45/T46). Complement to the exclusion test above: the
# per-user values stay out of log.env, and so does the pointer to them.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-CONFIG-SAVE-NO-LOG-SESSION-CHAIN: log.env carries no per-user chain line" \
  echo "(verify log.env does not source log.session.env)"
if grep -q 'log\.session\.env' "$_llfix/log.env" 2>/dev/null; then
  expect.fail "log.env chains the per-user session file — dash aborts when it is missing: $(grep -n 'session' "$_llfix/log.env" 2>/dev/null | tr '\n' ' ')"
else
  expect.pass "log.env carries no \$OOSH_USER_CONFIG_PATH/log.session.env chain"
fi
rm -rf "$_llfix"

# ─────────────────────────────────────────────────────────────────────────────
# T-OO-CHECKOUT-COMPLETION-LOCAL-FALLBACK : oo.checkout.completion.version
# must fall back to locally-cached remote-tracking branches when `git ls-remote
# origin` fails (origin unreachable: VM without 2cuGitHub SSH alias, offline
# laptop, expired token). Without this, the completion silently returns
# nothing and c2's parameter-default fallback leaks the literal
# "addDefaultValue" placeholder as the lone completion suggestion — observed
# on a fresh tart_sequoia VM where git can't resolve `2cuGitHub`. Pin both
# the canonical ls-remote query (ogit.remote.branch.list) and the local
# remote-tracking fallback (ogit.branch.list remote) — ogit plan Task 15.
# ─────────────────────────────────────────────────────────────────────────────
test.case - "T-OO-CHECKOUT-COMPLETION-LOCAL-FALLBACK: oo.checkout.completion.version falls back to local remote-tracking refs when ls-remote fails" \
  echo "(grep)"
OO_CHECKOUT_BODY=$(sed -n '/^oo\.checkout\.completion\.version()/,/^}/p' "$OOSH_DIR/oo")
if printf "%s" "$OO_CHECKOUT_BODY" | grep -qE 'ogit\.remote\.branch\.list' \
   && printf "%s" "$OO_CHECKOUT_BODY" | grep -qE 'ogit\.branch\.list remote'; then
  expect.pass "oo.checkout.completion.version has both ogit.remote.branch.list (primary) and ogit.branch.list remote (local fallback)"
else
  expect.fail "oo.checkout.completion.version missing local fallback — 'oo checkout <Tab>' will silently return nothing on offline / unreachable-origin hosts"
fi

# ============================================================================
# T-SHARED-TREE-FROM-LOCAL-CREATES-MAIN-AND-CLONE: helper produces the
# canonical Once.sh/{main, <branch>} CLONE layout (2026-09-23 design) from a
# local git clone: <branch>/ is an independent clone (.git a directory) whose
# origin is main/'s origin, in group-shared mode. Reproduces state-31's
# fallback path.
# ============================================================================
# The fixture origin URL is never contacted: every clone here is from a local
# path, and the helper only COPIES main/'s origin URL onto the new clone.
TEST_OO_STREE_ORIGIN="git@github.com:example/once.sh.git"

private.test.oo.stree.cloneShape() { # <fixtureTarget> <branch> # RESULT = "clone" when <target>/<branch> has the clone shape, else what is wrong
  local t="$1" b="$2" mainUrl devUrl shared
  mainUrl=$(git -C "$t/main" remote get-url origin 2>/dev/null)
  devUrl=$(git -C "$t/$b" remote get-url origin 2>/dev/null)
  shared=$(git -C "$t/$b" config --get core.sharedRepository 2>/dev/null)
  if [ ! -d "$t/main/.git" ]; then
    create.result 1 "main/ is not a repository"
  elif [ ! -d "$t/$b/.git" ]; then
    create.result 1 "$b/.git is not a directory — not an independent clone ($( [ -f "$t/$b/.git" ] && echo 'a worktree file' || echo missing))"
  elif [ -z "$mainUrl" ] || [ "$devUrl" != "$mainUrl" ]; then
    create.result 1 "origin of $b/ is '$devUrl', main/'s is '$mainUrl'"
  elif [ "$(git -C "$t/$b" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$b" ]; then
    create.result 1 "$b/ is not on branch $b"
  elif [ "$shared" != "group" ]; then
    create.result 1 "core.sharedRepository of $b/ is '$shared', not group"
  else
    create.result 0 "clone"
  fi
  return $(result)
}

test.oo.sharedTreeFromLocalCreatesLayout() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.stree.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  mkdir -p "$fixture/source" "$fixture/target"
  # Build a minimal source clone: init repo, commit on main, branch dev.
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo "seed" > README.md
    git add README.md
    git commit -q -m "seed"
    git branch dev
    git checkout -q dev
    git config receive.denyCurrentBranch warn
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc=$?

  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "main/ + dev/ clone layout produced"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-SHARED-TREE-FROM-LOCAL-CREATES-MAIN-AND-CLONE: helper produces main/ + dev/ clone layout" \
  test.oo.sharedTreeFromLocalCreatesLayout
expect 0 "main/ + dev/ clone layout produced" "private.oo.shared.tree.from.local creates the canonical clone layout: dev/.git a directory, origin = main/'s origin, core.sharedRepository=group"

# T-SHARED-TREE-FROM-LOCAL-ORIGIN-FALLBACK: the source is a clone of ANOTHER
# branch, so main/ holds only origin/<branch>, no local <branch>. A clone from
# a local path sees only main/'s local heads — the helper must create the local
# <branch> from origin/<branch> first (the fallback the old worktree-add pair
# had), and leave main/ on main.
test.oo.sharedTreeFromLocalOriginFallback() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.stree.fb.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  mkdir -p "$fixture/source" "$fixture/target"
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo "seed" > README.md && git add . && git commit -q -m "seed"
    git checkout -q -b dev
    echo "on dev" > dev.txt && git add . && git commit -q -m "dev work"
    git update-ref refs/remotes/origin/dev dev
    git checkout -q main
    git branch -q -D dev
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc=$?

  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif ! private.test.oo.stree.cloneShape "$fixture/target" dev; then
    :
  elif [ ! -f "$fixture/target/dev/dev.txt" ]; then
    create.result 1 "dev/ does not hold origin/dev's commit"
  elif [ "$(git -C "$fixture/target/main" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "main" ]; then
    create.result 1 "main/ was left on $(git -C "$fixture/target/main" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  else
    create.result 0 "cloned from origin/dev"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-FROM-LOCAL-ORIGIN-FALLBACK: main/ without a local dev still yields the dev clone" \
  test.oo.sharedTreeFromLocalOriginFallback
expect 0 "cloned from origin/dev" "the origin/<branch> fallback survives the move from worktree add to clone"

# T-SHARED-TREE-FROM-LOCAL-IDEMPOTENT: second invocation must be a no-op
# (fast-path returns when main/ already exists) and leaves the clone as it was.
test.oo.sharedTreeFromLocalIdempotent() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.stree.idem.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  mkdir -p "$fixture/source" "$fixture/target"
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo "seed" > README.md && git add . && git commit -q -m "seed"
    git branch dev && git checkout -q dev
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local hash1
  hash1=$(find "$fixture/target" -printf '%p %m\n' 2>/dev/null | sort | sha256sum)

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc2=$?
  local hash2
  hash2=$(find "$fixture/target" -printf '%p %m\n' 2>/dev/null | sort | sha256sum)

  if [ "$rc2" -ne 0 ]; then
    create.result 1 "second call returned $rc2"
  elif [ "$hash1" != "$hash2" ]; then
    create.result 1 "hash mismatch: '$hash1' vs '$hash2'"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "second call no-op"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-SHARED-TREE-FROM-LOCAL-IDEMPOTENT: second invocation is a no-op and keeps the clone" \
  test.oo.sharedTreeFromLocalIdempotent
expect 0 "second call no-op" "private.oo.shared.tree.from.local is idempotent (fast-path on main/ presence), rc 0, the clone untouched"

# T-SHARED-TREE-FROM-LOCAL-BRANCH-MAIN: when branch arg IS main, only main/
# is created (no worktree-add for ../main).
test.oo.sharedTreeFromLocalBranchMain() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.stree.main.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  mkdir -p "$fixture/source" "$fixture/target"
  (
    cd "$fixture/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    echo "seed" > README.md && git add . && git commit -q -m "seed"
  ) >/dev/null 2>&1

  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" main ) >/dev/null 2>&1
  local rc=$?

  # main/ should exist; no sibling "main/main" or similar weirdness.
  local extra_dirs
  extra_dirs=$(find "$fixture/target" -maxdepth 1 -mindepth 1 -type d -not -name main -not -name source 2>/dev/null | wc -l)
  if [ "$rc" -eq 0 ] && [ -d "$fixture/target/main/.git" ] && [ "$extra_dirs" -eq 0 ]; then
    create.result 0 "only main/ created"
  else
    create.result 1 "rc=$rc; extra dirs: $(ls $fixture/target 2>&1)"
  fi
  rm -rf "$fixture" 2>/dev/null
}
test.case - "T-SHARED-TREE-FROM-LOCAL-BRANCH-MAIN: branch=main creates only main/, no spurious worktree" \
  test.oo.sharedTreeFromLocalBranchMain
expect 0 "only main/ created" "private.oo.shared.tree.from.local skips worktree-add when branch == main"

# ============================================================================
# T-SHARED-TREE-CONSUME-*: the <?consumeSource:no> parameter
# ============================================================================
# `oo mode.setup` needs the source removed BETWEEN the copy and the
# branch clone: when the plain clone already sits at <base>/<branch>, the
# clone into <base>/<branch> collides with it (ogit repo.clone refuses a
# non-empty target). Doing it inside the helper
# keeps ONE layout builder and puts the destructive step next to the rc checks
# that already guard the copy. Default `no`, which is what pins install state
# 31's call.
private.test.oo.consume.fixture() { # <fixtureRoot> # a source clone on dev + an empty target
  mkdir -p "$1/source" "$1/target"
  (
    cd "$1/source"
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    git remote add origin "$TEST_OO_STREE_ORIGIN"
    echo seed > README.md
    git add README.md
    git commit -q -m seed
    git branch dev
    git checkout -q dev
  ) >/dev/null 2>&1
}

test.oo.sharedTreeConsumeDefaultKeepsSource() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.consume.keep.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  private.test.oo.consume.fixture "$fixture"
  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif [ ! -d "$fixture/source" ]; then
    create.result 1 "the default removed the source — state 31 would lose ~/oosh"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "source kept"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-DEFAULT: without the flag the source survives" \
  test.oo.sharedTreeConsumeDefaultKeepsSource
expect 0 "source kept" "install state 31 passes no third argument — its source is \$HOME/oosh"

test.oo.sharedTreeConsumeRemovesSource() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.consume.yes.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  private.test.oo.consume.fixture "$fixture"
  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev yes ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc"
  elif [ -d "$fixture/source" ]; then
    create.result 1 "the source is still there"
  elif private.test.oo.stree.cloneShape "$fixture/target" dev; then
    create.result 0 "source consumed"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-YES: the source is removed and the clone layout still lands" \
  test.oo.sharedTreeConsumeRemovesSource
expect 0 "source consumed" "the removal happens between the copy and the branch clone, which is the only safe ordering"

test.oo.sharedTreeConsumeRefusesBadMain() {
  # A source that is NOT a git repository: the copy succeeds, main/.git is
  # absent, and the helper must refuse rather than delete the only copy.
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.consume.bad.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/source" "$fixture/target"
  echo "not a repo" > "$fixture/source/README.md"
  ( cd "$fixture/target" && private.oo.shared.tree.from.local "$fixture/source" dev yes ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success with a main/ that is not a repository"
  elif [ ! -d "$fixture/source" ]; then
    create.result 1 "it removed the source anyway — the only copy is gone"
  else
    create.result 0 "refused"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-REFUSES: a main/ that is not a repository is not a licence to delete" \
  test.oo.sharedTreeConsumeRefusesBadMain
expect 0 "refused" "verify before destroying — the source may be the only copy"

# The case the parameter exists for: the clone ALREADY sits where the branch
# clone has to go. Without consuming it first, ogit repo.clone refuses an
# existing non-empty path and the whole layout fails. The rebuilt dev/ is the
# helper's own clone: group-shared, which the staged source never was.
test.oo.sharedTreeConsumeSourceInTheWay() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.consume.inway.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  mkdir -p "$fixture/base"
  private.test.oo.consume.fixture "$fixture/staging"
  mv "$fixture/staging/source" "$fixture/base/dev"

  ( cd "$fixture/base" && private.oo.shared.tree.from.local "$fixture/base/dev" dev yes ) >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned $rc with the source in the way"
  elif private.test.oo.stree.cloneShape "$fixture/base" dev; then
    create.result 0 "rebuilt in place"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case $level "T-SHARED-TREE-CONSUME-IN-THE-WAY: a clone sitting at <base>/<branch> is replaced by the layout's own clone" \
  test.oo.sharedTreeConsumeSourceInTheWay
expect 0 "rebuilt in place" "this is the ordering the parameter exists for — copy, verify, remove, then clone"

# ============================================================================
# T-PROFILE-*: /etc/profile.d/oosh.sh — the login-shell bootstrap
# ============================================================================
# Successor of ticket T9's `/etc/oosh/boot`. That fixed host-wide SYMLINK
# existed for one reason: with HOME unset, dash/ash leave `~` literal, so
# `. ~/oosh/boot` could not be REACHED in exactly the empty-environment case
# it was meant to survive — an absolute path was the only way in.
#
# There is nothing left to link. `boot` is gone; the bootstrap is DATA in
# ~/config/user.env, and that path is $HOME-relative by construction. What
# survives is the LOGIN route: /etc/profile loops `for i in /etc/profile.d/*.sh`,
# so a drop-in there recovers $HOME itself (getent -> dscl -> /etc/passwd) and
# then sources ~/config/user.env. Measured in a container:
#
#   env -i sh      -> NO.  $ENV is a non-login POSIX sh's ONLY rc hook, and
#                          `env -i` is what erased it. Nothing recovers this;
#                          do not claim otherwise anywhere.
#   env -i sh -l   -> YES, once /etc/profile.d has the oosh drop-in.
#
# dash's own trace settles it: `env -i sh -lxc ':'` runs /etc/profile
# (`[ -d /etc/profile.d ]`, then the `*.sh` glob) while `env -i sh -xc ':'`
# shows only `+ :`.
#
# It is created by install state 34 (root.profile.dropin.installed) and healed
# by `oo profile.fix`; `oo profile.status` reports on it.
#
# EVERYTHING here is driven against FIXTURE paths. A core test must never write
# to the host's real /etc/profile.d, and must never need root.

# --- T-PROFILE-CHECK-DEFINED --------------------------------------------------------
test.oo.profileDropInCheckDefined() {
  if [ "$(type -t private.check.root.profile.dropin.installed)" = "function" ]; then
    create.result 0 "state 34 guard is defined"
  else
    create.result 1 "private.check.root.profile.dropin.installed is not a function"
  fi
  return $(result)
}
test.case - "T-PROFILE-CHECK-DEFINED: private.check.root.profile.dropin.installed exists" \
  test.oo.profileDropInCheckDefined
expect 0 "state 34 guard is defined" \
  "state.next [34] dispatches to private.check.<stateName> — no guard, no transition"


# ============================================================================
# T-PROFILE-STATE-34: `34 root.profile.dropin.installed` is registered, and RENUMBERS NOTHING
# ============================================================================
# state.add treats a NUMERIC argument as a transition marker that jumps the
# index; every other argument takes the current index and then increments it.
# So inserting a named state after `root.installation.done` lands it at 34 and
# pushes only the `state.add 40` MARKER to index 35 — every existing state
# NUMBER, including the ones hard-coded in comments across `oo` and `ossh`, is
# unchanged. The RENAME from root.boot.path.installed changes the name in slot
# 34 and nothing else.
#
# The host's own machine is frozen at first install, so this DECLARES a fresh
# one under a throwaway CONFIG_PATH (state.machine.create + the very state.add
# calls private.init.state.machine makes, read from the source) and lets the
# real `state` number it — nothing transitions, so no private.check.* runs and
# the shared current.state.machine.env is never touched. A declared-but-never-
# STARTED machine keeps the template placeholder `next.custom.state` after the
# last add (state.machine.start turns it into the 99 transition), hence slot 62.
# ([[project-state-check-resources-script]]).
test.oo.stateMachineNumbering() {
  local tmp adds map expected
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.state34.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  adds=$(awk '
    /^private\.init\.state\.machine\(\)/ { inFn = 1 }
    inFn && /^}/                        { inFn = 0 }
    inFn && $1 == "state.add"           { print $2 }
  ' "$OOSH_DIR/oo")
  map=$(
    export CONFIG_PATH="$tmp"; mkdir -p "$tmp/stateMachines"
    source "$OOSH_DIR/state" >/dev/null 2>&1
    LOG_LEVEL=0
    state.machine.create T34 oo >/dev/null 2>&1
    for s in $adds; do state.add "$s" silent >/dev/null 2>&1; done
    # shellcheck disable=SC1090
    source "$tmp/stateMachines/T34.states.env" 2>/dev/null
    for i in "${!T34_STATES[@]}"; do [ "$i" -ge 11 ] && echo "$i=${T34_STATES[$i]}"; done | sort -n
  )
  rm -rf "$tmp"
  # The FULL expected map. Any renumbering of any state breaks this literally.
  expected="11=remote.install.started
12=local.install.started
13=priviledges.checked
14=20
20=user.rights.only
21=user.installation.done
22=user.mode.release
23=user.mode.dev
24=30
30=root.rights
31=root.shared.dev.folder.created
32=root.dev.keys.installed
33=root.installation.done
34=root.profile.dropin.installed
35=40
40=user.shared.dev.folder.linked
41=user.state.machine.synced.with.root
42=50
50=headless.setup.started
51=headless.setup.finished
52=60
60=once.setup.started
61=once.setup.finished
62=next.custom.state
99=finished
100=6"
  if [ "$map" = "$expected" ]; then
    create.result 0 "state 34 registered, no state renumbered"
  else
    create.result 1 "state map drifted: $(diff <(echo "$expected") <(echo "$map") | tr '\n' ' ')"
  fi
  return $(result)
}
test.case - "T-PROFILE-STATE-34: root.profile.dropin.installed is state 34 and nothing else moves" \
  test.oo.stateMachineNumbering
expect 0 "state 34 registered, no state renumbered" \
  "state numbers are hard-coded in comments across oo and ossh — they must not shift"


# ============================================================================
# T-PROFILE-FIX / T-PROFILE-STATUS — the repair primitive and its report
# ============================================================================
# The state-machine declaration is FROZEN per host at first install
# (state.machine.init writes the array once; oo.state() re-creates the machine
# only when it does not exist). So no already-installed host will EVER see
# state 34 — `oo profile.fix` is the only path onto those machines. It is not a
# convenience.

# --- T-PROFILE-PATH-SUDO-GET --------------------------------------------------------
# The one privilege rule: writable -> no prefix; missing under a writable
# parent -> no prefix; under a directory this user cannot write -> $SUDO
# (which is "" for root, so root never gets a prefix either).
test.oo.pathSudoGet() {
  local fixture bad=""
  fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.sudoget.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  mkdir -p "$fixture/ro"; chmod 500 "$fixture/ro"
  [ "$(private.oo.path.sudo.get "$fixture")" = "" ] || bad="$bad writable-got-prefix"
  [ "$(private.oo.path.sudo.get "$fixture/new")" = "" ] || bad="$bad missing-under-writable-got-prefix"
  [ "$(private.oo.path.sudo.get "$fixture/ro/new")" = "$SUDO" ] || bad="$bad unwritable-parent=>'$(private.oo.path.sudo.get "$fixture/ro/new")'"
  chmod 700 "$fixture/ro"; rm -rf "$fixture"
  if [ -z "$bad" ]; then
    create.result 0 "sudo prefix follows writability and \$SUDO"
  else
    create.result 1 "private.oo.path.sudo.get wrong:$bad"
  fi
  return $(result)
}
test.case - "T-PROFILE-PATH-SUDO-GET: private.oo.path.sudo.get prefixes only what this user cannot write" \
  test.oo.pathSudoGet
expect 0 "sudo prefix follows writability and \$SUDO" \
  "oo profile.fix and private.oo.profile.dropin.ensure must share ONE privilege rule, built on \$SUDO"

# --- T-PROFILE-FIX-CREATES-DROPIN ---------------------------------------------------
# Drives the real method against a writable fixture <profileDir>: it must land
# the drop-in, and the drop-in must be the template.
test.oo.profileFixCreatesDropIn() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profilefix) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  # A FIXTURE <profileDir> on purpose: with the default the method would aim at
  # the host's real /etc/profile.d and ask a non-root runner for a sudo
  # password — a core test must never do that.
  oo.profile.fix "$fixture/profile.d" >/dev/null 2>&1
  local rc=$? dropIn="$fixture/profile.d/oosh.sh"
  if [ "$rc" -ne 0 ]; then
    create.result 1 "oo.profile.fix rc=$rc"
  elif [ ! -f "$dropIn" ]; then
    create.result 1 "$dropIn was not created ($(ls -la "$fixture/profile.d" 2>&1 | tr '\n' ' '))"
  elif ! diff -q "$dropIn" "$OOSH_DIR/templates/user/profile.d.oosh.sh" >/dev/null 2>&1; then
    create.result 1 "drop-in is not the template: $(diff "$OOSH_DIR/templates/user/profile.d.oosh.sh" "$dropIn" | head -3 | tr '\n' ' ')"
  else
    create.result 0 "profile.fix landed the login-shell drop-in"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-FIX-CREATES-DROPIN: oo profile.fix writes <profileDir>/oosh.sh from the template" \
  test.oo.profileFixCreatesDropIn
expect 0 "profile.fix landed the login-shell drop-in" \
  "the frozen-per-host state machine means profile.fix is the ONLY path onto existing machines"

# --- T-PROFILE-FIX-FAILS-LOUD -------------------------------------------------------
# $SUDO internally, one command for root and for a dev member with sudo — and
# if NEITHER applies it must fail loudly naming what it needed, never
# half-succeed. PATH=/nonexistent removes sudo from reach; the fixture dir is
# mode 500 so the write genuinely needs privilege.
test.oo.profileFixFailsLoudWithoutPrivilege() {
  if [ "$(id -u)" = "0" ]; then
    create.result 0 "missing privilege reported loudly"   # root always has it
    return $(result)
  fi
  local fixture; fixture=$(test.suite.fixture.make test.oo.profilefix.loud) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  # The DROP-IN DIRECTORY is what must be unwritable: private.oo.path.sudo.get
  # probes <profileDir> itself (it exists), not its parent. A mode-500 parent
  # around a writable profile.d would need no privilege at all and the case
  # would prove nothing.
  chmod 500 "$fixture/profile.d"
  local out rc
  out=$( ( PATH=/nonexistent; oo.profile.fix "$fixture/profile.d" ) 2>&1 )
  rc=$?
  chmod 700 "$fixture/profile.d" 2>/dev/null
  if [ "$rc" -eq 0 ]; then
    create.result 1 "returned 0 with neither root nor sudo — half-success"
  elif [ -e "$fixture/profile.d/oosh.sh" ]; then
    create.result 1 "created a drop-in despite failing"
  elif ! echo "$out" | grep -q 'root'; then
    create.result 1 "failure message does not name what it needed: $out"
  elif ! echo "$out" | grep -q 'sudo'; then
    create.result 1 "failure message does not mention sudo: $out"
  else
    create.result 0 "missing privilege reported loudly"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-FIX-FAILS-LOUD: neither root nor sudo fails loudly, naming both" \
  test.oo.profileFixFailsLoudWithoutPrivilege
expect 0 "missing privilege reported loudly" \
  "it must never half-succeed (T9 decision 4)"

# --- T-PROFILE-FIX-FATAL-USES-BARE-ECHO ---------------------------------------------
# Doctrine guard, mirroring the bare-echo tests in test.promote and
# test.ossh.certificates.update. error.log routes to $LOG_DEVICE, so a
# fatal instruction emitted through it VANISHES whenever LOG_DEVICE is a file,
# /dev/null, or a non-tty CI run — the caller gets a bare non-zero exit and no
# idea what to do. This is not hypothetical: the privilege message shipped as
# error.log and was invisible to every container user in the platform run,
# while still printing on the developer's terminal, so it passed locally and
# failed in CI. Guards against a future "uniform log routing" refactor.
test.case - "T-PROFILE-FIX-FATAL-USES-BARE-ECHO: the privilege failure survives any LOG_DEVICE" \
  true
if type oo.profile.fix 2>/dev/null | grep 'needs root' | grep -qE '^[[:space:]]*echo '; then
  expect.pass "fatal privilege line uses bare \`echo\` — survives every LOG_LEVEL / LOG_DEVICE"
else
  expect.fail "'needs root' line must use bare \`echo\` (not error.log) per [status-command-output-idiom]"
fi

# --- T-PROFILE-STATUS-ECHOES-AT-LOG-LEVEL-1 -----------------------------------------
# The repo's status-command idiom: a user-invoked .status method emits its
# ANSWER on plain stdout, never gated behind console.log / important.log —
# otherwise `oo profile.status` is silent at the log level CI and installs use.
test.oo.profileStatusEchoesAtLevel1() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profilestatus) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  local prof="$fixture/profile.d"
  oo.profile.fix "$prof" >/dev/null 2>&1
  local saved=$LOG_LEVEL out rc
  log.level 1 >/dev/null 2>&1
  out=$(oo.profile.status "$prof" 2>/dev/null); rc=$?
  log.level $saved >/dev/null 2>&1
  if [ -z "$out" ]; then
    create.result 1 "no stdout at LOG_LEVEL=1 — the answer is gated behind a log function"
  elif [ "$rc" -ne 0 ]; then
    create.result 1 "healthy drop-in reported rc=$rc: $out"
  elif ! echo "$out" | grep -Fq "$prof/oosh.sh"; then
    create.result 1 "report does not name the drop-in: $out"
  elif ! echo "$out" | grep -q 'OK'; then
    create.result 1 "report does not state the drop-in is OK: $out"
  else
    create.result 0 "status reports on stdout at log level 1"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-STATUS-ECHOES-AT-LOG-LEVEL-1: the answer goes to plain stdout" \
  test.oo.profileStatusEchoesAtLevel1
expect 0 "status reports on stdout at log level 1" \
  "status answers are echo, not console.log (repo idiom)"

# --- T-PROFILE-STATUS-READ-ONLY -----------------------------------------------------
test.oo.profileStatusIsReadOnly() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profilestatus.ro) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  local before after out rc
  before=$(find "$fixture" | sort)
  out=$(oo.profile.status "$fixture/profile.d" 2>/dev/null)
  rc=$?
  after=$(find "$fixture" | sort)
  if [ "$before" != "$after" ]; then
    create.result 1 "status MUTATED the tree: $(diff <(echo "$before") <(echo "$after") | tr '\n' ' ')"
  elif [ "$rc" -eq 0 ]; then
    create.result 1 "reported rc=0 for a MISSING drop-in"
  elif ! echo "$out" | grep -q 'profile.fix'; then
    create.result 1 "missing drop-in reported without the recovery command: $out"
  else
    create.result 0 "status is read-only and names the recovery command"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-STATUS-READ-ONLY: reports a missing drop-in without creating it" \
  test.oo.profileStatusIsReadOnly
expect 0 "status is read-only and names the recovery command" \
  "a report must diagnose, never repair — repair is the explicit oo profile.fix"


# ============================================================================
# T-PROFILE-DROPIN / T-PROFILE-CONTENT — the file itself
# ============================================================================

# --- T-PROFILE-DROPIN-CREATED -------------------------------------------------------
# The file must END IN .sh — /etc/profile has `for i in /etc/profile.d/*.sh`,
# so any other name is never read and the whole route silently does nothing.
test.oo.profileDropInCreated() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profiledropin.create) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  local prof="$fixture/profile.d"
  private.oo.profile.dropin.ensure "$prof" >/dev/null 2>&1
  local rc=$? dropIn="$prof/oosh.sh" mode=""
  [ -f "$dropIn" ] && mode=$(ls -l "$dropIn" 2>/dev/null | cut -c1-10)
  local matched=no
  # exactly the glob /etc/profile reads — not a name that merely looks right
  local g; for g in "$prof"/*.sh; do [ "$g" = "$dropIn" ] && matched=yes; done
  if [ "$rc" -ne 0 ]; then
    create.result 1 "helper returned rc=$rc"
  elif [ ! -f "$dropIn" ]; then
    create.result 1 "no drop-in at $dropIn (dir: $(ls -la "$prof" 2>&1 | tr '\n' ' '))"
  elif [ "$matched" != "yes" ]; then
    create.result 1 "$dropIn is not matched by /etc/profile's own \`*.sh\` glob — it would never be read"
  elif ! grep -Fq 'config/user.env' "$dropIn"; then
    create.result 1 "drop-in does not source ~/config/user.env: $(cat "$dropIn")"
  elif [ "$mode" != "-rw-r--r--" ]; then
    create.result 1 "drop-in mode is '$mode', expected -rw-r--r-- (644) — every login shell must be able to read it"
  else
    create.result 0 "login-shell drop-in created"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-DROPIN-CREATED: state 34 / oo profile.fix lands <profileDir>/oosh.sh" \
  test.oo.profileDropInCreated
expect 0 "login-shell drop-in created" \
  "without it \`env -i sh -l\` still cannot bootstrap oosh (/etc/profile has no oosh line)"

# --- T-PROFILE-SKIPS-WITHOUT-PROFILE-DIR --------------------------------------------
# macOS has NO /etc/profile.d: its /etc/profile runs path_helper and sources
# /etc/bashrc, and globs nothing. Creating the directory there would be inert,
# so absence is a GRACEFUL SKIP — rc 0, nothing created.
test.oo.profileSkipsWithoutProfileDir() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profiledropin.nodir) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture"
  local prof="$fixture/profile.d"
  private.oo.profile.dropin.ensure "$prof" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "absent $prof must SKIP (rc=0), got rc=$rc — state 34 would halt on every macOS host"
  elif [ -e "$prof" ]; then
    create.result 1 "created $prof although the host has none — a drop-in there is inert on macOS"
  else
    create.result 0 "no profile.d means a graceful skip"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-SKIPS-WITHOUT-PROFILE-DIR: macOS has no /etc/profile.d — skip, do not fail" \
  test.oo.profileSkipsWithoutProfileDir
expect 0 "no profile.d means a graceful skip" \
  "the login route is Linux-only; its absence must never halt state 34"

# --- T-PROFILE-CONTENT-FROM-TEMPLATE ------------------------------------------------
# The drop-in is a managed file, so its content is a TEMPLATE
# (templates/user/profile.d.oosh.sh) like bashrcTemplate and ooShim — never a
# heredoc in code. Nothing is substituted any more: the boot data is at a
# $HOME-relative path, so the emitted bytes ARE the template's bytes.
test.oo.profileContentFromTemplate() {
  local template="$OOSH_DIR/templates/user/profile.d.oosh.sh" tmp
  if [ ! -r "$template" ]; then
    create.result 1 "template missing: $template"; return $(result)
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/test.oo.profilecontent.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  private.oo.profile.content.get > "$tmp" 2>/dev/null
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"; create.result 1 "private.oo.profile.content.get emitted nothing"; return $(result)
  fi
  if ! diff -q "$tmp" "$template" >/dev/null 2>&1; then
    create.result 1 "emitted content is not byte-equal to the template: $(diff "$template" "$tmp" | head -3 | tr '\n' ' ')"
  elif grep -q '@SYSTEM_PATH@' "$tmp"; then
    create.result 1 "a @SYSTEM_PATH@ placeholder survives — there is no path to substitute any more"
  else
    create.result 0 "drop-in content is the template, byte for byte"
  fi
  rm -f "$tmp"
  return $(result)
}
test.case - "T-PROFILE-CONTENT-FROM-TEMPLATE: the drop-in IS templates/user/profile.d.oosh.sh, unsubstituted" \
  test.oo.profileContentFromTemplate
expect 0 "drop-in content is the template, byte for byte" \
  "managed files oosh writes come from templates/user/, never from heredocs in code"

# --- T-PROFILE-CONTENT-IS-POSIX -----------------------------------------------------
# It is read by /bin/sh on every login.
test.oo.profileContentIsPosix() {
  local tmp bad=""; tmp=$(mktemp "${TMPDIR:-/tmp}/test.oo.profilelint.XXXXXX") || { create.result 1 "mktemp failed"; return 1; }
  private.oo.profile.content.get > "$tmp" 2>/dev/null
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"; create.result 1 "private.oo.profile.content.get emitted nothing"
    return $(result)
  fi
  sh    -n "$tmp" 2>/dev/null || bad="$bad sh:$(sh -n "$tmp" 2>&1 | head -1)"
  if command -v dash >/dev/null 2>&1; then
    dash -n "$tmp" 2>/dev/null || bad="$bad dash:$(dash -n "$tmp" 2>&1 | head -1)"
  fi
  if command -v busybox >/dev/null 2>&1; then
    busybox ash -n "$tmp" 2>/dev/null || bad="$bad ash:$(busybox ash -n "$tmp" 2>&1 | head -1)"
  fi
  bash  -n "$tmp" 2>/dev/null || bad="$bad bash:$(bash -n "$tmp" 2>&1 | head -1)"
  # `-n` ALONE IS NOT ENOUGH, and that is measured, not assumed: a planted
  # `[[ -r … ]]` sails through `dash -n`, because `[[` is a perfectly valid
  # COMMAND NAME to dash — it only blows up at run time with "[[: not found".
  # So the common bashisms are grepped for explicitly — in the CODE only. The
  # header of this file is prose about the code ("neither file may source a
  # shared helper"), and a comment cannot be a bashism.
  local bashisms='(^|[[:space:];&|(])(\[\[|\(\(|local|source|declare|typeset)([[:space:]]|$)'
  if grep -vE '^[[:space:]]*#' "$tmp" | grep -Eq "$bashisms"; then
    bad="$bad bashism:$(grep -vE '^[[:space:]]*#' "$tmp" | grep -nE "$bashisms" | head -1)"
  fi
  rm -f "$tmp"
  if [ -z "$bad" ]; then
    create.result 0 "drop-in parses as POSIX sh in every shell"
  else
    create.result 1 "drop-in lint failed —$bad"
  fi
  return $(result)
}
test.case - "T-PROFILE-CONTENT-IS-POSIX: parses under sh/dash/ash/bash with no bashisms" \
  test.oo.profileContentIsPosix
expect 0 "drop-in parses as POSIX sh in every shell" \
  "this file runs for EVERY login on the box — a parse error breaks logins"

# --- T-PROFILE-CONTENT-IS-GUARDED ---------------------------------------------------
# The behavioural contract plus the two structural rules that keep a login
# alive. This runs for every login shell on the host, including users who have
# never heard of oosh.
#   1. HOME unset (`env -i sh -l`, the case this route EXISTS for) -> HOME is
#      derived from the password database, then ~/config/user.env is sourced.
#   2. HOME set and the user HAS ~/config/user.env -> anchors recovered.
#   3. HOME set and the user has NO ~/config/user.env -> left exactly as found.
#      Without this guard every non-oosh user on the box would grow a
#      nonexistent ~/oosh on PATH just for logging in.
#   4. Structurally: the source line is behind a `[ -f … ]` test, and there is
#      no `exit` (it would CLOSE the login shell) and no `return` (not every
#      /etc/profile sources this from a function) anywhere outside a comment.
test.oo.profileContentIsGuarded() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profileguard) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  local prof="$fixture/profile.d"
  private.oo.profile.dropin.ensure "$prof" >/dev/null 2>&1
  local dropIn="$prof/oosh.sh" bad="" out
  local probe='echo "<[$HOME|$OOSH_DIR]>"'

  # 4a. the source line is GUARDED by a `[ -f ]` test on the same file.
  grep -Eq '\[ -f "\$HOME/config/user\.env" \]' "$dropIn" \
    || bad="$bad source-not-behind-[-f]"
  # 4b. no `exit`, no `return` outside comments. Single-quoted spans are
  #     stripped first: `awk '… ; exit }'` is an AWK keyword inside an awk
  #     program, not a shell command, and a shell `exit`/`return` can never
  #     live inside single quotes.
  if grep -vE '^[[:space:]]*#' "$dropIn" | sed "s/'[^']*'//g" | grep -Ewq 'return|exit'; then
    bad="$bad contains-exit-or-return:$(grep -vE '^[[:space:]]*#' "$dropIn" | sed "s/'[^']*'//g" | grep -Ewn 'return|exit' | head -1)"
  fi

  # 1. HOME unset — the drop-in must recover it from the password database.
  #    Compared against the PASSWD home, not the runner's $HOME (they differ
  #    under sudo without -H).
  local pwHome
  pwHome=$(test.suite.home.passwd)
  out=$(cd /tmp && env -i sh -c ". $dropIn; $probe" 2>&1 | grep -o '<\[[^]]*\]>' | tail -1)
  [ "$out" = "<[$pwHome|$pwHome/oosh]>" ] || bad="$bad home-unset=>$out"

  # 2. HOME set, user HAS ~/config/user.env (this test's own user).
  if [ -f "$HOME/config/user.env" ]; then
    out=$(cd /tmp && env -i HOME="$HOME" sh -c ". $dropIn; $probe" 2>&1 | grep -o '<\[[^]]*\]>' | tail -1)
    [ "$out" = "<[$HOME|$HOME/oosh]>" ] || bad="$bad oosh-user=>$out"
  fi

  # 3. HOME set, NO ~/config/user.env — must be left exactly as found.
  local stranger="$fixture/stranger"
  mkdir -p "$stranger"
  out=$(cd /tmp && env -i HOME="$stranger" sh -c ". $dropIn; $probe" 2>&1 | grep -o '<\[[^]]*\]>' | tail -1)
  [ "$out" = "<[$stranger|]>" ] || bad="$bad non-oosh-user=>$out"
  [ -e "$stranger/.config/oosh" ] && bad="$bad littered:$stranger/.config/oosh"

  rm -rf "$fixture" 2>/dev/null
  if [ -z "$bad" ]; then
    create.result 0 "drop-in is guarded on the file and on the caller"
  else
    create.result 1 "guard broken —$bad"
  fi
  return $(result)
}
test.case - "T-PROFILE-CONTENT-IS-GUARDED: never breaks a login, never touches a non-oosh user" \
  test.oo.profileContentIsGuarded
expect 0 "drop-in is guarded on the file and on the caller" \
  "a host-wide login hook that assumes oosh would junk every other user's PATH and home"

# --- T-PROFILE-BARE-SH-CANNOT-SELF-RECOVER ----------------------------------------
# The negative half of the claim docs/repair-toolkit.md makes: a NON-login
# `env -i sh` reads no /etc/profile, so the drop-in cannot reach it and nothing
# else can either — $ENV is a non-login POSIX sh's only rc hook and `env -i`
# is what erased it. Pinned so the docs cannot drift into promising more than
# the login route delivers (the old platform INVARIANT-6 pinned this; it went
# with that file).
test.oo.bareShCannotSelfRecover() {
  local out
  out=$(cd /tmp && env -i sh -c 'echo "[$OOSH_DIR|$CONFIG_PATH]"' 2>/dev/null)
  if [ "$out" = "[|]" ]; then
    create.result 0 "a bare env -i sh comes up with no anchors — only the login route recovers"
  else
    create.result 1 "a bare env -i sh came up anchored ($out) — some rc file is reaching it; the docs' claim is stale"
  fi
  return $(result)
}
test.case - "T-PROFILE-BARE-SH-CANNOT-SELF-RECOVER: env -i sh (non-login) has no anchors — only env -i sh -l recovers" \
  test.oo.bareShCannotSelfRecover
expect 0 "a bare env -i sh comes up with no anchors — only the login route recovers" \
  "docs/repair-toolkit.md states it; nothing pinned it since the old platform INVARIANT-6 went"

# --- T-PROFILE-CONTENT-RECOVERS-HOME ------------------------------------------------
# The one thing this file exists for, asserted against the TEMPLATE itself
# rather than a written fixture: `env -i` drops HOME, and the drop-in derives
# it (getent -> dscl -> /etc/passwd) before anything else. Second half: with an
# unusable PATH every lookup fails, and the fall-through must be SILENT and
# NON-FATAL — a shell that exits or returns here closes somebody's login.
test.oo.profileContentRecoversHome() {
  local template="$OOSH_DIR/templates/user/profile.d.oosh.sh" bad="" out pwHome
  pwHome=$(test.suite.home.passwd)
  out=$(cd /tmp && env -i PATH=/usr/bin:/bin /bin/sh -c ". $template; echo \"[\$HOME]\"" 2>&1 | tail -1)
  [ "$out" = "[$pwHome]" ] || bad="$bad recovery=>$out"
  # /bin/sh by ABSOLUTE path: with PATH=/nonexistent, `env` itself could not
  # find a bare `sh` and the case would prove nothing.
  out=$(cd /tmp && env -i PATH=/nonexistent /bin/sh -c ". $template; echo ALIVE" 2>&1 | tail -1)
  [ "$out" = "ALIVE" ] || bad="$bad unusable-PATH=>$out"
  if [ -z "$bad" ]; then
    create.result 0 "drop-in recovers HOME and never aborts the shell"
  else
    create.result 1 "HOME recovery broken —$bad"
  fi
  return $(result)
}
test.case - "T-PROFILE-CONTENT-RECOVERS-HOME: derives \$HOME under env -i, and survives an unusable PATH" \
  test.oo.profileContentRecoversHome
expect 0 "drop-in recovers HOME and never aborts the shell" \
  "every anchor hangs off \$HOME, and a login shell must survive a failed lookup"

# --- T-PROFILE-IDEMPOTENT -----------------------------------------------------------
test.oo.profileIdempotent() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profileidem) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  local prof="$fixture/profile.d"
  private.oo.profile.dropin.ensure "$prof" >/dev/null 2>&1
  local first; first=$(cat "$prof/oosh.sh" 2>/dev/null; ls -l "$prof" 2>/dev/null)
  private.oo.profile.dropin.ensure "$prof" >/dev/null 2>&1
  local rc=$? second; second=$(cat "$prof/oosh.sh" 2>/dev/null; ls -l "$prof" 2>/dev/null)
  if [ "$rc" -ne 0 ]; then
    create.result 1 "second call returned rc=$rc"
  elif [ ! -s "$prof/oosh.sh" ]; then
    # Without this, "nothing == nothing" would make the comparison below pass
    # while no drop-in was ever written. Two absences are not idempotence.
    create.result 1 "no drop-in to be idempotent about at $prof/oosh.sh"
  elif [ "$first" != "$second" ]; then
    create.result 1 "second call changed the drop-in"
  else
    create.result 0 "drop-in write is a no-op on re-run"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-IDEMPOTENT: re-running state 34 rewrites the same file" \
  test.oo.profileIdempotent
expect 0 "drop-in write is a no-op on re-run" \
  "state 34 re-runs on every re-install, and oo profile.fix is run by hand"

# --- T-PROFILE-STATUS-REPORTS -------------------------------------------------------
# `oo profile.status` is the read-only report; a missing OR stale drop-in must
# be visible, or a broken login route stays invisible until someone needs
# `env -i sh -l` in anger.
test.oo.profileStatusReports() {
  local fixture; fixture=$(test.suite.fixture.make test.oo.profilestatus.rep) || { create.result 1 "mktemp failed"; return 1; }
  rm -rf "$fixture"; mkdir -p "$fixture/profile.d"
  local prof="$fixture/profile.d"
  oo.profile.fix "$prof" >/dev/null 2>&1
  local saved=$LOG_LEVEL out rc out2 rc2 out3 rc3
  log.level 1 >/dev/null 2>&1
  out=$(oo.profile.status "$prof" 2>/dev/null); rc=$?
  # STALE: present, but not the oosh drop-in (a host healed by the old T9).
  echo '# something else entirely' > "$prof/oosh.sh"
  out2=$(oo.profile.status "$prof" 2>/dev/null); rc2=$?
  # MISSING
  rm -f "$prof/oosh.sh"
  out3=$(oo.profile.status "$prof" 2>/dev/null); rc3=$?
  log.level $saved >/dev/null 2>&1
  if [ "$rc" -ne 0 ]; then
    create.result 1 "healthy host reported rc=$rc: $out"
  elif ! echo "$out" | grep -Fq "$prof/oosh.sh"; then
    create.result 1 "report does not name the drop-in: $out"
  elif [ "$rc2" -eq 0 ]; then
    create.result 1 "a STALE drop-in reported healthy (rc=0): $out2"
  elif ! echo "$out2" | grep -q 'STALE'; then
    create.result 1 "a stale drop-in was not reported as STALE: $out2"
  elif [ "$rc3" -eq 0 ]; then
    create.result 1 "a MISSING drop-in reported healthy (rc=0): $out3"
  elif ! echo "$out3" | grep -q 'profile.fix'; then
    create.result 1 "missing drop-in reported without the recovery command: $out3"
  else
    create.result 0 "status separates OK, STALE and MISSING"
  fi
  rm -rf "$fixture" 2>/dev/null
  return $(result)
}
test.case - "T-PROFILE-STATUS-REPORTS: oo profile.status tells OK, STALE and MISSING apart" \
  test.oo.profileStatusReports
expect 0 "status separates OK, STALE and MISSING" \
  "a host healed by the old T9 has a drop-in that sources /etc/oosh/boot — that must read STALE, not OK"

# ============================================================================
# T-CMD-* — oo.cmd's result contract
# ============================================================================
# oo.cmd reported success unconditionally: its last statement was a bare
# `RETURN=$1` assignment, so its exit status was that of a variable assignment
# — always 0, whatever the package manager did. `oo cmd mc` shelled out and
# reported success when the package did not exist, the network was down, sudo
# was denied, or OOSH_PM was empty. Three callers check the status and could
# never fire.
#
# Driven through a PATH shim that LOGS ITS ARGV, so "the PM was never invoked"
# is an assertion with a diagnostic rather than a bare sentinel. OOSH_PM is
# pinned in every case: left empty, oo.cmd calls oo.pm.discover, which does a
# real `config save` and on apt hosts a real `apt-get update`.
# CONFIG_PATH is passed through from this file's fixture (test.suite.config.isolate
# at the top), never env -i'd away, so the child cannot reach the shared tier.

test.oo.cmd.fixture() { # <stubDir> # a fake package manager that records every call and exits $PM_RC
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' 'exit ${PM_RC:-0}' > "$1/fakepm"
  chmod +x "$1/fakepm"
}

test.oo.cmd.fixture.apt() { # <stubDir> # a fake apt-get that records its ARGV *and* the debconf-relevant env
  # Named apt-get on purpose, so `case "$OOSH_PM" in apt-get*)` inside oo.cmd
  # actually fires — the fakepm stub the other T-CMD cases pin deliberately
  # does not match it, which is why this needs its own stub rather than a
  # tweak to test.oo.cmd.fixture (six cases depend on that one unchanged).
  printf '%s\n' '#!/bin/sh' \
    'echo "argv=$*" >> "$PM_LOG"' \
    'echo "DEBIAN_FRONTEND=[${DEBIAN_FRONTEND-unset}]" >> "$PM_LOG"' \
    'exit ${PM_RC:-0}' > "$1/apt-get"
  chmod +x "$1/apt-get"
}

test.oo.cmd.fixture.brew() { # <stubDir> # a fake brew that records its ARGV *and* HOMEBREW_NO_ASK
  # Named brew on purpose: oo.cmd's brew branch calls `brew install` by name,
  # not through $OOSH_PM, so only a stub called brew is ever reached.
  printf '%s\n' '#!/bin/sh' \
    'echo "argv=$*" >> "$PM_LOG"' \
    'echo "HOMEBREW_NO_ASK=[${HOMEBREW_NO_ASK-unset}]" >> "$PM_LOG"' \
    'exit ${PM_RC:-0}' > "$1/brew"
  chmod +x "$1/brew"
}

test.oo.cmd.run() { # <stubDir> <pmRc> <noPm> <args...> # run oo.cmd in a pinned child; echo "rc|RESULT"
  local stub="$1" pmRc="$2" noPm="$3"; shift 3
  local pmPin='OOSH_PM="fakepm install"'
  [ "$noPm" = "noPm" ] && pmPin='OOSH_PM=""; oo.pm.discover() { :; }'
  [ "$noPm" = "aptPm" ] && pmPin='OOSH_PM="apt-get -y install"'
  # SUDO_USER unset pins oo.cmd's direct brew branch. With it set (root's leg
  # of the platform test) oo.cmd hops through `sudo -u`, whose secure_path
  # drops $stub from PATH and the fake brew is never reached.
  [ "$noPm" = "brewPm" ] && pmPin='OOSH_PM="brew install"; unset SUDO_USER'
  # TEST_OO_CMD_OVERRIDE, when set, is spliced in AFTER the real oo is sourced.
  # The negative controls below use it to plant the ORIGINAL defect as an
  # oo.cmd override and prove the test function above catches it.
  env PATH="$stub:$PATH" HOME="$HOME" LOG_LEVEL=0 SUDO="" \
      PM_LOG="$stub/pm.calls" PM_RC="$pmRc" \
      CONFIG_PATH="$CONFIG_PATH" CONFIG="$CONFIG" CONFIG_FILE="$CONFIG_FILE" \
      bash -c '
        source "$OOSH_DIR/this" >/dev/null 2>&1
        source "$OOSH_DIR/oo"   >/dev/null 2>&1
        '"$pmPin"'
        '"${TEST_OO_CMD_OVERRIDE:-:}"'
        oo.cmd "$@" >/dev/null 2>&1
        printf "%s|%s" "$?" "$RESULT"' _ "$@"
}

test.oo.cmd.control() { # <caseName> <plantedOverride> <testFunction> <expectedFailurePrefix> # negative control: with the defect planted as an oo.cmd override, the test function must FAIL with the named diagnosis
  # Runs its own test.case + expect (the T-OSSH-PREREQS-* idiom) because
  # test.case word-splits $testArguments — a quoted override with spaces cannot
  # travel through it as one argument.
  local name="$1" fn="$3" want="$4" rc res
  test.case $level "$name" echo "(negative control: plant the original defect, expect the test above to catch it)"
  TEST_OO_CMD_OVERRIDE="$2"
  $fn; rc=$?; res="$RESULT"
  unset TEST_OO_CMD_OVERRIDE
  if [ "$rc" -ne 0 ] && [ "${res#"$want"}" != "$res" ]; then
    expect.pass "control caught: $want"
  else
    expect.fail "planted defect NOT caught by $fn (rc=$rc RESULT=[$res])"
  fi
}

# --- T-CMD-PM-FAILS ---------------------------------------------------------
test.oo.cmdPmFails() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.fail.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  local got; got=$(test.oo.cmd.run "$stub" 1 withPm ooshNoSuchTool)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "reported success though the package manager exited 1 (RESULT=[$res])"
  elif [ "${res#*ooshNoSuchTool}" = "$res" ]; then
    create.result 1 "failed but \$RESULT does not name the tool: [$res]"
  else
    create.result 0 "a failing package manager is reported"
  fi
  return $(result)
}
test.case $level "T-CMD-PM-FAILS: a failing package manager is reported, and names the tool" \
  test.oo.cmdPmFails
expect 0 "a failing package manager is reported" \
  "oo cmd reported success unconditionally — three callers check its status and could never fire"

# --- T-CMD-VERIFY-AFTER-INSTALL --------------------------------------------
test.oo.cmdVerifyAfterInstall() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.verify.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  # PM exits 0 but installs nothing — the command is still absent afterwards
  local got; got=$(test.oo.cmd.run "$stub" 0 withPm ooshNoSuchTool)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "package manager said OK and the command is still absent, but oo.cmd reported success (RESULT=[$res])"
  else
    create.result 0 "installing without landing the command is a failure"
  fi
  return $(result)
}
test.case $level "T-CMD-VERIFY-AFTER-INSTALL: PM says OK but the command is still missing" \
  test.oo.cmdVerifyAfterInstall
expect 0 "installing without landing the command is a failure" \
  "the post-condition oo.cmd's own comment deferred to ossh.prereqs.install for"

# --- T-CMD-ALREADY-PRESENT --------------------------------------------------
test.oo.cmdAlreadyPresent() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.present.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  local got; got=$(test.oo.cmd.run "$stub" 0 withPm sh)
  local rc="${got%%|*}"
  local calls=""; [ -s "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ -n "$calls" ]; then
    create.result 1 "invoked the package manager for an already-present command: [$calls]"
  elif [ "$rc" != "0" ]; then
    create.result 1 "an already-present command reported rc=$rc"
  else
    create.result 0 "already present is success, PM never invoked"
  fi
  return $(result)
}
test.case $level "T-CMD-ALREADY-PRESENT: no work, no package manager, rc 0" \
  test.oo.cmdAlreadyPresent
expect 0 "already present is success, PM never invoked" \
  "idempotency is the documented contract — every caller relies on it"

# --- T-CMD-NO-PM ------------------------------------------------------------
test.oo.cmdNoPm() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.nopm.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  local got; got=$(test.oo.cmd.run "$stub" 0 noPm ooshNoSuchTool)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "no package manager at all, yet reported success (RESULT=[$res])"
  else
    create.result 0 "no package manager is a failure"
  fi
  return $(result)
}
test.case $level "T-CMD-NO-PM: nothing can be installed, so nothing succeeded" \
  test.oo.cmdNoPm
expect 0 "no package manager is a failure" \
  "it used to console.log 'no package manger' and exit 0"

# --- T-CMD-TWO-ARG ----------------------------------------------------------
test.oo.cmdTwoArg() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.twoarg.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  # <cmd> <packageName> — the documented two-argument form
  test.oo.cmd.run "$stub" 0 withPm ooshNoSuchTool ooshNoSuchPackage >/dev/null
  local calls=""; [ -f "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ "${calls#*ooshNoSuchPackage}" = "$calls" ]; then
    create.result 1 "the package name never reached the package manager: [$calls]"
  else
    create.result 0 "the package name reaches the package manager"
  fi
  return $(result)
}
test.case $level "T-CMD-TWO-ARG: oo.cmd <cmd> <packageName> installs the PACKAGE" \
  test.oo.cmdTwoArg
expect 0 "the package name reaches the package manager" \
  "the second argument was shifted away and lost — ossh:1933 installs nothing today"

# --- T-CMD-APT-NONINTERACTIVE -----------------------------------------------
# `oo cmd vim` on a naked ubuntu:24.04 hung forever: apt pulled tzdata, and
# tzdata's debconf postinst blocked in anon_pipe_read waiting for an answer to
# "Geographic area:" that no unattended installer can give. The install wedged
# with no output after "no vim", and a 5-minute watcher timed out rather than
# ever seeing the end banner.
#
# `-y` does not cover this — -y answers apt's own prompt, debconf is a separate
# questioner inside the maintainer script. And the variable has to cross the
# sudo boundary via `env`: $SUDO is "sudo ", and sudo's env_reset drops a plain
# shell-assignment prefix, so `DEBIAN_FRONTEND=x $SUDO apt-get …` would never
# reach apt at all.
test.oo.cmdAptNonInteractive() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.apt.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture.apt "$stub"
  test.oo.cmd.run "$stub" 0 aptPm ooshNoSuchTool ooshNoSuchPackage >/dev/null
  local calls=""; [ -f "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ -z "$calls" ]; then
    create.result 1 "the apt-get stub was never invoked — the guard or the stub PATH is wrong"
  elif [ "${calls#*DEBIAN_FRONTEND=\[noninteractive\]}" = "$calls" ]; then
    create.result 1 "DEBIAN_FRONTEND did not reach apt — tzdata will hang the install: [$calls]"
  elif [ "${calls#*ooshNoSuchPackage}" = "$calls" ]; then
    create.result 1 "the env prefix swallowed the package name: [$calls]"
  else
    create.result 0 "an apt-like PM is invoked non-interactively, with the package intact"
  fi
  return $(result)
}
test.case $level "T-CMD-APT-NONINTERACTIVE: apt-like package managers are invoked with DEBIAN_FRONTEND set" \
  test.oo.cmdAptNonInteractive
expect 0 "an apt-like PM is invoked non-interactively, with the package intact" \
  "oo cmd vim wedged forever on tzdata's 'Geographic area' prompt in a naked ubuntu:24.04"

# --- T-CMD-BREW-NONINTERACTIVE ----------------------------------------------
# `brew install bash` on a virgin Sequoia tart VM stopped at "Do you want to
# proceed? [y/n]" and waited forever. Homebrew 6 made ask mode the default for
# install/upgrade/reinstall: it prompts when there is a TTY and the plan pulls
# in dependencies (bash does). HOMEBREW_NO_ASK=1 is the documented opt-out.
# NONINTERACTIVE=1 is NOT — only Homebrew's bootstrap install.sh reads it.
# GHA runners never saw this: they ship bash 5, so no brew install ran.
# Only the direct branch is exercised (the brewPm pin unsets SUDO_USER); the
# root -> `sudo -u $SUDO_USER` branch resets PATH, so no stub can reach it.
# Its init/oosh twin is pinned by grep in test/test.install instead.
test.oo.cmdBrewNonInteractive() {
  local stub; stub=$(test.suite.fixture.make test.oo.cmd.brew) \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture.brew "$stub"
  test.oo.cmd.run "$stub" 0 brewPm ooshNoSuchTool ooshNoSuchPackage >/dev/null
  local calls=""; [ -f "$stub/pm.calls" ] && calls=$(tr '\n' ' ' < "$stub/pm.calls")
  rm -rf "$stub" 2>/dev/null
  if [ -z "$calls" ]; then
    create.result 1 "the brew stub was never invoked — the guard or the stub PATH is wrong"
  elif [ "${calls#*HOMEBREW_NO_ASK=\[1\]}" = "$calls" ]; then
    create.result 1 "HOMEBREW_NO_ASK did not reach brew — a fresh macOS waits on 'proceed? [y/n]': [$calls]"
  elif [ "${calls#*ooshNoSuchPackage}" = "$calls" ]; then
    create.result 1 "the env prefix swallowed the package name: [$calls]"
  else
    create.result 0 "brew is invoked with ask mode off, with the package intact"
  fi
  return $(result)
}
test.case $level "T-CMD-BREW-NONINTERACTIVE: brew install runs with HOMEBREW_NO_ASK set" \
  test.oo.cmdBrewNonInteractive
expect 0 "brew is invoked with ask mode off, with the package intact" \
  "a fresh Sequoia install hung forever on brew's default ask-mode prompt"

# --- T-PM-ENV-GET -----------------------------------------------------------
# One table for the non-interactive prefix, shared by oo.cmd and
# oo.prereqs.install (init/oosh keeps a POSIX twin — it cannot source oo).
# A getter consumed as $(...), so it is judged on what it ECHOES: the
# method.new scaffold's `expect 0 "<value>"` compares $RESULT, which a getter
# never sets, and would pass whatever the table said.
test.oo.pmEnvGet() {
  local got bad=""
  got=$(private.oo.pm.env.get "apt-get -y install")
  [ "$got" = "env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1" ] || bad="$bad apt=[$got]"
  got=$(private.oo.pm.env.get "brew install")
  [ "$got" = "env HOMEBREW_NO_ASK=1" ] || bad="$bad brew=[$got]"
  got=$(private.oo.pm.env.get "apk add")
  [ -z "$got" ] || bad="$bad apk=[$got]"
  got=$(OOSH_PM="brew install"; private.oo.pm.env.get)
  [ "$got" = "env HOMEBREW_NO_ASK=1" ] || bad="$bad default=[$got]"
  if [ -n "$bad" ]; then
    create.result 1 "wrong prefix:$bad"
  else
    create.result 0 "apt and brew get their prefix, other PMs none, \$OOSH_PM is the default"
  fi
  return $(result)
}
test.case $level "T-PM-ENV-GET: private.oo.pm.env.get maps each PM to its non-interactive prefix" \
  test.oo.pmEnvGet
expect 0 "apt and brew get their prefix, other PMs none, \$OOSH_PM is the default" \
  "the prefix table lived in two places in oo and a third in init/oosh"

# --- T-PREREQS-BASH-NONINTERACTIVE -------------------------------------------
# oo.prereqs.install's bash-4 upgrade bypasses oo.cmd (whose existence check
# would no-op on macOS's /bin/bash 3.2), so it needs the prefix itself. The
# apt arm had none: the tzdata hang of 899358e, one function over. Structural,
# because the branch only runs under bash < 4 and BASH_VERSINFO is readonly.
test.oo.prereqsBashNonInteractive() {
  local body; body=$(declare -f oo.prereqs.install)
  local calls; calls=$(printf '%s\n' "$body" | grep -E '\$OOSH_PM bash')
  if [ -z "$calls" ]; then
    create.result 1 "no \$OOSH_PM bash call found — the test no longer sees the upgrade"
  elif printf '%s\n' "$calls" | grep -vq 'private.oo.pm.env.get'; then
    create.result 1 "a bash upgrade runs without the non-interactive prefix: $(printf '%s' "$calls" | tr '\n' ' ')"
  else
    create.result 0 "every PM arm of the bash upgrade takes its prefix from private.oo.pm.env.get"
  fi
  return $(result)
}
test.case $level "T-PREREQS-BASH-NONINTERACTIVE: oo.prereqs.install upgrades bash non-interactively on every PM" \
  test.oo.prereqsBashNonInteractive
expect 0 "every PM arm of the bash upgrade takes its prefix from private.oo.pm.env.get" \
  "the apt arm of the bash upgrade had no DEBIAN_FRONTEND — tzdata would hang it"

# --- T-CMD-DEAD-BRANCH ------------------------------------------------------
test.oo.cmdDeadBranch() {
  local stub; stub=$(mktemp -d "${TMPDIR:-/tmp}/test.oo.cmd.dead.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.oo.cmd.fixture "$stub"
  # mkcert delegates to once.su.mkcert.install, which is defined nowhere
  local got; got=$(test.oo.cmd.run "$stub" 0 withPm mkcert)
  local rc="${got%%|*}" res="${got#*|}"
  rm -rf "$stub" 2>/dev/null
  if [ "$rc" = "0" ]; then
    create.result 1 "a branch whose installer does not exist reported success (RESULT=[$res])"
  else
    create.result 0 "a branch that cannot work says so"
  fi
  return $(result)
}
test.case $level "T-CMD-DEAD-BRANCH: mkcert delegates to a command that does not exist" \
  test.oo.cmdDeadBranch
expect 0 "a branch that cannot work says so" \
  "once, private.stage and once.su.mkcert.install are defined nowhere in this tree"

# --- T-CMD-CONTROL-* — one negative control per T-CMD assertion ------------
# Each plants the ORIGINAL defect as an oo.cmd override in the same shim and
# asserts the test function above goes red with its specific diagnosis. A test
# nobody has watched fail is not a test (standing verification bar).
test.oo.cmd.control "T-CMD-CONTROL-PM-FAILS: a bare RETURN=\$1 tail (always rc 0) is caught" \
  'oo.cmd() { $OOSH_PM "$1"; RETURN=$1; }' \
  test.oo.cmdPmFails "reported success though the package manager exited 1"

test.oo.cmd.control "T-CMD-CONTROL-VERIFY: trusting the PM without re-verifying is caught" \
  'oo.cmd() { $OOSH_PM "$1" && create.result 0 "installed"; return $(result); }' \
  test.oo.cmdVerifyAfterInstall "package manager said OK and the command is still absent"

test.oo.cmd.control "T-CMD-CONTROL-PRESENT: dropping the already-present short-circuit is caught" \
  'oo.cmd() { $OOSH_PM "$1"; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdAlreadyPresent "invoked the package manager for an already-present command"

test.oo.cmd.control "T-CMD-CONTROL-NO-PM: the old console.log-and-exit-0 on a missing PM is caught" \
  'oo.cmd() { create.result 0 "no package manger"; return $(result); }' \
  test.oo.cmdNoPm "no package manager at all, yet reported success"

test.oo.cmd.control "T-CMD-CONTROL-TWO-ARG: the double shift that lost the package name is caught" \
  'oo.cmd() { shift; shift; $OOSH_PM "$1"; create.result 1 "x"; return $(result); }' \
  test.oo.cmdTwoArg "the package name never reached the package manager"

test.oo.cmd.control "T-CMD-CONTROL-DEAD-BRANCH: calling an undefined installer and reporting success is caught" \
  'oo.cmd() { once.su.mkcert.install; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdDeadBranch "a branch whose installer does not exist reported success"

test.oo.cmd.control "T-CMD-CONTROL-APT-INTERACTIVE: the bare \$SUDO \$OOSH_PM call that hung on tzdata is caught" \
  'oo.cmd() { $SUDO $OOSH_PM "$2"; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdAptNonInteractive "DEBIAN_FRONTEND did not reach apt"

test.oo.cmd.control "T-CMD-CONTROL-BREW-ASK: the bare brew install that hung on a fresh macOS is caught" \
  'oo.cmd() { brew install "$2"; create.result 0 "ok"; return $(result); }' \
  test.oo.cmdBrewNonInteractive "HOMEBREW_NO_ASK did not reach brew"

# ============================================================================
# T-METHOD-* — `oo method.new` actually produces a usable method
# ============================================================================
# The project mandates template-driven method creation
# (docs/first-principles.md, docs/command-creation.md), but every method in
# this tree is hand-written because the tool was half-broken: it shipped the
# template's placeholder docstring, mangled the usage table to
# `<method>------`, dropped every name segment after the second, and emitted
# no completion function. The docstring is the metadata this.help renders and
# c2 completes from, so a method born without it is broken by the project's
# own Method Structure Standard.

test.oo.method.probe.clean() { # <probe> # remove a throwaway script, its test, and any transaction leftovers
  rm -f "$OOSH_DIR/$1" "$OOSH_DIR/$1.new" "$OOSH_DIR/$1.bak" \
        "$OOSH_DIR/test/test.$1" "$OOSH_DIR/test/test.$1.new" "$OOSH_DIR/test/test.$1.bak" 2>/dev/null
}

test.oo.method.probe.make() { # <probe> # a throwaway script + test from the templates, via the real oo.new
  test.oo.method.probe.clean "$1"
  ( LOG_LEVEL=1 oo.new "$1" ) >/dev/null 2>&1
  [ -f "$OOSH_DIR/$1" ] && [ -f "$OOSH_DIR/test/test.$1" ]
}

# --- T-METHOD-NEW-DOCSTRING -------------------------------------------------
test.oo.methodNewWritesDocstring() {
  local probe="probeMethodNewScript" pwdBefore="$PWD"
  # oo.new and private.oo.new.test both `cd`, so the caller's directory has to
  # be put back by hand.
  if ! test.oo.method.probe.make "$probe"; then
    cd "$pwdBefore"; test.oo.method.probe.clean "$probe"
    create.result 1 "oo.new did not create $probe and its test"
    return $(result)
  fi
  printf '%s\n' '<branch> <?force:no>' 'switches to a branch, safely' \
                 'a probe test' 'probeArg' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "$probe.probeThing" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local docline mangled untouchedExamples stub testcase
  docline=$(grep -F "$probe.probeThing()" "$OOSH_DIR/$probe" 2>/dev/null | head -1)
  # The mangling signature is a NAME run straight into dashes — `probeThing------`
  # — produced by the first-match-anywhere sed that used to chew the Examples
  # block. The template's own plain dashed rule is not residue: the tool does
  # not touch the usage table at all any more, so that line must survive intact.
  mangled=$(grep -c -E '^[[:space:]]*[A-Za-z][A-Za-z0-9.]*-{3,}' "$OOSH_DIR/$probe" 2>/dev/null)
  untouchedExamples=$(grep -c -E '^[[:space:]]*-{4,}[[:space:]]*$' "$OOSH_DIR/$probe" 2>/dev/null)
  stub=$(grep -c "^$probe.probeThing.completion.branch()" "$OOSH_DIR/$probe" 2>/dev/null)
  testcase=$(grep -c 'a probe test' "$OOSH_DIR/test/test.$probe" 2>/dev/null)
  test.oo.method.probe.clean "$probe"

  if ! echo "$docline" | grep -Fq '# <branch> <?force:no> # switches to a branch, safely #'; then
    create.result 1 "the typed metadata never reached the docstring: [$docline]"
  elif [ "$mangled" != "0" ]; then
    create.result 1 "the usage/Examples block was mangled ($mangled line(s) of the probeThing------ shape)"
  elif [ "$untouchedExamples" = "0" ]; then
    create.result 1 "the template's Examples rule is gone — the tool is still editing the usage table"
  elif [ "$stub" = "0" ]; then
    create.result 1 "no completion function for <branch> — the method cannot tab-complete"
  elif [ "$testcase" = "0" ]; then
    create.result 1 "the test case was not written into test.$probe"
  else
    create.result 0 "docstring, completion and test case all carry the typed metadata"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-DOCSTRING: the typed parameters and description land in the docstring, with a completion stub" \
  test.oo.methodNewWritesDocstring
expect 0 "docstring, completion and test case all carry the typed metadata" \
  "the docstring is what this.help renders and c2 completes from — it must never ship a placeholder"

# --- T-METHOD-NEW-MULTISEGMENT ----------------------------------------------
test.oo.methodNewMultiSegment() {
  local probe="probeMultiSegScript" pwdBefore="$PWD"
  if ! test.oo.method.probe.make "$probe"; then
    cd "$pwdBefore"; test.oo.method.probe.clean "$probe"
    create.result 1 "oo.new did not create $probe and its test"
    return $(result)
  fi
  printf '%s\n' '<host>' 'updates the certificates for a host' \
                 'a probe test' 'probeHost' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "$probe.certificates.update.run" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local full truncated
  full=$(grep -c "^$probe.certificates.update.run()" "$OOSH_DIR/$probe" 2>/dev/null)
  truncated=$(grep -c "^$probe.certificates()" "$OOSH_DIR/$probe" 2>/dev/null)
  test.oo.method.probe.clean "$probe"

  if [ "$truncated" != "0" ]; then
    create.result 1 "the name was truncated to $probe.certificates() — every segment after the second was dropped"
  elif [ "$full" != "1" ]; then
    create.result 1 "$probe.certificates.update.run() was not created (found $full)"
  else
    create.result 0 "every dot segment survives into the method name"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-MULTISEGMENT: oo method.new <script>.a.b.c creates a.b.c, not a" \
  test.oo.methodNewMultiSegment
expect 0 "every dot segment survives into the method name" \
  "deep hierarchy is explicitly blessed by the naming standard — hiveMind.team.context.status()"

# --- T-DOCS-NAME-DRIFT ------------------------------------------------------
# 2fe5133 renamed oo.new.method to oo.method.new in March 2026 and updated two
# documentation lines. Seventeen references stayed wrong for six months, so the
# documented route into this tooling did not dispatch for anyone who followed it.
test.oo.docsNameNoDrift() {
  local missing="" doc cmd method
  for doc in "$OOSH_DIR"/docs/*.md; do
    [ -f "$doc" ] || continue
    for cmd in $(grep -ohE '(^[[:space:]]*([0-9]+\.[[:space:]]*)?\.?/?oo |`\.?/?oo )[a-z][a-zA-Z0-9]*(\.[a-zA-Z0-9]+)*' "$doc" 2>/dev/null \
                 | sed -E 's/.*oo //' | sort -u); do
      method="oo.$cmd"
      grep -qE "^(private\.)?${method//./\.}\(\)" "$OOSH_DIR/oo" || missing="$missing
    $(basename "$doc"): oo $cmd"
    done
  done
  if [ -z "$(echo "$missing" | tr -d '[:space:]')" ]; then
    create.result 0 "every documented oo command exists"
  else
    create.result 1 "docs name commands that oo does not define:$missing"
  fi
  return $(result)
}
test.case $level "T-DOCS-NAME-DRIFT: every oo command named in docs/ is actually defined" \
  test.oo.docsNameNoDrift
expect 0 "every documented oo command exists" \
  "a rename must update the docs — 2fe5133 did not, and it went unnoticed for six months"

# ============================================================================
# T-MODE-RELEASE-* — the release lane asks about the branch, not a mode word
# ============================================================================
# OOSH_MODE carried two kinds of value: a branch name, written by `oo mode`,
# and the literal word "released", written by promote AFTER it had already
# checked the tree back out to dev. Its sibling lane asserts "dev", so a box
# could satisfy only one of the two — and on a genuinely released box, where
# `oo mode prod` had set the branch name, the release lane failed anyway.
#
# A released install is one sitting on the prod branch. The lane keeps its
# purpose and asks the right question; promote's write is gone, because it was
# recording a developer-box event into a variable that describes an installed
# machine.
test.oo.modeRelease() { # <modeValue> # rc of private.check.user.mode.release with OOSH_MODE=<modeValue>
  local saved="$OOSH_MODE"
  export OOSH_MODE="$1"
  private.check.user.mode.release >/dev/null 2>&1
  local rc=$?
  export OOSH_MODE="$saved"
  return $rc
}

test.oo.modeReleaseChecksProd() {
  if ! test.oo.modeRelease prod; then
    create.result 1 "a prod box is not accepted as released"
  elif test.oo.modeRelease dev; then
    create.result 1 "a dev box was accepted as released"
  elif test.oo.modeRelease released; then
    create.result 1 "the old mode word 'released' still satisfies the check — OOSH_MODE is meant to be a branch now"
  else
    create.result 0 "released means: on the prod branch"
  fi
  return $(result)
}
test.case $level "T-MODE-RELEASE-CHECKS-PROD: the release lane accepts prod, rejects dev and the old mode word" \
  test.oo.modeReleaseChecksProd
expect 0 "released means: on the prod branch" \
  "OOSH_MODE is the branch the host is on; 'released' was an event recorded in the wrong variable"


# ============================================================================
# T-METHOD-DELETE — the counterpart of oo method.new
# ============================================================================
# oo had `oo new`, `oo test.new` and `oo method.new`, and nothing that removed
# a method. Deleting one by hand takes the body and leaves the docstring's
# completion functions behind — which is how `path` came to carry completion
# functions for verbs it no longer had. The fixture is a throwaway script in
# $OOSH_DIR, because the tool addresses scripts as $OOSH_DIR/<script>.
MD_SCRIPT="testMethodDeleteFixture$$"   # dot-free: <script.method> splits on the FIRST dot
MD_FILE="$OOSH_DIR/$MD_SCRIPT"

private.test.oo.method.delete.fixture() { # # write the throwaway script under test
  cat > "$MD_FILE" <<FIXTURE
#!/usr/bin/env bash

$MD_SCRIPT.keep() # <dir> # a method that must survive
{
  echo keep
}
$MD_SCRIPT.keep.completion.dir() { echo "/tmp"; }

$MD_SCRIPT.victim() # <dir> <?force:no> # the method under test
{
  local brace="}"      # NOT the end of the block
  echo victim
}
$MD_SCRIPT.victim.completion.dir() {
  echo "/tmp"
}
$MD_SCRIPT.victim.completion.force() { echo "yes"; echo "no"; }
FIXTURE
}

test.oo.methodDeleteRemovesMethodAndCompletions() {
  private.test.oo.method.delete.fixture
  "$OOSH_DIR/oo" method.delete "$MD_SCRIPT.victim" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "oo method.delete returned $rc"
  elif grep -q "victim" "$MD_FILE"; then
    create.result 1 "something named victim survived: $(grep -n victim "$MD_FILE" | tr '\n' ' ')"
  elif ! grep -q "^$MD_SCRIPT.keep() " "$MD_FILE" || ! grep -q "^$MD_SCRIPT.keep.completion.dir" "$MD_FILE"; then
    create.result 1 "the neighbouring method or its completion was taken too: $(cat "$MD_FILE")"
  else
    create.result 0 "removed"
  fi
  return $(result)
}
test.case $level "T-METHOD-DELETE: the method, its docstring and both completion functions go together" \
  test.oo.methodDeleteRemovesMethodAndCompletions
expect 0 "removed" "a one-line completion function has no closing brace LINE — the block form alone would run past it"

# A method that is not there must be refused, not silently reported as done.
test.oo.methodDeleteRefusesUnknown() {
  private.test.oo.method.delete.fixture
  "$OOSH_DIR/oo" method.delete "$MD_SCRIPT.neverExisted" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success for a method that does not exist"
  elif ! grep -q "^$MD_SCRIPT.victim() " "$MD_FILE"; then
    create.result 1 "it edited the file anyway"
  else
    create.result 0 "refused"
  fi
  return $(result)
}
test.case $level "T-METHOD-DELETE-UNKNOWN: an absent method is refused and the file is untouched" \
  test.oo.methodDeleteRefusesUnknown
expect 0 "refused" "silently succeeding would hide a typo in the method name"

rm -f "$MD_FILE" "$MD_FILE.bak" "$MD_FILE.new"
unset MD_SCRIPT MD_FILE

# ============================================================================
# T-STATE31-SSH-SNAPSHOT-FIRST: the snapshot precedes the first ~/.ssh write
# ============================================================================
# State 31 is the first thing in the whole install that writes the installing
# user's ~/.ssh — `mkdir -p "$HOME/.ssh"`, the Host github.com block, the
# ssh-keyscan into known_hosts, the developking copy into ids/. That is why
# ossh.install.continue.local's old "ssh.original" backup was nothing of the
# kind: it ran after `oo state`, by which point this state had already run.
#
# Structural, not behavioural: state.check re-sources $stateScript on every
# advancement, which kills in-shell function mocks, so an end-to-end mock of
# `user ssh.backup` cannot survive. The ORDER is the invariant that matters,
# and the platform gate proves the behaviour.
test.oo.state31SnapshotsBeforeWriting() {
  local body snapshotLine mkdirLine
  body=$(declare -f private.check.root.shared.dev.folder.created 2>/dev/null)
  if [ -z "$body" ]; then
    create.result 1 "private.check.root.shared.dev.folder.created is not defined"
    return $(result)
  fi
  snapshotLine=$(printf '%s\n' "$body" | grep -n 'ssh\.backup pre-install' | head -1 | cut -d: -f1)
  mkdirLine=$(printf '%s\n' "$body" | grep -n 'mkdir -p "\$HOME/\.ssh"' | head -1 | cut -d: -f1)
  if [ -z "$snapshotLine" ]; then
    create.result 1 "state 31 takes no pre-install ssh snapshot"
  elif [ -z "$mkdirLine" ]; then
    create.result 1 "could not find the mkdir -p \$HOME/.ssh this test anchors on"
  elif [ "$snapshotLine" -ge "$mkdirLine" ]; then
    create.result 1 "the snapshot is at line $snapshotLine, the first write at $mkdirLine — too late"
  else
    create.result 0 "snapshot first"
  fi
  return $(result)
}
test.case $level "T-STATE31-SSH-SNAPSHOT-FIRST: state 31 archives ~/.ssh before it writes to it" \
  test.oo.state31SnapshotsBeforeWriting
expect 0 "snapshot first" "the state that does the work owns the snapshot — a backup taken afterwards is not a backup"
# --- T-METHOD-NEW-PRIVATE ---------------------------------------------------
# A private method is named private.<script>.<verb>, so the SCRIPT it belongs
# to is the SECOND segment. Splitting on the first sent the tool at a file
# called `private` and it refused with rc 3 — so the tool this project MANDATES
# for method creation could not create a single private method, and every one
# in the tree was hand-written. That is the standing methodology violation.
test.oo.methodNewPrivate() {
  local probe="probePrivateScript" pwdBefore="$PWD"
  if ! test.oo.method.probe.make "$probe"; then
    cd "$pwdBefore"; test.oo.method.probe.clean "$probe"
    create.result 1 "oo.new did not create $probe and its test"
    return $(result)
  fi
  printf '%s\n' '<envPrefix>' 'lists the persistable variable names' \
                 'a probe test' 'OOSH' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "private.$probe.variables.list" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local created stray stubs testcase
  created=$(grep -c "^private\.$probe\.variables\.list()" "$OOSH_DIR/$probe" 2>/dev/null)
  # The old split aimed at $OOSH_DIR/private. Nothing should ever create it.
  stray=0; [ -e "$OOSH_DIR/private" ] && stray=1
  # A private method is never dispatched from the command line, so a completion
  # function for it is dead code — test/test.completion.audit skips `private*`
  # for exactly that reason, and the tool must not generate one.
  stubs=$(grep -c "^private\.$probe\.variables\.list\.completion\." "$OOSH_DIR/$probe" 2>/dev/null)
  testcase=$(grep -c "private\.$probe\.variables\.list" "$OOSH_DIR/test/test.$probe" 2>/dev/null)
  test.oo.method.probe.clean "$probe"

  if [ "$stray" != "0" ]; then
    create.result 1 "the tool created \$OOSH_DIR/private — the script is the SECOND segment of a private name"
  elif [ "$created" != "1" ]; then
    create.result 1 "private.$probe.variables.list() was not created in $probe (found $created)"
  elif [ "$stubs" != "0" ]; then
    create.result 1 "a private method got $stubs completion stub(s) — dead code the audit skips"
  elif [ "$testcase" = "0" ]; then
    create.result 1 "no test case was written for the private method"
  else
    create.result 0 "a private method lands in its own script, with no dead completion stub"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-PRIVATE: oo method.new private.<script>.<verb> writes to <script>" \
  test.oo.methodNewPrivate
expect 0 "a private method lands in its own script, with no dead completion stub" \
  "private methods are a large share of every script; the mandated tool could not create one"

# --- T-CHECK-PM-NO-CLOBBER --------------------------------------------------
# private.check.pm (oo:3055) does `export OS_CMD_GROUP_ADD=$3` and
# `export OS_CMD_USER_ADD=$4` unconditionally, then persists the set with
# `config save os.commands "OS_CMD"`. Four of the eight call sites pass those
# arguments; `brew` — the macOS one — passes NEITHER (private.check.all.pm), as do dpkg,
# pkg and pacman. So on macOS the pair is written as the EMPTY STRING and
# saved, which is why a clean Sequoia install carries
#
#   export OS_CMD_GROUP_ADD=""
#   export OS_CMD_USER_ADD=""
#
# while Linux carries real values. private.user.init already knows the darwin
# answers (`dseditgroup -o create -q`, `sysadminctl -addUser`, user:1633-1636),
# so the fix is NOT to duplicate them here — it is for check.pm to stop writing
# a variable it was never given, and let the heal fill them.
#
# The consequences were three, all measured on a clean VM 2026-09-17:
#   - user.create fails ("ooshTestC should exist with no password hash");
#   - private.this.group.create has no working route on darwin;
#   - the cache can never go healthy, so private.user.init's persist branch —
#     `config save os.commands` + `oo pm.discover` — runs on EVERY invocation,
#     and that cascade is what wrote the shared config tier from an isolated
#     test. See docs/research/2026-09-17-shared-tier-leak-macos.md.
test.oo.checkPmDoesNotClobber() {
  # A subshell: check.pm exports into its caller, and OOSH_PM must be empty for
  # it to do anything at all. `true` stands in for a package manager because
  # `command -v true` succeeds everywhere and installing nothing is safe — the
  # apt-get branch, which shells out to `apt-get update`, is not reached.
  local observed
  observed=$(
    export OOSH_PM=""
    export OS_CMD_GROUP_ADD="SENTINEL_GROUP"
    export OS_CMD_USER_ADD="SENTINEL_USER"
    private.check.pm ls "ls install" >/dev/null 2>&1
    echo "$OS_CMD_GROUP_ADD|$OS_CMD_USER_ADD"
  )
  if [ "$observed" = "SENTINEL_GROUP|SENTINEL_USER" ]; then
    create.result 0 "a two-argument check.pm leaves the OS_CMD pair alone"
  else
    create.result 1 "check.pm overwrote the pair with [$observed] — a call that passes no group/user command must not write one"
  fi
  return $(result)
}
test.case $level "T-CHECK-PM-NO-CLOBBER: a PM with no group/user command does not blank the cached pair" \
  test.oo.checkPmDoesNotClobber
expect 0 "a two-argument check.pm leaves the OS_CMD pair alone" \
  "brew passes neither, so macOS persisted two empty strings and user.create has never worked there"

# --- T-PM-TABLES-AGREE -------------------------------------------------------
# The package-manager map exists FOUR times in this tree, and they had drifted.
#
#   init/oosh:209-228   oosh_pm_detect        POSIX sh, standalone by necessity —
#                                             it runs from a curl one-liner before
#                                             any oosh exists to source.
#   oo:3113-3121        private.check.all.pm  the local installer's call table
#   ossh.pm.discover    ossh.pm.discover      a string executed on a REMOTE host
#                                             that may have no oosh at all
#   config              private.config.pm.command.get   added 2026-09-17 by card 2,
#                                             because oo pm.discover is not a
#                                             detector (it runs sudo apt-get update)
#
# Three of the four CANNOT be merged: init/oosh must be self-contained POSIX,
# and ossh's runs on a machine that has nothing of ours on it. What can be done
# is pin that they AGREE — which is what this test is, and what nothing did
# before. The drift it was written to catch:
#
#   pacman   init/oosh, ossh, config: "pacman -S --noconfirm"    oo: "pacman -S"
#   pkg      init/oosh, ossh, config: "pkg install -y"           oo: "pkg install"
#
# Both of oo's are INTERACTIVE. `oo cmd <tool>` runs them during an install, so
# on Arch or FreeBSD the install would sit on a confirmation prompt — the same
# failure mode as the sudo prompt oo pm.discover caused on 2026-09-17.
test.oo.pmTablesAgree() {
  local pm mismatches="" fromOo fromInit fromConfig
  for pm in brew apt-get dnf yum apk pacman pkg; do
    fromOo=$(grep -oE "private\.check\.pm $pm \"[^\"]+\"" "$OOSH_DIR/oo" 2>/dev/null \
             | head -1 | sed 's/.*"\(.*\)"/\1/')
    fromInit=$(grep -E "^[[:space:]]+$pm\)" "$OOSH_DIR/init/oosh" 2>/dev/null \
               | head -1 | sed 's/.*OOSH_PM="\([^"]*\)".*/\1/')
    fromConfig=$(grep -E "^[[:space:]]+$pm\)" "$OOSH_DIR/config" 2>/dev/null \
                 | head -1 | sed 's/.*echo "\([^"]*\)".*/\1/')
    [ -n "$fromOo" ] && [ -n "$fromInit" ] && [ "$fromOo" != "$fromInit" ] \
      && mismatches="$mismatches
    $pm: oo=[$fromOo] init/oosh=[$fromInit]"
    [ -n "$fromConfig" ] && [ -n "$fromInit" ] && [ "$fromConfig" != "$fromInit" ] \
      && mismatches="$mismatches
    $pm: config=[$fromConfig] init/oosh=[$fromInit]"
  done
  if [ -z "$(printf '%s' "$mismatches" | tr -d '[:space:]')" ]; then
    create.result 0 "every copy of the package-manager map agrees"
  else
    create.result 1 "the package-manager maps disagree:$mismatches"
  fi
  return $(result)
}
test.case $level "T-PM-TABLES-AGREE: the four copies of the package-manager map say the same thing" \
  test.oo.pmTablesAgree
expect 0 "every copy of the package-manager map agrees" \
  "oo's pacman and pkg entries lack their non-interactive flags, so an install on Arch or FreeBSD would sit on a prompt"

# --- T-METHOD-NEW-DOTTED-SCRIPT ---------------------------------------------
# A script whose own NAME contains a dot — `test.suite` is the one that matters
# — cannot be extended by the tool this project mandates. `${name%%.*}` takes
# everything before the FIRST dot, so `oo method.new test.suite.portability.validate`
# resolves the script to `test`, which is a DIRECTORY, and the insertion has
# nowhere to go.
#
# The boundary between script and method is not "the first dot". It is "the
# longest leading prefix that names a file that exists", which is the only
# definition that can tell `test.suite.x` from `config.x` without a list.
test.oo.methodNewDottedScript() {
  local probe="probeDotted.name" pwdBefore="$PWD"
  printf '#!/usr/bin/env bash\n\n### new.method\n' > "$OOSH_DIR/$probe"
  printf '#!/usr/bin/env bash\nTEST_CATEGORY=core\n\n### test.method\n' > "$OOSH_DIR/test/test.$probe"
  printf '%s\n' '<thing>' 'does a thing' 'a probe test' 'x' 'probe_ok' \
    | ( LOG_LEVEL=1 oo.method.new "$probe.deep.verb" ) >/dev/null 2>&1
  cd "$pwdBefore"

  local created stray testcase
  created=$(grep -c "^$probe\.deep\.verb()" "$OOSH_DIR/$probe" 2>/dev/null)
  # The old split aimed at `probeDotted`; nothing should ever create it.
  stray=0; [ -e "$OOSH_DIR/probeDotted" ] && stray=1
  testcase=$(grep -c "$probe\.deep\.verb" "$OOSH_DIR/test/test.$probe" 2>/dev/null)
  rm -f "$OOSH_DIR/$probe" "$OOSH_DIR/$probe".bak "$OOSH_DIR/$probe".new \
        "$OOSH_DIR/test/test.$probe" "$OOSH_DIR/test/test.$probe".bak \
        "$OOSH_DIR/test/test.$probe".new "$OOSH_DIR/probeDotted" 2>/dev/null

  if [ "$stray" != "0" ]; then
    create.result 1 "the tool created \$OOSH_DIR/probeDotted — the script is the LONGEST existing prefix, not the first segment"
  elif [ "$created" != "1" ]; then
    create.result 1 "$probe.deep.verb() was not created in $probe (found $created)"
  elif [ "$testcase" = "0" ]; then
    create.result 1 "no test case was written for a dotted-script method"
  else
    create.result 0 "a script whose name contains a dot can be extended"
  fi
  return $(result)
}
test.case $level "T-METHOD-NEW-DOTTED-SCRIPT: oo method.new resolves a script name containing a dot" \
  test.oo.methodNewDottedScript
expect 0 "a script whose name contains a dot can be extended" \
  "test.suite is such a script, and the mandated tool could not add a method to it"



console.log "
Test 1 
===================================================================="

test.oo.testPlatformNew() {
  local fx bad="" t; fx=$(test.suite.fixture.make platformnew)
  mkdir -p "$fx/templates/code" "$fx/test"
  cp "$OOSH_DIR/templates/code/newPlatformInvariantTest" "$fx/templates/code/"
  local OOSH_DIR="$fx"
  t="$fx/test/test.platform.fx.layout.invariant"
  oo.test.platform.new fx layout >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -x "$t" ] || bad="$bad not-created"
  grep -q '^TEST_CATEGORY=platform' "$t" 2>/dev/null || bad="$bad category"
  grep -q 'platform\.fx\.layout:' "$t" 2>/dev/null || bad="$bad not-substituted"
  grep -qE '<scope>|<aspect>' "$t" 2>/dev/null && bad="$bad placeholder-left"
  printf 'mine\n' > "$t"
  oo.test.platform.new fx layout >/dev/null 2>&1 && bad="$bad overwrite-passed"
  [ "$(cat "$t")" = mine ] || bad="$bad overwrote-existing"
  oo.test.platform.new 'fx/x' layout >/dev/null 2>&1 && bad="$bad bad-name-passed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "test.platform.new: generated from the template, refuses to overwrite or a bad name" || create.result 1 "test.platform.new:$bad"
  return $(result)
}
test.case $level "T-OO-TEST-PLATFORM-NEW: oo test.platform.new generates a platform invariant test" test.oo.testPlatformNew
expect 0 "test.platform.new: generated from the template, refuses to overwrite or a bad name" "platform invariants come from the template, not by hand"

# --- T-METHOD-NEW-SYMLINKED-SCRIPT -------------------------------------------
# Top-level `c2` is a symlink to `ng/c2`. method.new and method.delete edit
# $OOSH_DIR/<script>; they must edit the link's TARGET and leave the link a link
# (replace commit refuses a symlink — T-REPLACE-COMMIT-REFUSES-SYMLINK).
test.oo.methodNewSymlinkedScript() {
  local fx bad=""; fx=$(test.suite.fixture.make symlinkscript)
  mkdir -p "$fx/ng" "$fx/test" "$fx/templates/code"
  cp "$OOSH_DIR/templates/code/newMethod" "$OOSH_DIR/templates/code/newMethodTest" "$fx/templates/code/"
  printf '#!/usr/bin/env bash\n\n### new.method\n' > "$fx/ng/probeLinked"; chmod +x "$fx/ng/probeLinked"
  ln -s ng/probeLinked "$fx/probeLinked"
  printf '#!/usr/bin/env bash\nTEST_CATEGORY=core\n\n### test.method\n' > "$fx/test/test.probeLinked"
  printf '%s\n' '<thing>' 'does a thing' 'a probe test' 'x' 'probe_ok' \
    | ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.new probeLinked.thing.do ) >/dev/null 2>&1
  [ -L "$fx/probeLinked" ] || bad="$bad new-replaced-link"
  grep -q '^probeLinked\.thing\.do()' "$fx/ng/probeLinked" || bad="$bad new-not-in-target"
  [ -x "$fx/ng/probeLinked" ] || bad="$bad new-target-lost-exec"
  grep -q 'probeLinked\.thing\.do' "$fx/test/test.probeLinked" || bad="$bad new-no-test-case"
  ( OOSH_DIR="$fx"; LOG_LEVEL=1 oo.method.delete probeLinked.thing.do ) >/dev/null 2>&1
  [ -L "$fx/probeLinked" ] || bad="$bad delete-replaced-link"
  grep -q '^probeLinked\.thing\.do()' "$fx/ng/probeLinked" && bad="$bad delete-left-method"
  [ -x "$fx/ng/probeLinked" ] || bad="$bad delete-target-lost-exec"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "method.new and method.delete edit the link target; the link stays a link" || create.result 1 "symlinked script:$bad"
  return $(result)
}
test.case $level "T-METHOD-NEW-SYMLINKED-SCRIPT: oo method.new / method.delete edit a symlinked script through its target" \
  test.oo.methodNewSymlinkedScript
expect 0 "method.new and method.delete edit the link target; the link stays a link" \
  "c2 -> ng/c2: the mandated tool must be able to extend c2"


# ============================================================================
# T-BRANCH-CLONE-ENSURE-*: private.oo.branch.clone.ensure — the clone step of
# install state 31 and of private.oo.shared.tree.from.local, idempotent
# ============================================================================
# State 31 itself cannot be driven end to end (state.check re-sources the
# script and kills mocks), so the branch-clone decision lives in this helper
# and is tested here against fixtures: absent → clone; a clone on the branch →
# kept (a re-run is not a failure although ogit repo.clone refuses a non-empty
# target); an old-install WORKTREE → left alone, rc 0, pointing at
# `sudo ogit worktree.remove`; anything else → refused, never deleted.
private.test.oo.branchClone.origin() { # <fixture> # $fixture/origin: a repository with main + dev
  (
    mkdir -p "$1/origin" && cd "$1/origin" || exit 1
    git init --initial-branch=main -q
    git config user.email "test@test.local"
    git config user.name "test"
    echo seed > README.md && git add . && git commit -q -m seed
    git branch dev
  ) >/dev/null 2>&1
}

test.oo.branchCloneEnsureClonesAndKeeps() {
  local fx; fx=$(test.suite.fixture.make oo.branchclone) || { create.result 1 "fixture failed"; return $(result); }
  private.test.oo.branchClone.origin "$fx"
  mkdir -p "$fx/base"
  local rc1 rc2
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc1=$?
  echo "local work" > "$fx/base/dev/untracked.txt"
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc2=$?
  if [ "$rc1" -ne 0 ]; then
    create.result 1 "first call returned $rc1"
  elif [ ! -d "$fx/base/dev/.git" ]; then
    create.result 1 "dev/.git is not a directory"
  elif [ "$(git -C "$fx/base/dev" rev-parse --abbrev-ref HEAD 2>/dev/null)" != dev ]; then
    create.result 1 "dev/ is not on dev"
  elif [ "$rc2" -ne 0 ]; then
    create.result 1 "the re-run returned $rc2 — a re-run of state 31 would halt"
  elif [ ! -f "$fx/base/dev/untracked.txt" ]; then
    create.result 1 "the re-run replaced the existing clone"
  else
    create.result 0 "cloned, then kept"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-BRANCH-CLONE-ENSURE-IDEMPOTENT: clones an absent branch folder, keeps it on a re-run" \
  test.oo.branchCloneEnsureClonesAndKeeps
expect 0 "cloned, then kept" "state 31 re-runs over an existing clone of the right branch with rc 0"

test.oo.branchCloneEnsureLeavesWorktree() {
  local fx; fx=$(test.suite.fixture.make oo.branchclone.wt) || { create.result 1 "fixture failed"; return $(result); }
  private.test.oo.branchClone.origin "$fx"
  mkdir -p "$fx/base"
  git clone -q -b main "$fx/origin" "$fx/base/main" >/dev/null 2>&1
  git -C "$fx/base/main" worktree add -q "$fx/base/dev" dev >/dev/null 2>&1
  local rc
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc=$?
  if [ ! -f "$fx/base/main/.git/worktrees/dev/HEAD" ] && [ ! -f "$fx/base/dev/.git" ]; then
    create.result 1 "fixture: no linked worktree was made"
  elif [ "$rc" -ne 0 ]; then
    create.result 1 "returned $rc on an old-install worktree"
  elif [ ! -f "$fx/base/dev/.git" ]; then
    create.result 1 "the worktree was replaced — it must be left alone"
  elif ! printf '%s' "$RESULT" | grep -q 'ogit worktree.remove'; then
    create.result 1 "RESULT does not point at ogit worktree.remove: $RESULT"
  else
    create.result 0 "worktree left alone"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-BRANCH-CLONE-ENSURE-WORKTREE: an old-install worktree is left alone with a pointer to ogit worktree.remove" \
  test.oo.branchCloneEnsureLeavesWorktree
expect 0 "worktree left alone" "the conversion is ogit worktree.remove's job (gated, carries ignored files) — never the install's"

test.oo.branchCloneEnsureRefusesOther() {
  local fx; fx=$(test.suite.fixture.make oo.branchclone.other) || { create.result 1 "fixture failed"; return $(result); }
  private.test.oo.branchClone.origin "$fx"
  mkdir -p "$fx/base"
  git clone -q -b main "$fx/origin" "$fx/base/dev" >/dev/null 2>&1
  local rc
  private.oo.branch.clone.ensure "$fx/origin" dev "$fx/base/dev" >/dev/null 2>&1; rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "accepted a clone of main sitting at dev/"
  elif [ "$(git -C "$fx/base/dev" rev-parse --abbrev-ref HEAD 2>/dev/null)" != main ]; then
    create.result 1 "the folder was changed"
  else
    create.result 0 "refused"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-BRANCH-CLONE-ENSURE-REFUSES: a folder on another branch is refused, not replaced" \
  test.oo.branchCloneEnsureRefusesOther
expect 0 "refused" "the install never deletes a folder it did not make"

# ============================================================================
# T-STATE31-CLONE-LAYOUT: state 31 produces clones with per-folder permissions
# ============================================================================
# Structural (state.check re-sources $stateScript — end-to-end mocks die):
# the branch folder comes from the clone helper, never from worktree add; the
# permission block runs PER repository folder under the base (repo.share +
# safe.directory of the case-canonical path); the BASE gets group dev + setgid
# so folders added later inherit the group; no recursive chown of the base.
test.oo.state31CloneLayout() {
  local body bad=""
  body=$(declare -f private.check.root.shared.dev.folder.created 2>/dev/null)
  if [ -z "$body" ]; then
    create.result 1 "private.check.root.shared.dev.folder.created is not defined"
    return $(result)
  fi
  printf '%s\n' "$body" | grep -q 'ogit.repo.clone' || bad="$bad no-ogit.repo.clone"
  printf '%s\n' "$body" | grep -q 'private.oo.branch.clone.ensure' || bad="$bad no-branch.clone.ensure"
  printf '%s\n' "$body" | grep -q 'worktree.add' && bad="$bad still-worktree.add"
  printf '%s\n' "$body" | grep -q 'private.ogit.base.folders.list "$onceShBase"' || bad="$bad no-per-folder-loop"
  printf '%s\n' "$body" | grep -q 'ogit.repo.share "$_wt"' || bad="$bad no-per-folder-share"
  printf '%s\n' "$body" | grep -q 'ogit.safeDirectory.add "$(private.this.path.case.get "$_wt")"' || bad="$bad no-per-folder-trust"
  printf '%s\n' "$body" | grep -q 'chmod g+ws "$onceShBase"' || bad="$bad base-not-setgid"
  printf '%s\n' "$body" | grep -q 'chgrp dev "$onceShBase"' || bad="$bad base-not-group-dev"
  printf '%s\n' "$body" | grep -qE 'chown -R[^;]*onceShBase' && bad="$bad recursive-chown-of-base"
  printf '%s\n' "$body" | grep -q 'onceShBase/main/.git' && bad="$bad main-only-permissions"
  if [ -z "$bad" ]; then
    create.result 0 "clone layout, per-folder permissions, setgid base"
  else
    create.result 1 "state 31:$bad"
  fi
  return $(result)
}
test.case $level "T-STATE31-CLONE-LAYOUT: state 31 clones the branch and shares + trusts every folder, base setgid, no recursive chown" \
  test.oo.state31CloneLayout
expect 0 "clone layout, per-folder permissions, setgid base" "spec § 2 + § 4: each folder is its own repository"

### test.method

test.suite.save.results
