# ============================================================================
# Test team.save/restore round-trip preserves role registry
# ============================================================================

TEAM_TEST_SESSION="hivemind_teamtest_$$"
TEAM_SAVE_FILE="/tmp/hivemind_team_$$.md"
TEAM_TMUX_FILE="/tmp/hivemind_team_$$.tmux"
TEAM_REGISTRY_BACKUP=""

# Backup existing registry
if [ -f "$HIVEMIND_REGISTRY" ]; then
  TEAM_REGISTRY_BACKUP="/tmp/hivemind_registry_backup_$$.tmp"
  cp "$HIVEMIND_REGISTRY" "$TEAM_REGISTRY_BACKUP"
fi

# Create test session with 2 panes
tmux -u new-session -d -s "$TEAM_TEST_SESSION" -c "/tmp"
TEAM_FIRST_WIN=$(tmux -u list-windows -t "$TEAM_TEST_SESSION" -F "#{window_index}" 2>/dev/null | head -1)
tmux -u split-window -t "$TEAM_TEST_SESSION:$TEAM_FIRST_WIN" -c "/tmp"

# Register roles for the test session
private.hiveMind.registry.set "${TEAM_TEST_SESSION}:${TEAM_FIRST_WIN}.1" "test-expert"
private.hiveMind.registry.set "${TEAM_TEST_SESSION}:${TEAM_FIRST_WIN}.2" "test-tester"

test.case $level "hiveMind.team.save creates topology file" \
  hiveMind.team.save "$TEAM_TEST_SESSION" "$TEAM_SAVE_FILE"

if [ -f "$TEAM_SAVE_FILE" ]; then
  expect.pass "team topology file created"
else
  expect.fail "team topology file not created"
fi

test.case $level "team topology contains agents table" \
  echo "checking agents table"

if grep -q "test-expert" "$TEAM_SAVE_FILE" 2>/dev/null && grep -q "test-tester" "$TEAM_SAVE_FILE" 2>/dev/null; then
  expect.pass "topology contains both test roles"
else
  expect.fail "topology should contain test-expert and test-tester"
fi

test.case $level "team topology has corresponding tmux file" \
  echo "checking tmux file"

if [ -f "$TEAM_TMUX_FILE" ]; then
  expect.pass "tmux layout file exists: $TEAM_TMUX_FILE"
else
  expect.fail "tmux layout file not created"
fi

# Kill session and clear registry entries for this session
tmux -u kill-session -t "$TEAM_TEST_SESSION" 2>/dev/null
grep -v "^${TEAM_TEST_SESSION}:" "$HIVEMIND_REGISTRY" > "${HIVEMIND_REGISTRY}.tmp" 2>/dev/null
mv "${HIVEMIND_REGISTRY}.tmp" "$HIVEMIND_REGISTRY" 2>/dev/null

# Restore
test.case $level "hiveMind.team.restore round-trip" \
  hiveMind.team.restore "$TEAM_SAVE_FILE"

if tmux -u has-session -t "$TEAM_TEST_SESSION" 2>/dev/null; then
  # Check registry was rebuilt
  RESTORED_EXPERT=$(grep "test-expert" "$HIVEMIND_REGISTRY" 2>/dev/null)
  RESTORED_TESTER=$(grep "test-tester" "$HIVEMIND_REGISTRY" 2>/dev/null)
  if [ -n "$RESTORED_EXPERT" ] && [ -n "$RESTORED_TESTER" ]; then
    expect.pass "round-trip: roles restored in registry"
  else
    expect.fail "round-trip: roles missing from registry after restore"
  fi
  tmux -u kill-session -t "$TEAM_TEST_SESSION" 2>/dev/null
else
  expect.fail "round-trip: session not found after restore"
fi

# Cleanup
rm -f "$TEAM_SAVE_FILE" "$TEAM_TMUX_FILE"
# Remove test entries from registry
if [ -f "$HIVEMIND_REGISTRY" ]; then
  grep -v "^${TEAM_TEST_SESSION}:" "$HIVEMIND_REGISTRY" > "${HIVEMIND_REGISTRY}.tmp" 2>/dev/null
  mv "${HIVEMIND_REGISTRY}.tmp" "$HIVEMIND_REGISTRY" 2>/dev/null
fi
# Restore original registry if we had one
if [ -n "$TEAM_REGISTRY_BACKUP" ] && [ -f "$TEAM_REGISTRY_BACKUP" ]; then
  cp "$TEAM_REGISTRY_BACKUP" "$HIVEMIND_REGISTRY"
  rm -f "$TEAM_REGISTRY_BACKUP"
fi

