# hiveMind snapshot roundtrip-test
# session|address|role|uuid|title
${RT_SESS}|0.0|rt-alpha||rt-alpha
${RT_SESS}|0.1|rt-beta||rt-beta
RTSNAP
  cat > "$RT_FIXTURE/hivemind.roles.env" <<RTROLES
