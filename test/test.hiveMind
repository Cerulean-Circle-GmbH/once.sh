fi

# --- T-DRY-2: current.session returns a session name inside tmux ---
if [ -n "$TMUX" ]; then
  CURR_SESS=$(private.hiveMind.current.session 2>/dev/null)
  test.case $level "T-DRY-2: current.session returns non-empty in tmux" \
