#!/usr/bin/env bash
# T-INSTALL-NONDESTRUCTIVE (#34) — the constructor must not destroy an existing
# install. Origin: during #13 the relocation `mv "$OOSH_DIR" "$HOME/oosh"` blind-
# clobbered an existing $HOME/oosh (mid-mv wipe). S34.1 (a3b1eff) fix: an existing
# real $HOME/oosh is moved aside to a TIMESTAMPED `.pre-oosh` backup (not died,
# not wiped); a bare SYMLINK has only its link removed (its target tree untouched);
# fresh install is unchanged.
#
# STRUCTURAL + ISOLATED SANDBOX only — we NEVER run the real installer against a
# live oosh dir (that IS the bug). Full destructive e2e → E1.2 throwaway container.
# (ref: session/tasks/init-oosh-nondestructive.md S34.2)

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

I="$OOSH_DIR/init/oosh"
code() { grep -vE '^[[:space:]]*#' "$I"; }   # comment-stripped view of init/oosh

# --- (1) existing REAL $HOME/oosh is BACKED UP (timestamped), not wiped/died ---
test.case $level "T-INSTALL-NONDESTRUCTIVE: existing real \$HOME/oosh → timestamped .pre-oosh backup" \
  echo "checking backup branch"
if code | grep -qE '\.pre-oosh\.' \
   && code | grep -qE 'mv +"\$HOME/oosh" +"\$_oosh_bak"'; then
  expect.pass "existing real dir is moved aside to a timestamped .pre-oosh backup (self-healing)"
else
  expect.fail "no timestamped backup of an existing \$HOME/oosh — an existing install could be lost (#34)"
fi

# --- (2) the `rm -f "$HOME/oosh"` is SYMLINK-GATED (never removes a real tree) --
# Extract the relocation if-block and confirm rm -f lives under `[ -L … ]`.
relBlock=$(awk '/if \[ -L "\$HOME\/oosh" \]/{f=1} f{print} f&&/^[[:space:]]*fi[[:space:]]*$/{c++} c>=1{exit}' "$I")
test.case $level "T-INSTALL-NONDESTRUCTIVE: rm -f \$HOME/oosh is guarded to the SYMLINK case only" \
  echo "$relBlock"
if printf '%s' "$relBlock" | grep -qE 'if \[ -L "\$HOME/oosh" \]' \
   && printf '%s' "$relBlock" | grep -qE 'rm -f +"\$HOME/oosh"' \
   && printf '%s' "$relBlock" | grep -qE 'elif \[ -e "\$HOME/oosh" \]'; then
  expect.pass "rm -f only under [ -L ] (symlink); real dir takes the elif backup path"
else
  expect.fail "rm -f \$HOME/oosh must be symlink-gated with a real-dir backup elif"
fi

# --- (3) NO `rm -rf` of the oosh tree anywhere (the truly-unrecoverable op).
# The only `rm -f "$HOME/oosh"` is the symlink-gated one already proven in (2).
rmrf=$(grep -nE 'rm +-rf +"?\$OOSH_DIR"?|rm +-rf +"?\$HOME/oosh"?' "$I")
test.case $level "T-INSTALL-NONDESTRUCTIVE: no 'rm -rf' of \$OOSH_DIR/\$HOME/oosh" \
  echo "${rmrf:-none}"
if [ -z "$rmrf" ]; then
  expect.pass "no rm -rf of the oosh tree — an existing install is never blind-deleted"
else
  expect.fail "rm -rf of the oosh tree present (unrecoverable): $rmrf"
fi

# --- (4) ISOLATED SANDBOX (behavioral, NON-destructive) — mirror the fix logic
#         against dummy dirs; a pre-existing MARKER must survive as a backup. ----
sbox=$(mktemp -d 2>/dev/null || echo "/tmp/t34-$$"); mkdir -p "$sbox/home" "$sbox/src"
printf 'PRECIOUS\n' > "$sbox/home/oosh_marker"; mkdir -p "$sbox/home/oosh"; mv "$sbox/home/oosh_marker" "$sbox/home/oosh/MARKER"
printf 'NEW\n' > "$sbox/src/NEW"
# the S34.1 placement algorithm, verbatim shape:
H="$sbox/home"; SRC="$sbox/src"
if [ -L "$H/oosh" ]; then
  rm -f "$H/oosh"
elif [ -e "$H/oosh" ]; then
  bak="$H/oosh.pre-oosh.$(date +%Y%m%d%H%M%S 2>/dev/null || echo ts)"
  mv "$H/oosh" "$bak"
fi
mv "$SRC" "$H/oosh" 2>/dev/null
survived=$(cat "$H"/oosh.pre-oosh.*/MARKER 2>/dev/null)
placed=$(cat "$H/oosh/NEW" 2>/dev/null)
test.case $level "T-INSTALL-NONDESTRUCTIVE (sandbox): pre-existing MARKER survives as backup" \
  echo "survived='$survived' placed='$placed'"
if [ "$survived" = "PRECIOUS" ] && [ "$placed" = "NEW" ]; then
  expect.pass "existing install preserved as .pre-oosh backup; new tree placed — non-destructive"
else
  expect.fail "sandbox: MARKER lost (survived='$survived') — placement is destructive"
fi
rm -rf "$sbox" 2>/dev/null

test.suite.save.results
