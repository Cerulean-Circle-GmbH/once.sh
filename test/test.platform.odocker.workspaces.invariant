#!/usr/bin/env bash
TEST_CATEGORY=platform

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source $OOSH_DIR/os
source $OOSH_DIR/odocker 2>/dev/null

log.level $level

# platform.odocker.workspaces.invariant — can THIS MACHINE build platform images?
#
#   ./test.suite run platform.odocker.workspaces.invariant 1
#
# These four assertions used to live in test/test.odocker as `core`, where they
# failed on every machine that is not this dev box. The DockerWorkspaces tree
# they check belongs to a DIFFERENT repository (donges/eamd.ucp.git) — no
# Dockerfile ships with oosh at all (`find . -name Dockerfile` in this repo
# returns nothing), and nothing on the install path creates it. So a fresh
# install could never satisfy them, and `os platform.test` runs
# `test.suite core 1` four times inside a container with no /var/dev
# (os:341,352,380,392): six failures × four users, every gate.
#
# The question is still worth asking — `os platform.test` cannot build an image
# without `$ODOCKER_WORKSPACES/<workspace>/Dockerfile` (os:212-220) — so it is
# asked HERE, where a host-dependent assertion belongs and where a missing
# real-world precondition does not fail a clean unit-test run
# (templates/code/newPlatformInvariantTest:15-17).
#
# The enumerator ITSELF is tested against a fixture in test/test.odocker
# (T-WS-LIST), which is the half that belongs in core and passes anywhere.

# ----------------------------------------------------------------------------
# INVARIANT-0 (precondition): the workspaces root is a directory.
# Without it nothing below can mean anything, so bail cleanly — but still
# record the failure, per the template. A skip that scores as a pass is how
# this went unnoticed in the first place.
# ----------------------------------------------------------------------------
test.case $level "platform.odocker.workspaces: precondition — \$ODOCKER_WORKSPACES is a directory" \
  test -d "$ODOCKER_WORKSPACES"
if [ ! -d "$ODOCKER_WORKSPACES" ]; then
  expect.fail "ODOCKER_WORKSPACES is not a directory: ${ODOCKER_WORKSPACES:-<unset>}
    This tree ships with EAMD.ucp, not with oosh, and no install creates it.
    Point oosh at a checkout:  odocker workspace.set <path-to-DockerWorkspaces>
    Or start an empty one:     odocker workspace.init <path>
    Until then \`os platform.test\` can only run against images already built."
  test.suite.save.results
  return 0 2>/dev/null || exit 0
else
  expect.pass "workspaces root: $ODOCKER_WORKSPACES"
fi

# ----------------------------------------------------------------------------
# INVARIANT-1: every must-pass platform has a Dockerfile.
#
# The list is READ from defaults/platforms.env through os's own helpers
# (private.os.platform.names, private.os.platform.parse) — never retyped. The
# version of this check that lived in test.odocker hard-coded all four names,
# which is how a fifth must-pass platform would have gone unnoticed.
#
# `native` workspaces (PLATFORM_macos) are not Docker platforms and have no
# Dockerfile by definition — os:186-193 skips them for the same reason.
# ----------------------------------------------------------------------------
missingDockerfiles=""
checkedPlatforms=""
for platformName in $(private.os.platform.names); do
  private.os.platform.parse "$platformName" >/dev/null 2>&1 || continue
  [ "$PLATFORM_TIER" = "must-pass" ] || continue
  [ "$PLATFORM_WORKSPACE" = "native" ] && continue
  checkedPlatforms="$checkedPlatforms $PLATFORM_WORKSPACE"
  [ -f "$ODOCKER_WORKSPACES/$PLATFORM_WORKSPACE/Dockerfile" ] \
    || missingDockerfiles="$missingDockerfiles $PLATFORM_WORKSPACE"
done

test.case $level "platform.odocker.workspaces: every must-pass platform has a Dockerfile" \
  test -z "$missingDockerfiles"
if [ -z "$missingDockerfiles" ]; then
  expect.pass "Dockerfiles present for:$checkedPlatforms"
else
  expect.fail "no Dockerfile under $ODOCKER_WORKSPACES for:$missingDockerfiles
    \`os platform.test\` builds from these (os:212-220) and will fail for each.
    Check the EAMD.ucp checkout is current, or point elsewhere with
    \`odocker workspace.set <path>\`."
fi

# ----------------------------------------------------------------------------
# INVARIANT-2: the enumerator actually finds something on the real tree.
# T-WS-LIST proves the globbing is correct against a fixture; this proves the
# real root is not merely an empty directory that satisfied INVARIANT-0.
# ----------------------------------------------------------------------------
enumerated=$(private.odocker.workspace.list 2>/dev/null)
test.case $level "platform.odocker.workspaces: the enumerator finds workspaces on the real tree" \
  test -n "$enumerated"
if [ -n "$enumerated" ]; then
  expect.pass "$(printf '%s\n' "$enumerated" | grep -c .) workspace(s) found under $ODOCKER_WORKSPACES"
else
  expect.fail "private.odocker.workspace.list found nothing under $ODOCKER_WORKSPACES —
    the root exists but holds no <dir>/Dockerfile or <dir>/<variant>/Dockerfile.
    An empty root passes INVARIANT-0 and is still unusable."
fi

# ----------------------------------------------------------------------------
# INVARIANT-3 (behavioural): the reporter agrees with the consumers.
# `odocker workspace.get` is what an operator runs when a build fails; item 8's
# research found it reporting a root that `workspace.list` and `build` were
# already rejecting. Nothing pinned that agreement on a real host.
# ----------------------------------------------------------------------------
workspaceGetOut=$(odocker.workspace.get 2>&1); workspaceGetRc=$?
test.case $level "platform.odocker.workspaces: workspace.get agrees the current root is usable" \
  test "$workspaceGetRc" = "0"
if [ "$workspaceGetRc" = "0" ]; then
  expect.pass "workspace.get rc 0: $(printf '%s' "$workspaceGetOut" | head -1)"
else
  expect.fail "workspace.get rc $workspaceGetRc on a root that INVARIANT-0 accepted:
$workspaceGetOut
    The reporter and the consumers disagree — that is the defect item 8 found."
fi

test.suite.save.results
