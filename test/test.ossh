#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

level=$1
if [ -z "$level" ]; then
  level=1
else 
  # remove the level parameter
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

#echo "sourcing init"
source this
source test.suite

log.level $level

competionArray=(once config list file ite)
source oo

test.ossh() 
{
((TEST_COUNTER++))
console.log "


Test 0: ossh \"$*\"
===================================================================="
ossh.start "$@"
console.log "RETURN: $RETURN_VALUE  Result: $RESULT 
===================================================================="
}

test.case - "ossh test start" \
   ossh $*
expect 0 "*" "Test start"

source ossh

### test.method

# ============================================================================
# Test ossh.config.create - user@host parsing (bug fix #1)
# ============================================================================

test.case $level "ossh.config.create parses user@host correctly" \
  ossh.config.create test@testhost

# Verify Host line uses hostname only (not user@host)
HOST_LINE=$(grep "^Host " "$CONFIG_PATH/result.txt" 2>/dev/null | head -1)
if echo "$HOST_LINE" | grep -q "^Host testhost$"; then
  expect.pass "Host line is 'Host testhost' (no @ symbol)"
else
  expect.fail "Host line should be 'Host testhost', got: $HOST_LINE"
fi

test.case $level "ossh.config.create parses User from user@host" \
  ossh.config.create test@testhost

USER_LINE=$(grep "User " "$CONFIG_PATH/result.txt" 2>/dev/null | head -1)
if echo "$USER_LINE" | grep -q "User test$"; then
  expect.pass "User parsed as 'test'"
else
  expect.fail "User should be 'test', got: $USER_LINE"
fi

test.case $level "ossh.config.create parses HostName from user@host" \
  ossh.config.create test@testhost

HOSTNAME_LINE=$(grep "HostName " "$CONFIG_PATH/result.txt" 2>/dev/null | head -1)
if echo "$HOSTNAME_LINE" | grep -q "HostName testhost$"; then
  expect.pass "HostName parsed as 'testhost'"
else
  expect.fail "HostName should be 'testhost', got: $HOSTNAME_LINE"
fi

# ============================================================================
# Test private.config.create sets RESULT via create.result (bug fix #4)
# ============================================================================

test.case $level "config.create sets RESULT via create.result" \
  ossh.config.create test@testhost

if [ -n "$RESULT" ] && [ "$RESULT" = "testhost" ]; then
  expect.pass "RESULT set to 'testhost'"
else
  expect.fail "RESULT should be 'testhost', got: '$RESULT'"
fi

# ============================================================================
# Test ossh.config.save.last - writes clean entry (bug fix #2, #3)
# ============================================================================

# Use a temp file to avoid polluting real ~/.ssh/config
TEST_SSH_CONFIG=$(mktemp /tmp/test.ossh.config.XXXXXX)

# First, create a config entry
ossh.config.create test@testhost

test.case $level "ossh.config.save.last writes clean entry to file" \
  ossh.config.save.last "$TEST_SSH_CONFIG"

if grep -q "^Host testhost$" "$TEST_SSH_CONFIG" 2>/dev/null; then
  expect.pass "config.save.last wrote 'Host testhost' to file"
else
  expect.fail "config.save.last should write 'Host testhost' to file"
fi

# ============================================================================
# Test ossh.config.save.last - duplicate detection (bug fix #3)
# ============================================================================

# config.save.last was already called once above, so calling again should detect duplicate
test.case $level "ossh.config.save.last detects duplicate Host entry" \
  ossh.config.save.last "$TEST_SSH_CONFIG"

if [ "$RETURN_VALUE" -eq 1 ]; then
  expect.pass "config.save.last returned 1 for duplicate Host"
else
  expect.fail "config.save.last should return 1 for duplicate, got: $RETURN_VALUE"
fi

# Verify only one entry exists (no duplicate appended)
ENTRY_COUNT=$(grep -c "^Host testhost$" "$TEST_SSH_CONFIG" 2>/dev/null)
test.case $level "config.save.last did not append duplicate entry" \
  echo "$ENTRY_COUNT"

if [ "$ENTRY_COUNT" -eq 1 ]; then
  expect.pass "only 1 'Host testhost' entry in file"
else
  expect.fail "should have exactly 1 entry, found: $ENTRY_COUNT"
fi

# ============================================================================
# Cleanup config.create tests
# ============================================================================

rm -f "$TEST_SSH_CONFIG" 2>/dev/null

# ============================================================================
# Test ossh.config.get / ossh.config.set — per-field SSH config editing
# ============================================================================

# Setup: create a temp SSH config with two Host blocks
TEST_CONFIG_FILE=$(mktemp /tmp/test.ossh.fieldops.XXXXXX)
cat > "$TEST_CONFIG_FILE" << 'SSHEOF'
Host alpha.example
 User alice
 Port 22
 HostName alpha.example.com
 IdentityFile ~/.ssh/id_ed25519

Host beta.example
 User bob
 Port 2222
 HostName beta.example.com
 IdentityFile ~/.ssh/ids/betakey/id_ed25519
SSHEOF

# Temporarily override sshDir so config.get/set use our temp file
ORIGINAL_CURRENT_SSH_DIR="$CURRENT_SSH_DIR"
TEST_SSH_DIR=$(mktemp -d /tmp/test.ossh.sshdir.XXXXXX)
cp "$TEST_CONFIG_FILE" "$TEST_SSH_DIR/config"
export CURRENT_SSH_DIR="$TEST_SSH_DIR"

# --- config.get: missing required params shows usage ---

test.case $level "config.get missing params returns error" \
  ossh.config.get
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "returns non-zero on missing params"
else
  expect.fail "should return non-zero when no params given"
fi

# --- config.set: missing required params shows usage ---

test.case $level "config.set missing all params returns error" \
  ossh.config.set
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "returns non-zero on missing params"
else
  expect.fail "should return non-zero when no params given"
fi

test.case $level "config.set missing field+value returns error" \
  ossh.config.set alpha.example
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "returns non-zero with only host"
else
  expect.fail "should return non-zero when field and value missing"
fi

# --- config.get: read existing fields ---

test.case $level "config.get reads User from alpha" \
  ossh.config.get alpha.example User
if [ "$RESULT" = "alice" ]; then
  expect.pass "User=alice"
else
  expect.fail "expected 'alice', got: '$RESULT'"
fi

test.case $level "config.get reads Port from beta" \
  ossh.config.get beta.example Port
if [ "$RESULT" = "2222" ]; then
  expect.pass "Port=2222"
else
  expect.fail "expected '2222', got: '$RESULT'"
fi

test.case $level "config.get reads IdentityFile from beta" \
  ossh.config.get beta.example IdentityFile
if [ "$RESULT" = "~/.ssh/ids/betakey/id_ed25519" ]; then
  expect.pass "IdentityFile correct"
else
  expect.fail "expected '~/.ssh/ids/betakey/id_ed25519', got: '$RESULT'"
fi

# --- config.get: without field returns whole block (backward compat) ---

test.case $level "config.get without field returns whole block" \
  ossh.config.get alpha.example
if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "returns 0 for existing host block"
else
  expect.fail "should return 0 for existing host, got: $RETURN_VALUE"
fi

# --- config.get: error cases ---

test.case $level "config.get non-existent host returns error" \
  ossh.config.get nonExistentHost User
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "non-zero for missing host"
else
  expect.fail "should return non-zero for non-existent host"
fi

test.case $level "config.get non-existent field returns error" \
  ossh.config.get alpha.example ProxyJump
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "non-zero for missing field"
else
  expect.fail "should return non-zero for non-existent field"
fi

# --- config.set: replace existing field ---

test.case $level "config.set replaces Port in alpha" \
  ossh.config.set alpha.example Port 443
if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "config.set returned 0"
else
  expect.fail "config.set should return 0, got: $RETURN_VALUE"
fi

# Verify the change persisted
test.case $level "config.get confirms Port changed to 443" \
  ossh.config.get alpha.example Port
if [ "$RESULT" = "443" ]; then
  expect.pass "Port=443 after set"
else
  expect.fail "expected '443', got: '$RESULT'"
fi

# --- config.set: isolation — other Host block untouched ---

test.case $level "config.set isolation: beta Port unchanged" \
  ossh.config.get beta.example Port
if [ "$RESULT" = "2222" ]; then
  expect.pass "beta Port still 2222"
else
  expect.fail "beta Port should be 2222, got: '$RESULT'"
fi

test.case $level "config.set isolation: beta User unchanged" \
  ossh.config.get beta.example User
if [ "$RESULT" = "bob" ]; then
  expect.pass "beta User still bob"
else
  expect.fail "beta User should be 'bob', got: '$RESULT'"
fi

# --- config.set: replace User field ---

test.case $level "config.set replaces User in beta" \
  ossh.config.set beta.example User deploy
test.case $level "config.get confirms User changed to deploy" \
  ossh.config.get beta.example User
if [ "$RESULT" = "deploy" ]; then
  expect.pass "User=deploy after set"
else
  expect.fail "expected 'deploy', got: '$RESULT'"
fi

# --- config.set: add new field ---

test.case $level "config.set adds ProxyJump to alpha" \
  ossh.config.set alpha.example ProxyJump bastion
if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "config.set returned 0 for new field"
else
  expect.fail "config.set should return 0 adding new field, got: $RETURN_VALUE"
fi

test.case $level "config.get confirms ProxyJump added" \
  ossh.config.get alpha.example ProxyJump
if [ "$RESULT" = "bastion" ]; then
  expect.pass "ProxyJump=bastion"
else
  expect.fail "expected 'bastion', got: '$RESULT'"
fi

# --- config.set: non-existent host returns error ---

test.case $level "config.set non-existent host returns error" \
  ossh.config.set nonExistentHost Port 22
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "non-zero for missing host"
else
  expect.fail "should return non-zero for non-existent host"
fi

# --- config.set: restore original value (round-trip) ---

test.case $level "config.set round-trip: restore Port to 22" \
  ossh.config.set alpha.example Port 22
test.case $level "config.get confirms Port restored to 22" \
  ossh.config.get alpha.example Port
if [ "$RESULT" = "22" ]; then
  expect.pass "Port=22 after restore"
else
  expect.fail "expected '22', got: '$RESULT'"
fi

# --- Tab completion: stubs exist ---

if grep -q 'ossh.config.set.completion.configItem' "$OOSH_DIR/ossh"; then
  expect.pass "config.set.completion.configItem exists"
else
  expect.fail "config.set.completion.configItem missing in ossh"
fi

if grep -q 'ossh.config.set.completion.field' "$OOSH_DIR/ossh"; then
  expect.pass "config.set.completion.field exists"
else
  expect.fail "config.set.completion.field missing in ossh"
fi

if grep -q 'ossh.config.set.completion.value' "$OOSH_DIR/ossh"; then
  expect.pass "config.set.completion.value exists"
else
  expect.fail "config.set.completion.value missing in ossh"
fi

if grep -q 'ossh.config.get.completion.configItem' "$OOSH_DIR/ossh"; then
  expect.pass "config.get.completion.configItem exists"
else
  expect.fail "config.get.completion.configItem missing in ossh"
fi

if grep -q 'ossh.config.get.completion.field' "$OOSH_DIR/ossh"; then
  expect.pass "config.get.completion.field exists"
else
  expect.fail "config.get.completion.field missing in ossh"
fi

# ============================================================================
# Cleanup config.set/get tests
# ============================================================================

export CURRENT_SSH_DIR="$ORIGINAL_CURRENT_SSH_DIR"
rm -f "$TEST_CONFIG_FILE" 2>/dev/null
rm -rf "$TEST_SSH_DIR" 2>/dev/null

# ============================================================================
# Test Summary
# ============================================================================

test.suite.save.results
