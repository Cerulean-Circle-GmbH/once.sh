#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else 
  # remove the level parameter
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

#echo "sourcing init"
source this
source test.suite

log.level $level

competionArray=(once config list file ite)
source oo

test.ossh() 
{
((TEST_COUNTER++))
console.log "


Test 0: ossh \"$*\"
===================================================================="
ossh.start "$@"
console.log "RETURN: $RETURN_VALUE  Result: $RESULT 
===================================================================="
}

test.case - "ossh test start" \
   ossh usage
expect 0 "*" "Test start"

source ossh

# ============================================================================
# T-OSSH-REMOTE-PRELUDE: one owner for "stand a remote/non-interactive shell up"
# ============================================================================
# A command over ssh (ossh exec), runuser/sudo -u or docker exec never runs
# .bashrc. It used to start with `[ -f ~/oosh/boot ] && . ~/oosh/boot || export
# PATH=…` — copied into ossh, user, os, odocker, c2 and the CI workflow — and
# the `&& … ||` form takes the fallback whenever sourcing returns non-zero
# (regression 5d06827). ossh.remote.prelude.get is the one text: POSIX, `if`,
# ~/config/user.env when present, else ~/oosh on PATH.
test.ossh.remotePrelude() {
  local fx bare bad="" p out; fx=$(test.suite.fixture.make prelude); bare=$(test.suite.fixture.make preludebare)
  mkdir -p "$fx/config"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export PATH="$HOME/oosh:$HOME/oosh/ng:$PATH"' > "$fx/config/user.env"
  p=$(ossh.remote.prelude.get)
  case "$p" in *"&&"*"||"*) bad="$bad and-or-chain" ;; esac
  out=$(env -i HOME="$fx" PATH=/usr/bin:/bin sh -c "$p"' printf "%s|%s" "$CONFIG_PATH" "${PATH%%:*}"' 2>/dev/null)
  [ "$out" = "$fx/config|$fx/oosh" ] || bad="$bad with-user.env=[$out]"
  out=$(env -i HOME="$bare" PATH=/usr/bin:/bin sh -c "$p"' printf "%s|%s" "$CONFIG_PATH" "${PATH%%:*}"' 2>/dev/null)
  [ "$out" = "|$bare/oosh" ] || bad="$bad without-user.env=[$out]"
  rm -rf "$fx" "$bare"
  [ -z "$bad" ] && create.result 0 "remote prelude: user.env when present, ~/oosh on PATH otherwise, POSIX, no && ||" || create.result 1 "remote prelude:$bad"
  return $(result)
}
test.case $level "T-OSSH-REMOTE-PRELUDE: ossh.remote.prelude.get stands a non-interactive shell up from user.env" test.ossh.remotePrelude
expect 0 "remote prelude: user.env when present, ~/oosh on PATH otherwise, POSIX, no && ||" \
  "seven copies of a boot line, and the && || form hid a failing source"

# ============================================================================
# T-OSSH-CMD-NONINTERACTIVE: remote package installs carry the non-interactive
# prefix
# ============================================================================
# oo.cmd and oo.prereqs.install learned the apt/brew prefix table
# (private.oo.pm.env.get) in 6f4a8e9/85ef5b1; ossh.cmd — the REMOTE
# counterpart — still sent a bare `sudo $pmCmd $pkg`, so apt could hang on
# tzdata's "Geographic area:" exactly as oo.cmd used to, and
# ossh.harden.packages carried a fifth hand copy missing NEEDRESTART_SUSPEND.
# Drives both with private.ossh.ssh mocked to echo the string it would send.
test.ossh.cmdNonInteractive() {
  local out bad=""
  out=$(
    # `(pattern)`: bash before 5.2 reads a bare `pattern)` inside $( … ) as
    # its end — AlmaLinux 9's bash 5.1 (T-ALL-SCRIPTS-PARSE).
    private.ossh.ssh() { case "$*" in (*"command -v"*) return 1 ;; esac; echo "$*"; }
    ossh.pm.discover() { echo "apt-get install -y"; }
    ossh.cmd somehost tree 2>/dev/null
  )
  case "$out" in
    *"sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes apt-get install -y tree"*) ;;
    *) bad="$bad ossh.cmd=>[$out]" ;;
  esac
  # What goes in front of the remote package manager is oo's answer
  # (private.oo.pm.install.prefix.get): no sudo before brew (Homebrew refuses
  # it), sudo + env before apt-get, sudo before dnf and apk — as before.
  local pm want
  for pm in "brew install" "apt-get -y install" "dnf -y install" "apk add"; do
    case "$pm" in
      "brew install")       want="sudo" ;;
      "apt-get -y install") want="sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 LC_ALL=C.UTF-8 DEBCONF_NOWARNINGS=yes apt-get -y install tree" ;;
      *)                    want="sudo $pm tree" ;;
    esac
    out=$(
      private.ossh.ssh() { case "$*" in (*"command -v"*) return 1 ;; esac; echo "$*"; }
      ossh.pm.discover() { echo "$pm"; }
      ossh.cmd somehost tree 2>/dev/null
    )
    out=$(printf '%s' "$out" | tr -s ' ')   # a doubled space is not a different command
    case "$pm" in
      "brew install") case "$out" in *sudo*) bad="$bad brew-has-sudo=[$out]" ;; esac
                      case "$out" in *"brew install tree"*) ;; *) bad="$bad brew=[$out]" ;; esac ;;
      *) case "$out" in *"-tt somehost $want"|*"-tt somehost $want "*) ;; *) bad="$bad $pm=[$out]-want-[$want]" ;; esac ;;
    esac
  done
  out=$(
    private.ossh.ssh() { echo "$*"; }
    private.ossh.harden.preflight() { return 0; }
    ossh.harden.packages somehost 2>/dev/null
  )
  case "$out" in
    *"export DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1"*) ;;
    *) bad="$bad harden.packages=>[$out]" ;;
  esac
  if [ -n "$bad" ]; then
    create.result 1 "a remote package install can still prompt:$bad"
  else
    create.result 0 "ossh.cmd and ossh.harden.packages send the non-interactive prefix"
  fi
  return $(result)
}
test.case - "T-OSSH-CMD-NONINTERACTIVE: ossh.cmd and ossh.harden.packages run the remote PM non-interactively" \
  test.ossh.cmdNonInteractive
expect 0 "ossh.cmd and ossh.harden.packages send the non-interactive prefix" \
  "the remote counterpart of oo cmd sent a bare sudo \$pmCmd — apt's tzdata prompt hangs it"

# T-OSSH-INSTALL-HOST-NAME: a local install names the computer through private.config.host.name.get
test.ossh.installHostName() {
  local body bad=""; body=$(declare -f ossh.install.continue.local)
  case "$body" in *private.config.host.name.get*) ;; *) bad="$bad no-getter" ;; esac
  case "$body" in *'sshConfigNameUsedForLocal="$HOSTNAME"'*) bad="$bad raw-HOSTNAME" ;; esac
  [ -z "$bad" ] && create.result 0 "the install names the computer through the getter" || create.result 1 "install host name:$bad"
  return $(result)
}
test.case $level "T-OSSH-INSTALL-HOST-NAME: a local install names the computer through the getter, not \$HOSTNAME" test.ossh.installHostName
expect 0 "the install names the computer through the getter" "\$HOSTNAME is a container's ID"

# T-OSSH-KEY-NAME-NO-HOSTNAME: the SSH key name carries the computer name without the hostname program
# The key name is <user>.<hostname -f>. AlmaLinux 9's minimal image has no
# hostname program, so the name part came out empty ("someone."). Without the
# program the name comes from the kernel (private.this.host.name.get full, the
# HOSTNAME of bash); with it the name stays byte-identical — existing keys are
# found by that name. The expected names with a hostname stub were captured
# from the code before the change. Both sites: private.ossh.get.key.name and
# private.ossh.set.key.name without a name. config save writes to a fixture.
test.ossh.keyNameNoHostname() {
  local fx bad="" got
  fx=$(test.suite.fixture.make test.ossh.keyNameNoHostname)
  test.ossh.keyNameNoHostname.run() { # <box|gha|none> — echo "<get name>|<set name>" with that hostname program
    M="$1" FX="$fx" LOG_LEVEL=1 bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/ossh" >/dev/null 2>&1
      export CONFIG_PATH="$FX" USER=someone LOG_LEVEL=1; unset SSH_KEY_NAME OOSH_SSH_CONFIG_HOST
      HOSTNAME=alma9.example.org
      case "$M" in
        box)  hostname() { [ "$1" = -f ] && echo box.example.org; } ;;
        gha)  hostname() { [ "$1" = -f ] && echo "sat12-bq160 ssh.runner.example"; } ;;
        none) command()  { [ "$1 $2" = "-v hostname" ] && return 1; builtin command "$@"; }
              hostname() { return 127; } ;;   # the program is not there
      esac
      get=$(private.ossh.get.key.name 2>/dev/null)
      unset SSH_KEY_NAME; private.ossh.set.key.name >/dev/null 2>&1
      printf "%s|%s" "$get" "$SSH_KEY_NAME"' 2>/dev/null </dev/null
  }
  got=$(test.ossh.keyNameNoHostname.run none)
  [ "$got" = "someone.alma9.example.org|someone.alma9.example.org" ] || bad="$bad no-hostname=[$got]"
  got=$(test.ossh.keyNameNoHostname.run box)
  [ "$got" = "someone.box.example.org|someone.box.example.org" ] || bad="$bad box-changed=[$got]"
  got=$(test.ossh.keyNameNoHostname.run gha)
  [ "$got" = "someone.sat12-bq160ssh.runner.example|someone.sat12-bq160ssh.runner.example" ] || bad="$bad gha-changed=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the key name carries the computer name with and without hostname" || create.result 1 "key name:$bad"
  return $(result)
}
test.case $level "T-OSSH-KEY-NAME-NO-HOSTNAME: without the hostname program the SSH key name carries HOSTNAME; with it the name is unchanged" test.ossh.keyNameNoHostname
expect 0 "the key name carries the computer name with and without hostname" \
  "AlmaLinux minimal has no hostname program — the key name was <user>. with an empty computer part"


# ============================================================================
# T-OSSH-INSTALL-BRANCH-ENV: ossh install pushes the installer and the branch of OSSH_INSTALL_BRANCH
# ============================================================================
# os platform.test <branch> exports OSSH_INSTALL_BRANCH around its two ossh
# install calls so an older ref is installed first; ossh read neither — this
# tree's init/oosh and this tree's branch were always pushed. Fixture repo:
# main with init/oosh "installer main" plus an uncommitted "installer
# worktree", and a ref known only as origin/old with "installer old".
# private.ossh.ssh records each command and what was piped into it; the push
# (private.push.init.oosh) runs with the connection, the key, the identity,
# the config and the finish step stubbed — no network, no real ~/.ssh.
test.ossh.installBranchEnv.fixture() { # <fx> # the fixture repo <fx>/repo: main, origin/old (no local old), an uncommitted init/oosh; echoes the sha of main
  local fx="$1"
  git init -q -b main "$fx/repo"; mkdir -p "$fx/repo/init" "$fx/ssh/public_keys"
  printf 'installer main\n' > "$fx/repo/init/oosh"
  git -C "$fx/repo" add init/oosh; git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q -m main
  git -C "$fx/repo" checkout -q -b old; printf 'installer old\n' > "$fx/repo/init/oosh"
  git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q -am old
  git -C "$fx/repo" update-ref refs/remotes/origin/old old; git -C "$fx/repo" update-ref refs/remotes/origin/main main
  # stale: origin/stale says "installer stale origin", the local stale moved on — the host clones origin
  git -C "$fx/repo" checkout -q -b stale main; printf 'installer stale origin\n' > "$fx/repo/init/oosh"
  git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q -am stale-origin
  git -C "$fx/repo" update-ref refs/remotes/origin/stale stale
  printf 'installer stale local\n' > "$fx/repo/init/oosh"
  git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q -am stale-local
  git -C "$fx/repo" checkout -q main; git -C "$fx/repo" branch -q -D old
  printf 'installer worktree\n' > "$fx/repo/init/oosh"
  : > "$fx/ssh/public_keys/key.public_key"; : > "$fx/config.env"
  git -C "$fx/repo" rev-parse main
}
test.ossh.installBranchEnv.run() { # <fx> <?branch> # echo the PUSH>…< and RUN>…< lines of one private.push.init.oosh with OSSH_INSTALL_BRANCH=<branch> (unset when empty)
  local fx="$1" branch="$2"
  (
    # ogit is loaded before OOSH_DIR moves to the fixture repo (it has no scripts)
    private.this.script.load ogit ogit.branch.get; private.this.script.load ogit ogit.file.show
    private.this.script.load ogit ogit.branch.check
    OOSH_DIR="$fx/repo"; CONFIG="$fx/config.env"; sshConfigHost=somehost
    unset OSSH_INSTALL_TARGET_USER OOSH_SSH_CONFIG_HOST OSSH_INSTALL_LOG_LEVEL OSSH_INSTALL_BRANCH
    [ -n "$branch" ] && export OSSH_INSTALL_BRANCH="$branch"
    private.get.sshDir() { RESULT="$fx/ssh"; }
    private.ossh.get.file.name() { echo key; }
    ossh.connection.open() { :; }; private.ossh.identity.stage() { :; }
    ossh.install.finish.local() { :; }; config() { :; }
    private.ossh.ssh() {
      case "$*" in
        (*state.machine.env*|*"[ -d ~/oosh ]"*) return 1 ;;
        (*"cat > ~/oosh"*) echo "PUSH>$(cat)<" ;;
        (*"cat > "*) cat >/dev/null ;;
        (*) echo "RUN>$*<" ;;
      esac
    }
    private.push.init.oosh 2>/dev/null
  ) </dev/null | grep -E '^(PUSH|RUN)>'
}
test.ossh.installBranchEnv() {
  local fx bad="" out
  fx=$(test.suite.fixture.make osshinstallbranchenv)
  test.ossh.installBranchEnv.fixture "$fx" >/dev/null
  out=$(test.ossh.installBranchEnv.run "$fx" "")
  case "$out" in *"PUSH>installer worktree<"*) ;; *) bad="$bad unset-push=[$out]" ;; esac
  case "$out" in *"RUN>-tt somehost ./oosh mode root somehost _ main 1<"*) ;; *) bad="$bad unset-run=[$out]" ;; esac
  out=$(test.ossh.installBranchEnv.run "$fx" old)
  case "$out" in *"PUSH>installer old<"*) ;; *) bad="$bad old-push=[$out]" ;; esac
  case "$out" in *"RUN>-tt somehost ./oosh mode root somehost _ old 1<"*) ;; *) bad="$bad old-run=[$out]" ;; esac
  out=$(test.ossh.installBranchEnv.run "$fx" stale)
  case "$out" in *"PUSH>installer stale origin<"*) ;; *) bad="$bad stale-local-won=[$out]" ;; esac
  out=$( OSSH_INSTALL_BRANCH=old; OOSH_DIR="$fx/repo"; private.ossh.install.branch.get )
  [ "$out" = old ] || bad="$bad branch.get=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the push carries the installer and the branch of OSSH_INSTALL_BRANCH, this tree's when unset" || create.result 1 "install branch:$bad"
  return $(result)
}
test.case $level "T-OSSH-INSTALL-BRANCH-ENV: ossh install pushes the init/oosh and the branch of OSSH_INSTALL_BRANCH, this tree's when unset" \
  test.ossh.installBranchEnv
expect 0 "the push carries the installer and the branch of OSSH_INSTALL_BRANCH, this tree's when unset" \
  "os platform.test exported OSSH_INSTALL_BRANCH and ossh pushed this tree's installer and branch anyway"

# T-OSSH-INSTALL-LOCAL: OSSH_INSTALL_LOCAL=1 installs this tree — the working-tree init/oosh and a
# bundle of the committed branch as OOSH_REPO of the remote installer, the bundle removed afterwards
# The remote installer clones a branch on origin: a branch that is not pushed (the one a platform
# test proves, the fresh install the heal is compared with) could not be installed at all. With
# OSSH_INSTALL_LOCAL=1 ossh install ships it as OOSH_HEAL_LOCAL=1 ships a heal: the bundle of
# private.ossh.bundle.push (stubbed here, recording), `env OOSH_REPO=<bundle> ./oosh mode root …`,
# then `rm -f <bundle>`; the origin check is not asked (the branch need not be on origin), and a
# failed bundle stops the install before the installer runs.
test.ossh.installLocal() {
  local fx bad="" out B=/tmp/oosh-install-bundle.Q1w2E3
  fx=$(test.suite.fixture.make osshinstalllocal)
  test.ossh.installBranchEnv.fixture "$fx" >/dev/null
  # the stub lives in the subshells of the runs only: the real private.ossh.bundle.push stays for the tests after this one
  test.ossh.installLocal.run() { ( private.ossh.bundle.push() { echo "BUNDLE>$*<"; [ -n "$FX_BUNDLEFAIL" ] && { create.result 1 "stubbed failure"; return 1; }; create.result 0 "$B"; }; test.ossh.installBranchEnv.run "$@" ); }
  out=$(OSSH_INSTALL_LOCAL=1 test.ossh.installLocal.run "$fx" ""; OSSH_INSTALL_LOCAL=1 test.ossh.installLocal.run "$fx" stale)
  case "$out" in *"PUSH>installer worktree<"*) ;; *) bad="$bad local-push=[$out]" ;; esac
  case "$out" in *"RUN>-tt somehost env OOSH_REPO='$B' ./oosh mode root somehost _ main 1<"*) ;; *) bad="$bad local-run=[$out]" ;; esac
  case "$out" in *"RUN>-n somehost rm -f '$B'<"*) ;; *) bad="$bad local-no-rm=[$out]" ;; esac
  case "$out" in *"PUSH>installer stale"*) bad="$bad branch-installer-not-worktree=[$out]" ;; esac
  case "$out" in *"RUN>-tt somehost env OOSH_REPO='$B' ./oosh mode root somehost _ stale 1<"*) ;; *) bad="$bad local-branch-run=[$out]" ;; esac
  out=$(FX_BUNDLEFAIL=1 OSSH_INSTALL_LOCAL=1 test.ossh.installLocal.run "$fx" "")
  case "$out" in *"mode root"*) bad="$bad ran-without-bundle=[$out]" ;; esac
  out=$(test.ossh.installLocal.run "$fx" "")
  case "$out" in *OOSH_REPO*|*rm\ -f*) bad="$bad unset-carries-bundle=[$out]" ;; esac
  # the origin check is not asked under OSSH_INSTALL_LOCAL=1: a local-only branch reaches the push
  out=$(
    OOSH_DIR="$fx/repo"
    ossh.config.parse() { echo "PARSE $*"; }
    private.ossh.origin.branch.check() { echo CHECKED; return 1; }
    OSSH_INSTALL_LOCAL=1 OSSH_INSTALL_BRANCH=localonly ossh.install somehost 2>/dev/null; echo "rc=$?"
  )
  case "$out" in *CHECKED*|*rc=1*) bad="$bad local-origin-checked=[$out]" ;; esac
  case "$out" in *"PARSE somehost private.push.init.oosh"*) ;; *) bad="$bad local-not-parsed=[$out]" ;; esac
  unset -f test.ossh.installLocal.run
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the working-tree installer, the bundle as OOSH_REPO, removed afterwards; no origin check; no run without the bundle" || create.result 1 "install local:$bad"
  return $(result)
}
test.case $level "T-OSSH-INSTALL-LOCAL: OSSH_INSTALL_LOCAL=1 installs this tree: the working-tree installer and a bundle of the branch as OOSH_REPO" \
  test.ossh.installLocal
expect 0 "the working-tree installer, the bundle as OOSH_REPO, removed afterwards; no origin check; no run without the bundle" \
  "an unpushed branch could not be installed in a platform container: the installer cloned origin"

# T-OSSH-INSTALL-USER-REMOTE-BRANCH: ossh install <host> <user> sets the user up on the branch of OSSH_INSTALL_BRANCH
# os platform.heal.test installs dev from a dev.heal tree: the push honoured
# OSSH_INSTALL_BRANCH, but ossh.install.user.remote took this tree's branch —
# it looked for <base>/dev.heal/user, absent in the container, and bash-user
# got no oosh (bash-user=127, test.suite: command not found). The branch is
# private.ossh.install.branch.get's. private.ossh.ssh records each command; the
# remote base answers /home, the shared user script is there, nothing else runs.
test.ossh.installUserRemoteBranch() {
  local bad="" out base=/home/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh
  out=$( (
    export OSSH_INSTALL_BRANCH=oldbranch LOG_DEVICE=/dev/null HOME=/nonexistent
    private.ossh.ssh() {
      [ "$1" = -tt ] && shift
      shift; printf 'CMD>%s<\n' "$*" | tr '\n' ' ' >&2; echo >&2
      case "$*" in (*OSTYPE*) echo /home ;; esac
      return 0
    }
    ossh.install.user.remote somehost bash-user >/dev/null
  ) 2>&1 | grep -a '^CMD>' )
  case "$out" in *"[ -x '$base/oldbranch/user' ]"*) ;; *) bad="$bad user-script-not-of-oldbranch" ;; esac
  case "$out" in *"user oosh.install bash-user oldbranch"*) ;; *) bad="$bad install-not-oldbranch" ;; esac
  [ -z "$bad" ] && create.result 0 "the shared user script and user oosh.install of OSSH_INSTALL_BRANCH" || create.result 1 "install user remote:$bad out=[$(printf '%s' "$out" | head -c 600)]"
  return $(result)
}
test.case $level "T-OSSH-INSTALL-USER-REMOTE-BRANCH: ossh install <host> <user> sets the user up on the branch of OSSH_INSTALL_BRANCH, not this tree's" \
  test.ossh.installUserRemoteBranch
expect 0 "the shared user script and user oosh.install of OSSH_INSTALL_BRANCH" \
  "os platform.heal.test installed dev from a dev.heal tree and bash-user got no oosh"

# T-OSSH-INSTALL-BRANCH-REFUSED: a value origin does not list as a branch is refused before any connection
# The remote installer clones a BRANCH (git clone -b); a commit sha cannot be
# cloned that way. ossh.install refuses it with rc 1 and says the platform test
# must ship it as a temporary branch — ossh.config.parse (the connection) is
# never reached. A branch on origin (here only as origin/old) passes. A miss
# fetches origin once (a local bare repo here, no network) and checks again:
# a branch pushed after the last fetch (late) passes.
test.ossh.installBranchRefused() {
  local fx bad="" out sha
  fx=$(test.suite.fixture.make osshinstallbranchrefused)
  sha=$(test.ossh.installBranchEnv.fixture "$fx")
  git init -q --bare "$fx/origin.git"; git -C "$fx/repo" push -q "$fx/origin.git" main:late 2>/dev/null
  git -C "$fx/repo" remote add origin "$fx/origin.git"
  out=$(
    private.this.script.load ogit ogit.branch.check; private.this.script.load ogit ogit.remote.fetch
    OOSH_DIR="$fx/repo"
    ossh.config.parse() { echo "PARSE $*"; }
    OSSH_INSTALL_BRANCH=late ossh.install somehost 2>/dev/null; echo "late-rc=$?"
    OSSH_INSTALL_BRANCH="$sha" ossh.install somehost 2>/dev/null; echo "sha-rc=$? result=[$RESULT]"
    OSSH_INSTALL_BRANCH=old ossh.install somehost 2>/dev/null; echo "old-rc=$?"
  )
  case "$out" in *"sha-rc=1 result=["*"not a branch on origin"*"temporary branch"*"ogit remote.fetch"*"]"*) ;; *) bad="$bad sha=[$out]" ;; esac
  [ "$(printf '%s\n' "$out" | grep -c '^PARSE')" = 2 ] || bad="$bad parse-count=[$out]"
  case "$out" in *"PARSE somehost private.push.init.oosh"*"late-rc=0"*) ;; *) bad="$bad late-not-fetched=[$out]" ;; esac
  case "$out" in *"PARSE somehost private.push.init.oosh"*"old-rc=0"*) ;; *) bad="$bad old=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a sha is refused before any connection, a branch on origin passes" || create.result 1 "install branch refusal:$bad"
  return $(result)
}
test.case $level "T-OSSH-INSTALL-BRANCH-REFUSED: an OSSH_INSTALL_BRANCH that is no branch on origin is refused with rc 1, before any connection" \
  test.ossh.installBranchRefused
expect 0 "a sha is refused before any connection, a branch on origin passes" \
  "the remote clones a branch — a sha would fail inside the container, after the connection"


# ============================================================================
# T-OSSH-HEAL-PUSH-TARGET: ossh heal is the curl form over ssh — a temp file, the heal arm, the rc
# ============================================================================
# The heal must run from another machine (the Mac reaching the container over
# ssh). ossh install's push writes ~/oosh and skips a host at state 99 or with a
# ~/oosh — exactly the hosts a heal is for, and ~/oosh may be a symlink into a
# tree. ossh.heal writes this tree's init/oosh to a fresh /tmp/oosh-heal-init.*
# (no probe, no skip), runs `sh <it> heal <branch> …` with -tt, passes the
# remote rc through unchanged and removes the temp files. OOSH_HEAL_LOCAL=1
# ships a bundle of the local <branch> and puts OOSH_REPO=<bundle> in the
# arm's environment. Only a clean LAST line of the remote stdout is a path
# (dotfile noise of a broken host). private.ossh.ssh and ossh.connection.open
# are stubbed and record; the bundle the stub receives is checked with git —
# no network (the fixture has no origin, so the one fetch fails at once).
test.ossh.healPushTarget.run() { # <fx> <rc> <args...> # ossh.heal <args> (FX_METHOD: another method, e.g. ossh.heal.pipe) with the remote heal answering <rc> (FX_NOISE=before|after|inside dirties the temp path answer); the recording goes to <fx>/rec, the pushed bytes to <fx>/pushed.*; echoes rc=<rc of ossh.heal>
  local fx="$1" fxRc="$2"
  shift 2
  : > "$fx/rec"; rm -f "$fx/pushed.init" "$fx/pushed.bundle"
  (
    # ogit is loaded before OOSH_DIR moves to the fixture repo (it has no scripts)
    private.this.script.load ogit ogit.branch.get; private.this.script.load ogit ogit.branch.check
    private.this.script.load ogit ogit.bundle.heads.create; private.this.script.load ogit ogit.remote.fetch
    OOSH_DIR="$fx/repo"
    ossh.connection.open() { echo "OPEN $*" >> "$fx/rec"; }
    test.ossh.healPushTarget.answer() { # <path> # the temp path as a host prints it, with FX_NOISE
      case "$FX_NOISE" in
        before) printf 'Welcome to the host\n%s\n' "$1" ;;
        after)  printf '%s\nlogout noise\n' "$1" ;;
        inside) printf '%s;touch x\n' "$1" ;;
        *)      printf '%s\n' "$1" ;;
      esac
    }
    private.ossh.ssh() {
      echo "SSH>$*<" >> "$fx/rec"
      case "$*" in
        (*"mktemp /tmp/oosh-heal-init."*)   cat > "$fx/pushed.init";   test.ossh.healPushTarget.answer /tmp/oosh-heal-init.AbC123 ;;
        (*"mktemp /tmp/oosh-heal-bundle."*) cat > "$fx/pushed.bundle"; [ -n "$FX_BUNDLEFAIL" ] && return 1; test.ossh.healPushTarget.answer /tmp/oosh-heal-bundle.XyZ789 ;;
        (*" heal "*) echo "REMOTE PASS/FAIL TABLE"; return "$fxRc" ;;
      esac
      return 0
    }
    "${FX_METHOD:-ossh.heal}" "$@" > "$fx/stdout" 2>/dev/null
    echo "rc=$?"
  ) </dev/null
}
test.ossh.healPushTarget.fixture() { # <fx> # the fixture repo <fx>/repo: main (ahead of origin/main), feat and origin/feat, a committed init/oosh
  local fx="$1"
  git init -q -b main "$fx/repo"; mkdir -p "$fx/repo/init"
  printf 'heal installer of this tree\n' > "$fx/repo/init/oosh"
  git -C "$fx/repo" add init/oosh; git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q -m main
  git -C "$fx/repo" branch feat; git -C "$fx/repo" update-ref refs/remotes/origin/feat feat
  # origin/main stays behind the local main: the bundle's main is origin's (the base clones main from it)
  git -C "$fx/repo" update-ref refs/remotes/origin/main main
  git -C "$fx/repo" -c user.email=t@t -c user.name=t commit -q --allow-empty -m local-ahead
}
test.ossh.healPushTarget() {
  local fx bad="" out rec heads I=/tmp/oosh-heal-init.AbC123 B=/tmp/oosh-heal-bundle.XyZ789
  fx=$(test.suite.fixture.make osshhealpushtarget)
  test.ossh.healPushTarget.fixture "$fx"
  # 1. one user, a branch, the remote answers 3: pushed to the temp file, rc 3 back
  out=$(test.ossh.healPushTarget.run "$fx" 3 somehost bob feat); rec=$(cat "$fx/rec")
  [ "$out" = rc=3 ] || bad="$bad user-rc=[$out]"
  case "$rec" in "OPEN somehost"*) ;; *) bad="$bad no-open=[$rec]" ;; esac
  [ "$(cat "$fx/pushed.init" 2>/dev/null)" = "heal installer of this tree" ] || bad="$bad pushed-text"
  case "$rec" in *"~/oosh"*|*state.machine*|*"[ -d"*) bad="$bad probes-or-home=[$rec]" ;; esac
  case "$rec" in *"SSH>-tt somehost if [ \"\$(id -un)\" = bob ]; then sh '$I' heal feat; else chmod 644 '$I' && sudo -H -u bob sh '$I' heal feat; fi; rc=\$?; rm -f '$I'; exit \$rc<"*) ;; *) bad="$bad user-run=[$rec]" ;; esac
  case "$rec" in *"heal feat all"*|*OOSH_REPO*|*bundle*) bad="$bad user-extra=[$rec]" ;; esac
  case "$rec" in *"SSH>-n somehost rm -f '$I'<"*) ;; *) bad="$bad user-no-cleanup" ;; esac
  case "$(cat "$fx/stdout")" in *"REMOTE PASS/FAIL TABLE"*) ;; *) bad="$bad table-not-shown" ;; esac
  # 2. defaults: user all, this tree's branch; the init file readable for every hop; ssh's 255 passes through
  out=$(test.ossh.healPushTarget.run "$fx" 255 somehost); rec=$(cat "$fx/rec")
  [ "$out" = rc=255 ] || bad="$bad default-rc=[$out]"
  case "$rec" in *"SSH>-tt somehost chmod 644 '$I' && sh '$I' heal main all; rc=\$?; rm -f '$I'; exit \$rc<"*) ;; *) bad="$bad default-run=[$rec]" ;; esac
  # 3. OOSH_HEAL_LOCAL=1, all: a bundle of feat, OOSH_REPO in the arm's environment, both readable, both removed
  out=$(OOSH_HEAL_LOCAL=1 test.ossh.healPushTarget.run "$fx" 0 somehost all feat); rec=$(cat "$fx/rec")
  [ "$out" = rc=0 ] || bad="$bad local-rc=[$out]"
  # the heal clones main AND <branch> from OOSH_REPO: both heads, main = origin/main, each clonable by name
  heads=$(git bundle list-heads "$fx/pushed.bundle" 2>/dev/null)
  case "$heads" in *refs/heads/feat*) ;; *) bad="$bad no-feat-in-bundle=[$heads]" ;; esac
  case "$heads" in *"$(git -C "$fx/repo" rev-parse origin/main) refs/heads/main"*) ;; *) bad="$bad main-not-origin-main=[$heads]" ;; esac
  git clone -q -b main "$fx/pushed.bundle" "$fx/c-main" 2>/dev/null || bad="$bad clone-main"
  git clone -q -b feat "$fx/pushed.bundle" "$fx/c-feat" 2>/dev/null || bad="$bad clone-feat"
  case "$rec" in *"SSH>-tt somehost chmod 644 '$I' '$B' && env OOSH_REPO='$B' sh '$I' heal feat all; rc=\$?; rm -f '$I' '$B'; exit \$rc<"*) ;; *) bad="$bad local-run=[$rec]" ;; esac
  case "$rec" in *"SSH>-n somehost rm -f '$I' '$B'<"*) ;; *) bad="$bad local-no-cleanup" ;; esac
  # 4. OOSH_HEAL_LOCAL=1, one user: the id -un arm and the sudo arm both carry OOSH_REPO, both files readable
  out=$(OOSH_HEAL_LOCAL=1 test.ossh.healPushTarget.run "$fx" 0 somehost bob feat); rec=$(cat "$fx/rec")
  case "$rec" in *"SSH>-tt somehost if [ \"\$(id -un)\" = bob ]; then env OOSH_REPO='$B' sh '$I' heal feat; else chmod 644 '$I' '$B' && sudo -H -u bob env OOSH_REPO='$B' sh '$I' heal feat; fi; rc=\$?; rm -f '$I' '$B'; exit \$rc<"*) ;; *) bad="$bad local-user-run=[$rec]" ;; esac
  # 5. OOSH_HEAL_LOCAL=1 without a local branch: rc 2 and nothing sent at all (the branch is checked before the first call)
  out=$(OOSH_HEAL_LOCAL=1 test.ossh.healPushTarget.run "$fx" 0 somehost all nobranch); rec=$(cat "$fx/rec")
  [ "$out" = rc=2 ] || bad="$bad nolocal-rc=[$out]"
  [ -z "$(printf '%s\n' "$rec" | grep '^SSH>')" ] || bad="$bad nolocal-ssh=[$rec]"
  # 5b. the bundle cannot be written: rc 2, and the init file already on the host is removed again
  out=$(FX_BUNDLEFAIL=1 OOSH_HEAL_LOCAL=1 test.ossh.healPushTarget.run "$fx" 0 somehost all feat); rec=$(cat "$fx/rec")
  [ "$out" = rc=2 ] || bad="$bad bundlefail-rc=[$out]"
  case "$rec" in *"SSH>-n somehost rm -f '$I'<"*) ;; *) bad="$bad bundlefail-no-rm=[$rec]" ;; esac
  case "$rec" in *" heal "*) bad="$bad bundlefail-ran=[$rec]" ;; esac
  # 6. words that are no names, a host with a leading dash: rc 2, nothing sent
  for args in "somehost bob all" "somehost bob origin/all" "somehost a;b feat" "somehost -bob feat" "somehost bob -feat" "-oProxyCommand=x bob feat" "somehost b@b feat"; do
    out=$(test.ossh.healPushTarget.run "$fx" 0 $args); rec=$(cat "$fx/rec")
    { [ "$out" = rc=2 ] && [ -z "$rec" ]; } || bad="$bad refused[$args]=[$out|$rec]"
  done
  # 7. a noisy host: a line before the path is ignored; a line after it, or junk in it, is no path — rc 2, no run
  out=$(FX_NOISE=before test.ossh.healPushTarget.run "$fx" 0 somehost); rec=$(cat "$fx/rec")
  { [ "$out" = rc=0 ] && case "$rec" in *"sh '$I' heal main all; rc="*) true ;; *) false ;; esac; } || bad="$bad noise-before=[$out|$rec]"
  case "$rec" in *Welcome*) bad="$bad noise-in-command" ;; esac
  for noise in after inside; do
    out=$(FX_NOISE=$noise test.ossh.healPushTarget.run "$fx" 0 somehost); rec=$(cat "$fx/rec")
    [ "$out" = rc=2 ] || bad="$bad noise-$noise-rc=[$out]"
    case "$rec" in *" heal "*|*noise*|*touch*) bad="$bad noise-$noise-used=[$rec]" ;; esac
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the heal goes to a temp file, runs the heal arm, returns the remote rc; the bundle only with OOSH_HEAL_LOCAL=1" || create.result 1 "heal push:$bad"
  return $(result)
}
test.case $level "T-OSSH-HEAL-PUSH-TARGET: ossh heal pushes init/oosh to /tmp/oosh-heal-init.*, never ~/oosh, runs heal <branch> <user>, passes the rc through; a bundle only with OOSH_HEAL_LOCAL=1" \
  test.ossh.healPushTarget
expect 0 "the heal goes to a temp file, runs the heal arm, returns the remote rc; the bundle only with OOSH_HEAL_LOCAL=1" \
  "ossh install's push writes ~/oosh and skips exactly the hosts a heal is for"



# T-OSSH-HEAL-PIPE: ossh heal.pipe runs the pure pipe form — cat <file> | sh -s -- heal <branch>
# The scenario test runs the curl form exactly as a user types it (the pipe,
# as the login user, no sudo) in a container; it called ossh's privates to do
# it. ossh.heal.pipe is the public method: the same push, the same temp files,
# the run line `cat '<f>' | [env OOSH_REPO='<b>'] sh -s -- heal <branch>`, the
# remote rc unchanged, the temp files removed. The stubbed runner of
# T-OSSH-HEAL-PUSH-TARGET records it.
test.ossh.healPipe() {
  local fx bad="" out rec I=/tmp/oosh-heal-init.AbC123 B=/tmp/oosh-heal-bundle.XyZ789
  fx=$(test.suite.fixture.make osshhealpipe)
  test.ossh.healPushTarget.fixture "$fx"
  # 1. a branch, the remote answers 4
  out=$(FX_METHOD=ossh.heal.pipe test.ossh.healPushTarget.run "$fx" 4 somehost feat); rec=$(cat "$fx/rec")
  [ "$out" = rc=4 ] || bad="$bad rc=[$out]"
  case "$rec" in *"SSH>-tt somehost cat '$I' | sh -s -- heal feat<"*) ;; *) bad="$bad run=[$rec]" ;; esac
  case "$rec" in *sudo*|*" all"*|*OOSH_REPO*) bad="$bad extra=[$rec]" ;; esac
  case "$rec" in *"SSH>-n somehost rm -f '$I'<"*) ;; *) bad="$bad no-cleanup=[$rec]" ;; esac
  # 2. this tree's branch by default; ssh's 255 passes through
  out=$(FX_METHOD=ossh.heal.pipe test.ossh.healPushTarget.run "$fx" 255 somehost); rec=$(cat "$fx/rec")
  [ "$out" = rc=255 ] || bad="$bad default-rc=[$out]"
  case "$rec" in *"SSH>-tt somehost cat '$I' | sh -s -- heal main<"*) ;; *) bad="$bad default-run=[$rec]" ;; esac
  # 3. OOSH_HEAL_LOCAL=1: the bundle is OOSH_REPO of sh, both temp files removed
  out=$(OOSH_HEAL_LOCAL=1 FX_METHOD=ossh.heal.pipe test.ossh.healPushTarget.run "$fx" 0 somehost feat); rec=$(cat "$fx/rec")
  [ "$out" = rc=0 ] || bad="$bad local-rc=[$out]"
  case "$rec" in *"SSH>-tt somehost cat '$I' | env OOSH_REPO='$B' sh -s -- heal feat<"*) ;; *) bad="$bad local-run=[$rec]" ;; esac
  case "$rec" in *"SSH>-n somehost rm -f '$I' '$B'<"*) ;; *) bad="$bad local-no-cleanup=[$rec]" ;; esac
  # 4. no branch name, a host with a leading dash: rc 2, nothing sent
  for args in "somehost all" "somehost -feat" "somehost a;b" "-oX feat"; do
    out=$(FX_METHOD=ossh.heal.pipe test.ossh.healPushTarget.run "$fx" 0 $args); rec=$(cat "$fx/rec")
    { [ "$out" = rc=2 ] && [ -z "$rec" ]; } || bad="$bad refused[$args]=[$out|$rec]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "heal.pipe runs cat <file> | sh -s -- heal <branch>, returns the remote rc, removes the temp files" || create.result 1 "heal pipe:$bad"
  return $(result)
}
test.case $level "T-OSSH-HEAL-PIPE: ossh heal.pipe runs cat <file> | [env OOSH_REPO=<bundle>] sh -s -- heal <branch> as the login user, passes the rc through, removes the temp files" \
  test.ossh.healPipe
expect 0 "heal.pipe runs cat <file> | sh -s -- heal <branch>, returns the remote rc, removes the temp files" \
  "the scenario test called ossh's private heal.push and heal.bundle.push from os"


console.log "
Test: private.ossh.remote.file.put
===================================================================="

# T-OSSH-REMOTE-FILE-PUT: stdin goes to a new mktemp file <prefix>.XXXXXX in /tmp of the host
# through the one ssh runner; the path is the clean last line of the answer, a half-written
# file of a failed run is removed, a host or prefix that is no name is refused before any call.
test.ossh.remoteFilePut() {
  local fx bad="" out rec; fx=$(test.suite.fixture.make osshremotefileput)
  # the stubbed runner records its words and keeps the bytes it was fed; FX_ANSWER and FX_SSHRC steer it
  test.ossh.remoteFilePut.run() { # <host> <prefix> # echo rc=<rc> RESULT=<result> of one put of "payload" with the runner stubbed
    (
      private.ossh.ssh() { echo "SSH>$*<" >> "$fx/rec"; case "$*" in (*mktemp*) cat > "$fx/pushed"; printf '%b' "$FX_ANSWER"; return "${FX_SSHRC:-0}" ;; esac; return 0; }
      private.ossh.remote.file.put "$1" "$2" < "$fx/payload" >/dev/null 2>&1
      echo "rc=$? RESULT=[$RESULT]"
    )
  }
  printf payload > "$fx/payload"
  : > "$fx/rec"
  out=$(FX_ANSWER='/tmp/oosh-heal-init.AbC123\n' test.ossh.remoteFilePut.run somehost oosh-heal-init); rec=$(cat "$fx/rec")
  [ "$out" = "rc=0 RESULT=[/tmp/oosh-heal-init.AbC123]" ] || bad="$bad clean=[$out]"
  [ "$(cat "$fx/pushed" 2>/dev/null)" = payload ] || bad="$bad bytes=[$(cat "$fx/pushed" 2>/dev/null)]"
  case "$rec" in *"SSH>somehost "*"mktemp /tmp/oosh-heal-init.XXXXXX"*) ;; *) bad="$bad script=[$rec]" ;; esac
  out=$(FX_ANSWER='Welcome\n/tmp/oosh-heal-init.AbC123\n' test.ossh.remoteFilePut.run somehost oosh-heal-init)
  [ "$out" = "rc=0 RESULT=[/tmp/oosh-heal-init.AbC123]" ] || bad="$bad noise-before=[$out]"
  : > "$fx/rec"
  out=$(FX_ANSWER='/tmp/oosh-heal-init.AbC123\nnoise\n' test.ossh.remoteFilePut.run somehost oosh-heal-init)
  case "$out" in rc=1*) ;; *) bad="$bad noise-after=[$out]" ;; esac
  out=$(FX_ANSWER='/tmp/oosh-heal-init.a/b\n' test.ossh.remoteFilePut.run somehost oosh-heal-init)
  case "$out" in rc=1*) ;; *) bad="$bad slash-in-name=[$out]" ;; esac
  # a failed copy whose answer still names a clean path: the file goes
  : > "$fx/rec"
  out=$(FX_SSHRC=1 FX_ANSWER='/tmp/oosh-heal-init.AbC123\n' test.ossh.remoteFilePut.run somehost oosh-heal-init); rec=$(cat "$fx/rec")
  case "$out" in rc=1*) ;; *) bad="$bad failed-rc=[$out]" ;; esac
  case "$rec" in *"rm -f '/tmp/oosh-heal-init.AbC123'"*) ;; *) bad="$bad failed-no-rm=[$rec]" ;; esac
  # refused before any call
  local args
  for args in "- oosh-heal-init" "somehost -x" "somehost a/b" "somehost a;b" "somehost x"; do
    : > "$fx/rec"
    out=$(FX_ANSWER='/tmp/x.AbC123\n' test.ossh.remoteFilePut.run $args); rec=$(cat "$fx/rec")
    case "$args" in "somehost x") [ -n "$rec" ] || bad="$bad plain-name-not-sent" ;; *) { case "$out" in rc=1*) true ;; *) false ;; esac && [ -z "$rec" ]; } || bad="$bad refused[$args]=[$out|$rec]" ;; esac
  done
  out=$(test.ossh.remoteFilePut.run "" oosh-heal-init); case "$out" in rc=1*) ;; *) bad="$bad nohost=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "remote.file.put: stdin lands in /tmp/<prefix>.XXXXXX, the clean last line is the path, a failed copy is removed, a bad host or prefix is refused before any call" || create.result 1 "remote.file.put:$bad"
  return $(result)
}
test.case $level "T-OSSH-REMOTE-FILE-PUT: stdin is copied to a new mktemp file of the host and the path comes back" test.ossh.remoteFilePut
expect 0 "remote.file.put: stdin lands in /tmp/<prefix>.XXXXXX, the clean last line is the path, a failed copy is removed, a bad host or prefix is refused before any call" "heal.push and the bundle push each carried their own copy of this script"


console.log "
Test: private.ossh.bundle.push
===================================================================="

# T-OSSH-BUNDLE-PUSH: the one bundle builder of ossh — main (origin/main) and the local branch,
# sent through private.ossh.remote.file.put under the given prefix; refused without a local branch
# and before any call without <host> <branch>. The fixture of T-OSSH-HEAL-PUSH-TARGET; the put is stubbed.
test.ossh.bundlePush() {
  local fx bad="" out heads
  fx=$(test.suite.fixture.make osshbundlepush)
  test.ossh.healPushTarget.fixture "$fx"
  out=$(
    private.this.script.load ogit ogit.branch.check; private.this.script.load ogit ogit.bundle.heads.create
    OOSH_DIR="$fx/repo"
    private.ossh.remote.file.put() { echo "PUT $*" >> "$fx/rec"; cat > "$fx/pushed.bundle"; create.result 0 "/tmp/$2.Zz9"; }
    private.ossh.bundle.push somehost feat oosh-install-bundle >/dev/null 2>&1; echo "feat rc=$? RESULT=[$RESULT]"
    private.ossh.bundle.push somehost nobranch >/dev/null 2>&1; echo "nobranch rc=$?"
    private.ossh.bundle.push somehost >/dev/null 2>&1; echo "noargs rc=$? RESULT=[$RESULT]"
  )
  case "$out" in *"feat rc=0 RESULT=[/tmp/oosh-install-bundle.Zz9]"*) ;; *) bad="$bad feat=[$out]" ;; esac
  case "$out" in *"nobranch rc=1"*) ;; *) bad="$bad nobranch=[$out]" ;; esac
  case "$out" in *"noargs rc=1 RESULT=[private.ossh.bundle.push requires <host> <branch>]"*) ;; *) bad="$bad noargs=[$out]" ;; esac
  [ "$(cat "$fx/rec" 2>/dev/null)" = "PUT somehost oosh-install-bundle" ] || bad="$bad puts=[$(cat "$fx/rec" 2>/dev/null)]"
  heads=$(git bundle list-heads "$fx/pushed.bundle" 2>/dev/null)
  case "$heads" in *"$(git -C "$fx/repo" rev-parse origin/main) refs/heads/main"*) ;; *) bad="$bad main-not-origin-main=[$heads]" ;; esac
  case "$heads" in *refs/heads/feat*) ;; *) bad="$bad no-feat=[$heads]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "main as origin/main and the local branch, sent under the prefix; no local branch or no arguments refused" || create.result 1 "bundle push:$bad"
  return $(result)
}
test.case $level "T-OSSH-BUNDLE-PUSH: the bundle carries main and the local branch and lands in a fresh temp file of the host" test.ossh.bundlePush
expect 0 "main as origin/main and the local branch, sent under the prefix; no local branch or no arguments refused" \
  "the heal and the local install each needed a bundle of the branch under test"

### test.method

# ============================================================================
# Test ossh.config.create - user@host parsing (bug fix #1)
# ============================================================================

test.case $level "ossh.config.create parses user@host correctly" \
  ossh.config.create test@testhost

# Verify Host line uses hostname only (not user@host)
HOST_LINE=$(grep "^Host " "$CONFIG_PATH/result.txt" 2>/dev/null | head -1)
if echo "$HOST_LINE" | grep -q "^Host testhost$"; then
  expect.pass "Host line is 'Host testhost' (no @ symbol)"
else
  expect.fail "Host line should be 'Host testhost', got: $HOST_LINE"
fi

test.case $level "ossh.config.create parses User from user@host" \
  ossh.config.create test@testhost

USER_LINE=$(grep "User " "$CONFIG_PATH/result.txt" 2>/dev/null | head -1)
if echo "$USER_LINE" | grep -q "User test$"; then
  expect.pass "User parsed as 'test'"
else
  expect.fail "User should be 'test', got: $USER_LINE"
fi

test.case $level "ossh.config.create parses HostName from user@host" \
  ossh.config.create test@testhost

HOSTNAME_LINE=$(grep "HostName " "$CONFIG_PATH/result.txt" 2>/dev/null | head -1)
if echo "$HOSTNAME_LINE" | grep -q "HostName testhost$"; then
  expect.pass "HostName parsed as 'testhost'"
else
  expect.fail "HostName should be 'testhost', got: $HOSTNAME_LINE"
fi

# ============================================================================
# Test private.config.create sets RESULT via create.result (bug fix #4)
# ============================================================================

test.case $level "config.create sets RESULT via create.result" \
  ossh.config.create test@testhost

if [ -n "$RESULT" ] && [ "$RESULT" = "testhost" ]; then
  expect.pass "RESULT set to 'testhost'"
else
  expect.fail "RESULT should be 'testhost', got: '$RESULT'"
fi

# ============================================================================
# Test ossh.config.save.last - writes clean entry (bug fix #2, #3)
# ============================================================================

# Use a temp file to avoid polluting real ~/.ssh/config
TEST_SSH_CONFIG=$(mktemp /tmp/test.ossh.config.XXXXXX)

# First, create a config entry
ossh.config.create test@testhost

test.case $level "ossh.config.save.last writes clean entry to file" \
  ossh.config.save.last "$TEST_SSH_CONFIG"

if grep -q "^Host testhost$" "$TEST_SSH_CONFIG" 2>/dev/null; then
  expect.pass "config.save.last wrote 'Host testhost' to file"
else
  expect.fail "config.save.last should write 'Host testhost' to file"
fi

# ============================================================================
# Test ossh.config.save.last - duplicate detection (bug fix #3)
# ============================================================================

# config.save.last was already called once above, so calling again should detect duplicate
test.case $level "ossh.config.save.last detects duplicate Host entry" \
  ossh.config.save.last "$TEST_SSH_CONFIG"

if [ "$RETURN_VALUE" -eq 1 ]; then
  expect.pass "config.save.last returned 1 for duplicate Host"
else
  expect.fail "config.save.last should return 1 for duplicate, got: $RETURN_VALUE"
fi

# Verify only one entry exists (no duplicate appended)
ENTRY_COUNT=$(grep -c "^Host testhost$" "$TEST_SSH_CONFIG" 2>/dev/null)
test.case $level "config.save.last did not append duplicate entry" \
  echo "$ENTRY_COUNT"

if [ "$ENTRY_COUNT" -eq 1 ]; then
  expect.pass "only 1 'Host testhost' entry in file"
else
  expect.fail "should have exactly 1 entry, found: $ENTRY_COUNT"
fi

# ============================================================================
# Cleanup
# ============================================================================

rm -f "$TEST_SSH_CONFIG" 2>/dev/null

# ============================================================================
# Test ossh.known.hosts.remove - requires host parameter
# ============================================================================

test.case $level "ossh.known.hosts.remove requires host parameter" \
  ossh.known.hosts.remove

if [ "$RETURN_VALUE" -eq 1 ]; then
  expect.pass "returns 1 when no host given"
else
  expect.fail "should return 1 when no host given, got: $RETURN_VALUE"
fi

# ============================================================================
# Test ossh.known.hosts.remove - function exists
# ============================================================================

test.case $level "ossh.known.hosts.remove is defined" \
  type ossh.known.hosts.remove

if type ossh.known.hosts.remove 2>/dev/null | grep -q "function"; then
  expect.pass "ossh.known.hosts.remove is a function"
else
  expect.fail "ossh.known.hosts.remove should be a function after sourcing ossh"
fi

# ============================================================================
# Test ossh.known.hosts.remove - handles missing known_hosts gracefully
# ============================================================================

TEST_HOME_BACKUP="$HOME"
TEST_TMP_HOME=$(mktemp -d /tmp/test.ossh.home.XXXXXX)
HOME="$TEST_TMP_HOME"

test.case $level "ossh.known.hosts.remove handles missing known_hosts" \
  ossh.known.hosts.remove testhost 8022

if [ "$RETURN_VALUE" -eq 0 ]; then
