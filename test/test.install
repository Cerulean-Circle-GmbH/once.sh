#!/usr/bin/env bash
# Tests for init/oosh — thin bootstrap contract. Asserts prereq guards,
# mode-root arg parsing, handoff to ossh install.continue.local, size
# shrink target, OOSH_SELF_BRANCH preservation, and the Install-oosh.command
# drag-and-drop wrapper.
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

INIT_SCRIPT="$OOSH_DIR/init/oosh"

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-BASH-PREREQ: init/oosh has a bash 4+ prereq guard with install hint
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-BASH-PREREQ: init/oosh errors out if bash major < 4" \
  echo "(grep)"
if grep -qE '! *oosh_bash_ok' "$INIT_SCRIPT" \
   && grep -qE 'bash 4\+' "$INIT_SCRIPT" \
   && grep -qE 'brew install bash' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has a bash 4+ prereq guard with macOS install hint"
else
  expect.fail "init/oosh missing bash 4+ prereq guard or install hint"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-GIT-PREREQ: init/oosh has a git prereq guard (post-refactor: simple
# `command -v git || die …` instead of the framed-error accumulator).
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-GIT-PREREQ: init/oosh errors out if git not on PATH" \
  echo "(grep)"
if grep -qE '! +command -v git +>/dev/null +2>&1; +then' "$INIT_SCRIPT" \
   && grep -qE 'die +"git missing' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has a thin git prereq guard with die-on-missing"
else
  expect.fail "init/oosh missing git prereq guard"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-MODE-ROOT-PARSE: `mode root` arg path preserved for ossh install
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-MODE-ROOT-PARSE: mode root arg path is preserved for ossh install compat" \
  echo "(grep)"
if grep -qE '\[ +"\$1" += +"mode" +\]' "$INIT_SCRIPT"; then
  expect.pass "init/oosh parses 'mode root' invocation"
else
  expect.fail "init/oosh dropped 'mode root' parsing — breaks ossh install"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-HANDS-OFF: init/oosh ends with exec ossh install.continue.local
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-HANDS-OFF: init/oosh hands off to ossh install.continue.local" \
  echo "(grep)"
if grep -qE '"\$OOSH_DIR/this" +call +ossh +install\.continue\.local' "$INIT_SCRIPT"; then
  expect.pass "init/oosh hands off to ossh install.continue.local"
else
  expect.fail "init/oosh missing handoff to install.continue.local"
fi

test.case $level "T-INIT-INSTALL-FOR-SUDO-USER: init/oosh installs oosh for SUDO_USER after state machine" \
  echo "(grep)"
if grep -qE 'SUDO_USER.*!=.*root' "$INIT_SCRIPT" \
   && grep -qE '"\$OOSH_DIR/user" +oosh\.install +"\$SUDO_USER"' "$INIT_SCRIPT"; then
  expect.pass "init/oosh runs user.oosh.install for SUDO_USER when non-root invoker sudo-re-exec'd"
else
  expect.fail "init/oosh missing post-install user.oosh.install for SUDO_USER — non-root curl won't set up the invoker"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SIZE-CAP: init/oosh stays bounded — ≤ 700 counted lines.
# The 700-line cap is a soft anti-bloat guard, not a thin-bootstrap target.
# A block leaves the count only when it is NAMED in the exempt list AND says
# why: `# BEGIN <name>`, then `# size-exception: <reason>` as the very next
# line, … `# END <name>`; the block is subtracted with its markers. The exempt
# lines together stay ≤ 15 (the ceiling). Any other block counts fully. Owner
# decision 2026-10-07: the heal arm is the one all-or-nothing block that must
# live in the file the curl form fetches.
# ─────────────────────────────────────────────────────────────────────────
TEST_INSTALL_SIZE_EXEMPT="healArm"
TEST_INSTALL_SIZE_CEILING=15
test.install.sizeCapCheck() # <file> <?exempt:$TEST_INSTALL_SIZE_EXEMPT> # rc 0 when <file>'s counted lines stay ≤ 700 and its exempt lines ≤ the ceiling; RESULT names the raw, the counted and the exempt lines
{
  local raw counted ex names="${2-$TEST_INSTALL_SIZE_EXEMPT}" cap=700 ceiling=$TEST_INSTALL_SIZE_CEILING
  # One pass over the lines: a `# BEGIN <name>` with <name> in the exempt list
  # whose NEXT line is a `# size-exception: <reason>` with a non-empty reason
  # opens a block that runs to its own `# END <name>`; its lines, markers
  # included, leave the count. An unclosed block subtracts nothing.
  read -r raw ex < <(awk -v names=" $names " '{ l[NR] = $0 }
    END {
      ex = 0
      for (i = 1; i <= NR; i++) {
        if (l[i] !~ /^# BEGIN [^ ]+$/ || l[i + 1] !~ /^# size-exception:[ ]*[^ ]/) continue
        name = substr(l[i], 9)
        if (index(names, " " name " ") == 0) continue
        end = "# END " name
        for (j = i + 2; j <= NR && l[j] != end; j++) ;
        if (j <= NR) { ex += j - i + 1; i = j }
      }
      print NR, ex
    }' "$1")
  counted=$((raw - ex))
  RESULT="init/oosh is $raw lines, $counted counted (cap $cap; $ex exempt lines in${names:+ $names}, ceiling $ceiling)"
  if [ "$ex" -gt "$ceiling" ]; then
    create.result 1 "$RESULT — over the $ceiling-line exemption ceiling"
  elif [ "$counted" -gt "$cap" ]; then
    create.result 1 "$RESULT — over the $cap-line anti-bloat cap"
  else
    create.result 0 "$RESULT"
  fi
  return $(result)
}

test.install.sizeCapFile() # <file> <filler> <blockName> <reason|-|none> <bodyLines> # write <filler> filler lines, then one BEGIN/END block: with the reason line, an empty one (-) or none
{
  local i
  { for ((i = 0; i < $2; i++)); do echo "echo filler"; done
    echo "# BEGIN $3"; [ "$4" = none ] || echo "# size-exception:${4#-}"
    for ((i = 0; i < $5; i++)); do echo "echo body"; done; echo "# END $3"; } > "$1"
}

# T-INIT-SIZE-CAP-FIXTURE: synthetic files of filler lines and one block —
# only a named block with a reason leaves the count, and the exempt lines
# have a ceiling.
test.install.sizeCapFixture() {
  local fx bad="" i rc
  fx=$(test.suite.fixture.make sizecap)
  test.install.sizeCapFile "$fx/named"   10 arm  " a reason" 3     # 10 + 6
  test.install.sizeCapFile "$fx/empty"   10 arm  -          3      # empty reason: counts
  test.install.sizeCapFile "$fx/noreason" 10 arm none       4      # no reason line: counts
  test.install.sizeCapFile "$fx/big"     10 arm  " a reason" 14    # 10 + 17: over the ceiling
  test.install.sizeCapFile "$fx/bloat"  695 arm  " a reason" 3     # 695 + 6
  test.install.sizeCapCheck "$fx/named" arm >/dev/null; rc=$?
  [ "$rc:$RESULT" = "0:init/oosh is 16 lines, 10 counted (cap 700; 6 exempt lines in arm, ceiling 15)" ] || bad="$bad named=[$rc:$RESULT]"
  test.install.sizeCapCheck "$fx/named" other >/dev/null; rc=$?
  [ "$rc:$RESULT" = "0:init/oosh is 16 lines, 16 counted (cap 700; 0 exempt lines in other, ceiling 15)" ] || bad="$bad unnamed=[$rc:$RESULT]"
  test.install.sizeCapCheck "$fx/empty" arm >/dev/null; rc=$?
  [ "$rc:$RESULT" = "0:init/oosh is 16 lines, 16 counted (cap 700; 0 exempt lines in arm, ceiling 15)" ] || bad="$bad empty=[$rc:$RESULT]"
  test.install.sizeCapCheck "$fx/noreason" arm >/dev/null; rc=$?
  [ "$rc:$RESULT" = "0:init/oosh is 16 lines, 16 counted (cap 700; 0 exempt lines in arm, ceiling 15)" ] || bad="$bad noreason=[$rc:$RESULT]"
  test.install.sizeCapCheck "$fx/big" arm >/dev/null; rc=$?
  case "$rc:$RESULT" in "1:init/oosh is 27 lines, 10 counted (cap 700; 17 exempt lines in arm, ceiling 15) — over the 15-line exemption ceiling") ;; *) bad="$bad big=[$rc:$RESULT]" ;; esac
  test.install.sizeCapCheck "$fx/bloat" other >/dev/null; rc=$?
  case "$rc:$RESULT" in "1:init/oosh is 701 lines, 701 counted (cap 700; 0 exempt lines in other, ceiling 15) — over the 700-line anti-bloat cap") ;; *) bad="$bad bloat=[$rc:$RESULT]" ;; esac
  test.install.sizeCapCheck "$fx/bloat" arm >/dev/null; rc=$?
  [ "$rc:$RESULT" = "0:init/oosh is 701 lines, 695 counted (cap 700; 6 exempt lines in arm, ceiling 15)" ] || bad="$bad bloat-named=[$rc:$RESULT]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "only a named block with a reason leaves the count, up to the ceiling" || create.result 1 "size cap:$bad"
  return $(result)
}
test.case $level "T-INIT-SIZE-CAP-FIXTURE: only a named size-exception block leaves the count, and the exempt lines have a ceiling" \
  test.install.sizeCapFixture
expect 0 "only a named block with a reason leaves the count, up to the ceiling" \
  "the size cap must subtract exactly the named blocks that say why, and no more than the ceiling"

test.case $level "T-INIT-SIZE-CAP: init/oosh is bounded (≤ 700 counted lines, ≤ 15 exempt lines in the named blocks)" \
  echo "(wc -l)"
if test.install.sizeCapCheck "$INIT_SCRIPT" >/dev/null; then
  expect.pass "$RESULT"
else
  expect.fail "$RESULT"
fi

# T-INIT-BASH-PATH-PREPEND (a grep for Phase B's _bashCandidate loop) is replaced by
# T-INIT-PHASE-A-BREW-PATH below: the brewPath block now prepends Homebrew's bin dirs before Phase A.

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SUDO-CURL-PIPE: sudo re-exec pre-clones when $0 isn't a real file
# ─────────────────────────────────────────────────────────────────────────
# When init/oosh is invoked via `sh -c "$(curl …/init/oosh)"` (the
# documented curl one-liner AND the Install oosh.command wrapper's
# no-sibling fallback), $0 is the literal "sh"/"bash", not a filesystem
# path. Without a no-real-file fallback, `exec sudo -H -E sh "$0" "$@"`
# makes the kernel treat "sh"/"bash" as a script name → PATH-resolves
# to /bin/sh → fails to read the binary with "cannot execute binary
# file" (exit 126). The fix: pre-clone the repo to a temp dir so we
# have a real init/oosh file to hand to sudo.
test.case $level "T-INIT-SUDO-CURL-PIPE: sudo re-exec pre-clones when \$0 isn't a real file" \
  echo "(grep)"
# Extract just the sudo re-exec block.
SUDO_REEXEC=$(awk '/Non-root.*sudo re-exec/{found=1} found{print; if(found && /^fi$/){exit}}' "$INIT_SCRIPT")
if printf "%s" "$SUDO_REEXEC" | grep -qE '\[ ! -f "\$0" \]' \
   && printf "%s" "$SUDO_REEXEC" | grep -qE 'mktemp -d' \
   && printf "%s" "$SUDO_REEXEC" | grep -qE 'git clone -b "\$OOSH_BRANCH"'; then
  expect.pass "init/oosh sudo re-exec handles curl-pipe (no-real-file) via pre-clone"
else
  expect.fail "init/oosh sudo re-exec missing no-real-file fallback — curl one-liner and drag-and-drop standalone .command will fail with 'cannot execute binary file'"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SELF-BRANCH-DEFAULT: OOSH_SELF_BRANCH preserved for promote rewrites
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-SELF-BRANCH-DEFAULT: OOSH_SELF_BRANCH default preserved" \
  echo "(grep)"
if grep -qE 'OOSH_SELF_BRANCH="\$\{OOSH_SELF_BRANCH:-[A-Za-z0-9_-]*\}"' "$INIT_SCRIPT"; then
  expect.pass "OOSH_SELF_BRANCH default preserved — promote will still rewrite on dev→testing→prod"
else
  expect.fail "OOSH_SELF_BRANCH pattern missing — promote.rewrite.self.branch would have no target to rewrite"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-DOT-COMMAND: Install oosh.command wrapper exists, executable, invokes init/oosh
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-DOT-COMMAND: Install oosh.command drag-and-drop wrapper present" \
  echo "(stat + grep)"
CMD="$OOSH_DIR/Install oosh.command"
if [ -x "$CMD" ] && grep -qE '\./init/oosh' "$CMD"; then
  expect.pass "Install oosh.command is executable and invokes ./init/oosh"
else
  expect.fail "Install oosh.command missing, not executable, or doesn't invoke init/oosh"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INSTALL-NO-FETCHER: with no curl/wget/fetch and no sibling init/oosh, the
# wrapper must fail LOUDLY. It used to run `sh -c "$(curl -fsSL "$url")"` —
# command-substituting a MISSING curl yields "", `sh -c ""` exits 0, and the
# wrapper printed "✓ Install complete." having installed nothing. Silence plus
# a green tick is the worst failure mode an installer can have. Reproduced
# 2026-09-21 on a naked ubuntu:24.04, which ships none of the three fetchers.
# ─────────────────────────────────────────────────────────────────────────
test.install.noFetcherFailsLoud() {
  local d
  d=$(test.suite.fixture.make nofetch) \
    || { create.result 1 "no fixture directory"; return $(result); }
  cp "$OOSH_DIR/Install oosh.command" "$d/Install oosh.command" || {
    rm -rf "$d"; create.result 1 "could not copy the wrapper"; return $(result); }
  chmod +x "$d/Install oosh.command"

  # A PATH holding the externals the wrapper needs and NO curl / wget / fetch.
  # `dirname` is NOT optional: the wrapper opens with `cd "$(dirname "$0")"`,
  # and without it that collapses to `cd ""`, which silently leaves the cwd
  # alone — the run then finds the REPO's ./init/oosh and tests nothing.
  mkdir -p "$d/bin"
  local b p
  for b in sh bash dirname mktemp rm cat wc; do
    p=$(type -P "$b" 2>/dev/null) && ln -s "$p" "$d/bin/$b"
  done

  # cd into $d so there is no ./init/oosh sibling -> the fetch branch is taken.
  # </dev/null feeds the trailing `read -r _` an EOF so this cannot hang the
  # suite; that is also why the wrapper must end in `exit "$rc"` — without it
  # the status would be read's, and this case would pass for the wrong reason.
  local out rc
  out=$(cd "$d" && env -i PATH="$d/bin" HOME="$HOME" TERM=dumb \
          "$d/Install oosh.command" </dev/null 2>&1)
  rc=$?
  rm -rf "$d" 2>/dev/null

  local flat
  flat=$(printf '%s' "$out" | tr '\n' '|')
  if [ "$rc" -eq 0 ]; then
    create.result 1 "no fetcher on PATH, yet the wrapper exited 0: [$flat]"
  elif [ "${out#*Install complete}" != "$out" ]; then
    create.result 1 "printed '✓ Install complete' having installed nothing: [$flat]"
  elif [ "${out#*No sibling init/oosh}" = "$out" ]; then
    create.result 1 "never reached the fetch branch — dirname/cwd rig is wrong, not the wrapper: [$flat]"
  elif [ "${out#*curl}" = "$out" ]; then
    create.result 1 "failed without naming a fetcher to install: [$flat]"
  else
    create.result 0 "a missing fetcher is a named, non-zero failure"
  fi
  return $(result)
}
test.case $level "T-INSTALL-NO-FETCHER: no curl/wget/fetch is a loud failure, not a green tick" \
  test.install.noFetcherFailsLoud
expect 0 "a missing fetcher is a named, non-zero failure" \
  "sh -c \"\$(curl …)\" with curl absent is sh -c \"\" — exit 0, nothing installed, ✓ printed"

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-NO-OLD-SCAFFOLDING: dead-weight bootstrap functions are gone
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-NO-OLD-SCAFFOLDING: old bootstrap functions removed" \
  echo "(grep -cE)"
if grep -qE 'oosh_check_all_pm|oosh_parse_shellps|oosh_install_remote|oosh_setup_env|oosh_status' "$INIT_SCRIPT"; then
  expect.fail "init/oosh still contains old bootstrap scaffolding (oosh_* functions)"
else
  expect.pass "init/oosh no longer contains old bootstrap scaffolding"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-PREREQS-LOCAL-INVOCATION: init/oosh hands off to `ossh prereqs.install`
# (local mode) BEFORE invoking the state-machine entrypoint. This is where
# rsync / tree / future post-clone deps install via the canonical `oo cmd`
# primitive — replaces the eager _oosh_install_one rsync/tree blocks that
# used to live in init/oosh's Phase B (removed in the 2026-05-08 minimal
# refactor; see memory project_init_oosh_minimal_refactor).
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-PREREQS-LOCAL-INVOCATION: init/oosh calls ossh prereqs.install (local mode) before state-machine handoff" \
  echo "(grep)"
if grep -qE '"\$OOSH_DIR/this" +call +ossh +prereqs\.install$|"\$OOSH_DIR/this" +call +ossh +prereqs\.install +\|\|' "$INIT_SCRIPT"; then
  expect.pass "init/oosh invokes ossh prereqs.install local mode (no host arg) before handoff"
else
  expect.fail "init/oosh missing ossh prereqs.install local-mode invocation — rsync/tree won't be installed post-clone"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-ALPINE-BUSYBOX-SUID : the curl/drag-and-drop install path runs init/oosh
# directly (no ossh.prereqs.install). For alpine targets, init/oosh must heal
# /bin/busybox suid bit after its sudo re-exec, otherwise post-install
# `user login <user>` from non-root fails with "su: must be suid to work properly".
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-ALPINE-BUSYBOX-SUID: init/oosh sets suid on /bin/busybox for apk hosts after sudo re-exec" \
  echo "(grep)"
if grep -qE 'command -v apk.*&&.*\[ -e /bin/busybox \]' "$INIT_SCRIPT" \
   && grep -qE 'chmod u\+s /bin/busybox' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has busybox-suid heal for alpine"
else
  expect.fail "init/oosh missing busybox-suid heal — curl/drag-and-drop install on alpine will leave user.login broken"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-INSTALL-* : the platform install logic that used to live in
# ossh.prereqs.install moved INTO init/oosh's POSIX prelude. These tests
# replicate the assertions that were previously in test.ossh against
# `declare -f ossh.prereqs.install`, but now read init/oosh's body directly.
# Same coverage, new home — single source of truth.
# ─────────────────────────────────────────────────────────────────────────────

# T-INIT-INSTALL-PM-DETECT: PM detection covers brew + apt-get + dnf + yum +
# apk + pacman + pkg, mirroring ossh.pm.discover.
test.case $level "T-INIT-INSTALL-PM-DETECT: prelude PM detection covers all supported managers" \
  echo "(grep)"
if grep -qE 'for _pm in brew apt-get dnf yum apk pacman pkg' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude detects brew/apt-get/dnf/yum/apk/pacman/pkg"
else
  expect.fail "init/oosh prelude PM detect missing one or more managers"
fi

# T-INIT-INSTALL-BREW-BOOTSTRAP: naked macOS images get Homebrew bootstrapped
# non-interactively when no PM is detected, matching what ossh.prereqs.install
# used to do.
test.case $level "T-INIT-INSTALL-BREW-BOOTSTRAP: prelude bootstraps Homebrew on naked macOS" \
  echo "(grep)"
if grep -qE 'NONINTERACTIVE=1.*Homebrew/install' "$INIT_SCRIPT" \
   && grep -qE 'uname -s.*Darwin' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude bootstraps Homebrew when no PM is detected on macOS"
else
  expect.fail "init/oosh prelude missing Homebrew bootstrap — naked macOS images (no PM) will leave bash 4+ never landed"
fi

# T-INIT-BREW-INSTALL-NONINTERACTIVE: every package install in init/oosh runs
# with its non-interactive prefix. Homebrew 6 asks "Do you want to proceed?
# [y/n]" by default on a TTY when the plan has dependencies — `brew install
# bash` on a virgin Sequoia VM waited on it forever. The bootstrap's
# NONINTERACTIVE=1 does not reach `brew install`; HOMEBREW_NO_ASK=1 does. So
# any executable line that invokes the PM (`$OOSH_PM …` or a literal
# `brew install`) must carry either the per-PM `$_pmEnv` or HOMEBREW_NO_ASK.
# Comments, messages (echo/die) and the PM table itself are not invocations.
# The root -> `sudo -u $SUDO_USER` branch cannot be run on a Linux host, which
# is why this is a structural check and test.oo's behavioural one is not.
test.case $level "T-INIT-BREW-INSTALL-NONINTERACTIVE: no package-manager call in init/oosh can prompt" \
  echo "(grep)"
unguarded=$(grep -nE '\$OOSH_PM ["'"'"'$]|brew install' "$INIT_SCRIPT" \
  | grep -vE '^[0-9]+:[[:space:]]*(#|echo |die )|OOSH_PM="brew install"' \
  | grep -vE '_pmEnv|HOMEBREW_NO_ASK=1|oosh_pm_env')
if ! grep -qE 'brew\*\).*HOMEBREW_NO_ASK=1' "$INIT_SCRIPT"; then
  expect.fail "init/oosh has no brew arm setting HOMEBREW_NO_ASK=1 — a fresh macOS waits on brew's 'proceed? [y/n]'"
elif [ -n "$unguarded" ]; then
  expect.fail "package-manager calls without a non-interactive prefix: $(echo "$unguarded" | tr '\n' ' ')"
else
  expect.pass "every package-manager call in init/oosh is non-interactive (apt: DEBIAN_FRONTEND, brew: HOMEBREW_NO_ASK)"
fi

# T-INIT-INSTALL-BREW-PATHSD: brew bash install must wire /etc/paths.d/oosh-homebrew
# so non-interactive ssh sessions find /opt/homebrew/bin/bash. Same reasoning as
# the prior ossh.prereqs.install test — moved here.
test.case $level "T-INIT-INSTALL-BREW-PATHSD: prelude wires /etc/paths.d/oosh-homebrew on brew hosts" \
  echo "(grep)"
if grep -qE '/etc/paths\.d/oosh-homebrew' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude wires /etc/paths.d/oosh-homebrew for brew"
else
  expect.fail "init/oosh prelude missing /etc/paths.d/oosh-homebrew wiring — non-interactive ssh on macOS won't find brew bash"
fi

# T-INIT-INSTALL-AUTO-PRELUDE: the POSIX prelude auto-installs git via $OOSH_PM.
# Post-refactor (2026-05-08): bash-phase auto-install pass for git/sudo/curl was
# REMOVED — Phase A's prelude `oosh_cmd_install git` is the single source of
# truth (Phase A of init/oosh), and runtime prereqs (rsync, tree) install via
# `ossh prereqs.install` local mode in the post-clone prereqs block instead. sudo and curl are
# chicken-and-egg in non-root flows; init/oosh dies fast if missing.
test.case $level "T-INIT-INSTALL-AUTO-PRELUDE: Phase A prelude auto-installs git via PM" \
  echo "(grep)"
if grep -qE 'oosh_cmd_install +git' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude calls oosh_cmd_install git"
else
  expect.fail "init/oosh prelude missing git auto-install — the POSIX prelude must install git before clone"
fi

# T-INIT-INSTALL-APT-UPDATE-GATE: apt-get update is gated by OOSH_APT_UPDATED
# so re-exec'd children don't repeat the (slow) `apt-get update` step.
test.case $level "T-INIT-INSTALL-APT-UPDATE-GATE: apt-get update is gated by OOSH_APT_UPDATED" \
  echo "(grep)"
if grep -qE 'OOSH_APT_UPDATED' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude has OOSH_APT_UPDATED gate"
else
  expect.fail "init/oosh prelude missing OOSH_APT_UPDATED gate — children will re-run apt-get update wastefully"
fi

# T-INIT-PRELUDE-POSIX: the prelude must use POSIX-only constructs so it works
# under dash/ash/busybox before bash is installed. Quick syntactic guard:
# parses cleanly under dash up to the bash-phase boundary.
test.case $level "T-INIT-PRELUDE-POSIX: Phase A prelude is POSIX-clean (parses under dash)" \
  echo "(awk + dash -n)"
if command -v dash >/dev/null 2>&1; then
  _preludeDir=$(test.suite.fixture.make prelude); _preludeFile="$_preludeDir/prelude"
  awk '/^# Phase B —/{exit} {print}' "$INIT_SCRIPT" > "$_preludeFile"
  if dash -n "$_preludeFile" 2>/dev/null; then
    expect.pass "Phase A prelude parses under dash"
  else
    expect.fail "Phase A prelude has non-POSIX syntax — will fail under dash/ash/busybox before bash is installed"
  fi
  rm -rf "$_preludeDir"
else
  expect.pass "dash not installed locally — skipping POSIX-clean check (CI covers it)"
fi

# ============================================================================
# T-INIT-WORKTREE-AWARE: init/oosh's clone-skip test handles worktree .git
# ----------------------------------------------------------------------------
# git worktrees store `.git` as a FILE pointing back to the main repo's
# `.git/`, NOT as a directory. State 31 symlinks $HOME/oosh to the dev/
# worktree, so a re-invocation of init/oosh (e.g. `ossh install <host>
# <user>` after the host's bootstrap install set up the shared tree)
# sees `$OOSH_DIR/.git` as a regular file — the old `-d` test failed
# that and fell through to `git clone`, which died with "destination
# path already exists" because the symlink target was non-empty. This
# was the root cause of the 2026-05-19 macOS CI failure at Phase A.1b
# (run 26092181247). The fix uses `-e` so the test treats both
# dir-style and file-style `.git` markers as "this is a repo, skip".
# Structural assertion locks the contract in.
# ============================================================================
test.case $level "T-INIT-WORKTREE-AWARE: init/oosh clone-skip uses -e (matches worktree .git files)" \
  bash -c "grep -qE '\\[ ! -e \"\\\$OOSH_DIR/\\.git\" \\]' \"$INIT_SCRIPT\""
if grep -qE '\[ ! -e "\$OOSH_DIR/\.git" \]' "$INIT_SCRIPT"; then
  expect.pass "init/oosh uses '-e' for .git existence check — handles both directory (plain clone) and file (worktree pointer) markers"
else
  expect.fail "init/oosh's clone-skip must test '\[ ! -e \"\$OOSH_DIR/.git\" \]' (not '-d') so it correctly skips clone when \$OOSH_DIR is a symlink into a worktree — '-d' fails for worktrees and causes 'destination path already exists' errors at git-clone time"
fi

# ============================================================================
# T-STATE-31-CHOWN-NOT-RECURSIVE: state 31 doesn't stomp existing file owners
# ----------------------------------------------------------------------------
# Regression for 2026-05-19 macOS CI run 26095749022 where Phase A.4
# (`ossh install macos bash-user`) failed because /Users/runner/config/*
# files had been re-chowned developking:dev during Phase A.1b's state-31
# run on the host. The runner user's effective process groups didn't
# include `dev` (group adds only take effect on next login), so the
# runner couldn't write to its own previously-written files anymore.
# Root cause: `chown -R developking:dev "$CONFIG_PATH"` in state 31 of oo was
# too aggressive — it overrode ALL prior writers' file ownership. Fix:
# chown only the top-level dir + setgid bit so new files inherit dev
# group automatically. Existing files keep their writer's ownership.
# Lock the contract in with a structural assertion.
# ============================================================================
OO_SCRIPT="$OOSH_DIR/oo"
test.case $level "T-STATE-31-CHOWN-NOT-RECURSIVE: state 31 chowns only top-level sharedConfig dir, not recursively" \
  bash -c "! grep -qE 'chown -R developking:dev \"\\\$CONFIG_PATH\"' \"$OO_SCRIPT\""
if grep -qE 'chown -R developking:dev "\$CONFIG_PATH"' "$OO_SCRIPT"; then
  expect.fail "state 31 must NOT use 'chown -R developking:dev \$CONFIG_PATH' — that stomps existing files written by other users (e.g. runner during bootstrap). Use 'chown developking:dev \$CONFIG_PATH' + 'chmod g+s' so new files inherit dev group via setgid, and existing files keep their owner."
else
  expect.pass "state 31's chown is non-recursive — existing dev-group writers retain ownership"
fi
test.case $level "T-STATE-31-CHOWN-SETGID: state 31 sets setgid on sharedConfig dir" \
  bash -c "grep -qE 'chmod g\\+s \"\\\$CONFIG_PATH\"' \"$OO_SCRIPT\""
if grep -qE 'chmod g\+s "\$CONFIG_PATH"' "$OO_SCRIPT"; then
  expect.pass "state 31 sets setgid on sharedConfig — new files inherit group=dev automatically"
else
  expect.fail "state 31 must set 'chmod g+s \$CONFIG_PATH' so new files inherit dev group from the dir (canonical shared-dir Unix model)"
fi
unset OO_SCRIPT

# ============================================================================
# T-INIT-HOME-RECOVERY: init/oosh recovers $HOME under env -i
# ============================================================================
# README documents `unbuffer env -i sh -xc "$(wget -O- .../init/oosh)"`. env -i
# drops HOME, so init/oosh computed OOSH_DIR=/oosh and
# INSTALL_LOG=/config/install.log — it would install into the filesystem root.
# Structural check: the recovery block exists and precedes the first $HOME use.
test.install.homeRecovery() {
  local ok=1 recoverLn firstUseLn
  grep -q 'eval echo ~"$_oosh_user"' "$INIT_SCRIPT" || ok=0
  grep -q 'NFSHomeDirectory' "$INIT_SCRIPT" || ok=0
  grep -q '/etc/passwd' "$INIT_SCRIPT" || ok=0
  recoverLn=$(grep -n '^# BEGIN homeRecovery$' "$INIT_SCRIPT" | head -1 | cut -d: -f1)
  firstUseLn=$(grep -n ': ${OOSH_DIR:=$HOME/oosh}' "$INIT_SCRIPT" | head -1 | cut -d: -f1)
  [ -n "$recoverLn" ] && [ -n "$firstUseLn" ] && [ "$recoverLn" -lt "$firstUseLn" ] || ok=0
  if [ "$ok" = "1" ]; then
    create.result 0 "HOME recovery precedes the first \$HOME use"
  else
    create.result 1 "recover=$recoverLn firstUse=$firstUseLn"
  fi
}
test.case $level "T-INIT-HOME-RECOVERY: init/oosh recovers \$HOME before using it" \
  test.install.homeRecovery
expect 0 "HOME recovery precedes the first \$HOME use" \
  "env -i drops HOME; without recovery the installer targets /oosh"

# ============================================================================
# T-INIT-CLEAN-ENV: init/oosh re-establishes a clean environment
# ============================================================================
# From 2024-04-07 (8c277f4, Chris Daßler) to 2026-03-09 (075b4a3) init/oosh
# carried `#!/usr/bin/env -iS HOME=${HOME} sh` — clean environment, HOME passed
# through. 075b4a3 removed it because BusyBox env has no -S. A self-re-exec
# gets the same guarantee portably: busybox env rejects -S but accepts
# `env -i VAR=val cmd`.
test.install.cleanEnvReexec() {
  local ok=1
  grep -q 'OOSH_CLEAN_ENV' "$INIT_SCRIPT" || ok=0
  # BEGIN/END cleanEnv markers delimit the block the probe below extracts.
  grep -q '^# BEGIN cleanEnv$' "$INIT_SCRIPT" && grep -q '^# END cleanEnv$' "$INIT_SCRIPT" || ok=0
  grep -qE '^ *exec env -i( \\)?$' "$INIT_SCRIPT" || ok=0
  # The re-exec must name an INTERPRETER, never hand a bare "$0" to the
  # kernel — see T-INIT-CLEAN-ENV-EXEC for the three call sites that breaks.
  grep -qE '"\$_oosh_sh" \$_oosh_x "\$0"' "$INIT_SCRIPT" || ok=0
  # Guarded on $0 being a readable regular file — the curl-pipe case has no
  # file to re-exec. Anchored to the OOSH_CLEAN_ENV condition itself: a bare
  # `[ -f "$0" ]` also occurs in the bash re-exec block (`if [ -f "$0" ]`
  # inside the bash-4+ upgrade), so an unanchored grep still matched — and
  # therefore still PASSED — with this guard deleted. `-r` is what an
  # interpreter actually needs; the execute bit is deliberately not required.
  grep -qE '^if \[ -z "\$OOSH_CLEAN_ENV" \] && \[ -f "\$0" \] && \[ -r "\$0" \]' "$INIT_SCRIPT" || ok=0
  # and must NOT reintroduce the flag BusyBox cannot parse
  grep -q 'env -S' "$INIT_SCRIPT" && ok=0
  if [ "$ok" = "1" ]; then
    create.result 0 "clean re-exec present, guarded, no -S"
  else
    create.result 1 "clean-env re-exec missing, unguarded, or uses env -S"
  fi
}
test.case $level "T-INIT-CLEAN-ENV: init/oosh re-execs clean without env -S" \
  test.install.cleanEnvReexec
expect 0 "clean re-exec present, guarded, no -S" \
  "restores the 2024-2026 clean-environment guarantee; -S is what BusyBox lacks"

# ============================================================================
# T-INIT-CLEAN-ENV-CARRY: the clean re-exec carries the invoker's identity
# ============================================================================
# BEHAVIOURAL, not structural. The re-exec added for T3 wipes the environment,
# so every variable init/oosh READS BUT NEVER SETS is destroyed unless it is
# named in the carried list. An audit of the 2026-09-14 file found that ALL of
# its env-reading code postdates 075b4a3 (2026-03-09, the commit that dropped
# `#!/usr/bin/env -iS HOME=${HOME} sh`) — at the pre-change baseline a6f0ce3,
# 531 of 537 lines do, and the 6 that don't are two bare `fi`s and four blank
# lines. So none of it has ever run under
# `env -i`, and "this only restores old behaviour" does not hold.
#
# Two vars are read-only inherits with no internal assignment at all:
#   SUDO_USER  — set by sudo itself, assigned nowhere in init/oosh. Losing it
#                silently skips "Installing oosh for invoking user" and flips
#                the login-shell exec's `[ -z "$SUDO_USER" ]` branch.
#                Introduced 7ac375a (2026-04-24), i.e. six weeks AFTER the
#                guarantee was removed.
#   OOSH_REPO  — three `${OOSH_REPO:-<github url>}` readers, assigned
#                nowhere. Its only purpose is external override; wiping it
#                makes the override dead and silently falls back to public
#                GitHub. Same failure class as 57f0984 (OOSH_BRANCH).
#
# The probe extracts the block and runs it standalone — it NEVER runs the
# installer. It asserts three things at once: the re-exec actually fired
# (CLEAN=[1]), the environment really was wiped (POLLUTE gone), and the
# variable under test crossed intact.
test.install.cleanEnvProbe() # <interpreter> <flags|-> <var=value…> # runs the extracted block, echoes the child's view
{
  local interp="$1"; shift
  local flags="$1"; shift
  local fx probe err out rc
  [ "$flags" = "-" ] && flags=""
  fx=$(test.suite.fixture.make cleanenv) || return 1
  probe="$fx/probe"; err="$fx/err"
  {
    echo '#!/usr/bin/env sh'
    echo 'OOSH_SELF_BRANCH="${OOSH_SELF_BRANCH:-dev}"'
    echo ': ${OOSH_BRANCH:=$OOSH_SELF_BRANCH}'
    sed -n '/^# BEGIN cleanEnv$/,/^# END cleanEnv$/p' "$INIT_SCRIPT"
    echo 'hasHomebrew=no; case ":$PATH:" in *:/opt/homebrew/bin:*) hasHomebrew=yes ;; esac'
    echo 'xtraceOn=off; case "$-" in *x*) xtraceOn=on ;; esac'
    echo 'isBash=no; if [ -n "$BASH_VERSION" ]; then isBash=yes; fi'
    echo 'echo "CLEAN=[${OOSH_CLEAN_ENV-<gone>}] POLLUTE=[${POLLUTE-<gone>}] SUDO_USER=[${SUDO_USER-<gone>}] OOSH_REPO=[${OOSH_REPO-<gone>}] USER=[${USER-<gone>}] LOGNAME=[${LOGNAME-<gone>}] GIT_SSH_COMMAND=[${GIT_SSH_COMMAND-<gone>}] LOG_LEVEL=[${LOG_LEVEL-<gone>}] TERM=[${TERM-<gone>}] TMPDIR=[${TMPDIR-<gone>}] HEALNI=[${OOSH_HEAL_NONINTERACTIVE-<gone>}] NOINSTALL=[${OOSH_NO_INSTALL-<gone>}] HOMEBREW_ON_PATH=[$hasHomebrew] XTRACE=[$xtraceOn] BASH=[$isBash]"'
  } > "$probe"
  chmod 600 "$probe"
  # DELIBERATELY NOT chmod +x. Mode 600 — readable, NOT
  # executable — is exactly the shape ossh.prereqs.install produces:
  # it `scp -q`s init/oosh with no `-p` and then runs `bash /tmp/oosh-init.$$`,
  # whose comment promises the "POSIX-prelude path even if /tmp/oosh-init.$$
  # isn't executable". An earlier revision of this probe chmod'd +x and so
  # granted the one permission the real call site does not — which is why it
  # passed against a re-exec that handed bare "$0" to the kernel.
  out="$(env -u OOSH_CLEAN_ENV POLLUTE=yes "$@" $interp $flags "$probe" 2>"$err")"
  rc=$?
  # Surface the child's stderr only when it produced no parseable line, so a
  # hard failure (e.g. "env: './x': Permission denied", exit 126) is legible
  # instead of showing up as an empty string.
  if [ -z "$out" ]; then
    out="rc=$rc stderr=[$(tr '\n' ' ' < "$err" | cut -c1-200)]"
  fi
  rm -rf "$fx"
  echo "$out"
}

test.install.cleanEnvCarriesSudoUser() {
  local out
  out="$(test.install.cleanEnvProbe sh - SUDO_USER=testinvoker)"
  case "$out" in
    *'CLEAN=[1]'*) : ;;
    *) create.result 1 "re-exec never fired: $out"; return 1 ;;
  esac
  case "$out" in
    *'POLLUTE=[<gone>]'*) : ;;
    *) create.result 1 "environment was NOT wiped: $out"; return 1 ;;
  esac
  case "$out" in
    *'SUDO_USER=[testinvoker]'*)
      create.result 0 "SUDO_USER survives the clean re-exec" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-CARRY: SUDO_USER crosses the clean re-exec" \
  test.install.cleanEnvCarriesSudoUser
expect 0 "SUDO_USER survives the clean re-exec" \
  "sudo ./init/oosh: losing SUDO_USER silently skips user.oosh.install for the invoker"

test.install.cleanEnvCarriesUser() {
  local out
  out="$(test.install.cleanEnvProbe sh - USER=testinvoker LOGNAME=testinvoker)"
  case "$out" in
    *'USER=[testinvoker]'*'LOGNAME=[testinvoker]'*)
      create.result 0 "USER and LOGNAME survive the clean re-exec" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-CARRY: USER and LOGNAME cross the clean re-exec" \
  test.install.cleanEnvCarriesUser
expect 0 "USER and LOGNAME survive the clean re-exec" \
  "bash does not set USER; state 13 routes root vs user on it — losing it sends a root install down the user lane"

test.install.cleanEnvAbsentStaysAbsent() {
  # `env -i VAR= cmd` SETS VAR to the empty string. git runs a set-but-empty
  # GIT_SSH_COMMAND as the command '' ("error: cannot run : No such file or
  # directory"), so state 31's ssh clone silently fell back to the local copy
  # on every install through the re-exec. A variable the caller does not have
  # must reach the child UNSET — and one it does have must arrive verbatim.
  # TMPDIR is never carried: the heal arm clones under /tmp whatever the caller has
  # (a $TMPDIR under /var on macOS is /private/var to the clone's oo heal).
  local absent present tmpdir
  absent="$(unset GIT_SSH_COMMAND; test.install.cleanEnvProbe sh -)"
  case "$absent" in
    *'CLEAN=[1]'*'GIT_SSH_COMMAND=[<gone>]'*) : ;;
    *) create.result 1 "unset GIT_SSH_COMMAND reached the child SET: $absent"; return 1 ;;
  esac
  tmpdir="$(test.install.cleanEnvProbe sh - TMPDIR=/var/tmp/oosh-probe)"
  case "$tmpdir" in
    *'CLEAN=[1]'*'TMPDIR=[<gone>]'*) : ;;
    *) create.result 1 "the caller's TMPDIR crossed the clean re-exec: $tmpdir"; return 1 ;;
  esac
  present="$(test.install.cleanEnvProbe sh - GIT_SSH_COMMAND='ssh -i /k')"
  case "$present" in
    *'GIT_SSH_COMMAND=[ssh -i /k]'*)
      create.result 0 "absent stays absent, set is carried verbatim, TMPDIR never" ;;
    *)
      create.result 1 "set GIT_SSH_COMMAND did not cross intact: $present" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-ABSENT: a variable the caller lacks reaches the child UNSET, not empty" \
  test.install.cleanEnvAbsentStaysAbsent
expect 0 "absent stays absent, set is carried verbatim, TMPDIR never" \
  "env -i VAR= sets VAR to ''; git then runs '' as the ssh command and state 31's clone fails; a carried TMPDIR put the heal clone where oo heal did not know it"

test.install.cleanEnvCarriesRepo() {
  local out
  out="$(test.install.cleanEnvProbe sh - OOSH_REPO=https://example.invalid/fork.git)"
  case "$out" in
    *'OOSH_REPO=[https://example.invalid/fork.git]'*)
      create.result 0 "OOSH_REPO survives the clean re-exec" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-CARRY: OOSH_REPO crosses the clean re-exec" \
  test.install.cleanEnvCarriesRepo
expect 0 "OOSH_REPO survives the clean re-exec" \
  "OOSH_REPO is assigned nowhere in init/oosh — wiping it makes the override dead code"

# ============================================================================
# T-INIT-CLEAN-ENV-EXEC: the re-exec names an interpreter, so $0 needs no +x
# ============================================================================
# `exec env -i … "$0" "$@"` hands $0 to the KERNEL, which requires the execute
# bit and re-reads the shebang. Every other exec in init/oosh names an
# interpreter deliberately — `exec "$_newbash" "$0" "$@"`,
# `exec sudo -H -E sh "$0" "$@"`, `exec sh "$OOSH_DIR/init/oosh" "$@"`.
# Three real breakages when this one does not:
#
#  (a) ossh.prereqs.install `scp -q`s init/oosh with NO `-p`, then runs
#      `bash /tmp/oosh-init.$$`. Its own comment promises the "POSIX-prelude
#      path even if /tmp/oosh-init.$$ isn't executable". A kernel exec of a
#      mode-644 $0 dies at exit 126 with a bare `env:` message and no
#      `oosh install:` prefix.
#  (b) README's "More detailed logging for debugging" documents
#      `unbuffer env -i sh -x init/oosh | tee install.log.txt`. $0 IS a file
#      there, so the re-exec fires and the shebang re-read drops `-x` —
#      the debug command produces a log with no trace in it.
#  (c) .github/workflows/macos-test.yml runs
#      `sudo -H /opt/homebrew/bin/bash /var/root/oosh/init/oosh` precisely to
#      get bash 5; a shebang re-read silently downgrades it to /usr/bin/env sh.
#
# The probe runs at mode 600 — readable, NOT executable — which is
# the ossh.prereqs.install shape exactly.
test.install.cleanEnvNoExecBit() {
  local out
  out="$(test.install.cleanEnvProbe sh -)"
  case "$out" in
    *'CLEAN=[1]'*'POLLUTE=[<gone>]'*)
      create.result 0 "re-exec survives a non-executable \$0" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-EXEC: re-exec works when \$0 is mode 644 (no execute bit)" \
  test.install.cleanEnvNoExecBit
expect 0 "re-exec survives a non-executable \$0" \
  "ossh.prereqs.install scp's without -p and runs 'bash \$remoteTmp' — \$0 has no +x there"

test.install.cleanEnvKeepsBash() {
  local out
  out="$(test.install.cleanEnvProbe bash -)"
  case "$out" in
    *'BASH=[yes]'*)
      create.result 0 "a deliberate bash invocation is not downgraded" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-EXEC: re-exec does not downgrade a deliberate bash to sh" \
  test.install.cleanEnvKeepsBash
expect 0 "a deliberate bash invocation is not downgraded" \
  "macos-test.yml invokes /opt/homebrew/bin/bash on purpose to get bash 5"

test.install.cleanEnvKeepsXtrace() {
  local out
  out="$(test.install.cleanEnvProbe sh -x)"
  case "$out" in
    *'XTRACE=[on]'*)
      create.result 0 "xtrace survives the re-exec" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-EXEC: re-exec forwards xtrace (-x)" \
  test.install.cleanEnvKeepsXtrace
expect 0 "xtrace survives the re-exec" \
  "README documents 'env -i sh -x init/oosh | tee install.log.txt' for debugging"

# ============================================================================
# T-INIT-CLEAN-ENV-PATH: the re-exec seeds a deterministic PATH
# ============================================================================
# `env -i` leaves PATH unset, so the child shell falls back to its compiled-in
# default — measured here as /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:
# /sbin:/bin (and something smaller under busybox). That default contains
# /usr/local/bin but NOT /opt/homebrew/bin.
#
# On an Apple-Silicon Mac that ALREADY has Homebrew, that is fatal, and it does
# not self-heal: `oosh_pm_detect` finds no PM, the Darwin branch runs the full
# Homebrew installer over curl, and as root that aborts with "Don't run this as
# root!" → `die "Homebrew bootstrap failed"`. The `eval "$(… brew shellenv)"`
# that would have rescued PATH sits INSIDE that failure branch, AFTER the
# installer has already run, so it is never reached. Intel Macs escape only
# because their brew lives in /usr/local/bin, which the default PATH has.
#
# Seeding a fixed, known-good PATH is NOT the same as carrying the caller's:
# the value is constant regardless of who invoked us, which is the determinism
# the clean-environment guarantee is actually for.
test.install.cleanEnvSeedsPath() {
  local out
  out="$(test.install.cleanEnvProbe sh -)"
  case "$out" in
    *'HOMEBREW_ON_PATH=[yes]'*)
      create.result 0 "/opt/homebrew/bin is on the child's PATH" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-PATH: re-exec seeds a PATH containing /opt/homebrew/bin" \
  test.install.cleanEnvSeedsPath
expect 0 "/opt/homebrew/bin is on the child's PATH" \
  "arm64 macOS root install hard-fails without it — brew is invisible and the bootstrap dies"

# ============================================================================
# T-HOME-RECOVERY-NO-GETENT: an empty shell finds HOME without getent
# ============================================================================
# Marcel (2026-10-06): no getent at runtime. The shell's own ~user expansion
# reads the same user database (files, LDAP, … through the C library) and
# gives ONE home — the two-line getent answer of files+LDAP hosts cannot
# happen. Then dscl (macOS), then /etc/passwd. Asserted by EFFECT: the
# recovery block of init/oosh and of the launcher runs in `env -i sh` with a
# stub getent on PATH that answers a wrong home and logs every call; HOME must
# be the runner's real home, and getent never asked.
test.install.homeRecoveryNoGetent() {
  local stub want bad="" file out
  stub=$(test.suite.fixture.make nogetent) || { create.result 1 "no fixture directory"; return 1; }
  want=$(eval echo ~"$(id -un)")
  printf '%s\n' '#!/bin/sh' "echo called >> $stub/getent.log" 'echo "u:x:1:1::/nonexistent/from-getent:/bin/sh"' > "$stub/getent"
  chmod +x "$stub/getent"
  for file in "$INIT_SCRIPT" "$OOSH_DIR/templates/user/thisLauncher"; do
    sed -n '/^# BEGIN homeRecovery$/,/^# END homeRecovery$/p' "$file" > "$stub/block"
    if [ ! -s "$stub/block" ]; then bad="$bad no-homeRecovery-markers:${file##*/}"; continue; fi
    out=$(cd /tmp && env -i PATH="$stub:/usr/bin:/bin" sh -c ". $stub/block; echo \"HOME=[\$HOME]\"" 2>/dev/null | tail -1)
    [ "$out" = "HOME=[$want]" ] || bad="$bad ${file##*/}=>$out"
  done
  [ -s "$stub/getent.log" ] && bad="$bad getent-asked:$(wc -l < "$stub/getent.log")x"
  rm -rf "$stub"
  if [ -z "$bad" ]; then
    create.result 0 "init/oosh and the launcher find HOME from the user database without getent"
  else
    create.result 1 "home recovery:$bad"
  fi
  return $(result)
}
test.case $level "T-HOME-RECOVERY-NO-GETENT: an empty shell finds HOME without getent (init/oosh, launcher)" \
  test.install.homeRecoveryNoGetent
expect 0 "init/oosh and the launcher find HOME from the user database without getent" \
  "no getent at runtime: the shell's ~user reads the same user database"

# ============================================================================
# T-INIT-CLEAN-ENV-PASSTHROUGH: the re-exec passes the caller's env to CHILDREN
# ============================================================================
# The guarantee is deterministic-for-oosh, PASS-THROUGH-for-the-tools-it-calls,
# not "empty". `env -i` strips the environment handed to every child init/oosh
# spawns — `this call ossh prereqs.install`, `install.continue.local`,
# `user oosh.install`, every `git clone`, the Homebrew `curl`, `sudo`, and the
# final `exec "${BASH_FILE:-bash}" -l`. A strictly-clean environment sabotages
# all of them.
#
# LOG_LEVEL is the case tested here because its loss is SILENT rather than
# loud. `this` does `[ -z "$LOG_LEVEL" ] && export LOG_LEVEL=3`, so it is an
# inherited knob; and only the `mode root` invocation has a positional argument
# for it, so on the drag-and-drop and direct paths env is the ONLY lever.
# Dropping it means `LOG_LEVEL=6 ./init/oosh` installs at 3 and says nothing.
#
# One representative case is enough — the rest of the pass-through group
# (LANG/LC_ALL, the proxies, SSH_AUTH_SOCK, GIT_SSH_COMMAND) crosses by the
# same mechanism. TERM is asserted separately because it is the one variable
# that needs a non-empty default rather than `${VAR:-}`.
test.install.cleanEnvPassesLogLevel() {
  local out
  out="$(test.install.cleanEnvProbe sh - LOG_LEVEL=6)"
  case "$out" in
    *'LOG_LEVEL=[6]'*)
      create.result 0 "LOG_LEVEL crosses the re-exec to the children" ;;
    *)
      create.result 1 "$out" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-PASSTHROUGH: LOG_LEVEL reaches the spawned tools" \
  test.install.cleanEnvPassesLogLevel
expect 0 "LOG_LEVEL crosses the re-exec to the children" \
  "env is the only lever on the drag-and-drop path; losing it installs at 3 in silence"

# TERM is the one pass-through that must NOT use the bare `${VAR:-}` form.
# Measured: bash turns an UNSET TERM into `dumb` but leaves an EMPTY one empty,
# and `tput` errors on empty while accepting `dumb`. So `${TERM:-}` would be
# strictly worse than dropping TERM altogether. `${TERM:-dumb}` reproduces the
# unset behaviour exactly, and carries a real terminal when there is one.
# The success path ends in `exec "${BASH_FILE:-bash}" -l`, so this is what
# decides whether the user lands in a usable shell.
test.install.cleanEnvTermDefault() {
  local kept dflt
  kept="$(test.install.cleanEnvProbe sh - TERM=xterm-256color)"
  # Passing TERM= (empty) is the strictly harder case: `${TERM:-dumb}` must
  # turn BOTH empty and unset into dumb, and empty is the one that a bare
  # `${TERM:-}` would have let through.
  dflt="$(test.install.cleanEnvProbe sh - TERM=)"
  case "$kept" in
    *'TERM=[xterm-256color]'*) : ;;
    *) create.result 1 "real TERM not carried: $kept"; return 1 ;;
  esac
  case "$dflt" in
    *'TERM=[dumb]'*)
      create.result 0 "TERM carried when set, defaulted to dumb when not" ;;
    *)
      create.result 1 "empty TERM did not default to dumb: $dflt" ;;
  esac
}
test.case $level "T-INIT-CLEAN-ENV-PASSTHROUGH: TERM is carried, and defaults to dumb not empty" \
  test.install.cleanEnvTermDefault
expect 0 "TERM carried when set, defaulted to dumb when not" \
  "an empty TERM is worse than an absent one — bash defaults unset to dumb, tput rejects empty"

# ============================================================================
# T-INIT-PM-ENV-AGREES: init/oosh's POSIX twin of the non-interactive prefix
# table answers exactly what private.oo.pm.env.get answers
# ============================================================================
# init/oosh cannot call the bash getter (it runs from a curl one-liner before
# oosh exists), so it carries a POSIX twin, oosh_pm_env. Two literal copies
# of the table inside init/oosh (oosh_cmd_install's _pmEnv and the brew-bash
# upgrade line) is how the brew arm was missed once already (6f4a8e9). One
# function, extracted here and run for every PM the table knows.
test.install.pmEnvAgrees() {
  [ "$(type -t private.oo.pm.env.get)" = "function" ] || source "$OOSH_DIR/oo" >/dev/null 2>&1
  local twin pm want got bad=""
  twin=$(sed -n '/^oosh_pm_env() {/,/^}/p' "$INIT_SCRIPT")
  [ -n "$twin" ] || { create.result 1 "init/oosh has no oosh_pm_env() — the prefix table is still inlined"; return $(result); }
  for pm in "apt-get install -y" "dpkg -i" "brew install" "apk add" "dnf install -y" "pacman -S"; do
    want=$(private.oo.pm.env.get "$pm")
    got=$(sh -c "$twin; oosh_pm_env \"\$1\"" sh "$pm" 2>&1)
    [ "$got" = "$want" ] || bad="$bad [$pm: twin='$got' getter='$want']"
  done
  if [ -n "$bad" ]; then
    create.result 1 "the twins disagree:$bad"
  else
    create.result 0 "oosh_pm_env answers exactly what private.oo.pm.env.get answers"
  fi
  return $(result)
}
test.case $level "T-INIT-PM-ENV-AGREES: init/oosh's oosh_pm_env twin matches private.oo.pm.env.get for every PM" \
  test.install.pmEnvAgrees
expect 0 "oosh_pm_env answers exactly what private.oo.pm.env.get answers" \
  "two literal copies of the table inside init/oosh is how the brew arm was missed before"

# ============================================================================
# T-INIT-HOME-LINK-NOT-MOVED: a re-run through the ~/oosh symlink never moves
# the shared branch folder into $HOME
# ============================================================================
# init/oosh resolves OOSH_DIR physically when ../.git is a DIRECTORY. In the
# clone layout (2026-09-23 design) the shared dev/ folder IS such a clone, so a
# re-run via ~/oosh -> …/Once.sh/dev resolved OOSH_DIR to the shared path, saw
# it differ from "$HOME/oosh", deleted the link and MOVED the shared dev/ into
# /root/oosh (os platform.test ubuntu_24_04, once init at state 60; every later
# user install then failed with "Once.sh/dev missing"). The worktree layout hid
# it: dev/.git was a file. oosh_dir_is_home_link recognises the link's target.
test.install.homeLinkNotMoved() {
  local fx fn bad=""
  fn=$(grep '^oosh_dir_is_home_link() {' "$INIT_SCRIPT")   # a one-liner: a sed range would run on into the installer
  [ -n "$fn" ] || { create.result 1 "init/oosh has no oosh_dir_is_home_link() — a re-run moves the shared folder"; return $(result); }
  fx=$(test.suite.fixture.make homelink)
  mkdir -p "$fx/home" "$fx/shared/dev/.git" "$fx/elsewhere/.git"
  ln -s "$fx/shared/dev" "$fx/home/oosh"
  sh -c "$fn; oosh_dir_is_home_link \"\$1\" \"\$2\"" sh "$fx/shared/dev" "$fx/home" || bad="$bad link-target-not-recognised"
  sh -c "$fn; oosh_dir_is_home_link \"\$1\" \"\$2\"" sh "$fx/elsewhere" "$fx/home" && bad="$bad other-dir-taken-for-link"
  rm "$fx/home/oosh"; mkdir "$fx/home/oosh"
  sh -c "$fn; oosh_dir_is_home_link \"\$1\" \"\$2\"" sh "$fx/shared/dev" "$fx/home" && bad="$bad real-dir-taken-for-link"
  rm -rf "$fx"
  # …and the guard runs BEFORE the move, so the move block never sees the link case.
  local guard move
  guard=$(grep -n 'oosh_dir_is_home_link "\$OOSH_DIR" "\$HOME" && OOSH_DIR="\$HOME/oosh"' "$INIT_SCRIPT" | head -1 | cut -d: -f1)
  move=$(grep -n 'mv "\$OOSH_DIR" "\$HOME/oosh"' "$INIT_SCRIPT" | head -1 | cut -d: -f1)
  { [ -n "$guard" ] && [ -n "$move" ] && [ "$guard" -lt "$move" ]; } || bad="$bad guard-not-before-move(guard=$guard move=$move)"
  [ -z "$bad" ] && create.result 0 "a re-run through the ~/oosh link keeps the shared folder where it is" || create.result 1 "home link:$bad"
  return $(result)
}
test.case $level "T-INIT-HOME-LINK-NOT-MOVED: a re-run via the ~/oosh symlink never moves the shared branch folder" \
  test.install.homeLinkNotMoved
expect 0 "a re-run through the ~/oosh link keeps the shared folder where it is" \
  "the clone layout made the shared dev/ look like a stray repo and init/oosh moved it into /root/oosh"

# T-THIS-LAUNCHER-TEMPLATE: the launcher is plain POSIX sh and assigns no PATH or OOSH_DIR
# /usr/local/bin/this runs from `env -i sh` — dash on Linux, the macOS sh — so
# it must parse as POSIX sh; it recovers HOME with the same marked block as
# init/oosh; and it builds nothing: no PATH=, no OOSH_DIR= (the PATH and anchor
# rules hold for it as for every file).
test.install.thisLauncherTemplate() {
  local f="$OOSH_DIR/templates/user/thisLauncher" bad=""
  [ -f "$f" ] || { create.result 1 "no launcher template"; return $(result); }
  sh -n "$f" 2>/dev/null || bad="$bad not-posix-sh"
  grep -qx '# BEGIN homeRecovery' "$f" && grep -qx '# END homeRecovery' "$f" || bad="$bad no-homeRecovery-markers"
  grep -nE '(^|[^A-Za-z_])(PATH|OOSH_DIR)=' "$f" >/dev/null && bad="$bad assigns-PATH-or-OOSH_DIR"
  [ -z "$bad" ] && create.result 0 "POSIX sh, the homeRecovery block, no PATH or OOSH_DIR" || create.result 1 "launcher:$bad"
  return $(result)
}
test.case $level "T-THIS-LAUNCHER-TEMPLATE: the launcher is POSIX sh with the homeRecovery block" test.install.thisLauncherTemplate
expect 0 "POSIX sh, the homeRecovery block, no PATH or OOSH_DIR" "env -i sh runs it with dash or the macOS sh"

# T-THIS-LAUNCHER-EXEC: the launcher starts the caller's own ~/oosh/this with every argument
# A stub ~/oosh/this in a fixture home prints what it was given. The launcher
# runs under `env -i` (no PATH but the system's) and must hand over HOME and
# every argument; without ~/oosh it says so and returns 127.
test.install.thisLauncherExec() {
  local fx bad="" out rc; fx=$(test.suite.fixture.make thislauncher)
  mkdir -p "$fx/home/oosh" "$fx/empty"
  printf '%s\n' 'echo "RAN $HOME|$*"' > "$fx/home/oosh/this"
  out=$(env -i HOME="$fx/home" PATH=/usr/bin:/bin sh "$OOSH_DIR/templates/user/thisLauncher" anchor.validate "two words" 2>/dev/null)
  [ "$out" = "RAN $fx/home|anchor.validate two words" ] || bad="$bad got=[$out]"
  env -i HOME="$fx/empty" PATH=/usr/bin:/bin sh "$OOSH_DIR/templates/user/thisLauncher" >/dev/null 2>&1; rc=$?
  [ "$rc" = 127 ] || bad="$bad no-oosh-rc=$rc"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the caller's own ~/oosh/this gets HOME and every argument" || create.result 1 "launcher run:$bad"
  return $(result)
}
test.case $level "T-THIS-LAUNCHER-EXEC: the launcher starts the caller's own ~/oosh/this with every argument" test.install.thisLauncherExec
expect 0 "the caller's own ~/oosh/this gets HOME and every argument" "env -i sh, then this: sh: this: not found"

# T-THIS-LAUNCHER-SOURCED: `source this` that finds the launcher loads ~/oosh/this — it does not replace the shell
# `source this` with a bare name searches PATH. Where ~/oosh is not on it yet
# (test.tilde's clean environment, an empty shell) bash found
# /usr/local/bin/this, and its `exec` replaced the very script that sourced
# it with a started `this` — the platform run hung in T69 behind an orphaned
# `bash -i` (2026-10-02). Sourced, the launcher loads the real ~/oosh/this
# into the caller and returns.
test.install.thisLauncherSourced() {
  local fx bad="" out; fx=$(test.suite.fixture.make thislaunchersourced)
  mkdir -p "$fx/home/oosh" "$fx/bin"
  printf '%s\n' 'LOADED="real this, args: $*"' > "$fx/home/oosh/this"
  cp "$OOSH_DIR/templates/user/thisLauncher" "$fx/bin/this"
  out=$(env -i HOME="$fx/home" PATH="$fx/bin:/usr/bin:/bin" bash -c 'source this a b; echo "AFTER [$LOADED]"' 2>&1)
  [ "$out" = "AFTER [real this, args: a b]" ] || bad=" got=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "sourced, the launcher loads ~/oosh/this into the caller and returns" || create.result 1 "sourced launcher:$bad"
  return $(result)
}
test.case $level "T-THIS-LAUNCHER-SOURCED: source this finding the launcher loads ~/oosh/this, the caller keeps running" test.install.thisLauncherSourced
expect 0 "sourced, the launcher loads ~/oosh/this into the caller and returns" \
  "the launcher's exec replaced a script that ran source this — T69 hung the platform run"

# T-NO-DOUBLED-LOG-CALL: no log call with its name doubled (infoinfo.log.log)
# init/once called `infoinfo.log.log` — "command not found" every time a
# check had to fix something (platform test, 2026-10-06). Every tracked script
# of oosh is swept for a command <name>.log.log.
test.install.noDoubledLogCall() {
  local hits
  hits=$(cd "$OOSH_DIR" && git grep -nE '^[[:space:]]*[a-z]+\.log\.log([[:space:]]|$)' -- . ':!sessions' ':!docs' ':!test' 2>/dev/null)
  if [ -z "$hits" ]; then
    create.result 0 "no doubled log call"
  else
    create.result 1 "doubled log call: $(echo "$hits" | cut -d: -f1,2 | tr '\n' ' ')"
  fi
  return $(result)
}
test.case $level "T-NO-DOUBLED-LOG-CALL: no log call with its name doubled (infoinfo.log.log)" test.install.noDoubledLogCall
expect 0 "no doubled log call" "init/once called infoinfo.log.log — command not found"

### test.method

# T-INIT-REFUSES-BROKEN-HOME-OOSH: the brokenTree block runs standalone under POSIX sh
# against fixture repos; the installer never runs. A git first on PATH records
# every call: the block must never call it (the tree may be another user's,
# git would answer "dubious ownership"), so a call shows up as GIT=[…].
test.install.brokenTreeProbe() # <oosh-dir> # runs the extracted brokenTree block with a recording git first on PATH, echoes "<output> RC=<rc>" and GIT=[<calls>] when git was called
{
  local fx probe out rc
  fx=$(test.suite.fixture.make brokentreeprobe) || return 1
  probe="$fx/probe"; mkdir -p "$fx/bin"
  printf '%s\n' '#!/bin/sh' "echo \"\$*\" >> '$fx/git.log'" "exec '$(command -v git)' \"\$@\"" > "$fx/bin/git"; chmod 755 "$fx/bin/git"
  {
    echo '#!/usr/bin/env sh'
    echo 'OOSH_SELF_BRANCH="${OOSH_SELF_BRANCH:-dev}"'
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    echo 'set -e'
    sed -n '/^# BEGIN brokenTree$/,/^# END brokenTree$/p' "$INIT_SCRIPT"
  } > "$probe"
  if ! grep -q '^# BEGIN brokenTree$' "$probe"; then rm -rf "$fx"; echo "NO-BLOCK RC=99"; return 0; fi
  out="$(OOSH_DIR="$1" PATH="$fx/bin:$PATH" sh "$probe" 2>&1)"
  rc=$?
  [ -s "$fx/git.log" ] && rc="$rc GIT=[$(tr '\n' '|' < "$fx/git.log")]"
  rm -rf "$fx"
  echo "$out RC=$rc"
}

test.install.refusesBrokenHomeOosh() {
  local fx out why="" d
  private.this.script.load ogit ogit.repo.init
  fx=$(test.suite.fixture.make brokentree) || return 1
  mkdir "$fx/nogit"
  for d in merge detached clean; do
    ogit.repo.init "$fx/$d" no main >/dev/null 2>&1
    echo one > "$fx/$d/one"
    ogit.index.add all "$fx/$d" >/dev/null 2>&1
    ogit.commit.create one t@t.invalid t "$fx/$d" >/dev/null 2>&1
  done
  ogit.commit.log.show HEAD 1 '%H' "$fx/merge" > "$fx/merge/.git/MERGE_HEAD"
  ogit.branch.checkout "$(ogit.commit.log.show HEAD 1 '%H' "$fx/detached")" "$fx/detached" >/dev/null 2>&1
  out="$(test.install.brokenTreeProbe "$fx/merge")"
  case "$out" in *"not reused"*"RC=1") : ;; *) why="$why merge:[$out]" ;; esac
  out="$(test.install.brokenTreeProbe "$fx/detached")"
  case "$out" in *"not reused"*"RC=1") : ;; *) why="$why detached:[$out]" ;; esac
  out="$(test.install.brokenTreeProbe "$fx/clean")"
  [ "$out" = " RC=0" ] || why="$why clean:[$out]"
  out="$(test.install.brokenTreeProbe "$fx/nogit")"
  [ "$out" = " RC=0" ] || why="$why nogit:[$out]"
  mkdir "$fx/wt"; echo "gitdir: $fx/clean/.git/worktrees/wt" > "$fx/wt/.git"
  out="$(test.install.brokenTreeProbe "$fx/wt")"
  [ "$out" = " RC=0" ] || why="$why worktree-file:[$out]"
  rm -rf "$fx"
  if [ -z "$why" ]; then
    create.result 0 "mid-merge and detached trees are refused, clean and non-git trees pass"
  else
    create.result 1 "$why"
  fi
}
test.case $level "T-INIT-REFUSES-BROKEN-HOME-OOSH: a mid-merge or detached ~/oosh is not reused and names the heal" \
  test.install.refusesBrokenHomeOosh
expect 0 "mid-merge and detached trees are refused, clean and non-git trees pass" \
  "the Mac's conflicted tree was executed by a re-run of the installer"

# T-INIT-HEAL-ARM: `sh init/oosh heal [<branch>] [all]` clones <branch> fresh
# into a temp dir under /tmp and runs THAT tree's oo heal. The healArgs and
# healArm blocks run standalone under POSIX sh (with the installer's `set -e`)
# against a fixture origin whose `oo` is a stub that prints what it got; the
# installer never runs, no network, HOME is the fixture's and TMPDIR names a
# fixture folder the arm must not use. A recording mktemp first on PATH names
# every temp dir the arm made (<fx>/mktemp.log). HEAL_PROBE_TTY=<path> puts <path> in
# the place of /dev/tty in the arm: a path that cannot be opened is a host
# without a terminal, a file is a terminal the child reads — on every host, as
# root too, with no new session and no setsid.
test.install.healArmProbe() # <fixture> <pipe|shc|sh-args…> <sh-args…> # runs healArgs + healArm as `sh probe <args>`, piped (pipe), as `sh -c <text> <$0> <args>` (shc) or the file form; echoes "<output> RC=<rc>"
{
  local fx="$1"; shift
  local probe="$fx/probe" out rc i
  {
    echo 'OOSH_SELF_BRANCH="${OOSH_SELF_BRANCH:-dev}"'
    echo ': ${OOSH_BRANCH:=$OOSH_SELF_BRANCH}'
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    sed -n '/^# BEGIN healArgs$/,/^# END healArgs$/p' "$INIT_SCRIPT"
    echo 'set -e'
    sed -n '/^# BEGIN healArm$/,/^# END healArm$/p' "$INIT_SCRIPT" | sed "s#/dev/tty#${HEAL_PROBE_TTY:-/dev/tty}#g"
    echo 'echo FELL-THROUGH'
  } > "$probe.body"
  {
    echo '#!/usr/bin/env sh'
    cat "$probe.body"
    # far more than one read buffer of script text after the block: a child
    # that inherited the pipe would read a PADDING line
    for ((i = 0; i < 2000; i++)); do echo '# PADDING-MARKER the child must never read this script text'; done
  } > "$probe"
  if ! grep -q '^# BEGIN healArm$' "$probe"; then echo "NO-BLOCK RC=99"; return 0; fi
  if [ "$1" = pipe ]; then
    shift
    out="$(umask 077; cat "$probe" | env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_DIR -u CONFIG HOME="$fx/home" TMPDIR="$fx/tmp" PATH="${HEAL_PROBE_PATH:-$fx/bin:$PATH}" OOSH_REPO="$fx/origin.git" sh -s -- "$@" 2>&1)"
  elif [ "$1" = shc ]; then
    shift
    out="$(umask 077; env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_DIR -u CONFIG HOME="$fx/home" TMPDIR="$fx/tmp" PATH="${HEAL_PROBE_PATH:-$fx/bin:$PATH}" OOSH_REPO="$fx/origin.git" sh -c "$(cat "$probe.body")" "$@" 2>&1 </dev/null)"
  else
    out="$(umask 077; env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_DIR -u CONFIG HOME="$fx/home" TMPDIR="$fx/tmp" PATH="${HEAL_PROBE_PATH:-$fx/bin:$PATH}" OOSH_REPO="$fx/origin.git" sh "$probe" "$@" 2>&1 </dev/null)"
  fi
  rc=$?
  echo "$out RC=$rc"
}

test.install.healArmFixture() # <label> # echo a fixture: origin.git with dev and prod whose oo is a stub printing its view and exiting 3; a recording sudo and mktemp in its bin
{
  local fx
  private.this.script.load ogit ogit.repo.init
  fx=$(test.suite.fixture.make "$1"); mkdir -p "$fx/home" "$fx/tmp" "$fx/bin"
  ogit.repo.init "$fx/origin.git" yes dev >/dev/null 2>&1
  ogit.repo.init "$fx/seed" no dev >/dev/null 2>&1
  cat > "$fx/seed/oo" <<'STUB'
#!/usr/bin/env bash
if [ -t 0 ]; then tty=tty; first=""; else tty=notty; IFS= read -r first || true; fi
echo "STUB args=[$*] me=[$(id -un)] OOSH_DIR=[${OOSH_DIR-<unset>}] CONFIG=[${CONFIG-<unset>}] OOSH_REPO=[${OOSH_REPO-<unset>}] HEALNI=[${OOSH_HEAL_NONINTERACTIVE-<unset>}] NOINSTALL=[${OOSH_NO_INSTALL-<unset>}] stdin=[$tty] first=[$first] mode=[$(ls -ld "${0%/*}/.." | cut -c1-10)] tree=[$(ls -ld "${0%/*}" | cut -c1-10)] file=[$(ls -l "$0" | cut -c1-10)] self=[$0]"
exit 3
STUB
  ogit.index.add all "$fx/seed" >/dev/null 2>&1
  ogit.commit.create "stub oo" t@t.invalid t "$fx/seed" >/dev/null 2>&1
  git -C "$fx/seed" push -q "$fx/origin.git" dev:dev dev:prod 2>/dev/null # ogit-exception: fixture push to a path — ogit.remote.push pushes only to a configured origin
  # env_reset, like the real one; -n fails when STUB_SUDO_NO_N is set (a password would be needed)
  printf '%s\n' '#!/bin/sh' "echo \"SUDO [\$*]\" >> \"$fx/sudo.log\"" \
    'n=; while [ $# -gt 0 ]; do case "$1" in -n) n=1; shift ;; -*) shift ;; *) break ;; esac; done' \
    '[ -n "$n" ] && [ -n "$STUB_SUDO_NO_N" ] && exit 1' 'exec env -i PATH="$PATH" HOME="$HOME" "$@"' > "$fx/bin/sudo"
  # the real mktemp, recording what it was asked for and the folder it made
  printf '%s\n' '#!/bin/sh' "d=\$('$(command -v mktemp)' \"\$@\") || exit \$?" "echo \"MKTEMP [\$*] \$d\" >> \"$fx/mktemp.log\"" 'echo "$d"' > "$fx/bin/mktemp"
  # the real rm, failing when STUB_RM_FAIL is set: a cleanup that fails, for root too
  printf '%s\n' '#!/bin/sh' '[ -n "$STUB_RM_FAIL" ] && exit 1' "exec '$(command -v rm)' \"\$@\"" > "$fx/bin/rm"
  chmod 755 "$fx/bin/sudo" "$fx/bin/mktemp" "$fx/bin/rm"
  echo "$fx"
}

test.install.healArmTempLeft() # <fixture> # echo every temp dir the arm made (mktemp.log) that is still there; silent getter
{
  local d
  [ -f "$1/mktemp.log" ] || return 0
  for d in $(awk '{ print $NF }' "$1/mktemp.log"); do [ ! -e "$d" ] || echo "$d"; done
}

test.install.healArmRemove() # <fixture> # remove the fixture and every temp dir the arm made
{
  local d
  for d in $(test.install.healArmTempLeft "$1") "$1"; do rm -rf "${d:?}"; done
}

test.install.healArm() {
  local fx out bad="" me n c
  me=$(id -un)
  fx=$(test.install.healArmFixture healarm)
  # <who> is oo heal's own default: the arm passes the branch, and all when given
  out=$(test.install.healArmProbe "$fx" heal)
  case "$out" in *"STUB args=[heal dev] me=[$me] OOSH_DIR=[<unset>] CONFIG=[<unset>] OOSH_REPO=[$fx/origin.git]"*"mode=[drwxr-xr-x] tree=[drwxr-xr-x] file=[-rw-r--r--] self=[/tmp/oosh-heal."*"/t/oo]"*"RC=3") ;; *) bad="$bad heal=[$out]" ;; esac
  # always under /tmp, never the caller's TMPDIR
  case "$(cat "$fx/mktemp.log" 2>/dev/null)" in "MKTEMP [-d /tmp/oosh-heal.XXXXXX] /tmp/oosh-heal."*) ;; *) bad="$bad not-under-tmp=[$(cat "$fx/mktemp.log" 2>/dev/null)]" ;; esac
  out=$(test.install.healArmProbe "$fx" heal prod)
  case "$out" in *"STUB args=[heal prod] "*"RC=3") ;; *) bad="$bad heal-prod=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" heal origin/prod)
  case "$out" in *"STUB args=[heal prod] "*"RC=3") ;; *) bad="$bad heal-origin/prod=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" heal all)
  case "$out" in *"STUB args=[heal dev all] me=[$me]"*"OOSH_REPO=[$fx/origin.git]"*"tree=[drwxr-xr-x] file=[-rw-r--r--] self=[/tmp/oosh-heal."*"RC=3") ;; *) bad="$bad heal-all=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" heal all prod)
  case "$out" in *"STUB args=[heal prod all] "*"RC=3") ;; *) bad="$bad heal-all-prod=[$out]" ;; esac
  # one branch word only, an empty, a dash or an origin/-only argument is refused — before anything is cloned
  n=$(wc -l < "$fx/mktemp.log")
  out=$(test.install.healArmProbe "$fx" heal dev prod)
  case "$out" in *"heal: one branch only, got 'dev' and 'prod'"*"RC=1") ;; *) bad="$bad second-branch=[$out]" ;; esac
  for c in "" -x; do
    out=$(test.install.healArmProbe "$fx" heal "$c")
    case "$out" in *"heal: bad argument '$c'"*"RC=1") ;; *) bad="$bad heal-[$c]=[$out]" ;; esac
  done
  # origin/ alone strips to an empty branch: refused, not a silent heal of the default
  out=$(test.install.healArmProbe "$fx" heal origin/)
  case "$out" in *"heal: bad argument 'origin/'"*"RC=1") ;; *) bad="$bad heal-origin/=[$out]" ;; esac
  [ "$(wc -l < "$fx/mktemp.log")" = "$n" ] || bad="$bad refused-but-cloned"
  out=$(test.install.healArmProbe "$fx")
  [ "$out" = "FELL-THROUGH RC=0" ] || bad="$bad no-heal=[$out]"
  [ -z "$(test.install.healArmTempLeft "$fx")" ] || bad="$bad temp-left=[$(test.install.healArmTempLeft "$fx")]"
  # a cleanup that fails (the child left a dir it cannot delete) keeps the child's rc and says so
  out=$(STUB_RM_FAIL=1 test.install.healArmProbe "$fx" heal)
  case "$out" in *"STUB args=[heal dev] "*"RC=3") ;; *) bad="$bad cleanup-masks-rc=[$out]" ;; esac
  case "$out" in *"heal: remove /tmp/oosh-heal."*"yourself"*) ;; *) bad="$bad cleanup-not-reported=[$out]" ;; esac
  # the arm calls no sudo — not for the heal, not for its cleanup
  [ -e "$fx/sudo.log" ] && bad="$bad arm-called-sudo=[$(cat "$fx/sudo.log")]"
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "heal clones <branch> fresh under /tmp, runs its oo heal <branch> [all], removes the temp dir and returns oo's rc" || create.result 1 "heal arm:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-ARM: sh init/oosh heal [<branch>] [all] runs a fresh clone's oo heal and never touches ~/oosh" \
  test.install.healArm
expect 0 "heal clones <branch> fresh under /tmp, runs its oo heal <branch> [all], removes the temp dir and returns oo's rc" \
  "a broken or absent ~/oosh must be healable by the one file the curl form fetches"

# T-INIT-HEAL-FORMS: the four ways to start the heal all reach the arm — the
# pipe (`curl … | sh -s -- heal`), the file (`sh init/oosh heal`), `sh -c
# "$(curl …)" sh heal` and `sh -c "$(curl …)" heal`, where `heal` is $0 and
# the script got no arguments: it used to run a plain install.
test.install.healForms() {
  local fx out bad=""
  fx=$(test.install.healArmFixture healforms)
  out=$(test.install.healArmProbe "$fx" pipe heal prod)
  case "$out" in *"STUB args=[heal prod] "*"RC=3") ;; *) bad="$bad pipe=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" heal prod)
  case "$out" in *"STUB args=[heal prod] "*"RC=3") ;; *) bad="$bad file=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" shc sh heal prod)
  case "$out" in *"STUB args=[heal prod] "*"RC=3") ;; *) bad="$bad sh-c-sh-heal=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" shc heal)
  case "$out" in *"STUB args=[heal dev] "*"RC=3") ;; *) bad="$bad sh-c-heal=[$out]" ;; esac
  out=$(test.install.healArmProbe "$fx" shc heal prod all)
  case "$out" in *"STUB args=[heal prod all] "*"RC=3") ;; *) bad="$bad sh-c-heal-prod-all=[$out]" ;; esac
  # an install stays an install in every form
  out=$(test.install.healArmProbe "$fx" shc sh)
  [ "$out" = "FELL-THROUGH RC=0" ] || bad="$bad sh-c-install=[$out]"
  out=$(test.install.healArmProbe "$fx" pipe)
  [ "$out" = "FELL-THROUGH RC=0" ] || bad="$bad pipe-install=[$out]"
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "pipe, file, sh -c … sh heal and sh -c … heal all reach the arm" || create.result 1 "heal forms:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-FORMS: pipe, file, sh -c … sh heal and sh -c … heal each run the heal" \
  test.install.healForms
expect 0 "pipe, file, sh -c … sh heal and sh -c … heal all reach the arm" \
  "sh -c \"\$(curl …)\" heal made heal \$0 and ran a plain install"

# T-INIT-HEAL-ARM-STDIN: in the pipe form the script IS stdin — neither the
# clone nor the child may read it (the child gets /dev/tty or /dev/null); a
# clone failure says so, fails, and leaves no temp dir. A git first on
# PATH reads one line of its stdin on `clone` and records it before it hands
# over to the real git: a clone that inherited the pipe reads script text.
test.install.healArmStdin() {
  local fx out bad="" realGit
  fx=$(test.install.healArmFixture healarmstdin)
  realGit=$(command -v git)
  printf '%s\n' '#!/bin/sh' \
    'if [ "$1" = clone ]; then _l=""; IFS= read -r _l || true; echo "GIT [$*] STDIN=[$_l]" >> "'"$fx/git.log"'"; fi' \
    "exec '$realGit' \"\$@\"" > "$fx/bin/git"
  chmod 755 "$fx/bin/git"
  out=$(test.install.healArmProbe "$fx" pipe heal)
  case "$out" in *"STUB args=[heal dev] "*) ;; *) bad="$bad pipe=[$out]" ;; esac
  case "$out" in *PADDING-MARKER*) bad="$bad child-read-the-script" ;; esac
  case "$out" in *"stdin=[tty] first=[]"*|*"stdin=[notty] first=[]"*) ;; *) bad="$bad stdin=[$out]" ;; esac
  case "$out" in *"RC=3") ;; *) bad="$bad pipe-rc=[$out]" ;; esac
  case "$(cat "$fx/git.log" 2>/dev/null)" in
    "GIT [clone -q -b dev $fx/origin.git /tmp/oosh-heal."*"/t] STDIN=[]") ;;
    *) bad="$bad clone-stdin=[$(cat "$fx/git.log" 2>/dev/null)]" ;;
  esac
  out=$(test.install.healArmProbe "$fx" heal nosuchbranch)
  case "$out" in *"heal: clone of nosuchbranch failed"*"RC=1") ;; *) bad="$bad bad-branch=[$out]" ;; esac
  [ -z "$(test.install.healArmTempLeft "$fx")" ] || bad="$bad temp-left=[$(test.install.healArmTempLeft "$fx")]"
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "the piped script is never read by the clone or the child; a failed clone is loud and leaves no temp dir" || create.result 1 "heal stdin:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-ARM-STDIN: curl … | sh -s -- heal: the script on stdin is not eaten; a bad branch fails loud and clean" \
  test.install.healArmStdin
expect 0 "the piped script is never read by the clone or the child; a failed clone is loud and leaves no temp dir" \
  "in the pipe form a child that inherits stdin swallows the rest of the installer"

# The part of init/oosh from Phase B's prereq checks (git, bash 4+) through the
# installer's "sudo missing" check, extracted in the file's own order and run
# under sh after the healArgs block, with oosh_bash_ok answering <bashOk> and
# PATH the fixture's bin only (no sudo unless the fixture put one there).
test.install.prereqRegionProbe() # <fixture> <bashOk:yes|no> <sh-args…> # runs init/oosh from the prereq checks to the sudo check, echoes "<output> RC=<rc>"
{
  local fx="$1" bashOk="$2" out rc; shift 2
  {
    echo '#!/usr/bin/env sh'
    echo 'OOSH_SELF_BRANCH="${OOSH_SELF_BRANCH:-dev}"'
    echo ': ${OOSH_BRANCH:=$OOSH_SELF_BRANCH}'
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    sed -n '/^# BEGIN healArgs$/,/^# END healArgs$/p' "$INIT_SCRIPT"
    echo "MODE=\"\"; oosh_bash_ok() { [ $bashOk = yes ]; }"
    echo 'set -e'
    awk '/^# ─── Prereqs \(essentials only\)/{f=1} /^# ─── Non-root → sudo re-exec/{exit} f{print}' "$INIT_SCRIPT"
    echo 'echo PAST-THE-SUDO-CHECK'
  } > "$fx/region"
  out="$(umask 077; env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_DIR -u CONFIG HOME="$fx/home" TMPDIR="$fx/tmp" PATH="$fx/bin" OOSH_REPO="$fx/origin.git" "$(command -v sh)" "$fx/region" "$@" 2>&1 </dev/null)"; rc=$?
  echo "$out RC=$rc"
}

# T-INIT-HEAL-ARM-NO-SUDO: the arm needs no sudo — it runs before the
# installer's "sudo missing" check and hands `heal` and `heal all` to the
# clone's oo heal, which decides root itself (rc 2 without it:
# T-OO-HEAL-ARM-TREE-NO-COPY). PATH holds only the tools the arm and the stub
# use, sudo not among them.
test.install.healArmNoSudo() {
  local fx out bad="" c
  fx=$(test.install.healArmFixture healarmnosudo)
  rm -f "$fx/bin/sudo"
  # mktemp is the fixture's recording one
  for c in sh bash env git chmod id ls cut cat awk; do ln -s "$(command -v "$c")" "$fx/bin/$c"; done
  out=$(HEAL_PROBE_PATH="$fx/bin" test.install.healArmProbe "$fx" heal)
  case "$out" in *"STUB args=[heal dev] me=[$(id -un)]"*"RC=3") ;; *) bad="$bad own=[$out]" ;; esac
  out=$(HEAL_PROBE_PATH="$fx/bin" test.install.healArmProbe "$fx" heal all)
  case "$out" in *"STUB args=[heal dev all] me=[$(id -un)]"*"RC=3") ;; *) bad="$bad all=[$out]" ;; esac
  # …and in init/oosh's own order (Phase B's prereq checks, the arm, the sudo
  # check, run as one piece): a heal reaches the clone without sudo on PATH, a
  # missing bash 4+ stops it before the clone, an install stops at the sudo check
  out=$(test.install.prereqRegionProbe "$fx" yes heal)
  case "$out" in *"STUB args=[heal dev] me=[$(id -un)]"*"RC=3") ;; *) bad="$bad region-heal=[$out]" ;; esac
  out=$(test.install.prereqRegionProbe "$fx" no heal)
  case "$out" in *STUB*) bad="$bad region-heal-before-bash-check=[$out]" ;; *"bash 4+ missing"*"RC=1") ;; *) bad="$bad region-no-bash=[$out]" ;; esac
  out=$(test.install.prereqRegionProbe "$fx" yes)
  if [ "$(id -u)" -ne 0 ]; then
    case "$out" in *"sudo missing for non-root install"*"RC=1") ;; *) bad="$bad region-install=[$out]" ;; esac
  else
    case "$out" in *"PAST-THE-SUDO-CHECK RC=0") ;; *) bad="$bad region-install-root=[$out]" ;; esac
  fi
  [ -z "$(test.install.healArmTempLeft "$fx")" ] || bad="$bad temp-left=[$(test.install.healArmTempLeft "$fx")]"
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "heal and heal all reach the clone's oo heal without sudo" || create.result 1 "heal no sudo:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-ARM-NO-SUDO: heal and heal all reach the clone's oo heal without sudo — root is its decision" \
  test.install.healArmNoSudo
expect 0 "heal and heal all reach the clone's oo heal without sudo" \
  "the sudo-missing check of the install blocked a heal that needs no sudo"

# T-INIT-HEAL-ARM-HANDOVER-NO-SUDO: the arm hands its clone over without sudo
# The arm ran `sudo -H bash <tmp>/t/oo heal <branch> all` itself — a second
# copy of the sudo decision the clone's oo heal makes anyway
# (private.oo.heal.env.clean through private.oo.heal.sudo.get, one prompt).
# The arm runs the clone's oo as the user, `all` included; root is decided
# there, once. A recording sudo stub is first on PATH: the arm never calls it,
# not for the heal and not for the cleanup of its temp dir.
test.install.healArmHandoverNoSudo() {
  local fx out bad=""
  fx=$(test.install.healArmFixture healarmhandover)
  out=$(test.install.healArmProbe "$fx" heal all)
  case "$out" in *"STUB args=[heal dev all] me=[$(id -un)]"*"self=[/tmp/oosh-heal."*"RC=3") ;; *) bad="$bad all=[$out]" ;; esac
  out=$(STUB_RM_FAIL=1 test.install.healArmProbe "$fx" heal all)
  case "$out" in *"STUB args=[heal dev all] "*"RC=3") ;; *) bad="$bad all-locked=[$out]" ;; esac
  [ -e "$fx/sudo.log" ] && bad="$bad arm-called-sudo=[$(cat "$fx/sudo.log")]"
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "the arm runs the clone's oo heal as the user, all included; root is the clone's decision" || create.result 1 "heal handover:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-ARM-HANDOVER-NO-SUDO: the heal arm runs the clone's oo heal without sudo — the clone decides root once" \
  test.install.healArmHandoverNoSudo
expect 0 "the arm runs the clone's oo heal as the user, all included; root is the clone's decision" \
  "the arm and oo heal each decided sudo with the same logic"

# T-INIT-APT-REFRESH-ON-NEED: Phase A refreshes the apt lists only when it
# must install git or bash 4+ — a heal or a re-run on a host that has both
# asks for no sudo password. The block runs standalone with a recording SUDO.
test.install.aptRefreshProbe() # <fixture> <git:yes|no> <bashOk:yes|no> <OOSH_APT_UPDATED|-> <?sudoRc:0> # runs the extracted apt refresh block, echoes "<recorded> UPDATED=[…]"
{
  local fx="$1" probe="$1/aptprobe"
  rm -f "$fx/sudo.log" "$fx/apt/git"; mkdir -p "$fx/apt"
  [ "$2" = yes ] && printf '#!/bin/sh\n' > "$fx/apt/git" && chmod 755 "$fx/apt/git"
  printf '%s\n' '#!/bin/sh' "echo \"SUDO [\$*]\" >> \"$fx/sudo.log\"" "exit ${5:-0}" > "$fx/apt/sudo"; chmod 755 "$fx/apt/sudo"
  {
    echo 'OOSH_PM_BIN=apt-get'
    echo "oosh_bash_ok() { [ $3 = yes ]; }"
    awk '/^# ─── 2\. apt-get update/{f=1} f{print; if (/^fi$/) exit}' "$INIT_SCRIPT"
    echo 'echo "UPDATED=[${OOSH_APT_UPDATED-<unset>}]"'
  } > "$probe"
  local upd=""; [ "$4" != - ] && upd="OOSH_APT_UPDATED=$4"
  env -u OOSH_APT_UPDATED $upd PATH="$fx/apt" SUDO="$fx/apt/sudo" "$(command -v sh)" "$probe" 2>/dev/null
  echo "RECORDED=[$(cat "$fx/sudo.log" 2>/dev/null)]"
}

test.install.aptRefreshOnNeed() {
  local fx out bad=""
  fx=$(test.suite.fixture.make aptrefresh)
  out=$(test.install.aptRefreshProbe "$fx" yes yes -)
  case "$out" in *"UPDATED=[<unset>]"*"RECORDED=[]") ;; *) bad="$bad git+bash=[$out]" ;; esac
  out=$(test.install.aptRefreshProbe "$fx" no yes -)
  case "$out" in *"UPDATED=[1]"*"RECORDED=[SUDO [apt-get update]]") ;; *) bad="$bad no-git=[$out]" ;; esac
  out=$(test.install.aptRefreshProbe "$fx" yes no -)
  case "$out" in *"UPDATED=[1]"*"RECORDED=[SUDO [apt-get update]]") ;; *) bad="$bad old-bash=[$out]" ;; esac
  out=$(test.install.aptRefreshProbe "$fx" no yes - 100)
  case "$out" in *"UPDATED=[<unset>]"*"RECORDED=[SUDO [apt-get update]]") ;; *) bad="$bad failed-refresh-flagged=[$out]" ;; esac
  out=$(test.install.aptRefreshProbe "$fx" no no 1)
  case "$out" in *"UPDATED=[1]"*"RECORDED=[]") ;; *) bad="$bad already=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "apt-get update runs only when git or bash 4+ must be installed, once, flagged only when it worked" || create.result 1 "apt refresh:$bad"
  return $(result)
}
test.case $level "T-INIT-APT-REFRESH-ON-NEED: Phase A runs apt-get update only when it must install git or bash 4+" \
  test.install.aptRefreshOnNeed
expect 0 "apt-get update runs only when git or bash 4+ must be installed, once, flagged only when it worked" \
  "an unconditional sudo apt-get update asked a heal for a password it did not need"

# T-INIT-HEAL-ARM-NO-TTY: without a terminal `heal all` never prompts — the
# arm calls no sudo and hands the clone's oo heal /dev/null, so its sudo.get
# uses sudo -n or stops with rc 2 (T-OO-HEAL-SUDO-GET, T-OO-HEAL-ARM-TREE-NO-COPY).
# The arm's /dev/tty is a fixture path (HEAL_PROBE_TTY): one that cannot be
# opened is no terminal, a file holding a line is a terminal — then the child
# reads that file, never the piped script. No new session is needed, so the
# test runs on every host and as root.
test.install.healArmNoTty() {
  local fx out bad=""
  fx=$(test.install.healArmFixture healarmnotty)
  out=$(STUB_SUDO_NO_N=1 HEAL_PROBE_TTY="$fx/no-terminal" test.install.healArmProbe "$fx" heal all)
  case "$out" in *"STUB args=[heal dev all]"*"stdin=[notty] first=[]"*"RC=3") ;; *) bad="$bad no-tty=[$out]" ;; esac
  out=$(STUB_SUDO_NO_N=1 HEAL_PROBE_TTY="$fx/no-terminal" test.install.healArmProbe "$fx" pipe heal all)
  case "$out" in *"STUB args=[heal dev all]"*"stdin=[notty] first=[]"*"RC=3") ;; *) bad="$bad no-tty-pipe=[$out]" ;; esac
  echo "TERMINAL-LINE" > "$fx/terminal"
  out=$(HEAL_PROBE_TTY="$fx/terminal" test.install.healArmProbe "$fx" pipe heal all)
  case "$out" in *"STUB args=[heal dev all]"*"first=[TERMINAL-LINE]"*"RC=3") ;; *) bad="$bad terminal=[$out]" ;; esac
  [ -e "$fx/sudo.log" ] && bad="$bad arm-called-sudo=[$(cat "$fx/sudo.log")]"
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "without a terminal heal all asks no password: the arm calls no sudo and hands the clone /dev/null" || create.result 1 "heal no tty:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-ARM-NO-TTY: without a terminal heal all hands the clone /dev/null and calls no sudo" \
  test.install.healArmNoTty
expect 0 "without a terminal heal all asks no password: the arm calls no sudo and hands the clone /dev/null" \
  "a plain sudo without a terminal fails as 'left for you', and a late sudo in the cleanup prompts a second time"

# T-INIT-HEAL-FLAGS-TRAVEL: OOSH_HEAL_NONINTERACTIVE and OOSH_NO_INSTALL cross the
# clean re-exec and reach the clone's oo heal, `all` included.
test.install.healFlagsTravel() {
  local fx out bad=""
  out="$(test.install.cleanEnvProbe sh - OOSH_HEAL_NONINTERACTIVE=1 OOSH_NO_INSTALL=1)"
  case "$out" in *'CLEAN=[1]'*'HEALNI=[1] NOINSTALL=[1]'*) ;; *) bad="$bad reexec=[$out]" ;; esac
  fx=$(test.install.healArmFixture healflags)
  out=$(OOSH_HEAL_NONINTERACTIVE=1 OOSH_NO_INSTALL=1 test.install.healArmProbe "$fx" heal)
  case "$out" in *"HEALNI=[1] NOINSTALL=[1]"*"RC=3") ;; *) bad="$bad heal=[$out]" ;; esac
  out=$(unset OOSH_HEAL_NONINTERACTIVE OOSH_NO_INSTALL; test.install.healArmProbe "$fx" heal)
  case "$out" in *"HEALNI=[<unset>] NOINSTALL=[<unset>]"*"RC=3") ;; *) bad="$bad unset-stays-unset=[$out]" ;; esac
  out=$(OOSH_HEAL_NONINTERACTIVE=1 OOSH_NO_INSTALL=1 test.install.healArmProbe "$fx" heal all)
  case "$out" in *"HEALNI=[1] NOINSTALL=[1]"*"RC=3") ;; *) bad="$bad all=[$out]" ;; esac
  test.install.healArmRemove "$fx"
  [ -z "$bad" ] && create.result 0 "the non-interactive flags reach oo heal, through the re-exec and the arm" || create.result 1 "heal flags:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-FLAGS-TRAVEL: OOSH_HEAL_NONINTERACTIVE and OOSH_NO_INSTALL reach oo heal" \
  test.install.healFlagsTravel
expect 0 "the non-interactive flags reach oo heal, through the re-exec and the arm" \
  "env -i dropped the flags an unattended heal depends on"

# T-INIT-REFUSES-BROKEN-HOME-OOSH (unreadable HEAD): under the installer's
# set -e an unreadable .git/HEAD must not abort with "cannot open" — the tree
# is refused like a detached one. A directory in HEAD's place cannot be read
# by anyone, root included, so the case runs on every host.
test.install.brokenTreeUnreadableHead() {
  local fx out
  private.this.script.load ogit ogit.repo.init
  fx=$(test.suite.fixture.make brokenhead)
  ogit.repo.init "$fx/repo" no main >/dev/null 2>&1
  rm -f "$fx/repo/.git/HEAD"; mkdir "$fx/repo/.git/HEAD"
  out="$(test.install.brokenTreeProbe "$fx/repo")"
  rm -rf "${fx:?}"
  case "$out" in
    *open*) create.result 1 "unreadable HEAD aborted the shell: [$out]" ;;
    *"not reused"*"RC=1") create.result 0 "an unreadable HEAD is refused, not a shell abort" ;;
    *) create.result 1 "unreadable HEAD: [$out]" ;;
  esac
  return $(result)
}
test.case $level "T-INIT-REFUSES-BROKEN-HOME-OOSH: an unreadable .git/HEAD is refused, not a set -e abort" \
  test.install.brokenTreeUnreadableHead
expect 0 "an unreadable HEAD is refused, not a shell abort" \
  "read -r _bh < HEAD under set -e killed the installer with 'cannot open'"

# T-INIT-HEAL-EARLY-PARSE: a heal is known before Phase A — by its first
# argument, also when `sh -c "$(curl …)" heal` made `heal` $0 (the healArgs
# block puts it back in front) — so Phase A's bash hand-over never turns a
# heal into an install; the arm reads the branch and `all` itself. What Phase
# A sees: init/oosh from its first line up to the Phase A header, run under sh
# (no re-exec: OOSH_CLEAN_ENV is set), then a line that prints the arguments.
test.install.phaseAViewProbe() # <file|shc> <sh-args…> # runs init/oosh up to Phase A as `sh probe <args>` or `sh -c <text> <args>`, echoes "PHASE-A ARGS=[…] RC=<rc>"
{
  local fx form="$1" out rc; shift
  fx=$(test.suite.fixture.make phaseaview) || return 1
  {
    awk '/^# Phase A — self-install/{exit} {print}' "$INIT_SCRIPT"
    echo 'echo "PHASE-A ARGS=[$*]"'
  } > "$fx/probe"
  if [ "$form" = shc ]; then
    out="$(env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_NO_AUTORUN -u BASH_SOURCE HOME="$fx" OOSH_CLEAN_ENV=1 "$(command -v sh)" -c "$(cat "$fx/probe")" "$@" 2>&1 </dev/null)"; rc=$?
  else
    out="$(env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_NO_AUTORUN -u BASH_SOURCE HOME="$fx" OOSH_CLEAN_ENV=1 "$(command -v sh)" "$fx/probe" "$@" 2>&1 </dev/null)"; rc=$?
  fi
  rm -rf "${fx:?}"
  echo "$out RC=$rc"
}

test.install.healEarlyParse() {
  local out bad=""
  out=$(test.install.phaseAViewProbe file heal dev.heal all)
  [ "$out" = "PHASE-A ARGS=[heal dev.heal all] RC=0" ] || bad="$bad file-heal=[$out]"
  out=$(test.install.phaseAViewProbe shc sh heal dev.heal all)
  [ "$out" = "PHASE-A ARGS=[heal dev.heal all] RC=0" ] || bad="$bad sh-c-sh-heal=[$out]"
  out=$(test.install.phaseAViewProbe shc heal dev.heal all)
  [ "$out" = "PHASE-A ARGS=[heal dev.heal all] RC=0" ] || bad="$bad sh-c-heal=[$out]"
  out=$(test.install.phaseAViewProbe shc heal)
  [ "$out" = "PHASE-A ARGS=[heal] RC=0" ] || bad="$bad sh-c-heal-only=[$out]"
  out=$(test.install.phaseAViewProbe file mode root host _ prod 3)
  [ "$out" = "PHASE-A ARGS=[mode root host _ prod 3] RC=0" ] || bad="$bad install=[$out]"
  out=$(test.install.phaseAViewProbe shc sh)
  [ "$out" = "PHASE-A ARGS=[] RC=0" ] || bad="$bad sh-c-install=[$out]"
  [ -z "$bad" ] && create.result 0 "Phase A sees heal as the first argument in every form, the arguments intact" || create.result 1 "heal early parse:$bad"
  return $(result)
}
test.case $level "T-INIT-HEAL-EARLY-PARSE: Phase A sees heal as the first argument in every form, the arguments intact" \
  test.install.healEarlyParse
expect 0 "Phase A sees heal as the first argument in every form, the arguments intact" \
  "Phase A's bash hand-over pre-cloned the self branch and ran an install instead of the heal"

# T-INIT-PIPE-HEAL-ARGS-SURVIVE: on macOS the pipe form (`curl … | sh -s -- heal
# dev.heal all`, sh = bash 3.2) reached Phase A step 4, which pre-cloned the SELF
# branch (dev, no heal arm) and re-ran ITS installer: a plain install instead of
# a heal. The healArgs block and step 4 run standalone under sh with oosh_bash_ok
# false, the brew prefix and /etc/paths.d moved into the fixture, and stub git
# and bash that record what they got. A heal never hands over and never
# pre-clones (the arm is POSIX sh; Phase B puts brew bash first on PATH for its
# child) — also as `sh -c "$(curl …)" heal`; any other run hands over with every argument.
test.install.step4Probe() # <fixture> <pipe|file|shc> <sh-args…> # runs healArgs + Phase A step 4 as sh, echoes "<output> GIT=[…] RC=<rc>"
{
  local fx="${1:?}" form="$2" out rc; shift 2
  rm -rf "$fx/tmp" "$fx/git.log" "$fx/pathsd"; mkdir -p "$fx/tmp" "$fx/hb" "$fx/bin" "$fx/pathsd"
  printf '%s\n' '#!/bin/sh' 'echo "BASH-EXEC [$*]"' > "$fx/hb/bash"
  printf '%s\n' '#!/bin/sh' "echo \"\$*\" >> '$fx/git.log'" 'eval "d=\${$#}"; mkdir -p "$d/init" && : > "$d/init/oosh"' > "$fx/bin/git"
  chmod 755 "$fx/hb/bash" "$fx/bin/git"
  {
    echo '#!/usr/bin/env sh'
    echo 'OOSH_SELF_BRANCH="${OOSH_SELF_BRANCH:-dev}"'
    echo ': ${OOSH_BRANCH:=$OOSH_SELF_BRANCH}'
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    echo 'oosh_bash_ok() { return 1; }'
    echo 'oosh_pm_env() { :; }'
    echo 'OOSH_PM_BIN=brew; OOSH_PM="brew install"; SUDO=""'
    sed -n '/^# BEGIN healArgs$/,/^# END healArgs$/p' "$INIT_SCRIPT"
    awk '/^# ─── 4\. Install bash 4\+/{f=1} f{print; if (/^fi$/) exit}' "$INIT_SCRIPT" \
      | sed -e "s#/opt/homebrew/bin#$fx/hb#g" -e "s#/usr/local/bin#$fx/nolocal#g" -e "s#/etc/paths.d#$fx/pathsd#g"
    echo 'echo "FELL-THROUGH ARGS=[$*]"'
  } > "$fx/probe"
  case "$form" in
    pipe) out="$(cat "$fx/probe" | env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_REPO TMPDIR="$fx/tmp" PATH="$fx/bin:$PATH" sh -s -- "$@" 2>&1)"; rc=$? ;;
    shc)  out="$(env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_REPO TMPDIR="$fx/tmp" PATH="$fx/bin:$PATH" sh -c "$(cat "$fx/probe")" "$@" 2>&1 </dev/null)"; rc=$? ;;
    *)    out="$(env -u OOSH_BRANCH -u OOSH_SELF_BRANCH -u OOSH_REPO TMPDIR="$fx/tmp" PATH="$fx/bin:$PATH" sh "$fx/probe" "$@" 2>&1 </dev/null)"; rc=$? ;;
  esac
  echo "$out GIT=[$(cat "$fx/git.log" 2>/dev/null)] RC=$rc"
}

test.install.pipeHealArgsSurvive() {
  local fx out bad="" left
  fx=$(test.suite.fixture.make step4probe) || return 1
  # the macOS report: the heal falls through to the arm with its arguments — no clone, no hand-over
  out=$(test.install.step4Probe "$fx" pipe heal dev.heal all)
  case "$out" in *"FELL-THROUGH ARGS=[heal dev.heal all] GIT=[] RC=0") ;; *) bad="$bad pipe-heal=[$out]" ;; esac
  case "$out" in *BASH-EXEC*) bad="$bad pipe-heal-handed-over" ;; esac
  left=$(find "$fx/tmp" -mindepth 1 -maxdepth 1); [ -z "$left" ] || bad="$bad pipe-heal-temp-left=[$left]"
  out=$(test.install.step4Probe "$fx" pipe heal)
  case "$out" in *"FELL-THROUGH ARGS=[heal] GIT=[] RC=0") ;; *) bad="$bad pipe-heal-self=[$out]" ;; esac
  out=$(test.install.step4Probe "$fx" file heal prod)
  case "$out" in *"FELL-THROUGH ARGS=[heal prod] GIT=[] RC=0") ;; *) bad="$bad file-heal=[$out]" ;; esac
  # `heal` as $0 is still a heal
  out=$(test.install.step4Probe "$fx" shc heal prod)
  case "$out" in *"FELL-THROUGH ARGS=[heal prod] GIT=[] RC=0") ;; *) bad="$bad sh-c-heal=[$out]" ;; esac
  # an install still hands over to the new bash, with every argument
  out=$(test.install.step4Probe "$fx" pipe mode root host _ prod 3)
  case "$out" in *"BASH-EXEC [$fx/tmp/"*"/once.sh/init/oosh mode root host _ prod 3]"*"GIT=[clone -b dev "*) ;; *) bad="$bad pipe-install=[$out]" ;; esac
  case "$out" in *FELL-THROUGH*) bad="$bad pipe-install-not-handed-over" ;; esac
  out=$(test.install.step4Probe "$fx" file mode root host _ prod 3)
  case "$out" in *"BASH-EXEC [$fx/probe mode root host _ prod 3] GIT=[] RC=0") ;; *) bad="$bad file-install=[$out]" ;; esac
  rm -rf "${fx:?}"
  [ -z "$bad" ] && create.result 0 "a heal reaches the arm with its arguments and no pre-clone; an install hands over with every argument" || create.result 1 "step 4:$bad"
  return $(result)
}
test.case $level "T-INIT-PIPE-HEAL-ARGS-SURVIVE: curl … | sh -s -- heal <branch> [all] under bash 3.2 reaches the arm, not a plain install of dev" \
  test.install.pipeHealArgsSurvive
expect 0 "a heal reaches the arm with its arguments and no pre-clone; an install hands over with every argument" \
  "the macOS VM pre-cloned dev and ran a plain install instead of healing dev.heal"

# T-INIT-REEXEC-KEEPS-ARGS: every re-exec of the installer passes the caller's
# arguments on, so `heal <branch> [all]` survives each one. Each re-exec runs
# extracted under sh with stubs that print the argument list they got, one
# [word] per argument (a word with a blank stays one): the clean re-exec, the
# sudo re-exec from a file and from the pipe (pre-clone), and the move to
# ~/oosh. Phase A's bash hand-over: T-INIT-PIPE-HEAL-ARGS-SURVIVE.
test.install.reexecKeepsArgs() {
  local fx out bad=""
  fx=$(test.suite.fixture.make reexecargs) || return 1
  mkdir -p "$fx/bin" "$fx/tmp" "$fx/home" "$fx/src/init"
  # the clean re-exec
  {
    echo 'OOSH_SELF_BRANCH="${OOSH_SELF_BRANCH:-dev}"'
    echo ': ${OOSH_BRANCH:=$OOSH_SELF_BRANCH}'
    sed -n '/^# BEGIN cleanEnv$/,/^# END cleanEnv$/p' "$INIT_SCRIPT"
    echo 'echo "CLEAN=[${OOSH_CLEAN_ENV-}] ARGS=$(printf "[%s]" "$@")"'
  } > "$fx/clean"
  out=$(env -u OOSH_CLEAN_ENV sh "$fx/clean" heal 'a b' all 2>&1)
  [ "$out" = "CLEAN=[1] ARGS=[heal][a b][all]" ] || bad="$bad clean=[$out]"
  # the sudo re-exec: a non-root uid, a sudo that prints what it would run, a git that makes the clone
  printf '%s\n' '#!/bin/sh' '[ "$1" = -u ] && { echo 1000; exit 0; }' "exec '$(command -v id)' \"\$@\"" > "$fx/bin/id"
  printf '%s\n' '#!/bin/sh' 'echo "SUDO $(printf "[%s]" "$@")"' > "$fx/bin/sudo"
  printf '%s\n' '#!/bin/sh' 'eval "d=\${$#}"; mkdir -p "$d/init" && : > "$d/init/oosh"' > "$fx/bin/git"
  chmod 755 "$fx/bin/id" "$fx/bin/sudo" "$fx/bin/git"
  {
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    echo 'MODE=""; OOSH_BRANCH=dev'
    awk '/^# ─── Non-root → sudo re-exec/{f=1} f{print; if (/^fi$/) exit}' "$INIT_SCRIPT"
    echo 'echo NOT-REEXECED'
  } > "$fx/sudo"
  out=$(TMPDIR="$fx/tmp" PATH="$fx/bin:$PATH" sh "$fx/sudo" heal 'a b' all 2>&1)
  case "$out" in *"SUDO [-H][-E][sh][$fx/sudo][heal][a b][all]") ;; *) bad="$bad sudo-file=[$out]" ;; esac
  out=$(cat "$fx/sudo" | TMPDIR="$fx/tmp" PATH="$fx/bin:$PATH" sh -s -- heal 'a b' all 2>&1)
  case "$out" in *"SUDO [-H][-E][sh][$fx/tmp/"*"/once.sh/init/oosh][heal][a b][all]") ;; *) bad="$bad sudo-pipe=[$out]" ;; esac
  # the move to ~/oosh re-runs the moved installer
  printf '%s\n' 'echo "MOVED ARGS=$(printf "[%s]" "$@") FROM=[$0]"' > "$fx/src/init/oosh"
  {
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    awk '/^_canon="\$HOME\/oosh"$/{f=1} f{print} /^unset _canon$/{exit}' "$INIT_SCRIPT"
    echo 'echo NOT-MOVED'
  } > "$fx/move"
  out=$(OOSH_DIR="$fx/src" HOME="$fx/home" sh "$fx/move" heal 'a b' all 2>&1)
  [ "$out" = "MOVED ARGS=[heal][a b][all] FROM=[$fx/home/oosh/init/oosh]" ] || bad="$bad move=[$out]"
  rm -rf "${fx:?}"
  [ -z "$bad" ] && create.result 0 "every re-exec of init/oosh passes the arguments on" || create.result 1 "re-exec dropped arguments:$bad"
  return $(result)
}
test.case $level "T-INIT-REEXEC-KEEPS-ARGS: the clean, the sudo and the move re-exec each hand the arguments on intact" \
  test.install.reexecKeepsArgs
expect 0 "every re-exec of init/oosh passes the arguments on" \
  "a re-exec that drops the arguments turns heal <branch> [all] into a plain install"

# T-INIT-PHASE-A-BREW-PATH: on the macOS VM an ssh login of `admin` whose PATH
# lacked /opt/homebrew/bin ran `curl … | sh -s -- heal dev.heal all` (no clean
# re-exec in the pipe form, so its own PATH) and died "bash 4+ missing": Phase A
# never looked under Homebrew, and Phase B's prepend came after the bash check.
# The brewPath block runs standalone under sh, <passes> times, with the brew
# dirs moved into the fixture (both exist; `brew` only where the case puts it)
# and a bash 3.2 stub first on PATH. The first dir with an executable brew
# (Apple silicon, then Intel) goes first unless it already comes before /bin —
# the seeded PATH of the clean re-exec stays as it is, a second and third pass
# change nothing; no brew anywhere (Linux) leaves PATH alone.
test.install.brewPathProbe() # <fixture> <hb|ul|both|none> <passes> <?pathBefore> # runs the extracted brewPath block <passes> times, echoes "PATH=[…] BEFORE=<rc> AFTER=<rc>"
{
  local fx="${1:?}" brew="$2" passes="$3" pathBefore i
  rm -rf "$fx/hb" "$fx/ul" "$fx/stub"; mkdir -p "$fx/stub" "$fx/hb" "$fx/ul"
  pathBefore="${4:-$fx/stub:/usr/bin:/bin}"
  case "$brew" in hb|both) printf '#!/bin/sh\n' > "$fx/hb/brew"; chmod 755 "$fx/hb/brew" ;; esac
  case "$brew" in ul|both) printf '#!/bin/sh\n' > "$fx/ul/brew"; chmod 755 "$fx/ul/brew" ;; esac
  printf '%s\n' '#!/bin/sh' 'echo "GNU bash, version 3.2.57(1)-release"' > "$fx/stub/bash"
  printf '%s\n' '#!/bin/sh' 'echo "GNU bash, version 5.3.3(1)-release"' > "$fx/hb/bash"
  chmod 755 "$fx/stub/bash" "$fx/hb/bash"
  {
    echo '#!/usr/bin/env sh'
    awk '/^oosh_bash_ok\(\) \{/{f=1} f{print; if (/^}$/) exit}' "$INIT_SCRIPT"
    echo 'oosh_bash_ok; _b=$?'
    for ((i = 0; i < passes; i++)); do
      sed -n '/^# BEGIN brewPath$/,/^# END brewPath$/p' "$INIT_SCRIPT" \
        | sed -e "s#/opt/homebrew/bin#$fx/hb#g" -e "s#/usr/local/bin#$fx/ul#g"
    done
    echo 'oosh_bash_ok; echo "PATH=[$PATH] BEFORE=$_b AFTER=$?"'
  } > "$fx/probe"
  if ! grep -q '^# BEGIN brewPath$' "$fx/probe"; then echo "NO-BLOCK RC=99"; return 0; fi
  env PATH="$pathBefore" sh "$fx/probe" 2>&1
}

# The order of effects: init/oosh from the brewPath block through step 1 (pm
# detection), then Phase B's current-bash-dir prepend, in the file's order and
# with the same fixture dirs; oosh_pm_detect is a stub that prints the PATH it
# runs under and whether bash 4+ is found there.
test.install.brewOrderProbe() # <fixture> <brew|nobrew> # echoes "PM-DETECT PATH=[…] BASH-OK=<rc> END PATH=[…]"
{
  local fx="${1:?}" brew="$2" sub
  rm -rf "$fx/hb" "$fx/ul" "$fx/stub"; mkdir -p "$fx/stub" "$fx/hb" "$fx/ul"
  [ "$brew" = brew ] && printf '#!/bin/sh\n' > "$fx/hb/brew" && chmod 755 "$fx/hb/brew"
  printf '%s\n' '#!/bin/sh' 'echo "GNU bash, version 3.2.57(1)-release"' > "$fx/stub/bash"
  printf '%s\n' '#!/bin/sh' 'echo "GNU bash, version 5.3.3(1)-release"' > "$fx/hb/bash"
  chmod 755 "$fx/stub/bash" "$fx/hb/bash"
  sub=(-e "s#/opt/homebrew/bin#$fx/hb#g" -e "s#/usr/local/bin#$fx/ul#g")
  {
    echo '#!/usr/bin/env sh'
    echo 'die() { echo "oosh install: $*" >&2; exit 1; }'
    awk '/^oosh_bash_ok\(\) \{/{f=1} f{print; if (/^}$/) exit}' "$INIT_SCRIPT"
    echo 'oosh_pm_detect() { if oosh_bash_ok; then _pb=0; else _pb=1; fi; echo "PM-DETECT PATH=[$PATH] BASH-OK=$_pb"; return 0; }'
    awk '/^# BEGIN brewPath$/{f=1} /^# ─── 2\./{exit} /^# Phase B/{exit} f{print} f && /^if ! oosh_pm_detect; then$/{g=1} g && /^fi$/{exit}' "$INIT_SCRIPT" | sed "${sub[@]}"
    awk '/^# Phase B — POSIX/{f=1} /^# ─── Arg parsing/{exit} f{print}' "$INIT_SCRIPT" | sed "${sub[@]}"
    echo 'echo "END PATH=[$PATH]"'
  } > "$fx/orderprobe"
  env PATH="$fx/stub:/usr/bin:/bin" sh "$fx/orderprobe" 2>&1 | tr '\n' ' ' | sed 's/ $//'
  echo
}

test.install.phaseABrewPath() {
  local fx out bad="" s seeded n
  fx=$(test.suite.fixture.make brewpathprobe) || return 1
  s="$fx/stub:/usr/bin:/bin"
  seeded="$fx/hb:$fx/hbs:$fx/ul:$fx/uls:/usr/bin:/bin:/usr/sbin:/sbin"
  for n in 1 3; do
    out=$(test.install.brewPathProbe "$fx" hb $n)
    [ "$out" = "PATH=[$fx/hb:$s] BEFORE=1 AFTER=0" ] || bad="$bad silicon-x$n=[$out]"
    # only the first dir with a brew, never both
    out=$(test.install.brewPathProbe "$fx" both $n)
    [ "$out" = "PATH=[$fx/hb:$s] BEFORE=1 AFTER=0" ] || bad="$bad both-x$n=[$out]"
    out=$(test.install.brewPathProbe "$fx" ul $n)
    [ "$out" = "PATH=[$fx/ul:$s] BEFORE=1 AFTER=1" ] || bad="$bad intel-x$n=[$out]"
    # no brew anywhere (Linux, where /usr/local/bin exists): PATH stays as it was
    out=$(test.install.brewPathProbe "$fx" none $n)
    [ "$out" = "PATH=[$s] BEFORE=1 AFTER=1" ] || bad="$bad no-brew-x$n=[$out]"
    # Homebrew after /bin (the VM's frozen era-B PATH ends in /opt/homebrew/bin): it goes first, once
    out=$(test.install.brewPathProbe "$fx" hb $n "$s:$fx/hb")
    [ "$out" = "PATH=[$fx/hb:$s:$fx/hb] BEFORE=1 AFTER=0" ] || bad="$bad frozen-after-bin-x$n=[$out]"
    # already before /bin: PATH stays as it was
    out=$(test.install.brewPathProbe "$fx" hb $n "$fx/hb:$s")
    [ "$out" = "PATH=[$fx/hb:$s] BEFORE=0 AFTER=0" ] || bad="$bad first-x$n=[$out]"
    # the seeded PATH of the clean re-exec, Apple silicon and Intel: no duplicate
    out=$(test.install.brewPathProbe "$fx" hb $n "$seeded")
    [ "$out" = "PATH=[$seeded] BEFORE=0 AFTER=0" ] || bad="$bad seeded-silicon-x$n=[$out]"
    out=$(test.install.brewPathProbe "$fx" ul $n "$seeded")
    [ "$out" = "PATH=[$seeded] BEFORE=0 AFTER=0" ] || bad="$bad seeded-intel-x$n=[$out]"
  done
  # pm detection already runs with Homebrew first and finds its bash 4+; Phase B
  # adds no second Homebrew dir; without brew PATH stays as it was
  out=$(test.install.brewOrderProbe "$fx" brew)
  [ "$out" = "PM-DETECT PATH=[$fx/hb:$s] BASH-OK=0 END PATH=[$fx/hb:$s]" ] || bad="$bad order-brew=[$out]"
  out=$(test.install.brewOrderProbe "$fx" nobrew)
  [ "$out" = "PM-DETECT PATH=[$s] BASH-OK=1 END PATH=[$s]" ] || bad="$bad order-nobrew=[$out]"
  rm -rf "${fx:?}"
  [ -z "$bad" ] && create.result 0 "the first Homebrew bin dir with a brew leads PATH before pm detection and the bash 4 check, once" || create.result 1 "brew path:$bad"
  return $(result)
}
test.case $level "T-INIT-PHASE-A-BREW-PATH: Phase A puts the first Homebrew bin dir with a brew before /bin, once, before it looks for brew and bash 4" \
  test.install.phaseABrewPath
expect 0 "the first Homebrew bin dir with a brew leads PATH before pm detection and the bash 4 check, once" \
  "the macOS VM's admin had no /opt/homebrew/bin on PATH and the heal died 'bash 4+ missing'"

# T-INIT-PHASE-A-SUDO-NONINTERACTIVE: a heal nobody watches — OOSH_HEAL_NONINTERACTIVE
# or OOSH_NO_INSTALL set, or no terminal — never waits at a password prompt in
# Phase A (apt-get update, a package install, /etc/paths.d): its SUDO is
# `sudo -n`. An install, and a heal at a terminal, keep plain sudo; root none.
# The SUDO block runs standalone under sh with a uid stub, and /dev/tty
# replaced by a fixture file that is there (a terminal) or not.
test.install.phaseASudoProbe() # <fixture> <tty|notty> <uid> <var=value|-> <sh-args…> # runs the extracted SUDO block, echoes "SUDO=[…]"
{
  local fx="${1:?}" tty="$2" uid="$3" var="$4"; shift 4
  mkdir -p "$fx/bin"; rm -f "$fx/tty"
  [ "$tty" = tty ] && : > "$fx/tty"
  printf '%s\n' '#!/bin/sh' "[ \"\$1\" = -u ] && { echo $uid; exit 0; }" "exec '$(command -v id)' \"\$@\"" > "$fx/bin/id"; chmod 755 "$fx/bin/id"
  {
    awk '/^# SUDO setup/{f=1} f{print} /^export SUDO$/{exit}' "$INIT_SCRIPT" | sed "s#/dev/tty#$fx/tty#g"
    echo 'echo "SUDO=[$SUDO]"'
  } > "$fx/sudoprobe"
  [ "$var" = - ] && var=""
  env -u SUDO -u OOSH_HEAL_NONINTERACTIVE -u OOSH_NO_INSTALL $var PATH="$fx/bin:$PATH" sh "$fx/sudoprobe" "$@" 2>&1
}

test.install.phaseASudoNoninteractive() {
  local fx out bad=""
  fx=$(test.suite.fixture.make phaseasudo) || return 1
  out=$(test.install.phaseASudoProbe "$fx" tty 1000 - heal dev)
  [ "$out" = "SUDO=[sudo]" ] || bad="$bad heal-at-terminal=[$out]"
  out=$(test.install.phaseASudoProbe "$fx" tty 1000 OOSH_HEAL_NONINTERACTIVE=1 heal dev)
  [ "$out" = "SUDO=[sudo -n]" ] || bad="$bad heal-noninteractive=[$out]"
  out=$(test.install.phaseASudoProbe "$fx" tty 1000 OOSH_NO_INSTALL=1 heal)
  [ "$out" = "SUDO=[sudo -n]" ] || bad="$bad heal-no-install=[$out]"
  out=$(test.install.phaseASudoProbe "$fx" notty 1000 - heal dev all)
  [ "$out" = "SUDO=[sudo -n]" ] || bad="$bad heal-no-terminal=[$out]"
  out=$(test.install.phaseASudoProbe "$fx" notty 1000 -)
  [ "$out" = "SUDO=[sudo]" ] || bad="$bad install-no-terminal=[$out]"
  out=$(test.install.phaseASudoProbe "$fx" tty 1000 OOSH_HEAL_NONINTERACTIVE=1 mode root host _ prod 3)
  [ "$out" = "SUDO=[sudo]" ] || bad="$bad install-flag=[$out]"
  out=$(test.install.phaseASudoProbe "$fx" notty 0 - heal)
  [ "$out" = "SUDO=[]" ] || bad="$bad root=[$out]"
  rm -rf "${fx:?}"
  [ -z "$bad" ] && create.result 0 "a heal without a terminal or with a non-interactive flag uses sudo -n in Phase A; an install keeps sudo" || create.result 1 "phase A sudo:$bad"
  return $(result)
}
test.case $level "T-INIT-PHASE-A-SUDO-NONINTERACTIVE: Phase A of a heal nobody watches uses sudo -n, never a prompt" \
  test.install.phaseASudoNoninteractive
expect 0 "a heal without a terminal or with a non-interactive flag uses sudo -n in Phase A; an install keeps sudo" \
  "Phase A's apt-get update asked an unattended heal for a password"

test.suite.save.results
