#!/usr/bin/env bash
# Tests for init/oosh — thin bootstrap contract. Asserts prereq guards,
# mode-root arg parsing, handoff to ossh install.continue.local, size
# shrink target, OOSH_SELF_BRANCH preservation, and the Install-oosh.command
# drag-and-drop wrapper.
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

INIT_SCRIPT="$OOSH_DIR/init/oosh"

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-BASH-PREREQ: init/oosh has a bash 4+ prereq guard with install hint
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-BASH-PREREQ: init/oosh errors out if bash major < 4" \
  echo "(grep)"
if grep -qE 'BASH_VERSINFO\[0\].*-lt 4' "$INIT_SCRIPT" \
   && grep -qE 'bash 4\+' "$INIT_SCRIPT" \
   && grep -qE 'brew install bash' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has a bash 4+ prereq guard with macOS install hint"
else
  expect.fail "init/oosh missing bash 4+ prereq guard or install hint"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-GIT-PREREQ: init/oosh has a git prereq guard with install hint
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-GIT-PREREQ: init/oosh errors out if git not on PATH" \
  echo "(grep)"
if grep -qE 'command -v git' "$INIT_SCRIPT" \
   && grep -qE '_oosh_missing\+=\("git' "$INIT_SCRIPT" \
   && grep -qE 'xcode-select --install' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has a git prereq guard with macOS install hint"
else
  expect.fail "init/oosh missing git prereq guard or install hint"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-MODE-ROOT-PARSE: `mode root` arg path preserved for ossh install
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-MODE-ROOT-PARSE: mode root arg path is preserved for ossh install compat" \
  echo "(grep)"
if grep -qE '\[ +"\$1" += +"mode" +\]' "$INIT_SCRIPT"; then
  expect.pass "init/oosh parses 'mode root' invocation"
else
  expect.fail "init/oosh dropped 'mode root' parsing — breaks ossh install"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-HANDS-OFF: init/oosh ends with exec ossh install.continue.local
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-HANDS-OFF: init/oosh hands off to ossh install.continue.local" \
  echo "(grep)"
if grep -qE '"\$OOSH_DIR/this" +call +ossh +install\.continue\.local' "$INIT_SCRIPT"; then
  expect.pass "init/oosh hands off to ossh install.continue.local"
else
  expect.fail "init/oosh missing handoff to install.continue.local"
fi

test.case $level "T-INIT-INSTALL-FOR-SUDO-USER: init/oosh installs oosh for SUDO_USER after state machine" \
  echo "(grep)"
if grep -qE 'SUDO_USER.*!=.*root' "$INIT_SCRIPT" \
   && grep -qE '"\$OOSH_DIR/user" +oosh\.install +"\$SUDO_USER"' "$INIT_SCRIPT"; then
  expect.pass "init/oosh runs user.oosh.install for SUDO_USER when non-root invoker sudo-re-exec'd"
else
  expect.fail "init/oosh missing post-install user.oosh.install for SUDO_USER — non-root curl won't set up the invoker"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SIZE-SHRUNK: init/oosh stays "thin" — ≤ 400 lines (was ~650 pre-thin).
# Bumped from 350 to 400 alongside the bash-4+ self-re-exec curl-pipe fix
# (init/oosh:48-66): genuine necessary safety logic mirroring the sudo
# re-exec block's no-real-file handling. Not bloat.
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-SIZE-SHRUNK: init/oosh is the thin bootstrap (≤ 400 lines)" \
  echo "(wc -l)"
lines=$(wc -l < "$INIT_SCRIPT")
if [ "$lines" -le 400 ]; then
  expect.pass "init/oosh is $lines lines (target ≤ 400 — was 650 pre-thin)"
else
  expect.fail "init/oosh is $lines lines — thin-bootstrap target missed"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-BASH-RE-EXEC: init/oosh self-re-execs under brew bash if found
# ─────────────────────────────────────────────────────────────────────────
# Without this, on macOS the script would fail its own bash-4+ prereq
# even though brew bash 5 is installed at /opt/homebrew/bin/bash —
# /etc/paths.d/* is only consulted by login shells (path_helper),
# whereas ssh-exec'd init/oosh runs in non-login non-interactive context.
test.case $level "T-INIT-BASH-RE-EXEC: init/oosh self-re-execs under brew bash when bash <4" \
  echo "(grep)"
if grep -qE '/opt/homebrew/bin/bash.*/usr/local/bin/bash|exec "\$_bash' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has self-re-exec block for brew bash"
else
  expect.fail "init/oosh missing self-re-exec — bash-3.2 ssh sessions on macOS will fail prereq even with brew bash on disk"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-BASH-RE-EXEC-CURL-PIPE: bash-4+ self-re-exec handles curl-pipe
# ─────────────────────────────────────────────────────────────────────────
# When init/oosh is invoked via `bash -c "$(curl …/init/oosh)"` (the
# documented curl one-liner AND the Install oosh.command wrapper's
# no-sibling fallback), $0 is the literal "bash", not a filesystem path.
# Without a no-real-file fallback, `exec "$_bashCandidate" "$0" "$@"`
# makes brew bash treat "bash" as a script name → PATH-resolves to
# /bin/bash → fails to read the binary as a shell script with
# "cannot execute binary file" (exit 126) — observed on the
# tart_sequoia VM when running the standalone Install oosh.command
# after `ossh prereqs.install` completed. Mirrors the existing
# pre-clone pattern in the sudo re-exec block (init/oosh:197-213).
test.case $level "T-INIT-BASH-RE-EXEC-CURL-PIPE: bash 4+ self-re-exec pre-clones when \$0 isn't a real file" \
  echo "(grep)"
# Extract just the self-re-exec block (the one guarded by the
# bash-version test, not the sudo block further down).
SELF_REEXEC=$(awk '/BASH_VERSINFO\[0\]:?-?:?0/{found=1} found{print; if(found && /^fi$/){exit}}' "$INIT_SCRIPT")
if printf "%s" "$SELF_REEXEC" | grep -qE '\[ -f "\$0" \]' \
   && printf "%s" "$SELF_REEXEC" | grep -qE 'mktemp -d' \
   && printf "%s" "$SELF_REEXEC" | grep -qE 'git clone -b "\$OOSH_BRANCH"'; then
  expect.pass "init/oosh self-re-exec handles curl-pipe (no-real-file) via pre-clone"
else
  expect.fail "init/oosh self-re-exec missing no-real-file fallback — curl one-liner and drag-and-drop standalone .command will fail with 'cannot execute binary file' on macOS once brew bash is installed"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SELF-BRANCH-DEFAULT: OOSH_SELF_BRANCH preserved for promote rewrites
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-SELF-BRANCH-DEFAULT: OOSH_SELF_BRANCH default preserved" \
  echo "(grep)"
if grep -qE 'OOSH_SELF_BRANCH="\$\{OOSH_SELF_BRANCH:-[A-Za-z0-9_-]*\}"' "$INIT_SCRIPT"; then
  expect.pass "OOSH_SELF_BRANCH default preserved — promote will still rewrite on dev→testing→prod"
else
  expect.fail "OOSH_SELF_BRANCH pattern missing — promote.rewrite.self.branch would have no target to rewrite"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-DOT-COMMAND: Install oosh.command wrapper exists, executable, invokes init/oosh
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-DOT-COMMAND: Install oosh.command drag-and-drop wrapper present" \
  echo "(stat + grep)"
CMD="$OOSH_DIR/Install oosh.command"
if [ -x "$CMD" ] && grep -qE '\./init/oosh' "$CMD"; then
  expect.pass "Install oosh.command is executable and invokes ./init/oosh"
else
  expect.fail "Install oosh.command missing, not executable, or doesn't invoke init/oosh"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-NO-OLD-SCAFFOLDING: dead-weight bootstrap functions are gone
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-NO-OLD-SCAFFOLDING: old bootstrap functions removed" \
  echo "(grep -cE)"
if grep -qE 'oosh_check_all_pm|oosh_parse_shellps|oosh_install_remote|oosh_setup_env|oosh_status' "$INIT_SCRIPT"; then
  expect.fail "init/oosh still contains old bootstrap scaffolding (oosh_* functions)"
else
  expect.pass "init/oosh no longer contains old bootstrap scaffolding"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-OSSH-RETRY-HINT : the MODE=root prereq-error branch points admins at
# `ossh prereqs.install <host>` rather than the curl one-liner.
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-OSSH-RETRY-HINT: MODE=root error-retry hint points at ossh prereqs.install" \
  echo "(grep)"
if grep -qE 'ossh prereqs\.install.*REMOTE_SSH_HOST' "$INIT_SCRIPT"; then
  expect.pass "init/oosh suggests ossh prereqs.install in the ossh-install flow"
else
  expect.fail "init/oosh still points at the curl one-liner for MODE=root failures"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-ALPINE-BUSYBOX-SUID : the curl/drag-and-drop install path runs init/oosh
# directly (no ossh.prereqs.install). For alpine targets, init/oosh must heal
# /bin/busybox suid bit after its sudo re-exec, otherwise post-install
# `user login <user>` from non-root fails with "su: must be suid to work properly".
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-ALPINE-BUSYBOX-SUID: init/oosh sets suid on /bin/busybox for apk hosts after sudo re-exec" \
  echo "(grep)"
if grep -qE 'command -v apk.*&&.*\[ -e /bin/busybox \]' "$INIT_SCRIPT" \
   && grep -qE 'chmod u\+s /bin/busybox' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has busybox-suid heal for alpine"
else
  expect.fail "init/oosh missing busybox-suid heal — curl/drag-and-drop install on alpine will leave user.login broken"
fi

test.suite.save.results
