#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

source this
source test.suite

log.level $level

# Check if install script exists
if ! [ -f "$OOSH_DIR/install" ] && ! [ -f "$OOSH_DIR/old/install" ]; then
  echo -e "\e[1;33m  ⚠ SKIPPED: install script not available (deprecated)\e[0m"
  test.suite.save.results
  exit 0
fi

# Source from old/ if that's where it is
if [ -f "$OOSH_DIR/old/install" ]; then
  source "$OOSH_DIR/old/install"
else
  source install
fi

test.install()
{
((TEST_COUNTER++))
console.log "


Test 0: install \"$*\"
===================================================================="
install.start "$@"
console.log "RETURN: $RETURN_VALUE  Result: $RESULT
===================================================================="
}

test.case - "install test start" \
   install $*
expect 0 "*" "Test start"

### test.method

