#!/usr/bin/env bash
# Tests for init/oosh — thin bootstrap contract. Asserts prereq guards,
# mode-root arg parsing, handoff to ossh install.continue.local, size
# shrink target, OOSH_SELF_BRANCH preservation, and the Install-oosh.command
# drag-and-drop wrapper.
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

INIT_SCRIPT="$OOSH_DIR/init/oosh"

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-BASH-PREREQ: init/oosh has a bash 4+ prereq guard with install hint
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-BASH-PREREQ: init/oosh errors out if bash major < 4" \
  echo "(grep)"
if grep -qE '! *oosh_bash_ok' "$INIT_SCRIPT" \
   && grep -qE 'bash 4\+' "$INIT_SCRIPT" \
   && grep -qE 'brew install bash' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has a bash 4+ prereq guard with macOS install hint"
else
  expect.fail "init/oosh missing bash 4+ prereq guard or install hint"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-GIT-PREREQ: init/oosh has a git prereq guard with install hint
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-GIT-PREREQ: init/oosh errors out if git not on PATH" \
  echo "(grep)"
if grep -qE 'command -v git' "$INIT_SCRIPT" \
   && grep -qE '_oosh_append +_oosh_missing +"git"' "$INIT_SCRIPT" \
   && grep -qE 'xcode-select --install' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has a git prereq guard with macOS install hint"
else
  expect.fail "init/oosh missing git prereq guard or install hint"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-MODE-ROOT-PARSE: `mode root` arg path preserved for ossh install
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-MODE-ROOT-PARSE: mode root arg path is preserved for ossh install compat" \
  echo "(grep)"
if grep -qE '\[ +"\$1" += +"mode" +\]' "$INIT_SCRIPT"; then
  expect.pass "init/oosh parses 'mode root' invocation"
else
  expect.fail "init/oosh dropped 'mode root' parsing — breaks ossh install"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-HANDS-OFF: init/oosh ends with exec ossh install.continue.local
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-HANDS-OFF: init/oosh hands off to ossh install.continue.local" \
  echo "(grep)"
if grep -qE '"\$OOSH_DIR/this" +call +ossh +install\.continue\.local' "$INIT_SCRIPT"; then
  expect.pass "init/oosh hands off to ossh install.continue.local"
else
  expect.fail "init/oosh missing handoff to install.continue.local"
fi

test.case $level "T-INIT-INSTALL-FOR-SUDO-USER: init/oosh installs oosh for SUDO_USER after state machine" \
  echo "(grep)"
if grep -qE 'SUDO_USER.*!=.*root' "$INIT_SCRIPT" \
   && grep -qE '"\$OOSH_DIR/user" +oosh\.install +"\$SUDO_USER"' "$INIT_SCRIPT"; then
  expect.pass "init/oosh runs user.oosh.install for SUDO_USER when non-root invoker sudo-re-exec'd"
else
  expect.fail "init/oosh missing post-install user.oosh.install for SUDO_USER — non-root curl won't set up the invoker"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SIZE-CAP: init/oosh stays bounded — ≤ 700 lines.
# History: was ~650 (fat), shrunk to ~350 (thin), now ~600 (self-installing
# again — POSIX prelude in Phase A handles platform deps so ossh.prereqs.install
# becomes a thin SCP-and-run wrapper). The 700-line cap is a soft anti-bloat
# guard, not a thin-bootstrap target.
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-SIZE-CAP: init/oosh is bounded (≤ 700 lines)" \
  echo "(wc -l)"
lines=$(wc -l < "$INIT_SCRIPT")
if [ "$lines" -le 700 ]; then
  expect.pass "init/oosh is $lines lines (cap 700; POSIX prelude + bash phase)"
else
  expect.fail "init/oosh is $lines lines — over the 700-line anti-bloat cap"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-BASH-PATH-PREPEND: init/oosh prepends brew bash dir to PATH
# ─────────────────────────────────────────────────────────────────────────
# init/oosh runs under sh, so it doesn't re-exec under bash. But the
# framework (ossh, oo, state, this) downstream needs bash 4+. macOS ssh
# non-login non-interactive sessions get PATH=/usr/bin:/bin:/usr/sbin:/sbin
# from launchd; /etc/paths.d/* is only consulted by login shells. So
# init/oosh prepends /opt/homebrew/bin (or /usr/local/bin) to PATH if it
# contains bash, ensuring downstream `#!/usr/bin/env bash` shebangs
# resolve to bash 4+.
test.case $level "T-INIT-BASH-PATH-PREPEND: init/oosh prepends brew bash dir to PATH for downstream consumers" \
  echo "(grep)"
if grep -qE '_bashCandidate in /opt/homebrew/bin /usr/local/bin' "$INIT_SCRIPT" \
   && grep -qE 'export PATH="\$_bashCandidate:\$PATH"' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prepends brew bash dir to PATH"
else
  expect.fail "init/oosh missing brew-bash PATH-prepend — bash-3.2 ssh sessions on macOS will not find bash 4+ for downstream framework"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SUDO-CURL-PIPE: sudo re-exec pre-clones when $0 isn't a real file
# ─────────────────────────────────────────────────────────────────────────
# When init/oosh is invoked via `sh -c "$(curl …/init/oosh)"` (the
# documented curl one-liner AND the Install oosh.command wrapper's
# no-sibling fallback), $0 is the literal "sh"/"bash", not a filesystem
# path. Without a no-real-file fallback, `exec sudo -H -E sh "$0" "$@"`
# makes the kernel treat "sh"/"bash" as a script name → PATH-resolves
# to /bin/sh → fails to read the binary with "cannot execute binary
# file" (exit 126). The fix: pre-clone the repo to a temp dir so we
# have a real init/oosh file to hand to sudo.
test.case $level "T-INIT-SUDO-CURL-PIPE: sudo re-exec pre-clones when \$0 isn't a real file" \
  echo "(grep)"
# Extract just the sudo re-exec block.
SUDO_REEXEC=$(awk '/Non-root.*sudo re-exec/{found=1} found{print; if(found && /^fi$/){exit}}' "$INIT_SCRIPT")
if printf "%s" "$SUDO_REEXEC" | grep -qE '\[ ! -f "\$0" \]' \
   && printf "%s" "$SUDO_REEXEC" | grep -qE 'mktemp -d' \
   && printf "%s" "$SUDO_REEXEC" | grep -qE 'git clone -b "\$OOSH_BRANCH"'; then
  expect.pass "init/oosh sudo re-exec handles curl-pipe (no-real-file) via pre-clone"
else
  expect.fail "init/oosh sudo re-exec missing no-real-file fallback — curl one-liner and drag-and-drop standalone .command will fail with 'cannot execute binary file'"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-SELF-BRANCH-DEFAULT: OOSH_SELF_BRANCH preserved for promote rewrites
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-SELF-BRANCH-DEFAULT: OOSH_SELF_BRANCH default preserved" \
  echo "(grep)"
if grep -qE 'OOSH_SELF_BRANCH="\$\{OOSH_SELF_BRANCH:-[A-Za-z0-9_-]*\}"' "$INIT_SCRIPT"; then
  expect.pass "OOSH_SELF_BRANCH default preserved — promote will still rewrite on dev→testing→prod"
else
  expect.fail "OOSH_SELF_BRANCH pattern missing — promote.rewrite.self.branch would have no target to rewrite"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-DOT-COMMAND: Install oosh.command wrapper exists, executable, invokes init/oosh
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-DOT-COMMAND: Install oosh.command drag-and-drop wrapper present" \
  echo "(stat + grep)"
CMD="$OOSH_DIR/Install oosh.command"
if [ -x "$CMD" ] && grep -qE '\./init/oosh' "$CMD"; then
  expect.pass "Install oosh.command is executable and invokes ./init/oosh"
else
  expect.fail "Install oosh.command missing, not executable, or doesn't invoke init/oosh"
fi

# ─────────────────────────────────────────────────────────────────────────
# T-INIT-NO-OLD-SCAFFOLDING: dead-weight bootstrap functions are gone
# ─────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-NO-OLD-SCAFFOLDING: old bootstrap functions removed" \
  echo "(grep -cE)"
if grep -qE 'oosh_check_all_pm|oosh_parse_shellps|oosh_install_remote|oosh_setup_env|oosh_status' "$INIT_SCRIPT"; then
  expect.fail "init/oosh still contains old bootstrap scaffolding (oosh_* functions)"
else
  expect.pass "init/oosh no longer contains old bootstrap scaffolding"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-OSSH-RETRY-HINT : the MODE=root prereq-error branch points admins at
# `ossh prereqs.install <host>` rather than the curl one-liner.
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-OSSH-RETRY-HINT: MODE=root error-retry hint points at ossh prereqs.install" \
  echo "(grep)"
if grep -qE 'ossh prereqs\.install.*REMOTE_SSH_HOST' "$INIT_SCRIPT"; then
  expect.pass "init/oosh suggests ossh prereqs.install in the ossh-install flow"
else
  expect.fail "init/oosh still points at the curl one-liner for MODE=root failures"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-ALPINE-BUSYBOX-SUID : the curl/drag-and-drop install path runs init/oosh
# directly (no ossh.prereqs.install). For alpine targets, init/oosh must heal
# /bin/busybox suid bit after its sudo re-exec, otherwise post-install
# `user login <user>` from non-root fails with "su: must be suid to work properly".
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "T-INIT-ALPINE-BUSYBOX-SUID: init/oosh sets suid on /bin/busybox for apk hosts after sudo re-exec" \
  echo "(grep)"
if grep -qE 'command -v apk.*&&.*\[ -e /bin/busybox \]' "$INIT_SCRIPT" \
   && grep -qE 'chmod u\+s /bin/busybox' "$INIT_SCRIPT"; then
  expect.pass "init/oosh has busybox-suid heal for alpine"
else
  expect.fail "init/oosh missing busybox-suid heal — curl/drag-and-drop install on alpine will leave user.login broken"
fi

# ─────────────────────────────────────────────────────────────────────────────
# T-INIT-INSTALL-* : the platform install logic that used to live in
# ossh.prereqs.install moved INTO init/oosh's POSIX prelude. These tests
# replicate the assertions that were previously in test.ossh against
# `declare -f ossh.prereqs.install`, but now read init/oosh's body directly.
# Same coverage, new home — single source of truth.
# ─────────────────────────────────────────────────────────────────────────────

# T-INIT-INSTALL-PM-DETECT: PM detection covers brew + apt-get + dnf + yum +
# apk + pacman + pkg, mirroring ossh.pm.discover (ossh:2128-2140).
test.case $level "T-INIT-INSTALL-PM-DETECT: prelude PM detection covers all supported managers" \
  echo "(grep)"
if grep -qE 'for _pm in brew apt-get dnf yum apk pacman pkg' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude detects brew/apt-get/dnf/yum/apk/pacman/pkg"
else
  expect.fail "init/oosh prelude PM detect missing one or more managers"
fi

# T-INIT-INSTALL-BREW-BOOTSTRAP: naked macOS images get Homebrew bootstrapped
# non-interactively when no PM is detected, matching what ossh.prereqs.install
# used to do at lines 2204-2224.
test.case $level "T-INIT-INSTALL-BREW-BOOTSTRAP: prelude bootstraps Homebrew on naked macOS" \
  echo "(grep)"
if grep -qE 'NONINTERACTIVE=1.*Homebrew/install' "$INIT_SCRIPT" \
   && grep -qE 'uname -s.*Darwin' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude bootstraps Homebrew when no PM is detected on macOS"
else
  expect.fail "init/oosh prelude missing Homebrew bootstrap — naked macOS images (no PM) will leave bash 4+ never landed"
fi

# T-INIT-INSTALL-BREW-PATHSD: brew bash install must wire /etc/paths.d/oosh-homebrew
# so non-interactive ssh sessions find /opt/homebrew/bin/bash. Same reasoning as
# the prior ossh.prereqs.install test — moved here.
test.case $level "T-INIT-INSTALL-BREW-PATHSD: prelude wires /etc/paths.d/oosh-homebrew on brew hosts" \
  echo "(grep)"
if grep -qE '/etc/paths\.d/oosh-homebrew' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude wires /etc/paths.d/oosh-homebrew for brew"
else
  expect.fail "init/oosh prelude missing /etc/paths.d/oosh-homebrew wiring — non-interactive ssh on macOS won't find brew bash"
fi

# T-INIT-INSTALL-AUTO: the bash phase auto-installs git/sudo/curl via $OOSH_PM
# when they're missing, instead of failing immediately with the framed error.
# The framed error remains as the final fallback when no PM is available.
test.case $level "T-INIT-INSTALL-AUTO: bash phase tries auto-install before falling back to the framed error" \
  echo "(grep)"
if grep -qE '_oosh_install_one git' "$INIT_SCRIPT" \
   && grep -qE '_oosh_install_one sudo' "$INIT_SCRIPT"; then
  expect.pass "init/oosh bash phase calls _oosh_install_one for git/sudo before producing the framed error"
else
  expect.fail "init/oosh bash phase missing auto-install attempt — users see the framed error even when the PM could install the missing prereqs"
fi

# T-INIT-INSTALL-APT-UPDATE-GATE: apt-get update is gated by OOSH_APT_UPDATED
# so re-exec'd children don't repeat the (slow) `apt-get update` step.
test.case $level "T-INIT-INSTALL-APT-UPDATE-GATE: apt-get update is gated by OOSH_APT_UPDATED" \
  echo "(grep)"
if grep -qE 'OOSH_APT_UPDATED' "$INIT_SCRIPT"; then
  expect.pass "init/oosh prelude has OOSH_APT_UPDATED gate"
else
  expect.fail "init/oosh prelude missing OOSH_APT_UPDATED gate — children will re-run apt-get update wastefully"
fi

# T-INIT-PRELUDE-POSIX: the prelude must use POSIX-only constructs so it works
# under dash/ash/busybox before bash is installed. Quick syntactic guard:
# parses cleanly under dash up to the bash-phase boundary.
test.case $level "T-INIT-PRELUDE-POSIX: Phase A prelude is POSIX-clean (parses under dash)" \
  echo "(awk + dash -n)"
if command -v dash >/dev/null 2>&1; then
  _preludeFile="$(mktemp)"
  awk '/^# Phase B —/{exit} {print}' "$INIT_SCRIPT" > "$_preludeFile"
  if dash -n "$_preludeFile" 2>/dev/null; then
    expect.pass "Phase A prelude parses under dash"
  else
    expect.fail "Phase A prelude has non-POSIX syntax — will fail under dash/ash/busybox before bash is installed"
  fi
  rm -f "$_preludeFile"
else
  expect.pass "dash not installed locally — skipping POSIX-clean check (CI covers it)"
fi

test.suite.save.results
