#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source $OOSH_DIR/ogit   # once, not loaded per test (the boss, 2026-10-22)

log.level $level

# ============================================================================
# META-TEST: This test validates that test.suite correctly counts pass/fail
# ============================================================================
#
# IMPORTANT: This test file contains ONE INTENTIONAL FAILURE to verify that
# the test.suite correctly counts and reports failures.
#
# Expected results:
#   - Total assertions: 7
#   - Passed: 6
#   - Failed: 1 (the intentional failure)
#
# If all 5 tests pass, the counter logic is BROKEN!
# If more than 1 test fails, there's a real bug.
#
# DO NOT "FIX" THE INTENTIONAL FAILURE - it's testing the test framework!
# ============================================================================

echo ""
echo -e "\e[1;35m╔════════════════════════════════════════════════════════════════════╗\e[0m"
echo -e "\e[1;35m║  META-TEST: Testing the test.suite framework itself               ║\e[0m"
echo -e "\e[1;35m║  Expected: 4 PASS, 1 FAIL (intentional)                           ║\e[0m"
echo -e "\e[1;35m╚════════════════════════════════════════════════════════════════════╝\e[0m"

# Store initial counter values
INITIAL_TEST_COUNT=$TEST_SUITE_TEST_COUNTER
INITIAL_EXPECT_COUNT=$TEST_SUITE_EXPECT_COUNTER
INITIAL_SUCCESS_COUNT=$TEST_SUITE_SUCCESS_COUNTER

# ============================================================================
# Test 1: expect.pass increments both counters
# ============================================================================

test.case $level "expect.pass - increments counters correctly" \
  true

BEFORE_EXPECT=$TEST_SUITE_EXPECT_COUNTER
BEFORE_SUCCESS=$TEST_SUITE_SUCCESS_COUNTER

expect.pass "this should pass and increment both counters"

if [ "$TEST_SUITE_EXPECT_COUNTER" -eq $((BEFORE_EXPECT + 1)) ] && \
   [ "$TEST_SUITE_SUCCESS_COUNTER" -eq $((BEFORE_SUCCESS + 1)) ]; then
  expect.pass "expect.pass incremented EXPECT and SUCCESS counters"
else
  expect.fail "expect.pass should increment both counters"
fi

# ============================================================================
# Test 2: expect.fail increments only EXPECT counter (not SUCCESS)
# ============================================================================

test.case $level "expect.fail - increments only EXPECT counter" \
  true

BEFORE_EXPECT=$TEST_SUITE_EXPECT_COUNTER
BEFORE_SUCCESS=$TEST_SUITE_SUCCESS_COUNTER

# We'll check the delta after calling expect.fail
# Note: We need to call it but it will show as a failure - that's expected

# ============================================================================
# INTENTIONAL FAILURE - DO NOT FIX
# ============================================================================
# This failure is BY DESIGN to verify that:
# 1. expect.fail properly increments EXPECT_COUNTER but not SUCCESS_COUNTER
# 2. The final summary correctly shows 1 failure
# 3. The test framework is working correctly
#
# If you see this test passing, the test framework is BROKEN!
# ============================================================================
echo -e "\e[1;35m  ┌─────────────────────────────────────────────────────────────────┐\e[0m"
echo -e "\e[1;35m  │ INTENTIONAL FAILURE BELOW - THIS VERIFIES COUNTER LOGIC        │\e[0m"
echo -e "\e[1;35m  └─────────────────────────────────────────────────────────────────┘\e[0m"

expect.fail "INTENTIONAL: This failure tests that failures are counted correctly"

# Verify expect.fail only incremented EXPECT, not SUCCESS
if [ "$TEST_SUITE_EXPECT_COUNTER" -eq $((BEFORE_EXPECT + 1)) ] && \
   [ "$TEST_SUITE_SUCCESS_COUNTER" -eq "$BEFORE_SUCCESS" ]; then
  expect.pass "expect.fail correctly incremented only EXPECT counter"
else
  expect.fail "expect.fail should only increment EXPECT counter"
fi

# ============================================================================
# Test 3: test.case increments TEST_COUNTER
# ============================================================================

BEFORE_TEST=$TEST_SUITE_TEST_COUNTER

test.case $level "test.case - increments TEST counter" \
  true

if [ "$TEST_SUITE_TEST_COUNTER" -eq $((BEFORE_TEST + 1)) ]; then
  expect.pass "test.case incremented TEST_COUNTER"
else
  expect.fail "test.case should increment TEST_COUNTER"
fi

# ============================================================================
# Test 4: private.test.suite.category reads core from a core test file
# ============================================================================

test.case $level "private.test.suite.category reads core marker" \
  private.test.suite.category "$OOSH_DIR/test/test.this"
expect 0 "core" "test.this is categorized as core"

# ============================================================================
# Test 5: private.test.suite.category defaults to extended for unmarked files
# ============================================================================

test.case $level "private.test.suite.category defaults to extended" \
  private.test.suite.category "$OOSH_DIR/test/test.claudeCode"
expect 0 "extended" "test.claudeCode defaults to extended"

# ============================================================================
# T-RESULTS-NO-INHERIT — a file that saves no result inherits nothing
# ============================================================================
# test.suite.save.results writes $CONFIG_PATH/testresult.env and the runner
# reads it back as that file's score. The runner used to zero only the shell
# VARIABLES and leave the FILE, so a file that never called save.results was
# scored with the previous file's numbers. test.tilde reporting test.this's 31
# assertions was the instance that exposed it.
#
# Driven against the primitive with a fixture TEST_SUITE_RESULT_PATH (dynamic
# scoping — private.test.suite.results.file reads it), so the real shared
# ~/config is never touched and no state is borrowed from the surrounding run.
# Driven END-TO-END through the real runner against test.colors, which asserts
# nothing and never calls test.suite.save.results. A unit check of the clear
# primitive alone would be tautological: once the handoff is removed, the
# "inherited" branch can never fire. Only the runner path proves the score a
# score-less file actually receives.
test.test.suite.resultsNoInherit() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.results.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }

  # a previous file's score, exactly as test.suite.save.results writes it,
  # planted where the runner will look
  printf 'export TEST_SUITE_TEST_COUNTER="9"\nexport TEST_SUITE_EXPECT_COUNTER="31"\nexport TEST_SUITE_SUCCESS_COUNTER="31"\n' \
    > "$fix/testresult.env"

  local out
  out=$(TEST_SUITE_RESULT_PATH="$fix" "$OOSH_DIR/test.suite" run colors 1 2>&1 \
        | sed 's/\x1b\[[0-9;]*m//g')
  rm -rf "$fix" 2>/dev/null

  if echo "$out" | grep -q '31 assertions'; then
    create.result 1 "test.colors was scored with the previous file's 31 assertions"
  elif ! echo "$out" | grep -q 'NO RESULTS'; then
    create.result 1 "no warning that the file produced no score of its own"
  elif ! echo "$out" | grep -q '0 / 0 assertions'; then
    create.result 1 "did not report 0 / 0: $(echo "$out" | grep -m1 'Results:')"
  else
    create.result 0 "0 assertions inherited"
  fi
  return $(result)
}
test.case $level "T-RESULTS-NO-INHERIT: a file that saves nothing inherits nothing" \
  test.test.suite.resultsNoInherit
expect 0 "0 assertions inherited" \
  "the previous file's score must never become this file's score"

# ============================================================================
# T-FIXTURE-* — a test file must not rewrite the shared config tier
# ============================================================================
# ~/config is a SITE-WIDE sharedConfig sourced by every user at login.
# test/test.path sources `path`, and path.append/prepend/remove each end in
# private.update.config, whose body is a NO-ARG `config save` — which truncates
# user.env and regenerates oosh.env and log.env from the current process env.
#
# The proof is a planted CANARY, not a checksum. config.save rewrites those
# files byte-identically from the same environment, and test.oo (which sorts
# earlier) has its own pollution erased by test.path's later truncate — so a
# content diff or a hash is a guaranteed false negative. Only a marker that a
# rewrite destroys can see it. mtime would work by hand on Linux but not in a
# test: BSD stat on the macOS runners has whole-second resolution.
test.test.suite.fixtureSharedConfig() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.fixture.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local canary="# OOSH-SHARED-CANARY-$$"
  local f
  for f in user.env oosh.env log.env; do
    printf 'export BASH_FILE="/usr/bin/bash"\nexport CONFIG_FILE="user.env"\n%s\n' "$canary" > "$fix/$f"
  done
  : > "$fix/result.env"

  # Run the real file the way the runner does (kernel exec), with both anchors
  # AND the results path pointed at the simulated shared dir. Without
  # TEST_SUITE_RESULT_PATH the child would inherit ours and clobber this file's
  # own score.
  env CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
      TEST_SUITE_RESULT_PATH="$fix" \
      "$OOSH_DIR/test/test.path" 1 >/dev/null 2>&1

  local missing=""
  for f in user.env oosh.env log.env; do
    grep -qF "$canary" "$fix/$f" 2>/dev/null || missing="$missing $f"
  done
  # grep, not source — sourcing would clobber THIS file's live counters
  local landed=0
  [ -f "$fix/testresult.env" ] \
    && landed=$(grep -m1 TEST_SUITE_EXPECT_COUNTER "$fix/testresult.env" | cut -d'"' -f2)
  rm -rf "$fix" 2>/dev/null

  if [ -n "$missing" ]; then
    create.result 1 "test.path rewrote the shared tier; canary destroyed in:$missing"
  elif [ "${landed:-0}" -le 0 ]; then
    create.result 1 "test.path's score never reached the TEST_SUITE_RESULT_PATH it was given — the config fixture swallowed it"
  else
    # Fixed literal — the expect below matches it exactly. Never `expect 0 "*"`,
    # which would set the expectation to whatever actually happened.
    create.result 0 "shared tier intact, score landed"
  fi
  return $(result)
}
test.case $level "T-FIXTURE-SHARED-CONFIG: test.path leaves the inherited config tier alone" \
  test.test.suite.fixtureSharedConfig
expect 0 "shared tier intact, score landed" \
  "a core test must never rewrite the site-wide config every user sources at login"

# ============================================================================
# T-SHARED-CANARY-* — the RUNNER guards the shared tier, for every file
# ============================================================================
# test.suite.config.isolate is opt-in: the next file that forgets the line
# rewrites the site-wide tier again, and only the isolating file itself carries
# a canary. Worse, isolation only redirects writes addressed through
# $CONFIG_PATH — test.log's T31 wrote the real shared log.env through a
# hardcoded $HOME/config path while believing itself isolated (fixed f9c3802).
# So the runner fingerprints the tier around EVERY core and extended child,
# names the offender, puts the tier back, and fails the run.

test.test.suite.shared.fixture() { # <dir> # a simulated shared tier with the three files a no-arg config.save rewrites
  local f
  for f in user.env oosh.env log.env; do
    printf 'export OOSH_CANARY_%s="original"\n' "${f%%.*}" > "$1/$f"
  done
}

# --- T-SHARED-CANARY-DETECTS ------------------------------------------------
test.test.suite.sharedCanaryDetects() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.canary.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run"
  # A subshell: the pins below must not leak into THIS file's own scoring.
  local out rc
  out=$(
    export TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run"
    private.test.suite.shared.snapshot >/dev/null 2>&1 || { echo "SNAPSHOT-FAILED"; exit 1; }
    if private.test.suite.shared.verify probeFile >/dev/null 2>&1; then
      : # clean tier verifies clean, as it must
    else
      echo "CLEAN-TIER-REPORTED-DIRTY: $RESULT"; exit 1
    fi
    printf 'export OOSH_CANARY_oosh="rewritten"\n' > "$fix/oosh.env"
    if private.test.suite.shared.verify probeFile >/dev/null 2>&1; then
      echo "WRITE-NOT-DETECTED"; exit 1
    fi
    echo "$RESULT"
  ); rc=$?
  rm -rf "$fix" 2>/dev/null
  if [ "$rc" -ne 0 ]; then
    create.result 1 "${out:-verify did not report the write}"
  elif [ "${out#*oosh.env}" = "$out" ]; then
    create.result 1 "did not name the file that changed: [$out]"
  elif [ "${out#*user.env}" != "$out" ]; then
    create.result 1 "named a file that did NOT change: [$out]"
  elif [ "${out#*probeFile}" = "$out" ]; then
    create.result 1 "did not name the test file responsible: [$out]"
  else
    create.result 0 "the write is detected and both the file and the offender are named"
  fi
  return $(result)
}
test.case $level "T-SHARED-CANARY-DETECTS: a rewritten shared file is caught and named, an untouched one is not" \
  test.test.suite.sharedCanaryDetects
expect 0 "the write is detected and both the file and the offender are named" \
  "opt-in isolation cannot see a file that never opted in"

# --- T-SHARED-CANARY-MTIME --------------------------------------------------
# The fingerprint must be CONTENT ONLY. The tier is owned by developking and
# merely group-writable, so a test user can put a file's content back but
# cannot put its mtime back — `cp -p` needs ownership for utimensat. An
# mtime-sensitive stamp therefore turned one genuine write into a permanent
# mismatch, and the alpine platform run of 2026-09-16 duly reported fourteen
# consecutive "offenders" that had touched nothing at all.
test.test.suite.sharedCanaryIgnoresMtime() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.mtime.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run"
  local out rc
  out=$(
    export TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run"
    private.test.suite.shared.snapshot >/dev/null 2>&1 || { echo "SNAPSHOT-FAILED"; exit 1; }
    # Same bytes, new timestamp — exactly what a non-owner restore leaves behind.
    touch "$fix/user.env" "$fix/oosh.env" "$fix/log.env"
    private.test.suite.shared.verify probeFile >/dev/null 2>&1 || { echo "MTIME-REPORTED-AS-A-WRITE: $RESULT"; exit 1; }
    # and a real content change is still caught
    printf 'export OOSH_CANARY_user="rewritten"\n' > "$fix/user.env"
    private.test.suite.shared.verify probeFile >/dev/null 2>&1 && { echo "CONTENT-CHANGE-MISSED"; exit 1; }
    echo "$RESULT"
  ); rc=$?
  rm -rf "$fix" 2>/dev/null
  if [ "$rc" -ne 0 ]; then
    create.result 1 "${out:-the stamp is sensitive to something other than content}"
  elif [ "${out#*user.env}" = "$out" ]; then
    create.result 1 "the content change was reported without naming the file: [$out]"
  else
    create.result 0 "a new timestamp is not a write, a new byte is"
  fi
  return $(result)
}
test.case $level "T-SHARED-CANARY-MTIME: the fingerprint is content, not timestamps" \
  test.test.suite.sharedCanaryIgnoresMtime
expect 0 "a new timestamp is not a write, a new byte is" \
  "a test user can restore a shared file's content but not its mtime — stamping mtime cascades"

# --- T-SHARED-CANARY-RESTORES -----------------------------------------------
test.test.suite.sharedCanaryRestores() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.restore.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run"
  local out rc
  out=$(
    export TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run"
    private.test.suite.shared.snapshot >/dev/null 2>&1 || { echo "SNAPSHOT-FAILED"; exit 1; }
    printf 'export OOSH_CANARY_user="rewritten"\n' > "$fix/user.env"
    rm -f "$fix/log.env"                       # a file DELETED by the offender
    printf 'export X="1"\n' > "$fix/extra.env" # a file the snapshot never saw
    private.test.suite.shared.restore >/dev/null 2>&1 || { echo "RESTORE-FAILED: $RESULT"; exit 1; }
    # the tier must now verify clean against the stamp pinned before the damage
    private.test.suite.shared.verify probeFile >/dev/null 2>&1 || { echo "STILL-DIRTY: $RESULT"; exit 1; }
    cat "$fix/user.env"
    [ -f "$fix/extra.env" ] || echo "COLLATERAL-REMOVAL"
  ); rc=$?
  rm -rf "$fix" 2>/dev/null
  if [ "$rc" -ne 0 ]; then
    create.result 1 "${out:-restore did not put the tier back}"
  elif [ "${out#*COLLATERAL}" != "$out" ]; then
    create.result 1 "restore removed a file it never snapshotted"
  elif [ "${out#*rewritten}" != "$out" ]; then
    create.result 1 "the rewritten content survived the restore: [$out]"
  elif [ "${out#*original}" = "$out" ]; then
    create.result 1 "the original content did not come back: [$out]"
  else
    create.result 0 "the tier is put back, byte for byte, and nothing else is touched"
  fi
  return $(result)
}
test.case $level "T-SHARED-CANARY-RESTORES: the snapshot undoes the damage, including a deletion" \
  test.test.suite.sharedCanaryRestores
expect 0 "the tier is put back, byte for byte, and nothing else is touched" \
  "the tier is site-wide — one bad test file must not leave it broken for every user on the box"

# --- T-SHARED-CANARY-RUNNER -------------------------------------------------
# End to end, through the real runner. The unit checks above prove the
# primitives; only this proves the RUNNER calls them. The throwaway probe file
# lives in the fixture and is run by its path (T-SUITE-RUN-PATH), so nothing is
# written into the tracked test folder and an interrupted run leaves nothing in
# the suite's glob.
test.test.suite.sharedCanaryRunner() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.runner.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local probe="$fix/test.sharedTierProbe"
  trap 'rm -rf "'"$fix"'"' RETURN
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run"
  {
    echo '#!/usr/bin/env bash'
    echo 'TEST_CATEGORY=core'
    echo 'source this'
    echo 'source test.suite'
    # exactly the defect under test: a production write to the inherited tier
    echo 'printf %s\\n "export OOSH_CANARY_oosh=\"probe\"" > "$CONFIG_PATH/oosh.env"'
    echo 'expect.pass "the probe asserted something"'
    echo 'test.suite.save.results'
  } > "$probe"
  chmod +x "$probe"

  local out rc
  # Capture first, strip colours second. A pipeline would hand back sed's exit
  # status, not the runner's, and the runner's status is the whole assertion.
  # TEST_SUITE_CONFIG_ORIGIN must be pinned alongside CONFIG_PATH. It is
  # exported, so this nested runner would otherwise inherit THIS run's origin —
  # the real ~/config — snapshot that instead of the fixture, find it untouched
  # and report green while the probe merrily rewrote the fixture.
  out=$(env CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
            TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run" \
            "$OOSH_DIR/test.suite" run "$probe" 1 2>&1); rc=$?
  out=$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g')
  local after; after=$(cat "$fix/oosh.env" 2>/dev/null)

  if [ "$rc" -eq 0 ]; then
    create.result 1 "the runner stayed green while the probe rewrote the shared tier"
  elif ! echo "$out" | grep -q 'SHARED CONFIG WRITTEN'; then
    create.result 1 "the runner did not report the write: $(echo "$out" | tail -3 | tr '\n' '|')"
  elif ! echo "$out" | grep -q 'test.sharedTierProbe'; then
    create.result 1 "the report does not name the offending file"
  elif ! echo "$out" | grep -q 'test.suite.config.isolate'; then
    create.result 1 "the report does not say how to fix it"
  elif [ "${after#*probe}" != "$after" ]; then
    create.result 1 "the runner did not restore the tier: [$after]"
  else
    create.result 0 "the runner catches it, names it, says how to fix it, and restores the tier"
  fi
  return $(result)
}
test.case $level "T-SHARED-CANARY-RUNNER: end to end, the runner itself catches a file that writes the tier" \
  test.test.suite.sharedCanaryRunner
expect 0 "the runner catches it, names it, says how to fix it, and restores the tier" \
  "the primitives being right proves nothing unless the runner actually calls them"

# --- T-SHARED-CANARY-WAIVER -------------------------------------------------
# Two core files cannot be isolated yet: test.completion.audit and test.config
# both SOURCE `config`, whose config.start re-runs config.init, which does an
# unconditional `export CONFIG_PATH=~/config` — the fixture is undone from
# inside the file under test. That is T7's blocker, not a test defect. Such a
# file declares TEST_SHARED_TIER_WRITER with the reason; the guard still
# reports it and still restores the tier, but does not fail the run. A waiver
# is a confession, not an exemption, and the count has to reach zero.
test.test.suite.sharedCanaryWaiver() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.waived.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local probe="$fix/test.sharedTierWaived"
  trap 'rm -rf "'"$fix"'"' RETURN
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run"
  {
    echo '#!/usr/bin/env bash'
    echo 'TEST_CATEGORY=core'
    echo 'TEST_SHARED_TIER_WRITER="blocked on T7: probe"'
    echo 'source this'
    echo 'source test.suite'
    echo 'printf %s\\n "export OOSH_CANARY_oosh=\"probe\"" > "$CONFIG_PATH/oosh.env"'
    echo 'expect.pass "the probe asserted something"'
    echo 'test.suite.save.results'
  } > "$probe"
  chmod +x "$probe"

  local out rc
  out=$(env CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
            TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run" \
            "$OOSH_DIR/test.suite" run "$probe" 1 2>&1); rc=$?
  out=$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g')
  local after; after=$(cat "$fix/oosh.env" 2>/dev/null)

  if [ "$rc" -ne 0 ]; then
    create.result 1 "a declared writer still failed the run (rc=$rc)"
  elif ! echo "$out" | grep -q 'SHARED CONFIG WRITTEN (known)'; then
    create.result 1 "the write was not reported at all — a waiver must still confess"
  elif ! echo "$out" | grep -q 'blocked on T7: probe'; then
    create.result 1 "the report does not carry the declared reason"
  elif [ "${after#*probe}" != "$after" ]; then
    create.result 1 "a waived writer was not restored: [$after]"
  else
    create.result 0 "a declared writer is reported and restored, but does not fail the run"
  fi
  return $(result)
}
test.case $level "T-SHARED-CANARY-WAIVER: a declared known writer is reported and restored, not failed" \
  test.test.suite.sharedCanaryWaiver
expect 0 "a declared writer is reported and restored, but does not fail the run" \
  "two core files cannot be isolated until T7 — the gate must stay meaningful without lying about them"

# ============================================================================
# T-REAL-SSH-* — the RUNNER guards the runner user's real ~/.ssh, for every file
# ============================================================================
# Incident 2026-10-16 12:46:31: during a run of test.ossh / test.user and the
# red harnesses, something rebuilt the REAL ~/.ssh/authorized_keys of the user
# running the suite from ~/.ssh/public_keys/ (mode 600) — a real
# `user authorized.keys.update` against the real ~/.ssh. Nobody saw it: the run
# stayed green and the culprit could not be found by reading. HOME=<fixture>
# does not isolate everything (ssh reads the passwd home, a helper may use a
# hardcoded ~), so the runner fingerprints the real ~/.ssh around EVERY core and
# extended child, exactly as it does the shared config tier, names the
# offender, fails the run and puts ~/.ssh back. Every test below points the
# guard at a FIXTURE home via TEST_SUITE_SSH_ORIGIN — never the real ~/.ssh.

test.test.suite.realSsh.fixture() { # <home> # a simulated ~/.ssh under <home>: config, known_hosts, a key pair on top, a key in each list folder, no authorized_keys; every private key holds the word PRIVATE
  local ssh="$1/.ssh"
  mkdir -p "$ssh/public_keys" "$ssh/private_key" "$ssh/ids/ssh.x"
  printf 'Host fixture\n  User fixture\n' > "$ssh/config"
  printf 'fixture.host ssh-ed25519 AAAAfixture\n' > "$ssh/known_hosts"
  printf 'ssh-ed25519 AAAAfixturekey fixture\n' > "$ssh/public_keys/a.public_key"
  printf 'PRIVATE fixture\n' > "$ssh/private_key/a.private_key"
  printf 'PRIVATE id\n' > "$ssh/ids/ssh.x/id_ed25519"
  printf 'PRIVATE top\n' > "$ssh/id_ed25519"
  printf 'ssh-ed25519 AAAAtop top\n' > "$ssh/id_ed25519.pub"
  chmod 640 "$ssh/public_keys/a.public_key"
  chmod 600 "$ssh/private_key/a.private_key" "$ssh/ids/ssh.x/id_ed25519" "$ssh/config" "$ssh/known_hosts" "$ssh/id_ed25519" "$ssh/id_ed25519.pub"
}

# --- T-REAL-SSH-DETECTS -----------------------------------------------------
# What the incident did (authorized_keys CREATED) and the other three shapes of
# damage: a changed file, a file that appears in a list folder, a removed file,
# and a mode change on a private key (ssh refuses a group-readable key).
test.test.suite.realSshDetects() {
  local fx out rc bad=""
  fx=$(test.suite.fixture.make test.test.suite.realssh.detects)
  test.test.suite.realSsh.fixture "$fx/home"
  mkdir -p "$fx/run"
  # A subshell: the pins below must not leak into THIS file's own guard.
  out=$(
    export TEST_SUITE_SSH_ORIGIN="$fx/home/.ssh" TEST_SUITE_RESULT_PATH="$fx/run"
    private.test.suite.ssh.snapshot >/dev/null 2>&1 || { echo "SNAPSHOT-FAILED"; exit 1; }
    private.test.suite.ssh.verify probeFile >/dev/null 2>&1 || { echo "CLEAN-REPORTED-DIRTY: $RESULT"; exit 1; }
    cat "$fx/home/.ssh/public_keys/a.public_key" > "$fx/home/.ssh/authorized_keys"
    printf 'other.host ssh-ed25519 AAAAother\n' >> "$fx/home/.ssh/known_hosts"
    printf 'ssh-ed25519 AAAAnew new\n' > "$fx/home/.ssh/ids/ssh.x/new.public_key"
    rm -f "$fx/home/.ssh/private_key/a.private_key"
    chmod 644 "$fx/home/.ssh/ids/ssh.x/id_ed25519"
    private.test.suite.ssh.verify probeFile >/dev/null 2>&1 && { echo "WRITE-NOT-DETECTED"; exit 1; }
    echo "$RESULT"
  ); rc=$?
  rm -rf "$fx"
  [ "$rc" = 0 ] || bad="$bad rc=$rc[$out]"
  case "$out" in *probeFile*) ;; *) bad="$bad offender-not-named" ;; esac
  case "$out" in *"authorized_keys (created)"*) ;; *) bad="$bad created-missed" ;; esac
  case "$out" in *"known_hosts (changed)"*) ;; *) bad="$bad changed-missed" ;; esac
  case "$out" in *"ids/ssh.x/new.public_key (created)"*) ;; *) bad="$bad listed-file-missed" ;; esac
  case "$out" in *"private_key/a.private_key (removed)"*) ;; *) bad="$bad removed-missed" ;; esac
  case "$out" in *"ids/ssh.x/id_ed25519 (changed)"*) ;; *) bad="$bad mode-missed" ;; esac
  case "$out" in *" config ("*) bad="$bad untouched-named" ;; esac
  [ -z "$bad" ] && create.result 0 "every write to ~/.ssh is caught and named, with the offender" || create.result 1 "detects:$bad"
  return $(result)
}
test.case $level "T-REAL-SSH-DETECTS: a created, changed, removed or re-moded file in ~/.ssh is caught and named" \
  test.test.suite.realSshDetects
expect 0 "every write to ~/.ssh is caught and named, with the offender" \
  "a real authorized_keys rebuild ran during a test run on 2026-10-16 and nothing noticed"

# --- T-REAL-SSH-RESTORES ----------------------------------------------------
# The guard puts ~/.ssh back: a CREATED file is removed (the guard must never
# leave — or re-create — an authorized_keys that was not there), a changed or
# removed file comes back byte for byte WITH its mode, a created folder goes.
# PRIVATE KEYS are never copied: a killed run would leave them in /tmp. So no
# copy of a fixture private key may exist anywhere under the run folder (found
# by content), and a changed private key is reported — still dirty after the
# restore — with "restore by hand: <path>", not put back.
test.test.suite.realSshRestores() {
  local fx out rc bad="" ssh
  fx=$(test.suite.fixture.make test.test.suite.realssh.restores)
  test.test.suite.realSsh.fixture "$fx/home"
  ssh="$fx/home/.ssh"
  mkdir -p "$fx/run"
  cp -p "$ssh/known_hosts" "$fx/known_hosts.orig"
  out=$(
    export TEST_SUITE_SSH_ORIGIN="$ssh" TEST_SUITE_RESULT_PATH="$fx/run"
    private.test.suite.ssh.snapshot >/dev/null 2>&1 || { echo "SNAPSHOT-FAILED"; exit 1; }
    grep -rlF "PRIVATE" "$fx/run" 2>/dev/null | sed 's/^/SECRET-COPIED:/'
    cat "$ssh/public_keys/a.public_key" > "$ssh/authorized_keys"
    printf 'rewritten\n' > "$ssh/known_hosts"
    rm -f "$ssh/public_keys/a.public_key"
    mkdir -p "$ssh/ids/ssh.new" && printf 'k.pub\n' > "$ssh/ids/ssh.new/id_ed25519.pub"
    chmod 644 "$ssh/id_ed25519.pub"
    private.test.suite.ssh.restore >/dev/null 2>&1 || { echo "RESTORE-FAILED: $RESULT"; exit 1; }
    private.test.suite.ssh.verify probeFile >/dev/null 2>&1 || { echo "STILL-DIRTY: $RESULT"; exit 1; }
    # now a secret: changed, reported, by hand, not restored
    printf 'PRIVATE changed\n' > "$ssh/private_key/a.private_key"
    private.test.suite.ssh.verify probeFile >/dev/null 2>&1 && { echo "SECRET-CHANGE-MISSED"; exit 1; }
    private.test.suite.ssh.report "$RESULT" probeFile 2>&1 | sed 's/\x1b\[[0-9;]*m//g'
    private.test.suite.ssh.verify probeFile >/dev/null 2>&1 && echo "SECRET-RESTORED"
    echo "restored"
  ); rc=$?
  [ "$rc" = 0 ] || bad="$bad rc=$rc[$out]"
  case "$out" in *SECRET-COPIED*) bad="$bad private-key-copied[$(echo "$out" | grep SECRET-COPIED | tr '\n' ' ')]" ;; esac
  case "$out" in *SECRET-RESTORED*) bad="$bad secret-restored" ;; esac
  case "$out" in *"private_key/a.private_key (changed)"*) ;; *) bad="$bad secret-not-reported" ;; esac
  case "$out" in *"restore by hand: $ssh/private_key/a.private_key"*) ;; *) bad="$bad no-by-hand-note" ;; esac
  [ "$(cat "$ssh/private_key/a.private_key" 2>/dev/null)" = "PRIVATE changed" ] || bad="$bad secret-touched"
  [ -e "$ssh/authorized_keys" ] && bad="$bad created-file-left"
  cmp -s "$fx/known_hosts.orig" "$ssh/known_hosts" || bad="$bad known_hosts-not-byte-identical"
  [ "$(private.test.suite.ssh.mode.get "$ssh/public_keys/a.public_key")" = 640 ] || bad="$bad removed-file-not-back-with-mode"
  [ "$(private.test.suite.ssh.mode.get "$ssh/id_ed25519.pub")" = 600 ] || bad="$bad mode-not-restored"
  [ -e "$ssh/ids/ssh.new" ] && bad="$bad created-folder-left"
  [ -f "$ssh/ids/ssh.x/id_ed25519" ] && [ -f "$ssh/id_ed25519" ] || bad="$bad uncopied-secret-removed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "~/.ssh is put back as it was, modes included; private keys are never copied, only reported" || create.result 1 "restores:$bad"
  return $(result)
}
test.case $level "T-REAL-SSH-RESTORES: the snapshot undoes the damage — created removed, changed and removed put back with their mode; private keys by hand" \
  test.test.suite.realSshRestores
expect 0 "~/.ssh is put back as it was, modes included; private keys are never copied, only reported" \
  "one bad test file must not leave the runner user's own ssh keys and trust changed — nor its private keys in /tmp"

# --- T-REAL-SSH-RUNNER ------------------------------------------------------
# End to end, through the real runner: a probe file that does what the
# incident did (creates authorized_keys) is reported, fails the run, and its
# file is gone afterwards. The probe writes the FIXTURE home's .ssh, which the
# nested runner is told is "the real one" through TEST_SUITE_SSH_ORIGIN.
test.test.suite.realSshRunner.probe() { # <probeFile> <category> <shell line> # write a one-assertion probe test file that runs <shell line>
  printf '%s\n' '#!/usr/bin/env bash' "TEST_CATEGORY=$2" 'source this' 'source test.suite' \
    "$3" 'expect.pass "the probe asserted something"' 'test.suite.save.results' > "$1"
  chmod +x "$1"
}
test.test.suite.realSshRunner.run() { # <fixture> <probeFile> # run <probeFile> through a nested runner whose shared tier, session files and real ~/.ssh are all inside <fixture>; echoes the colour-stripped output, rc is the runner's
  local out rc
  out=$(env HOME="$1/home" CONFIG_PATH="$1" CONFIG_FILE=user.env CONFIG="$1/user.env" \
      TEST_SUITE_CONFIG_ORIGIN="$1" TEST_SUITE_RESULT_PATH="$1/run" \
      TEST_SUITE_SSH_ORIGIN="$1/home/.ssh" PROBE_SSH="$1/home/.ssh" \
      "$OOSH_DIR/test.suite" run "$2" 1 2>&1); rc=$?
  printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g'
  return $rc
}
test.test.suite.realSshRunner() {
  local fx probe out rc bad=""
  fx=$(test.suite.fixture.make test.test.suite.realssh.runner)
  probe="$fx/test.realSshProbe"
  test.test.suite.shared.fixture "$fx"
  test.test.suite.realSsh.fixture "$fx/home"
  mkdir -p "$fx/run" "$fx/home/.config/oosh"
  test.test.suite.realSshRunner.probe "$probe" core \
    'cat "$PROBE_SSH/public_keys/a.public_key" > "$PROBE_SSH/authorized_keys"; chmod 600 "$PROBE_SSH/authorized_keys"'
  out=$(test.test.suite.realSshRunner.run "$fx" "$probe"); rc=$?
  [ "$rc" != 0 ] || bad="$bad stayed-green"
  case "$out" in *"REAL ~/.ssh WRITTEN: test.realSshProbe changed ~/.ssh: authorized_keys (created)"*) ;; *) bad="$bad not-reported" ;; esac
  case "$out" in *"CURRENT_SSH_DIR"*) ;; *) bad="$bad no-fix-hint" ;; esac
  [ -e "$fx/home/.ssh/authorized_keys" ] && bad="$bad created-file-left"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the runner names the file that created authorized_keys, fails, and removes it" || create.result 1 "runner:$bad"
  return $(result)
}

# --- T-REAL-SSH-RUNNER-RESTORE / -PLATFORM -----------------------------------
# A probe that CHANGES known_hosts is restored byte for byte; a platform probe
# is exempt (it asserts on the real machine), as for the shared tier.
test.test.suite.realSshRunnerRestore() {
  local fx probe out rc bad=""
  fx=$(test.suite.fixture.make test.test.suite.realssh.runnerrestore)
  probe="$fx/test.realSshKnownHosts"
  test.test.suite.shared.fixture "$fx"
  test.test.suite.realSsh.fixture "$fx/home"
  mkdir -p "$fx/run" "$fx/home/.config/oosh"
  cp -p "$fx/home/.ssh/known_hosts" "$fx/known_hosts.orig"
  test.test.suite.realSshRunner.probe "$probe" core \
    'printf "probe.host ssh-ed25519 AAAAprobe\n" >> "$PROBE_SSH/known_hosts"'
  out=$(test.test.suite.realSshRunner.run "$fx" "$probe"); rc=$?
  [ "$rc" != 0 ] || bad="$bad stayed-green"
  case "$out" in *"REAL ~/.ssh WRITTEN: test.realSshKnownHosts changed ~/.ssh: known_hosts (changed)"*) ;; *) bad="$bad not-reported" ;; esac
  cmp -s "$fx/known_hosts.orig" "$fx/home/.ssh/known_hosts" || bad="$bad not-byte-identical"
  # a changed private key: reported, fails, left for the user — and no copy of
  # any private key in the run folder (found by content), even after the run
  probe="$fx/test.realSshSecret"
  test.test.suite.realSshRunner.probe "$probe" core \
    'printf "PRIVATE probe\n" > "$PROBE_SSH/private_key/a.private_key"'
  out=$(test.test.suite.realSshRunner.run "$fx" "$probe"); rc=$?
  [ "$rc" != 0 ] || bad="$bad secret-stayed-green"
  case "$out" in *"test.realSshSecret changed ~/.ssh: private_key/a.private_key (changed)"*) ;; *) bad="$bad secret-not-reported" ;; esac
  case "$out" in *"restore by hand: $fx/home/.ssh/private_key/a.private_key"*) ;; *) bad="$bad no-by-hand-note" ;; esac
  grep -rqF "PRIVATE" "$fx/run" 2>/dev/null && bad="$bad private-key-copied"
  # the platform exemption, through the same runner
  probe="$fx/test.realSshPlatform"
  test.test.suite.realSshRunner.probe "$probe" platform \
    'printf "platform.host ssh-ed25519 AAAAp\n" >> "$PROBE_SSH/known_hosts"'
  out=$(test.test.suite.realSshRunner.run "$fx" "$probe"); rc=$?
  [ "$rc" = 0 ] || bad="$bad platform-failed=$rc"
  case "$out" in *"REAL ~/.ssh WRITTEN"*) bad="$bad platform-reported" ;; esac
  rm -rf "$fx"
  unset -f test.test.suite.realSshRunner.probe test.test.suite.realSshRunner.run 2>/dev/null
  [ -z "$bad" ] && create.result 0 "a changed known_hosts is restored byte for byte; a changed private key is reported by hand, never copied; a platform file is exempt" || create.result 1 "runner restore:$bad"
  return $(result)
}
test.case $level "T-REAL-SSH-RUNNER: end to end, the runner catches a file that creates the real authorized_keys" \
  test.test.suite.realSshRunner
expect 0 "the runner names the file that created authorized_keys, fails, and removes it" \
  "the incident of 2026-10-16: an authorized_keys rebuild against the real ~/.ssh stayed green"
test.case $level "T-REAL-SSH-RUNNER-RESTORE: a changed known_hosts comes back byte for byte; a private key is never copied; platform files are exempt" \
  test.test.suite.realSshRunnerRestore
expect 0 "a changed known_hosts is restored byte for byte; a changed private key is reported by hand, never copied; a platform file is exempt" \
  "the guard must undo the damage, and must not fail the tests that exist to look at the real machine"

# ============================================================================
# T-VERDICT — the suite's pass/fail rule, as one testable decision
# ============================================================================
# The rule used to be a 20-line if/elif chain in the tail of
# private.test.suite.run.filtered that nothing could reach. Extracted so the
# two new failure causes — a written shared tier, and a core file that scored
# nothing — can be proven to reach the return code, which is what the macOS
# workflow and platform test gate on.
#
# The table is its own control: it contains both rc 0 and rc 1 rows, so a rule
# that always passed or always failed cannot satisfy it.
test.test.suite.verdictRule() {
  local row want got fails=""
  # sharedWrites noResults category expects passed metaFailures <?sshWrites> | wantRc
  # (T-REAL-SSH-VERDICT: the last four rows — a written real ~/.ssh fails any category)
  while read -r row; do
    [ -z "$row" ] && continue
    want="${row##*|}"; want="${want// /}"
    set -- ${row%%|*}
    private.test.suite.verdict "$1" "$2" "$3" "$4" "$5" "$6" "$7" >/dev/null 2>&1
    got=$?
    [ "$got" != "$want" ] && fails="$fails [${row%%|*}-> $got want $want]"
  done <<'ROWS'
0 0 core 10 10 -    | 0
0 0 core 10 9 1     | 0
0 0 core 10 9 -     | 1
0 0 core 10 8 1     | 1
0 0 core 0 0 -      | 1
0 1 core 10 10 -    | 1
0 1 extended 10 10 -| 0
0 1 platform 10 10 -| 1
1 0 core 10 10 -    | 1
1 0 extended 10 10 -| 1
0 0 core 10 10 - 0  | 0
0 0 core 10 10 - 1  | 1
0 0 extended 10 10 - 1 | 1
0 0 core 10 9 1 1   | 1
ROWS
  if [ -n "$fails" ]; then
    create.result 1 "verdict rule wrong for:$fails"
  else
    create.result 0 "the verdict rule holds on every row"
  fi
  return $(result)
}
test.case $level "T-VERDICT: a written tier or a written real ~/.ssh fails any run; a score-less file fails core and platform" \
  test.test.suite.verdictRule
expect 0 "the verdict rule holds on every row" \
  "these two causes never reached the return code, so CI stayed green through both"

# ============================================================================
# Final verification
# ============================================================================

echo ""
echo -e "\e[1;35m╔════════════════════════════════════════════════════════════════════╗\e[0m"
echo -e "\e[1;35m║  META-TEST VERIFICATION                                           ║\e[0m"
echo -e "\e[1;35m╚════════════════════════════════════════════════════════════════════╝\e[0m"

TOTAL_EXPECTS=$((TEST_SUITE_EXPECT_COUNTER - INITIAL_EXPECT_COUNT))
TOTAL_SUCCESS=$((TEST_SUITE_SUCCESS_COUNTER - INITIAL_SUCCESS_COUNT))
TOTAL_FAILED=$((TOTAL_EXPECTS - TOTAL_SUCCESS))

echo ""
echo -e "  This test run:"
echo -e "    Assertions: $TOTAL_EXPECTS"
echo -e "    Passed:     $TOTAL_SUCCESS"
echo -e "    Failed:     $TOTAL_FAILED (should be exactly 1)"
echo ""

if [ "$TOTAL_FAILED" -eq 1 ]; then
  echo -e "\e[1;32m  ✓ META-TEST PASSED: Counter logic is working correctly!\e[0m"
  echo -e "\e[1;32m    (The 1 failure above is intentional and expected)\e[0m"
else
  echo -e "\e[1;31m  ✗ META-TEST FAILED: Expected exactly 1 failure, got $TOTAL_FAILED\e[0m"
  echo -e "\e[1;31m    The test.suite counter logic may be broken!\e[0m"
fi

echo ""

# ============================================================================
# Test Summary
# ============================================================================

# ============================================================================
# T-PORTABILITY-* : test.suite.portability.validate
#
# Sibling of test.path's T-PATH-VALIDATE-* and test.this's anchor tests, and
# deliberately the same shape — plant a file in a throwaway git repo (`git
# grep` only sees TRACKED files, so `git add` is required), read the verdict.
#
# The sweep exists because three separate faults on 2026-09-17 were GNU-only
# constructs in TEST code that reported the code under test as broken while it
# was fine. See the header comment on the function itself.
# ============================================================================
PORT_FIXTURE=$(test.suite.fixture.make test.test.suite.portability)
git -c init.defaultBranch=main init "$PORT_FIXTURE" >/dev/null 2>&1

private.test.suite.portability.plant() { # <file> <content...> # write + track <file>, echo the verdict
  local name="$1"; shift
  printf '%s\n' "$@" > "$PORT_FIXTURE/$name"
  git -C "$PORT_FIXTURE" add "$name" >/dev/null 2>&1
  # LOG_DEVICE is not always a tty (test.suite core redirects), so error.log
  # lines can share this capture with the verdict — match on SUBSTRINGS.
  test.suite.portability.validate "$PORT_FIXTURE" 2>/dev/null
}
private.test.suite.portability.clear() { # # drop every planted file
  git -C "$PORT_FIXTURE" rm -q -f --ignore-unmatch '*' >/dev/null 2>&1
  rm -f "$PORT_FIXTURE"/* 2>/dev/null
}

# ----------------------------------------------------------------------------
# T-PORTABILITY-TREE: the shipped test tree conforms. THIS is the gate — the
# one assertion that keeps the next `grep -q 'a\|b'` out of test/.
# ----------------------------------------------------------------------------
test.test.suite.portabilityTree() {
  local out
  out=$(test.suite.portability.validate "$OOSH_DIR/test" 2>/dev/null)
  local rc=$?
  case "$out" in
    *"OK:"*"0 violations"*) [ "$rc" -eq 0 ] && create.result 0 "tree conforms" || create.result 1 "verdict OK but rc=$rc" ;;
    *)                      create.result 1 "rc=$rc $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-TREE: no test assumes GNU coreutils or a Linux filesystem" \
  test.test.suite.portabilityTree
expect 0 "tree conforms" "a GNU-only construct in a test blames the code under test, not itself"

# ----------------------------------------------------------------------------
# T-PORTABILITY-REJECTS: the guard can actually fail. A guard that never fails
# guards nothing.
# ----------------------------------------------------------------------------
test.test.suite.portabilityRejects() {
  private.test.suite.portability.clear
  local out
  # portability-exception: the offending construct below is the FIXTURE — it is
  # planted in a throwaway repo to prove the sweep can fail. A sweep that cannot
  # contain its own counter-example cannot be tested at all.
  out=$(private.test.suite.portability.plant offender '#!/usr/bin/env bash' \
        "grep -q 'alpha\\|beta' \"\$file\"")
  case "$out" in
    *"INVALID:"*"1 violation"*) create.result 0 "BRE alternation rejected" ;;
    *)                          create.result 1 "expected 1 violation, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-REJECTS: a BRE \\| alternation is a violation" \
  test.test.suite.portabilityRejects
expect 0 "BRE alternation rejected" "BSD grep counts 0 for it and the test blames the wrong thing"

# ----------------------------------------------------------------------------
# T-PORTABILITY-GREP-E: and it does NOT fire on the correct form. Under -E a
# backslash-pipe is an escaped LITERAL pipe — three sites in test.config and
# test.install use it deliberately, and the first draft of this sweep flagged
# all of them.
# ----------------------------------------------------------------------------
test.test.suite.portabilityAcceptsGrepE() {
  private.test.suite.portability.clear
  local out
  out=$(private.test.suite.portability.plant conforming '#!/usr/bin/env bash' \
        "grep -qE 'alpha\\|beta' \"\$file\"")
  case "$out" in
    *"OK:"*"0 violations"*) create.result 0 "grep -E accepted" ;;
    *)                      create.result 1 "expected 0 violations, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-GREP-E: grep -E with an escaped literal pipe is not a violation" \
  test.test.suite.portabilityAcceptsGrepE
expect 0 "grep -E accepted" "the rule is about the BRE, not about the characters"

# ----------------------------------------------------------------------------
# T-PORTABILITY-SED-WC: sed's BRE \| and a string-compared wc -l are violations
# too; sed -E and wc -l compared with -eq are not. Both passed the sweep and
# failed only on macOS (core on the tart VM, 2026-10-21): a call-order filter
# `sed -n 's/^\(a\|b\).*/\1/p'` found nothing there (BSD sed has no \|), and
# `[ "$(… | wc -l)" = 1 ]` saw "       1" (BSD wc pads the count).
# ----------------------------------------------------------------------------
test.test.suite.portabilitySedWc() {
  local out bad=""
  # portability-exception: the offending constructs below are the FIXTURE —
  # planted in a throwaway repo to prove the sweep can fail.
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant sedBre '#!/usr/bin/env bash' \
        "order=\$(printf '%s\\n' \"\$out\" | sed -n 's/^\\(run\\|ossh\\).*/\\1/p')")
  case "$out" in *"INVALID:"*"1 violation"*) ;; *) bad="$bad sedBre=[$out]" ;; esac
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant sedEre '#!/usr/bin/env bash' \
        "order=\$(printf '%s\\n' \"\$out\" | sed -nE 's/^(run|ossh).*/\\1/p')")
  case "$out" in *"OK:"*"0 violations"*) ;; *) bad="$bad sedEre=[$out]" ;; esac
  # \| right after the quote is the POSIX address delimiter (\cREGEXc), portable — test.path's editor
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant sedDelimiter '#!/usr/bin/env bash' \
        "sed -i.bak -e '\\|/bin1\$|d' \"\$1\"")
  case "$out" in *"OK:"*"0 violations"*) ;; *) bad="$bad sedDelimiter=[$out]" ;; esac
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant wcString '#!/usr/bin/env bash' \
        "[ \"\$(ls \"\$dir\" | wc -l)\" = 3 ] || bad=x")
  case "$out" in *"INVALID:"*"1 violation"*) ;; *) bad="$bad wcString=[$out]" ;; esac
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant wcNumber '#!/usr/bin/env bash' \
        "[ \"\$(ls \"\$dir\" | wc -l)\" -eq 3 ] || bad=x")
  case "$out" in *"OK:"*"0 violations"*) ;; *) bad="$bad wcNumber=[$out]" ;; esac
  [ -z "$bad" ] && create.result 0 "sed BRE alternation and string-compared wc -l rejected" || create.result 1 "sed/wc:$bad"
  return $(result)
}
test.case $level "T-PORTABILITY-SED-WC: sed's BRE \\| and a wc -l compared as a string are violations; sed -E and -eq are not" \
  test.test.suite.portabilitySedWc
expect 0 "sed BRE alternation and string-compared wc -l rejected" \
  "two constructs passed the sweep and failed only on macOS"

# ----------------------------------------------------------------------------
# T-PORTABILITY-MARKER: a deliberate one can be declared, on the line or in the
# few lines above it — the same affordance path.validate gives.
# ----------------------------------------------------------------------------
test.test.suite.portabilityHonoursMarker() {
  private.test.suite.portability.clear
  local out
  out=$(private.test.suite.portability.plant declared '#!/usr/bin/env bash' \
        '# portability-exception: fixture — this line is the point of the test' \
        "grep -q 'alpha\\|beta' \"\$file\"")
  case "$out" in
    *"OK:"*"1 exception"*) create.result 0 "marker honoured" ;;
    *)                     create.result 1 "expected 1 exception, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-MARKER: an in-code # portability-exception: is honoured" \
  test.test.suite.portabilityHonoursMarker
expect 0 "marker honoured" "the marker may sit on the line or in the few lines above it"

# ----------------------------------------------------------------------------
# T-PORTABILITY-PAIRED: a GNU form with its BSD fallback is the FIX, not the
# fault — including when the pair is written across a continued line, which is
# how all six real sites in the tree are written.
# ----------------------------------------------------------------------------
test.test.suite.portabilityAcceptsPair() {
  private.test.suite.portability.clear
  local out
  out=$(private.test.suite.portability.plant paired '#!/usr/bin/env bash' \
        'owner=$(stat -c %U "$f" 2>/dev/null \' \
        '        || stat -f %Su "$f" 2>/dev/null)')
  case "$out" in
    *"OK:"*"0 violations"*) create.result 0 "paired fallback accepted" ;;
    *)                      create.result 1 "expected 0 violations, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-PAIRED: stat -c with a stat -f fallback on the next line is accepted" \
  test.test.suite.portabilityAcceptsPair
expect 0 "paired fallback accepted" "a continued line is one command and is judged as one"

# ----------------------------------------------------------------------------
# T-PORTABILITY-SETSID: `setsid` ships with util-linux only — macOS has none,
# and T-LOG-DEVICE-PROBE died on the sequoia VM (fc0aaee). A bare setsid is a
# violation; one guarded by `command -v setsid` in the lines above is the fix.
# ----------------------------------------------------------------------------
test.test.suite.portabilitySetsid() {
  private.test.suite.portability.clear
  local out bad=""
  # portability-exception: the planted lines are the FIXTURE, not a use
  out=$(private.test.suite.portability.plant bare '#!/usr/bin/env bash' 'setsid bash -c true')
  case "$out" in *"INVALID:"*"1 violation"*) ;; *) bad="$bad bare=[$out]" ;; esac
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant guarded '#!/usr/bin/env bash' \
        'if command -v setsid >/dev/null 2>&1; then' '  setsid bash -c true' 'fi')
  case "$out" in *"OK:"*"0 violations"*) ;; *) bad="$bad guarded=[$out]" ;; esac
  [ -z "$bad" ] && create.result 0 "an unguarded call rejected, a guarded call accepted" || create.result 1 "setsid:$bad"
  return $(result)
}
test.case $level "T-PORTABILITY-SETSID: an unguarded new-session call is a violation, a guarded one is not" \
  test.test.suite.portabilitySetsid
expect 0 "an unguarded call rejected, a guarded call accepted" "only util-linux ships setsid"

# ----------------------------------------------------------------------------
# T-PORTABILITY-PROC: macOS has no /proc. Handed to a fresh shell as
# LOG_DEVICE, `this` finds the device unwritable and swaps in the live tty, so
# the output escapes the capture (T-OSSH-PREREQS-LOCAL-NAMES-TOOL, fc0aaee).
# /dev/fd/N exists on both.
# ----------------------------------------------------------------------------
test.test.suite.portabilityProc() {
  private.test.suite.portability.clear
  local out bad=""
  # portability-exception: the planted lines are the FIXTURE, not a use
  out=$(private.test.suite.portability.plant procdev '#!/usr/bin/env bash' 'env -i LOG_DEVICE=/proc/self/fd/1 bash -c true')
  case "$out" in *"INVALID:"*"1 violation"*) ;; *) bad="$bad proc=[$out]" ;; esac
  private.test.suite.portability.clear
  out=$(private.test.suite.portability.plant fddev '#!/usr/bin/env bash' 'env -i LOG_DEVICE=/dev/fd/1 bash -c true')
  case "$out" in *"OK:"*"0 violations"*) ;; *) bad="$bad fd=[$out]" ;; esac
  [ -z "$bad" ] && create.result 0 "LOG_DEVICE=/proc rejected, /dev/fd accepted" || create.result 1 "proc:$bad"
  return $(result)
}
test.case $level "T-PORTABILITY-PROC: a /proc log device for a fresh shell is a violation, /dev/fd is not" \
  test.test.suite.portabilityProc
expect 0 "LOG_DEVICE=/proc rejected, /dev/fd accepted" "macOS has no /proc"

# ----------------------------------------------------------------------------
# T-PORTABILITY-ADVISORY: `mktemp` is LATENT, not wrong — 116 sites in the tree
# today. It is counted and reported, and it does NOT fail the gate. If this
# ever goes red the two severities have collapsed into one and the sweep
# becomes unusable as a gate.
# ----------------------------------------------------------------------------
test.test.suite.portabilityAdvisoryIsNotFatal() {
  private.test.suite.portability.clear
  local out
  out=$(private.test.suite.portability.plant latent '#!/usr/bin/env bash' \
        'tmp=$(mktemp -d)')
  local rc=$?
  case "$out" in
    *"OK:"*"1 advisory"*"0 violations"*) [ "$rc" -eq 0 ] && create.result 0 "advisory reported, gate open" || create.result 1 "verdict OK but rc=$rc" ;;
    *)                                   create.result 1 "expected 1 advisory and 0 violations, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-ADVISORY: a raw mktemp is reported but does not fail the gate" \
  test.test.suite.portabilityAdvisoryIsNotFatal
expect 0 "advisory reported, gate open" "the latent mktemp sites must not make the gate permanently red"

private.test.suite.portability.clear
# ----------------------------------------------------------------------------
# T-PORTABILITY-BLIND: a sweep that can read NOTHING must not report OK.
# `git grep` sees tracked files only, and returns empty both for a clean tree
# and for a tree it cannot read at all — an unpacked tarball, or the "dubious
# ownership" refusal that fires when root sweeps an oosh-user checkout, which
# is the shape `platform test` runs in. Silence is not a pass.
# ----------------------------------------------------------------------------
test.test.suite.portabilityRefusesBlind() {
  local blind out rc
  blind=$(test.suite.fixture.make test.test.suite.portability.blind)
  : > "$blind/untracked"          # a file, but no repository
  out=$(test.suite.portability.validate "$blind" 2>/dev/null); rc=$?
  rm -rf "$blind"
  case "$out" in
    *"INVALID:"*"no tracked files visible"*) [ "$rc" -ne 0 ] && create.result 0 "blind sweep refused" || create.result 1 "verdict INVALID but rc=$rc" ;;
    *)                                       create.result 1 "expected a refusal, got rc=$rc $out" ;;
  esac
  return $(result)
}
# ----------------------------------------------------------------------------
# T-PORTABILITY-ADVISORY-STRING: a construct NAMED in a message is not a USE of
# it. `|| { create.result 1 "mktemp failed"; ... }` is the commonest line in the
# tree containing the word, at 57 occurrences, and it runs nothing.
#
# This is the same false-positive class that `sed -i` was given a
# command-position anchor for when the sweep was written — and the mktemp rule
# was left as a bare pattern, so it over-counted its own advisory tally by 43%
# (119 reported, 83 real). A validator that reports faults which are not there
# is doing a mild version of the exact thing this whole sweep exists to stop.
# ----------------------------------------------------------------------------
test.test.suite.portabilityIgnoresNamedConstruct() {
  private.test.suite.portability.clear
  local out
  out=$(private.test.suite.portability.plant named '#!/usr/bin/env bash' \
        'fixture=$(private.make.dir) \' \
        '  || { create.result 1 "mktemp failed"; return $(result); }')
  case "$out" in
    *"OK:"*"0 advisory"*) create.result 0 "named construct ignored" ;;
    *)                    create.result 1 "expected 0 advisories, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-PORTABILITY-ADVISORY-STRING: mktemp named in a message is not a use of mktemp" \
  test.test.suite.portabilityIgnoresNamedConstruct
expect 0 "named construct ignored" "a sweep that reports faults which are not there is the fault it exists to stop"

private.test.suite.portability.clear
test.case $level "T-PORTABILITY-BLIND: a tree git cannot read is a failure, not a clean result" \
  test.test.suite.portabilityRefusesBlind
expect 0 "blind sweep refused" "an empty git grep looks exactly like a conforming tree"

private.test.suite.portability.clear
rm -rf "$PORT_FIXTURE"

# ============================================================================
# T-TEST-SUITE-GATE: core AND the post-install platform invariants, one verdict
# ============================================================================
# platform test ran only `test.suite core 1` per user, so a platform
# invariant (the config layout, no boot) never gated anything. test.suite gate
# runs core and platform.shared.configLayout.invariant and fails when either
# fails. Composition is judged with both halves stubbed.
test.test.suite.gate() {
  local bad="" rc calls
  rc=$( test.suite.core() { return 0; }; test.suite.run() { echo "run:$*" >&2; return 0; }; test.suite.gate 1 >/dev/null 2>&1; echo $? )
  [ "$rc" = 0 ] || bad="$bad both-pass-rc=$rc"
  calls=$( test.suite.core() { echo core; return 0; }; test.suite.run() { echo "run:$*"; return 0; }; test.suite.gate 1 2>/dev/null )
  # The WODA IdentityFile check reads the real ~/.ssh/config: a platform
  # check since 2026-10-14 — it blocked a promotion on a developer box whose
  # WODA lines point at the own key on purpose. The gate keeps it running on
  # every freshly installed machine.
  case "$calls" in *core*"run:platform.shared.configLayout.invariant 1"*"run:platform.ssh.config.woda.portable 1"*) ;; *) bad="$bad calls=[$(echo $calls)]" ;; esac
  rc=$( test.suite.core() { return 1; }; test.suite.run() { return 0; }; test.suite.gate 1 >/dev/null 2>&1; echo $? )
  [ "$rc" = 1 ] || bad="$bad core-fail-rc=$rc"
  rc=$( test.suite.core() { return 0; }; test.suite.run() { return 1; }; test.suite.gate 1 >/dev/null 2>&1; echo $? )
  [ "$rc" = 1 ] || bad="$bad platform-fail-rc=$rc"
  [ -z "$bad" ] && create.result 0 "gate: core then the platform invariants; rc 1 when one fails" || create.result 1 "gate:$bad"
  return $(result)
}
test.case $level "T-TEST-SUITE-GATE: test.suite gate runs core and the platform invariant, one verdict" test.test.suite.gate
expect 0 "gate: core then the platform invariants; rc 1 when one fails" \
  "platform test ran core only, so no platform invariant ever gated a run"

# ----------------------------------------------------------------------------
# T-SUITE-SESSION-RESTORE: the runner puts its user's own user.session.env back
# The per-user half of the forked user.env hangs off HOME, which
# test.suite.config.isolate cannot divert: a test that runs a production
# `config save` with the real HOME rewrote the runner's own file (test.config,
# test.user: OOSH_MODE="dev", 2026-10-02). Snapshot, change, restore — and a
# file that was absent is absent again.
# ----------------------------------------------------------------------------
test.test.suite.sessionRestore() {
  local fx bad="" f; fx=$(test.suite.fixture.make suitesession)
  f="$fx/home/.config/oosh/user.session.env"; mkdir -p "$fx/home/.config/oosh" "$fx/run"
  printf 'export OOSH_MODE="mine"\n' > "$f"
  printf 'export LOG_DEVICE="/dev/pts/9"\n' > "$fx/home/.config/oosh/log.session.env"
  # oosh.session.env holds the user's OOSH_MODE (config.session.save,
  # private.config.session.file.ensure) — the runner's own, like the others.
  printf 'export OOSH_MODE="dev.review"\n' > "$fx/home/.config/oosh/oosh.session.env"
  ( export HOME="$fx/home" TEST_SUITE_RESULT_PATH="$fx/run"
    private.test.suite.session.snapshot >/dev/null 2>&1
    printf 'export OOSH_MODE="test"\n' > "$f"
    printf 'export LOG_DEVICE="/dev/stderr"\n' > "$fx/home/.config/oosh/log.session.env"
    printf 'export OOSH_MODE="test"\n' > "$fx/home/.config/oosh/oosh.session.env"
    private.test.suite.session.restore >/dev/null 2>&1 )
  [ "$(cat "$f" 2>/dev/null)" = 'export OOSH_MODE="mine"' ] || bad="$bad not-restored=[$(cat "$f" 2>/dev/null)]"
  [ "$(cat "$fx/home/.config/oosh/log.session.env" 2>/dev/null)" = 'export LOG_DEVICE="/dev/pts/9"' ] || bad="$bad log-session-not-restored"
  [ "$(cat "$fx/home/.config/oosh/oosh.session.env" 2>/dev/null)" = 'export OOSH_MODE="dev.review"' ] || bad="$bad oosh-session-not-restored=[$(cat "$fx/home/.config/oosh/oosh.session.env" 2>/dev/null)]"
  rm -f "$f" "$fx/home/.config/oosh/oosh.session.env"
  ( export HOME="$fx/home" TEST_SUITE_RESULT_PATH="$fx/run"
    private.test.suite.session.snapshot >/dev/null 2>&1
    printf 'export OOSH_MODE="test"\n' > "$f"
    printf 'export OOSH_MODE="test"\n' > "$fx/home/.config/oosh/oosh.session.env"
    private.test.suite.session.restore >/dev/null 2>&1 )
  [ -e "$f" ] && bad="$bad absent-file-left"
  [ -e "$fx/home/.config/oosh/oosh.session.env" ] && bad="$bad absent-oosh-session-left"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the runner's own session files are put back, an absent one stays absent" || create.result 1 "session restore:$bad"
  return $(result)
}
test.case $level "T-SUITE-SESSION-RESTORE: the runner puts its user's own user.session.env back" \
  test.test.suite.sessionRestore
expect 0 "the runner's own session files are put back, an absent one stays absent" \
  "a test that saves through config save with the real HOME rewrote the runner's own file"

# ----------------------------------------------------------------------------
# T-SUITE-SESSION-RESTORE-RUNNER: end to end, through the real runner
# ----------------------------------------------------------------------------
test.test.suite.sessionRestoreRunner() {
  local fix; fix=$(mktemp -d "${TMPDIR:-/tmp}/test.test.suite.session.XXXXXX") \
    || { create.result 1 "mktemp failed"; return $(result); }
  local probe="$fix/test.sessionTierProbe"
  trap 'rm -rf "'"$fix"'"' RETURN
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run" "$fix/home/.config/oosh"
  printf 'export OOSH_MODE="mine"\n' > "$fix/home/.config/oosh/user.session.env"
  {
    echo '#!/usr/bin/env bash'
    echo 'TEST_CATEGORY=core'
    echo 'source this'
    echo 'source test.suite'
    # what a production config save does with the real HOME
    echo 'printf %s\\n "export OOSH_MODE=\"probe\"" > "$HOME/.config/oosh/user.session.env"'
    echo 'expect.pass "the probe asserted something"'
    echo 'test.suite.save.results'
  } > "$probe"
  chmod +x "$probe"
  env HOME="$fix/home" CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
      TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run" \
      "$OOSH_DIR/test.suite" run "$probe" 1 >/dev/null 2>&1
  local after; after=$(cat "$fix/home/.config/oosh/user.session.env" 2>/dev/null)
  if [ "$after" = 'export OOSH_MODE="mine"' ]; then
    create.result 0 "the runner restores its user's own session file after a test file"
  else
    create.result 1 "the probe's write stayed: [$after]"
  fi
  return $(result)
}
test.case $level "T-SUITE-SESSION-RESTORE-RUNNER: end to end, the runner restores its user's own session file" \
  test.test.suite.sessionRestoreRunner
expect 0 "the runner restores its user's own session file after a test file" \
  "only this proves the runner calls the restore"

# T-SUITE-SESSION-RESTORE-PLATFORM: the filtered runner restores after a platform file too
# test.suite all / the category runs put the session files back only when the
# file was not a platform invariant — a condition copied from the shared-tier
# guard, with no reason of its own — while test.suite run always restores.
# The filtered runner reads $OOSH_DIR/test, so it runs here in a subshell over a
# fixture folder holding the one probe; the probe itself sources the real oosh.
test.test.suite.sessionRestorePlatform() {
  local fix realOosh="$OOSH_DIR" after; fix=$(test.suite.fixture.make test.test.suite.platform)
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run" "$fix/home/.config/oosh" "$fix/oosh/test"
  printf 'export OOSH_MODE="mine"\n' > "$fix/home/.config/oosh/user.session.env"
  printf '%s\n' '#!/usr/bin/env bash' 'TEST_CATEGORY=platform' "export OOSH_DIR=\"$realOosh\"" \
    'source this' 'source test.suite' \
    'printf %s\\n "export OOSH_MODE=\"probe\"" > "$HOME/.config/oosh/user.session.env"' \
    'expect.pass "the probe asserted something"' 'test.suite.save.results' > "$fix/oosh/test/test.sessionPlatformProbe"
  chmod +x "$fix/oosh/test/test.sessionPlatformProbe"
  ( export HOME="$fix/home" CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
           TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run" OOSH_DIR="$fix/oosh"
    unset TEST_SUITE_SESSION_SNAPSHOT
    private.test.suite.run.filtered 1 "" platform >/dev/null 2>&1 )
  after=$(cat "$fix/home/.config/oosh/user.session.env" 2>/dev/null)
  rm -rf "$fix"
  [ "$after" = 'export OOSH_MODE="mine"' ] && create.result 0 "the filtered runner restores the session files after a platform file" \
                                          || create.result 1 "the platform probe's write stayed: [$after]"
  return $(result)
}
test.case $level "T-SUITE-SESSION-RESTORE-PLATFORM: the filtered runner restores the session files after a platform file too" \
  test.test.suite.sessionRestorePlatform
expect 0 "the filtered runner restores the session files after a platform file" \
  "test.suite all skipped the restore for platform invariants"

# T-SUITE-NO-INSTALL: a test run installs nothing on the machine it runs on
# Tests start real scripts (`odocker up`); a script that installs what it
# misses did so DURING the tests (colima, docker, lima on a Mac VM,
# 2026-10-06). test.suite exports OOSH_NO_INSTALL=1 for every test file.
test.test.suite.noInstall() {
  [ "$OOSH_NO_INSTALL" = "1" ] && create.result 0 "OOSH_NO_INSTALL=1 in every test file" \
                               || create.result 1 "OOSH_NO_INSTALL=[$OOSH_NO_INSTALL]"
  return $(result)
}
test.case $level "T-SUITE-NO-INSTALL: a test run installs nothing on the machine it runs on" test.test.suite.noInstall
expect 0 "OOSH_NO_INSTALL=1 in every test file" "a test run installed colima, docker and lima on a Mac VM"

# T-ALL-SCRIPTS-PARSE: every tracked oosh script parses with this machine's bash
# bash before 5.2 reads `*"x"*)` inside $( … ) as the end of the substitution:
# on AlmaLinux 9 (bash 5.1) test.ossh died on a syntax error and scored
# nothing — "NO RESULTS", no line named (2026-10-06). `bash -n` names it.
test.test.suite.allScriptsParse() {
  local f bad="" checked=0
  while IFS= read -r f; do
    [ -f "$OOSH_DIR/$f" ] || continue
    case "$f" in *.md|*.puml|*.drawio|*.png|*.json|*.env|sessions/*) continue ;; esac
    head -1 "$OOSH_DIR/$f" | grep -qE '^#!.*(bash|sh)' || continue
    checked=$((checked + 1))
    bash -n "$OOSH_DIR/$f" 2>/dev/null || bad="$bad $f"
  done <<FILES
$(ogit.repo.files.list "$OOSH_DIR")
FILES
  # A sweep that read nothing checked nothing (T-ALL-SCRIPTS-PARSE-BLIND).
  if [ "$checked" -eq 0 ]; then
    create.result 1 "no script read under $OOSH_DIR — git lists no tracked file there"
  elif [ -z "$bad" ]; then
    create.result 0 "every script parses with bash $BASH_VERSION"
  else
    create.result 1 "does not parse with bash $BASH_VERSION:$bad"
  fi
  return $(result)
}
test.case $level "T-ALL-SCRIPTS-PARSE: every tracked oosh script parses with this machine's bash" test.test.suite.allScriptsParse
expect 0 "every script parses with bash $BASH_VERSION" "a file that does not parse scores nothing — NO RESULTS, no line named"

# T-ALL-SCRIPTS-PARSE-BLIND: a parse sweep that reads no script is a failure
# git lists nothing for a tree it cannot read (no repository, "dubious
# ownership" for root in a platform container): the sweep checked nothing and
# reported "every script parses". Same rule as T-PORTABILITY-BLIND.
test.test.suite.allScriptsParseBlind() {
  local blind out; blind=$(test.suite.fixture.make test.test.suite.parse.blind)
  : > "$blind/untracked"
  out=$( OOSH_DIR="$blind" test.test.suite.allScriptsParse >/dev/null 2>&1; echo "rc=$? $RESULT" )
  rm -rf "$blind"
  case "$out" in
    "rc=1 "*"no script"*) create.result 0 "a sweep that reads no script fails" ;;
    *)                    create.result 1 "a blind sweep: [$out]" ;;
  esac
  return $(result)
}
test.case $level "T-ALL-SCRIPTS-PARSE-BLIND: a parse sweep that reads no script is a failure" test.test.suite.allScriptsParseBlind
expect 0 "a sweep that reads no script fails" "a sweep that reads nothing reports every script parses"

# T-SUITE-NO-RESULTS-RUNNER: a single run of a file that never saves its results fails
# A file that dies (a syntax error, an early exit) before test.suite.save.results
# scored "NO RESULTS … 0 / 0" and then "All tests successful", rc 0 — for
# `test.suite run`, and so for the platform half of `test.suite gate`. The
# probe lives in the fixture and is run by its path (T-SUITE-RUN-PATH).
test.test.suite.noResultsRunner() {
  local fix name probe out rc; fix=$(test.suite.fixture.make test.test.suite.noresults)
  name="noResultsProbe$$"; probe="$fix/test.$name"
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run" "$fix/home/.config/oosh"
  printf '%s\n' '#!/usr/bin/env bash' 'TEST_CATEGORY=core' 'source this' 'source test.suite' \
    'expect.pass "the probe asserted something"' 'exit 0' 'test.suite.save.results' > "$probe"
  chmod +x "$probe"
  out=$(env HOME="$fix/home" CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
      TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run" \
      "$OOSH_DIR/test.suite" run "$probe" 1 2>&1); rc=$?
  rm -rf "$fix"
  local bad=""
  [ "$rc" = 1 ] || bad="$bad rc=$rc"
  case "$out" in *"All tests successful"*) bad="$bad all-tests-successful" ;; esac
  case "$out" in *"NO RESULTS"*"test.$name"*) ;; *) bad="$bad file-not-named" ;; esac
  [ -z "$bad" ] && create.result 0 "rc 1, the file named, no success line" || create.result 1 "no results:$bad"
  return $(result)
}
test.case $level "T-SUITE-NO-RESULTS-RUNNER: a single run of a file that never saves its results fails" test.test.suite.noResultsRunner
expect 0 "rc 1, the file named, no success line" "a test file that died before saving scored All tests successful"


# T-SUITE-RUN-PATH: test.suite run takes a path to a test file outside the test folder
# The runner ran $OOSH_DIR/test/test.<name> only, so its own end-to-end tests
# wrote their probe files into the tracked test folder. An argument holding a
# / is a file path; a bare name stays $OOSH_DIR/test/test.<name>.
test.test.suite.runPath() {
  local fix probe out rc bad=""; fix=$(test.suite.fixture.make test.test.suite.runpath)
  probe="$fix/test.pathProbe"
  test.test.suite.shared.fixture "$fix"
  mkdir -p "$fix/run" "$fix/home/.config/oosh"
  printf '%s\n' '#!/usr/bin/env bash' 'TEST_CATEGORY=core' 'source this' 'source test.suite' \
    'expect.pass "the probe asserted something"' 'test.suite.save.results' > "$probe"
  chmod +x "$probe"
  out=$(env HOME="$fix/home" CONFIG_PATH="$fix" CONFIG_FILE=user.env CONFIG="$fix/user.env" \
      TEST_SUITE_CONFIG_ORIGIN="$fix" TEST_SUITE_RESULT_PATH="$fix/run" \
      "$OOSH_DIR/test.suite" run "$probe" 1 2>&1); rc=$?
  rm -rf "$fix"
  [ "$rc" = 0 ] || bad="$bad rc=$rc"
  case "$out" in *"Completed: "*"test.pathProbe"*) ;; *) bad="$bad not-named" ;; esac
  case "$out" in *"Results: "*"1"*" / 1 assertions passed"*) ;; *) bad="$bad not-scored" ;; esac
  [ -z "$bad" ] && create.result 0 "a test file outside the test folder is run and scored" || create.result 1 "run <path>:$bad"
  return $(result)
}
test.case $level "T-SUITE-RUN-PATH: test.suite run takes a path to a test file outside the test folder" test.test.suite.runPath
expect 0 "a test file outside the test folder is run and scored" "the runner's own probes were written into the tracked test folder"


console.log "
Test: private.test.suite.session.files.get
===================================================================="

test.case - "T-SUITE-SESSION-FILES: the runner guards the user, log and oosh session files" \
   private.test.suite.session.files.get 
expect 0 "user.session.env log.session.env oosh.session.env"


# T-REAL-SSH-ORIGIN: the guard watches the passwd home's .ssh, not $HOME's
# ssh reads the passwd home whatever HOME says, and so did the 2026-10-16
# rebuild — a guard that followed HOME would watch a fixture while the real
# folder was written. Called with HOME pointing at a fixture.
test.test.suite.realSshOrigin() {
  local fx got want bad=""
  fx=$(test.suite.fixture.make test.test.suite.realssh.origin)
  want="$(eval echo ~"$(id -un)")/.ssh"
  got=$(HOME="$fx"; private.test.suite.ssh.origin.get)
  rm -rf "$fx"
  [ "$got" = "$want" ] || bad="$bad got=[$got] want=[$want]"
  [ -z "$bad" ] && create.result 0 "the origin is the passwd home's .ssh, whatever HOME says" || create.result 1 "origin:$bad"
  return $(result)
}
test.case $level "T-REAL-SSH-ORIGIN: the origin is the passwd home even under a fixture HOME" test.test.suite.realSshOrigin
expect 0 "the origin is the passwd home's .ssh, whatever HOME says" "a guard that follows HOME watches the fixture while ssh writes the real folder"

# T-REAL-SSH-STAMP: one line per path — relative name, mode, checksum and size
# Mode is part of it (unlike the shared tier's content-only stamp): the runner
# owns its ~/.ssh, so a mode CAN be put back, and a group-readable key is
# damage — ssh refuses it. A socket (an ossh ControlMaster) is not a file and
# is left out.
test.test.suite.realSshStamp() {
  local fx out bad=""
  fx=$(test.suite.fixture.make test.test.suite.realssh.stamp)
  test.test.suite.realSsh.fixture "$fx/home"
  out=$(private.test.suite.ssh.stamp.get "$fx/home/.ssh")
  [ "$(private.test.suite.ssh.mode.get "$fx/home/.ssh/public_keys/a.public_key")" = 640 ] || bad="$bad mode.get"
  rm -rf "$fx"
  [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" = 7 ] || bad="$bad lines=[$out]"
  case "$out" in *"public_keys/a.public_key	640 "*) ;; *) bad="$bad no-mode-line" ;; esac
  case "$out" in *"$fx"*) bad="$bad absolute-path" ;; esac
  [ -z "$bad" ] && create.result 0 "one relative line per file, with mode and checksum" || create.result 1 "stamp:$bad"
  return $(result)
}
test.case $level "T-REAL-SSH-STAMP: one line per path with mode and checksum" test.test.suite.realSshStamp
expect 0 "one relative line per file, with mode and checksum" "the fingerprint must see a created file and a changed mode"

# private.test.suite.ssh.snapshot / .verify / .restore / .report are proven by
# T-REAL-SSH-DETECTS, -RESTORES, -RUNNER and -RUNNER-RESTORE above, always
# against a fixture origin. Never call them bare here: this file runs under
# the runner, whose exported TEST_SUITE_SSH_* point at the REAL ~/.ssh.


# T-REAL-SSH-SECRET: which paths under ~/.ssh are private keys
# The guard copies ~/.ssh aside to restore it; a killed run leaves that copy in
# /tmp, so a private key must never be in it. The table is its own control:
# both secret (rc 0) and public (rc 1) rows.
test.test.suite.realSshSecret() {
  local row want got fails=""
  while read -r row; do
    [ -z "$row" ] && continue
    want="${row##*|}"; want="${want// /}"; row="${row%%|*}"; row="${row// /}"
    private.test.suite.ssh.secret.is "$row" >/dev/null 2>&1; got=$?
    [ "$got" != "$want" ] && fails="$fails [$row -> $got want $want]"
  done <<'ROWS'
id_ed25519                                      | 0
id_rsa                                          | 0
private_key/a.private_key                       | 0
ids/ssh.x/id_ed25519                            | 0
ids/ssh.x/private_key/k.private_key             | 0
ids/ssh.x/ssh.developking/private_key/dk        | 0
id_ed25519.pub                                  | 1
ids/ssh.x/id_ed25519.pub                        | 1
public_keys/a.public_key                        | 1
authorized_keys                                 | 1
config                                          | 1
known_hosts                                     | 1
known_hosts.old                                 | 1
ids/ssh.developking/known_hosts                 | 1
ROWS
  [ -z "$fails" ] && create.result 0 "private keys are told from everything else" || create.result 1 "secret rule wrong for:$fails"
  return $(result)
}
test.case $level "T-REAL-SSH-SECRET: which paths under ~/.ssh are private keys" test.test.suite.realSshSecret
expect 0 "private keys are told from everything else" "a killed run would leave a copied private key in /tmp"
# private.test.suite.ssh.secrets.changed.get is proven by T-REAL-SSH-RESTORES
# and T-REAL-SSH-RUNNER-RESTORE (the "restore by hand" note), against a fixture.


# T-TEST-SUITE-REAL-CONFIG-EXPORTED: a run names the real config folders for every child
# test.suite.init exports the canonical real ~/config and ~/.config/oosh of
# the user running the tests — from the passwd home, so a child that sets
# HOME to a fixture still knows them — and keeps a value it inherits (a nested
# runner). The runner turns a refused write into a red file:
# private.test.suite.real.config.verify names it and clears the list.
test.test.suite.realConfigExported() {
  local fx bad="" real got
  real=$(private.this.path.canonical "$(eval echo ~"$(id -un)")/config")
  [ "$TEST_SUITE_REAL_CONFIG" = "$real" ] || bad="$bad config=[$TEST_SUITE_REAL_CONFIG]"
  [ -n "$TEST_SUITE_REAL_SESSION" ] || bad="$bad noSession"
  got=$(env TEST_SUITE_REAL_CONFIG=/outer bash -c 'echo "$TEST_SUITE_REAL_CONFIG"'); [ "$got" = /outer ] || bad="$bad notInherited"
  got=$( ( export HOME=/tmp; bash -c 'echo "$TEST_SUITE_REAL_CONFIG"' ) ); [ "$got" = "$real" ] || bad="$bad homeChanged=[$got]"
  fx=$(test.suite.fixture.make suiterealconfig)
  ( TEST_SUITE_RESULT_PATH="$fx"; echo "$fx/a.env" > "$fx/real.config.refused"
    private.test.suite.real.config.verify t.x >/dev/null; echo "$?|$RESULT" > "$fx/out"
    private.test.suite.real.config.verify t.x >/dev/null; echo "$?" >> "$fx/out" )
  [ "$(head -1 "$fx/out")" = "1|t.x tried to write the real config: $fx/a.env " ] || bad="$bad verify=[$(head -1 "$fx/out")]"
  [ "$(sed -n 2p "$fx/out")" = 0 ] || bad="$bad notCleared"
  rm -rf "${fx:?}"
  [ -z "$bad" ] && create.result 0 "the real folders are named for every child" || create.result 1 "real config:$bad"
  return $(result)
}
test.case $level "T-TEST-SUITE-REAL-CONFIG-EXPORTED: test.suite names the real ~/config and ~/.config/oosh for every child, and a refused write turns the file red" test.test.suite.realConfigExported
expect 0 "the real folders are named for every child" \
  "a test overwrote the real user.env and nothing in the run said so"


# T-SUITE-COMPLETION-EXISTS: a test asks for "a completion of <p>", whichever form c2 finds
# test.suite.completion.exists / .get accept the method-specific
# <s>.<m>.completion.<p> and the class-level <s>.parameter.completion.<p>, in
# c2's order, so a test does not break when a completion moves to the class
# level (Marcel, 36e1305d, 2026-10-20).
test.test.suite.completionExists() {
  local bad="" got
  ( tsCe.a.completion.x() { echo specific; }; tsCe.parameter.completion.x() { echo class; }
    tsCe.parameter.completion.y() { echo "class:$1:$2:$3"; }
    test.suite.completion.exists tsCe a x >/dev/null; echo "ax=$?:$RESULT"
    test.suite.completion.exists tsCe b x >/dev/null; echo "bx=$?:$RESULT"
    test.suite.completion.exists tsCe a z >/dev/null; echo "az=$?"
    echo "getAx=$(test.suite.completion.get tsCe a x)"
    echo "getBy=$(test.suite.completion.get tsCe b y cu)"
    test.suite.completion.get tsCe b z >/dev/null; echo "getBz=$?" ) > "${TMPDIR:-/tmp}/tsce.$$" 2>/dev/null
  got=$(tr '\n' ' ' < "${TMPDIR:-/tmp}/tsce.$$"); rm -f "${TMPDIR:-/tmp}/tsce.$$"
  [ "$got" = "ax=0:tsCe.a.completion.x bx=0:tsCe.parameter.completion.x az=1 getAx=specific getBy=class:cu:tsCe:b getBz=1 " ] || bad=" [$got]"
  [ -z "$bad" ] && create.result 0 "both forms, in c2's order" || create.result 1 "completion.exists:$bad"
  return $(result)
}
test.case $level "T-SUITE-COMPLETION-EXISTS: test.suite.completion.exists/.get accept both completion forms, in c2's order" test.test.suite.completionExists
expect 0 "both forms, in c2's order" "a test pinned one spelling and broke when the completion moved to the class level"

### test.method

test.suite.save.results
