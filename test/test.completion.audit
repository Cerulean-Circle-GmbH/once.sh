#!/usr/bin/env bash
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

# The audit drives c2 against every user-facing script, which SOURCES each of
# them — `config` included — and a non-sourced `log.level` persists via
# `config save log LOG`. Isolate before that happens. This only became
# possible once config.init stopped clobbering an inherited CONFIG_PATH (T7);
# before that, sourcing `config` undid the fixture from inside.
test.suite.config.isolate test.completion.audit >/dev/null || exit 1

source $OOSH_DIR/ng/c2

log.level $level

# ============================================================================
# Universal Completion Audit
# ============================================================================
# Iterates every user-facing OOSH script, extracts public methods with
# parameters, and verifies a completion function exists for each non-exempt
# parameter.  A completion function is either:
#   scriptName.method.completion()               (method-level catch-all)
#   scriptName.method.completion.paramName()      (method+param specific)
#   scriptName.parameter.completion.paramName()   (shared across methods)

# Parameter names exempt from completion (free-text / numeric / not completable)
# IMPORTANT: must be a single line (no newlines) for space-delimited matching
# limit: a number of commits (ogit commit.log.show); asName: free-text bot display name (ogit identity)
# remoteKeyName: a file on the other host (ossh key.pull) — a listing would ask the password on Tab, and a shared keyName completion lists this computer's keys (T-OSSH-KEY-COMPLETION)
# remoteConfigName: a Host in the other host's ~/.ssh/config (ossh config.pull) — the same reason; the shared sshConfigName completion lists this computer's Hosts (T-OSSH-CONFIG-PULL-COMPLETION)
EXEMPT_PARAMS=" limit asName prompt message description text command keys template query args content subject body comment reason note prefix lines count width height percentage size subcommand options mode value new newName newClassName newScript ENV_PREFIX interval seconds timeout threshold amount errorCount number condition format data title hook channel pattern portMap sshPort port portOrOffset url githubUrl uid gid log load cmd1 cmd2 key key1 key2 filename filepath fromPath toPath from alwaysReturnId TestName turns tools reset task name newName newName roles featureBranchPrefix startCommit worktree_base sourceSshDir idName remoteKeyName remoteConfigName "

# In-scope user-facing scripts
IN_SCOPE_SCRIPTS="otmux claudeCode claudeFlow hiveMind ossh odocker state
  config backup context scrumMaster user log agentRoom disk promote oo path
  certificates check index osx mycmd share snet otest test.suite c2 ogit"

# Counters
AUDIT_TOTAL=0
AUDIT_COVERED=0
AUDIT_EXEMPT=0
AUDIT_MISSING=0

# Helper: check if a word is in an exempt list string
private.audit.isExempt() {
  [[ "$EXEMPT_PARAMS" == *" $1 "* ]]
}

# Cache for method-level completions (avoid repeated type -t calls)
declare -A METHOD_COMPLETION_CACHE

# Helper: check if method-level completion exists (catches all params)
private.audit.hasMethodCompletion() {
  local key="$1.$2.completion"
  if [ -z "${METHOD_COMPLETION_CACHE[$key]+x}" ]; then
    if [ "$(type -t "$key" 2>/dev/null)" = "function" ]; then
      METHOD_COMPLETION_CACHE[$key]=1
    else
      METHOD_COMPLETION_CACHE[$key]=0
    fi
  fi
  [ "${METHOD_COMPLETION_CACHE[$key]}" -eq 1 ]
}

# ============================================================================
# Main audit loop
# ============================================================================

for scriptName in $IN_SCOPE_SCRIPTS; do

  # Resolve script path
  scriptPath="$OOSH_DIR/$scriptName"
  if [ ! -f "$scriptPath" ]; then
    scriptPath="$OOSH_DIR/ng/$scriptName"
  fi
  if [ ! -f "$scriptPath" ]; then
    continue
  fi

  # Source script to load its completion functions (suppress all output)
  source "$scriptPath" completion.discover 2>/dev/null

  # Grep function signatures directly from the file
  while IFS= read -r sigLine; do
    [ -z "$sigLine" ] && continue

    # Extract full method name (everything before the parentheses)
    methodFull="${sigLine%%\(\)*}"
    methodFull="${methodFull## }"
    method="${methodFull#${scriptName}.}"

    # Skip private, completion, start, usage methods
    case "$method" in
      private*|*completion*|start|usage) continue ;;
    esac

    # Extract parameter names using bash regex
    paramSection="${sigLine#*\# }"
    params=""
    while [[ "$paramSection" =~ \<\??([a-zA-Z][a-zA-Z0-9_]*) ]]; do
      params="$params ${BASH_REMATCH[1]}"
      paramSection="${paramSection#*${BASH_REMATCH[0]}}"
    done

    for param in $params; do
      AUDIT_TOTAL=$((AUDIT_TOTAL + 1))

      # Skip exempt (free-text) params
      if private.audit.isExempt "$param"; then
        AUDIT_EXEMPT=$((AUDIT_EXEMPT + 1))
        continue
      fi

      # Check method-level catch-all: scriptName.method.completion()
      if private.audit.hasMethodCompletion "$scriptName" "$method"; then
        AUDIT_COVERED=$((AUDIT_COVERED + 1))
        continue
      fi

      # Check method+param specific: scriptName.method.completion.param()
      if [ "$(type -t "${scriptName}.${method}.completion.${param}" 2>/dev/null)" = "function" ]; then
        AUDIT_COVERED=$((AUDIT_COVERED + 1))
        continue
      fi

      # Check shared parameter: scriptName.parameter.completion.param()
      if [ "$(type -t "${scriptName}.parameter.completion.${param}" 2>/dev/null)" = "function" ]; then
        AUDIT_COVERED=$((AUDIT_COVERED + 1))
        continue
      fi

      # Missing completion
      AUDIT_MISSING=$((AUDIT_MISSING + 1))
      test.case $level "${scriptName}.${method}: missing completion for <${param}>" \
        echo "missing"
      expect.fail "${scriptName} needs completion for '${param}' (method: ${method})"
    done
  done < <(grep -E "^${scriptName}\.[a-zA-Z].*\(\) +#.+<" "$scriptPath" 2>/dev/null \
           | grep -v '\.completion\.' | grep -v '^private\.')
done

# ============================================================================
# No method is defined with the `function` keyword
# ============================================================================
# The signature grep above — like c2 get.functions, this.methodNotFound and
# oo method.delete — only sees `script.method() # <params> # description`
# (templates/code/newScript, newMethod). A `function x()` line is invisible to
# all of them: no help, no completion, no audit. `debug` is sourced by every
# oosh shell, so it is held to the same rule although it is not user-facing.
KEYWORD_DEFS=""
for scriptName in $IN_SCOPE_SCRIPTS debug; do
  scriptPath="$OOSH_DIR/$scriptName"
  [ -f "$scriptPath" ] || scriptPath="$OOSH_DIR/ng/$scriptName"
  [ -f "$scriptPath" ] || continue
  # A DEFINITION: `function name` then `(`, `{` or end of line — not usage text
  # like check's "  function      initializes a new user config".
  hits=$(grep -nE '^[[:space:]]*function[[:space:]]+[A-Za-z_.][A-Za-z0-9_.]*[[:space:]]*(\(|\{|$)' "$scriptPath" 2>/dev/null | cut -d'(' -f1)
  [ -n "$hits" ] && KEYWORD_DEFS="$KEYWORD_DEFS $scriptName:[$(printf '%s' "$hits" | tr '\n' ' ')]"
done
test.case $level "No in-scope script defines a method with the function keyword" \
  echo "function keyword check"
if [ -z "$KEYWORD_DEFS" ]; then
  expect.pass "every method is a bare script.method()"
else
  expect.fail "function keyword in:$KEYWORD_DEFS"
fi


# ============================================================================
# A completion is defined once, and never calls itself
# ============================================================================
# The audit above only asks whether a completion function EXISTS. A mechanical
# move to the class-level form (Marcel's dev.cleanup, 2026-10-20) left the
# same <script>.parameter.completion.<p> defined up to 11 times — bash keeps
# the last one, so earlier methods silently lost their candidates — and one
# that only calls itself (Tab would recurse until bash gives up). Both rules
# read the file, so they see what bash overwrites (T-AUDIT-COMPLETION-ONCE,
# T-AUDIT-COMPLETION-NO-SELF-CALL).
private.audit.completion.duplicates.get() { # <scriptPath> # echo each completion function defined more than once in <scriptPath>, one per line #
  grep -oE '^[[:space:]]*[A-Za-z_][A-Za-z0-9_.]*\.completion[A-Za-z0-9_.]*[[:space:]]*\(\)' "$1" 2>/dev/null \
    | tr -d ' \t()' | sort | uniq -d
}

private.audit.completion.selfcalls.get() { # <scriptPath> # echo each completion function whose body runs itself with nothing but its own arguments, one per line #
  # A command is the first word of a body line (or what follows the `{` of a
  # one-line body); a name inside a log text or a string is no call. Only a
  # call that hands on its own input ("$@", $*, $1 … or nothing) never ends:
  # config.completion.discover recurses on a resolved path, which is fine.
  awk '
    function isSelf(text, name,   w, args, n, i, a) {
      sub(/^[[:space:]]*\{?[[:space:]]*/, "", text)
      w = text; sub(/[[:space:];].*$/, "", w)
      if (w != name) return 0
      args = substr(text, length(w) + 1); sub(/[;}].*$/, "", args); gsub(/"/, "", args)
      n = split(args, a, /[[:space:]]+/)
      for (i = 1; i <= n; i++) if (a[i] != "" && a[i] !~ /^\$[@*0-9]$/) return 0
      return 1
    }
    match($0, /^[[:space:]]*[A-Za-z_][A-Za-z0-9_.]*\.completion[A-Za-z0-9_.]*[[:space:]]*\(\)/) {
      fn = substr($0, RSTART, RLENGTH); gsub(/[ \t()]/, "", fn)
      rest = substr($0, RSTART + RLENGTH)
      if (rest ~ /\{/) {
        body = rest; sub(/^[^{]*\{/, "", body); sub(/\}[[:space:]]*$/, "", body)
        if (isSelf(body, fn)) print fn
        if (rest ~ /\}[[:space:]]*$/) { fn = ""; next }
      }
      next
    }
    fn != "" && /^\}/ { fn = ""; next }
    fn != "" && isSelf($0, fn) { print fn }
  ' "$1" 2>/dev/null | sort -u
}

# The two rules, proven on fixture scripts first: one with a duplicate and a
# self-call, one clean (a log text naming the function, or a recursion on
# another argument, is no call).
AUDIT_FX=$(test.suite.fixture.make completionaudit)
cat > "$AUDIT_FX/bad" <<'EOF'
bad.parameter.completion.x() { echo a; }
bad.parameter.completion.x() { echo b; }
bad.parameter.completion.y() { bad.parameter.completion.y "$@"; }
bad.m.completion.z()
{
  bad.m.completion.z "$1"
}
EOF
cat > "$AUDIT_FX/good" <<'EOF'
good.parameter.completion.x() {
  important.log "good.parameter.completion.x $*"
  echo a
}
good.m.completion.x() { good.parameter.completion.x "$@"; }
good.r.completion() { good.r.completion $ac; }
EOF
test.case $level "T-AUDIT-COMPLETION-ONCE: a completion defined twice is found, a clean script has none" echo "duplicates"
if [ "$(private.audit.completion.duplicates.get "$AUDIT_FX/bad" | tr '\n' ' ')" = "bad.parameter.completion.x " ] \
   && [ -z "$(private.audit.completion.duplicates.get "$AUDIT_FX/good")" ]; then
  expect.pass "the duplicate is found, the clean script has none"
else
  expect.fail "duplicates: bad=[$(private.audit.completion.duplicates.get "$AUDIT_FX/bad" | tr '\n' ' ')] good=[$(private.audit.completion.duplicates.get "$AUDIT_FX/good" | tr '\n' ' ')]"
fi
test.case $level "T-AUDIT-COMPLETION-NO-SELF-CALL: a completion that runs itself is found, a log text naming it is not" echo "self calls"
if [ "$(private.audit.completion.selfcalls.get "$AUDIT_FX/bad" | tr '\n' ' ')" = "bad.m.completion.z bad.parameter.completion.y " ] \
   && [ -z "$(private.audit.completion.selfcalls.get "$AUDIT_FX/good")" ]; then
  expect.pass "the self-calls are found, the clean script has none"
else
  expect.fail "self calls: bad=[$(private.audit.completion.selfcalls.get "$AUDIT_FX/bad" | tr '\n' ' ')] good=[$(private.audit.completion.selfcalls.get "$AUDIT_FX/good" | tr '\n' ' ')]"
fi
rm -rf "${AUDIT_FX:?}"

# … and on every in-scope script.
DUPLICATE_DEFS="" SELF_CALLS=""
for scriptName in $IN_SCOPE_SCRIPTS; do
  scriptPath="$OOSH_DIR/$scriptName"
  [ -f "$scriptPath" ] || scriptPath="$OOSH_DIR/ng/$scriptName"
  [ -f "$scriptPath" ] || continue
  hits=$(private.audit.completion.duplicates.get "$scriptPath" | tr '\n' ' ')
  [ -n "$hits" ] && DUPLICATE_DEFS="$DUPLICATE_DEFS $scriptName:[${hits% }]"
  hits=$(private.audit.completion.selfcalls.get "$scriptPath" | tr '\n' ' ')
  [ -n "$hits" ] && SELF_CALLS="$SELF_CALLS $scriptName:[${hits% }]"
done
test.case $level "No in-scope script defines a completion twice" echo "duplicate check"
if [ -z "$DUPLICATE_DEFS" ]; then
  expect.pass "every completion is defined once"
else
  expect.fail "defined more than once (bash keeps the last):$DUPLICATE_DEFS"
fi
test.case $level "No in-scope completion calls itself" echo "self-call check"
if [ -z "$SELF_CALLS" ]; then
  expect.pass "no completion runs itself"
else
  expect.fail "a completion runs itself:$SELF_CALLS"
fi

# ============================================================================
# Summary
# ============================================================================

test.case $level "Completion audit: ${AUDIT_TOTAL} params, ${AUDIT_COVERED} covered, ${AUDIT_EXEMPT} exempt, ${AUDIT_MISSING} missing" \
  echo "audit complete"

if [ "$AUDIT_MISSING" -eq 0 ]; then
  expect.pass "All completable parameters have completion functions"
else
  expect.fail "${AUDIT_MISSING} of ${AUDIT_TOTAL} parameters need completion functions"
fi

test.suite.save.results
