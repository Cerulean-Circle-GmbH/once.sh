#!/usr/bin/env bash
# ============================================================================
# Platform invariant: the MacStudio config layout, and a shell that starts without boot.
#
# Runs on the REAL host, as every installed user (os platform.test runs it
# per user once the runners are switched — Round 4 of the dev.config plan).
# The model (test/mcdonges.latest, the boss's MacStudio):
#   ~/config/user.env  CONFIG_PATH/CONFIG_FILE/CONFIG, PATH, BASH_FILE
#                      then . oosh.env, then . log.env,
#                      then any other chain (. odocker.env, config add …)
#   ~/config/oosh.env  every OOSH_* variable
#   ~/config/log.env   every LOG_* variable, last line
#                      . $HOME/.config/oosh/log.session.env
#   ~/.config/oosh/log.session.env  per user, always present
# ~/config is SHARED between users, so no saved value may carry the saving
# user's absolute $HOME. No boot, no /etc/profile.d/oosh.sh: .bashrc and
# `source this` stand the shell up from user.env.
# Invoke: ./test.suite run platform.shared.configLayout.invariant 1
# ============================================================================

TEST_CATEGORY=platform

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ----------------------------------------------------------------------------
# INVARIANT-0 (precondition): ~/config/user.env exists — the rest reads it.
# ----------------------------------------------------------------------------
userEnv="$HOME/config/user.env"
ooshEnv="$HOME/config/oosh.env"
logEnv="$HOME/config/log.env"
sessionEnv="$HOME/.config/oosh/log.session.env"
chainLine='. $HOME/.config/oosh/log.session.env'

test.case $level "platform.shared.configLayout: precondition — $userEnv exists" \
  test -f "$userEnv"
if [ ! -f "$userEnv" ]; then
  expect.fail "$userEnv does not exist — run \`config save\` (or \`ossh install <host>\` first)"
  test.suite.save.results
  return 0 2>/dev/null || exit 0
else
  expect.pass "$userEnv present"
fi

# ----------------------------------------------------------------------------
# INVARIANT-1: user.env — the anchors, PATH, BASH_FILE, then oosh.env before
# log.env.
# Any other chain (`. $CONFIG_PATH/odocker.env`, `config add myapp`) is part of
# the model too — config save keeps it (T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS) —
# and comes after log.env.
# ----------------------------------------------------------------------------
foreign=$(grep -vE '^export [A-Z_][A-Z0-9_]*=".*"$|^\. \$CONFIG_PATH/[A-Za-z0-9_.]+\.env$' "$userEnv" | head -1)
missing=""
for k in CONFIG_PATH CONFIG_FILE CONFIG PATH BASH_FILE; do
  grep -q "^export $k=" "$userEnv" || missing="$missing $k"
done
ooshAt=$(grep -nxF '. $CONFIG_PATH/oosh.env' "$userEnv" | cut -d: -f1)
logAt=$(grep -nxF '. $CONFIG_PATH/log.env' "$userEnv" | cut -d: -f1)
extraAt=$(grep -nE '^\. \$CONFIG_PATH/[A-Za-z0-9_.]+\.env$' "$userEnv" | grep -vE ':\. \$CONFIG_PATH/(oosh|log)\.env$' | head -1 | cut -d: -f1)
prefixed=$(grep -E '^export (OOSH|LOG)_' "$userEnv" | head -1)
test.case $level "platform.shared.configLayout: user.env holds the anchors and chains oosh.env, then log.env, then any other" true
if [ -z "$foreign" ] && [ -z "$missing" ] && [ -n "$ooshAt" ] && [ -n "$logAt" ] && [ "$ooshAt" -lt "$logAt" ] \
   && { [ -z "$extraAt" ] || [ "$extraAt" -gt "$logAt" ]; } && [ -z "$prefixed" ]; then
  expect.pass "user.env in the MacStudio layout"
else
  expect.fail "user.env off-model (foreign=[$foreign] missing=[$missing] oosh@$ooshAt log@$logAt extra@$extraAt prefixed=[$prefixed]) — run \`config save\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-2: oosh.env — only OOSH_* lines, OOSH_DIR the ~/oosh constant, and
# no absolute path of THIS user's home (the shared ~/config serves every user).
# ----------------------------------------------------------------------------
foreign=$(grep -vE '^export OOSH_[A-Z0-9_]+=".*"$' "$ooshEnv" 2>/dev/null | head -1)
leaked=$(grep -F "$HOME/" "$ooshEnv" 2>/dev/null | head -1)
test.case $level "platform.shared.configLayout: oosh.env holds every OOSH_* variable, \$HOME-relative" true
if [ -f "$ooshEnv" ] && [ -z "$foreign" ] && [ -z "$leaked" ] && grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$ooshEnv"; then
  expect.pass "oosh.env: OOSH_* only, OOSH_DIR=\"\$HOME/oosh\", no absolute home"
else
  expect.fail "oosh.env off-model (foreign=[$foreign] leaked=[$leaked]) — run \`config save oosh\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-3: log.env — only LOG_* lines, the session chain as the LAST line.
# ----------------------------------------------------------------------------
foreign=$(sed '$d' "$logEnv" 2>/dev/null | grep -vE '^export LOG_[A-Z0-9_]+=".*"$' | head -1)
leaked=$(grep -F "$HOME/" "$logEnv" 2>/dev/null | head -1)
test.case $level "platform.shared.configLayout: log.env holds every LOG_* variable, the session chain last" true
if [ -f "$logEnv" ] && [ -z "$foreign" ] && [ -z "$leaked" ] && [ "$(tail -1 "$logEnv")" = "$chainLine" ]; then
  expect.pass "log.env: LOG_* only, ends with $chainLine"
else
  expect.fail "log.env off-model (foreign=[$foreign] leaked=[$leaked] last=[$(tail -1 "$logEnv" 2>/dev/null)]) — run \`config save log\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-4: the per-user session file exists — log.env chains it unguarded.
# ----------------------------------------------------------------------------
test.case $level "platform.shared.configLayout: $sessionEnv exists" \
  test -f "$sessionEnv"
if [ -f "$sessionEnv" ]; then
  expect.pass "$sessionEnv present"
else
  expect.fail "$sessionEnv missing — log.env's chain line fails; run \`config init.user\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-5: no boot anywhere — not in the tree, not as a login drop-in,
# not in .bashrc.
# ----------------------------------------------------------------------------
bootLeft=""
[ -e "$HOME/oosh/boot" ] && bootLeft="$bootLeft ~/oosh/boot"
[ -e /etc/profile.d/oosh.sh ] && bootLeft="$bootLeft /etc/profile.d/oosh.sh"
grep -q 'oosh/boot' "$HOME/.bashrc" 2>/dev/null && bootLeft="$bootLeft ~/.bashrc"
test.case $level "platform.shared.configLayout: no boot, no login drop-in, no boot in .bashrc" true
if [ -z "$bootLeft" ]; then
  expect.pass "no boot anywhere"
else
  expect.fail "boot still present:$bootLeft — run \`oo update\` (drop-in) and \`config init.user\` (.bashrc)"
fi

# ----------------------------------------------------------------------------
# INVARIANT-6: behavioural — an interactive shell (.bashrc) and an empty one
# (`source this` alone: cron, ssh commands) both come up as oosh shells.
# ----------------------------------------------------------------------------
want="$HOME/config|$HOME/oosh|function"
# RESULT on a line of its own: the .bashrc trap prints "bashrc onExit: 0" when the shell exits.
interactive=$(bash -ic 'printf "\nRESULT %s|%s|%s\n" "$CONFIG_PATH" "$OOSH_DIR" "$(type -t log.level)"' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
cold=$(env -i HOME="$HOME" USER="$USER" PATH=/usr/bin:/bin bash -c \
  'source "$HOME/oosh/this" >/dev/null 2>&1; printf "%s|%s|%s" "$CONFIG_PATH" "$OOSH_DIR" "$(type -t log.level)"' 2>/dev/null)
test.case $level "platform.shared.configLayout: bash -i and an empty shell both start from user.env" true
if [ "$interactive" = "$want" ] && [ "$cold" = "$want" ]; then
  expect.pass "both shells: $want"
else
  expect.fail "shell start (want [$want]): interactive=[$interactive] cold=[$cold] — see invariants 1-5"
fi

# ----------------------------------------------------------------------------
# INVARIANT-7: the clean boot — `env -i` wipes everything and oosh constructs it
# again: from ~/oosh an empty shell derives HOME and comes up; as root, `env -i
# su - <user>` (what `user login` does) brings every installed user up as an
# oosh shell from their own ~/config/user.env.
# ----------------------------------------------------------------------------
wantSelf="$HOME|$HOME/config|function"
cleanSelf=$(cd "$HOME/oosh" 2>/dev/null && env -i PATH=/usr/bin:/bin bash -c \
  'source ./this >/dev/null 2>&1; printf "\nRESULT %s|%s|%s\n" "$HOME" "$CONFIG_PATH" "$(type -t log.level)"' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
loginBad=""
if [ "$(id -u)" = 0 ]; then
  for loginHome in /home/* /Users/*; do
    [ -L "$loginHome/oosh" ] && [ -f "$loginHome/config/user.env" ] || continue
    loginUser=$(basename "$loginHome")
    loginOut=$(env -i su - "$loginUser" -c 'bash -ic '"'"'printf "\nRESULT %s|%s\n" "$CONFIG" "$(type -t log.level)"'"'"'' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
    [ "$loginOut" = "$loginHome/config/user.env|function" ] || loginBad="$loginBad $loginUser=[$loginOut]"
  done
fi
test.case $level "platform.shared.configLayout: env -i then user login constructs the oosh shell again" true
if [ "$cleanSelf" = "$wantSelf" ] && [ -z "$loginBad" ]; then
  expect.pass "clean boot: env -i derives HOME ($cleanSelf)$([ "$(id -u)" = 0 ] && echo '; every user comes up through env -i su -')"
else
  expect.fail "clean boot (want [$wantSelf]): self=[$cleanSelf]${loginBad:+ login:$loginBad} — see invariants 1-6"
fi

# ----------------------------------------------------------------------------
# INVARIANT-8: a login shell given only HOME — ssh, `su -`, `user login` —
# starts from user.env with the oosh directories first and no directory twice
# on PATH. What a login file runs AFTER .bashrc is outside oosh's reach: on
# this computer an installer's `export PATH="$HOME/.local/bin:$PATH"` in
# ~/.bash_profile put a second ~/.local/bin in front (2026-09-30).
# A bare `env -i bash -l` with NO HOME is not an oosh shell and is not meant to
# be — bash cannot find ~/.bash_profile — the MacStudio model has no host-wide
# login file; its routes are `user login` (su - sets HOME) and
# `source ~/oosh/this` (INVARIANT-7).
# ----------------------------------------------------------------------------
loginPath=$(env -i HOME="$HOME" TERM=dumb bash -lic 'printf "\nRESULT %s\n" "$PATH"' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
loginDup=$(printf '%s\n' "$loginPath" | tr ':' '\n' | grep -v '^$' | sort | uniq -d | tr '\n' ' ')
test.case $level "platform.shared.configLayout: a login shell with HOME has oosh first and no PATH duplicate" true
if [ "${loginPath%%:*}" = "$HOME/oosh" ] && [ -z "$loginDup" ]; then
  expect.pass "login shell: PATH starts with $HOME/oosh, no duplicate"
else
  expect.fail "login shell PATH (first=[${loginPath%%:*}] duplicates=[$loginDup]) — a login file (~/.bash_profile, ~/.profile) changes PATH after .bashrc"
fi

test.suite.save.results
