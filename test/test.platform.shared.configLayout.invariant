#!/usr/bin/env bash
# ============================================================================
# Platform invariant: the MacStudio config layout, and a shell that starts without boot.
#
# Runs on the REAL host, as every installed user (os platform.test runs it
# per user once the runners are switched — Round 4 of the dev.config plan).
# The model (test/mcdonges.latest, the boss's MacStudio), user.env forked like
# log.env (boss, 2026-10-02):
#   ~/config/user.env  CONFIG_PATH/CONFIG_FILE/CONFIG, BASH_FILE — no PATH —
#                      then . oosh.env, then . log.env,
#                      then any other chain (. odocker.env, config add …),
#                      last line . $HOME/.config/oosh/user.session.env
#   ~/config/oosh.env  every OOSH_* variable but OOSH_MODE, last line
#                      . $HOME/.config/oosh/oosh.session.env
#   ~/config/log.env   every LOG_* variable, last line
#                      . $HOME/.config/oosh/log.session.env
#   ~/.config/oosh/log.session.env   per user, always present
#   ~/.config/oosh/user.session.env  per user, always present: the user's
#                      real PATH (no $ at all), nothing else
#   ~/.config/oosh/oosh.session.env  per user, always present: OOSH_MODE
# ~/config is SHARED between users, so no saved value may carry the saving
# user's absolute $HOME. No boot, no /etc/profile.d/oosh.sh: .bashrc and
# `source this` stand the shell up from user.env.
# Invoke: ./test.suite run platform.shared.configLayout.invariant 1
# ============================================================================

TEST_CATEGORY=platform

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ----------------------------------------------------------------------------
# INVARIANT-0 (precondition): ~/config/user.env exists — the rest reads it.
# ----------------------------------------------------------------------------
userEnv="$HOME/config/user.env"
ooshEnv="$HOME/config/oosh.env"
logEnv="$HOME/config/log.env"
sessionEnv="$HOME/.config/oosh/log.session.env"
chainLine='. $HOME/.config/oosh/log.session.env'
userSessionEnv="$HOME/.config/oosh/user.session.env"
userChainLine='. $HOME/.config/oosh/user.session.env'
ooshSessionEnv="$HOME/.config/oosh/oosh.session.env"
ooshChainLine='. $HOME/.config/oosh/oosh.session.env'

test.case $level "platform.shared.configLayout: precondition — $userEnv exists" \
  test -f "$userEnv"
if [ ! -f "$userEnv" ]; then
  expect.fail "$userEnv does not exist — run \`config save\` (or \`ossh install <host>\` first)"
  test.suite.save.results
  return 0 2>/dev/null || exit 0
else
  expect.pass "$userEnv present"
fi

# ----------------------------------------------------------------------------
# INVARIANT-1: user.env — the anchors, BASH_FILE, then oosh.env before
# log.env, and the user's own user.session.env LAST. No PATH: it is per user.
# Any other chain (`. $CONFIG_PATH/odocker.env`, `config add myapp`) is part of
# the model too — config save keeps it (T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS) —
# and comes after log.env.
# ----------------------------------------------------------------------------
foreign=$(grep -vE '^export [A-Z_][A-Z0-9_]*=".*"$|^\. \$CONFIG_PATH/[A-Za-z0-9_.]+\.env$' "$userEnv" | grep -vxF "$userChainLine" | head -1)
missing=""
for k in CONFIG_PATH CONFIG_FILE CONFIG BASH_FILE; do
  grep -q "^export $k=" "$userEnv" || missing="$missing $k"
done
# path-exception: a pattern searched for in user.env, not an assignment.
grep -q '^export PATH=' "$userEnv" && missing="$missing no-PATH-line-expected"
[ "$(tail -1 "$userEnv")" = "$userChainLine" ] || missing="$missing user.session.env-chain-last"
ooshAt=$(grep -nxF '. $CONFIG_PATH/oosh.env' "$userEnv" | cut -d: -f1)
logAt=$(grep -nxF '. $CONFIG_PATH/log.env' "$userEnv" | cut -d: -f1)
extraAt=$(grep -nE '^\. \$CONFIG_PATH/[A-Za-z0-9_.]+\.env$' "$userEnv" | grep -vE ':\. \$CONFIG_PATH/(oosh|log)\.env$' | head -1 | cut -d: -f1)
prefixed=$(grep -E '^export (OOSH|LOG)_' "$userEnv" | head -1)
test.case $level "platform.shared.configLayout: user.env holds the anchors and chains oosh.env, then log.env, then any other" true
if [ -z "$foreign" ] && [ -z "$missing" ] && [ -n "$ooshAt" ] && [ -n "$logAt" ] && [ "$ooshAt" -lt "$logAt" ] \
   && { [ -z "$extraAt" ] || [ "$extraAt" -gt "$logAt" ]; } && [ -z "$prefixed" ]; then
  expect.pass "user.env in the MacStudio layout, the user's own session file chained last"
else
  expect.fail "user.env off-model (foreign=[$foreign] missing=[$missing] oosh@$ooshAt log@$logAt extra@$extraAt prefixed=[$prefixed]) — run \`sudo oo update\` (the switch), then \`config save\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-2: oosh.env — only OOSH_* lines, OOSH_DIR the ~/oosh constant, no
# OOSH_MODE (per user, in user.session.env) and no absolute path of THIS
# user's home (the shared ~/config serves every user).
# ----------------------------------------------------------------------------
foreign=$(grep -vE '^export OOSH_[A-Z0-9_]+=".*"$' "$ooshEnv" 2>/dev/null | grep -vxF "$ooshChainLine" | head -1)
[ -z "$foreign" ] && foreign=$(grep -E '^export OOSH_MODE=' "$ooshEnv" 2>/dev/null | head -1)
[ "$(tail -1 "$ooshEnv" 2>/dev/null)" = "$ooshChainLine" ] || foreign="$foreign oosh.session.env-chain-not-last"
leaked=$(grep -F "$HOME/" "$ooshEnv" 2>/dev/null | head -1)
test.case $level "platform.shared.configLayout: oosh.env holds every OOSH_* variable but OOSH_MODE, \$HOME-relative" true
if [ -f "$ooshEnv" ] && [ -z "$foreign" ] && [ -z "$leaked" ] && grep -qxF 'export OOSH_DIR="$HOME/oosh"' "$ooshEnv"; then
  expect.pass "oosh.env: OOSH_* only, OOSH_DIR=\"\$HOME/oosh\", no absolute home"
else
  expect.fail "oosh.env off-model (foreign=[$foreign] leaked=[$leaked]) — run \`config save oosh\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-3: log.env — only LOG_* lines, the session chain as the LAST line.
# ----------------------------------------------------------------------------
foreign=$(sed '$d' "$logEnv" 2>/dev/null | grep -vE '^export LOG_[A-Z0-9_]+=".*"$' | head -1)
leaked=$(grep -F "$HOME/" "$logEnv" 2>/dev/null | head -1)
test.case $level "platform.shared.configLayout: log.env holds every LOG_* variable, the session chain last" true
if [ -f "$logEnv" ] && [ -z "$foreign" ] && [ -z "$leaked" ] && [ "$(tail -1 "$logEnv")" = "$chainLine" ]; then
  expect.pass "log.env: LOG_* only, ends with $chainLine"
else
  expect.fail "log.env off-model (foreign=[$foreign] leaked=[$leaked] last=[$(tail -1 "$logEnv" 2>/dev/null)]) — run \`config save log\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-4: the per-user session files exist — log.env and user.env chain
# them unguarded. user.session.env holds the user's REAL PATH (no $ at all,
# ~/oosh first) and OOSH_MODE, nothing else. As root: every user linked to
# this shared config has a filled one (a plain sh of theirs ends otherwise).
# ----------------------------------------------------------------------------
test.case $level "platform.shared.configLayout: $sessionEnv exists" \
  test -f "$sessionEnv"
if [ -f "$sessionEnv" ]; then
  expect.pass "$sessionEnv present"
else
  expect.fail "$sessionEnv missing — log.env's chain line fails; run \`config init.user\`"
fi
sessionBad=""
[ -s "$userSessionEnv" ] || sessionBad="$sessionBad missing-or-empty"
# path-exception: patterns searched for in the session file, not assignments.
sessionForeign=$(grep -vE '^export PATH="/[^$]*"$' "$userSessionEnv" 2>/dev/null | head -1)
[ -n "$sessionForeign" ] && sessionBad="$sessionBad foreign=[$sessionForeign]"
sessionPath=$(sed -n 's/^export PATH="\(.*\)"$/\1/p' "$userSessionEnv" 2>/dev/null)
[ "${sessionPath%%:*}" = "$HOME/oosh" ] || sessionBad="$sessionBad path-first=[${sessionPath%%:*}]"
grep -qx 'export OOSH_MODE="..*"' "$ooshSessionEnv" 2>/dev/null || sessionBad="$sessionBad no-OOSH_MODE-in-oosh.session.env"
if [ "$(id -u)" = 0 ]; then
  sharedTarget=$(private.this.path.canonical "$HOME/config" 2>/dev/null)
  for linkedHome in /home/* /Users/*; do
    [ -L "$linkedHome/config" ] || continue
    [ "$(private.this.path.canonical "$linkedHome/config" 2>/dev/null)" = "$sharedTarget" ] || continue
    [ -s "$linkedHome/.config/oosh/user.session.env" ] || sessionBad="$sessionBad $(basename "$linkedHome")-has-no-user.session"
    [ -f "$linkedHome/.config/oosh/oosh.session.env" ] || sessionBad="$sessionBad $(basename "$linkedHome")-has-no-oosh.session"
  done
fi
test.case $level "platform.shared.configLayout: user.session.env holds the real PATH, oosh.session.env OOSH_MODE" true
if [ -z "$sessionBad" ]; then
  expect.pass "user.session.env: real PATH from $HOME/oosh; oosh.session.env: OOSH_MODE$([ "$(id -u)" = 0 ] && echo '; every linked user has both')"
else
  expect.fail "user.session.env off-model:$sessionBad — run \`oo user.fix\` (as root: \`sudo oo update\`)"
fi

# ----------------------------------------------------------------------------
# INVARIANT-5: no boot anywhere — not in the tree, not as a login drop-in,
# not in .bashrc.
# ----------------------------------------------------------------------------
bootLeft=""
[ -e "$HOME/oosh/boot" ] && bootLeft="$bootLeft ~/oosh/boot"
[ -e /etc/profile.d/oosh.sh ] && bootLeft="$bootLeft /etc/profile.d/oosh.sh"
grep -q 'oosh/boot' "$HOME/.bashrc" 2>/dev/null && bootLeft="$bootLeft ~/.bashrc"
test.case $level "platform.shared.configLayout: no boot, no login drop-in, no boot in .bashrc" true
if [ -z "$bootLeft" ]; then
  expect.pass "no boot anywhere"
else
  expect.fail "boot still present:$bootLeft — run \`oo update\` (drop-in) and \`config init.user\` (.bashrc)"
fi

# ----------------------------------------------------------------------------
# INVARIANT-6: behavioural — an interactive shell (.bashrc) and an empty one
# (`source this` alone: cron, ssh commands) both come up as oosh shells.
# ----------------------------------------------------------------------------
want="$HOME/config|$HOME/oosh|function"
# RESULT on a line of its own: the .bashrc trap prints "bashrc onExit: 0" when the shell exits.
interactive=$(bash -ic 'printf "\nRESULT %s|%s|%s\n" "$CONFIG_PATH" "$OOSH_DIR" "$(type -t log.level)"' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
cold=$(env -i HOME="$HOME" USER="$USER" PATH=/usr/bin:/bin bash -c \
  'source "$HOME/oosh/this" >/dev/null 2>&1; printf "%s|%s|%s" "$CONFIG_PATH" "$OOSH_DIR" "$(type -t log.level)"' 2>/dev/null)
test.case $level "platform.shared.configLayout: bash -i and an empty shell both start from user.env" true
if [ "$interactive" = "$want" ] && [ "$cold" = "$want" ]; then
  expect.pass "both shells: $want"
else
  expect.fail "shell start (want [$want]): interactive=[$interactive] cold=[$cold] — see invariants 1-5"
fi

# ----------------------------------------------------------------------------
# INVARIANT-7: the clean boot — `env -i` wipes everything and oosh constructs it
# again: from ~/oosh an empty shell derives HOME and comes up; as root, `env -i
# su - <user>` (what `user login` does) brings every installed user (a home
# with ~/oosh and ~/config/user.env whose name is a user) up as an
# oosh shell from their own ~/config/user.env.
# The login starts "$BASH" -i, the bash the suite runs under: a bare `bash` is
# /bin/bash 3.2 on macOS, whose hand-over to the brew bash drops the -c
# command. su's stderr is the terminal when there is one: macOS su hands the
# terminal to the login only through fd 2, and an interactive bash outside
# the terminal's foreground stops itself (SIGTTIN) — the probe hung 12 minutes
# as root on the macOS VM (2026-10-06). Bounded anyway: 30 s, then "hung".
# ----------------------------------------------------------------------------
test.platform.shared.configLayout.login.get() # <user> <home> # echo CONFIG and the type of log.level after an env -i su - login of the user, or hung when it does not end within 30 s; the session file of the user as it was before
{
 local loginUser="$1" loginHome="$2" fx pid child waited=0 errTo=/dev/null sessionFile kept=no
 local probe='printf "\nRESULT %s|%s\n" "$CONFIG" "$(type -t log.level)"'
 { : >/dev/tty; } 2>/dev/null && errTo=/dev/tty
 fx=$(test.suite.fixture.make configLayoutLogin)
 # The login runs the user's ~/.bashrc, whose log.session.save writes LOG_NAME and LOG_LIVE into
 # their session file: as root this probes every user, and the heal's verify runs it — the compare
 # of os platform.heal.test found those lines in every home (P6). test.suite keeps only the
 # runner's own files; this one is kept here and put back, content only (owner and mode stay).
 sessionFile="$loginHome/.config/oosh/log.session.env"
 [ -f "$sessionFile" ] && cp "$sessionFile" "$fx/session.kept" && kept=yes
 env -i su - "$loginUser" -c "'$BASH' -ic '$probe' 2>/dev/null" </dev/null >"$fx/out" 2>"$errTo" &
 pid=$!
 while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do sleep 1; waited=$((waited + 1)); done
 if kill -0 "$pid" 2>/dev/null; then
   # stopped processes take only SIGKILL; the login and its bash first
   for child in $(pgrep -P "$pid"); do pkill -9 -P "$child" 2>/dev/null; kill -9 "$child" 2>/dev/null; done
   kill -9 "$pid" 2>/dev/null
   echo hung
 else
   wait "$pid"
   sed -n 's/^RESULT //p' "$fx/out"
 fi
 if [ "$kept" = yes ]; then cat "$fx/session.kept" > "$sessionFile" 2>/dev/null; else rm -f "$sessionFile"; fi
 rm -rf "$fx"
}

wantSelf="$HOME|$HOME/config|function"
cleanSelf=$(cd "$HOME/oosh" 2>/dev/null && env -i PATH=/usr/bin:/bin bash -c \
  'source ./this >/dev/null 2>&1; printf "\nRESULT %s|%s|%s\n" "$HOME" "$CONFIG_PATH" "$(type -t log.level)"' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
loginBad=""
if [ "$(id -u)" = 0 ]; then
  for loginHome in /home/* /Users/*; do
    [ -L "$loginHome/oosh" ] && [ -f "$loginHome/config/user.env" ] || continue
    loginUser=$(basename "$loginHome")
    # a home that names no user (the tart image's /Users/runner -> /Users/admin) is no login
    id -u "$loginUser" >/dev/null 2>&1 || continue
    loginOut=$(test.platform.shared.configLayout.login.get "$loginUser" "$loginHome")
    [ "$loginOut" = "$loginHome/config/user.env|function" ] || loginBad="$loginBad $loginUser=[$loginOut]"
  done
fi
test.case $level "platform.shared.configLayout: env -i then user login constructs the oosh shell again" true
if [ "$cleanSelf" = "$wantSelf" ] && [ -z "$loginBad" ]; then
  expect.pass "clean boot: env -i derives HOME ($cleanSelf)$([ "$(id -u)" = 0 ] && echo '; every user comes up through env -i su -')"
else
  expect.fail "clean boot (want [$wantSelf]): self=[$cleanSelf]${loginBad:+ login:$loginBad} — see invariants 1-6"
fi

# ----------------------------------------------------------------------------
# INVARIANT-8: a login shell given only HOME — ssh, `su -`, `user login` —
# starts from user.env with the oosh directories first and no directory twice
# on PATH. What a login file runs AFTER .bashrc is outside oosh's reach: on
# this computer an installer's `export PATH="$HOME/.local/bin:$PATH"` in
# ~/.bash_profile put a second ~/.local/bin in front (2026-09-30).
# The same with NO HOME — `env -i sh`, then `bash -l` or `this` — is an oosh
# shell too since 2026-10-02 (the boss's boot order); platform.shared.boot
# checks those.
# The probe is "$BASH", the bash the suite runs under (4+): under env -i,
# `bash` is /bin/bash 3.2 on macOS, whose hand-over to the newer bash drops
# the -c command and leaves no output (macOS VM, 2026-10-06).
# ----------------------------------------------------------------------------
loginPath=$(env -i HOME="$HOME" TERM=dumb "$BASH" -lic 'printf "\nRESULT %s\n" "$PATH"' 2>/dev/null </dev/null | sed -n 's/^RESULT //p')
loginDup=$(printf '%s\n' "$loginPath" | tr ':' '\n' | grep -v '^$' | sort | uniq -d | tr '\n' ' ')
test.case $level "platform.shared.configLayout: a login shell with HOME has oosh first and no PATH duplicate" true
if [ "${loginPath%%:*}" = "$HOME/oosh" ] && [ -z "$loginDup" ]; then
  expect.pass "login shell: PATH starts with $HOME/oosh, no duplicate"
else
  expect.fail "login shell PATH (first=[${loginPath%%:*}] duplicates=[$loginDup]) — a login file (~/.bash_profile, ~/.profile) changes PATH after .bashrc"
fi


# ----------------------------------------------------------------------------
# INVARIANT-9: every file and folder of the shared config is group-writable
# and in group dev — every user of the computer appends to the same
# error.txt and result.txt and rewrites the same env files. oo heal ran as
# root with umask 022 after config init.shared had normalised it: on the
# macOS VM (2026-10-08) result.txt, error.txt and the colour env files stayed
# -rw-r--r-- root dev and every other user's next login printed
# "tee: ~/config/error.txt: Permission denied". Read-only; without a dev
# group (a single-user install) nothing is shared and nothing is checked.
# A file its owner cannot write either (0444) is read-only on purpose: the kernel's
# folder.share gives it the group and leaves its mode (share.pending.list asks
# for g+w only where the owner has w), so it is not asked to be group-writable.
# ----------------------------------------------------------------------------
sharedConfig=$(private.this.path.canonical "$HOME/config" 2>/dev/null)
notShared=""
if private.this.group.exists dev && [ -d "$sharedConfig" ]; then
  notShared=$(find "$sharedConfig/" \( -type f -o -type d \) \( \( -perm -u=w ! -perm -g=w \) -o ! -group dev \) 2>/dev/null | sed "s|^$sharedConfig/||; s|^$|.|" | head -20 | tr '\n' ' ')
fi
test.case $level "platform.shared.configLayout: every file of the shared config is group-writable and group dev" true
if [ -z "$notShared" ]; then
  expect.pass "$sharedConfig: every file and folder group dev and group-writable$(private.this.group.exists dev || echo ' (no dev group — single-user install, nothing shared)')"
else
  expect.fail "$sharedConfig has files other users cannot write: ${notShared% } — run \`config init.shared\` (it uses sudo when you do not own the folder)"
fi

test.suite.save.results
