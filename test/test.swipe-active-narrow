#!/usr/bin/env bash
# T-SWIPE-ACTIVE-NARROW — RED-FIRST for Rule 4 (design session/tasks/stale-role-labels-after-pane-move.design.md
# b2f9222e1, acceptance cells 10-12): ACTIVE must survive a NARROW pane, in swipe AND pulse classify.
# BUG (measured on ooshTeam:0.3, oosh-tester, while working): the status bar is truncated
#   ('esc to interrupt' -> '· esc …') and the working line ('✻ Forging… (34m 0s · ↓ 108.8k tokens)') sits
#   4 lines above the input box behind a Tip + update notice -> classify reads the last 6 lines, misses
#   the full 'esc to int' -> falls through to the auto-mode bar -> IDLE. Width-dependent.
# CONTRACT (ACTIVE if ANY): (1) 'esc to int' in the 6-line tail; (2) '· esc' segment on the status-bar line;
#   (3) anchored working line: walk UP <=8 lines from the input box's upper separator across ONLY trailer
#   chrome (blank / ⎿ / ✔ / indented); first non-trailer line must be  <glyph> Verb… (elapsed
# Cell 11 is the GUARD (must stay IDLE before AND after the fix): a finished 'Brewed for …', body text that
#   merely says thinking/Forging…, a working-shaped line >8 lines up or above real output.
# Frozen fixtures: one throwaway session per case sized to its chrome; a 'claude'-named stand-in prints
#   the exact chrome (no live agent, no live state). Test pane is outside every fixture session.

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-FIRST — narrow-pane ACTIVE must fail)"
source this
source test.suite
log.level $level
export LOG_DEVICE=/dev/null

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

FX_PREFIX="fxr4_"; GEN="${OOSH_DIR}/test/gen/t-swipe-active-narrow"
SM_UT=$(command -v scrumMaster)
sweep(){ tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" \
           | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; rm -rf "$GEN"; }
trap sweep EXIT
sweep
mkdir -p "$GEN/bin" "$GEN/fx" "$GEN/cwd"

SEPT='──────────────────────── fxr4-agent@WODA.prod ─'
SEPB='────────────────────────────────────────────────'
BAR_IDLE='  ⏵⏵ auto mode on (shift+tab to cycle)'
BAR_TRUNC='  ⏵⏵ auto mode on (shift+tab to cycle) · esc …'
BAR_FULL='  ⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt'
WORK='✻ Forging… (34m 0s · ↓ 108.8k tokens)'
TIP='  ⎿  Tip: Use /clear to start fresh when switching topics'
NOTE='        ✔ Update installed · Restart to update'

fx(){ local n="$1"; shift; printf '%s\n' "$@" > "$GEN/fx/$n.txt"; }
# case | expected | chrome lines (top -> bottom)
fx 10a  "$WORK" "$TIP" "$NOTE" "$SEPT" '❯ ' "$SEPB" "$BAR_TRUNC"                  # measured 0.3 chrome
fx 10b  "$WORK" "$TIP" "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"                            # signal 3 alone
fx 10c  "● Wrote 3 files and ran the suite." "$SEPT" '❯ ' "$SEPB" "$BAR_TRUNC"     # signal 2 alone
fx 11a  "✻ Brewed for 5m 16s · done 11:32 AM" "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"     # finished -> IDLE
fx 11b  "● While thinking I was Forging… a plan (32m 25s · thinking) earlier," \
        "  and this is the real output that followed it." "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"
fx 11c1 "$WORK" "" "" "" "" "" "" "" "" "" "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"         # 9 blanks: >8 lines up
fx 11c2 "$WORK" "● Done. Real output line." "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"       # above a non-trailer line
fx 12w  "$WORK" "$TIP" "$SEPT" '❯ ' "$SEPB" "$BAR_FULL"                            # wide: full esc to interrupt
fx 12n  "$WORK" "$TIP" "$SEPT" '❯ ' "$SEPB" "$BAR_TRUNC"                           # narrow: truncated
# 13 (expert-flagged copy-drift pins): (a) '●' shares the E2 lead byte with the spinner glyphs — a
# bracket match under C locale would accept it; glyph must be an ALTERNATION -> IDLE. (b) NBSP-indented
# line between working line and separator: bash and python must AGREE (value recorded, not prescribed).
fx 13a  "● Forging… (34m 0s · ↓ 1.2k tokens)" "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"
fx 13b  "$WORK" $'  ⎿  Tip: nbsp-indented continuation' "$SEPT" '❯ ' "$SEPB" "$BAR_IDLE"
declare -A WANT=([10a]=ACTIVE [10b]=ACTIVE [10c]=ACTIVE [11a]=IDLE [11b]=IDLE [11c1]=IDLE [11c2]=IDLE [12w]=ACTIVE [12n]=ACTIVE [13a]=IDLE [13b]=AGREE)
CASES="10a 10b 10c 11a 11b 11c1 11c2 12w 12n 13a 13b"

echo; echo "===== UNIT — private.scrumMaster.swipe.classify on the exact chrome (always runnable) ====="
for c in $CASES; do
  [ "${WANT[$c]}" = AGREE ] && continue        # agreement-only cell: checked swipe-vs-pulse below
  got=$( (source "$SM_UT" >/dev/null 2>&1; private.scrumMaster.swipe.classify "$(cat "$GEN/fx/$c.txt")") 2>/dev/null)
  test.case $level "U $c -> ${WANT[$c]}" echo "$got"
  [ "$got" = "${WANT[$c]}" ] && ok "swipe.classify $c = $got" || no "RED: swipe.classify $c = '${got}', want ${WANT[$c]}"
done

if [ -z "$TMUX" ]; then
  test.case $level "INTEGRATION swipe+pulse (skipped — no tmux)" echo skip; expect.pass "skipped"
else
echo; echo "===== INTEGRATION — frozen fixture panes rendered by swipe AND pulse ====="
cat > "$GEN/bin/claude" <<'SH'
#!/bin/sh
# stand-in agent: print the fixture chrome EXACTLY (no trailing newline -> last line stays the pane bottom), hold
printf '%s' "$(cat "$1")"
while :; do sleep 86400; done
SH
chmod +x "$GEN/bin/claude"
RC=$(cd "$GEN/cwd" && pwd -P)
for c in $CASES; do
  h=$(grep -c '' "$GEN/fx/$c.txt")
  # +1: tmux's status bar takes one row of the session height — a -y N session has an N-1 row pane,
  # which scrolled the TOP chrome line (the working line) off and made signal-3 cells vacuous.
  tmux new-session -d -s "${FX_PREFIX}$c" -x 120 -y "$((h+1))" -c "$RC" 2>/dev/null
  # stand-in runs as a CHILD of the pane's bash (no exec): swipe/pulse kind = claude in the SUBTREE below pane_pid
  tmux send-keys -t "${FX_PREFIX}$c:0.0" "clear; '$GEN/bin/claude' '$GEN/fx/$c.txt'" Enter 2>/dev/null
done
sleep 1.6
# instrument: the pane must show the chrome exactly (bottom line == fixture's last line), else confounded
BAD=""
for c in $CASES; do   # the WHOLE visible pane must equal the fixture chrome (trailing blanks ignored)
  got=$(tmux capture-pane -p -t "${FX_PREFIX}$c:0.0" 2>/dev/null | sed 's/[[:space:]]*$//')
  want=$(sed 's/[[:space:]]*$//' "$GEN/fx/$c.txt")
  [ "$got" = "$want" ] || BAD="$BAD $c[$(diff <(printf '%s\n' "$want") <(printf '%s\n' "$got") | grep '^[<>]' | head -2 | tr '\n' '~')]"
done
test.case $level "FIXTURE: every pane renders EXACTLY the fixture chrome" echo "${BAD:-ok}"
[ -z "$BAD" ] && ok "chrome rendered exactly" || no "FIXTURE CONFOUND (fix the test):${BAD}"

# Render each fixture ONCE per tool (each call re-runs fleet-wide session discovery — re-rendering per
# cell blew the timeout); every cell below reads the cached render.
for c in $CASES; do for t in swipe pulse; do
  "$SM_UT" "$t" "${FX_PREFIX}$c" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' > "$GEN/out.$t.$c"
done; done
state_of(){ awk '$1=="0.0"{print $3; exit}' "$GEN/out.$1.$2" 2>/dev/null; }
for c in $CASES; do
  [ "${WANT[$c]}" = AGREE ] && continue
  for t in swipe pulse; do
    got=$(state_of "$t" "$c")
    test.case $level "I $t $c -> ${WANT[$c]}" echo "$got"
    [ "$got" = "${WANT[$c]}" ] && ok "$t $c = $got" || no "RED: $t $c = '${got:-<no row>}', want ${WANT[$c]}"
  done
done

echo; echo "===== cell 12 — width independence: the same state at two widths classifies the same ====="
for t in swipe pulse; do
  w=$(state_of "$t" 12w); n=$(state_of "$t" 12n)
  test.case $level "W $t: wide '$w' == narrow '$n'" echo "$w|$n"
  [ -n "$w" ] && [ "$w" = "$n" ] && ok "$t width-independent ($w)" || no "RED: $t wide='$w' narrow='$n' (width-dependent)"
done

echo; echo "===== cell 13b — NBSP indentation: the bash and python copies AGREE ====="
s13=$(state_of swipe 13b); p13=$(state_of pulse 13b)
test.case $level "13b NBSP-indented trailer: swipe '$s13' == pulse '$p13'" echo "$s13|$p13"
[ -n "$s13" ] && [ "$s13" = "$p13" ] && ok "copies agree on NBSP ($s13)" || no "COPY DRIFT: swipe='$s13' pulse='$p13' on an NBSP-indented line"
fi

echo
echo "=================================================================="
echo "  T-SWIPE-ACTIVE-NARROW  PASS=$pass FAIL=$fail"
echo "  RED-FIRST until Rule 4 lands in swipe AND pulse; cell 11 must stay IDLE before and after."
echo "=================================================================="
sweep
test.suite.save.results
