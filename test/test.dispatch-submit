#!/usr/bin/env bash
# T-DISPATCH-SUBMIT → reshaped to the QUEUE-DRAIN no-drop guard (2026-07-03).
#
# HISTORY / why reshaped (PO directive): the original RC0 / RC2-POKE / RC3 cells
# tested the OTR-1 stage→submit→verify→poke rc 0/2/3 verified-submission
# contract via otmux.send.{stage,submit,verify,poke}. That contract was REVERTED
# — those primitives are GONE, replaced by the self-heal `otmux.send.verified`
# (stage once → Escape-idle-only+Enter → poke Enter-only). The send contract is
# now covered by **test.send-selfheal (5/5)** + **test.send-matrix**. Those 3
# cells were STALE (testing removed functions), NOT a real regression → RETIRED.
#
# What remains real and worth guarding: `hiveMind agent.queue.drain` must NOT
# silently drop a message it can't deliver. The gate is now ROUTE-based (keep
# when the agent isn't at an idle `inform` prompt), not the old dispatchRc gate.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T-DRAIN-ROUTE-GATE [S]: agent.queue.drain KEEPS (break) a message when the
# recipient's route != inform (busy / overlay / unknown = not deliverable now),
# BEFORE it dispatches or dequeues — the current no-silent-drop guard. (The old
# dispatchRc rc0-gate was removed when the self-heal send made delivery reliable
# + rc2=on-pane=dequeue.)
# ============================================================================
DRAIN_BODY=$(sed -n '/^hiveMind.agent.queue.drain()/,/^}/p' "$OOSH_DIR/hiveMind")
ROUTE_GATE=$(printf '%s\n' "$DRAIN_BODY" | grep -n 'route" != "inform"' | head -1 | cut -d: -f1)
BREAK_AFTER=$(printf '%s\n' "$DRAIN_BODY" | awk -v g="${ROUTE_GATE:-0}" 'NR>g && NR<=g+3 && /break/{print "yes"; exit}')
LAST_DEQ=$(printf '%s\n' "$DRAIN_BODY" | grep -n 'tail -n +2 "$f"' | tail -1 | cut -d: -f1)
test.case $level "T-DRAIN-ROUTE-GATE: drain keeps (break) when route!=inform before dispatch/dequeue" \
  echo "routeGate=$ROUTE_GATE break=$BREAK_AFTER lastDequeue=$LAST_DEQ"
if [ -n "$ROUTE_GATE" ] && [ "$BREAK_AFTER" = "yes" ] && [ -n "$LAST_DEQ" ] && [ "$LAST_DEQ" -gt "$ROUTE_GATE" ]; then
  expect.pass "route!=inform → break (keep) before the dispatch-success dequeue (line $LAST_DEQ)"
else
  expect.fail "route-gate missing/misordered: routeGate=$ROUTE_GATE break=$BREAK_AFTER dequeue=$LAST_DEQ"
fi

# ============================================================================
# T-DRAIN-NODROP [B]: draining against a recipient that is NOT at an idle inform
# prompt must KEEP the message (never a silent drop). Uses an isolated throwaway
# pane in a blocked/modal display state → route != inform → drain bails, message
# stays queued. Direct queue-file write (no script sourcing — T-NO-SOURCE).
# ============================================================================
if [ -n "$(command -v tmux)" ] && tmux new-session -d -s "__drain_$$" -x 100 -y 30 2>/dev/null; then
  DP="__drain_$$:0.0"
  QDIR="${HIVEMIND_QUEUE_DIR:-${CONFIG_PATH:-$HOME/config}/hivemind.queue}"
  QSAFE="${DP//:/_}"; QSAFE="${QSAFE//./_}"
  QFILE="${QDIR}/${QSAFE}.queue"
  mkdir -p "$QDIR" 2>/dev/null
  MARKER="drain-nodrop-$$"
  echo "$(date +%s)|inform|${MARKER}" > "$QFILE"

  # Put the pane in a blocked/modal display (route != inform → drain must keep).
  tmux send-keys -t "$DP" "printf 'Do you want to proceed?\\n'" Enter
  sleep 0.6

  hiveMind agent.queue.drain "$DP" >/dev/null 2>&1

  KEPT=$(grep -c "$MARKER" "$QFILE" 2>/dev/null)
  test.case $level "T-DRAIN-NODROP: drain never silently drops an undeliverable message" \
    echo "kept=$KEPT"
  if [ "${KEPT:-0}" -ge 1 ]; then
    expect.pass "undeliverable message KEPT queued after drain (no silent drop)"
  else
    expect.fail "drain DROPPED the message it could not deliver [Sprint22 Hole-2 regression]"
  fi

  rm -f "$QFILE" 2>/dev/null
  tmux kill-session -t "__drain_$$" 2>/dev/null
else
  test.case $level "T-DRAIN-NODROP: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
fi

# NOTE: the send-side verified-submission contract (commit, exactly-1-delivery,
# no-interrupt, prefix-once) is verified by test.send-selfheal (5/5) and
# test.send-matrix — not here. This file is now the queue-drain no-drop guard.

echo ""
echo "=== T-DISPATCH-SUBMIT (drain no-drop guard) complete ==="
echo ""

test.suite.save.results
