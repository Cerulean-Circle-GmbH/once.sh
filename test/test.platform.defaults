#!/usr/bin/env bash
# T-PLATFORM-DEFAULTS — cross-platform install locations are DERIVED from os
# detection (single seam in config.init), never hardcoded to one platform.
#
# Regression for sprint-setup-server-crossplatform.md D3 (expert 650e743):
#   single OOSH_SHARED_BASE seam in config.init keyed on $OOSH_OS →
#   OOSH_COMPONENTS_DIR + ODOCKER_WORKSPACES; consumers (oo.mode.base.get,
#   odocker) drop the macOS literals; ${VAR:-} preserves operator overrides.
# Tester measured live on WODA.test (linux): OOSH_SHARED_BASE=/home/shared,
# OOSH_COMPONENTS_DIR=/home/shared/.../components/OOSH, OOSH_OS=linux-gnu.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

CONFIG_SCRIPT="$OOSH_DIR/config"
OO="$OOSH_DIR/oo"
ODOCKER="$OOSH_DIR/odocker"

# ============================================================================
# (1) Single derivation seam exists in config, keyed on the os discriminator
# ============================================================================
test.case $level "T-PLATFORM-DEFAULTS: config derives OOSH_SHARED_BASE keyed on OOSH_OS" \
  echo "grep config for OOSH_SHARED_BASE derivation"
if grep -qE 'OOSH_SHARED_BASE' "$CONFIG_SCRIPT" \
   && grep -qE 'OOSH_OS|OSTYPE' "$CONFIG_SCRIPT"; then
  expect.pass "config computes OOSH_SHARED_BASE from the os discriminator"
else
  expect.fail "config must derive OOSH_SHARED_BASE from OOSH_OS/OSTYPE (single seam)"
fi

# ============================================================================
# (2) Both platform bases present in the derivation (darwin AND linux)
# ============================================================================
test.case $level "T-PLATFORM-DEFAULTS: derivation covers darwin AND linux bases" \
  echo "grep config for /Users/Shared and /home/shared"
if grep -qE '/Users/Shared' "$CONFIG_SCRIPT" && grep -qE '/home/shared' "$CONFIG_SCRIPT"; then
  expect.pass "config maps darwin→/Users/Shared, linux→/home/shared"
else
  expect.fail "config must map both platforms (darwin + linux bases)"
fi

# ============================================================================
# (3) Override honored — derivation uses ${VAR:-} so a preset base survives
# ============================================================================
test.case $level "T-PLATFORM-DEFAULTS: OOSH_SHARED_BASE override preserved (\${VAR:-})" \
  echo "grep config for OOSH_SHARED_BASE:- default-guard"
if grep -qE 'OOSH_SHARED_BASE:-|OOSH_SHARED_BASE:=|\[\s*-z\s*"?\$\{?OOSH_SHARED_BASE' "$CONFIG_SCRIPT"; then
  expect.pass "config preserves a preset OOSH_SHARED_BASE (operator/CI override)"
else
  expect.fail "config must guard OOSH_SHARED_BASE with \${VAR:-} to honor overrides"
fi

# ============================================================================
# (4) Consumers de-hardcoded: oo.mode.base.get + odocker read the derived vars,
#     NOT a bare macOS literal as the only source of truth.
# ============================================================================
baseBody=$(awk '/^oo\.mode\.base\.get\(\)/{f=1} f{print} f&&/^}/{exit}' "$OO")
test.case $level "T-PLATFORM-DEFAULTS: oo.mode.base.get consumes OOSH_COMPONENTS_DIR" \
  echo "$baseBody"
if echo "$baseBody" | grep -qE 'OOSH_COMPONENTS_DIR'; then
  expect.pass "oo.mode.base.get reads OOSH_COMPONENTS_DIR"
else
  expect.fail "oo.mode.base.get must consume OOSH_COMPONENTS_DIR (not a hardcoded base)"
fi

test.case $level "T-PLATFORM-DEFAULTS: oo.mode.base.get has NO bare macOS literal fallback" \
  echo "check for /Users/Shared literal (excluding comments)"
# Ignore comment lines — the fixed body documents "never a hardcoded /Users/Shared".
if echo "$baseBody" | grep -vE '^[[:space:]]*#' | grep -qE '/Users/Shared'; then
  expect.fail "oo.mode.base.get still hardcodes /Users/Shared in code — breaks linux/container"
else
  expect.pass "oo.mode.base.get free of the macOS literal (code)"
fi

test.case $level "T-PLATFORM-DEFAULTS: odocker derives ODOCKER_WORKSPACES from OOSH_SHARED_BASE" \
  echo "grep odocker for ODOCKER_WORKSPACES derivation"
if grep -qE 'ODOCKER_WORKSPACES' "$ODOCKER" \
   && grep -qE 'OOSH_SHARED_BASE' "$ODOCKER"; then
  expect.pass "odocker ODOCKER_WORKSPACES derives from OOSH_SHARED_BASE"
else
  expect.fail "odocker must derive ODOCKER_WORKSPACES from OOSH_SHARED_BASE"
fi

test.case $level "T-PLATFORM-DEFAULTS: odocker has NO bare macOS workspaces literal" \
  echo "check odocker ODOCKER_WORKSPACES for /Users/Shared literal (excluding comments)"
odockLine=$(grep -nE 'ODOCKER_WORKSPACES' "$ODOCKER" | grep -vE '^[0-9]+:[[:space:]]*#' | grep -E '/Users/Shared')
if [ -n "$odockLine" ]; then
  expect.fail "odocker hardcodes macOS workspaces path in code: $odockLine"
else
  expect.pass "odocker ODOCKER_WORKSPACES free of the macOS literal (code)"
fi

# ============================================================================
# (5) FUNCTIONAL — the derived base is correct for THIS platform (via os), and
#     matches what the current OOSH_OS implies.
# ============================================================================
curOS=$(uname -s 2>/dev/null)
test.case $level "T-PLATFORM-DEFAULTS (live): derived base matches this platform" \
  echo "uname=$curOS OOSH_SHARED_BASE=${OOSH_SHARED_BASE:-<unset>}"
case "$curOS" in
  Darwin)
    if [ -z "$OOSH_SHARED_BASE" ] || echo "$OOSH_SHARED_BASE" | grep -qE '/Users/Shared'; then
      expect.pass "darwin base is /Users/Shared (or derived at init)"
    else
      expect.fail "darwin base should be /Users/Shared, got $OOSH_SHARED_BASE"
    fi ;;
  Linux)
    if [ -z "$OOSH_SHARED_BASE" ] || echo "$OOSH_SHARED_BASE" | grep -qE '/home/shared'; then
      expect.pass "linux base is /home/shared (or derived at init)"
    else
      expect.fail "linux base should be /home/shared, got $OOSH_SHARED_BASE"
    fi ;;
  *)
    expect.pass "platform $curOS — derivation present (base checked at source level above)" ;;
esac

test.suite.save.results
