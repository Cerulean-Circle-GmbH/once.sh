#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else 
  # remove the level parameter
  shift
fi

# platform (the platform tests) — moved out of test.os with the methods,
# 2026-10-22 (the boss: no private.this.script.load; os was loading odocker)

#echo "sourcing init"
source this
source test.suite

log.level $level
info.log "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

completionArray=(once config list file ite)
source oo

# ─────────────────────────────────────────────────────────────────────────────
# Test: private.platform.load populates PLATFORM_* vars
# ─────────────────────────────────────────────────────────────────────────────
source $OOSH_DIR/platform
private.platform.load
if [ -n "$PLATFORM_ubuntu_24_04" ]; then
  expect.pass "platform.load populates PLATFORM_ubuntu_24_04"
else
  expect.fail "platform.load did not populate PLATFORM_ubuntu_24_04"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: private.platform.names returns known platforms
# ─────────────────────────────────────────────────────────────────────────────
_NAMES=$(private.platform.names)
_FOUND_ALL=true
for _P in ubuntu_24_04 debian_12 almalinux_9 alpine_3_19 macos; do
  if ! echo "$_NAMES" | grep -q "$_P"; then
    expect.fail "platform.names missing: $_P"
    _FOUND_ALL=false
  fi
done
if [ "$_FOUND_ALL" = true ]; then
  expect.pass "platform.names includes all must-pass platforms"
fi
unset _NAMES _FOUND_ALL _P

# ─────────────────────────────────────────────────────────────────────────────
# Test: private.platform.parse extracts fields correctly
# ─────────────────────────────────────────────────────────────────────────────
private.platform.parse ubuntu_24_04
if [ "$PLATFORM_WORKSPACE" = "nakedUbuntu/24.04" ] && \
   [ "$PLATFORM_BASE_IMAGE" = "ubuntu:24.04" ] && \
   [ "$PLATFORM_PM" = "apt-get" ] && \
   [ "$PLATFORM_TIER" = "must-pass" ]; then
  expect.pass "parse ubuntu_24_04: all fields correct"
else
  expect.fail "parse ubuntu_24_04: ws=$PLATFORM_WORKSPACE img=$PLATFORM_BASE_IMAGE pm=$PLATFORM_PM tier=$PLATFORM_TIER"
fi

private.platform.parse alpine_3_19
if [ "$PLATFORM_WORKSPACE" = "nakedAlpine/3.19" ] && \
   [ "$PLATFORM_PM" = "apk" ] && \
   [ "$PLATFORM_TIER" = "must-pass" ]; then
  expect.pass "parse alpine_3_19: fields correct"
else
  expect.fail "parse alpine_3_19: ws=$PLATFORM_WORKSPACE pm=$PLATFORM_PM tier=$PLATFORM_TIER"
fi

private.platform.parse macos
if [ "$PLATFORM_WORKSPACE" = "native" ] && \
   [ "$PLATFORM_PM" = "brew" ] && \
   [ "$PLATFORM_TIER" = "must-pass" ]; then
  expect.pass "parse macos: fields correct"
else
  expect.fail "parse macos: ws=$PLATFORM_WORKSPACE pm=$PLATFORM_PM tier=$PLATFORM_TIER"
fi

private.platform.parse nonexistent_platform_xyz 2>/dev/null
if [ $? -eq 1 ]; then
  expect.pass "parse unknown platform returns error"
else
  expect.fail "parse unknown platform should return 1"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: private.platform.image.from.workspace matches odocker logic
# ─────────────────────────────────────────────────────────────────────────────
declare -A _WS_EXPECT=(
  ["nakedUbuntu/24.04"]="naked_ubuntu_24_04"
  ["nakedDebian/12"]="naked_debian_12"
  ["nakedAlma/9.sshd"]="naked_alma_9_sshd"
  ["nakedAlpine/3.19"]="naked_alpine_3_19"
)
for ws in "${!_WS_EXPECT[@]}"; do
  RESULT=$(private.platform.image.from.workspace "$ws")
  if [ "$RESULT" = "${_WS_EXPECT[$ws]}" ]; then
    expect.pass "image from workspace $ws → $RESULT"
  else
    expect.fail "image from workspace $ws: expected ${_WS_EXPECT[$ws]}, got: $RESULT"
  fi
done
unset _WS_EXPECT

# ─────────────────────────────────────────────────────────────────────────────
# Test: platform list runs without error
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "platform list runs" \
  platform list
if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "platform list exits 0"
else
  expect.fail "platform list exits $RETURN_VALUE (expected 0)"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: platform test without args returns error
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "platform test requires parameter" \
  platform test
if [ "$RETURN_VALUE" -eq 1 ]; then
  expect.pass "platform test without args exits 1"
else
  expect.fail "platform test without args exits $RETURN_VALUE (expected 1)"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: private.platform.test.ci function is defined
# ─────────────────────────────────────────────────────────────────────────────
if type private.platform.test.ci >/dev/null 2>&1; then
  expect.pass "private.platform.test.ci is defined"
else
  expect.fail "private.platform.test.ci should be defined"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: macos routes to CI (workspace=native), without triggering actual CI
# ─────────────────────────────────────────────────────────────────────────────
private.platform.parse macos
if [ "$PLATFORM_WORKSPACE" = "native" ]; then
  expect.pass "macos routes to CI (workspace=native, not Docker)"
else
  expect.fail "macos should have workspace=native, got: $PLATFORM_WORKSPACE"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: missing gh CLI triggers auto-install attempt
# ─────────────────────────────────────────────────────────────────────────────
_AUTO_OUTPUT=$(
  emptyDir=$(mktemp -d)
  PATH="$emptyDir"
  private.platform.test.ci macos 2>&1
  rmdir "$emptyDir" 2>/dev/null
)
if echo "$_AUTO_OUTPUT" | grep -q "oo: command not found"; then
  expect.pass "missing gh CLI triggers auto-install (oo cmd gh attempted)"
else
  expect.fail "missing gh CLI should trigger auto-install, got: $_AUTO_OUTPUT"
fi
unset _AUTO_OUTPUT

# ─────────────────────────────────────────────────────────────────────────────
# Test: completion function exists
# ─────────────────────────────────────────────────────────────────────────────
# either form c2 asks (T-SUITE-COMPLETION-EXISTS)
if test.suite.completion.exists platform test platform >/dev/null; then
  expect.pass "a completion for platform of platform test is defined"
else
  expect.fail "a completion for platform of platform test should be defined"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: terminal completion function exists
# ─────────────────────────────────────────────────────────────────────────────
# either form c2 asks (T-SUITE-COMPLETION-EXISTS)
if test.suite.completion.exists platform test terminal >/dev/null; then
  expect.pass "a completion for terminal of platform test is defined"
else
  expect.fail "a completion for terminal of platform test should be defined"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: terminal completion returns "terminal"
# ─────────────────────────────────────────────────────────────────────────────
_TERMINAL_COMP=$(test.suite.completion.get platform test terminal "")  # either form c2 asks (T-SUITE-COMPLETION-EXISTS)
if echo "$_TERMINAL_COMP" | grep -q "terminal"; then
  expect.pass "terminal completion suggests 'terminal'"
else
  expect.fail "terminal completion should suggest 'terminal', got: $_TERMINAL_COMP"
fi
unset _TERMINAL_COMP

# ─────────────────────────────────────────────────────────────────────────────
# Test: platform.test signature includes terminal parameter
# ─────────────────────────────────────────────────────────────────────────────
_SIG=$(grep "^platform.test()" "$OOSH_DIR/platform" 2>/dev/null)
if echo "$_SIG" | grep -q "terminal"; then
  expect.pass "platform.test signature includes terminal parameter"
else
  expect.fail "platform.test signature should include terminal parameter"
fi
unset _SIG

# T-PLATFORM-PARSE-CHECK: platform parse.check — bash -n of every tracked shell file with the bash of a platform image
# test.oo did not even load on almalinux_9 (bash 5.1: a case pattern without
# its "(" inside $( ( … ) )), only Ubuntu's and macOS's bash 5.2 had read it —
# found by a promotion's platform test (2026-10-14). The check runs on this
# host in the platform's image; here odocker.image.command runs the command
# locally, the logic is what is tested. A tree: a good script, one that does
# not parse, a file that is no script.
test.platform.parseCheck() {
  local fx bad="" got; fx=$(test.suite.fixture.make platformparsecheck); mkdir -p "$fx/tree/test"
  printf '%s\n' '#!/usr/bin/env bash' 'echo ok' > "$fx/tree/good"
  printf '%s\n' '#!/bin/bash' 'if then' > "$fx/tree/test/test.bad"
  printf '%s\n' '# notes' 'if then' > "$fx/tree/notes.md"
  git -C "$fx/tree" init -q; git -C "$fx/tree" add -A
  test.platform.parseCheck.run() { # <platform>
    : > "$fx/log"
    ( FX="$fx"
      odocker.image.command() { echo "image $1" >> "$FX/log"; sh -c "$2"; }
      private.platform.image.exists() { [ "$1" = naked_alma_9_sshd ]; }
      platform.parse.check "$1" "$fx/tree" >/dev/null 2>&1; echo "$?|$RESULT" )
  }
  got=$(test.platform.parseCheck.run almalinux_9)
  case "$got" in "1|1 of 2 shell files do not parse with "*": test/test.bad") ;; *) bad="$bad bad-tree=[$got]" ;; esac
  grep -q "^image naked_alma_9_sshd$" "$fx/log" || bad="$bad image=[$(cat "$fx/log")]"
  rm "$fx/tree/test/test.bad"; git -C "$fx/tree" add -A
  got=$(test.platform.parseCheck.run almalinux_9)
  case "$got" in "0|1 shell files parse with "*) ;; *) bad="$bad good-tree=[$got]" ;; esac
  got=$(test.platform.parseCheck.run debian_12)
  case "$got" in "1|"*"no image naked_debian_12"*) ;; *) bad="$bad no-image=[$got]" ;; esac
  got=$(test.platform.parseCheck.run macos)
  case "$got" in "1|"*"native"*) ;; *) bad="$bad native=[$got]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the shell files of a tree parsed with the bash of a platform image; the ones that do not are named" || create.result 1 "parse check:$bad"
  return $(result)
}
test.case $level "T-PLATFORM-PARSE-CHECK: bash -n of every tracked shell file with the bash of a platform image" test.platform.parseCheck
expect 0 "the shell files of a tree parsed with the bash of a platform image; the ones that do not are named" \
  "test.oo did not load on almalinux_9 (bash 5.1) — only a promotion's platform test found it"


# T-PLATFORM-TEST-USES-CONTAINER-BLOCKS: platform test and odocker container.oosh.install share one chain
# The Host, the first login with sshpass, the sudo rule and the sshd re-exec
# were written out in platform test; odocker container.oosh.install needs
# the same steps. Both use the private.odocker.container.* building blocks —
# platform keeps no sshpass line of its own.
test.platform.testUsesContainerBlocks() {
  local body bad="" b
  body=$(declare -f platform.test)
  for b in private.odocker.container.ssh.config private.odocker.container.ssh.master \
           private.odocker.container.sudo.nopasswd private.odocker.container.sshd.reload; do
    case "$body" in *"$b"*) ;; *) bad="$bad missing:$b" ;; esac
  done
  case "$body" in *"sshpass -e"*) bad="$bad ownSshpass" ;; esac
  [ -z "$bad" ] && create.result 0 "one chain, in odocker" || create.result 1 "platform.test:$bad"
  return $(result)
}
test.case $level "T-PLATFORM-TEST-USES-CONTAINER-BLOCKS: platform test uses odocker's container building blocks" test.platform.testUsesContainerBlocks
expect 0 "one chain, in odocker" "the container chain was written twice, in platform (then os) and in odocker"

### test.method

test.suite.save.results

