#!/usr/bin/env bash
# T-SWIPE-PARITY — THE gate for scrumMaster.swipe (plan validated-dazzling-kitten.md, Tron-approved).
# swipe is a pure-bash, hiveMind-FREE drop-in for the (deprecated-but-kept) pulse. pulse = the ORACLE.
# RED-FIRST: scrumMaster.swipe does not exist yet → every arm fails on the deployed surface.
#
# CONTRACT: `scrumMaster swipe $T` and `scrumMaster pulse $T` on the SAME session must be
# BYTE-IDENTICAL after masking ONLY the ctx field — TEAM header, row idx/role, STATE token+color,
# sh:N, and layout identical; the ctx token may differ ONLY in its numeric value (live-read jitter,
# Δ<1) and must keep the SAME ctx TYPE (tuple vs ?ctx-lag vs ?ctx-no-jsonl).
# Also: DEPENDENCY-FREE — the swipe methods must contain ZERO 'hiveMind' references.

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-FIRST — scrumMaster.swipe absent must fail)"
source this
source test.suite
log.level $level
export LOG_DEVICE=/dev/null
ESC=$'\033'
T="${SWIPE_TEST_TEAM:-ooshTeam}"

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

GEN="${OOSH_DIR}/test/gen/t-swipe-parity"; rm -rf "$GEN"; mkdir -p "$GEN"
PF="$GEN/pulse.out"; SF="$GEN/swipe.out"

# Capture the oracle (pulse) and the candidate (swipe) back-to-back on the SAME session.
scrumMaster pulse "$T" 2>/dev/null > "$PF"
scrumMaster swipe "$T" 2>/dev/null > "$SF"

# Mask ONLY the ctx field: the trailing token after `sh:N{RST} ` on an agent row → a TYPE-tag that
# preserves tuple-vs-sentinel (a type mismatch must still fail) but drops the numeric+its color/mark.
mask_ctx(){ sed -E \
    -e "s/(sh:[0-9]+${ESC}\[0m )${ESC}\[(9[0-9]|3[0-9])m[^0-9]*[0-9]+% \([0-9]+k\/[0-9]+k\)${ESC}\[0m/\1<CTX:tuple>/" \
    -e "s/(sh:[0-9]+${ESC}\[0m )${ESC}\[90m\?ctx-lag\(reboot\)${ESC}\[0m/\1<CTX:lag>/" \
    -e "s/(sh:[0-9]+${ESC}\[0m )${ESC}\[90m\?ctx-no-jsonl${ESC}\[0m/\1<CTX:none>/" ; }

echo; echo "===== swipe exists? (RED-first precond) ====="
SWIPE_DEF=$(type -t scrumMaster.swipe 2>/dev/null || (source scrumMaster >/dev/null 2>&1; type -t scrumMaster.swipe 2>/dev/null))
test.case $level "swipe method is defined" echo "${SWIPE_DEF:-ABSENT}"
[ "$SWIPE_DEF" = function ] && ok "scrumMaster.swipe defined" || no "scrumMaster.swipe ABSENT (RED-first — not yet implemented)"

echo; echo "===== (1) PARITY-STRUCT: masked pulse == masked swipe (format/colors/state/layout byte-identical) ====="
mask_ctx < "$PF" > "$GEN/pulse.masked"; mask_ctx < "$SF" > "$GEN/swipe.masked"
test.case $level "PARITY-STRUCT: swipe byte-identical to pulse (ctx-field masked)" echo "diff"
if [ -s "$SF" ] && diff -q "$GEN/pulse.masked" "$GEN/swipe.masked" >/dev/null 2>&1; then
  ok "swipe == pulse after masking the ctx field (TEAM header/idx/role/state+color/sh:N/layout identical)"
else
  no "NOT byte-identical (RED): swipe output empty or differs from pulse — $(diff "$GEN/pulse.masked" "$GEN/swipe.masked" 2>&1 | head -3 | tr '\n' '~')"
fi

echo; echo "===== (2) PARITY-CTX-TYPE: per-agent ctx TYPE (tuple/lag/none) matches ====="
# ctx type per agent idx: tuple if it has 'k/..k)', lag if '?ctx-lag', none if '?ctx-no-jsonl'.
ctx_type(){ local line="$1"; case "$line" in *'?ctx-lag'*) echo lag;; *'?ctx-no-jsonl'*) echo none;; *'k/'*'k)'*) echo tuple;; *) echo -;; esac; }
TYPE_OK=1; TYPE_MISS=""
while IFS= read -r prow; do
  idx=$(printf '%s' "$prow" | sed -E "s/^  ([0-9]+\.[0-9]+) .*/\1/"); [ "$idx" = "$prow" ] && continue
  case "$prow" in *'sh:'*) ;; *) continue ;; esac   # agent rows only
  srow=$(grep -E "^  ${idx//./\\.} " "$SF" 2>/dev/null | head -1)
  pt=$(ctx_type "$prow"); st=$(ctx_type "$srow")
  [ "$pt" != "$st" ] && { TYPE_OK=0; TYPE_MISS="$TYPE_MISS ${idx}[pulse=$pt swipe=$st]"; }
done < "$PF"
test.case $level "PARITY-CTX-TYPE: ctx token TYPE identical per agent" echo "${TYPE_MISS:-match}"
{ [ -s "$SF" ] && [ "$TYPE_OK" = 1 ]; } && ok "ctx type matches every agent row" || no "ctx TYPE mismatch (RED):${TYPE_MISS:-<no swipe rows>}"

echo; echo "===== (3) PARITY-CTX-DELTA: per-agent tuple pct within Δ<1 (live-read jitter) ====="
DELTA_OK=1; DELTA_BAD=""
while IFS= read -r prow; do
  case "$prow" in *'k/'*'k)'*) ;; *) continue ;; esac
  idx=$(printf '%s' "$prow" | sed -E "s/^  ([0-9]+\.[0-9]+) .*/\1/")
  srow=$(grep -E "^  ${idx//./\\.} " "$SF" 2>/dev/null | head -1)
  pp=$(printf '%s' "$prow" | sed -E "s/.* ([0-9]+)% \(.*/\1/"); sp=$(printf '%s' "$srow" | sed -E "s/.* ([0-9]+)% \(.*/\1/")
  [ -z "$sp" ] && { DELTA_OK=0; DELTA_BAD="$DELTA_BAD ${idx}[no-swipe]"; continue; }
  d=$(( pp>sp ? pp-sp : sp-pp )); [ "$d" -ge 1 ] && { DELTA_OK=0; DELTA_BAD="$DELTA_BAD ${idx}[Δ=$d pulse=$pp swipe=$sp]"; }
done < "$PF"
test.case $level "PARITY-CTX-DELTA: tuple pct Δ<1 per agent" echo "${DELTA_BAD:-ok}"
{ [ -s "$SF" ] && [ "$DELTA_OK" = 1 ]; } && ok "every tuple pct within Δ<1" || no "ctx pct Δ≥1 or no swipe (RED):${DELTA_BAD:-<no swipe>}"

echo; echo "===== (4) DEP-FREE: swipe methods contain ZERO hiveMind references ====="
SWIPE_BODY=$(sed -n '/^\(private\.\)\?scrumMaster\.swipe/,/^}/p' /root/oosh/scrumMaster 2>/dev/null)
HM=$(printf '%s\n' "$SWIPE_BODY" | grep -c 'hiveMind')
test.case $level "DEP-FREE: swipe exists AND 0 hiveMind refs" echo "swipe-lines=$(printf '%s\n' "$SWIPE_BODY" | grep -c .) hiveMind=$HM"
{ [ -n "$SWIPE_BODY" ] && [ "$HM" -eq 0 ]; } && ok "swipe present + hiveMind-free (0 refs)" \
  || no "RED: swipe absent (no methods to grep) OR has $HM hiveMind refs — dependency-free unproven"

echo
echo "=================================================================="
echo "  T-SWIPE-PARITY  PASS=$pass FAIL=$fail"
echo "  RED-FIRST: all arms FAIL until scrumMaster.swipe exists byte-identical-to-pulse + hiveMind-free."
echo "=================================================================="
rm -rf "$GEN"
test.suite.save.results
