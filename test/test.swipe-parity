#!/usr/bin/env bash
# T-SWIPE-PARITY — THE gate for scrumMaster.swipe (plan validated-dazzling-kitten.md, Tron-approved).
# swipe = pure-bash, hiveMind-FREE drop-in for the (deprecated-but-kept) pulse. pulse = the ORACLE.
# RED-FIRST: scrumMaster.swipe absent → every arm fails on the deployed surface.
#
# WHY A FROZEN FIXTURE SESSION (not the live fleet): two SEQUENTIAL snapshots of a LIVE session race
# both STATE (an agent flips active↔idle between the pulse run and the swipe run) and ctx (live-read
# jitter) — a live-target parity gate is non-deterministic. A controlled, FROZEN fixture session makes
# pulse and swipe read byte-IDENTICAL inputs (stand-in panes with a fixed chrome + a STATIC seeded
# jsonl), so the comparison is exact with ZERO tolerance, AND the test pane is NOT in the fixture
# session → the self-pane sh:N observer-effect (expert d48f45d0) cannot arise. pulse==swipe or RED.
# Also: DEPENDENCY-FREE — the swipe methods must contain ZERO hiveMind INVOCATIONS (roles.env data-read ok).

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-FIRST — scrumMaster.swipe absent must fail)"
source this
source test.suite
log.level $level
export LOG_DEVICE=/dev/null

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

FX_PREFIX="fxswpp_"; FIX="${FX_PREFIX}fix"
GEN="${OOSH_DIR}/test/gen/t-swipe-parity"; SEED="$HOME/.claude/projects/-test-seed-swipeparity"
PUUID="eeeeeeee-5555-4555-8555-eeeeeeeeeeee"; PTITLE="prole@WODA.prod"
sweep(){ tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" \
           | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; rm -rf "$GEN" "$SEED"; }
trap sweep EXIT
sweep

if [ -z "$TMUX" ]; then
  test.case $level "T-SWIPE-PARITY (skipped — no tmux)" echo skip; expect.pass "skipped"
  test.suite.save.results; return 0 2>/dev/null || exit 0
fi
mkdir -p "$GEN/bin" "$GEN/cwd" "$SEED"; RC=$(cd "$GEN/cwd" && pwd -P)

# stand-in agent: renders a FIXED idle chrome (classify→IDLE, deterministic), then holds. Named 'claude'
# (subtree→kind=agent). Chrome must sit in the pane's BOTTOM lines → use a SHORT pane.
cat > "$GEN/bin/claude" <<'SH'
#!/bin/sh
printf '%s\n' '────────── prole@WODA.prod ──' '❯ ' '──────────' '  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents'
while :; do sleep 86400; done
SH
chmod +x "$GEN/bin/claude"
# STATIC seeded jsonl → stable ctx tuple (non-lagging): usage ~650k of 1M, assistant-usage is last line.
printf '{"cwd":"%s","type":"x"}\n{"type":"assistant","customTitle":"%s","message":{"usage":{"input_tokens":1,"cache_creation_input_tokens":1,"cache_read_input_tokens":649998}}}\n' "$RC" "$PTITLE" > "$SEED/$PUUID.jsonl"

# FROZEN fixture session: pane 0.0 = stand-in agent, pane 0.1 = a plain shell (covers the shell row).
tmux new-session  -d -s "$FIX" -x 120 -y 8 -c "$RC" 2>/dev/null
tmux split-window -t "$FIX" -v -l 3 -c "$RC" 2>/dev/null       # pane 0.1 = bash shell
tmux select-pane  -t "${FIX}:0.0" -T "$PTITLE" 2>/dev/null
tmux send-keys    -t "${FIX}:0.1" "PS1='oosh > '" Enter 2>/dev/null
tmux send-keys    -t "${FIX}:0.0" "'$GEN/bin/claude' --resume $PUUID --model x" Enter 2>/dev/null
sleep 1.6

PF="$GEN/pulse.out"; SF="$GEN/swipe.out"
scrumMaster pulse "$FIX" 2>/dev/null > "$PF"
scrumMaster swipe "$FIX" 2>/dev/null > "$SF"

echo; echo "===== swipe exists? (RED-first precond) ====="
SWIPE_DEF=$( (source scrumMaster >/dev/null 2>&1; type -t scrumMaster.swipe) 2>/dev/null)
test.case $level "swipe method is defined" echo "${SWIPE_DEF:-ABSENT}"
[ "$SWIPE_DEF" = function ] && ok "scrumMaster.swipe defined" || no "scrumMaster.swipe ABSENT (RED-first)"

echo; echo "===== (1) PARITY: swipe BYTE-IDENTICAL to pulse on the frozen fixture (no masking, no tolerance) ====="
echo "  pulse:"; cat -v "$PF" | sed 's/^/    /'
echo "  swipe:"; cat -v "$SF" | sed 's/^/    /'
test.case $level "PARITY: swipe output == pulse output byte-for-byte (format/colors/state/ctx/sh:N/layout)" echo "diff"
if [ -s "$SF" ] && diff -q "$PF" "$SF" >/dev/null 2>&1; then
  ok "swipe == pulse BYTE-IDENTICAL on the frozen fixture"
else
  no "NOT byte-identical (RED): swipe empty or differs — $(diff "$PF" "$SF" 2>&1 | head -4 | tr '\n' '~')"
fi

echo; echo "===== (2) the fixture actually exercised an AGENT row with a ctx TUPLE (gate is meaningful) ====="
test.case $level "fixture sanity: pulse rendered an agent row with a ctx tuple + a shell row" echo "check"
{ grep -qE '^  0\.0 .*k/[0-9]+k\)' "$PF" && grep -qE '^  0\.1 .*shell' "$PF"; } \
  && ok "fixture exercised agent(ctx tuple)+shell rows (parity is non-vacuous)" || no "fixture did not render the expected rows: $(head -3 "$PF" | tr '\n' '~')"

echo; echo "===== (3) DEP-FREE: swipe methods contain ZERO hiveMind INVOCATIONS (roles.env data-read allowed) ====="
# Read the scrumMaster ACTUALLY under test (on PATH) — NOT $OOSH_DIR/scrumMaster: `source this`
# re-anchors OOSH_DIR to the test file's own repo (deployed), which reads 0 swipe methods on a branch.
SM_UNDER_TEST=$(command -v scrumMaster 2>/dev/null)
SWIPE_BODY=$(sed -n '/^\(private\.\)\?scrumMaster\.swipe/,/^}/p' "$SM_UNDER_TEST" 2>/dev/null)
# Count hiveMind used as a COMMAND/method call (invocation position); comments stripped; a
# roles.env/sessions.env DATA read or `grep hiveMind <file>` is NOT an invocation.
HM=$(printf '%s\n' "$SWIPE_BODY" | sed 's/#.*//' | grep -cE '(^|[;|&]|\$\()[[:space:]]*hiveMind([[:space:].]|$)')
test.case $level "DEP-FREE: swipe exists AND 0 hiveMind invocations" echo "swipe-lines=$(printf '%s\n' "$SWIPE_BODY" | grep -c .) hiveMind-invocations=$HM (read $SM_UNDER_TEST)"
{ [ -n "$SWIPE_BODY" ] && [ "$HM" -eq 0 ]; } && ok "swipe present + ZERO hiveMind invocations (survives a broken hiveMind)" \
  || no "RED: swipe absent OR $HM hiveMind invocation(s) — dependency-free unproven"

echo
echo "=================================================================="
echo "  T-SWIPE-PARITY  PASS=$pass FAIL=$fail"
echo "  RED-FIRST until swipe exists byte-identical-to-pulse (frozen fixture) + hiveMind-free."
echo "=================================================================="
sweep
test.suite.save.results
