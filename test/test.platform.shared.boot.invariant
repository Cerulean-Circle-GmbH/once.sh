#!/usr/bin/env bash
# ============================================================================
# Platform invariant: the empty shell — `env -i sh`, then `bash` or `this`.
#
# The boot sequence (the boss's diagram, 2026-10-02): env -i sh → bash | this
# → this → log → debug → config → every other oosh command. An empty
# environment has no HOME and only the system PATH; it must come up as an
# oosh shell either way, on Linux and macOS, for every installed user:
#   bash  — ~/.bashrc hands an old bash (macOS /bin/bash 3.2) over to
#           BASH_FILE, then loads `this` first, which derives HOME
#   this  — /usr/local/bin/this (templates/user/thisLauncher) starts the
#           caller's own ~/oosh/this; started, `this` writes only the user's
#           own user.session.env, never the shared env files
# Commands go in through stdin, not -c: the macOS handover execs a new bash,
# and a -c command would not survive it.
# Invoke: ./test.suite run platform.shared.boot.invariant 1
# ============================================================================

TEST_CATEGORY=platform

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ----------------------------------------------------------------------------
# INVARIANT-0 (precondition): ~/oosh/this exists — everything below starts it.
# ----------------------------------------------------------------------------
artefact="$HOME/oosh/this"

test.case $level "platform.shared.boot: precondition — $artefact exists" \
  test -e "$artefact"
if [ ! -e "$artefact" ]; then
  expect.fail "$artefact does not exist — run \`ossh install <host>\` first"
  test.suite.save.results
  return 0 2>/dev/null || exit 0
else
  expect.pass "$artefact present"
fi
# The interactive shells below run ~/.bashrc, whose log.session.save writes LOG_NAME and LOG_LIVE
# into the user's own session file: the invariant leaves the home as it found it — the heal's verify
# runs this file, and the compare of os platform.heal.test found those lines on the healed side only
# (P6 round 1). The file is kept here and put back (content, owner and mode) before the results.
sessionLog="$HOME/.config/oosh/log.session.env" sessionKeep=""
if [ -f "$sessionLog" ]; then sessionKeep="$(private.this.temp.dir.get boot.invariant)" && cp -p "$sessionLog" "$sessionKeep/log.session.env"; fi
boot.invariant.session.restore() { # # put the session file of this user back as it was before the probes
  if [ -n "$sessionKeep" ] && [ -f "$sessionKeep/log.session.env" ]; then
    cat "$sessionKeep/log.session.env" > "$sessionLog"; rm -rf "$sessionKeep"
  elif [ -z "$sessionKeep" ]; then
    rm -f "$sessionLog"
  fi
}
sharedSum() { cat "$HOME/config/user.env" "$HOME/config/oosh.env" "$HOME/config/log.env" 2>/dev/null | cksum; }
probe='printf "\nRESULT %s|%s|%s|%s\n" "$HOME" "$CONFIG" "${PATH%%:*}" "$(type -t log.level)"'
want="$HOME|$HOME/config/user.env|$HOME/oosh|function"

# ----------------------------------------------------------------------------
# INVARIANT-1: `env -i sh`, then `bash` — no HOME, and an oosh shell anyway.
# ----------------------------------------------------------------------------
got=$(cd / && printf '%s\nexit\n' "$probe" | env -i bash -i 2>/dev/null | sed -n 's/^RESULT //p')
test.case $level "platform.shared.boot: an empty shell's bash is an oosh shell" true
if [ "$got" = "$want" ]; then
  expect.pass "env -i bash: $got"
else
  expect.fail "env -i bash (want [$want]) got [$got] — run \`oo user.fix\` (it re-installs the .bashrc)"
fi

# ----------------------------------------------------------------------------
# INVARIANT-2: the launcher is on the system PATH and up to date.
# ----------------------------------------------------------------------------
test.case $level "platform.shared.boot: /usr/local/bin/this is the launcher" true
if cmp -s "$HOME/oosh/templates/user/thisLauncher" /usr/local/bin/this && [ -x /usr/local/bin/this ]; then
  expect.pass "/usr/local/bin/this matches templates/user/thisLauncher"
else
  expect.fail "/usr/local/bin/this missing or old — run \`sudo oo update\`"
fi

# ----------------------------------------------------------------------------
# INVARIANT-3: `env -i sh`, then `this` — a method returns; plain `this`
# enters an oosh shell; neither rewrites the shared env files.
# ----------------------------------------------------------------------------
before=$(sharedSum)
methodOut=$(cd / && env -i sh -c 'this anchor.validate' </dev/null 2>/dev/null); methodRc=$?
enterGot=$(cd / && printf '%s\nexit\n' "$probe" | env -i sh -c 'this' 2>/dev/null | sed -n 's/^RESULT //p')
after=$(sharedSum)
test.case $level "platform.shared.boot: an empty shell's this is an oosh shell" true
if [ "$methodRc" = 0 ] && printf '%s\n' "$methodOut" | grep -q '^OK:' && [ "$enterGot" = "$want" ] && [ "$before" = "$after" ]; then
  expect.pass "env -i sh -c this: a method returns, this enters ($enterGot), the shared files untouched"
else
  expect.fail "env -i sh -c this: method rc=$methodRc enter=[$enterGot] (want [$want]) shared-changed=$([ "$before" = "$after" ] && echo no || echo yes) — see invariant 2"
fi

# ----------------------------------------------------------------------------
# INVARIANT-4: a LOGIN shell without HOME — ~/oosh first on PATH.
# ----------------------------------------------------------------------------
loginFirst=$(cd / && printf 'printf "\\nRESULT %%s\\n" "${PATH%%%%:*}"\nexit\n' | env -i bash -l -i 2>/dev/null | sed -n 's/^RESULT //p')
test.case $level "platform.shared.boot: an empty login shell has ~/oosh first on PATH" true
if [ "$loginFirst" = "$HOME/oosh" ]; then
  expect.pass "env -i bash -l: PATH starts with $loginFirst"
else
  expect.fail "env -i bash -l: PATH starts with [$loginFirst] — a login file of this user (~/.bash_profile) must use ~/.bashrc, not \$HOME/.bashrc"
fi

# ----------------------------------------------------------------------------
# INVARIANT-5 (macOS): the empty shell's bash is 3.2; the .bashrc hands over.
# ----------------------------------------------------------------------------
if [ "$(uname -s)" = "Darwin" ]; then
  major=$(cd / && printf 'printf "\\nRESULT %%s\\n" "${BASH_VERSINFO[0]}"\nexit\n' | env -i bash -i 2>/dev/null | sed -n 's/^RESULT //p')
  test.case $level "platform.shared.boot: macOS — the empty shell ends in bash 4 or newer" true
  if [ -n "$major" ] && [ "$major" -ge 4 ]; then
    expect.pass "env -i bash on macOS continues in bash $major"
  else
    expect.fail "env -i bash on macOS stayed in bash [$major] — BASH_FILE in ~/config/user.env must name a brew bash"
  fi
fi

boot.invariant.session.restore
test.suite.save.results
