#!/usr/bin/env bash
# T-SWIPE-JSONL-LAG — RED-FIRST for swipe's BASH ctx helper + the ON-WALL-not-hidden invariant
# (plan validated-dazzling-kitten.md). Mirrors test.pulse-jsonl-lag but gates the pure-bash
# private.scrumMaster.swipe.ctx (python3 as JSON-helper ONLY), not pulse's embedded python.
# CONTRACT: private.scrumMaster.swipe.ctx <jsonl> <denomK> →
#   fresh (≤8 content after last assistant-usage) → tuple "used_k|pct|denom_k"
#   >8 content-window (user|attachment|tool_result|tool_use after last usage) → "lag" sentinel
#   no usage / no jsonl → none (empty/sentinel) ; the THREE states must be DISTINCT.
# And ON-WALL must NOT be hidden by a lagging ctx: a wall-chrome pane whose ctx reads 'lag' still
# classifies ON-WALL (red) with a ?ctx-lag ctx token. RED-FIRST: swipe helper/method absent.

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-FIRST — private.scrumMaster.swipe.ctx absent must fail)"
source this
source test.suite
source scrumMaster >/dev/null 2>&1   # bring in the (eventual) bash helper for direct drive
log.level $level
export LOG_DEVICE=/dev/null
ESC=$'\033'

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

FX_PREFIX="fxswlag_"
D="${OOSH_DIR}/test/gen/t-swipe-lag"; SEED_PROJ="$HOME/.claude/projects/-test-seed-swipelag"
sweep(){ tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" \
           | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; rm -rf "$D" "$SEED_PROJ"; }
trap sweep EXIT
sweep
mkdir -p "$D" "$SEED_PROJ"

USAGE='{"type":"assistant","message":{"usage":{"input_tokens":1,"cache_creation_input_tokens":1000,"cache_read_input_tokens":398999}}}'
# FRESH: assistant-usage is the last substantive line (≤8 content after) → tuple (~400k = 40% of 1M).
printf '%s\n' "$USAGE" > "$D/fresh.jsonl"
# LAG: >8 content entries (reboot types) AFTER the last assistant-usage → stale lower-bound → 'lag'.
{ printf '%s\n' "$USAGE"
  for i in $(seq 1 20); do printf '{"type":"attachment","content":"[read ctx %d]"}\n' "$i"; done
  for i in $(seq 1 20); do printf '{"type":"tool_use","name":"Read","input":{"f":"L%d"}}\n' "$i"; done; } > "$D/lag.jsonl"
# NONE: no assistant-usage → none (distinct from both).
printf '{"type":"user","message":{"role":"user","content":"no usage"}}\n' > "$D/none.jsonl"

echo; echo "===== swipe ctx helper exists? (RED-first precond) ====="
H=$(type -t private.scrumMaster.swipe.ctx 2>/dev/null)
test.case $level "private.scrumMaster.swipe.ctx defined" echo "${H:-ABSENT}"
[ "$H" = function ] && ok "swipe.ctx helper defined" || no "private.scrumMaster.swipe.ctx ABSENT (RED-first)"

CF=$(private.scrumMaster.swipe.ctx "$D/fresh.jsonl" 1000 2>/dev/null)
CL=$(private.scrumMaster.swipe.ctx "$D/lag.jsonl"   1000 2>/dev/null)
CN=$(private.scrumMaster.swipe.ctx "$D/none.jsonl"  1000 2>/dev/null)
echo "  fresh='$CF'  lag='$CL'  none='$CN'"

echo; echo "===== (A1) FRESH → numeric tuple used_k|pct|denom_k ====="
test.case $level "A1-FRESH: fresh jsonl → tuple" echo "$CF"
printf '%s' "$CF" | grep -qE '^[0-9]+\|[0-9]+\|[0-9]+$' && ok "fresh → tuple ($CF)" || no "fresh not a tuple (RED): '$CF'"

echo; echo "===== (A2) LAG → 'lag' sentinel (>8 content window), NOT a false-low number ====="
test.case $level "A2-LAG: >8-window jsonl → 'lag'" echo "$CL"
[ "$CL" = "lag" ] && ok "lag window → 'lag' sentinel (no false-low)" || no "lag not signaled (RED): '$CL' (false-low hides a wall)"

echo; echo "===== (A3) NONE → none, and THREE STATES DISTINCT ====="
test.case $level "A3-NONE: no-usage jsonl → none (not a tuple, not lag)" echo "$CN"
NONE_OK=1; { printf '%s' "$CN" | grep -qE '^[0-9]+\|'; } && NONE_OK=0; [ "$CN" = "lag" ] && NONE_OK=0
[ "$NONE_OK" = 1 ] && ok "none distinct ('$CN')" || no "none not distinct (RED): '$CN'"
test.case $level "A3-DISTINCT: fresh≠lag≠none all three distinct" echo "$CF|$CL|$CN"
{ [ "$CF" != "$CL" ] && [ "$CF" != "$CN" ] && [ "$CL" != "$CN" ]; } && ok "three states distinct" || no "states collide (RED): fresh='$CF' lag='$CL' none='$CN'"

echo; echo "===== (B) ON-WALL NOT hidden by a lagging ctx (signature-agnostic, swipe OUTPUT level) ====="
if [ -z "$TMUX" ]; then
  test.case $level "B ON-WALL-not-hidden (skipped — no tmux)" echo skip; expect.pass "skipped"
else
  WUUID="dddddddd-4444-4444-8444-dddddddddddd"; WTITLE="wallrole@WODA.prod"
  mkdir -p "$D/bin" "$D/cwd"; RC=$(cd "$D/cwd" && pwd -P)
  # stand-in RENDERS the wall chrome itself (its own stdout = the pane's last-6-line chrome that
  # classify reads), then holds — send-keys to a held foreground proc would be swallowed, not shown.
  cat > "$D/bin/claude" <<'SH'
#!/bin/sh
printf '\n  Context limit reached · run /compact or /clear to continue\n'
while :; do sleep 86400; done
SH
# NB: the chrome above matches classify's ON-WALL vocabulary ("context limit reached" /
# "compact or /clear to continue") — the HARD wall. The "Context low (N% remaining)" auto-compact
# WARNING is deliberately NOT ON-WALL in pulse(oracle):705 or swipe (parity); don't swap it in here.
  chmod +x "$D/bin/claude"
  # a LAGGING jsonl for this pane's resolved uuid (so swipe's ctx reads 'lag' for it)
  { printf '{"cwd":"%s","type":"x"}\n{"type":"assistant","customTitle":"%s","message":{"usage":{"input_tokens":1,"cache_creation_input_tokens":1,"cache_read_input_tokens":990000}}}\n' "$RC" "$WTITLE"
    for i in $(seq 1 20); do printf '{"type":"tool_use","name":"Read","input":{"f":"L%d"}}\n' "$i"; done; } > "$SEED_PROJ/$WUUID.jsonl"
  # SHORT pane so the stand-in's wall chrome lands in the bottom lines classify reads (not scrolled above).
  W="${FX_PREFIX}wall"; tmux new-session -d -s "$W" -x 150 -y 6 -c "$RC" 2>/dev/null
  tmux send-keys -t "$W" "'$D/bin/claude' --resume $WUUID --model x" Enter
  tmux select-pane -t "$W" -T "$WTITLE" 2>/dev/null; sleep 1.4
  ROW=$(scrumMaster swipe "$W" 2>/dev/null | grep -E '^  0\.0 ' | head -1)
  echo "  swipe row: $(printf '%s' "$ROW" | cat -v)"
  test.case $level "B-ON-WALL: wall-chrome pane shows ON-WALL (red 91m) despite lagging ctx" echo "$ROW"
  printf '%s' "$ROW" | grep -q "${ESC}\[91m" && ok "state = ON-WALL (not downgraded by the lagging ctx)" \
    || no "ON-WALL HIDDEN (RED): row lacks 91m state — a lagging ctx suppressed the wall (or swipe absent)"
  test.case $level "B-CTX-LAG: the same row's ctx token is ?ctx-lag (lag surfaced, not a false number)" echo "$ROW"
  printf '%s' "$ROW" | grep -q 'ctx-lag' && ok "ctx shows ?ctx-lag alongside ON-WALL" \
    || no "ctx not lag (RED): row ctx token is not ?ctx-lag (or swipe absent)"
fi

echo
echo "=================================================================="
echo "  T-SWIPE-JSONL-LAG  PASS=$pass FAIL=$fail"
echo "  RED-FIRST: swipe.ctx three-state + ON-WALL-not-hidden-by-lag fail until swipe is implemented."
echo "=================================================================="
sweep
test.suite.save.results
