#!/usr/bin/env bash
# T-NO-PYTHON — step-0 burn-down gate for design session/tasks/no-python-in-oosh.design.md (§3, §4, §6.0).
# LAW: OOSH ships no python. Count non-comment python CALLS ('python3', 'python -' (incl. -c/-m), '-m json.tool')
# across the TRACKED OOSH scripts + tests == 0. RED today by design; it is the burn-down instrument and prints
# the full per-site list. jq is ALLOWED (Tron ruling) and is not counted.
# EXEMPT (rulings 2026-10-28): opy (the python manager), osemvec (permanent opy exception — guarded by N3),
#   otest (until its node port), restore/ (until deleted). test.osemvec is NOT exempt (its json.tool -> awk).
# NOT a scope: docs/*.md, test/fixtures/** (static goldens are data), .github/, untracked test/gen/ scratch.
# Rule for "call": a line whose first non-blank char is not '#'. Trailing comments on a code line still count
# (conservative: a mention on a code line is flagged, never silently skipped).

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-first burn-down — every python call site is listed)"
# The tree under test = the tree THIS FILE lives in — resolved BEFORE 'source this': sourcing the kernel loads
# the real user.env, which re-exports OOSH_DIR=/root/oosh, so an OOSH_DIR-derived root silently scanned the
# DEPLOYED tree on a branch/differential run (caught: old T22 lines reported from a worktree with the new T22).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source this
source test.suite
log.level $level
export LOG_DEVICE=/dev/null

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

echo "  tree under test: $ROOT @ $(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null)"
EXEMPT_FILES="opy osemvec otest"          # top-level scripts
EXEMPT_DIRS="restore/"
PAT='python3|python[[:space:]]+-|-m[[:space:]]+json[.]tool'
SELF_REL="test/test.no-python"

# scanner: <file> -> "path:line:text" for every non-comment python call
scan(){ awk -v f="$2" -v pat="$PAT" '{ s=$0; sub(/^[[:space:]]+/, "", s); if (s ~ /^#/) next; if ($0 ~ pat) printf "%s:%d:%s\n", f, NR, $0 }' "$1"; }

echo; echo "===== N0 — instrument self-check: the scanner CAN fail (seeded call found, comment ignored) ====="
SEED="${TMPDIR:-/tmp}/t-no-python.seed.$$"
printf '%s\n' '#!/usr/bin/env bash' 'x=$(python3 -c "print(1)")' '  # python3 in a comment is not a call' 'y=$(echo "{}" | python -m json.tool)' 'z=$(cat f | python - <<EOF' > "$SEED"
SN=$(scan "$SEED" seed | grep -c .)
printf '%s\n' '#!/usr/bin/env bash' 'echo clean; jq -r .a f' > "$SEED.clean"
SC0=$(scan "$SEED.clean" clean | grep -c .)
rm -f "$SEED" "$SEED.clean"
test.case $level "N0 seeded file: 3 calls found, comment skipped; clean (jq) file: 0" echo "seed=$SN clean=$SC0"
{ [ "$SN" -eq 3 ] && [ "$SC0" -eq 0 ]; } && ok "scanner detects calls, ignores comments, allows jq" \
  || no "INSTRUMENT BROKEN: seed=$SN (want 3) clean=$SC0 (want 0) — no verdict below is trustworthy"
test.case $level "N0b scanned ROOT is the tree this test file lives in (not the OOSH_DIR from user.env)" echo "$ROOT"
[ "$ROOT/test/test.no-python" -ef "${BASH_SOURCE[0]}" ] && ok "ROOT = this file's tree ($ROOT)" \
  || no "INSTRUMENT CONFOUND: ROOT=$ROOT is not the tree of ${BASH_SOURCE[0]} — verdict would judge the wrong tree"

echo; echo "===== N1 — zero python calls across tracked OOSH scripts + tests (exemptions applied) ====="
FILES=$(cd "$ROOT" && git ls-files 2>/dev/null | grep -vE '\.md$|^docs/|^test/fixtures/|^\.github/|^test/gen/' )
LIST=""; NF=0
while IFS= read -r rel; do
  [ -z "$rel" ] && continue
  [ "$rel" = "$SELF_REL" ] && continue
  base="${rel%%/*}"; case " $EXEMPT_FILES " in *" $rel "*) continue;; esac
  for d in $EXEMPT_DIRS; do case "$rel" in "$d"*) continue 2;; esac; done
  f="$ROOT/$rel"; [ -f "$f" ] || continue
  # text files only (skip binaries)
  grep -qI . "$f" 2>/dev/null || continue
  NF=$((NF+1))
  hits=$(scan "$f" "$rel")
  [ -n "$hits" ] && LIST="${LIST}${hits}"$'\n'
done <<< "$FILES"
NHIT=$(printf '%s' "$LIST" | grep -c .)
NSITEFILES=$(printf '%s' "$LIST" | grep . | cut -d: -f1 | sort -u | grep -c .)
echo "  scanned $NF tracked text files; python call lines = $NHIT in $NSITEFILES file(s)"
if [ "$NHIT" -gt 0 ]; then
  echo "  --- burn-down (per file) ---"
  printf '%s' "$LIST" | grep . | cut -d: -f1 | sort | uniq -c | sort -rn | sed 's/^/    /'
  echo "  --- sites ---"
  printf '%s' "$LIST" | grep . | cut -c1-170 | sed 's/^/    /'
fi
test.case $level "N1 python call lines in non-exempt OOSH scripts+tests == 0" echo "$NHIT in $NSITEFILES files"
[ "$NHIT" -eq 0 ] && ok "OOSH is python-free (exemptions: $EXEMPT_FILES $EXEMPT_DIRS)" \
  || no "RED: $NHIT python call line(s) in $NSITEFILES file(s) — burn-down list above"

echo; echo "===== N2 — exemptions are REAL (a missing exempt file means the scope silently shrank) ====="
MISS=""; for e in $EXEMPT_FILES; do [ -f "$ROOT/$e" ] || MISS="$MISS $e"; done
RESTORE=$([ -d "$ROOT/restore" ] && echo present || echo deleted)
test.case $level "N2 exempt scripts exist (opy osemvec otest); restore/ status disclosed" echo "missing=${MISS:-none} restore=$RESTORE"
[ -z "$MISS" ] && ok "exempt set present; restore/ $RESTORE" || no "exempt file(s) missing:$MISS — re-check the exemption list"

echo; echo "===== N3 — osemvec guard: every interpreter resolves under OPY_VENVS, no bare python call ====="
OS="$ROOT/osemvec"
if [ -f "$OS" ]; then
  BARE=$(awk '{ s=$0; sub(/^[[:space:]]+/, "", s); if (s ~ /^#/) next;
               if ($0 ~ /(^|[;&|(]|\$\(|[[:space:]]exec[[:space:]]|^[[:space:]]*)python3?[[:space:]]/) printf "%d:%s\n", NR, $0 }' "$OS")
  NB=$(printf '%s' "$BARE" | grep -c .)
  VP=$(sed -n '/^private\.osemvec\.venvPython()/,/^}/p' "$OS")
  VPOK=0; echo "$VP" | grep -q 'OPY_VENVS' && echo "$VP" | grep -q 'bin/python' && VPOK=1
  test.case $level "N3 osemvec: 0 bare python/python3 calls AND venvPython resolves under OPY_VENVS" echo "bare=$NB venvPython-under-OPY_VENVS=$VPOK"
  { [ "$NB" -eq 0 ] && [ "$VPOK" -eq 1 ]; } && ok "osemvec complies (opy-managed interpreter only)" \
    || no "RED: osemvec bare calls=$NB [$(printf '%s' "$BARE" | head -2 | tr '\n' '~')] venvPython-under-OPY_VENVS=$VPOK"
else
  test.case $level "N3 osemvec guard" echo "absent"; no "osemvec absent — exemption list stale"
fi

echo; echo "===== N4 — test.osemvec is NOT exempt (its json.tool checks must be ported) ====="
TOS=$(printf '%s' "$LIST" | grep -c '^test/test.osemvec:')
test.case $level "N4 test.osemvec counted by N1 (not exempt): python lines = $TOS" echo "$TOS"
[ "$TOS" -eq 0 ] && ok "test.osemvec python-free" || no "RED: test.osemvec still has $TOS python line(s) (ruling: port json.tool -> awk structural check)"

echo
echo "=================================================================="
echo "  T-NO-PYTHON  PASS=$pass FAIL=$fail   (RED until the burn-down reaches 0)"
echo "=================================================================="
test.suite.save.results
