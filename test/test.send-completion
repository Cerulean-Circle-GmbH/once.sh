#!/usr/bin/env bash
# T-SEND-COMPLETION — a NON-INTERACTIVE, repeatable QA proof for the `otmux send`
# c2 completion gate (Tron: scalability over eyeball). Invokes the SAME entry the
# interactive `_oo_completion` wrapper calls — `ng/c2 completion.discover
# <COMP_CWORD> <cur> <words…> -` — and asserts + CAPTURES the output.
#
#   (1) returns PANE TARGETS (a75753d): completion.result.txt lists CURRENT +
#       directionals (U/D/L/R) + every live session:address pane.
#   (2) [S] the current-param display fixes are IN ng/c2: the #40 RED-1
#       declare-only filter (2484ffc — keeps current.method.env sourceable so the
#       <param>/CYAN display isn't blanked) + the RED-2 position-cyan highlight
#       (25081bd — colours the parc-th <…> token CYAN by position).
#   The captured completion.result.txt is attached as the proof artifact.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

C2="$OOSH_DIR/ng/c2"
RESULT="${CONFIG_PATH:-$HOME/config}/completion.result.txt"

# ── Invoke the completion exactly as _oo_completion does for `otmux send <TAB>`:
# COMP_CWORD=2 (target position), cur=-- (empty), words-to-cursor + trailing -.
"$C2" completion.discover 2 "--" otmux send - >/dev/null 2>&1

# ============================================================================
# SC-PANE-TARGETS [B] — completion returns the pane-target set (a75753d).
# ============================================================================
RES=$(cat "$RESULT" 2>/dev/null)
HAS_CURRENT=$(printf '%s\n' "$RES" | grep -cxE 'CURRENT')
HAS_DIR=$(printf '%s\n' "$RES" | grep -cxE '[UDLR]')
HAS_PANES=$(printf '%s\n' "$RES" | grep -cE '^[A-Za-z_][A-Za-z0-9_.-]*:[0-9]+\.[0-9]+$')
test.case $level "SC-PANE-TARGETS: 'otmux send' completion returns pane targets" \
  echo "current=$HAS_CURRENT directionals=$HAS_DIR sessionPanes=$HAS_PANES"
if [ "${HAS_CURRENT:-0}" -ge 1 ] && [ "${HAS_DIR:-0}" -ge 4 ] && [ "${HAS_PANES:-0}" -ge 1 ]; then
  expect.pass "returns CURRENT + $HAS_DIR directionals + $HAS_PANES session:address panes"
else
  expect.fail "pane targets missing: current=$HAS_CURRENT dir=$HAS_DIR panes=$HAS_PANES"
fi

# ── CAPTURE the proof artifact (first lines of the target set). ──────────────
echo "── PROOF: completion.result.txt (otmux send <target>) ──"
printf '%s\n' "$RES" | head -20 | sed 's/^/    /'
echo "── ($HAS_PANES session:address panes total) ──"

# ============================================================================
# SC-CYAN-FIX-SRC [S] — the current-param display fixes are present in ng/c2:
# RED-1 declare-only filter (2484ffc) + RED-2 position-cyan highlight (25081bd).
# ============================================================================
RED1=$(grep -cE "grep '\^declare '" "$C2")
# position-cyan: colours the parc-th <…> token CYAN by position (_pi -eq parc).
RED2=$(grep -cE '_pi.*-eq.*parc|parc.*_pi' "$C2")
CYAN_ON_PARAM=$(grep -cE '\$\{?CYAN\}?.*_tok|CYAN.*tok' "$C2")
test.case $level "SC-CYAN-FIX-SRC: ng/c2 has RED-1 declare-filter + RED-2 position-cyan" \
  echo "red1DeclareFilter=$RED1 red2PositionCyan=$RED2 cyanOnToken=$CYAN_ON_PARAM"
if [ "${RED1:-0}" -ge 1 ] && [ "${RED2:-0}" -ge 1 ] && [ "${CYAN_ON_PARAM:-0}" -ge 1 ]; then
  expect.pass "RED-1 declare-only filter + RED-2 position-based CYAN current-param present in ng/c2"
else
  expect.fail "fixes missing: red1=$RED1 red2=$RED2 cyanOnToken=$CYAN_ON_PARAM"
fi

echo ""
echo "=== T-SEND-COMPLETION complete ==="
echo ""

test.suite.save.results
