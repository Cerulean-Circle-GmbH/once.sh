#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

level=$1
if [ -z "$level" ]; then
  level=1
else 
  # remove the level parameter
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

#echo "sourcing init"
source this
source test.suite

log.level $level

# competionArray=(once config list file ite)
# source oo

test.case.color() # <colorENV> <colorNAME> # color envitrionment variable and color display name
{
((TEST_COUNTER++))

local color=$1 
local colorName=$2 

echo -e "


Test $TEST_COUNTER: color \"$*\"
===================================================================="


# colors.start "$@"
echo -e "This should be ${!color}${colorName} ${NORMAL}and ${BOLD}${!color}bold ${colorName} ${NORMAL}and back to normal"


echo -e  "====================================================================
RETURN: $RETURN_VALUE  Result: $RESULT 
===================================================================="
}

test.case.colors() 
{
((TEST_COUNTER++))

local color=$1 
local colorName=$2 

echo -e "


Test 0: colors \"$*\"
===================================================================="


# colors.start "$@"
echo -e "This should be ${RED}red ${NORMAL}and ${BOLD_RED}bold ${BOLD}${RED}red${NORMAL} and back to normal"
echo -e "This should be ${GREEN}green ${NORMAL}and ${BOLD_GREEN}bold ${BOLD}${GREEN}green${NORMAL} and back to normal"


echo -e  "====================================================================
RETURN: $RETURN_VALUE  Result: $RESULT 
===================================================================="
}

# test.case - "colors test start" \
#   colors $*
# expect 0 "*" "Test start"

# source colors
test.case - "colors test start" \
  test.case.colors

test.case.color RED red
test.case.color GREEN green
test.case.color BLUE blue
test.case.color YELLOW yellow
test.case.color GRAY gray
test.case.color GREY grey
test.case.color CYAN cyan
test.case.color WHITE white

