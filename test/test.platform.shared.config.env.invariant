#!/usr/bin/env bash
TEST_CATEGORY=platform

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# platform.shared.config.env.invariant — the CONTENT of the generated env
# files, on the real host, after a real install.
#
#   ./test.suite run platform.shared.config.env.invariant 1
#
# Its sibling test.platform.shared.config.invariant asserts the config
# DIRECTORY: symlink, owner, group, mode, write-through, c2 dispatch. It
# asserts nothing whatever about what is INSIDE the files. That gap is exactly
# why a fresh macOS install shipped a ~/config/oosh.env that no shell could
# source, and every login printed "OOSH_MODE: command not found", without a
# single test noticing — see docs/research/2026-09-17-config-save-bash32.md.
#
# Why this cannot be a `core` fixture test: the fault is bash-3.2-only, and
# core runs on whatever bash the dev host has (5.x on Linux). test/test.config
# T75 injects a simulated 3.2 stream and proves the CODE no longer depends on
# the broken form; only this file, on a real macOS box, proves the RESULT.

cfgPath="${CONFIG_PATH:-$HOME/config}"

# ----------------------------------------------------------------------------
# INVARIANT-0 (precondition): the generated files exist at all.
# ----------------------------------------------------------------------------
missing=""
for envName in user oosh log; do
  [ -f "$cfgPath/$envName.env" ] || missing="$missing $envName.env"
done

test.case $level "platform.shared.config.env: precondition — user/oosh/log .env all present" \
  test -z "$missing"
if [ -n "$missing" ]; then
  expect.fail "absent in $cfgPath:$missing — run \`config init.env\` (or reinstall if that writes an empty file)"
  test.suite.save.results
  return 0 2>/dev/null || exit 0
else
  expect.pass "user.env, oosh.env and log.env present in $cfgPath"
fi

# ----------------------------------------------------------------------------
# INVARIANT-1: every line is an export assignment, a comment, blank, or a
# `.`/`source` chain line.
#
# STRICTLY STRONGER THAN `config validate`, deliberately. config.validate's
# regex makes `export` OPTIONAL — `^(export[[:space:]]+(declare[[:space:]]+)?)?
# [A-Za-z_][A-Za-z0-9_]*=` — so a file of bare `NAME=value` lines validates OK.
# On macOS that is exactly what config.save produced for years: bash 3.2's
# `declare -p` prints no `declare -x` prefix, so the sed that was supposed to
# rewrite it into `export` never matched. The existing guard was structurally
# blind to it.
# ----------------------------------------------------------------------------
for envName in user oosh log; do
  envFile="$cfgPath/$envName.env"
  offenders=$(grep -n -v -E '^[[:space:]]*($|#|export [A-Za-z_][A-Za-z0-9_]*=|(source|\.)[[:space:]])' "$envFile" 2>/dev/null)
  test.case $level "platform.shared.config.env: $envName.env carries only export/comment/blank/chain lines" \
    test -z "$offenders"
  if [ -z "$offenders" ]; then
    expect.pass "$envFile is all export assignments"
  else
    expect.fail "$envFile has non-export line(s):
$offenders
    — regenerate with \`config save\`; if they are prose rows, this is the bash-3.2 harvest bug"
  fi
done

# ----------------------------------------------------------------------------
# INVARIANT-2: no ANSI-C quoting. `$'a\nb'` is a BASHISM, and $OOSH_DIR/boot
# sources these files under dash/ash on /bin/sh login shells, where $'…' is
# read literally (review-2026-09-09 § D1).
# ----------------------------------------------------------------------------
for envName in user oosh log; do
  envFile="$cfgPath/$envName.env"
  ansiC=$(grep -n -F "=\$'" "$envFile" 2>/dev/null)
  test.case $level "platform.shared.config.env: $envName.env has no \$'…' ANSI-C quoting" \
    test -z "$ansiC"
  if [ -z "$ansiC" ]; then
    expect.pass "$envFile is POSIX-quoted throughout"
  else
    expect.fail "$envFile uses bash ANSI-C quoting, which dash reads literally:
$ansiC"
  fi
done

# ----------------------------------------------------------------------------
# INVARIANT-3: the tree's own validators agree. config.save already runs
# config.validate on what it wrote — and throws the verdict away
# (`>/dev/null 2>&1 || warn.log`), which is why the broken files shipped. This
# is that discarded verdict, wired to an assertion.
# ----------------------------------------------------------------------------
for envName in user oosh log; do
  validateOut=$("$OOSH_DIR/config" validate "$envName" 2>&1); validateRc=$?
  test.case $level "platform.shared.config.env: config validate $envName returns OK" \
    test "$validateRc" = "0"
  if [ "$validateRc" = "0" ]; then
    expect.pass "$validateOut"
  else
    expect.fail "$validateOut — config.save discards this verdict to /dev/null; that is why it shipped"
  fi
done

requiredOut=$("$OOSH_DIR/config" validate required 2>&1); requiredRc=$?
test.case $level "platform.shared.config.env: config validate required returns OK" \
  test "$requiredRc" = "0"
if [ "$requiredRc" = "0" ]; then
  expect.pass "$requiredOut"
else
  expect.fail "$requiredOut
    — NOTE: \`config init.env\` is the advertised repair and can make this WORSE
      (research § 5: it regenerates from an environment the broken files failed
      to populate, and writes an empty file). That is card 2, not this one."
fi

# ----------------------------------------------------------------------------
# INVARIANT-4 (behavioural): the user-visible symptom. A shell that sources
# boot must come up with OOSH_MODE set and print nothing to stderr. This is § 1
# of the research doc as an assertion — it is what the operator actually saw.
# ----------------------------------------------------------------------------
bootOut=$(env -i HOME="$HOME" sh -c '. "$HOME/oosh/boot" 2>&1 1>/dev/null' 2>&1)
bootMode=$(env -i HOME="$HOME" sh -c '. "$HOME/oosh/boot" >/dev/null 2>&1; echo "$OOSH_MODE"' 2>/dev/null)

test.case $level "platform.shared.config.env: sourcing boot emits nothing on stderr" \
  test -z "$bootOut"
if [ -z "$bootOut" ]; then
  expect.pass "a clean shell sources boot silently"
else
  expect.fail "sourcing boot printed:
$bootOut
    — a non-assignment line in an env file becomes a command at every login"
fi

test.case $level "platform.shared.config.env: OOSH_MODE is set after sourcing boot" \
  test -n "$bootMode"
if [ -n "$bootMode" ]; then
  expect.pass "OOSH_MODE=$bootMode"
else
  expect.fail "OOSH_MODE is empty after sourcing boot — oosh.env did not carry it; see \`config validate required\`"
fi

test.suite.save.results
