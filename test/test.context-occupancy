#!/usr/bin/env bash
# T-CONTEXT-OCCUPANCY — RED-FIRST guard (rewind-safety defect, oopPO 2026-09-30).
# DEFECT: on a /context PANEL, the TUI parser (private.claudeCode.context.parse, Pattern-4
# "any %% in the bottom 10 lines") grabs the SUGGESTIONS line "Bash results using Xk tokens (17%)"
# instead of the OCCUPANCY "536k/1m tokens (54%)" → reads a FALSE-LOW (17 not 54) → a near-wall
# agent looks healthy → rewind-safety hazard. context.check MUST read the OCCUPANCY %, never a
# Suggestions/breakdown %%. RED now (deployed returns 17). Expert fixes; this is the failable gate.
level=$1; [ -z "$level" ] && level=1
echo "starting: T-CONTEXT-OCCUPANCY <LOG_LEVEL=$level> (RED-FIRST — fails until parse reads occupancy)"
source this
source test.suite
source claudeCode
export LOG_DEVICE=/dev/null
log.level $level

# REPRESENTATIVE /context panel — occupancy near the TOP (54%), long body, Suggestions 17% near the
# BOTTOM (exactly like the real panel: occupancy sits FAR above the bottom-10 the parser scans).
# The earlier bug in a naive fixture: too SHORT → occupancy fell inside tail -10 → false-green.
read -r -d '' PANEL <<'EOF'
 Context Usage
 Opus 4.8 (1M context)   claude-opus-4-8[1m]
 536.0k/1m tokens (54%)

 Estimated usage by category
   System prompt: 3.6k tokens (0.4%)
   System tools: 19.1k tokens (1.9%)
   Custom agents: 6.9k tokens (0.7%)
   Memory files: 7.6k tokens (0.8%)
   Skills: 2.2k tokens (0.2%)
   Messages: 445.6k tokens (44.6%)
   Compact buffer: 3k tokens (0.3%)
   Free space: 464k (46.4%)

 MCP tools · /mcp
   6 tools · 0 tokens
 Custom agents · .claude/agents/
   96 agents · 6.9k tokens
 Memory files · /memory
   2 files · 7.6k tokens
 Skills · /skills
   16 skills · 2.2k tokens

 Suggestions
   Bash results using 170k tokens (17%) — run /context to clear them
   ? for shortcuts
EOF

# CONVENTION = REMAINING (oosh-po ruling 2026-09-30, confirmed 2 ways: the status-bar anchor
# 'Context left until auto-compact: 42%'→42 is remaining as-is; expert's from.jsonl = 100-used +
# thresholds <=10 CRIT/<=25 LOW are remaining). So a 54%-USED panel must parse to 46 REMAINING.
USED=54  # raw occupancy (USED%) on the panel — the WRONG answer under the remaining-convention
REM=46   # CORRECT: 100 - USED = remaining (also equals the panel's 'Free space (46.4%)' line, rounded)
TRAP=17  # Suggestions false-LOW the parser currently grabs
DECBUG=6 # decimal-regex bug: [0-9]+%% on '53.6%'/'46.4%' grabs the trailing digit ('6'/'4')

echo; echo "===== (1) CORE: parse a /context panel → REMAINING (100-used=$REM), not the trap ====="
GOT=$(private.claudeCode.context.parse "$PANEL")
test.case $level "(1) context.parse(panel) = $REM remaining, NOT $TRAP/$USED/$DECBUG (got '$GOT')" echo "$GOT"
if [ "$GOT" = "$REM" ]; then
  expect.pass "read $REM% remaining (100-$USED used; ignored the Suggestions line)"
elif [ "$GOT" = "$TRAP" ]; then
  expect.fail "RED: read the Suggestions $TRAP% (FALSE-LOW) instead of $REM% remaining — rewind-safety hazard"
elif [ "$GOT" = "$USED" ]; then
  expect.fail "RED: read raw USED $USED% — must be REMAINING $REM% (100-used) per convention"
else
  expect.fail "RED: read '$GOT' — not $REM remaining (parser grabs a stray %%; e.g. decimal-bug $DECBUG)"
fi

echo; echo "===== (2) HARD invariants: never the trap, raw-used, or the decimal-bug value ====="
test.case $level "(2) parsed %% is none of {trap $TRAP, used $USED, decimal-bug $DECBUG,4}" echo "$GOT"
case "$GOT" in
  "$TRAP"|"$USED"|"$DECBUG"|4) expect.fail "RED: returned a wrong value '$GOT' (trap/used/decimal-bug)";;
  *)                           expect.pass "avoided trap/used/decimal-bug (got '$GOT')";;
esac

echo; echo "===== (3) ANCHOR: the status-bar path still works (no regression) ====="
BAR='  Context left until auto-compact: 42%'
GOTBAR=$(private.claudeCode.context.parse "$BAR")
test.case $level "(3) status-bar 'Context left until auto-compact: 42%' → 42 (got '$GOTBAR')" echo "$GOTBAR"
[ "$GOTBAR" = "42" ] && expect.pass "status-bar parse intact (Pattern 1)" \
                      || expect.fail "status-bar parse regressed: got '$GOTBAR'"

echo; echo "===== (4) DEPLOYED end-to-end via read.tui on a RENDERED panel pane ====="
FX_PREFIX="fxctx_"
sweep_fx() { tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; }
sweep_fx                      # PRE-RUN sweep (survives a prior SIGKILL; orphans never accumulate)
trap sweep_fx EXIT
if [ -n "$TMUX" ]; then
  S="${FX_PREFIX}$$"
  tmux new-session -d -s "$S" -x 200 -y 30 2>/dev/null
  # render the panel (bottom of a 30-row pane holds the Suggestions area, occupancy scrolls to top)
  scr=$(printf '%s\n' "$PANEL" | sed "s/'/'\\\\''/g")
  tmux send-keys -t "$S" "clear; printf '%s\n' '$scr'; exec cat" Enter 2>/dev/null
  sleep 0.5
  GOTTUI=$(private.claudeCode.context.read.tui "${S}:0.0" 2>/dev/null)
  test.case $level "(4) read.tui(rendered panel) = $REM remaining, not $TRAP (got '$GOTTUI')" echo "$GOTTUI"
  if [ "$GOTTUI" = "$REM" ]; then expect.pass "deployed read.tui read $REM% remaining"
  elif [ "$GOTTUI" = "$TRAP" ]; then expect.fail "RED: deployed read.tui read the Suggestions trap $TRAP (false-LOW)"
  else expect.fail "RED: deployed read.tui read '$GOTTUI' (want $REM remaining)"; fi
  sweep_fx
else
  test.case $level "(4) read.tui (skipped — no tmux)" echo skip; expect.pass skipped
fi

echo
echo "=================================================================="
echo "  T-CONTEXT-OCCUPANCY RED-FIRST: parse must read the occupancy and return REMAINING"
echo "  (100-used=$REM per oosh-po ruling), never the Suggestions trap $TRAP / raw-used $USED /"
echo "  decimal-bug $DECBUG. Expert fix (100-used OR the 'Free space (46.4%)' line) → $REM on merit."
echo "=================================================================="
sweep_fx
test.suite.save.results
