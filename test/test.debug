#!/usr/bin/env bash
# Comprehensive tests for the debug script
# Tests: debug.noop, debug.toggleDebug, expect.error, debug.setTrap, debug.onReturn, debug.onError, debug.stackTrace

#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite
source log

log.level $level

# CRITICAL: Disable STEP_DEBUG to prevent test blocking
export STEP_DEBUG=OFF

# Save original state
ORIGINAL_LOG_LEVEL=$LOG_LEVEL
ORIGINAL_STEP_DEBUG=$STEP_DEBUG
ORIGINAL_EXPECTED_RETURN_VALUE=$EXPECTED_RETURN_VALUE

# Source debug after disabling STEP_DEBUG
source debug

# Cleanup function
cleanup_debug_test() {
  export LOG_LEVEL=$ORIGINAL_LOG_LEVEL
  export STEP_DEBUG=OFF
  export EXPECTED_RETURN_VALUE=$ORIGINAL_EXPECTED_RETURN_VALUE
  # Remove traps to prevent interference
  trap - DEBUG ERR RETURN EXIT 2>/dev/null
}

# Ensure STEP_DEBUG stays off
export STEP_DEBUG=OFF

# ============================================================================
# T1: Test debug.noop returns 0
# ============================================================================
test.case - "T1: debug.noop returns 0" \
  debug.noop

if [ "$RETURN_VALUE" -eq 0 ]; then
  create.result 0 "debug.noop returns 0"
else
  create.result 1 "debug.noop returned $RETURN_VALUE"
fi
expect 0 "debug.noop returns 0" "debug.noop function returns 0"

# ============================================================================
# T2: Test debug.noop does nothing (no side effects)
# ============================================================================
BEFORE_VAR="unchanged"
test.case - "T2: debug.noop has no side effects" \
  debug.noop

if [ "$BEFORE_VAR" = "unchanged" ]; then
  create.result 0 "no side effects"
else
  create.result 1 "side effect detected"
fi
expect 0 "no side effects" "debug.noop has no side effects"

# ============================================================================
# T3: Test debug.toggleDebug changes LOG_LEVEL from low to high
# ============================================================================
export LOG_LEVEL=3
export STEP_DEBUG=OFF

test.case - "T3: debug.toggleDebug increases LOG_LEVEL from 3" \
  debug.toggleDebug

if [ "$LOG_LEVEL" -eq 5 ]; then
  create.result 0 "level increased to 5"
else
  create.result 1 "LOG_LEVEL=$LOG_LEVEL"
fi
expect 0 "level increased to 5" "debug.toggleDebug increases level"

# Reset
export STEP_DEBUG=OFF

# ============================================================================
# T4: Test debug.toggleDebug changes LOG_LEVEL from high to low
# ============================================================================
export LOG_LEVEL=5
export STEP_DEBUG=OFF

test.case - "T4: debug.toggleDebug decreases LOG_LEVEL from 5" \
  debug.toggleDebug

if [ "$LOG_LEVEL" -eq 3 ]; then
  create.result 0 "level decreased to 3"
else
  create.result 1 "LOG_LEVEL=$LOG_LEVEL"
fi
expect 0 "level decreased to 3" "debug.toggleDebug decreases level"

# Reset
export STEP_DEBUG=OFF
export LOG_LEVEL=$level

# ============================================================================
# T5: Test expect.error sets EXPECTED_RETURN_VALUE
# ============================================================================
export EXPECTED_RETURN_VALUE=0

test.case - "T5: expect.error sets EXPECTED_RETURN_VALUE" \
  expect.error 42

if [ "$EXPECTED_RETURN_VALUE" -eq 42 ]; then
  create.result 0 "EXPECTED_RETURN_VALUE=42"
else
  create.result 1 "EXPECTED_RETURN_VALUE=$EXPECTED_RETURN_VALUE"
fi
expect 0 "EXPECTED_RETURN_VALUE=42" "expect.error sets value"

# ============================================================================
# T6: Test expect.error rejects non-numeric input
# ============================================================================
export EXPECTED_RETURN_VALUE=99

test.case - "T6: expect.error rejects non-numeric" \
  expect.error "notanumber"

# Should remain unchanged since "notanumber" is invalid
if [ "$EXPECTED_RETURN_VALUE" -eq 99 ]; then
  create.result 0 "rejected non-numeric"
else
  create.result 1 "accepted non-numeric: $EXPECTED_RETURN_VALUE"
fi
expect 0 "rejected non-numeric" "expect.error rejects non-numeric"

# ============================================================================
# T7: Test debug.setTrap sets ERR trap
# ============================================================================
# Clear traps first
trap - ERR 2>/dev/null

test.case - "T7: debug.setTrap sets ERR trap" \
  debug.setTrap

ERR_TRAP=$(trap -p ERR)
if echo "$ERR_TRAP" | grep -q "debug.onError"; then
  create.result 0 "ERR trap set"
else
  create.result 1 "ERR trap: $ERR_TRAP"
fi
expect 0 "ERR trap set" "debug.setTrap sets ERR trap"

# ============================================================================
# T8: Test debug.setTrap sets RETURN trap
# ============================================================================
RETURN_TRAP=$(trap -p RETURN)
if echo "$RETURN_TRAP" | grep -q "debug.onReturn"; then
  create.result 0 "RETURN trap set"
else
  create.result 1 "RETURN trap: $RETURN_TRAP"
fi
expect 0 "RETURN trap set" "debug.setTrap sets RETURN trap"

# ============================================================================
# T9: Test debug.setTrap sets EXIT trap
# ============================================================================
EXIT_TRAP=$(trap -p EXIT)
if echo "$EXIT_TRAP" | grep -q "debug.onExit"; then
  create.result 0 "EXIT trap set"
else
  create.result 1 "EXIT trap: $EXIT_TRAP"
fi
expect 0 "EXIT trap set" "debug.setTrap sets EXIT trap"

# Clear traps after testing
trap - DEBUG ERR RETURN EXIT 2>/dev/null

# ============================================================================
# T10: Test debug.step function exists
# ============================================================================
test.case - "T10: debug.step function exists" \
  echo "checking debug.step"

if [ "$(type -t debug.step)" = "function" ]; then
  create.result 0 "debug.step is function"
else
  create.result 1 "debug.step type: $(type -t debug.step)"
fi
expect 0 "debug.step is function" "debug.step function exists"

# ============================================================================
# T11: Test debug.stackTrace function exists
# ============================================================================
test.case - "T11: debug.stackTrace function exists" \
  echo "checking debug.stackTrace"

if [ "$(type -t debug.stackTrace)" = "function" ]; then
  create.result 0 "debug.stackTrace is function"
else
  create.result 1 "debug.stackTrace type: $(type -t debug.stackTrace)"
fi
expect 0 "debug.stackTrace is function" "debug.stackTrace function exists"

# ============================================================================
# T12: Test debug.onError function exists
# ============================================================================
test.case - "T12: debug.onError function exists" \
  echo "checking debug.onError"

if [ "$(type -t debug.onError)" = "function" ]; then
  create.result 0 "debug.onError is function"
else
  create.result 1 "debug.onError type: $(type -t debug.onError)"
fi
expect 0 "debug.onError is function" "debug.onError function exists"

# ============================================================================
# T13: Test debug.onReturn function exists
# ============================================================================
test.case - "T13: debug.onReturn function exists" \
  echo "checking debug.onReturn"

if [ "$(type -t debug.onReturn)" = "function" ]; then
  create.result 0 "debug.onReturn is function"
else
  create.result 1 "debug.onReturn type: $(type -t debug.onReturn)"
fi
expect 0 "debug.onReturn is function" "debug.onReturn function exists"

# ============================================================================
# T14: Test debug.onExit function exists
# ============================================================================
test.case - "T14: debug.onExit function exists" \
  echo "checking debug.onExit"

if [ "$(type -t debug.onExit)" = "function" ]; then
  create.result 0 "debug.onExit is function"
else
  create.result 1 "debug.onExit type: $(type -t debug.onExit)"
fi
expect 0 "debug.onExit is function" "debug.onExit function exists"

# ============================================================================
# T15: Test STEP_DEBUG can be toggled
# ============================================================================
export STEP_DEBUG=OFF

test.case - "T15: STEP_DEBUG can be set to ON" \
  echo "testing STEP_DEBUG"

export STEP_DEBUG=ON
if [ "$STEP_DEBUG" = "ON" ]; then
  create.result 0 "STEP_DEBUG=ON"
else
  create.result 1 "STEP_DEBUG=$STEP_DEBUG"
fi
expect 0 "STEP_DEBUG=ON" "STEP_DEBUG can be toggled"

# Reset immediately
export STEP_DEBUG=OFF

# ============================================================================
# T16: Test debug.v returns version (uses info.log, needs level > 3)
# ============================================================================
SAVED_LEVEL=$LOG_LEVEL
SAVED_DEVICE=$LOG_DEVICE
export LOG_LEVEL=4
# Use a temp file so output is always captured regardless of TTY permissions
T16_TMPFILE="/tmp/test.debug.t16.$$"
> "$T16_TMPFILE"
export LOG_DEVICE="$T16_TMPFILE"

test.case - "T16: debug.v returns version" \
  echo "checking version"

debug.v 2>&1
if grep -q "version" "$T16_TMPFILE"; then
  create.result 0 "version returned"
else
  create.result 1 "output: $(cat "$T16_TMPFILE")"
fi
expect 0 "version returned" "debug.v returns version string"

# Restore
rm -f "$T16_TMPFILE" 2>/dev/null
export LOG_LEVEL=$SAVED_LEVEL
export LOG_DEVICE=$SAVED_DEVICE

# ============================================================================
# T17: Test expect.error with 0
# ============================================================================
export EXPECTED_RETURN_VALUE=1

test.case - "T17: expect.error accepts 0" \
  expect.error 0

if [ "$EXPECTED_RETURN_VALUE" -eq 0 ]; then
  create.result 0 "accepts 0"
else
  create.result 1 "EXPECTED_RETURN_VALUE=$EXPECTED_RETURN_VALUE"
fi
expect 0 "accepts 0" "expect.error accepts 0"

# ============================================================================
# T18: Test debug.toggleDebug sets STEP_DEBUG to OFF
# ============================================================================
export STEP_DEBUG=ON
export LOG_LEVEL=3

test.case - "T18: debug.toggleDebug sets STEP_DEBUG OFF" \
  debug.toggleDebug

if [ "$STEP_DEBUG" = "OFF" ]; then
  create.result 0 "STEP_DEBUG=OFF"
else
  create.result 1 "STEP_DEBUG=$STEP_DEBUG"
fi
expect 0 "STEP_DEBUG=OFF" "debug.toggleDebug sets STEP_DEBUG OFF"

# Reset
export STEP_DEBUG=OFF

# ============================================================================
# T19: Test debug.onReturn handles return value
# ============================================================================
test_return_func() {
  return 42
}

# Set up trap temporarily
trap 'debug.onReturn ${?}' RETURN 2>/dev/null

test.case - "T19: debug.onReturn handles function return" \
  test_return_func

# debug.onReturn should have been called
if [ "$RETURN_VALUE" -eq 42 ]; then
  create.result 0 "return captured"
else
  create.result 1 "RETURN_VALUE=$RETURN_VALUE"
fi
expect 0 "return captured" "debug.onReturn handles function return"

# Clear trap
trap - RETURN 2>/dev/null

# ============================================================================
# T20: Test PS4 format is set for trace
# ============================================================================
test.case - "T20: PS4 trace format available" \
  echo "checking PS4"

# PS4 should be set when debug is sourced at high level
if [ -n "$PS4" ]; then
  create.result 0 "PS4 is set"
else
  create.result 1 "PS4 is empty"
fi
expect 0 "PS4 is set" "PS4 trace format available"

# ============================================================================
# T21: Test debug.onError suppresses expected errors (exit code = EXPECTED_RETURN_VALUE)
# ============================================================================
# Set up ERR trap for this test
trap 'debug.onError $?' ERR 2>/dev/null

export EXPECTED_RETURN_VALUE=1
export RETURN_VALUE=0

test.case - "T21: debug.onError suppresses expected error code" \
  echo "testing debug.onError suppression"

# Simulate debug.onError being called with exit code 1 (the expected value)
debug.onError 1

if [ "$RETURN_VALUE" -eq 1 ] && [ "$EXPECTED_RETURN_VALUE" -eq 1 ]; then
  create.result 0 "expected error suppressed"
else
  create.result 1 "RETURN_VALUE=$RETURN_VALUE EXPECTED_RETURN_VALUE=$EXPECTED_RETURN_VALUE"
fi
expect 0 "expected error suppressed" "debug.onError suppresses expected error and resets EXPECTED_RETURN_VALUE"

# Clear trap
trap - ERR 2>/dev/null

# ============================================================================
# T22: the helpers carry their documented debug.* names, and no bare one is left
# ============================================================================
# docs/debug.md documents debug.step, debug.stackTrace, debug.toggleDebug,
# debug.noop, debug.onReturn, debug.onError, debug.onExit and debug.setTrap.
# Bare names leaked into every oosh shell: bashrcTemplate's own debug.onExit()
# silently replaced debug's, and this.call ran debug's debug.noop for `myId debug.noop`.
test.debug.helpersNamed() {
  # Listed dotted, so a `replace word` rename of this file leaves the list alone.
  local m n missing="" bare=""
  for m in debug.step debug.stackTrace debug.toggleDebug debug.noop \
           debug.onReturn debug.onError debug.onExit debug.setTrap; do
    n="${m#debug.}"
    [ "$(type -t "$m")" = "function" ] || missing="$missing $m"
    grep -qE "^[[:space:]]*(function[[:space:]]+)?$n[[:space:]]*\(\)" "$OOSH_DIR/debug" && bare="$bare $n"
  done
  if [ -n "$missing" ]; then
    create.result 1 "not defined:$missing"
  elif [ -n "$bare" ]; then
    create.result 1 "bare definitions left in debug:$bare"
  else
    create.result 0 "all eight helpers are debug.*"
  fi
  return $(result)
}
test.case - "T22: the debug helpers are debug.* as documented; no bare name is defined" \
  test.debug.helpersNamed
expect 0 "all eight helpers are debug.*" "bare helper names collide with other scripts and bashrc"

# ============================================================================
# Cleanup
# ============================================================================
cleanup_debug_test

# ============================================================================
# Save results
# ============================================================================

console.log "
Test: debug.removeTrap
===================================================================="

test.case - "debug.removeTrap switches STEP_DEBUG off" \
   debug.removeTrap 
expect 0 "stepping off"

# ============================================================================
# T23: every debug.* method carries the mandatory docstring and a completion stub
# ============================================================================
# docs/oosh-architecture.md § Method Structure Standard: a method without its
# `# <params> # description` docstring is invisible to this.help and c2; a
# no-parameter method keeps the empty `.completion() { :; }` stub. The eight
# helpers were renamed to debug.* on 2026-09-28 without either, and `r` in
# debug.step called an undefined removeTrap.
test.debug.methodsDocumented() {
  local bad="" m sig
  for m in $(grep -oE "^debug\.[A-Za-z.]+\(\)" "$OOSH_DIR/debug" | grep -v "\.completion" | sed "s/()$//"); do
    sig=$(grep -E "^$m\(\)[[:space:]]*#.*#" "$OOSH_DIR/debug")
    [ -n "$sig" ] || bad="$bad no-docstring:$m"
    case "$sig" in *"# <"*) ;; *) [ "$(type -t "$m.completion")" = "function" ] || bad="$bad no-stub:$m" ;; esac
  done
  [ "$(type -t debug.removeTrap)" = "function" ] || bad="$bad no-debug.removeTrap"
  grep -qE "(^|[^.A-Za-z])removeTrap" "$OOSH_DIR/debug" && bad="$bad bare-removeTrap-left"
  [ -z "$bad" ] && create.result 0 "every debug.* method is documented and completable" || create.result 1 "methods:$bad"
  return $(result)
}
test.case - "T23: every debug.* method has its docstring; no-parameter ones have a completion stub; removeTrap is debug.removeTrap" \
  test.debug.methodsDocumented
expect 0 "every debug.* method is documented and completable" "renamed helpers without docstrings hid from help and completion"

### test.method

test.suite.save.results
