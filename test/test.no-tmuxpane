#!/usr/bin/env bash
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T-NO-TMUXPANE — BUG 7 guard (Tron directive 2026-06-28)
# ============================================================================
# $TMUX_PANE is set once at shell start and goes STALE after any pane swap/fork.
# It is the root cause of every self-identification failure. The reliable
# replacement is `otmux pane.self` (PID-walk). No code may read $TMUX_PANE for
# self-identification.
#
# This guard fails if any NON-COMMENT line in otmux/hiveMind/claudeCode
# references TMUX_PANE. Comments (documenting why it was removed) are allowed.

GUARD_SCRIPTS="otmux hiveMind claudeCode"

for scriptName in $GUARD_SCRIPTS; do
  scriptPath="$OOSH_DIR/$scriptName"
  if [ ! -f "$scriptPath" ]; then
    test.case $level "${scriptName}: file exists" echo "missing"
    expect.fail "${scriptName} not found at ${scriptPath}"
    continue
  fi

  # Match TMUX_PANE on lines that are NOT comments (strip leading whitespace,
  # skip lines starting with #).
  violations=$(grep -nE 'TMUX_PANE' "$scriptPath" 2>/dev/null \
    | grep -vE '^[0-9]+:[[:space:]]*#')

  if [ -z "$violations" ]; then
    test.case $level "${scriptName}: no TMUX_PANE self-ID (BUG 7)" echo "clean"
    expect.pass "${scriptName} has zero non-comment TMUX_PANE references"
  else
    test.case $level "${scriptName}: no TMUX_PANE self-ID (BUG 7)" echo "$violations"
    expect.fail "${scriptName} still reads TMUX_PANE — use otmux pane.self: $violations"
  fi

  # C-extension (BUG 7): bare `display-message -p '#{session_name|...}'` with NO
  # -t target returns the FOCUSED pane, not the caller's — same stale-self-ID
  # class, but has no TMUX_PANE string so the check above misses it. The pane.self
  # primitives (otmux pane.self / self.session) legitimately use -t, so requiring
  # ' -t ' on every self-ID display-message catches the bare ones.
  bareSelf=$(grep -nE "display-message -p '#\{(session_name|window_index|pane_index)" "$scriptPath" 2>/dev/null \
    | grep -v ' -t ' \
    | grep -vE '^[0-9]+:[[:space:]]*#')

  if [ -z "$bareSelf" ]; then
    test.case $level "${scriptName}: no bare display-message self-ID (BUG 7 C-ext)" echo "clean"
    expect.pass "${scriptName} has no untargeted (focused-pane) self-ID"
  else
    test.case $level "${scriptName}: no bare display-message self-ID (BUG 7 C-ext)" echo "$bareSelf"
    expect.fail "${scriptName} uses bare display-message -p (focused pane) — add -t via pane.self: $bareSelf"
  fi
done

test.suite.save.results
