#!/usr/bin/env bash
# T-HIVEMIND-VALIDATORS — RED-FIRST, hiveMind pass step 1 (PO-approved; spec session/tasks/hivemind-dead-validators.md).
# BUG (measured): b745e766 commented out kernel this.isPaneTarget/isSessionName/isRoleName/isUuid/isPipeSafe;
#   this.isSshHost was never defined on this lineage. hiveMind still calls them (50 call sites — see
#   T-STATIC-DEFINED-FUNCTIONS) -> command not found -> every guarded verb REJECTS VALID INPUT.
#   TIER 0: the otmux->hiveMind observers (panes.swapped / pane.moved / session.renamed) reject valid
#   args behind 2>/dev/null -> a pane move never reaches the registry (root of the stale-registry bug).
# CELLS
#   A  observers + VALID args -> rc0, no 'invalid', no 'command not found', AND the handler effect LANDS
#      in the sandbox registry (proves dispatch really ran — a renamed copy dispatches nothing, false-pass)
#   B  observers + JUNK (garbage / '|' / newline / bad session) -> rc!=0 + sandbox registry byte-unchanged
#   C  CAUSALITY: real otmux pane.swap / session.rename on a throwaway session -> sandbox row follows
#   D  Tier-2 sample (agent.rename, team.switch, delegate, registry.remove) valid-format input passes the
#      validator (stops later at resolve/existence — no 'invalid', no 'command not found')
#   F  no 'command not found' anywhere
#   G  (PO ruling) a move/swap observer leaves the DESTINATION pane UNTOUCHED: full-history capture by
#      pane id before == after (no 'export HIVEMIND_ROLE=...' typed), while the registry DID change
#   I  ISOLATION: sandbox HOME/CONFIG_PATH/HIVEMIND_REGISTRY/SESSIONS/TEAMS; live roles.env sha unchanged
# Fixture panes: nonexistent for A/B/D; a throwaway session of plain `bash --norc` panes for C/G only.

level=$1; [ -z "$level" ] && level=1
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level> (RED-FIRST — dead this.is* validators must fail)"
source this
source test.suite
log.level $level
export LOG_DEVICE=/dev/null

pass=0; fail=0
ok(){ expect.pass "$1"; pass=$((pass+1)); }
no(){ expect.fail "$1"; fail=$((fail+1)); }

FX_PREFIX="fxhv_"; LIVE="${FX_PREFIX}live"; GHOST="${FX_PREFIX}ghost"   # GHOST = never-created session
GEN="${OOSH_DIR}/test/gen/t-hivemind-validators"; SBX="$GEN/home"; CFG="$SBX/config"
REG="$CFG/hivemind.roles.env"; SES="$CFG/hivemind.sessions.env"; TEAMS="$CFG/hivemind.teams.env"
LIVE_REG="$HOME/config/hivemind.roles.env"
sha(){ [ -f "$1" ] && sha256sum "$1" | cut -d' ' -f1 || echo absent; }
LIVE_SHA_BEFORE=$(sha "$LIVE_REG")
sbx(){ HOME="$SBX" CONFIG_PATH="$CFG" HIVEMIND_REGISTRY="$REG" HIVEMIND_SESSIONS="$SES" HIVEMIND_TEAMS="$TEAMS" "$@"; }
ALLOUT="$GEN/all.out"

sweep(){ tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${FX_PREFIX}" \
           | while IFS= read -r s; do tmux kill-session -t "$s" 2>/dev/null; done; rm -rf "$GEN"; }
trap sweep EXIT
sweep
mkdir -p "$CFG"; : > "$CFG/result.txt"; : > "$CFG/error.txt"; : > "$ALLOUT"

seed(){ : > "$REG"; : > "$SES"; : > "$TEAMS"; local r; for r in "$@"; do echo "$r" >> "$REG"; done; }
row(){ awk -F'|' -v p="$1" '$1==p{print $2; exit}' "$REG"; }
# hm <args...> -> RC, OUT; everything also appended to ALLOUT for cell F
hm(){ OUT=$(sbx hiveMind "$@" 2>&1); RC=$?; printf '%s\n' "$OUT" >> "$ALLOUT"; }
bad(){ echo "$OUT" | grep -qiE 'invalid|rejected|command not found'; }

echo; echo "===== A — observers with VALID args: rc0 + handler effect lands in the sandbox registry ====="
seed "${GHOST}:0.0|fxnk-alpha|1782659134" "${GHOST}:0.5|fxnk-other|1782659134"
hm protected.pane.moved "${GHOST}:0.0" "${GHOST}:0.1"
test.case $level "A1 pane.moved ${GHOST}:0.0 -> :0.1" echo "rc=$RC dst=$(row "${GHOST}:0.1") src=$(row "${GHOST}:0.0")"
{ [ "$RC" -eq 0 ] && ! bad && [ "$(row "${GHOST}:0.1")" = fxnk-alpha ] && [ -z "$(row "${GHOST}:0.0")" ]; } \
  && ok "moved: row followed :0.0 -> :0.1" \
  || no "RED: rc=$RC, dst='$(row "${GHOST}:0.1")' src='$(row "${GHOST}:0.0")' (want row moved): $(echo "$OUT" | grep -iE 'invalid|rejected|not found' | head -1)"

seed "${GHOST}:0.0|fxnk-alpha|1782659134" "${GHOST}:0.1|fxnk-beta|1782659134"
hm protected.panes.swapped "$GHOST" "${GHOST}:0.0" "${GHOST}:0.1"
test.case $level "A2 panes.swapped ${GHOST} 0.0<->0.1" echo "rc=$RC 0.0=$(row "${GHOST}:0.0") 0.1=$(row "${GHOST}:0.1")"
{ [ "$RC" -eq 0 ] && ! bad && [ "$(row "${GHOST}:0.0")" = fxnk-beta ] && [ "$(row "${GHOST}:0.1")" = fxnk-alpha ]; } \
  && ok "swapped: rows exchanged" \
  || no "RED: rc=$RC, 0.0='$(row "${GHOST}:0.0")' 0.1='$(row "${GHOST}:0.1")' (want beta/alpha): $(echo "$OUT" | grep -iE 'invalid|rejected|not found' | head -1)"

seed "${GHOST}:0.0|fxnk-alpha|1782659134"
hm protected.session.renamed "$GHOST" "${GHOST}2"
test.case $level "A3 session.renamed ${GHOST} -> ${GHOST}2" echo "rc=$RC new=$(row "${GHOST}2:0.0") old=$(row "${GHOST}:0.0")"
{ [ "$RC" -eq 0 ] && ! bad && [ "$(row "${GHOST}2:0.0")" = fxnk-alpha ] && [ -z "$(row "${GHOST}:0.0")" ]; } \
  && ok "renamed: row rekeyed" \
  || no "RED: rc=$RC, new='$(row "${GHOST}2:0.0")' old='$(row "${GHOST}:0.0")' (want rekeyed): $(echo "$OUT" | grep -iE 'invalid|rejected|not found' | head -1)"

echo; echo "===== B — observers with JUNK: rejected rc!=0, sandbox registry byte-unchanged ====="
junk(){ # <label> <observer> <args...>
  local label="$1"; shift; seed "${GHOST}:0.0|fxnk-alpha|1782659134"; local b; b=$(sha "$REG")
  hm "$@"; local a; a=$(sha "$REG")
  test.case $level "B $label" echo "rc=$RC unchanged=$([ "$a" = "$b" ] && echo yes || echo NO)"
  { [ "$RC" -ne 0 ] && [ "$a" = "$b" ]; } && ok "rejected, registry unchanged" || no "JUNK ACCEPTED: rc=$RC registry-changed=$([ "$a" = "$b" ] && echo no || echo YES)"
}
junk "pane.moved garbage"        protected.pane.moved "garbage" "${GHOST}:0.1"
junk "pane.moved pipe char"      protected.pane.moved "${GHOST}:0.0" "${GHOST}:0.1|x"
junk "pane.moved newline"        protected.pane.moved "${GHOST}:0.0" "${GHOST}:0.1"$'\n'"x"
junk "panes.swapped garbage"     protected.panes.swapped "$GHOST" "zz" "${GHOST}:0.1"
junk "session.renamed bad name"  protected.session.renamed "$GHOST" "bad name"
junk "session.renamed pipe"      protected.session.renamed "$GHOST" "x|y"

echo; echo "===== D — Tier-2 verbs: valid-format input passes the validator (stops later, safely) ====="
seed "${GHOST}:0.0|fxnk-alpha|1782659134"
tier2(){ # <label> <args...>
  local label="$1"; shift; hm "$@"
  test.case $level "D $label" echo "rc=$RC"
  bad && no "RED: $label rejected valid input: $(echo "$OUT" | grep -iE 'invalid|rejected|not found' | head -1)" \
      || ok "$label: validator passed (stopped later: $(echo "$OUT" | grep -iE 'error|cannot|not' | head -1 | cut -c1-60))"
}
tier2 "agent.rename fxnk-nobody fxnk-newname" agent.rename fxnk-nobody fxnk-newname
tier2 "team.switch ${GHOST}"                  team.switch "$GHOST"
tier2 "delegate fxnk-nobody"                  delegate fxnk-nobody "fixture task (no such agent)"
tier2 "registry.remove ${GHOST}:0.0"          registry.remove "${GHOST}:0.0"

if [ -z "$TMUX" ]; then
  test.case $level "C/G (skipped — no tmux)" echo skip; expect.pass "skipped"
else
echo; echo "===== C + G — throwaway session of plain shells: row follows the real move; destination untouched ====="
tmux new-session -d -s "$LIVE" -x 120 -y 20 "bash --norc --noprofile" 2>/dev/null
tmux split-window -t "$LIVE" -v "bash --norc --noprofile" 2>/dev/null
for p in 0.0 0.1; do tmux send-keys -t "${LIVE}:$p" "PS1='fx> '; clear" Enter 2>/dev/null; done
sleep 0.8
IDA=$(tmux display-message -p -t "${LIVE}:0.0" '#{pane_id}'); IDB=$(tmux display-message -p -t "${LIVE}:0.1" '#{pane_id}')
capid(){ tmux capture-pane -p -S - -t "$1" 2>/dev/null; }
typed(){ capid "$1" | grep -c 'HIVEMIND_ROLE'; }

# C1: real otmux pane.swap -> sandbox rows follow the shells
seed "${LIVE}:0.0|fxnk-alpha|1782659134" "${LIVE}:0.1|fxnk-beta|1782659134"
CA0=$(capid "$IDA"); CB0=$(capid "$IDB")
sbx otmux pane.swap "${LIVE}:0.0" "${LIVE}:0.1" >>"$ALLOUT" 2>&1; sleep 1.2
test.case $level "C1 real otmux pane.swap -> registry rows follow" echo "0.0=$(row "${LIVE}:0.0") 0.1=$(row "${LIVE}:0.1")"
{ [ "$(row "${LIVE}:0.0")" = fxnk-beta ] && [ "$(row "${LIVE}:0.1")" = fxnk-alpha ]; } \
  && ok "rows followed the swap" || no "RED: after a real swap registry still 0.0='$(row "${LIVE}:0.0")' 0.1='$(row "${LIVE}:0.1")' (observer rejected behind 2>/dev/null)"
# G1: the swapped shells (by pane id) are byte-identical — nothing typed into them
test.case $level "G1 swap leaves both shells untouched (capture by pane id before == after)" echo "typedA=$(typed "$IDA") typedB=$(typed "$IDB")"
if [ "$(row "${LIVE}:0.1")" != fxnk-alpha ]; then no "RED: rows did not follow the swap (observer rejected) — untouched check would be vacuous"
elif [ "$(capid "$IDA")" = "$CA0" ] && [ "$(capid "$IDB")" = "$CB0" ]; then ok "rows followed AND both shells untouched"
else no "DESTINATION TOUCHED: typed HIVEMIND_ROLE A=$(typed "$IDA") B=$(typed "$IDB")"; fi

# G2: direct pane.moved observer between the two live shells -> registry DID change, destination untouched
seed "${LIVE}:0.0|fxnk-alpha|1782659134"
DST0=$(capid "${LIVE}:0.1"); RB=$(sha "$REG")
hm protected.pane.moved "${LIVE}:0.0" "${LIVE}:0.1"; sleep 1.2
test.case $level "G2 pane.moved observer: registry changed AND destination shell untouched" echo "rc=$RC regChanged=$([ "$(sha "$REG")" != "$RB" ] && echo yes || echo no) typed=$(typed "${LIVE}:0.1")"
if [ "$(sha "$REG")" = "$RB" ]; then no "RED: registry did NOT change (observer rejected/dispatched nothing) — destination check would be vacuous"
elif [ "$(capid "${LIVE}:0.1")" != "$DST0" ]; then no "DESTINATION TOUCHED: $(typed "${LIVE}:0.1") HIVEMIND_ROLE line(s) typed into ${LIVE}:0.1"
else ok "registry moved the row; destination shell byte-identical"; fi

# G3: direct panes.swapped observer -> registry DID change, both shells untouched
seed "${LIVE}:0.0|fxnk-alpha|1782659134" "${LIVE}:0.1|fxnk-beta|1782659134"
SA0=$(capid "${LIVE}:0.0"); SB0=$(capid "${LIVE}:0.1"); RB=$(sha "$REG")
hm protected.panes.swapped "$LIVE" "${LIVE}:0.0" "${LIVE}:0.1"; sleep 1.2
test.case $level "G3 panes.swapped observer: registry changed AND both shells untouched" echo "rc=$RC regChanged=$([ "$(sha "$REG")" != "$RB" ] && echo yes || echo no)"
if [ "$(sha "$REG")" = "$RB" ]; then no "RED: registry did NOT change (observer rejected) — untouched check would be vacuous"
elif [ "$(capid "${LIVE}:0.0")" != "$SA0" ] || [ "$(capid "${LIVE}:0.1")" != "$SB0" ]; then no "DESTINATION TOUCHED: typed 0.0=$(typed "${LIVE}:0.0") 0.1=$(typed "${LIVE}:0.1")"
else ok "rows swapped; both shells byte-identical"; fi

# G4: agent.rename (oosh-po ruling, expert e2e8c67e): BY DESIGN step 1 sends '/rename <new>@<host>'
# into the target pane, so whole-pane byte-identity is impossible for this verb. The hazard gated is the
# role_env INJECTION: zero 'export HIVEMIND_ROLE' lines in the destination, while the registry DID change.
seed "${LIVE}:0.1|fxnk-renamee|1782659134"
DST0=$(capid "${LIVE}:0.1"); RB=$(sha "$REG")
hm agent.rename fxnk-renamee fxnk-renamed; sleep 2.5
REN=$(capid "${LIVE}:0.1" | grep -c '/rename fxnk-renamed')
test.case $level "G4 agent.rename: registry changed AND no HIVEMIND_ROLE injected into the destination" echo "rc=$RC row=$(row "${LIVE}:0.1") typedRole=$(typed "${LIVE}:0.1") renameSent=$REN"
if [ "$(row "${LIVE}:0.1")" != fxnk-renamed ]; then no "RED: rename did not land in the registry (row='$(row "${LIVE}:0.1")') — injection check would be vacuous: $(echo "$OUT" | grep -iE 'invalid|rejected|not found' | head -1)"
elif [ "$(typed "${LIVE}:0.1")" -ne 0 ]; then no "INJECTED: $(typed "${LIVE}:0.1") 'export HIVEMIND_ROLE' line(s) typed into ${LIVE}:0.1"
else ok "renamed in registry; no HIVEMIND_ROLE injection (the designed /rename send seen x${REN})"; fi

# C2: real otmux session.rename -> sandbox rows rekeyed
seed "${LIVE}:0.0|fxnk-alpha|1782659134"
sbx otmux session.rename "$LIVE" "${LIVE}x" >>"$ALLOUT" 2>&1; sleep 0.8
test.case $level "C2 real otmux session.rename -> rows rekeyed" echo "new=$(row "${LIVE}x:0.0") old=$(row "${LIVE}:0.0")"
{ [ "$(row "${LIVE}x:0.0")" = fxnk-alpha ] && [ -z "$(row "${LIVE}:0.0")" ]; } \
  && ok "rows rekeyed on a real rename" || no "RED: after a real rename new='$(row "${LIVE}x:0.0")' old='$(row "${LIVE}:0.0")'"
fi

echo; echo "===== F — no 'command not found' in any call ====="
CNF=$(grep -c 'command not found' "$ALLOUT")
test.case $level "F zero 'command not found'" echo "count=$CNF"
[ "$CNF" -eq 0 ] && ok "no command-not-found" || no "RED: ${CNF}x command not found: $(grep -o 'this\.is[A-Za-z]*: command not found' "$ALLOUT" | sort | uniq -c | tr '\n' ' ')"

echo; echo "===== I — ISOLATION: live roles.env untouched ====="
LIVE_SHA_AFTER=$(sha "$LIVE_REG")
test.case $level "ISOLATION live roles.env sha256 unchanged" echo "${LIVE_SHA_BEFORE:0:12}..${LIVE_SHA_AFTER:0:12}"
[ "$LIVE_SHA_BEFORE" = "$LIVE_SHA_AFTER" ] && ok "live registry untouched" || no "LIVE REGISTRY MUTATED by the test"

echo
echo "=================================================================="
echo "  T-HIVEMIND-VALIDATORS  PASS=$pass FAIL=$fail"
echo "=================================================================="
sweep
test.suite.save.results
