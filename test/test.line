#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

#echo "sourcing init"
source this
source test.suite

log.level $level

competionArray=(once config list file ite)
source oo

test.line() 
{
((TEST_COUNTER++))
console.log "


Test 0: line \"$*\"
===================================================================="
line.start "$@"
console.log "RETURN: $RETURN_VALUE  Result: $RESULT 
===================================================================="
}

test.case - "line test start" \
   line usage
expect 0 "*" "Test start"

source line

# ============================================================================
# Regression: [args...] must be stripped from paramList (commit 58048e1)
# Without the fix, this generates: declare: '[args...]=addDefaultValue': not a valid identifier
# ============================================================================
test.case $level "completion: [args...] stripped from paramList" \
  echo "branch command [args...]" '|' line.parse.paramList.new

# Feed a parameter list containing [args...] through the parser
PARSE_OUTPUT=$(echo "branch command [args...]" | line.parse.paramList.new 2>&1)
PARSE_RC=$?

# Check no "not a valid identifier" error
if echo "$PARSE_OUTPUT" | grep -q 'not a valid identifier'; then
  expect.fail "paramList parser should not produce 'not a valid identifier' for [args...]"
else
  expect.pass "no invalid identifier error from [args...]"
fi

# Check that [args...] does not appear as a PARAM_ variable in the output
if echo "$PARSE_OUTPUT" | grep -q 'PARAM_\['; then
  expect.fail "paramList should strip [args...], not create PARAM_[args...]"
else
  expect.pass "[args...] stripped from paramList output"
fi

# Check that valid params (branch, command) are still parsed
PARAM_COUNT=$(echo "$PARSE_OUTPUT" | grep -c 'PARAM_' || true)
if [ "$PARAM_COUNT" -ge 1 ]; then
  expect.pass "valid PARAM_ variables generated ($PARAM_COUNT found)"
else
  expect.fail "should generate at least 1 PARAM_ variable"
fi

# ============================================================================
# T-FORMAT-1: line.format produces correct output with 3-arg format
# ============================================================================
test.case $level "line.format produces correct output with 3-arg format" \
  echo "checking"

FORMAT_TEST="[%s|%s|%s]"
RESULT=$(printf "'a'\n'b'\n'c'\n" | line.format FORMAT_TEST 2>&1)
if [ "$RESULT" = "[a|b|c]" ]; then
  create.result 0 "correct"
else
  create.result 1 "got: $RESULT"
fi
expect 0 "correct" "line.format with 3-arg format produces [a|b|c]"
unset FORMAT_TEST

# ============================================================================
# T-QUOTE-APOSTROPHE: line.quote must escape an embedded single quote
# ============================================================================
# line.format uses xargs as a QUOTED-FIELD PARSER — that is how a multi-column
# format gets its separate %s arguments. line.quote wrapped each line in '…'
# without escaping any ' inside it, so a single apostrophe broke the parse with
#   xargs: unmatched single quote…
# and took the whole pipeline with it. That is not cosmetic: this.help is built
# on this pipeline, so ONE apostrophe in ONE docstring broke `help` for the
# entire script — config, this, oo, ossh and user all carry one (only log does
# not). POSIX shell quoting escapes ' as '\'' ; that is what this pins.
test.case $level "line.quote escapes an embedded apostrophe" \
  echo "checking"

FORMAT_TEST="[%s]"
RESULT=$(printf "the user%ss thing\n" "'" | line.quote | line.format FORMAT_TEST 2>&1)
if [ "$RESULT" = "[the user's thing]" ]; then
  create.result 0 "apostrophe survives"
else
  create.result 1 "got: $RESULT"
fi
expect 0 "apostrophe survives" \
  "an apostrophe in a docstring must not break line.format (and so this.help)"
unset FORMAT_TEST

# ============================================================================
# T-FORMAT-INIT-EMPTY: an EMPTY lineFormat.env must not disable the formats
# ============================================================================
# private.line.format.init ends with `config save lineFormat "FORMAT_"`. If that
# ever leaves an empty file, an existence test (-f) sees it and skips the init
# forever: FORMAT_HELP stays unset, line.format gets an empty format string, and
# this.help renders NOTHING for every script. Seen on a live host and in a fresh
# container — lineFormat.env at 0 bytes, and `odocker` printing an empty
# Usage table. The guard must test CONTENT (-s), not existence.
test.line.formatInitSurvivesEmptyFile() {
  local fx; fx=$(mktemp -d "/tmp/test.line.fmt.XXXXXX")
  : > "$fx/lineFormat.env"          # exists, empty — the broken state
  local got
  got=$(bash -c '
    export OOSH_DIR="'"$OOSH_DIR"'"; export PATH="$OOSH_DIR:$OOSH_DIR/ng:$PATH"
    source "$OOSH_DIR/this" >/dev/null 2>&1
    export CONFIG_PATH="'"$fx"'"
    source "$OOSH_DIR/line" >/dev/null 2>&1
    [ -n "$FORMAT_HELP" ] && echo SET || echo UNSET
  ' 2>/dev/null | tail -1)
  rm -rf "$fx"
  if [ "$got" = "SET" ]; then
    create.result 0 "formats initialised despite an empty file"
  else
    create.result 1 "FORMAT_HELP $got — an empty lineFormat.env disabled this.help tree-wide"
  fi
}
test.case $level "an empty lineFormat.env must not disable the formats" \
  test.line.formatInitSurvivesEmptyFile
expect 0 "formats initialised despite an empty file" \
  "the guard must test content, not existence — otherwise this.help renders nothing"

# ============================================================================
# T-QUOTE-ROUNDTRIP: line.quote and line.unquote must mirror each other
# ============================================================================
# line.quote escapes an embedded ' so xargs can parse the field back. If
# line.unquote strips only the OUTER quotes, the round-trip is lossy and the
# escape leaks downstream — which broke c2's completion.discover (its pipeline
# quotes and unquotes the same data) while every line test still passed. The two
# must be inverses; this pins that, not just the escaping.
test.line.quoteUnquoteRoundTrip() {
  local probe got
  probe="the user's thing"
  got=$(printf '%s\n' "$probe" | line.quote | line.unquote)
  if [ "$got" = "$probe" ]; then
    create.result 0 "round-trip is lossless"
  else
    create.result 1 "in [$probe] out [$got]"
  fi
}
test.case $level "line.quote | line.unquote round-trips an apostrophe" \
  test.line.quoteUnquoteRoundTrip
expect 0 "round-trip is lossless" \
  "quote and unquote must be inverses — c2 depends on it"

test.suite.save.results
