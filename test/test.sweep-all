#!/usr/bin/env bash
# T-SWEEP-ALL — task-s2-h (ddfcf51): team.sweep no-arg = FLEET dashboard, a
# PROJECTION of the c.0 live-reader. Spec: task-s2-h-team-sweep-fleet-dashboard.md
# Contract:
#   • no-arg lists EVERY active team the c.0 reader sees (none omitted — PF3 guard).
#   • team header `N agents · M shells` == the c.0 tuple's agent/shell counts.
#   • agent lines show STATE + bg-shells `sh:K` + context `ctx NN%`; a low-ctx
#     agent (≤20%) shows the ⚠ cliff; shell rows show `shell`.
#   • PF3 regression guard: the fn READS `live.tupleset`, does NOT roll its own
#     HIVEMIND_REGISTRY / agents.discover enumeration (list-panes for pane_pid OK).

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

STRIP='s/\x1b\[[0-9;]*m//g'

# ── One fleet sweep + one canonical tuple read (both batch) ──────────────────
SWEEP=$(timeout 60 hiveMind team.sweep 2>/dev/null | sed -E "$STRIP")
TUPLE=$(hiveMind protected.live.tupleset 2>/dev/null | awk -F'|' 'NF==9{print}')

# ============================================================================
# SA-ALL-TEAMS [B] — every live team the c.0 reader sees appears in the no-arg
# sweep (PF3: a team is NEVER silently dropped).
# ============================================================================
TUPLE_TEAMS=$(printf '%s\n' "$TUPLE" | awk -F'|' '$7!="remote-unreachable"{print $2}' | sort -u | grep .)
SWEEP_TEAMS=$(printf '%s\n' "$SWEEP" | awk '/^TEAM /{print $2}' | sort -u | grep .)
MISSING=$(comm -23 <(printf '%s\n' "$TUPLE_TEAMS") <(printf '%s\n' "$SWEEP_TEAMS"))
MISSING_N=$(printf '%s' "$MISSING" | grep -c .)
test.case $level "SA-ALL-TEAMS: no-arg sweep lists every live team (PF3 — none omitted)" \
  echo "tupleTeams=$(printf '%s' "$TUPLE_TEAMS" | grep -c .) sweepTeams=$(printf '%s' "$SWEEP_TEAMS" | grep -c .) missing=$MISSING_N"
if [ "$MISSING_N" -eq 0 ] && [ "$(printf '%s' "$SWEEP_TEAMS" | grep -c .)" -ge 1 ]; then
  expect.pass "all $(printf '%s' "$TUPLE_TEAMS" | grep -c .) live teams present in the fleet sweep"
else
  expect.fail "sweep OMITS live team(s): $(printf '%s' "$MISSING" | tr '\n' ' ') [PF3 regression]"
fi

# ============================================================================
# SA-HEADER-COUNTS [B] — each team header `N agents · M shells` == the c.0
# tuple's counts for that session.
# ============================================================================
MISMATCH=""
while IFS= read -r team; do
  [ -z "$team" ] && continue
  hdr=$(printf '%s\n' "$SWEEP" | awk -v t="$team" '$1=="TEAM" && $2==t{print; exit}')
  hA=$(printf '%s' "$hdr" | grep -oE '[0-9]+ agents' | grep -oE '[0-9]+')
  hS=$(printf '%s' "$hdr" | grep -oE '[0-9]+ shells' | grep -oE '[0-9]+')
  tA=$(printf '%s\n' "$TUPLE" | awk -F'|' -v t="$team" '$2==t && $7=="agent"{c++} END{print c+0}')
  tS=$(printf '%s\n' "$TUPLE" | awk -F'|' -v t="$team" '$2==t && $7=="shell"{c++} END{print c+0}')
  [ "${hA:-x}" = "$tA" ] && [ "${hS:-x}" = "$tS" ] || MISMATCH="${MISMATCH}${team}(hdr:${hA}a/${hS}s vs tuple:${tA}a/${tS}s) "
done <<< "$TUPLE_TEAMS"
test.case $level "SA-HEADER-COUNTS: team header 'N agents · M shells' == c.0 tuple counts" \
  echo "mismatch='${MISMATCH:-none}'"
if [ -z "$MISMATCH" ]; then
  expect.pass "every team header matches the canonical tuple agent/shell counts"
else
  expect.fail "header/tuple count mismatch: $MISMATCH"
fi

# ============================================================================
# SA-AGENT-SIGNALS [B] — agent lines carry STATE + bg-shells `sh:K`; at least one
# agent shows `ctx NN%`; shell rows show `shell`.
# ============================================================================
HAS_SHK=$(printf '%s\n' "$SWEEP" | grep -cE 'sh:[0-9]+')
HAS_CTX=$(printf '%s\n' "$SWEEP" | grep -cE 'ctx [0-9]+%')
HAS_SHELLROW=$(printf '%s\n' "$SWEEP" | grep -cE '[[:space:]]shell[[:space:]]*$')
test.case $level "SA-AGENT-SIGNALS: agent lines show sh:K + ctx NN%; shells show 'shell'" \
  echo "shK=$HAS_SHK ctx=$HAS_CTX shellRows=$HAS_SHELLROW"
if [ "${HAS_SHK:-0}" -ge 1 ] && [ "${HAS_CTX:-0}" -ge 1 ] && [ "${HAS_SHELLROW:-0}" -ge 1 ]; then
  expect.pass "sh:K present ($HAS_SHK), ctx% present ($HAS_CTX), shell rows present ($HAS_SHELLROW)"
else
  expect.fail "missing signals: shK=$HAS_SHK ctx=$HAS_CTX shellRows=$HAS_SHELLROW"
fi

# ============================================================================
# SA-CLIFF [B] — every agent line with ctx ≤20% carries the ⚠ cliff flag.
# ============================================================================
LOWCTX=$(printf '%s\n' "$SWEEP" | grep -E 'ctx [0-9]+%' | awk 'match($0,/ctx ([0-9]+)%/,m){if(m[1]<=20) print}')
LOW_N=$(printf '%s' "$LOWCTX" | grep -c .)
LOW_NO_WARN=$(printf '%s\n' "$LOWCTX" | grep -vc '⚠')
# grep -vc counts non-matching lines; on empty input it prints 0.
[ -z "$LOWCTX" ] && LOW_NO_WARN=0
test.case $level "SA-CLIFF: every agent with ctx ≤20% shows the ⚠ cliff" \
  echo "lowCtxLines=$LOW_N withoutWarn=$LOW_NO_WARN"
if [ "${LOW_NO_WARN:-1}" -eq 0 ]; then
  expect.pass "$LOW_N low-context line(s), all carry ⚠ (or none present)"
else
  expect.fail "$LOW_NO_WARN low-context line(s) missing the ⚠ cliff flag"
fi

# ============================================================================
# SA-PF3-NOREENUM [S] — the fn PROJECTS off live.tupleset; it does NOT roll its
# own registry/agents.discover enumeration (the list-panes for pane_pid is OK).
# ============================================================================
SW=$(sed -n '/^hiveMind.team.sweep()/,/^}/p' "$OOSH_DIR/hiveMind")
USES_READER=$(printf '%s\n' "$SW" | grep -cE 'live\.tupleset')
REENUM=$(printf '%s\n' "$SW" | grep -cE 'HIVEMIND_REGISTRY|agents\.discover')
test.case $level "SA-PF3-NOREENUM: team.sweep reads live.tupleset, no registry re-enumeration" \
  echo "usesReader=$USES_READER reEnum=$REENUM"
if [ "${USES_READER:-0}" -ge 1 ] && [ "${REENUM:-1}" -eq 0 ]; then
  expect.pass "projects off c.0 live.tupleset; zero HIVEMIND_REGISTRY/agents.discover re-enumeration (PF3-clean)"
else
  expect.fail "PF3 anti-pattern: usesReader=$USES_READER reEnum=$REENUM"
fi

echo ""
echo "=== T-SWEEP-ALL complete ==="
echo ""

test.suite.save.results
