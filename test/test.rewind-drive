#!/usr/bin/env bash
# T-REWIND-DRIVE — task-s2-j (ef8ec82): peer-driven /rewind. SAFE-SURFACE gate.
# Spec: scrum.pmo/sprints/sprint-2/task-s2-j-peer-driven-rewind.md
#
# Law (correct-by-construction): NEVER leave the agent worse off. Refuse/fail-safe
# on any doubt; missing a rewind is cheap, corrupting a live session is not.
#
# SAFE cells verified here (NO live rewind): the refuse guards fire BEFORE any
# keystroke touches the pane, and the critical safety mechanisms are locked in
# source. The DESTRUCTIVE live cells — (d) idle-authorized peer drives the picker,
# (e) select-stall→agent-unharmed, (f) concurrent-send-held — actually rewind a
# REAL agent (irreversible) and are NOT run here: they need explicit Tron/PO
# authorization + a designated sacrificial peer. Tracked in the report-back.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

OT="$OOSH_DIR/otmux"; HM="$OOSH_DIR/hiveMind"
WORK="${TMPDIR:-/tmp}/test.rewind-drive.$$"; mkdir -p "$WORK/bin"; cp /bin/cat "$WORK/bin/claude" 2>/dev/null
HAVE=1; [ -z "$(command -v tmux)" ] && HAVE=0

# ── (b) RD-NOT-IDLE-REFUSE [B]: drive on a non-idle pane → rc3, and it posts NO
# /rewind (refuses BEFORE touching the pane). ────────────────────────────────
if [ "$HAVE" -eq 1 ] && tmux new-session -d -s "__rdni_$$" 2>/dev/null; then
  NIP="__rdni_$$:0.0"
  tmux send-keys -t "$NIP" "PS1='oosh > '" Enter; sleep 0.5
  otmux rewind.drive "$NIP" >/dev/null 2>&1; NI_RC=$?
  POSTED=$(tmux capture-pane -t "$NIP" -p 2>/dev/null | grep -c '/rewind')
  test.case $level "RD-NOT-IDLE-REFUSE: non-idle pane → refuse (rc3), NO /rewind posted" \
    echo "rc=$NI_RC posted=$POSTED"
  if [ "$NI_RC" -eq 3 ] && [ "${POSTED:-1}" -eq 0 ]; then
    expect.pass "refused rc3 before touching the pane (zero /rewind posted)"
  else
    expect.fail "rc=$NI_RC posted=$POSTED (want rc3, 0 posted)"
  fi
  tmux kill-session -t "__rdni_$$" 2>/dev/null
else
  test.case $level "RD-NOT-IDLE-REFUSE: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
fi

# ── (b') RD-BUSY-REFUSE [B]: a GENERATING pane ('esc to interrupt') → rc3, never
# interrupt. Fake-claude agent pane put into a generating display. ───────────
if [ "$HAVE" -eq 1 ] && tmux new-session -d -s "__rdbusy_$$" 2>/dev/null; then
  BP="__rdbusy_$$:0.0"
  tmux send-keys -t "$BP" "PATH=$WORK/bin:\$PATH claude" Enter; sleep 1
  tmux send-keys -t "$BP" -l "esc to interrupt"; tmux send-keys -t "$BP" Enter; sleep 0.5
  otmux rewind.drive "$BP" >/dev/null 2>&1; B_RC=$?
  POSTED_B=$(tmux capture-pane -t "$BP" -p 2>/dev/null | grep -c '/rewind')
  test.case $level "RD-BUSY-REFUSE: generating pane → refuse (rc3), no interrupt" \
    echo "rc=$B_RC posted=$POSTED_B"
  if [ "$B_RC" -eq 3 ] && [ "${POSTED_B:-1}" -eq 0 ]; then
    expect.pass "refused rc3 on a generating pane — never interrupts"
  else
    expect.fail "rc=$B_RC posted=$POSTED_B (want rc3, 0 posted)"
  fi
  tmux kill-session -t "__rdbusy_$$" 2>/dev/null
else
  test.case $level "RD-BUSY-REFUSE: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
fi

# ── (a) RD-SELF-REFUSE [S]: driving one's OWN pane is refused (rc1). ─────────
DRV=$(sed -n '/^otmux.rewind.drive()/,/^}/p' "$OT")
SELF_GUARD=$(printf '%s\n' "$DRV" | grep -B1 -iE 'cannot rewind SELF|== *"?\$\(otmux pane.self|pane\.self' | grep -c 'return 1')
[ "$SELF_GUARD" -eq 0 ] && SELF_GUARD=$(printf '%s\n' "$DRV" | grep -ciE 'REFUSED.*SELF')
test.case $level "RD-SELF-REFUSE [S]: rewind.drive refuses SELF (rc1) before touching" \
  echo "selfGuard=$SELF_GUARD"
if [ "${SELF_GUARD:-0}" -ge 1 ]; then
  expect.pass "SELF==pane.self → REFUSED rc1 (peer/Tron only)"
else
  expect.fail "no SELF-refuse guard in rewind.drive"
fi

# ── (c) RD-AUTH-REFUSE [S]: agent.rewind default-refuses without Tron auth,
# BEFORE it delegates to rewind.drive (no keystroke). ────────────────────────
ARB=$(sed -n '/hiveMind.agent.rewind()/,/^}/p' "$HM")
AUTH_LINE=$(printf '%s\n' "$ARB" | grep -n 'HIVEMIND_REWIND_AUTHORIZED\|REFUSED.*authoriz' | head -1 | cut -d: -f1)
# the real delegation CALL (has a quoted arg), not the signature comment (arrow).
DRIVE_LINE=$(printf '%s\n' "$ARB" | grep -nE 'otmux\.rewind\.drive "' | head -1 | cut -d: -f1)
DEFAULT_REFUSE=$(printf '%s\n' "$ARB" | grep -c 'return 1')
test.case $level "RD-AUTH-REFUSE [S]: agent.rewind default-refuse (auth gate BEFORE drive)" \
  echo "authLine=$AUTH_LINE driveLine=$DRIVE_LINE"
if [ -n "$AUTH_LINE" ] && [ -n "$DRIVE_LINE" ] && [ "$AUTH_LINE" -lt "$DRIVE_LINE" ] && [ "${DEFAULT_REFUSE:-0}" -ge 1 ]; then
  expect.pass "Tron-auth gate (default-refuse) precedes the keystroke delegation (line $AUTH_LINE < $DRIVE_LINE)"
else
  expect.fail "auth gate missing/after drive: authLine=$AUTH_LINE driveLine=$DRIVE_LINE"
fi

# ── (e-mechanism) RD-FAILSAFE-SRC [S]: an un-verified step → rewind.failsafe
# (Escape out → verify idle ❯ UNHARMED) → rc2; NEVER a blind re-Enter. ───────
FS_RC2=$(printf '%s\n' "$DRV" | grep -cE 'rewind.failsafe')
FS_RETURN2=$(printf '%s\n' "$DRV" | grep -cE 'return 2')
FS_UNHARMED=$(sed -n '/private.otmux.rewind.failsafe()/,/^}/p' "$OT" | grep -cE "grep -q '❯'")
test.case $level "RD-FAILSAFE-SRC [S]: unverified step → failsafe (Escape→idle-unharmed)→rc2, no blind re-Enter" \
  echo "failsafeCalls=$FS_RC2 rc2=$FS_RETURN2 unharmedCheck=$FS_UNHARMED"
if [ "${FS_RC2:-0}" -ge 1 ] && [ "${FS_RETURN2:-0}" -ge 1 ] && [ "${FS_UNHARMED:-0}" -ge 1 ]; then
  expect.pass "picker-not-open/vanished → Escape-out + verify idle ❯ unharmed → rc2 (stalled-safe)"
else
  expect.fail "fail-safe not first-class: failsafe=$FS_RC2 rc2=$FS_RETURN2 unharmed=$FS_UNHARMED"
fi

# ── (f-mechanism) RD-POKE-GUARD + CLEAR-EVERY-EXIT + REAP-RC0 [S]: agent.rewind
# sets DURING_REWIND before the drive (holds concurrent sends), ALWAYS clears it,
# and reaps ONLY on rc0. ─────────────────────────────────────────────────────
SET_BEFORE=$(printf '%s\n' "$ARB" | awk '/state.set.*DURING_REWIND/{s=NR} /otmux.rewind.drive/{d=NR} END{print (s>0 && d>0 && s<d)?"yes":"no"}')
ALWAYS_CLEAR=$(printf '%s\n' "$ARB" | awk '/otmux.rewind.drive/{d=NR} /state.clear/{c=NR} END{print (c>0 && d>0 && c>d)?"yes":"no"}')
REAP_RC0=$(printf '%s\n' "$ARB" | awk '/rc" -eq 0|rc -eq 0/{g=1} g&&/shell.reap/{print "yes"; exit}')
test.case $level "RD-POKE-GUARD/CLEAR/REAP [S]: DURING_REWIND set-before + clear-every-exit + reap-rc0-only" \
  echo "setBefore=$SET_BEFORE alwaysClear=$ALWAYS_CLEAR reapRc0=$REAP_RC0"
if [ "$SET_BEFORE" = yes ] && [ "$ALWAYS_CLEAR" = yes ] && [ "$REAP_RC0" = yes ]; then
  expect.pass "poke-guard set before drive; state cleared on EVERY exit; shell.reap only on rc0"
else
  expect.fail "controller contract broken: setBefore=$SET_BEFORE clear=$ALWAYS_CLEAR reapRc0=$REAP_RC0"
fi

rm -rf "$WORK" 2>/dev/null

echo ""
echo "=== T-REWIND-DRIVE (safe surface) complete ==="
echo "  NOTE: destructive live cells (d idle-drive / e select-stall-unharmed /"
echo "  f concurrent-send-held) require Tron/PO authorization + a sacrificial"
echo "  peer — NOT run here (would irreversibly rewind a real agent)."
echo ""

test.suite.save.results
