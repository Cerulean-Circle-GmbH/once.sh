#!/usr/bin/env bash
# T-SEND-SESSION — otmux send g.1: branch on target KIND (expert 188971a).
# Contract (send-reliability gate g.1):
#   • send to a NON-CLAUDE target (shell/ssh) COMPLETES: stage+Enter, NO Escape,
#     NO poke — the command dispatches, rc 0, no TUI-protocol misfire/hang.
#   • a BARE SESSION name resolves to that session's ACTIVE pane and dispatches.
#   • (regression, run separately) the CLAUDE path still passes
#     T-DISPATCH-SUBMIT 5/5 — g.1 only re-branches the orchestrator, the OTR-1
#     primitives are untouched.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

if [ -z "$(command -v tmux)" ] || ! tmux new-session -d -s "__sendses_$$" -x 100 -y 30 2>/dev/null; then
  for t in SHELL-COMPLETES NON-CLAUDE-PATH BARE-SESSION; do
    test.case $level "T-SEND-SESSION-$t: (skipped — no tmux)" echo "skip"
    expect.pass "skipped"
  done
  echo ""; echo "=== T-SEND-SESSION (skipped — no tmux) ==="; echo ""
  test.suite.save.results
  return 0 2>/dev/null || exit 0
fi

SS="__sendses_$$"
P="${SS}:0.0"
tmux send-keys -t "$P" "PS1='oosh > '" Enter; sleep 0.5

# ── T-SEND-SESSION-SHELL-COMPLETES: send to a shell pane dispatches (rc0) ────
MARK="SENDMARK_$$"
otmux send "$P" "echo $MARK" >/dev/null 2>&1; RC_SHELL=$?
sleep 1
CAP=$(otmux pane.capture "$P" 20 2>/dev/null)
# A standalone line == the marker is the echo OUTPUT → the command actually
# dispatched (Enter fired), not merely staged on the input line.
DISPATCHED=$(printf '%s\n' "$CAP" | grep -cE "^${MARK}$")
test.case $level "T-SEND-SESSION-SHELL-COMPLETES: shell send dispatches (rc 0)" \
  echo "rc=$RC_SHELL dispatched=$DISPATCHED"
if [ "$RC_SHELL" -eq 0 ] && [ "${DISPATCHED:-0}" -ge 1 ]; then
  expect.pass "shell send rc 0 and command dispatched (marker output present)"
else
  expect.fail "shell send did not complete/dispatch: rc=$RC_SHELL dispatched=$DISPATCHED"
fi

# ── T-SEND-SESSION-NON-CLAUDE-PATH: shell target takes the no-poke/no-Escape
# branch (console.log names the "(shell)" path; claude path would say
# "send.verified: SUBMITTED"). Confirms no TUI poke/Escape fired. ─────────────
SEND_OUT=$(otmux send "$P" "echo path_probe_$$" 2>&1); RC_PATH=$?
test.case $level "T-SEND-SESSION-NON-CLAUDE-PATH: shell send uses no-poke/no-Escape path" \
  echo "rc=$RC_PATH"
if [ "$RC_PATH" -eq 0 ] && printf '%s' "$SEND_OUT" | grep -qiE '\(shell\)|dispatched to'; then
  expect.pass "non-claude path taken (stage+Enter, no poke/Escape)"
elif [ "$RC_PATH" -eq 0 ] && ! printf '%s' "$SEND_OUT" | grep -qi 'poke'; then
  expect.pass "shell send rc 0 with no poke (non-claude path)"
else
  expect.fail "shell send took claude/poke path or hung: rc=$RC_PATH out=$(printf '%s' "$SEND_OUT" | head -1)"
fi

# ── T-SEND-SESSION-BARE-SESSION: a bare session name → active pane dispatch ──
BMARK="BAREMARK_$$"
otmux send "$SS" "echo $BMARK" >/dev/null 2>&1; RC_BARE=$?
sleep 1
ACTIVE=$(tmux display-message -p -t "$SS" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)
CAP_B=$(otmux pane.capture "$ACTIVE" 20 2>/dev/null)
DISP_B=$(printf '%s\n' "$CAP_B" | grep -cE "^${BMARK}$")
test.case $level "T-SEND-SESSION-BARE-SESSION: bare session resolves to active pane" \
  echo "rc=$RC_BARE active=$ACTIVE dispatched=$DISP_B"
if [ "$RC_BARE" -eq 0 ] && [ "${DISP_B:-0}" -ge 1 ]; then
  expect.pass "bare session '$SS' → active pane $ACTIVE, dispatched"
else
  expect.fail "bare session send failed: rc=$RC_BARE active=$ACTIVE dispatched=$DISP_B"
fi

# ── Cleanup ──────────────────────────────────────────────────────────────────
tmux kill-session -t "$SS" 2>/dev/null

echo ""
echo "=== T-SEND-SESSION tests complete ==="
echo ""

test.suite.save.results
