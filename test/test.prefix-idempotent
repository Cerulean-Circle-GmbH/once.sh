#!/usr/bin/env bash
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T-PREFIX-IDEMPOTENT — BUG 9 guard (Tron 2026-06-28)
# ============================================================================
# otmux.send prepends a sender prefix [@role pane] to Claude-Code-bound text.
# It MUST be idempotent: text that ALREADY starts with [@ must NOT be prefixed
# again (no [@x][@x] duplication). The chokepoint guard (otmux.send Step 2)
# applies the prefix only when: isClaudeCode AND text != /* AND text != [@*.
#
# Functional test of the idempotency predicate `[[ "$text" != \[@* ]]`.

# Mirror the exact guard predicate from otmux.send (text-side only)
wouldPrefix() { # <text>  → echo PREFIX or SKIP
  local text="$1"
  if [[ "$text" != /* ]] && [[ "$text" != \[@* ]]; then
    echo "PREFIX"
  else
    echo "SKIP"
  fi
}

# 1. Already-prefixed text → SKIP (the BUG 9 case)
r=$(wouldPrefix "[@oosh-expert ooshTeam:0.3] hello")
test.case $level "already-prefixed text is NOT re-prefixed" echo "$r"
if [ "$r" = "SKIP" ]; then
  expect.pass "[@…] prefixed text skips a second prefix"
else
  expect.fail "already-prefixed text would be prefixed again ($r)"
fi

# 2. Plain prose → PREFIX (normal path still works)
r=$(wouldPrefix "hello world")
test.case $level "plain prose gets a prefix" echo "$r"
if [ "$r" = "PREFIX" ]; then
  expect.pass "unprefixed prose is prefixed"
else
  expect.fail "plain prose did not get a prefix ($r)"
fi

# 3. Slash command → SKIP (unchanged behavior)
r=$(wouldPrefix "/model claude-opus-4-8")
test.case $level "/command is not prefixed" echo "$r"
if [ "$r" = "SKIP" ]; then
  expect.pass "slash commands skip prefix"
else
  expect.fail "slash command would be prefixed ($r)"
fi

# 4. Source-level: the live guard contains the [@ idempotency condition
test.case $level "otmux.send guard has [@ idempotency condition" echo "check"
if grep -qE 'isClaudeCode "\$target".*text" != \\\[@\*' "$OOSH_DIR/otmux" 2>/dev/null; then
  expect.pass "live guard skips already-prefixed text"
else
  expect.fail "otmux.send guard missing the [@ condition"
fi

test.suite.save.results
