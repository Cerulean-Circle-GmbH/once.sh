#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=3
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$1>"

#echo "sourcing init"
source this
source test.suite

log.level $level
this.isSourced

important.log "
now in ${BASH_SOURCE[@]##*/}
"

echo "
Test 0: this.call this.isSourced
===================================================================="
this.call this.isSourced
echo "RETURN: $RETURN_VALUE  Result: $RESULT 
====================================================================

"

test.case - "source mycmd permanently" \
  source mycmd
if [ "$RETURN_VALUE" -eq 0 ] && type -t mycmd.feature3 >/dev/null 2>&1; then
  expect.pass "mycmd sourced and mycmd.feature3 is defined"
else
  expect.fail "source mycmd rc=$RETURN_VALUE, mycmd.feature3=$(type -t mycmd.feature3 2>/dev/null)"
fi

test.case - "use sourced mycmd and call feature3 directly" \
  mycmd.feature3 hello world
if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "mycmd.feature3 ran from the sourced script"
else
  expect.fail "mycmd.feature3 rc=$RETURN_VALUE result=$RESULT"
fi

test.suite.save.results
