#!/usr/bin/env bash
# TC-02.1 — send.verified SHELL verify is kind-branched (task-02, ca6b085).
# A shell has no ❯ region, so its commit-check is prompt-advance, with an
# HONEST log LEVEL (not just rc):
#   • real command that RUNS (prompt advanced) → info.log
#     'send.verified: committed to <t> (shell — prompt advanced)' + rc 0, NO warn.
#   • WEDGED shell (Enter doesn't apply, prompt unchanged) → warn.log
#     'send.verified: <t> — Enter did not apply, text still staged, prompt
#     unchanged (rc 2)' + rc 2.
# Assert the LOG LEVEL (info vs warn), not just the rc. (Exactly-one-Enter is
# covered by test.send-selfheal V5.)

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

OTMUX_SRC="$OOSH_DIR/otmux"
R=$(command -v tmux)

# ── TC02-LOG-LEVEL-SRC [S]: the shell branch chooses info.log for committed and
# warn.log for wedged — the log-LEVEL distinction, locked in source. ─────────
VBODY=$(sed -n '/^otmux.send.verified()/,/^}/p' "$OTMUX_SRC")
COMMIT_INFO=$(printf '%s\n' "$VBODY" | grep -cE 'info\.log "send.verified: committed to \$target \(shell')
WEDGE_WARN=$(printf '%s\n' "$VBODY" | grep -cE 'warn\.log "send.verified: \$target — Enter did not apply')
test.case $level "TC02-LOG-LEVEL-SRC: committed→info.log, wedged→warn.log (shell branch)" \
  echo "commitInfo=$COMMIT_INFO wedgeWarn=$WEDGE_WARN"
if [ "${COMMIT_INFO:-0}" -ge 1 ] && [ "${WEDGE_WARN:-0}" -ge 1 ]; then
  expect.pass "committed logs at INFO, wedged logs at WARN — the honest log-level branch"
else
  expect.fail "log-level branch missing: commitInfo=$COMMIT_INFO wedgeWarn=$WEDGE_WARN"
fi

if [ -z "$R" ]; then
  test.case $level "TC02-COMMIT: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
  test.case $level "TC02-WEDGED: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
  echo ""; echo "=== TC-02.1 (skipped — no tmux) ==="; echo ""; test.suite.save.results
  return 0 2>/dev/null || exit 0
fi

# ── TC02-COMMIT [B]: real command RUNS → rc0 + INFO log (no WARNING). ────────
if $R new-session -d -s "__tcc_$$" 2>/dev/null; then
  CP="__tcc_$$:0.0"
  $R send-keys -t "$CP" "PS1='oosh > '" Enter; sleep 0.5
  COUT=$(LOG_LEVEL=4 LOG_DEVICE=/dev/stdout otmux send.verified "$CP" "echo TCC_$$" 2>&1); CRC=$?
  COUT=$(printf '%s\n' "$COUT" | sed -E 's/\x1b\[[0-9;]*m//g')
  C_MSG=$(printf '%s\n' "$COUT" | grep -c 'prompt advanced')
  C_WARN=$(printf '%s\n' "$COUT" | grep 'prompt advanced' | grep -c 'WARNING')
  test.case $level "TC02-COMMIT: shell command runs → rc0 + INFO 'committed (prompt advanced)', no warn" \
    echo "rc=$CRC msg=$C_MSG warnOnMsg=$C_WARN"
  if [ "$CRC" -eq 0 ] && [ "${C_MSG:-0}" -ge 1 ] && [ "${C_WARN:-1}" -eq 0 ]; then
    expect.pass "rc0, logged at INFO level (committed — prompt advanced), zero WARNING"
  else
    expect.fail "rc=$CRC msg=$C_MSG warnOnMsg=$C_WARN (want rc0, msg present, no WARNING)"
  fi
  $R kill-session -t "__tcc_$$" 2>/dev/null
else
  test.case $level "TC02-COMMIT: (skipped — session)" echo "skip"; expect.pass "skipped"
fi

# ── TC02-WEDGED [B]: a foreground `sleep` holds the terminal → Enter can't apply,
# prompt unchanged → rc2 + WARN log. ─────────────────────────────────────────
if $R new-session -d -s "__tcw_$$" 2>/dev/null; then
  WP="__tcw_$$:0.0"
  $R send-keys -t "$WP" "PS1='oosh > '" Enter; sleep 0.4
  $R send-keys -t "$WP" "sleep 300" Enter; sleep 0.6   # wedge: shell blocked on sleep
  WOUT=$(LOG_LEVEL=4 LOG_DEVICE=/dev/stdout otmux send.verified "$WP" "WDG_$$" 2>&1); WRC=$?
  WOUT=$(printf '%s\n' "$WOUT" | sed -E 's/\x1b\[[0-9;]*m//g')
  W_MSG=$(printf '%s\n' "$WOUT" | grep -c 'did not apply')
  W_WARN=$(printf '%s\n' "$WOUT" | grep 'did not apply' | grep -c 'WARNING')
  test.case $level "TC02-WEDGED: wedged shell → rc2 + WARN 'Enter did not apply, prompt unchanged'" \
    echo "rc=$WRC msg=$W_MSG warnOnMsg=$W_WARN"
  if [ "$WRC" -eq 2 ] && [ "${W_MSG:-0}" -ge 1 ] && [ "${W_WARN:-0}" -ge 1 ]; then
    expect.pass "rc2, logged at WARN level (Enter did not apply — prompt unchanged)"
  else
    expect.fail "rc=$WRC msg=$W_MSG warnOnMsg=$W_WARN (want rc2, msg present WITH WARNING)"
  fi
  $R kill-session -t "__tcw_$$" 2>/dev/null
else
  test.case $level "TC02-WEDGED: (skipped — session)" echo "skip"; expect.pass "skipped"
fi

echo ""
echo "=== TC-02.1 shell-verify (log-level branch) complete ==="
echo ""

test.suite.save.results
