#!/usr/bin/env bash
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# Verify $HOME/.ssh/config (the current user's config) contains the canonical
# Host aliases — WODA.test, WODA.dev.root, WODA.dev — with their fields, each
# line checked INSIDE that Host's own block. A tree-wide grep lets one block
# satisfy another block's requirement: until 2026-11-02 the test required
# "User root" for WODA.test but only grepped the whole file, so moving
# WODA.test to developking still passed on WODA.dev.root's "User root".
#
# WODA.test and WODA.dev log in as developking; WODA.dev.root is the root
# alias (User root) and only borrows the developking identity, which is
# checked separately by platform.ssh.config.woda.portable + ssh.config.invariant.

cfg="$HOME/.ssh/config"

test.case $level "ssh.config.woda: $USER has ~/.ssh/config" test -f "$cfg"
if [ ! -f "$cfg" ]; then
  expect.fail "$cfg missing"
  test.suite.save.results
  return 0 2>/dev/null || exit 0
else
  expect.pass "$cfg present"
fi

# <host> # print every line of the Host block that names <host>
woda.block() {
  awk -v host="$1" '
    /^[[:space:]]*Host[[:space:]]/ {
      inside = 0
      for (i = 2; i <= NF; i++) if ($i == host) inside = 1
      if (inside) { print; next }
    }
    inside && /^[[:space:]]*Match[[:space:]]/ { inside = 0 }
    inside { print }
  ' "$cfg"
}

# Required fixed-string lines, each scoped to its Host block (Host header +
# non-path fields). The presence of the three Host headers + their
# User/HostName is sufficient to detect the regression we care about (configs
# wiped by user.init).
required_lines=(
  # WODA.test
  "WODA.test::Host WODA.test"
  "WODA.test::User developking"
  "WODA.test::HostName 178.254.18.182"
  "WODA.test::IdentityFile ~/.ssh/ids/ssh.developking/id_rsa"
  # WODA.dev.root
  "WODA.dev.root::Host WODA.dev.root"
  "WODA.dev.root::User root"
  "WODA.dev.root::HostName cerulean.it"
  "WODA.dev.root::IdentityFile ~/.ssh/id_ed25519"
  # WODA.dev
  "WODA.dev::Host WODA.dev"
  "WODA.dev::User developking"
  "WODA.dev::HostName cerulean.it"
  "WODA.dev::IdentityFile ~/.ssh/ids/ssh.developking/id_rsa"
)

missing=()
for req in "${required_lines[@]}"; do
  label="${req%%::*}"
  line="${req#*::}"
  if ! woda.block "$label" | grep -Fq -- "$line"; then
    missing+=("[$label] $line")
  fi
done

test.case $level "ssh.config.woda: $USER contains all WODA fields" true
if [ ${#missing[@]} -eq 0 ]; then
  expect.pass "$USER has all required Host aliases and fields"
else
  expect.fail "$USER $cfg is missing: $(printf '%s; ' "${missing[@]}")"
fi


# github.com is not a line of ~/.ssh/config anymore: every user reads it from
# the system file of OpenSSH (ossh config.shared.github.create). `ssh -G`
# shows what ssh uses, from either place.
test.case $level "ssh.config.woda: $USER resolves github.com as user git, HostName github.com" true
ghResolved=$(ssh -G github.com 2>/dev/null)
if printf '%s\n' "$ghResolved" | grep -qx 'user git' && printf '%s\n' "$ghResolved" | grep -qx 'hostname github.com'; then
  expect.pass "github.com resolves to git@github.com"
else
  expect.fail "ssh -G github.com: $(printf '%s\n' "$ghResolved" | grep -E '^(user|hostname) ' | tr '\n' ' ')"
fi

test.suite.save.results
