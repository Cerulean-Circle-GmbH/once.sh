#!/usr/bin/env bash
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# Order between Host blocks does not matter, and lines from different
# blocks may interleave. The test verifies that the four canonical Host
# aliases are present, each with the expected User/Port/HostName/
# IdentityFile values *somewhere* in the file.
#
# Required content (per user's ~/.ssh/config):
#   - Host WODA.test    -> User root, HostName 178.254.18.182,
#                          IdentityFile /root/.ssh/id_ed25519
#   - Host WODA.dev.root-> User root, HostName cerulean.it,
#                          IdentityFile /root/.ssh/id_ed25519
#   - Host WODA.dev     -> User developking, HostName cerulean.it,
#                          IdentityFile /root/.ssh/id_ed25519
#   - Host 2cuGitHub    -> User git, HostName github.com,
#                          IdentityFile /home/developking/.ssh/id_rsa
#
# Each line is checked with `grep -Fq` independently (no order, no contiguity).

# Enumerate users to check: root + every /home/* except 'shared'.
basehome=/home
[ "$(uname)" = "Darwin" ] && basehome=/Users
users=()
[ -d /root ] && users+=("root:/root")
if [ -d "$basehome" ]; then
  for u in $(ls "$basehome" 2>/dev/null | grep -v '^shared$'); do
    [ -d "$basehome/$u" ] && users+=("$u:$basehome/$u")
  done
fi

# Skip-with-pass when there is nothing to check (core test must not
# false-fail on hosts where install hasn't created users yet).
if [ ${#users[@]} -eq 0 ]; then
  test.case $level "ssh.config.woda: no users on host, skipping" true
  expect.pass "no users; skipped"
  test.suite.save.results
  return 0 2>/dev/null || exit 0
fi

# Required lines, grouped by Host alias. Each entry: "label::line".
required_lines=(
  # WODA.test
  "WODA.test::Host WODA.test"
  "WODA.test::User root"
  "WODA.test::HostName 178.254.18.182"
  "WODA.test::IdentityFile /root/.ssh/id_ed25519"
  # WODA.dev.root
  "WODA.dev.root::Host WODA.dev.root"
  "WODA.dev.root::HostName cerulean.it"
  # (User root + IdentityFile /root/.ssh/id_ed25519 already required above)
  # WODA.dev
  "WODA.dev::Host WODA.dev"
  "WODA.dev::User developking"
  # (HostName cerulean.it already required above)
  # 2cuGitHub
  "2cuGitHub::Host 2cuGitHub"
  "2cuGitHub::User git"
  "2cuGitHub::HostName github.com"
  "2cuGitHub::IdentityFile /home/developking/.ssh/id_rsa"
)

for entry in "${users[@]}"; do
  user="${entry%%:*}"
  home="${entry#*:}"
  cfg="$home/.ssh/config"

  test.case $level "ssh.config.woda: $user has ~/.ssh/config" test -f "$cfg"
  if [ ! -f "$cfg" ]; then
    expect.fail "$cfg missing"
    continue
  else
    expect.pass "$cfg present"
  fi

  missing=()
  for req in "${required_lines[@]}"; do
    label="${req%%::*}"
    line="${req#*::}"
    if ! grep -Fq -- "$line" "$cfg" 2>/dev/null; then
      missing+=("[$label] $line")
    fi
  done

  test.case $level "ssh.config.woda: $user contains all WODA+2cuGitHub fields" true
  if [ ${#missing[@]} -eq 0 ]; then
    expect.pass "$user has all required Host aliases and fields"
  else
    expect.fail "$user $cfg is missing: $(printf '%s; ' "${missing[@]}")"
  fi
done

test.suite.save.results
