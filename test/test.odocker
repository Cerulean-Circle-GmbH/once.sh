# Test: odocker.install rejects nonexistent container
# ─────────────────────────────────────────────────────────────────────────────
test.case $level "odocker.install rejects nonexistent container" \
  odocker install nonexistent_container_$$
if [ "$RETURN_VALUE" -eq 1 ]; then
