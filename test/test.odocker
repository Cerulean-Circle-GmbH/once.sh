# ─────────────────────────────────────────────────────────────────────────────
# Test: odocker.install completion function exists
# ─────────────────────────────────────────────────────────────────────────────
if type odocker.install.completion.container >/dev/null 2>&1; then
  expect.pass "odocker.install.completion.container is defined"
else
  expect.fail "odocker.install.completion.container should be defined"
fi

if type odocker.exec.command.completion.container >/dev/null 2>&1; then
  expect.pass "odocker.exec.command.completion.container is defined"
else
  expect.fail "odocker.exec.command.completion.container should be defined"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Test: workspace.set canonicalizes relatives + persists to $CONFIG_PATH/odocker.env
# These tests mutate user.env and odocker.env; wrap in save/restore to keep
# the dev machine's real config pristine when test.suite runs ad-hoc.
# ─────────────────────────────────────────────────────────────────────────────
_WS_ORIG_VAR="$ODOCKER_WORKSPACES"
_WS_ORIG_USER_ENV="$(cat "$CONFIG_PATH/user.env" 2>/dev/null)"
_WS_ORIG_ODOCKER_ENV=""
_WS_HAD_ODOCKER_ENV=0
if [ -f "$CONFIG_PATH/odocker.env" ]; then
  _WS_HAD_ODOCKER_ENV=1
  _WS_ORIG_ODOCKER_ENV="$(cat "$CONFIG_PATH/odocker.env")"
fi

# T-WS-CANONICAL: relative path → absolute (read from odocker.env on disk,
# because `odocker workspace.set` runs in a subshell and its `export` does
# NOT propagate back to the test shell's $ODOCKER_WORKSPACES)
_WS_TMP="/tmp/odocker_ws_canon.$$"
mkdir -p "$_WS_TMP"
_WS_CWD="$(pwd)"
cd /tmp
odocker workspace.set "./$(basename "$_WS_TMP")" >/dev/null 2>&1
cd "$_WS_CWD"
_WS_STORED=""
if [ -f "$CONFIG_PATH/odocker.env" ]; then
  # config.save's sed pipeline produces `export declare ODOCKER_WORKSPACES="…"`
  # on some paths (the `declare` is harmless; bash parses it as the builtin).
  # Accept either form.
  _WS_STORED=$(grep "ODOCKER_WORKSPACES=" "$CONFIG_PATH/odocker.env" | sed 's/.*ODOCKER_WORKSPACES="\(.*\)"$/\1/')
fi
if [ "$_WS_STORED" = "$_WS_TMP" ]; then
  expect.pass "T-WS-CANONICAL: relative path canonicalized to '$_WS_TMP'"
else
  expect.fail "T-WS-CANONICAL: odocker.env stored '$_WS_STORED', expected '$_WS_TMP'"
fi

# T-WS-ENVFILE: $CONFIG_PATH/odocker.env exists with ODOCKER_WORKSPACES=
if [ -f "$CONFIG_PATH/odocker.env" ] && grep -q "ODOCKER_WORKSPACES=" "$CONFIG_PATH/odocker.env"; then
  expect.pass "T-WS-ENVFILE: odocker.env contains ODOCKER_WORKSPACES="
else
  expect.fail "T-WS-ENVFILE: $CONFIG_PATH/odocker.env missing or has no ODOCKER_WORKSPACES="
fi

# T-WS-REGISTERED: user.env sources odocker.env
if grep -q "odocker\.env" "$CONFIG_PATH/user.env" 2>/dev/null; then
  expect.pass "T-WS-REGISTERED: user.env sources odocker.env"
else
  expect.fail "T-WS-REGISTERED: user.env has no 'source .../odocker.env' line"
fi

# T-WS-MIGRATED: no legacy ODOCKER_WORKSPACES= in user.env
# Seed a legacy entry, then call workspace.set, then assert it's gone.
echo 'export ODOCKER_WORKSPACES="/legacy/leftover/path"' >> "$CONFIG_PATH/user.env"
_WS_TMP2="/tmp/odocker_ws_migrate.$$"
mkdir -p "$_WS_TMP2"
odocker workspace.set "$_WS_TMP2" >/dev/null 2>&1
if ! grep -q "^export ODOCKER_WORKSPACES=" "$CONFIG_PATH/user.env" 2>/dev/null; then
  expect.pass "T-WS-MIGRATED: legacy ODOCKER_WORKSPACES= removed from user.env"
else
  expect.fail "T-WS-MIGRATED: user.env still contains ODOCKER_WORKSPACES="
fi

# T-CONFIG-UNSET: the new primitive removes a single key idempotently.
# Invoke `config unset` as a script (subshell) with CONFIG overridden inline
# via `VAR=value command` syntax — avoids sourcing config into the test shell.
_UNSET_TMP="/tmp/unset_test.$$"
printf 'export ALPHA="a"\nexport BETA="b"\nexport GAMMA="c"\n' > "$_UNSET_TMP"
CONFIG="$_UNSET_TMP" config unset BETA >/dev/null 2>&1
if grep -q "^export ALPHA=" "$_UNSET_TMP" \
   && ! grep -q "^export BETA="  "$_UNSET_TMP" \
   && grep -q "^export GAMMA=" "$_UNSET_TMP"; then
  expect.pass "T-CONFIG-UNSET: removes only the target key"
else
  expect.fail "T-CONFIG-UNSET: key removal or neighbours disturbed"
fi
rm -f "$_UNSET_TMP"

# Cleanup — restore original config state and drop temp workspace dirs
echo "$_WS_ORIG_USER_ENV" > "$CONFIG_PATH/user.env"
if [ "$_WS_HAD_ODOCKER_ENV" = "1" ]; then
  echo "$_WS_ORIG_ODOCKER_ENV" > "$CONFIG_PATH/odocker.env"
else
  rm -f "$CONFIG_PATH/odocker.env"
fi
ODOCKER_WORKSPACES="$_WS_ORIG_VAR"
rm -rf "$_WS_TMP" "$_WS_TMP2"


# ─────────────────────────────────────────────────────────────────────────────
# T-WS-INIT-*: odocker.workspace.init
# ─────────────────────────────────────────────────────────────────────────────
# `workspace.set` rejects a missing directory on purpose, so a typo cannot
# persist a path that is not there. `init` is the verb allowed to create, and
# it delegates everything else — canonicalisation and the persistence trio —
# to `set`, so there is one definition of each.
#
# CONFIG_PATH is already pointed at this file's fixture (line 11), so the
# persistence assertions below read the fixture's odocker.env, never the
# shared tier.
_WS_INIT_TMP=$(test.suite.fixture.make test.odocker.wsinit)
_WS_INIT_SAVED="$ODOCKER_WORKSPACES"

test.odocker.workspaceInitCreates() {
  local target="$_WS_INIT_TMP/created"
  odocker.workspace.init "$target" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 1 "init returned $rc"
  elif [ ! -d "$target" ]; then
    create.result 1 "the directory was not created"
  elif [ "$ODOCKER_WORKSPACES" != "$target" ]; then
    create.result 1 "ODOCKER_WORKSPACES is '$ODOCKER_WORKSPACES', expected $target"
  elif ! grep -q "^export ODOCKER_WORKSPACES=" "$CONFIG_PATH/odocker.env" 2>/dev/null; then
    create.result 1 "nothing persisted to \$CONFIG_PATH/odocker.env"
  else
    create.result 0 "created and persisted"
  fi
  return $(result)
}
test.case $level "T-WS-INIT-CREATES: init creates a missing directory, sets it, and persists it" \
  test.odocker.workspaceInitCreates
expect 0 "created and persisted" "the card's Done when: create, canonicalise, and land in odocker.env"

test.odocker.workspaceInitIdempotent() {
  local target="$_WS_INIT_TMP/created"
  odocker.workspace.init "$target" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ] && [ -d "$target" ]; then
    create.result 0 "second call is a no-op"
  else
    create.result 1 "rc=$rc dir=$([ -d "$target" ] && echo yes || echo no)"
  fi
  return $(result)
}
test.case $level "T-WS-INIT-IDEMPOTENT: a second init on an existing root succeeds and changes nothing" \
  test.odocker.workspaceInitIdempotent
expect 0 "second call is a no-op" "mkdir -p is idempotent, which is what makes the verb safe to re-run"

test.odocker.workspaceInitUnwritable() {
  # The negative control the card asks for: it must FAIL, not fail silently.
  # /proc is present and unwritable on every Linux host; the guard has to stop
  # here rather than fall through to workspace.set's "Directory not found".
  odocker.workspace.init "/proc/odocker-test-nope/deeper" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success for a directory it could not create"
  elif [ "$ODOCKER_WORKSPACES" = "/proc/odocker-test-nope/deeper" ]; then
    create.result 1 "it persisted a path it could not create"
  else
    create.result 0 "refused"
  fi
  return $(result)
}
test.case $level "T-WS-INIT-UNWRITABLE: an unwritable parent is a loud failure" \
  test.odocker.workspaceInitUnwritable
expect 0 "refused" "silently not creating the workspaces root is how a build fails an hour later"

export ODOCKER_WORKSPACES="$_WS_INIT_SAVED"
rm -rf "$_WS_INIT_TMP"
unset _WS_INIT_TMP _WS_INIT_SAVED

# ─────────────────────────────────────────────────────────────────────────────
# T-WS-GET-*: odocker.workspace.get
# ─────────────────────────────────────────────────────────────────────────────
# Two defects, both of which these assertions start red against the old code.
# It declared no parameters and SILENTLY DISCARDED one — `$1` appeared nowhere
# in its body — so `workspace.get /some/path` echoed the old value and exited
# 0. And it never checked the root existed, so it reported a directory that was
# not there while `workspace.list` and `build` failed against it.
_WS_GET_TMP=$(test.suite.fixture.make test.odocker.wsget)
_WS_GET_SAVED="$ODOCKER_WORKSPACES"

test.odocker.workspaceGetHonoursArgument() {
  # THE assertion the card is about. The argument must change the answer.
  export ODOCKER_WORKSPACES="$_WS_GET_TMP"
  local out
  out=$(odocker.workspace.get "$_WS_GET_TMP/other" 2>/dev/null | head -1)
  mkdir -p "$_WS_GET_TMP/other"
  out=$(odocker.workspace.get "$_WS_GET_TMP/other" 2>/dev/null | head -1)
  if [ "$out" = "$_WS_GET_TMP/other" ]; then
    create.result 0 "argument honoured"
  else
    create.result 1 "got '$out', expected $_WS_GET_TMP/other — the argument was ignored"
  fi
  return $(result)
}
test.case $level "T-WS-GET-ARGUMENT: get reports the path it was given, not the current root" \
  test.odocker.workspaceGetHonoursArgument
expect 0 "argument honoured" "it used to discard \$1 entirely and echo the old value"

test.odocker.workspaceGetRejectsMissingCandidate() {
  odocker.workspace.get "$_WS_GET_TMP/nope" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 0 "missing candidate refused"
  else
    create.result 1 "it reported a nonexistent path as usable"
  fi
  return $(result)
}
test.case $level "T-WS-GET-CANDIDATE-MISSING: a path that is not there is reported unusable" \
  test.odocker.workspaceGetRejectsMissingCandidate
expect 0 "missing candidate refused" "get is the verb you run when a build fails; it has to be able to say no"

test.odocker.workspaceGetAcceptsRealCandidate() {
  # The positive half, so the negative one above cannot pass by always failing.
  mkdir -p "$_WS_GET_TMP/real"
  odocker.workspace.get "$_WS_GET_TMP/real" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 0 "real candidate accepted"
  else
    create.result 1 "rc=$rc for a directory that exists"
  fi
  return $(result)
}
test.case $level "T-WS-GET-CANDIDATE-REAL: a path that exists is reported usable" \
  test.odocker.workspaceGetAcceptsRealCandidate
expect 0 "real candidate accepted" "the control for the refusal above"

test.odocker.workspaceGetFailsOnBrokenRoot() {
  # The second defect: the reporter used to disagree with every consumer.
  export ODOCKER_WORKSPACES="$_WS_GET_TMP/removed"
  odocker.workspace.get >/dev/null 2>&1
  local rc=$?
  export ODOCKER_WORKSPACES="$_WS_GET_TMP"
  if [ "$rc" -ne 0 ]; then
    create.result 0 "broken root reported"
  else
    create.result 1 "it reported a root that is not there as fine"
  fi
  return $(result)
}
test.case $level "T-WS-GET-BROKEN-ROOT: get fails when the CURRENT root is not there" \
  test.odocker.workspaceGetFailsOnBrokenRoot
expect 0 "broken root reported" "workspace.list and build already fail on this; the reporter used to disagree"

test.odocker.workspaceGetReportsCurrentRoot() {
  # The regression guard: the healthy no-argument output is unchanged.
  export ODOCKER_WORKSPACES="$_WS_GET_TMP"
  local out rc
  out=$(odocker.workspace.get 2>/dev/null | head -1)
  rc=$?
  if [ "$out" = "$_WS_GET_TMP" ] && [ "$rc" -eq 0 ]; then
    create.result 0 "current root reported"
  else
    create.result 1 "got '$out' rc=$rc"
  fi
  return $(result)
}
test.case $level "T-WS-GET-CURRENT: with no argument it still reports the current root" \
  test.odocker.workspaceGetReportsCurrentRoot
expect 0 "current root reported" "the healthy output is byte-identical to before the change"

export ODOCKER_WORKSPACES="$_WS_GET_SAVED"
rm -rf "$_WS_GET_TMP"
unset _WS_GET_TMP _WS_GET_SAVED


console.log "
Test: T-WS-DEFAULT-DERIVED
===================================================================="

test.odocker.workspacesDefaultDerived() {
  local bad="" fx got; fx=$(test.suite.fixture.make wsDefault)
  mkdir -p "$fx/EAMD.ucp/infra/Once.sh"
  # oo.mode.base.get strategy 1: an explicit, existing components dir
  got=$(OOSH_COMPONENTS_DIR="$fx/EAMD.ucp/infra/Once.sh" private.odocker.workspaces.default.get) || bad="$bad rc=$?"
  [ "$got" = "$fx/EAMD.ucp/infra/DockerWorkspaces" ] || bad="$bad fixture=[$got]"
  # this host: beside the real Once.sh base
  got=$(private.odocker.workspaces.default.get)
  case "$got" in */DockerWorkspaces) ;; *) bad="$bad host=[$got]" ;; esac
  case "$got" in /var/dev/*) bad="$bad host-under-/var/dev" ;; esac
  grep -q '/var/dev' "$OOSH_DIR/odocker" && bad="$bad odocker-still-names-/var/dev"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "default derived beside the Once.sh base; no /var/dev" || create.result 1 "default:$bad"
  return $(result)
}
test.case $level "T-WS-DEFAULT-DERIVED: the workspaces default is DockerWorkspaces beside oo mode.base.get, never /var/dev" test.odocker.workspacesDefaultDerived
expect 0 "default derived beside the Once.sh base; no /var/dev" "/var/dev is history; the root follows the shared layout"


# T-WS-DEFAULT-NO-MAIN: without a main/ folder the default is still DockerWorkspaces beside the Once.sh base
# oo mode.base.get fails on a layout without main/ (a fresh clone); only
# private.odocker.workspaces.install derived the root from where ~/oosh really
# is, so odocker workspace.init / workspace.seed without a path failed on a host
# whose install had succeeded.
test.odocker.workspacesDefaultNoMain() {
  local bad="" fx got want; fx=$(test.suite.fixture.make wsDefaultNoMain)
  mkdir -p "$fx/Components/infra/Once.sh/dev"; ln -s "$fx/Components/infra/Once.sh/dev" "$fx/oosh"
  want="$(private.this.path.canonical "$fx")/Components/infra/DockerWorkspaces"
  got=$(FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    private.this.script.load oo oo.mode.base.get; private.this.script.load ogit ogit.branch.get
    unset OOSH_COMPONENTS_DIR; OOSH_DIR="$FX/oosh"
    private.odocker.workspaces.default.get' </dev/null 2>/dev/null) || bad="$bad rc=$?"
  [ "$got" = "$want" ] || bad="$bad got=[$got] want=[$want]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "no main/: DockerWorkspaces beside the Once.sh base" || create.result 1 "default no main:$bad"
  return $(result)
}
test.case $level "T-WS-DEFAULT-NO-MAIN: without a main/ folder the default is still DockerWorkspaces beside the Once.sh base" test.odocker.workspacesDefaultNoMain
expect 0 "no main/: DockerWorkspaces beside the Once.sh base" \
  "odocker workspace.init without a path failed where the install had found the root"


console.log "
Test: T-WS-SEED
===================================================================="

test.odocker.workspaceSeed() {
  local bad="" fx rc saved="$ODOCKER_WORKSPACES"; fx=$(test.suite.fixture.make wsSeed)
  mkdir -p "$fx/old/family/1.0" "$fx/empty"
  : > "$fx/old/family/1.0/Dockerfile"; printf 'd\n' > "$fx/old/.hidden"; printf 'r\n' > "$fx/old/README.txt"
  odocker.workspace.seed "$fx/old" "$fx/new" >/dev/null 2>&1 || bad="$bad rc=$?"
  [ -f "$fx/new/family/1.0/Dockerfile" ] || bad="$bad dockerfile"
  [ -f "$fx/new/.hidden" ] || bad="$bad dotfile"
  [ "$ODOCKER_WORKSPACES" = "$fx/new" ] || bad="$bad not-set=[$ODOCKER_WORKSPACES]"
  # idempotent: a populated root is never overwritten
  printf 'edited\n' > "$fx/new/README.txt"
  odocker.workspace.seed "$fx/old" "$fx/new" >/dev/null 2>&1 || bad="$bad rerun-rc=$?"
  [ "$(cat "$fx/new/README.txt" 2>/dev/null)" = edited ] || bad="$bad overwritten"
  # refusals create nothing
  odocker.workspace.seed "$fx/empty" "$fx/other" >/dev/null 2>&1; rc=$?
  [ "$rc" -eq 3 ] || bad="$bad no-dockerfile-rc=$rc"
  odocker.workspace.seed "$fx/nosuch" "$fx/other" >/dev/null 2>&1; rc=$?
  [ "$rc" -eq 2 ] || bad="$bad missing-from-rc=$rc"
  [ -e "$fx/other" ] && bad="$bad other-created"
  export ODOCKER_WORKSPACES="$saved"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "seeded once, never overwritten, refusals create nothing" || create.result 1 "seed:$bad"
  return $(result)
}
test.case $level "T-WS-SEED: workspace.seed fills a new root from an old one, once, and refuses a source without Dockerfiles" test.odocker.workspaceSeed
expect 0 "seeded once, never overwritten, refusals create nothing" "the new /home/shared root must get the old content without touching the old tree"

# T-ODOCKER-PREREQ-PACKAGE: the package that provides docker / column, per package manager
# oo cmd has no per-platform names: a package called `docker` is not Docker on
# Ubuntu. The names are odocker.install's.
test.odocker.prereqPackage() {
  local bad="" pm want got
  for pm in "apt-get -y install|docker-ce-cli|bsdextrautils" "apk add|docker-cli|util-linux-misc" \
            "dnf -y install|docker-ce-cli|util-linux" "brew install|docker|column"; do
    want="${pm#*|}"
    got="$(OOSH_PM="${pm%%|*}" private.odocker.prereq.package.get docker)|$(OOSH_PM="${pm%%|*}" private.odocker.prereq.package.get column)"
    [ "$got" = "$want" ] || bad="$bad ${pm%% *}=[$got]"
  done
  [ -z "$bad" ] && create.result 0 "docker and column map to the right package per package manager" || create.result 1 "packages:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-PACKAGE: docker and column map to the right package per package manager" test.odocker.prereqPackage
expect 0 "docker and column map to the right package per package manager" "oo cmd docker would ask apt for a package named docker"

# T-ODOCKER-PREREQ-INSTALL: a missing docker or column is installed through oo cmd
# A minimal system (a platform container) has neither. A stub apt-get records
# what oo cmd asks for; `command -v` is made to miss both.
test.odocker.prereqInstall() {
  local fx bad="" log; fx=$(test.suite.fixture.make odockerprereq); log="$fx/pm.log"; mkdir -p "$fx/bin"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' > "$fx/bin/apt-get"; chmod +x "$fx/bin/apt-get"
  # The container case on every machine: a socket of its own (a Mac VM has none).
  : > "$fx/docker.sock"
  env PATH="$fx/bin:$PATH" SUDO="" OOSH_PM="apt-get -y install" PM_LOG="$log" OOSH_DIR="$OOSH_DIR" FX="$fx" bash -c '
    command() { if [ "$1" = -v ] && { [ "$2" = docker ] || [ "$2" = column ]; }; then return 1; fi; builtin command "$@"; }
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    private.odocker.socket.get() { echo "$FX/docker.sock"; }
    private.odocker.docker.repo.add() { create.result 0 "added"; return 0; }
    private.odocker.prereqs.ensure >/dev/null 2>&1' >/dev/null 2>&1
  grep -q 'docker-ce-cli' "$log" 2>/dev/null || bad="$bad no-docker-ce-cli=[$(tr '\n' '|' < "$log" 2>/dev/null)]"
  grep -q 'bsdextrautils' "$log" 2>/dev/null || bad="$bad no-bsdextrautils"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "oo cmd installs docker-ce-cli and bsdextrautils when docker and column are missing" || create.result 1 "prereq install:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-INSTALL: a missing docker or column is installed through oo cmd" test.odocker.prereqInstall
expect 0 "oo cmd installs docker-ce-cli and bsdextrautils when docker and column are missing" \
  "odocker list in a platform container: docker: command not found"

# T-ODOCKER-PREREQ-START: only a started odocker method that runs docker installs
# Tab completion and the tests SOURCE odocker; usage, help and the workspace
# methods need no docker. None of them may install anything.
test.odocker.prereqStart() {
  local fx bad="" log n realTee realInstall; fx=$(test.suite.fixture.make odockerstart); log="$fx/pm.log"; mkdir -p "$fx/bin"; : > "$log"; : > "$fx/docker.sock"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' > "$fx/bin/apt-get"; chmod +x "$fx/bin/apt-get"
  # No network in a test: Docker's repository key is not fetched.
  printf '%s\n' '#!/bin/sh' 'exit 1' > "$fx/bin/curl"; chmod +x "$fx/bin/curl"
  # Nothing is written to /etc: as root (the platform containers) the real
  # private.odocker.docker.repo.add wrote /etc/apt/keyrings/docker.asc and
  # /etc/apt/sources.list.d/docker.list. install and tee record a write to
  # /etc instead of making it; every other call runs the real program.
  : > "$fx/writes.log"; realTee=$(command -v tee); realInstall=$(command -v install)
  printf '%s\n' '#!/bin/sh' 'case "$*" in */etc/*) echo "install $*" >> "$WRITES_LOG" ;; *) exec '"$realInstall"' "$@" ;; esac' > "$fx/bin/install"; chmod +x "$fx/bin/install"
  printf '%s\n' '#!/bin/sh' 'case "$*" in */etc/*) echo "tee $*" >> "$WRITES_LOG"; cat ;; *) exec '"$realTee"' "$@" ;; esac' > "$fx/bin/tee"; chmod +x "$fx/bin/tee"
  # No architecture, so Docker's apt repository is not added: the started
  # odocker stops in the repository method before it writes anything — as on
  # every machine without dpkg (Alpine, AlmaLinux, macOS).
  printf '%s\n' '#!/bin/sh' 'exit 1' > "$fx/bin/dpkg"; chmod +x "$fx/bin/dpkg"
  test.odocker.prereqStart.run() {
    # This test IS about installing: the test run's OOSH_NO_INSTALL is lifted.
    # The container case on every machine: the started odocker finds a socket
    # of its own through ODOCKER_SOCKET (a Mac VM has none).
    env -u OOSH_NO_INSTALL PATH="$fx/bin:$PATH" SUDO="" OOSH_PM="apt-get -y install" PM_LOG="$log" WRITES_LOG="$fx/writes.log" OOSH_DIR="$OOSH_DIR" ODOCKER_SOCKET="$fx/docker.sock" bash -c '
      command() { if [ "$1" = -v ] && { [ "$2" = docker ] || [ "$2" = column ]; }; then return 1; fi; builtin command "$@"; }
      export -f command
      '"$1" </dev/null >/dev/null 2>&1
  }
  test.odocker.prereqStart.run '"$OOSH_DIR/odocker" workspace.get'
  test.odocker.prereqStart.run '"$OOSH_DIR/odocker"'
  test.odocker.prereqStart.run 'source "$OOSH_DIR/odocker" ps'
  n=$(grep -c '' "$log"); [ "$n" = 0 ] || bad="$bad installed-for-workspace/usage/sourced=[$(tr '\n' '|' < "$log")]"
  test.odocker.prereqStart.run '"$OOSH_DIR/odocker" ps'
  grep -q 'docker-ce-cli' "$log" || bad="$bad started-ps-installed-nothing"
  [ -s "$fx/writes.log" ] && bad="$bad wrote-outside-fixture=[$(tr '\n' '|' < "$fx/writes.log")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a started docker method installs; workspace, usage and a sourced odocker do not" || create.result 1 "prereq start:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-START: only a started odocker method that runs docker installs" test.odocker.prereqStart
expect 0 "a started docker method installs; workspace, usage and a sourced odocker do not" \
  "Tab completion and the tests source odocker — they must never install"

# Stand-ins for the programs the socket methods call, in <fx>/bin, for a shell
# that has sourced only this and odocker — as a started odocker has. They work
# on <fx>/group (name:x:gid: lines), <fx>/dbgroups (the user's groups in the
# database) and <fx>/procgroups (the groups of this process), and record every
# call in <fx>/log. stat answers $SGID for <fx>/docker.sock; sudo runs only
# programs of the fixture, never a real groupadd or chgrp; docker answers no.
test.odocker.socketStubs() { # <fx>
  local fx="$1" realStat realId; realStat=$(command -v stat); realId=$(command -v id)
  mkdir -p "$fx/bin"; : > "$fx/docker.sock"; : > "$fx/group"; : > "$fx/log"; : > "$fx/dbgroups"; : > "$fx/procgroups"
  printf '%s\n' '#!/bin/sh' 'awk -F: -v k="$2" '"'"'$1 == k || $3 == k { print; f = 1 } END { exit !f }'"'"' "$FX/group"' > "$fx/bin/getent"
  printf '%s\n' '#!/bin/sh' 'echo "${0##*/} $*" >> "$FX/log"' 'for a; do n="$a"; done' 'echo "$n:x:$2:" >> "$FX/group"' > "$fx/bin/groupadd"
  cp "$fx/bin/groupadd" "$fx/bin/addgroup"
  printf '%s\n' '#!/bin/sh' 'echo "sudo $*" >> "$FX/log"' 'case "$1" in "$FX"/*) exec "$@" ;; esac' > "$fx/bin/sudo"
  printf '%s\n' '#!/bin/sh' 'echo "chgrp $*" >> "$FX/log"' > "$fx/bin/chgrp"
  printf '%s\n' '#!/bin/sh' 'case "$*" in *"$FX/docker.sock") echo "${SGID:-124}"; exit 0 ;; esac' "exec $realStat \"\$@\"" > "$fx/bin/stat"
  printf '%s\n' '#!/bin/sh' 'case "$*" in' '  -u) echo "${TUID:-1000}" ;;' '  -un) echo tester ;;' '  -nG) cat "$FX/procgroups" ;;' '  "-nG "*) cat "$FX/dbgroups" ;;' "  *) exec $realId \"\$@\" ;;" 'esac' > "$fx/bin/id"
  printf '%s\n' '#!/bin/sh' 'echo "docker $*" >> "$FX/log"' 'exit 1' > "$fx/bin/docker"
  chmod +x "$fx/bin/"*
}

# T-ODOCKER-SOCKET-ACCESS: a user who cannot reach the mounted socket joins a group with its GID
# In a platform container the host's /var/run/docker.sock is mounted with the
# HOST's group number: bash-user got `permission denied` right after the
# automatic docker install (2026-10-05). The socket itself is never touched
# (odocker.install: never chgrp the host's socket) — a group with its GID is
# created when there is none, and the user joins it. The membership is new,
# so RESULT asks for an `sg` re-run (sg:<group>) — with rc 0: a non-zero rc
# made oosh's error trap print "EXIT 2 Misuse of shell builtins" on every call.
test.odocker.socketAccess() {
  local fx bad="" out; fx=$(test.suite.fixture.make odockersocket); test.odocker.socketStubs "$fx"; mkdir -p "$fx/config"
  test.odocker.socketAccess.run() { # <database groups of tester> <groups of this process>
    echo "$1" > "$fx/dbgroups"; echo "$2" > "$fx/procgroups"; : > "$fx/log"
    # A started odocker has sourced only this and odocker: no os.check.env, no
    # OS_CMD_GROUP_ADD (2026-10-06). user is loaded as odocker loads it; its
    # user.group.add is a collaborator here, its config writes land in the
    # fixture. No USER: under `docker exec` there may be none.
    env -u OS_CMD_GROUP_ADD -u USER SUDO="sudo " SGID=4242 FX="$fx" CONFIG_PATH="$fx/config" PATH="$fx/bin:$PATH" OOSH_DIR="$OOSH_DIR" bash -c '
      OSTYPE=linux-gnu
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      private.this.script.load user private.user.group.member.pending
      user.group.add() { echo "join $*" >> "$FX/log"; echo "$(cat "$FX/dbgroups") $1" > "$FX/dbgroups"; }
      private.odocker.socket.access.ensure "$FX/docker.sock" >/dev/null 2>&1; echo "rc=$? result=$RESULT"' </dev/null 2>/dev/null | tail -1
  }
  # Not a member: the group is made, the user joins, the call re-runs under sg.
  out=$(test.odocker.socketAccess.run "tester" "tester")
  [ "$out" = "rc=0 result=sg:docker" ] || bad="$bad new=[$out]"
  grep -qx 'groupadd -g 4242 docker' "$fx/log" || bad="$bad no-group-created=[$(tr '\n' '|' < "$fx/log")]"
  grep -qx "join docker tester" "$fx/log" || bad="$bad not-joined=[$(tr '\n' '|' < "$fx/log")]"
  # A member this process does not know yet: sg, no second join.
  out=$(test.odocker.socketAccess.run "tester docker" "tester")
  [ "$out" = "rc=0 result=sg:docker" ] || bad="$bad pending=[$out]"
  grep -q '^join ' "$fx/log" && bad="$bad pending-joined-again"
  # This process has the group already: docker fails for another reason — no
  # sg, no "log out and back in".
  out=$(test.odocker.socketAccess.run "tester docker" "tester docker")
  case "$out" in "rc=0 result="*"another reason"*) ;; *) bad="$bad effective=[$out]" ;; esac
  grep -q '^join ' "$fx/log" && bad="$bad effective-joined"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the user joins a group with the socket GID; sg only for a membership this process does not have yet" || create.result 1 "socket access:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-SOCKET-ACCESS: a user who cannot reach the mounted socket joins a group with its GID; sg only when pending" test.odocker.socketAccess
expect 0 "the user joins a group with the socket GID; sg only for a membership this process does not have yet" \
  "permission denied on the socket; and sg / log out and back in on every call when docker failed for another reason"

# T-ODOCKER-SOCKET-ACCESS-NOOP: nothing happens when docker answers, without a socket, or for root
test.odocker.socketAccessNoop() {
  local fx bad="" out; fx=$(test.suite.fixture.make odockersocketnoop); : > "$fx/docker.sock"; : > "$fx/log"
  out=$(env SUDO="" LOGF="$fx/log" FX="$fx" OOSH_DIR="$OOSH_DIR" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    user.group.add() { echo "join $*" >> "$LOGF"; }
    docker() { return 0; }
    private.odocker.socket.access.ensure "$FX/docker.sock" >/dev/null 2>&1; printf "%s " "answers=$?"
    docker() { return 1; }
    private.odocker.socket.access.ensure "$FX/none.sock" >/dev/null 2>&1; printf "%s " "nosocket=$?"
    id() { echo 0; }
    private.odocker.socket.access.ensure "$FX/docker.sock" >/dev/null 2>&1; printf "%s" "root=$?"' 2>/dev/null | tail -1)
  [ "$out" = "answers=0 nosocket=0 root=0" ] || bad="$bad rcs=[$out]"
  [ -s "$fx/log" ] && bad="$bad joined=[$(tr '\n' '|' < "$fx/log")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "nothing to do when docker answers, there is no socket, or for root" || create.result 1 "socket noop:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-SOCKET-ACCESS-NOOP: nothing happens when docker answers, without a socket, or for root" test.odocker.socketAccessNoop
expect 0 "nothing to do when docker answers, there is no socket, or for root" "a working docker must not change any group"

# T-ODOCKER-SOCKET-SG: a new membership takes effect at once — the started call runs again under sg, once
test.odocker.socketSg() {
  local body bad=""
  body=$(declare -f odocker.start)
  case "$body" in *private.odocker.socket.access.ensure*) ;; *) bad="$bad no-access-ensure" ;; esac
  case "$body" in *'sg "${RESULT#sg:}"'*) ;; *) bad="$bad no-sg-rerun-from-RESULT" ;; esac
  # The request travels in RESULT with rc 0 — a non-zero rc set off the error
  # trap ("EXIT 2 Misuse of shell builtins") on every call in the same shell.
  case "$(declare -f private.odocker.socket.access.ensure)" in *'create.result 2'*) bad="$bad rc-2-signal" ;; esac
  case "$body" in *ODOCKER_SG*) ;; *) bad="$bad no-loop-guard" ;; esac
  [ -z "$bad" ] && create.result 0 "odocker.start re-runs the call under sg once after a new membership" || create.result 1 "sg:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-SOCKET-SG: a new membership takes effect at once — the call runs again under sg, once" test.odocker.socketSg
expect 0 "odocker.start re-runs the call under sg once after a new membership" "the current shell does not know a group joined a moment ago"

# T-ODOCKER-WORKSPACES-INSTALL: every install gives the host its odocker.env — once
# Only `odocker workspace.set` wrote ~/config/odocker.env and the user.env
# chain, so a fresh install had neither (platform container, 2026-10-05).
# private.odocker.workspaces.install creates the root, shares it, and sets it
# through workspace.set; an existing value is kept, the chain is never doubled.
test.odocker.workspacesInstall() {
  local fx bad="" ws; fx=$(test.suite.fixture.make odockerwsinstall); mkdir -p "$fx/config"; ws="$fx/DockerWorkspaces"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' '. $CONFIG_PATH/oosh.env' > "$fx/config/user.env"
  ( export CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env"; unset ODOCKER_WORKSPACES
    private.odocker.workspaces.install "$ws" >/dev/null 2>&1
    private.odocker.workspaces.install >/dev/null 2>&1 ) >/dev/null 2>&1
  [ -d "$ws" ] || bad="$bad not-created"
  grep -qx "export ODOCKER_WORKSPACES=\"$ws\"" "$fx/config/odocker.env" 2>/dev/null || bad="$bad odocker.env=[$(tr '\n' '|' < "$fx/config/odocker.env" 2>/dev/null)]"
  [ "$(grep -c 'odocker\.env' "$fx/config/user.env")" = 1 ] || bad="$bad chain-count=$(grep -c 'odocker\.env' "$fx/config/user.env")"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the workspaces root is created and set, odocker.env and its chain written once" || create.result 1 "workspaces install:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-WORKSPACES-INSTALL: every install gives the host its odocker.env, once" test.odocker.workspacesInstall
expect 0 "the workspaces root is created and set, odocker.env and its chain written once" \
  "a fresh install had no odocker.env — only odocker workspace.set wrote it"

# T-ODOCKER-PREREQ-PACKAGE-ENGINE: a bare computer gets the Docker ENGINE package per package manager
# With the host's socket mounted (a container) the client is enough; with no
# Docker at all the engine is installed on this computer. macOS: colima.
test.odocker.prereqPackageEngine() {
  local bad="" pm want got
  for pm in "apt-get -y install|docker.io" "apk add|docker" \
            "dnf -y install|docker-ce docker-ce-cli containerd.io" "brew install|colima docker"; do
    want="${pm#*|}"
    got=$(OOSH_PM="${pm%%|*}" private.odocker.prereq.package.get docker engine)
    [ "$got" = "$want" ] || bad="$bad ${pm%% *}=[$got]"
  done
  got=$(OOSH_PM="apk add" private.odocker.prereq.package.get docker)
  [ "$got" = "docker-cli" ] || bad="$bad client-default=[$got]"
  [ -z "$bad" ] && create.result 0 "engine packages per package manager, client by default" || create.result 1 "engine packages:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-PACKAGE-ENGINE: a bare computer gets the Docker engine package per package manager" test.odocker.prereqPackageEngine
expect 0 "engine packages per package manager, client by default" "on a bare computer the client alone reaches no Docker"

# T-ODOCKER-ENGINE-START: the engine is started the way this computer starts services
# systemd first, then OpenRC (Alpine), then SysV `service`; macOS starts colima.
# Stubs in a fixture bin record which one ran.
test.odocker.engineStart() {
  local fx bad="" log; fx=$(test.suite.fixture.make odockerengine); log="$fx/log"; mkdir -p "$fx/bin"; : > "$fx/docker.sock"
  local c; for c in systemctl rc-update rc-service service colima; do
    printf '%s\n' '#!/bin/sh' "echo \"$c \$*\" >> \"\$LOGF\"" 'v=$(echo "'"$c"'" | tr - _ | tr a-z A-Z)_RC; eval "exit \${$v:-0}"' > "$fx/bin/$c"; chmod +x "$fx/bin/$c"
  done
  test.odocker.engineStart.run() { # <env assignments…>
    : > "$log"
    env PATH="$fx/bin:$PATH" SUDO="" LOGF="$log" FX="$fx" OOSH_DIR="$OOSH_DIR" "$@" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      private.odocker.socket.get() { echo "$FX/docker.sock"; }
      private.odocker.engine.start >/dev/null 2>&1' >/dev/null 2>&1
    tr '\n' '|' < "$log"
  }
  [ "$(test.odocker.engineStart.run OOSH_OS=linux-gnu)" = "systemctl enable --now docker|" ] || bad="$bad systemd=[$(test.odocker.engineStart.run OOSH_OS=linux-gnu)]"
  [ "$(test.odocker.engineStart.run OOSH_OS=linux-gnu SYSTEMCTL_RC=1)" = "systemctl enable --now docker|rc-update add docker default|rc-service docker start|" ] || bad="$bad openrc=[$(test.odocker.engineStart.run OOSH_OS=linux-gnu SYSTEMCTL_RC=1)]"
  [ "$(test.odocker.engineStart.run OOSH_OS=linux-gnu SYSTEMCTL_RC=1 RC_SERVICE_RC=1)" = "systemctl enable --now docker|rc-update add docker default|rc-service docker start|service docker start|" ] || bad="$bad sysv"
  case "$(test.odocker.engineStart.run OOSH_OS=darwin)" in "colima start|"*) ;; *) bad="$bad colima=[$(test.odocker.engineStart.run OOSH_OS=darwin)]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "systemd, then OpenRC, then service; colima on macOS" || create.result 1 "engine start:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-ENGINE-START: the engine starts the way this computer starts services" test.odocker.engineStart
expect 0 "systemd, then OpenRC, then service; colima on macOS" "an installed engine that is not running answers nothing"

# T-ODOCKER-ENGINE-START-WAIT: an engine whose socket comes a moment after the start counts as started — within a few seconds
# A SysV / OpenRC start returns before dockerd has made its socket: odocker said
# "did not start" for an engine that was coming up. The stand-in service makes
# the socket (ODOCKER_SOCKET) a second later; a socket that never comes: rc 1.
test.odocker.engineStartWait() {
  local fx bad="" out; fx=$(test.suite.fixture.make odockerenginewait); mkdir -p "$fx/bin"
  printf '%s\n' '#!/bin/sh' 'exit 1' > "$fx/bin/systemctl"
  printf '%s\n' '#!/bin/sh' 'exit 0' > "$fx/bin/rc-update"
  printf '%s\n' '#!/bin/sh' '[ -n "$LATE" ] && ( sleep 1; : > "$ODOCKER_SOCKET" ) >/dev/null 2>&1 &' 'exit 0' > "$fx/bin/rc-service"
  chmod +x "$fx/bin/"*
  test.odocker.engineStartWait.run() { # <env assignments…>
    rm -f "$fx/docker.sock"
    env PATH="$fx/bin:$PATH" SUDO="" OOSH_OS=linux-gnu ODOCKER_SOCKET="$fx/docker.sock" OOSH_DIR="$OOSH_DIR" "$@" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      private.odocker.engine.start >/dev/null 2>&1; echo "rc=$?"' </dev/null 2>/dev/null | tail -1
  }
  out=$(test.odocker.engineStartWait.run LATE=1); [ "$out" = "rc=0" ] || bad="$bad late-socket=[$out]"
  out=$(test.odocker.engineStartWait.run); [ "$out" = "rc=1" ] || bad="$bad no-socket=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a socket that comes a moment later counts; none at all is rc 1" || create.result 1 "engine wait:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-ENGINE-START-WAIT: an engine whose socket comes a moment after the start counts as started" test.odocker.engineStartWait
expect 0 "a socket that comes a moment later counts; none at all is rc 1" "an OpenRC start returned before dockerd made its socket: did not start"

# T-ODOCKER-RESET-SIGNATURE: the reset signature is closed and its usage line names every parameter
test.odocker.resetSignature() {
  local bad="" sig params usage p
  sig=$(grep -E '^odocker\.reset\(\)' "$OOSH_DIR/odocker")
  case "$sig" in *" #") ;; *) bad="$bad signature-not-closed" ;; esac
  params=$(printf '%s\n' "$sig" | cut -d'#' -f2)
  usage=$(odocker.reset 2>/dev/null)
  for p in $params; do
    case "$usage" in *"$p"*) ;; *) bad="$bad usage-lacks-$p" ;; esac
  done
  [ -z "$bad" ] && create.result 0 "the reset signature is closed and its usage names every parameter" || create.result 1 "reset:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-RESET-SIGNATURE: the reset signature is closed and its usage line names every parameter" test.odocker.resetSignature
expect 0 "the reset signature is closed and its usage names every parameter" "odocker reset said nothing of <?name>"

# T-ODOCKER-PREREQ-MODE: no socket → the engine is installed and started; a mounted socket → the client only
test.odocker.prereqMode() {
  local fx bad="" log; fx=$(test.suite.fixture.make odockermode); log="$fx/pm.log"; mkdir -p "$fx/bin"
  # The stub package manager logs the install and marks docker as installed.
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' ': > "$FX/installed"' > "$fx/bin/apk"; chmod +x "$fx/bin/apk"
  test.odocker.prereqMode.run() { # <socket present: yes|no>
    : > "$log"; rm -f "$fx/docker.sock" "$fx/installed"; [ "$1" = yes ] && : > "$fx/docker.sock"
    env PATH="$fx/bin:$PATH" SUDO="" OOSH_PM="apk add" PM_LOG="$log" FX="$fx" OOSH_DIR="$OOSH_DIR" bash -c '
      # docker: there once the stub installed it; column: missing and never
      # provided — its install failed (BusyBox has none; util-linux-misc brings
      # it on Alpine), and the engine must start on docker alone.
      command() {
        if [ "$1" = -v ] && [ "$2" = docker ]; then [ -e "$FX/installed" ]; return; fi
        if [ "$1" = -v ] && [ "$2" = column ]; then return 1; fi
        builtin command "$@"; }
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      docker() { return 1; }
      private.odocker.socket.get() { echo "$FX/docker.sock"; }
      private.odocker.engine.supported() { create.result 0 "can run"; return 0; }
      # A bare computer — also when the suite itself runs in a container.
      private.this.container.is() { return 1; }
      private.odocker.engine.start() { echo "ENGINE-START" >> "$PM_LOG"; return 0; }
      private.odocker.prereqs.ensure >/dev/null 2>&1' >/dev/null 2>&1
    tr '\n' '|' < "$log"
  }
  case "$(test.odocker.prereqMode.run no)" in *"add docker|"*ENGINE-START*) ;; *) bad="$bad bare=[$(test.odocker.prereqMode.run no)]" ;; esac
  case "$(test.odocker.prereqMode.run yes)" in *"add docker-cli|"*) case "$(test.odocker.prereqMode.run yes)" in *ENGINE-START*) bad="$bad container-started-engine" ;; esac ;; *) bad="$bad container=[$(test.odocker.prereqMode.run yes)]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "bare computer: engine installed and started; container: client only" || create.result 1 "prereq mode:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-MODE: no socket installs and starts the engine, a mounted socket only the client" test.odocker.prereqMode
expect 0 "bare computer: engine installed and started; container: client only" "a bare computer needs Docker itself, a container only the client"

# T-ODOCKER-RUN-HOSTNAME: a container started with a name gets it as its host name too
test.odocker.runHostname() {
  local m bad=""
  for m in odocker.run odocker.run.sshd odocker.create; do
    case "$(declare -f $m)" in *'--hostname $name'*) ;; *) bad="$bad $m" ;; esac
  done
  [ -z "$bad" ] && create.result 0 "run, run.sshd and create pass --hostname with the name" || create.result 1 "no --hostname in:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-RUN-HOSTNAME: a container started with a name gets it as its host name too" test.odocker.runHostname
expect 0 "run, run.sshd and create pass --hostname with the name" "a container's host name was its ID"

# T-ODOCKER-CONTAINER-NAME-NEW: a container odocker starts without a name gets Docker's random name — known before it starts
# Docker's random name (xenodochial_brown) was unknown inside the container
# until a docker program was there; the host name was the ID, so was the oosh
# name (platform test, 2026-10-05). Docker picks the name on an empty
# `docker create`, odocker reads it and removes the entry, then starts the
# container with that name as name and host name. No name when create fails.
test.odocker.containerNameNew() {
  local fx bad="" got; fx=$(test.suite.fixture.make odockername)
  test.odocker.containerNameNew.run() { # <create works: yes|no>
    : > "$fx/log"
    OK="$1" LOGF="$fx/log" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      docker() {
        echo "$*" >> "$LOGF"
        case "$1" in
          create) [ "$OK" = yes ] && echo "c0ffee00aa11" || return 1 ;;
          container) [ "$2 ${!#}" = "inspect c0ffee00aa11" ] && echo "/xenodochial_brown" ;;
          rm) return 0 ;;
        esac; }
      private.odocker.container.name.new naked_ubuntu_24_04' 2>/dev/null
  }
  got=$(test.odocker.containerNameNew.run yes); [ "$got" = "xenodochial_brown" ] || bad="$bad name=[$got]"
  grep -qx 'create naked_ubuntu_24_04' "$fx/log" || bad="$bad no-create=[$(tr '\n' '|' < "$fx/log")]"
  grep -qx 'rm c0ffee00aa11' "$fx/log" || bad="$bad entry-not-removed"
  got=$(test.odocker.containerNameNew.run no);  [ -z "$got" ] || bad="$bad create-failed=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "Docker's random name, read before the container starts; the empty entry removed" || create.result 1 "container name:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-CONTAINER-NAME-NEW: a container started without a name gets Docker's random name, known before it starts" test.odocker.containerNameNew
expect 0 "Docker's random name, read before the container starts; the empty entry removed" "a container only knew its ID, its random Docker name stayed outside"

# T-ODOCKER-UNNAMED-GETS-NAME: run, run.sshd and create name an unnamed container; reset passes a given name, the platform test none
test.odocker.unnamedGetsName() {
  local m bad=""
  for m in odocker.run odocker.run.sshd odocker.create; do
    case "$(declare -f $m)" in *private.odocker.container.name.new*) ;; *) bad="$bad $m" ;; esac
  done
  case "$(declare -f odocker.reset)" in *'odocker.run.sshd "$image" "$name"'*) ;; *) bad="$bad reset" ;; esac
  private.this.script.load os os.platform.test >/dev/null 2>&1
  case "$(declare -f os.platform.test)" in *'odocker reset "$imageTag" "$sshPort";'*) ;; *) bad="$bad os.platform.test-names-it" ;; esac
  [ -z "$bad" ] && create.result 0 "every container odocker starts has a name it knows" || create.result 1 "unnamed in:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-UNNAMED-GETS-NAME: every container odocker starts has a name it knows" test.odocker.unnamedGetsName
expect 0 "every container odocker starts has a name it knows" "a platform container must keep Docker's random name"

# T-ODOCKER-START-NAME-REFRESH: once docker is there, a computer named by its container ID is renamed
test.odocker.startNameRefresh() {
  case "$(declare -f odocker.start)" in
    *'^[0-9a-f]{12}$'*private.config.host.name.refresh*) create.result 0 "a started odocker corrects a container-ID name" ;;
    *) create.result 1 "odocker.start does not refresh a container-ID name" ;;
  esac
  return $(result)
}
test.case $level "T-ODOCKER-START-NAME-REFRESH: once docker is there, a container-ID name is corrected" test.odocker.startNameRefresh
expect 0 "a started odocker corrects a container-ID name" "a container started by plain docker run kept its ID as name"

# T-ODOCKER-ENGINE-SUPPORTED: a Mac runs the Docker engine only with virtualization
# colima runs a VM; a Mac that is itself a VM (a tart VM: "Apple M1 Max
# (Virtual)", no kern.hv_support) cannot — odocker installed colima, docker and
# lima there and failed to start them (2026-10-06). Linux: always.
test.odocker.engineSupported() {
  local bad=""
  test.odocker.engineSupported.run() { # <os> <sysctl answer|-> <?container: yes|no>
    OS="$1" ANS="$2" CT="${3:-no}" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      export OOSH_OS="$OS"
      sysctl() { [ "$ANS" = "-" ] && { echo "sysctl: unknown oid" >&2; return 1; }; echo "$ANS"; }
      private.this.container.is() { [ "$CT" = yes ]; }
      private.odocker.engine.supported >/dev/null 2>&1; echo "$? $RESULT"' 2>/dev/null | tail -1
  }
  [ "$(test.odocker.engineSupported.run darwin 1 | cut -d" " -f1)" = 0 ] || bad="$bad mac-with-hv"
  [ "$(test.odocker.engineSupported.run darwin - | cut -d" " -f1)" = 1 ] || bad="$bad mac-vm"
  [ "$(test.odocker.engineSupported.run darwin 0 | cut -d" " -f1)" = 1 ] || bad="$bad mac-hv-0"
  [ "$(test.odocker.engineSupported.run linux-gnu - | cut -d" " -f1)" = 0 ] || bad="$bad linux"
  # A container has no init system to run an engine (2026-10-06).
  case "$(test.odocker.engineSupported.run linux-gnu - yes)" in "1 "*"no docker socket is mounted"*) ;; *) bad="$bad container=[$(test.odocker.engineSupported.run linux-gnu - yes)]" ;; esac
  [ -z "$bad" ] && create.result 0 "Linux outside a container; a Mac only with virtualization" || create.result 1 "engine supported:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-ENGINE-SUPPORTED: a Mac runs the Docker engine only with virtualization, a container never" test.odocker.engineSupported
expect 0 "Linux outside a container; a Mac only with virtualization" "a Mac VM got colima installed and could not start it"

# T-ODOCKER-PREREQ-CONTAINER-NO-SOCKET: a container without the host's socket gets the client and the word why
# The platform containers can be started without the socket: the first
# `odocker list` there installed a Docker engine that cannot start — a
# container has no init system (2026-10-06). The owner decided: the client
# only, and a warning that names the missing socket and the docker option.
test.odocker.prereqContainerNoSocket() {
  local fx bad="" log out; fx=$(test.suite.fixture.make odockerctnosock); log="$fx/pm.log"; mkdir -p "$fx/bin"; : > "$log"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' ': > "$FX/installed"' > "$fx/bin/apk"; chmod +x "$fx/bin/apk"
  out=$(env PATH="$fx/bin:$PATH" SUDO="" OOSH_PM="apk add" PM_LOG="$log" FX="$fx" OOSH_DIR="$OOSH_DIR" bash -c '
    command() {
      if [ "$1" = -v ] && [ "$2" = docker ]; then [ -e "$FX/installed" ]; return; fi
      if [ "$1" = -v ] && [ "$2" = column ]; then return 1; fi
      builtin command "$@"; }
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    docker() { return 1; }
    private.odocker.socket.get() { echo "$FX/no.sock"; }
    private.this.container.is() { return 0; }
    private.odocker.engine.start() { echo "ENGINE-START" >> "$PM_LOG"; return 0; }
    private.odocker.prereqs.ensure >/dev/null 2>&1; echo "rc=$? result=$RESULT"' 2>/dev/null | tail -1)
  grep -qx 'add docker-cli' "$log" || bad="$bad no-client=[$(tr '\n' '|' < "$log")]"
  grep -qx 'add docker' "$log" && bad="$bad engine-installed"
  grep -q 'ENGINE-START' "$log" && bad="$bad engine-started"
  case "$out" in "rc=1 result="*"no docker socket is mounted"*"docker option"*) ;; *) bad="$bad result=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the client, no engine; RESULT names the missing socket and the docker option" || create.result 1 "container no socket:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-CONTAINER-NO-SOCKET: a container without the host's socket gets the client and the word why" test.odocker.prereqContainerNoSocket
expect 0 "the client, no engine; RESULT names the missing socket and the docker option" \
  "odocker list in a container without the socket installed an engine that cannot start"

# T-ODOCKER-PREREQ-NO-ENGINE: where no engine can run, nothing is installed
test.odocker.prereqNoEngine() {
  local fx bad="" log rc; fx=$(test.suite.fixture.make odockernoengine); log="$fx/pm.log"; mkdir -p "$fx/bin"; : > "$log"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' > "$fx/bin/brew"; chmod +x "$fx/bin/brew"
  env PATH="$fx/bin:$PATH" SUDO="" OOSH_PM="brew install" PM_LOG="$log" FX="$fx" bash -c '
    command() { if [ "$1" = -v ] && [ "$2" = docker ]; then return 1; fi; builtin command "$@"; }
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    private.odocker.socket.get() { echo "$FX/no.sock"; }
    private.odocker.engine.supported() { create.result 1 "this Mac cannot run a VM"; return 1; }
    private.this.container.is() { return 1; }
    private.odocker.prereqs.ensure >/dev/null 2>&1; echo "rc=$? result=$RESULT"' > "$fx/out" 2>/dev/null
  grep -qE 'colima|docker' "$log" && bad="$bad installed=[$(tr '\n' '|' < "$log")]"
  grep -q '^rc=1 ' "$fx/out" || bad="$bad rc=[$(cat "$fx/out")]"
  grep -q 'cannot run a VM' "$fx/out" || bad="$bad no-reason=[$(cat "$fx/out")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "nothing installed, rc 1 naming the reason" || create.result 1 "no engine:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQ-NO-ENGINE: where no Docker engine can run, nothing is installed" test.odocker.prereqNoEngine
expect 0 "nothing installed, rc 1 naming the reason" "colima, docker and lima were installed on a Mac VM for nothing"

# T-ODOCKER-START-CONTINUES: a missing prerequisite is a warning — a method that needs no docker still runs
# `odocker up` without arguments shows a picker; it ended with rc 1 because
# the engine could not start (Mac VM, 2026-10-06).
test.odocker.startContinues() {
  local body bad=""; body=$(declare -f odocker.start)
  case "$body" in *'private.odocker.prereqs.ensure || return'*) bad="$bad returns-on-missing" ;; esac
  case "$body" in *'private.odocker.prereqs.ensure || warn.log'*) ;; *) bad="$bad no-warning" ;; esac
  [ -z "$bad" ] && create.result 0 "a missing prerequisite is a warning; the method runs" || create.result 1 "start:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-START-CONTINUES: a missing prerequisite is a warning, the method still runs" test.odocker.startContinues
expect 0 "a missing prerequisite is a warning; the method runs" "odocker up without docker ended before its picker"

# T-ODOCKER-START-NO-INSTALL: under OOSH_NO_INSTALL (every test run) a started odocker installs nothing
test.odocker.startNoInstall() {
  local fx bad="" log; fx=$(test.suite.fixture.make odockernoinstall); log="$fx/pm.log"; mkdir -p "$fx/bin"; : > "$log"
  printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$PM_LOG"' > "$fx/bin/apt-get"; chmod +x "$fx/bin/apt-get"
  # A stand-in sudo: the real one would ask the runner for a password.
  printf '%s\n' '#!/bin/sh' 'echo "sudo $*" >> "$PM_LOG"; exit 1' > "$fx/bin/sudo"; chmod +x "$fx/bin/sudo"
  env PATH="$fx/bin:$PATH" SUDO="" OOSH_PM="apt-get -y install" PM_LOG="$log" OOSH_NO_INSTALL=1 bash -c '
    command() { if [ "$1" = -v ] && { [ "$2" = docker ] || [ "$2" = column ]; }; then return 1; fi; builtin command "$@"; }
    export -f command
    "$OOSH_DIR/odocker" ps' </dev/null >/dev/null 2>&1
  [ -s "$log" ] && bad="$bad installed=[$(tr '\n' '|' < "$log")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a started odocker installs nothing under OOSH_NO_INSTALL" || create.result 1 "no install:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-START-NO-INSTALL: under OOSH_NO_INSTALL (every test run) a started odocker installs nothing" test.odocker.startNoInstall
expect 0 "a started odocker installs nothing under OOSH_NO_INSTALL" "the tests installed colima, docker and lima on a Mac VM"

# T-ODOCKER-SOCKET-NEVER-CHANGED: no odocker method ever runs chgrp or sudo on the docker socket
# (replaces T-ODOCKER-SOCKET-FIX-NO-INSTALL, which pinned the old fix.) The
# rule is: the socket itself is never changed — in a container it is the
# HOST's. private.odocker.ensure.socket.access still ran `sudo chgrp docker`
# from build, rebuild, reset and every container start (2026-10-06). Outside a
# test run, a socket whose group is not docker; docker itself answers nothing.
test.odocker.socketNeverChanged() {
  local fx bad="" opt; fx=$(test.suite.fixture.make odockersocketkept); test.odocker.socketStubs "$fx"
  opt=$(env -u OOSH_NO_INSTALL SUDO="sudo " FX="$fx" ODOCKER_SOCKET="$fx/docker.sock" PATH="$fx/bin:$PATH" OOSH_DIR="$OOSH_DIR" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    odocker.build >/dev/null 2>&1; odocker.rebuild >/dev/null 2>&1; odocker.reset >/dev/null 2>&1
    odocker.run someimage >/dev/null 2>&1
    private.odocker.docker.socket.opt 2>/dev/null' </dev/null 2>/dev/null | tail -1)
  grep -E '^(sudo|chgrp) ' "$fx/log" >/dev/null && bad="$bad changed=[$(grep -E '^(sudo|chgrp) ' "$fx/log" | tr '\n' '|')]"
  # The socket a container gets is the one odocker found: ODOCKER_SOCKET here.
  [ "$opt" = "-v $fx/docker.sock:/var/run/docker.sock" ] || bad="$bad mount=[$opt]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "no chgrp, no sudo on the socket; containers mount the socket odocker found" || create.result 1 "socket changed:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-SOCKET-NEVER-CHANGED: no odocker method ever runs chgrp or sudo on the docker socket" test.odocker.socketNeverChanged
expect 0 "no chgrp, no sudo on the socket; containers mount the socket odocker found" \
  "odocker build ran sudo chgrp docker on the host's socket"

# T-ODOCKER-SOCKET-ENV: ODOCKER_SOCKET names the docker socket, /var/run/docker.sock by default
# A started odocker cannot be given stand-in functions; the tests point it at
# a socket of their own (a Mac VM has none — PREREQ-START failed there,
# 2026-10-06).
test.odocker.socketEnv() {
  local bad="" got
  got=$(unset ODOCKER_SOCKET; private.odocker.socket.get); [ "$got" = "/var/run/docker.sock" ] || bad="$bad default=[$got]"
  got=$(ODOCKER_SOCKET=/tmp/x.sock private.odocker.socket.get); [ "$got" = "/tmp/x.sock" ] || bad="$bad env=[$got]"
  [ -z "$bad" ] && create.result 0 "ODOCKER_SOCKET, else /var/run/docker.sock" || create.result 1 "socket:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-SOCKET-ENV: ODOCKER_SOCKET names the docker socket, /var/run/docker.sock by default" test.odocker.socketEnv
expect 0 "ODOCKER_SOCKET, else /var/run/docker.sock" "the prerequisite tests depended on the machine having a docker socket"

# T-ODOCKER-SOCKET-GROUP-ENSURE: the group of the docker socket's number — found, or created
# One helper for the socket access of a started odocker AND the install,
# which adds every user to it (Alpine has no sg to apply a new membership at
# once, 2026-10-06).
test.odocker.socketGroupEnsure() {
  local fx bad="" got; fx=$(test.suite.fixture.make odockersocketgroup); test.odocker.socketStubs "$fx"
  test.odocker.socketGroupEnsure.run() { # prints the rc, RESULT and the group programs called (not sudo)
    : > "$fx/log"
    # A started odocker has sourced only this and odocker: no os.check.env, no
    # OS_CMD_GROUP_ADD — a normal user, so SUDO is sudo.
    env -u OS_CMD_GROUP_ADD SUDO="sudo " SGID=124 FX="$fx" PATH="$fx/bin:$PATH" OOSH_DIR="$OOSH_DIR" bash -c '
      OSTYPE=linux-gnu
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      private.odocker.socket.group.ensure "$FX/docker.sock" >/dev/null 2>&1; echo "rc=$? group=$RESULT"' 2>/dev/null | tail -1
    grep -E '^(groupadd|addgroup) ' "$fx/log" | tr '\n' '|'
  }
  echo "sockgrp:x:124:" > "$fx/group"
  got=$(test.odocker.socketGroupEnsure.run); [ "$got" = "rc=0 group=sockgrp" ] || bad="$bad existing=[$got]"
  : > "$fx/group"
  got=$(test.odocker.socketGroupEnsure.run); [ "$got" = "rc=0 group=docker
groupadd -g 124 docker|" ] || bad="$bad created=[$got]"
  # A second run finds the group it made: nothing is created again.
  got=$(test.odocker.socketGroupEnsure.run); [ "$got" = "rc=0 group=docker" ] || bad="$bad second-run=[$got]"
  echo "docker:x:999:" > "$fx/group"
  got=$(test.odocker.socketGroupEnsure.run); [ "$got" = "rc=0 group=dockerhost
groupadd -g 124 dockerhost|" ] || bad="$bad dockerhost=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the socket's group found, else docker or dockerhost created with its number, once" || create.result 1 "socket group:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-SOCKET-GROUP-ENSURE: the group of the docker socket's number — found, or created" test.odocker.socketGroupEnsure
expect 0 "the socket's group found, else docker or dockerhost created with its number, once" \
  "a started odocker ran sudo -g <gid> docker — os.check.env and OS_CMD_GROUP_ADD live in os and user"

# T-ODOCKER-NO-SG-NEXT-LOGIN: without sg, a new membership is announced for the next login
# Alpine (BusyBox) has no sg, and no package provides one: `odocker list` ended
# in "permission denied" with no word why (2026-10-06).
test.odocker.noSgNextLogin() {
  case "$(declare -f odocker.start)" in
    *'next login'*) create.result 0 "without sg the new membership is announced for the next login" ;;
    *) create.result 1 "odocker.start says nothing when sg is missing" ;;
  esac
  return $(result)
}
test.case $level "T-ODOCKER-NO-SG-NEXT-LOGIN: without sg, a new membership is announced for the next login" test.odocker.noSgNextLogin
expect 0 "without sg the new membership is announced for the next login" "Alpine: permission denied, and no word why"

# T-ODOCKER-DOCKER-REPO-APT: on apt systems the docker client comes from Docker's own repository
# Debian 12's docker.io is Docker 20.10 (API 1.41); a host's Docker 29 accepts
# 1.44 and up: "client version 1.41 is too old" (2026-10-06). Docker's
# repository has the current docker-ce-cli, as on dnf/yum.
# Once there it is left alone: every call downloaded the key again, rewrote the
# list and ran apt-get update (dnf: config-manager --add-repo). A failed or
# empty download left an empty key and a list that broke every later
# apt-get update — curl's rc was lost in a pipe. A package manager without a
# Docker repository is told so. All on a fixture root: stubs record every call,
# install and tee write there for real; SUDO is empty.
test.odocker.dockerRepoApt() {
  local fx bad="" out logSize sums realTee realInstall c deb
  fx=$(test.suite.fixture.make odockerrepoapt); mkdir -p "$fx/bin" "$fx/tmp"; : > "$fx/log"
  realTee=$(command -v tee); realInstall=$(command -v install)
  printf '%s\n' '#!/bin/sh' 'echo "curl $*" >> "$FX/log"' '[ "${CURL_RC:-0}" = 0 ] || exit "$CURL_RC"' 'printf "%s" "${CURL_OUT-KEY}"' > "$fx/bin/curl"
  for c in apt-get dnf yum; do printf '%s\n' '#!/bin/sh' "echo \"$c \$*\" >> \"\$FX/log\"" > "$fx/bin/$c"; done
  printf '%s\n' '#!/bin/sh' 'echo "dpkg $*" >> "$FX/log"' 'echo amd64' > "$fx/bin/dpkg"
  printf '%s\n' '#!/bin/sh' 'echo "install $*" >> "$FX/log"' "exec $realInstall \"\$@\"" > "$fx/bin/install"
  printf '%s\n' '#!/bin/sh' 'echo "tee $*" >> "$FX/log"' "exec $realTee \"\$@\"" > "$fx/bin/tee"
  chmod +x "$fx/bin/"*
  test.odocker.dockerRepoApt.run() { # <package manager> <root> <env assignments…>
    local pm="$1" root="$2"; shift 2
    # the root's own os-release (private.os.release.get reads <root>/etc/os-release)
    case "$pm" in apt-get*) mkdir -p "$root/etc"; printf '%s\n' 'ID=debian' 'VERSION_CODENAME=bookworm' > "$root/etc/os-release" ;; esac
    env PATH="$fx/bin:$PATH" SUDO="" TMPDIR="$fx/tmp" FX="$fx" OOSH_PM="$pm" ROOT="$root" OOSH_DIR="$OOSH_DIR" "$@" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      oo.cmd() { echo "oo.cmd $*" >> "$FX/log"; }
      private.odocker.docker.repo.add "$ROOT" >/dev/null 2>&1; echo "rc=$? $RESULT"' </dev/null 2>/dev/null | tail -1
  }
  deb='deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable'
  # apt, first run: key, list, one update
  out=$(test.odocker.dockerRepoApt.run "apt-get -y install" "$fx/apt")
  case "$out" in "rc=0 "*) ;; *) bad="$bad first=[$out]" ;; esac
  grep -q 'curl -fsSL https://download.docker.com/linux/debian/gpg' "$fx/log" || bad="$bad no-key-download"
  [ "$(cat "$fx/apt/etc/apt/keyrings/docker.asc" 2>/dev/null)" = KEY ] || bad="$bad key-file"
  [ "$(cat "$fx/apt/etc/apt/sources.list.d/docker.list" 2>/dev/null)" = "$deb" ] || bad="$bad list=[$(cat "$fx/apt/etc/apt/sources.list.d/docker.list" 2>/dev/null)]"
  [ "$(grep -c '^apt-get update' "$fx/log")" = 1 ] || bad="$bad updates=$(grep -c '^apt-get update' "$fx/log")"
  # apt, second run: nothing called, nothing changed
  logSize=$(wc -c < "$fx/log"); sums=$(cksum "$fx/apt/etc/apt/keyrings/docker.asc" "$fx/apt/etc/apt/sources.list.d/docker.list" 2>&1)
  out=$(test.odocker.dockerRepoApt.run "apt-get -y install" "$fx/apt")
  case "$out" in "rc=0 "*) ;; *) bad="$bad second=[$out]" ;; esac
  [ "$(wc -c < "$fx/log")" = "$logSize" ] || bad="$bad second-run-called=[$(tail -n +1 "$fx/log" | tail -3 | tr '\n' '|')]"
  [ "$(cksum "$fx/apt/etc/apt/keyrings/docker.asc" "$fx/apt/etc/apt/sources.list.d/docker.list" 2>&1)" = "$sums" ] || bad="$bad second-run-changed"
  # a failing download, an empty download: rc 1, nothing left behind
  for c in "fail CURL_RC=22" "empty CURL_OUT="; do
    : > "$fx/log"
    out=$(test.odocker.dockerRepoApt.run "apt-get -y install" "$fx/${c%% *}" "${c#* }")
    case "$out" in "rc=1 "*) ;; *) bad="$bad ${c%% *}=[$out]" ;; esac
    [ -e "$fx/${c%% *}/etc/apt/keyrings/docker.asc" ] && bad="$bad ${c%% *}-key-left"
    [ -e "$fx/${c%% *}/etc/apt/sources.list.d/docker.list" ] && bad="$bad ${c%% *}-list-left"
    grep -q '^apt-get update' "$fx/log" && bad="$bad ${c%% *}-updated"
    [ -z "$(ls -A "$fx/tmp")" ] || bad="$bad ${c%% *}-tmp-left=[$(ls -A "$fx/tmp" | tr '\n' ' ')]"
  done
  # dnf: the repository file once, then nothing
  : > "$fx/log"
  out=$(test.odocker.dockerRepoApt.run "dnf -y install" "$fx/dnf" CURL_OUT="[docker-ce-stable]")
  case "$out" in "rc=0 "*) ;; *) bad="$bad dnf=[$out]" ;; esac
  [ "$(cat "$fx/dnf/etc/yum.repos.d/docker-ce.repo" 2>/dev/null)" = "[docker-ce-stable]" ] || bad="$bad dnf-repo-file=[$(tr '\n' '|' < "$fx/log")]"
  logSize=$(wc -c < "$fx/log")
  out=$(test.odocker.dockerRepoApt.run "dnf -y install" "$fx/dnf")
  case "$out" in "rc=0 "*) ;; *) bad="$bad dnf-second=[$out]" ;; esac
  [ "$(wc -c < "$fx/log")" = "$logSize" ] || bad="$bad dnf-second-run-called"
  # apk: no Docker repository — rc 1 naming it, nothing called
  : > "$fx/log"
  out=$(test.odocker.dockerRepoApt.run "apk add" "$fx/apk")
  case "$out" in "rc=1 "*apk*) ;; *) bad="$bad apk=[$out]" ;; esac
  [ -s "$fx/log" ] && bad="$bad apk-called=[$(tr '\n' '|' < "$fx/log")]"
  [ -e "$fx/apk" ] && bad="$bad apk-wrote"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "Docker's repository: key, list and update once; a failed download leaves nothing; apk is refused" || create.result 1 "repo:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-DOCKER-REPO-APT: Docker's own repository is added once, a failed download leaves nothing behind" test.odocker.dockerRepoApt
expect 0 "Docker's repository: key, list and update once; a failed download leaves nothing; apk is refused" \
  "every call re-downloaded the key; a failed download left an empty key that broke apt-get update"


# Stand-in for docker in odocker.install: a running container with the socket
# mounted. $FX/log records every call. HASOOSH=yes: oosh is in the container
# (/root/oosh/odocker); PM: its package manager; SOCKGRP: the /etc/group line of
# the socket's number 4242, if any; DOCKERGRP=yes: a group docker (another number).
# The container's files live under $CT (default <fx>/ct): test -e, cat, mkdir -p,
# rm -f and `sh -c cat > <file>` work there; dpkg answers $CTARCH (arm64, not
# this host's). curl is a recording stand-in on a fixture PATH (CURL_RC, CURL_OUT);
# temporary files go to <fx>/tmp.
test.odocker.installRun() { # <fx> <env assignments…>
  local fx="$1"; shift
  mkdir -p "$fx/bin" "$fx/tmp" "$fx/ct"
  printf '%s\n' '#!/bin/sh' 'echo "curl $*" >> "$FX/curl.log"' '[ "${CURL_RC:-0}" = 0 ] || exit "$CURL_RC"' 'printf "%s" "${CURL_OUT-KEY}"' > "$fx/bin/curl"; chmod +x "$fx/bin/curl"
  env PATH="$fx/bin:$PATH" TMPDIR="$fx/tmp" FX="$fx" CT="$fx/ct" OOSH_DIR="$OOSH_DIR" "$@" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
    docker() {
      echo "docker $*" >> "$FX/log"
      case "$1" in
        inspect) case "$*" in *State*) echo running ;; *Mounts*) echo yes ;; esac ;;
        exec) shift; [ "$1" = -i ] && shift; shift
          case "$*" in
            *"echo \"\${OOSH_DIR"*) [ "$HASOOSH" = yes ] && echo /root/oosh ;;
            "test -f /root/oosh/odocker") [ "$HASOOSH" = yes ] ;;
            "test -e "*) [ -e "$CT$3" ] ;;
            "cat /etc/os-release") cat "$CT/etc/os-release" ;;
            "dpkg --print-architecture") echo "${CTARCH:-arm64}" ;;
            "mkdir -p "*) shift 2; local d; for d; do mkdir -p "$CT$d"; done ;;
            "rm -f "*) shift 2; local f; for f; do rm -f "$CT$f"; done ;;
            "sh -c cat > "*) local a="$*"; cat > "$CT${a##*cat > }" ;;
            *"command -v"*) echo "$PM" ;;
            # portability-exception: matches the command text odocker sends into a Linux container, runs no stat
            "stat -c %g /var/run/docker.sock") echo 4242 ;;
            *"getent group 4242"*) [ -n "$SOCKGRP" ] && echo "$SOCKGRP" ;;
            *"getent group docker"*) [ "$DOCKERGRP" = yes ] && echo "docker:x:999:" ;;
            awk*) echo tester ;;
          esac ;;
      esac
      # the answer of the arm that ran (test -e, test -f), else 0
      return; }
    odocker.install somecontainer >/dev/null 2>&1; echo "rc=$?"' </dev/null 2>/dev/null | tail -1
}

# T-ODOCKER-INSTALL-OOSH: odocker install runs odocker prereqs.install in a container with oosh
# odocker.install was a second, hand-forked copy of the client install (apt:
# docker.io, too old for a current host — Debian 12) and of the group rule
# (groupmod / delgroup renumbered an existing docker group). With oosh in the
# container, the container installs and groups itself, through the prelude.
test.odocker.installOosh() {
  local fx bad="" out; fx=$(test.suite.fixture.make odockerinstalloosh); : > "$fx/log"
  out=$(test.odocker.installRun "$fx" HASOOSH=yes PM=apt-get)
  [ "$out" = "rc=0" ] || bad="$bad rc=[$out]"
  grep -q "^docker exec somecontainer bash -c if \[ -f ~/config/user.env \].* /root/oosh/odocker prereqs.install" "$fx/log" || bad="$bad no-prereqs.install=[$(grep 'exec' "$fx/log" | tr '\n' '|')]"
  grep -qE 'docker\.io|groupmod|delgroup|apt-get|usermod|addgroup|groupadd' "$fx/log" && bad="$bad by-hand=[$(grep -E 'docker\.io|groupmod|delgroup|apt-get|usermod|addgroup|groupadd' "$fx/log" | tr '\n' '|')]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the container with oosh runs odocker prereqs.install through the prelude, nothing by hand" || create.result 1 "install oosh:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-INSTALL-OOSH: odocker install runs odocker prereqs.install in a container with oosh" test.odocker.installOosh
expect 0 "the container with oosh runs odocker prereqs.install through the prelude, nothing by hand" \
  "odocker install put docker.io (too old) in an apt container and renumbered its docker group"

# T-ODOCKER-INSTALL-RAW: a container without oosh gets the table's package names; no group is renumbered
# docker-ce-cli (apt, dnf/yum) comes from Docker's repository: the host
# downloads it with the data of private.odocker.docker.repo.get — the
# container's ID, VERSION_CODENAME and architecture — and writes it into the
# container (a naked image may have no curl), once. A failed download writes
# nothing into the container.
test.odocker.installRaw() {
  local fx bad="" out pm want n deb; fx=$(test.suite.fixture.make odockerinstallraw)
  mkdir -p "$fx/ct.apt-get/etc" "$fx/ct.dnf/etc" "$fx/ct.fail/etc"
  printf '%s\n' 'PRETTY_NAME="Ubuntu 24.04 LTS"' 'ID=ubuntu' 'VERSION_CODENAME=noble' | tee "$fx/ct.apt-get/etc/os-release" > "$fx/ct.fail/etc/os-release"
  printf '%s\n' 'ID="almalinux"' > "$fx/ct.dnf/etc/os-release"
  deb='deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable'
  for pm in apk apt-get dnf; do
    : > "$fx/log"; : > "$fx/curl.log"
    out=$(test.odocker.installRun "$fx" PM="$pm" CT="$fx/ct.$pm" CURL_OUT="[$pm-data]")
    [ "$out" = "rc=0" ] || bad="$bad $pm-rc=[$out]"
    want="$(OOSH_PM="$pm" private.odocker.prereq.package.get docker) $(OOSH_PM="$pm" private.odocker.prereq.package.get column)"
    grep -q "^docker exec somecontainer sh -c .*$pm.* $want\$" "$fx/log" || bad="$bad $pm-packages=[$(grep -vE 'command -v|inspect|OOSH_DIR' "$fx/log" | head -2 | tr '\n' '|')]"
    case "$pm" in
      apk) [ -s "$fx/curl.log" ] && bad="$bad apk-downloaded"
           [ -e "$fx/ct.apk/etc" ] && bad="$bad apk-wrote" ;;
      apt-get)
        grep -q 'curl -fsSL https://download.docker.com/linux/ubuntu/gpg' "$fx/curl.log" || bad="$bad apt-no-key-download=[$(tr '\n' '|' < "$fx/curl.log")]"
        [ "$(cat "$fx/ct.apt-get/etc/apt/keyrings/docker.asc" 2>/dev/null)" = "[apt-get-data]" ] || bad="$bad apt-key"
        [ "$(cat "$fx/ct.apt-get/etc/apt/sources.list.d/docker.list" 2>/dev/null)" = "$deb" ] || bad="$bad apt-list=[$(cat "$fx/ct.apt-get/etc/apt/sources.list.d/docker.list" 2>/dev/null)]"
        # the list is written before docker-ce-cli is installed
        n=$(grep -n 'cat > /etc/apt/sources.list.d/docker.list' "$fx/log" | cut -d: -f1)
        [ -n "$n" ] && [ "$n" -lt "$(grep -n 'apt-get -y install docker-ce-cli' "$fx/log" | cut -d: -f1)" ] || bad="$bad apt-order" ;;
      dnf)
        grep -q 'curl -fsSL https://download.docker.com/linux/centos/docker-ce.repo' "$fx/curl.log" || bad="$bad dnf-no-download"
        [ "$(cat "$fx/ct.dnf/etc/yum.repos.d/docker-ce.repo" 2>/dev/null)" = "[dnf-data]" ] || bad="$bad dnf-repo-file"
        grep -q 'DEBIAN_FRONTEND=noninteractive' "$fx/log" && bad="$bad dnf-has-apt-env" ;;
    esac
  done
  [ -z "$(ls -A "$fx/tmp")" ] || bad="$bad host-tmp-left"
  # second run: no download, no write into the container
  for pm in apt-get dnf; do
    : > "$fx/log"; : > "$fx/curl.log"
    out=$(test.odocker.installRun "$fx" PM="$pm" CT="$fx/ct.$pm")
    [ "$out" = "rc=0" ] || bad="$bad $pm-second-rc=[$out]"
    [ -s "$fx/curl.log" ] && bad="$bad $pm-second-downloaded"
    grep -qE 'exec -i|mkdir' "$fx/log" && bad="$bad $pm-second-wrote"
  done
  # a failing download: rc 1, nothing written into the container, no install of docker-ce-cli
  : > "$fx/log"
  out=$(test.odocker.installRun "$fx" PM=apt-get CT="$fx/ct.fail" CURL_RC=22)
  [ "$out" = "rc=1" ] || bad="$bad fail-rc=[$out]"
  [ -e "$fx/ct.fail/etc/apt" ] && bad="$bad fail-wrote"
  grep -q 'install docker-ce-cli' "$fx/log" && bad="$bad fail-installed"
  [ -z "$(ls -A "$fx/tmp")" ] || bad="$bad fail-host-tmp-left"
  : > "$fx/log"; test.odocker.installRun "$fx" PM=apt-get CT="$fx/ct.apt-get" >/dev/null
  grep -q 'DEBIAN_FRONTEND=noninteractive.* apt-get -y install' "$fx/log" || bad="$bad apt-interactive"
  # a docker group with another number is left alone: dockerhost gets the socket's number
  : > "$fx/log"; test.odocker.installRun "$fx" PM=apk DOCKERGRP=yes >/dev/null
  grep -q 'groupadd -g 4242 dockerhost' "$fx/log" || bad="$bad no-dockerhost=[$(grep group "$fx/log" | tr '\n' '|')]"
  grep -qE 'groupmod|delgroup|docker\.io' "$fx/log" && bad="$bad renumbered"
  # the socket's number has a group: it is used, nothing created
  : > "$fx/log"; test.odocker.installRun "$fx" PM=apk SOCKGRP="sockgrp:x:4242:" >/dev/null
  grep -q 'groupadd' "$fx/log" && bad="$bad created-over-existing"
  grep -q 'usermod -aG sockgrp tester' "$fx/log" || bad="$bad not-joined"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the table's client names; Docker's repository written into the container once, nothing on a failed download; the socket's group never renumbered" || create.result 1 "install raw:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-INSTALL-RAW: a container without oosh gets Docker's repository and the table's package names; no group is renumbered" test.odocker.installRaw
expect 0 "the table's client names; Docker's repository written into the container once, nothing on a failed download; the socket's group never renumbered" \
  "an apt or dnf container without oosh got no docker-ce-cli: Docker's repository was missing there"

# T-ODOCKER-PREREQS-INSTALL: odocker prereqs.install installs here and joins the socket's group — once; nothing in a test run
test.odocker.prereqsInstall() {
  local fx bad="" out; fx=$(test.suite.fixture.make odockerprereqsinstall); : > "$fx/log"; : > "$fx/docker.sock"; : > "$fx/member"
  test.odocker.prereqsInstall.run() { # <env assignments…>
    env -u OOSH_NO_INSTALL FX="$fx" ODOCKER_SOCKET="$fx/docker.sock" OOSH_DIR="$OOSH_DIR" "$@" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/odocker" >/dev/null 2>&1
      private.odocker.prereqs.ensure() { echo "prereqs.ensure" >> "$FX/log"; create.result 0 "present"; return 0; }
      private.odocker.socket.group.ensure() { echo "socket.group.ensure" >> "$FX/log"; create.result 0 "docker"; return 0; }
      user.group.add() { echo "join $*" >> "$FX/log"; echo docker >> "$FX/member"; }
      id() { case "$*" in "-nG tester") cat "$FX/member" ;; -u) echo 1000 ;; -un) echo tester ;; *) command id "$@" ;; esac; }
      odocker.prereqs.install tester >/dev/null 2>&1; echo "rc=$? $RESULT"' </dev/null 2>/dev/null | tail -1
  }
  out=$(test.odocker.prereqsInstall.run OOSH_NO_INSTALL=1)
  case "$out" in "rc=0 "*) ;; *) bad="$bad no-install-rc=[$out]" ;; esac
  [ -s "$fx/log" ] && bad="$bad no-install-called=[$(tr '\n' '|' < "$fx/log")]"
  # A test run sets OOSH_NO_INSTALL; this test IS about installing (with stand-ins).
  out=$(test.odocker.prereqsInstall.run)
  case "$out" in "rc=0 "*) ;; *) bad="$bad rc=[$out]" ;; esac
  [ "$(tr '\n' '|' < "$fx/log")" = "prereqs.ensure|socket.group.ensure|join docker tester|" ] || bad="$bad calls=[$(tr '\n' '|' < "$fx/log")]"
  # second run: the member is not added again
  test.odocker.prereqsInstall.run >/dev/null
  [ "$(grep -c '^join' "$fx/log")" = 1 ] || bad="$bad joined-again"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "prerequisites and the socket's group here; joined once; nothing under OOSH_NO_INSTALL" || create.result 1 "prereqs install:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-PREREQS-INSTALL: odocker prereqs.install installs here and joins the socket's group, once; nothing in a test run" test.odocker.prereqsInstall
expect 0 "prerequisites and the socket's group here; joined once; nothing under OOSH_NO_INSTALL" \
  "a container installed and grouped itself only through a second copy in odocker.install"


console.log "
Test: private.odocker.docker.repo.get
===================================================================="

# T-ODOCKER-DOCKER-REPO-GET: the one source of the data of Docker's repository
# The local add (T-ODOCKER-DOCKER-REPO-APT) and the container add
# (T-ODOCKER-INSTALL-RAW) both ask it; private.odocker.docker.repo.download and
# private.odocker.container.repo.add are tested through those two.
test.odocker.dockerRepoGet() {
  local fx bad="" got; fx=$(test.suite.fixture.make odockerrepoget)
  printf '%s\n' 'ID=debian' 'VERSION_CODENAME="bookworm"' > "$fx/os-release"
  got=$(private.odocker.docker.repo.get marker apt-get); [ "$got" = /etc/apt/sources.list.d/docker.list ] || bad="$bad apt-marker=[$got]"
  got=$(private.odocker.docker.repo.get file apt-get "$fx/os-release" amd64); [ "$got" = /etc/apt/keyrings/docker.asc ] || bad="$bad apt-file=[$got]"
  got=$(private.odocker.docker.repo.get url apt-get "$fx/os-release" amd64); [ "$got" = https://download.docker.com/linux/debian/gpg ] || bad="$bad apt-url=[$got]"
  got=$(private.odocker.docker.repo.get line apt-get "$fx/os-release" amd64)
  [ "$got" = "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" ] || bad="$bad apt-line=[$got]"
  got=$(private.odocker.docker.repo.get url apt-get "$fx/os-release"); [ "$?" = 1 ] && [ -z "$got" ] || bad="$bad apt-no-arch=[$got]"
  got=$(private.odocker.docker.repo.get url apt-get "$fx/none" amd64); [ "$?" = 1 ] && [ -z "$got" ] || bad="$bad apt-no-os-release=[$got]"
  got=$(private.odocker.docker.repo.get marker dnf); [ "$got" = /etc/yum.repos.d/docker-ce.repo ] || bad="$bad dnf-marker=[$got]"
  got=$(private.odocker.docker.repo.get file yum); [ "$got" = /etc/yum.repos.d/docker-ce.repo ] || bad="$bad yum-file=[$got]"
  got=$(private.odocker.docker.repo.get url dnf); [ "$got" = https://download.docker.com/linux/centos/docker-ce.repo ] || bad="$bad dnf-url=[$got]"
  got=$(private.odocker.docker.repo.get line dnf); [ "$?" = 0 ] && [ -z "$got" ] || bad="$bad dnf-line=[$got]"
  got=$(private.odocker.docker.repo.get marker apk); [ "$?" = 1 ] && [ -z "$got" ] || bad="$bad apk=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "marker, url, file and line per package manager; rc 1 for apk or missing apt values" || create.result 1 "repo get:$bad"
  return $(result)
}
test.case $level "T-ODOCKER-DOCKER-REPO-GET: the data of Docker's repository per package manager, from one getter" test.odocker.dockerRepoGet
expect 0 "marker, url, file and line per package manager; rc 1 for apk or missing apt values" \
  "the URLs, files and the list line lived inside the local add only"

### test.method

test.suite.save.results
