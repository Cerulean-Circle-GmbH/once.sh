#!/usr/bin/env bash
# T-NO-FLAGS — Death-to-Flags regression fence (#5, standing Tron directive).
# OOSH carries the verb in the method name, roles in POSITIONAL params, docs in
# .completion(); any `--flag` in a method's parameter surface is a violation.
#
# Covers: (A) regression FENCE — no `--` in any method-signature params block
# across the oosh scripts; (B) BEHAVIOR — hiveMind teams.restore/migrate use the
# flagless positional `<?mode:join|fork>` form (the removed `--fork`, E-FLAGS.1).
# (ref: session/tasks/flag-audit-death-to-flags.md E-FLAGS.2)

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

SCRIPTS="hiveMind otmux claudeCode ossh odocker oo config state test.suite"

# ============================================================================
# (A) FENCE — no `--flag` in any method-signature PARAMS block.
# OOSH signature: `name() # <params> # description`. The params live between the
# 1st and 2nd `#`. A `--` there = a flag param (violation). `--` in the trailing
# DESCRIPTION or in a method BODY calling an external tool is NOT a signature
# flag and is ignored by this fence.
# ============================================================================
flagSigs=""
for s in $SCRIPTS; do
  f="$OOSH_DIR/$s"
  [ -f "$f" ] || continue
  # method-def lines: `word.word() # ... # ...`
  while IFS= read -r line; do
    # isolate the params block = text after the FIRST '#', before the SECOND '#'
    afterHash="${line#*#}"
    params="${afterHash%%#*}"
    if printf '%s' "$params" | grep -qE '\-\-[a-zA-Z]'; then
      flagSigs="${flagSigs}${s}: ${line}"$'\n'
    fi
  done < <(grep -nE '^[a-zA-Z][a-zA-Z0-9_.]*\(\)[[:space:]]*#' "$f")
done
flagSigCount=$(printf '%s' "$flagSigs" | grep -c . | tr -d ' ')
test.case $level "T-NO-FLAGS (fence): no --flag in any method-signature params block" \
  echo "violations=$flagSigCount"
if [ "$flagSigCount" -eq 0 ]; then
  expect.pass "zero method signatures declare a --flag param"
else
  expect.fail "flag params reappeared in signatures:"$'\n'"$flagSigs"
fi

# ============================================================================
# (B) BEHAVIOR — teams.restore/migrate are flagless (the removed `--fork`).
# ============================================================================
HM="$OOSH_DIR/hiveMind"

# B1: the removed flag is GONE everywhere in hiveMind.
test.case $level "T-NO-FLAGS: hiveMind carries NO '--fork' anywhere" \
  echo "grep --fork"
if grep -qE '\-\-fork' "$HM"; then
  expect.fail "'--fork' reappeared in hiveMind:"$'\n'"$(grep -nE '\-\-fork' "$HM")"
else
  expect.pass "no '--fork' token in hiveMind"
fi

# B2: teams.restore offers a FLAGLESS fork path — tolerant of either OOSH shape
# the expert may land (E-FLAGS.1: positional `<?mode:join|fork>` OR a distinct
# `teams.restore.fork` method). Invariant: the fork path exists, with no `--`.
restoreSig=$(grep -nE '^hiveMind\.teams\.restore(\.fork)?\(\)' "$HM")
test.case $level "T-NO-FLAGS: teams.restore has a flagless fork path (positional mode OR .fork method)" \
  echo "$restoreSig"
posMode=$(printf '%s' "$restoreSig" | grep -E '<\?mode:join\|fork>')
forkMethod=$(printf '%s' "$restoreSig" | grep -E '^hiveMind\.teams\.restore\.fork\(\)')
if { [ -n "$posMode" ] || [ -n "$forkMethod" ]; } && ! printf '%s' "$restoreSig" | grep -qE '\-\-'; then
  expect.pass "flagless fork path present, no -- in signature"
else
  expect.fail "teams.restore needs a flagless fork path (<?mode:join|fork> or .fork method), no flags: $restoreSig"
fi

# B3: the fork/join distinction is carried POSITIONALLY (a bare `fork`/`join`
# token or a .fork method), NEVER via `--fork`.
restoreBody=$(awk '/^hiveMind\.teams\.restore(\.fork)?\(\)/{f=1} f{print} f&&/^}/{exit}' "$HM")
test.case $level "T-NO-FLAGS: fork/join carried positionally, never --fork" \
  echo "checking positional fork handling"
if { printf '%s' "$restoreBody" | grep -qE '^[[:space:]]*fork\)' \
     || [ -n "$forkMethod" ] \
     || grep -qE '^hiveMind\.teams\.restore\.fork\(\)' "$HM"; } \
   && ! printf '%s' "$restoreBody" | grep -qE '\-\-fork'; then
  expect.pass "fork handled positionally (case arm or .fork method), no --fork"
else
  expect.fail "fork must be positional (fork) arm / .fork method), never --fork"
fi

# B4: teams.migrate drives the flagless form — `teams.restore fork` (positional).
test.case $level "T-NO-FLAGS: teams.migrate calls flagless 'teams.restore fork'" \
  echo "grep migrate call"
if grep -qE 'teams\.restore fork' "$HM" && ! grep -qE 'teams\.restore[^#]*\-\-fork' "$HM"; then
  expect.pass "teams.migrate/remote drives 'teams.restore fork' positionally"
else
  expect.fail "teams.migrate must call 'teams.restore fork' (positional), never --fork"
fi

# ============================================================================
# (C) TRIAGE FENCE — body-level `--value` comparisons that read a flag-like
# token as a param VALUE (softer than a signature flag). The one filed item
# (otmux.layout.restore `<?force>` value "--force") was cleaned to a bare `force`
# sentinel in #33 (553b19a) → budget is now ZERO. Any `--value` param comparison
# reappearing = a new Death-to-Flags violation and fails the fence.
# ============================================================================
softFlags=""
for s in $SCRIPTS; do
  f="$OOSH_DIR/$s"
  [ -f "$f" ] || continue
  # `[ "$x" = "--y" ]` / `!= "--y"` on a positional var (exclude external-tool builders)
  while IFS= read -r hit; do
    echo "$hit" | grep -qE 'docker|git |tmux|ssh |curl|xsel|xclip|pbcopy|grep|sed|awk|jq|apt|brew|name_opt|--clipboard|--output|--help' && continue
    softFlags="${softFlags}${s}:${hit}"$'\n'
  done < <(grep -nE '(=|!=)[[:space:]]*"\-\-[a-zA-Z]' "$f")
done
softCount=$(printf '%s' "$softFlags" | grep -c . | tr -d ' ')
test.case $level "T-NO-FLAGS (triage): ZERO soft flag-value comparisons (budget 0)" \
  echo "soft=$softCount"$'\n'"$softFlags"
# Budget 0 — the last filed item (otmux --force) was cleaned in #33 (553b19a).
if [ "$softCount" -eq 0 ]; then
  expect.pass "zero soft flag-value comparisons — Death-to-Flags complete"
else
  expect.fail "soft flag-value comparison(s) present (must be 0): $softFlags"
fi

test.suite.save.results
