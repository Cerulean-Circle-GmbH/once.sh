#!/usr/bin/env bash
# Tests for this — OOSH kernel
# Tests: method dispatch, parameter parsing, constructor, single-word dispatch

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T1: this.start dispatches dotted method correctly
# ============================================================================
test.case $level "this.start dispatches dotted method (config.list)" \
  config list

if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "config list dispatched successfully"
else
  expect.fail "config list should dispatch to config.list()"
fi

# ============================================================================
# T2: this.absolutePath resolves relative paths
# ============================================================================
test.case $level "this.absolutePath resolves relative paths" \
  this.absolutePath "."

if [ -n "$RESULT" ] && [[ "$RESULT" == /* ]]; then
  expect.pass "this.absolutePath returned absolute path: $RESULT"
else
  expect.fail "this.absolutePath should return absolute path, got: $RESULT"
fi

# ============================================================================
# T3: this.isNumber validates numbers
# ============================================================================
test.case $level "this.isNumber validates numbers" \
  this.isNumber 42

if [ "$?" -eq 0 ]; then
  expect.pass "this.isNumber recognizes 42 as a number"
else
  expect.fail "this.isNumber should recognize 42 as a number"
fi

# ============================================================================
# T4: this.isNumber rejects non-numbers
# ============================================================================
test.case $level "this.isNumber rejects non-numbers" \
  this.isNumber "abc"

# Note: test.case sets RETURN_VALUE, not $?
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "this.isNumber rejects 'abc'"
else
  # BUG: this.isNumber may accept non-numbers (rc=0 for 'abc')
  expect.fail "this.isNumber should reject 'abc' (RETURN_VALUE=$RETURN_VALUE)"
fi

# ============================================================================
# T5: this.help exists and runs
# ============================================================================
test.case $level "this.help function exists" \
  type -t this.help

if type -t this.help &>/dev/null; then
  expect.pass "this.help function exists"
else
  expect.fail "this.help should be a function"
fi

# ============================================================================
# BUG REPRODUCTION: Single-word method dispatch
# Known issue: single-word methods (e.g., hiveMind dashboard) may conflict
# with OOSH dispatch when scripts have sub-methods starting with the same word
# ============================================================================
test.case $level "BUG: single-word dispatch (config list vs config.list)" \
  echo "testing dispatch"

# config list should dispatch to config.list(), not try to run "list" as a command
CONFIG_OUTPUT=$(./config list 2>&1)
CONFIG_RC=$?
# config.list outputs to LOG_DEVICE, so check exit code only
if [ $CONFIG_RC -eq 0 ]; then
  expect.pass "single-word 'config list' dispatches correctly (rc=0)"
else
  expect.fail "single-word 'config list' dispatch failed (rc=$CONFIG_RC)"
fi

# ============================================================================
# FIX VERIFICATION: Dashed parameter names
# this.start should reject dashes with error, not hang or crash
# (dashes are not valid OOSH convention — use dots: peer.compact)
# ============================================================================
test.case $level "dashed names rejected gracefully by this.start" \
  this.start peer-compact

# this.start should return non-zero for dashed names
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "dashed name 'peer-compact' rejected gracefully (rc=$RETURN_VALUE)"
else
  expect.fail "dashed name 'peer-compact' should be rejected (RETURN_VALUE=$RETURN_VALUE)"
fi

# ============================================================================
# T-ENV-I: HONEST clean boot from a LITERALLY empty env -i (no-state-interference
# / constructor principle). Feed NOTHING — no HOME, no PATH, no OOSH_*/CONFIG/LOG.
# A clean machine/boot has no inherited state; rigging env -i with HOME/PATH is
# forbidden (no human does that). Asserts: rc=0, and HOME/OOSH_DIR/CONFIG_PATH
# self-derive from OS identity (not the env). CONFIG_PATH must NOT degrade to
# /config (the empty-HOME bug). See memory feedback_env_i_honest_boot.md.
# ============================================================================
ENVI_OO="$OOSH_DIR/oo"
ENVI_THIS="$OOSH_DIR/this"

# 1) full entry: `oo mode.list` boots to rc=0 from empty env -i
test.case $level "T-ENV-I-1: oo mode.list boots from literal env -i (nothing fed)" \
  echo "env -i $ENVI_OO mode.list"
env -i /bin/bash -c '"'"$ENVI_OO"'" mode.list' >/dev/null 2>&1
ENVI_RC=$?
if [ "$ENVI_RC" -eq 0 ]; then
  expect.pass "oo mode.list rc=0 under empty env -i"
else
  expect.fail "oo mode.list should boot from empty env -i, rc=$ENVI_RC"
fi

# 2) HOME/OOSH_DIR/CONFIG_PATH self-derive correctly INSIDE the process
test.case $level "T-ENV-I-2: HOME/CONFIG_PATH self-derive (no /config degrade)" \
  echo "measuring in-process derivation"
ENVI_OUT=$(env -i /bin/bash -c 'source "'"$ENVI_THIS"'" >/dev/null 2>&1; this.init >/dev/null 2>&1; echo "$HOME|$OOSH_DIR|$CONFIG_PATH"' 2>/dev/null)
ENVI_HOME="${ENVI_OUT%%|*}"
ENVI_REST="${ENVI_OUT#*|}"
ENVI_ODIR="${ENVI_REST%%|*}"
ENVI_CPATH="${ENVI_REST##*|}"
if [ "$ENVI_HOME" = "$HOME" ] && [ "$ENVI_ODIR" = "$HOME/oosh" ] && [ "$ENVI_CPATH" = "$HOME/config" ]; then
  expect.pass "env -i self-derived HOME=$ENVI_HOME OOSH_DIR=$ENVI_ODIR CONFIG_PATH=$ENVI_CPATH"
else
  expect.fail "env -i derivation wrong: HOME=$ENVI_HOME OOSH_DIR=$ENVI_ODIR CONFIG_PATH=$ENVI_CPATH (expected home=$HOME, oosh=$HOME/oosh, config=$HOME/config)"
fi

# ============================================================================
# T-ENV-I GATE (oosh-tester independent — task a4.2): additive coverage over the
# expert's T-ENV-I-1/2. Different entry point (config list, not oo mode.list) +
# an explicit NEGATIVE regression guard on the exact bug (CONFIG_PATH=/config,
# empty HOME). Feeds NOTHING — literal empty env -i (no hand-fed HOME/PATH).
# ============================================================================
ENVI_CONFIG="$OOSH_DIR/config"

# 3) independent entry point: `config list` also boots rc=0 from empty env -i
test.case $level "T-ENV-I-3: config list boots from literal env -i (nothing fed)" \
  echo "env -i $ENVI_CONFIG list"
env -i /bin/bash -c '"'"$ENVI_CONFIG"'" list' >/dev/null 2>&1
ENVI_CFG_RC=$?
if [ "$ENVI_CFG_RC" -eq 0 ]; then
  expect.pass "config list rc=0 under empty env -i"
else
  expect.fail "config list should boot from empty env -i, rc=$ENVI_CFG_RC"
fi

# 4) NEGATIVE regression guard: the empty-HOME bug must NOT recur — under a
#    literal env -i, CONFIG_PATH must not degrade to /config and HOME must not
#    be empty. Asserts the failure mode directly, not just the happy path.
test.case $level "T-ENV-I-4: no /config degrade + non-empty HOME under env -i" \
  echo "guarding the empty-HOME regression"
ENVI_G=$(env -i /bin/bash -c 'source "'"$ENVI_THIS"'" >/dev/null 2>&1; this.init >/dev/null 2>&1; echo "$HOME|$CONFIG_PATH"' 2>/dev/null)
ENVI_G_HOME="${ENVI_G%%|*}"
ENVI_G_CPATH="${ENVI_G##*|}"
if [ -n "$ENVI_G_HOME" ] && [ "$ENVI_G_CPATH" != "/config" ] && [ "$ENVI_G_CPATH" = "$ENVI_G_HOME/config" ]; then
  expect.pass "no degrade: HOME=$ENVI_G_HOME (non-empty), CONFIG_PATH=$ENVI_G_CPATH (not /config)"
else
  expect.fail "empty-HOME regression: HOME='$ENVI_G_HOME' CONFIG_PATH='$ENVI_G_CPATH' (must be non-empty HOME + \$HOME/config, never /config)"
fi

# ============================================================================
# Test Summary
# ============================================================================

test.suite.save.results
