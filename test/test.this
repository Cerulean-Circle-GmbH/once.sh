#!/usr/bin/env bash
# Tests for this — OOSH kernel
# Tests: method dispatch, parameter parsing, constructor, single-word dispatch
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T1: this.start dispatches dotted method correctly
# ============================================================================
test.case $level "this.start dispatches dotted method (config.list)" \
  config list

if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "config list dispatched successfully"
else
  expect.fail "config list should dispatch to config.list()"
fi

# ============================================================================
# T2: this.absolutePath resolves relative paths
# ============================================================================
test.case $level "this.absolutePath resolves relative paths" \
  this.absolutePath "."

if [ -n "$RESULT" ] && [[ "$RESULT" == /* ]]; then
  expect.pass "this.absolutePath returned absolute path: $RESULT"
else
  expect.fail "this.absolutePath should return absolute path, got: $RESULT"
fi

# ============================================================================
# T3: this.isNumber validates numbers
# ============================================================================
test.case $level "this.isNumber validates numbers" \
  this.isNumber 42

if [ "$?" -eq 0 ]; then
  expect.pass "this.isNumber recognizes 42 as a number"
else
  expect.fail "this.isNumber should recognize 42 as a number"
fi

# ============================================================================
# T4: this.isNumber rejects non-numbers
# ============================================================================
test.case $level "this.isNumber rejects non-numbers" \
  this.isNumber "abc"

# Note: test.case sets RETURN_VALUE, not $?
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "this.isNumber rejects 'abc'"
else
  # BUG: this.isNumber may accept non-numbers (rc=0 for 'abc')
  expect.fail "this.isNumber should reject 'abc' (RETURN_VALUE=$RETURN_VALUE)"
fi

# ============================================================================
# T5: this.help exists and runs
# ============================================================================
test.case $level "this.help function exists" \
  type -t this.help

if type -t this.help &>/dev/null; then
  expect.pass "this.help function exists"
else
  expect.fail "this.help should be a function"
fi

# ============================================================================
# BUG REPRODUCTION: Single-word method dispatch
# Known issue: single-word methods (e.g., hiveMind dashboard) may conflict
# with OOSH dispatch when scripts have sub-methods starting with the same word
# ============================================================================
test.case $level "BUG: single-word dispatch (config list vs config.list)" \
  echo "testing dispatch"

# config list should dispatch to config.list(), not try to run "list" as a command
CONFIG_OUTPUT=$($OOSH_DIR/config list 2>&1)
CONFIG_RC=$?
# config.list outputs to LOG_DEVICE, so check exit code only
if [ $CONFIG_RC -eq 0 ]; then
  expect.pass "single-word 'config list' dispatches correctly (rc=0)"
else
  expect.fail "single-word 'config list' dispatch failed (rc=$CONFIG_RC)"
fi

# ============================================================================
# FIX VERIFICATION: Dashed parameter names
# this.start should reject dashes with error, not hang or crash
# (dashes are not valid OOSH convention — use dots: peer.compact)
# ============================================================================
test.case $level "dashed names rejected gracefully by this.start" \
  this.start peer-compact

# this.start should return non-zero for dashed names
if [ "$RETURN_VALUE" -ne 0 ]; then
  expect.pass "dashed name 'peer-compact' rejected gracefully (rc=$RETURN_VALUE)"
else
  expect.fail "dashed name 'peer-compact' should be rejected (RETURN_VALUE=$RETURN_VALUE)"
fi

# ============================================================================
# T6: Unknown method returns 127 with error message
# ============================================================================
test.case.expect.error 127 "unknown method returns 127" \
  this.call nonExistentMethod_xyzzy
if [ "$RETURN_VALUE" -eq 127 ]; then
  expect.pass "unknown method 'nonExistentMethod_xyzzy' returns 127"
else
  expect.fail "unknown method should return 127, got $RETURN_VALUE"
fi

# ============================================================================
# T7: Unknown method on wrapper script shows suggestions
# ============================================================================
# Capture stderr+stdout from otmux with a bogus method
UNKNOWN_OUTPUT=$($OOSH_DIR/otmux logg 2>&1)
UNKNOWN_RC=$?
if [ $UNKNOWN_RC -eq 127 ] || [ $UNKNOWN_RC -eq 1 ]; then
  expect.pass "otmux logg returns non-zero exit code ($UNKNOWN_RC)"
else
  expect.fail "otmux logg should return non-zero, got $UNKNOWN_RC"
fi

# ============================================================================
# T8: Stage 3 dynamic loading still works (regression)
# ============================================================================
test.case $level "this.call still loads scripts dynamically (mycmd feature3)" \
  this.call mycmd feature3 hello world

if [ "$RETURN_VALUE" -eq 0 ]; then
  expect.pass "this.call mycmd feature3 still works via this.load"
else
  expect.fail "this.call mycmd feature3 should still work (rc=$RETURN_VALUE)"
fi

# ============================================================================
# T-FN-PARTIAL-* : this.function.partial defines a closured delegate.
# Replaces ad-hoc `source /dev/stdin <<HEREDOC` patterns so promote's
# per-platform check stub generation can be OOSH-idiomatic.
# ============================================================================

# T-FN-PARTIAL-1: missing args → non-zero return
test.case $level "T-FN-PARTIAL-1: missing args returns non-zero" \
  echo "(this.function.partial with no args)"
this.function.partial >/dev/null 2>&1
if [ "$RETURN_VALUE" != "0" ]; then
  expect.pass "missing args → RETURN_VALUE=$RETURN_VALUE"
else
  expect.fail "expected non-zero RETURN_VALUE, got 0"
fi

# T-FN-PARTIAL-2: defined wrapper invokes target with bound first arg + extra
_FN_PARTIAL_TARGET_CAPTURE=""
_fn_partial_target() { _FN_PARTIAL_TARGET_CAPTURE="$*"; }
this.function.partial test.fn.partial.wrap1 _fn_partial_target FIRST >/dev/null 2>&1
test.case $level "T-FN-PARTIAL-2: wrapper passes bound first arg + extras to target" \
  echo "(call test.fn.partial.wrap1 extra1 extra2)"
test.fn.partial.wrap1 extra1 extra2
if [ "$_FN_PARTIAL_TARGET_CAPTURE" = "FIRST extra1 extra2" ]; then
  expect.pass "target received: '$_FN_PARTIAL_TARGET_CAPTURE'"
else
  expect.fail "target received: '$_FN_PARTIAL_TARGET_CAPTURE' (expected 'FIRST extra1 extra2')"
fi

# T-FN-PARTIAL-3: bound first arg is closured by value, not reference
_FN_PARTIAL_TARGET_CAPTURE=""
_FN_PARTIAL_FIRST=ORIGINAL
this.function.partial test.fn.partial.wrap2 _fn_partial_target "$_FN_PARTIAL_FIRST" >/dev/null 2>&1
_FN_PARTIAL_FIRST=REBOUND   # mutate after definition — must NOT affect wrap2
test.case $level "T-FN-PARTIAL-3: bound first arg is closured by value" \
  echo "(rebind first-arg variable, then call wrap2)"
test.fn.partial.wrap2 tail
if [ "$_FN_PARTIAL_TARGET_CAPTURE" = "ORIGINAL tail" ]; then
  expect.pass "closure held ORIGINAL: '$_FN_PARTIAL_TARGET_CAPTURE'"
else
  expect.fail "closure leaked: '$_FN_PARTIAL_TARGET_CAPTURE' (expected 'ORIGINAL tail')"
fi

unset -f _fn_partial_target test.fn.partial.wrap1 test.fn.partial.wrap2
unset _FN_PARTIAL_TARGET_CAPTURE _FN_PARTIAL_FIRST

# ============================================================================
# T-HEREDOC-LOCKDOWN: `source /dev/stdin` lives only inside
# this.function.partial. Regression net for the OOSH-conformance audit —
# any new HEREDOC code-synthesis site outside the documented OOSH helper
# is an anti-pattern.
# ============================================================================
test.case $level "T-HEREDOC-LOCKDOWN: source /dev/stdin only in dev/this (this.function.partial)" \
  echo "(grep across dev/ shell scripts)"
# `cd` into $OOSH_DIR so paths are relative (start with `./`), then anchor
# the directory filter to the start of the relative path. Two earlier
# attempts had portability issues:
#   - `grep -v '/test/'` (substring): false-matched `/home/test/` when the
#     test ran as user `test` inside `os platform.test`.
#   - `grep --exclude-dir=test`: GNU extension, busybox grep (Alpine
#     default) doesn't support it and silently let the test/ directory
#     through the filter.
# Anchoring with `^\./test/` works on both GNU and busybox grep.
_HEREDOC_HITS=$( cd "$OOSH_DIR" && \
  grep -rln 'source /dev/stdin' . 2>/dev/null \
  | grep -vE '^\./(\.git|docs|templates|test|sessions|restore)/' \
  | sort -u )
_HEREDOC_EXPECTED="./this"
if [ "$_HEREDOC_HITS" = "$_HEREDOC_EXPECTED" ]; then
  expect.pass "source /dev/stdin confined to dev/this (this.function.partial)"
else
  # Diagnostic — emit environment so future failures in cross-user platform
  # tests can be diagnosed from the log alone. (Quiet on the passing path.)
  echo "  DIAG: OOSH_DIR=$OOSH_DIR"
  echo "  DIAG: id=$(id 2>/dev/null)"
  echo "  DIAG: ls -laL \$OOSH_DIR | head:"
  ls -laL "$OOSH_DIR" 2>&1 | head -5 | sed 's/^/    /'
  echo "  DIAG: ls -l \$OOSH_DIR/this:"
  ls -l "$OOSH_DIR/this" 2>&1 | sed 's/^/    /'
  echo "  DIAG: grep -c 'source /dev/stdin' \$OOSH_DIR/this = $(grep -c 'source /dev/stdin' "$OOSH_DIR/this" 2>&1)"
  echo "  DIAG: raw grep -rln (no filter):"
  grep -rln 'source /dev/stdin' "$OOSH_DIR" 2>&1 | head -10 | sed 's/^/    /'
  expect.fail "source /dev/stdin found outside this.function.partial: $_HEREDOC_HITS"
fi
unset _HEREDOC_HITS _HEREDOC_EXPECTED

# ============================================================================
# T-SYMLINK-WITH-BACKUP-*: private.this.symlink.with.backup primitive
# ----------------------------------------------------------------------------
# Single canonical "make <linkPath> a symlink to <target>; preserve any
# pre-existing real entry as <linkPath>.orig.<ts>" primitive. Both
# `private.oo.user.shared.symlinks.ensure` (oo, state 31) and
# `config.init.user` (config) delegate to this — see the primitive's
# docstring of private.this.symlink.with.backup for the full contract.
#
# Four cases × one arg-validation:
#   ABSENT   → link created, no .orig.*
#   CORRECT  → no-op, no .orig.*, return 0
#   STALE    → re-pointed, no .orig.*
#   REAL-DIR → backed up to .orig.<ts>, link created
#   BAD-ARGS → return non-zero, no filesystem change
# ============================================================================
SLB_FIXTURE="/tmp/test.this.symlink.with.backup.$$"
mkdir -p "$SLB_FIXTURE/target.a" "$SLB_FIXTURE/target.b" "$SLB_FIXTURE/home"

test.symlink.with.backup.absent() {
  local link="$SLB_FIXTURE/home/absent"
  rm -rf "$link" "$link.orig."*
  private.this.symlink.with.backup "$link" "$SLB_FIXTURE/target.a" "20260101-000000" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ] && [ -L "$link" ] \
     && [ "$(readlink "$link")" = "$SLB_FIXTURE/target.a" ] \
     && ! ls "$link.orig."* >/dev/null 2>&1; then
    create.result 0 "absent → linked, no .orig.*"
  else
    create.result 1 "rc=$rc link=$([ -L "$link" ] && echo L || echo X) target=$(readlink "$link" 2>/dev/null)"
  fi
}
test.case $level "T-SYMLINK-WITH-BACKUP-ABSENT: absent path → symlink created" \
  test.symlink.with.backup.absent
expect 0 "*" "primitive creates symlink when no entry exists"

test.symlink.with.backup.correct() {
  local link="$SLB_FIXTURE/home/correct"
  rm -rf "$link" "$link.orig."*
  ln -s "$SLB_FIXTURE/target.a" "$link"
  private.this.symlink.with.backup "$link" "$SLB_FIXTURE/target.a" "20260101-000000" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ] && [ -L "$link" ] \
     && [ "$(readlink "$link")" = "$SLB_FIXTURE/target.a" ] \
     && ! ls "$link.orig."* >/dev/null 2>&1; then
    create.result 0 "already-correct → no-op, no .orig.*"
  else
    create.result 1 "rc=$rc link=$([ -L "$link" ] && echo L || echo X) target=$(readlink "$link" 2>/dev/null) orig=$(ls "$link.orig."* 2>/dev/null)"
  fi
}
test.case $level "T-SYMLINK-WITH-BACKUP-CORRECT: already-correct → idempotent no-op" \
  test.symlink.with.backup.correct
expect 0 "*" "primitive is idempotent on correct state"

test.symlink.with.backup.stale() {
  local link="$SLB_FIXTURE/home/stale"
  rm -rf "$link" "$link.orig."*
  ln -s "$SLB_FIXTURE/target.b" "$link"
  private.this.symlink.with.backup "$link" "$SLB_FIXTURE/target.a" "20260101-000000" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ] && [ -L "$link" ] \
     && [ "$(readlink "$link")" = "$SLB_FIXTURE/target.a" ] \
     && ! ls "$link.orig."* >/dev/null 2>&1; then
    create.result 0 "stale → re-pointed, no .orig.*"
  else
    create.result 1 "rc=$rc link=$([ -L "$link" ] && echo L || echo X) target=$(readlink "$link" 2>/dev/null) orig=$(ls "$link.orig."* 2>/dev/null)"
  fi
}
test.case $level "T-SYMLINK-WITH-BACKUP-STALE: stale symlink → re-pointed" \
  test.symlink.with.backup.stale
expect 0 "*" "primitive removes stale symlink and re-creates pointing at <target>"

test.symlink.with.backup.realdir() {
  local link="$SLB_FIXTURE/home/realdir"
  rm -rf "$link" "$link.orig."*
  mkdir -p "$link"
  touch "$link/preserve-me"
  private.this.symlink.with.backup "$link" "$SLB_FIXTURE/target.a" "20260101-000000" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -eq 0 ] && [ -L "$link" ] \
     && [ "$(readlink "$link")" = "$SLB_FIXTURE/target.a" ] \
     && [ -d "$link.orig.20260101-000000" ] \
     && [ -f "$link.orig.20260101-000000/preserve-me" ]; then
    create.result 0 "real-dir → backed up as .orig.<ts>, link created, contents preserved"
  else
    create.result 1 "rc=$rc link=$([ -L "$link" ] && echo L || echo X) target=$(readlink "$link" 2>/dev/null) backup=$([ -d "$link.orig.20260101-000000" ] && echo Y || echo N) contents=$([ -f "$link.orig.20260101-000000/preserve-me" ] && echo Y || echo N)"
  fi
}
test.case $level "T-SYMLINK-WITH-BACKUP-REALDIR: real-dir → backup + link" \
  test.symlink.with.backup.realdir
expect 0 "*" "primitive preserves real entry as .orig.<ts> with contents intact"

test.symlink.with.backup.badargs() {
  private.this.symlink.with.backup "" "/some/target" "20260101-000000" >/dev/null 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    create.result 0 "missing linkPath rejected (rc=$rc)"
  else
    create.result 1 "missing linkPath was accepted — should fail with non-zero"
  fi
}
test.case $level "T-SYMLINK-WITH-BACKUP-BADARGS: missing arg → non-zero, no fs change" \
  test.symlink.with.backup.badargs
expect 0 "*" "primitive validates required args"

rm -rf "$SLB_FIXTURE"
unset SLB_FIXTURE

# ============================================================================
# T-OOSH-DIR / T-CONFIG-PATH: the path anchors ARE the ~/… symlinks
# ============================================================================
# The boss ruling (docs/config.md § The anchor rule): OOSH_DIR is ALWAYS ~/oosh and CONFIG_PATH is
# ALWAYS ~/config — the symlink paths themselves. That makes them constants —
# switching branches, or re-pointing the shared tree, moves only what the
# symlink points AT — so user.env/oosh.env carry both as the "$HOME/…" constants, and
# everything that needs the PHYSICAL directory resolves it at point of use.

# --- T-OOSH-DIR-IS-HOME-OOSH: the live shell holds the constant --------------
test.this.ooshDirIsHomeOosh() {
  if [ "$OOSH_DIR" = "$HOME/oosh" ]; then
    create.result 0 "$OOSH_DIR"
  else
    create.result 1 "OOSH_DIR=$OOSH_DIR (expected $HOME/oosh) — start a new shell (it reads ~/config/user.env)"
  fi
}
test.case $level "T-OOSH-DIR-IS-HOME-OOSH: OOSH_DIR is the ~/oosh symlink itself" \
  test.this.ooshDirIsHomeOosh
expect 0 "$HOME/oosh" "OOSH_DIR is the constant ~/oosh, never a resolved worktree path"

# --- T-CONFIG-PATH-IS-HOME-CONFIG: same rule, same shape ---------------------
test.this.configPathIsHomeConfig() {
  if [ "$CONFIG_PATH" = "$HOME/config" ]; then
    create.result 0 "$CONFIG_PATH"
  else
    create.result 1 "CONFIG_PATH=$CONFIG_PATH (expected $HOME/config) — start a new shell (it reads ~/config/user.env)"
  fi
}
test.case $level "T-CONFIG-PATH-IS-HOME-CONFIG: CONFIG_PATH is the ~/config symlink itself" \
  test.this.configPathIsHomeConfig
expect 0 "$HOME/config" "CONFIG_PATH is the constant ~/config, never the resolved sharedConfig"

# --- T-OOSH-DIR-VALIDATE-TREE: the shipped tree obeys the rule ---------------
test.this.ooshDirValidateTree() {
  local out
  out=$(this.anchor.validate all "$OOSH_DIR" 2>/dev/null)
  local rc=$?
  # both anchors must report clean — count the OK lines, not just the last one
  local okLines
  okLines=$(printf '%s\n' "$out" | grep -c "0 violations")
  if [ "$rc" -eq 0 ] && [ "$okLines" -eq 2 ]; then
    create.result 0 "tree conforms"
  else
    create.result 1 "rc=$rc okLines=$okLines $out"
  fi
}
test.case $level "T-ANCHOR-VALIDATE-TREE: every OOSH_DIR=/CONFIG_PATH= in the tree conforms" \
  test.this.ooshDirValidateTree
expect 0 "tree conforms" "no unmarked anchor assignment escapes the rule"

# --- T-OOSH-DIR-VALIDATE-CATCHES: the guard can actually FAIL ----------------
# A guard that never fails guards nothing. Plant each of the three shapes in a
# throwaway git repo (git grep needs the file tracked; `git add` is enough).
ODV_FIXTURE=$(mktemp -d "/tmp/test.this.ooshdir.XXXXXX")
git -c init.defaultBranch=main init "$ODV_FIXTURE" >/dev/null 2>&1

private.test.this.oosh.dir.plant() { # <anchor> <fileContent...> # write + track ./planted, echo the validator's output
  local anchor="$1"; shift
  printf '%s\n' "$@" > "$ODV_FIXTURE/planted"
  git -C "$ODV_FIXTURE" add planted >/dev/null 2>&1
  # LOG_DEVICE is not always a tty (test.suite core redirects), so error.log
  # lines can land in this capture alongside the verdict — match on substrings,
  # never on a prefix.
  this.anchor.validate "$anchor" "$ODV_FIXTURE" 2>/dev/null
}

test.this.ooshDirValidateRejects() {
  local out
  out=$(private.test.this.oosh.dir.plant OOSH_DIR '#!/usr/bin/env bash' \
        'export OOSH_DIR="$(cd "$HOME/oosh" && pwd -P)"')
  case "$out" in
    *"INVALID:"*"1 violation"*) create.result 0 "pwd -P assignment rejected" ;;
    *)                          create.result 1 "expected 1 violation, got: $out" ;;
  esac
}
test.case $level "T-OOSH-DIR-VALIDATE-REJECTS: a resolved assignment is a violation" \
  test.this.ooshDirValidateRejects
expect 0 "pwd -P assignment rejected" "resolving ~/oosh into OOSH_DIR is caught"

test.this.ooshDirValidateAccepts() {
  local out
  out=$(private.test.this.oosh.dir.plant OOSH_DIR '#!/usr/bin/env bash' \
        'export OOSH_DIR="$HOME/oosh"')
  case "$out" in
    *"OK:"*"1 conforming"*) create.result 0 "literal accepted" ;;
    *)                      create.result 1 "expected 1 conforming, got: $out" ;;
  esac
}
test.case $level "T-OOSH-DIR-VALIDATE-ACCEPTS: the literal \$HOME/oosh conforms" \
  test.this.ooshDirValidateAccepts
expect 0 "literal accepted" "OOSH_DIR=\$HOME/oosh is the one conforming form"

test.this.ooshDirValidateException() {
  local out
  out=$(private.test.this.oosh.dir.plant OOSH_DIR '#!/usr/bin/env bash' \
        '# oosh-dir-exception: fixture — target has no ~/oosh yet' \
        'export OOSH_DIR="/somewhere/else"')
  case "$out" in
    *"OK:"*"1 exception"*) create.result 0 "marked exception honoured" ;;
    *)                     create.result 1 "expected 1 exception, got: $out" ;;
  esac
}
test.case $level "T-OOSH-DIR-VALIDATE-EXCEPTION: an in-code marker is honoured" \
  test.this.ooshDirValidateException
expect 0 "marked exception honoured" "# oosh-dir-exception: <reason> exempts the line"

# --- T-CONFIG-PATH-VALIDATE-REJECTS: the same guard, its own anchor ---------
# Proves the rule is per-anchor: the CONFIG_PATH scan must reject a resolved
# ~/config, and must NOT be satisfied by an OOSH_DIR-shaped marker.
test.this.configPathValidateRejects() {
  local out
  out=$(private.test.this.oosh.dir.plant CONFIG_PATH '#!/usr/bin/env bash' \
        '# oosh-dir-exception: wrong anchor marker, must not exempt CONFIG_PATH' \
        'export CONFIG_PATH="$(cd "$HOME/config" && pwd -P)"')
  case "$out" in
    *"INVALID:"*"CONFIG_PATH"*"1 violation"*) create.result 0 "resolved CONFIG_PATH rejected" ;;
    *)                                        create.result 1 "expected 1 violation, got: $out" ;;
  esac
}
test.case $level "T-CONFIG-PATH-VALIDATE-REJECTS: resolved ~/config is a violation" \
  test.this.configPathValidateRejects
expect 0 "resolved CONFIG_PATH rejected" "each anchor has its own marker; the wrong one does not exempt"

# --- T-ANCHOR-VALIDATE-BLIND: a tree git lists no tracked file in is no OK ----
# ogit.repo.grep discards stderr, so a folder that is no repository, a
# repository with nothing tracked and git's "dubious ownership" refusal all
# came back as an empty sweep — and both anchors printed OK, 0 violations.
test.this.anchorValidateRefusesBlind() {
  local bad="" out rc fx
  fx=$(test.suite.fixture.make test.this.anchor.blind)
  printf '%s\n' 'export OOSH_DIR="$(pwd -P)"' > "$fx/loose"         # a file, no repository
  out=$(this.anchor.validate all "$fx" 2>/dev/null); rc=$?
  [ "$rc" -ne 0 ] || bad="$bad no-repo-rc=$rc"
  case "$out" in *"OK:"*) bad="$bad no-repo-said-OK" ;; esac
  case "$out" in *"INVALID:"*"no tracked files visible"*) ;; *) bad="$bad no-repo=[$out]" ;; esac
  rm -rf "$fx"; fx=$(test.suite.fixture.make test.this.anchor.empty)
  git -c init.defaultBranch=main init -q "$fx"                        # a repository, nothing tracked
  out=$(this.anchor.validate OOSH_DIR "$fx" 2>/dev/null); rc=$?
  [ "$rc" -ne 0 ] || bad="$bad nothing-tracked-rc=$rc"
  case "$out" in *"INVALID:"*"no tracked files visible"*) ;; *) bad="$bad nothing-tracked=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "blind sweep refused" || create.result 1 "anchor.validate:$bad"
  return $(result)
}
test.case $level "T-ANCHOR-VALIDATE-BLIND: a tree git lists no tracked file in is a failure, not a clean result" \
  test.this.anchorValidateRefusesBlind
expect 0 "blind sweep refused" "an empty git grep looks exactly like a conforming tree"

rm -rf "$ODV_FIXTURE"
unset ODV_FIXTURE

# ============================================================================
# Test Summary
# ============================================================================

# --- T-THIS-USER-SELF-HEAL: $USER is a framework contract, like $SUDO ---------
# Login sets USER; bash does NOT. `env -i bash` — and init/oosh's clean
# re-exec — leave it empty, and install state 13
# (private.check.priviledges.checked) routes root vs user on `[ "$USER" = root ]`.
# So `this` must derive it from `id -un`, exactly as it derives $SUDO from
# `id -u`. Behavioural: clean environment, source this, read USER back.
test.this.userSelfHeal() {
  local expected got
  expected=$(id -un)
  got=$(env -i PATH="$PATH" HOME="$HOME" LOG_LEVEL=0 bash -c 'source "$HOME/oosh/this" >/dev/null 2>&1; printf "%s" "$USER"')
  if [ -n "$got" ] && [ "$got" = "$expected" ]; then
    create.result 0 "USER healed to $got"
  else
    create.result 1 "USER=[$got] after sourcing this under env -i (expected $expected) — this must heal USER from id -un, as it heals SUDO"
  fi
}
test.case $level "T-THIS-USER-SELF-HEAL: this derives \$USER when the environment lacks it" \
  test.this.userSelfHeal
expect 0 "USER healed to $(id -un)" "\$USER is a framework contract for every oosh context, like \$SUDO"

# ============================================================================
# T-RESULT-SAVE-NAMES: result.env carries RESULT*, and nothing else
# ============================================================================
# `declare -px | grep "RESULT"` matched the WHOLE LINE — the variable's name
# AND its value. So an exported variable whose name merely contained RESULT
# (test.suite exports TEST_SUITE_RESULT_PATH) or whose VALUE mentioned it was
# harvested into result.env — a file result.load then SOURCES, re-assigning
# whatever it picked up in the caller's shell. config.save fixed this same
# class for itself; this is its sibling in `this`.
test.this.resultSaveNamesOnly() {
  local fixture; fixture=$(mktemp -d "${TMPDIR:-/tmp}/test.this.result.XXXXXX") || {
    create.result 1 "mktemp -d failed"; return $(result); }
  local saved="$CONFIG_PATH"
  # Two decoys: one caught by NAME, one by VALUE.
  export DECOY_RESULT_PATH="/somewhere"
  export DECOY_MENTIONS="this text contains RESULT in its value"
  CONFIG_PATH="$fixture" result.save >/dev/null 2>&1
  local written; written=$(cat "$fixture/result.env" 2>/dev/null)
  CONFIG_PATH="$saved"
  unset DECOY_RESULT_PATH DECOY_MENTIONS
  rm -rf "$fixture" 2>/dev/null

  local strays
  strays=$(printf '%s\n' "$written" | grep -c -E '^(declare -x|export) DECOY_' 2>/dev/null)

  if [ -z "$written" ]; then
    create.result 1 "result.save wrote nothing"
  elif [ "${strays:-0}" != "0" ]; then
    create.result 1 "$strays decoy variable(s) were harvested into result.env: [$written]"
  elif ! printf '%s\n' "$written" | grep -q 'RESULT_CALLER='; then
    create.result 1 "the RESULT metadata is missing: [$written]"
  else
    create.result 0 "only the named RESULT variables are written"
  fi
  return $(result)
}
test.case - "T-RESULT-SAVE-NAMES: result.env carries the named RESULT variables, not every line matching RESULT" \
  test.this.resultSaveNamesOnly
expect 0 "only the named RESULT variables are written" \
  "result.load SOURCES this file — a substring sweep re-assigns whatever it swept"

console.log "
Test: T-THIS-SCRIPT-LOAD
===================================================================="

test.this.scriptLoad() {
  local fx bad="" savedThis="$This"; fx=$(test.suite.fixture.make scriptload)
  # The fixture script clobbers This at file scope, as this.start does when a real script is sourced.
  printf '%s\n' 'This=clobbered' 'fx.probe() { echo probed; }' > "$fx/fxScript"
  local OOSH_DIR="$fx"
  private.this.script.load fxScript fx.probe || bad="$bad rc=$?"
  [ "$(type -t fx.probe)" = function ] || bad="$bad not-loaded"
  [ "$This" = "$savedThis" ] || bad="$bad This-clobbered=[$This]"
  printf '%s\n' 'fx.probe() { echo reloaded; }' > "$fx/fxScript"
  private.this.script.load fxScript fx.probe || bad="$bad second-rc=$?"
  [ "$(fx.probe)" = probed ] || bad="$bad sourced-twice"
  private.this.script.load nosuch nosuch.probe && bad="$bad missing-script-passed"
  unset -f fx.probe; rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "script.load sources once, keeps This, rc 1 when the probe stays undefined" || create.result 1 "script.load:$bad"
  return $(result)
}
test.case $level "T-THIS-SCRIPT-LOAD: private.this.script.load sources a script once and keeps This" test.this.scriptLoad
expect 0 "script.load sources once, keeps This, rc 1 when the probe stays undefined" "the one lazy loader every ogit consumer uses"


console.log "
Test: T-THIS-PATH-CASE-GET
===================================================================="

test.this.pathCaseGet() {
  local bad="" out
  # No osascript on PATH (Linux always; macOS with PATH emptied) → the input, verbatim.
  out=$(PATH=/nonexistent private.this.path.case.get "/Some/Mixed Case/dir")
  [ "$out" = "/Some/Mixed Case/dir" ] || bad="$bad no-osascript=[$out]"
  private.this.path.case.get "" >/dev/null && bad="$bad empty-passed"
  case "$OSTYPE" in
    darwin*) out=$(private.this.path.case.get /users); [ "$out" = /Users ] || bad="$bad darwin-case=[$out]" ;;
  esac
  [ -z "$bad" ] && create.result 0 "path.case.get: input unchanged without osascript; canonical case on macOS" || create.result 1 "path.case.get:$bad"
  return $(result)
}
test.case $level "T-THIS-PATH-CASE-GET: private.this.path.case.get echoes the input without osascript" test.this.pathCaseGet
expect 0 "path.case.get: input unchanged without osascript; canonical case on macOS" "safe.directory is a string match on a case-insensitive FS"


# ============================================================================
# Shell start without boot (dev.config, Round 1.2 — red until Round 3)
# ============================================================================
# A shell that never ran .bashrc — cron, `ssh host '~/oosh/oo …'`, sudo -u —
# reaches oosh through `source this` alone. With boot gone, `this` is the one
# place that stands it up from ~/config/user.env. The fixture is a HOME with
# the user.env the model writes and an oosh symlink to this tree.
# A real user's home also trusts that tree: in a container the tree belongs to
# another user (shared through group dev) and git reads it only for a home whose
# .gitconfig names it in safe.directory — the install writes that entry. Without
# it `this anchor.validate` sees no tracked file and answers rc 2 (the gate,
# 2026-10-06), so the fixture home carries the same entry.
test.this.startFixture() { # <label> # echo a fixture HOME: oosh -> this tree, the git trust for it, config/user.env in the MacStudio layout
  local fx tree; fx=$(test.suite.fixture.make "$1") || return 1
  tree=$(private.this.path.canonical "$OOSH_DIR")
  ln -s "$tree" "$fx/oosh"
  git config --file "$fx/.gitconfig" --add safe.directory "$tree"
  mkdir -p "$fx/config" "$fx/.config/oosh"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export CONFIG_FILE="user.env"' \
    'export CONFIG="$HOME/config/user.env"' 'export PATH="$HOME/oosh:$HOME/oosh/ng:$PATH"' \
    'export BASH_FILE="/usr/bin/bash"' '. $CONFIG_PATH/oosh.env' '. $CONFIG_PATH/log.env' > "$fx/config/user.env"
  printf '%s\n' 'export OOSH_PROBE="from-oosh.env"' > "$fx/config/oosh.env"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $HOME/.config/oosh/log.session.env' > "$fx/config/log.env"
  : > "$fx/.config/oosh/log.session.env"
  echo "$fx"
}

# T-THIS-COLD-START-USER-ENV: `this` in an empty environment loads ~/config/user.env
test.this.coldStartUserEnv() {
  local fx bad="" out; fx=$(test.this.startFixture coldstart)
  out=$(env -i HOME="$fx" USER="$USER" PATH=/usr/bin:/bin bash -c \
    'source "$HOME/oosh/this" >/dev/null 2>&1; printf "%s|%s|%s" "$CONFIG" "$CONFIG_PATH" "$OOSH_PROBE"' 2>/dev/null)
  [ "$out" = "$fx/config/user.env|$fx/config|from-oosh.env" ] || bad=" got=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "this stands an empty shell up from ~/config/user.env and its chain" || create.result 1 "cold start:$bad"
  return $(result)
}
test.case $level "T-THIS-COLD-START-USER-ENV: this in an empty environment loads ~/config/user.env" test.this.coldStartUserEnv
expect 0 "this stands an empty shell up from ~/config/user.env and its chain" \
  "cron and ssh commands never run .bashrc — without boot, this is their only way in"

# T-THIS-PATH-NO-GROWTH: user.env's PATH prepend is data; sourcing it again must not grow PATH
test.this.pathNoGrowth() {
  local fx bad="" out; fx=$(test.this.startFixture pathgrowth)
  out=$(env -i HOME="$fx" USER="$USER" PATH=/usr/bin:/bin bash -c '
    source "$HOME/oosh/this" >/dev/null 2>&1; first="$PATH"
    . "$HOME/config/user.env"; source "$HOME/oosh/this" >/dev/null 2>&1
    dup=$(printf "%s\n" "$PATH" | tr ":" "\n" | sort | uniq -d | head -1)
    printf "%s|%s|%s" "$([ "$PATH" = "$first" ] && echo same || echo grew)" "$dup" "${PATH%%:*}"' 2>/dev/null)
  [ "$out" = "same||$fx/oosh" ] || bad=" got=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "sourcing user.env again leaves PATH as it was, ~/oosh first, no duplicates" || create.result 1 "PATH:$bad"
  return $(result)
}
test.case $level "T-THIS-PATH-NO-GROWTH: sourcing user.env twice does not grow PATH" test.this.pathNoGrowth
expect 0 "sourcing user.env again leaves PATH as it was, ~/oosh first, no duplicates" \
  ".bashrc and every nested source this re-read the prepend line"

# T-THIS-COLD-START-KEEPS-LOG-DEVICE: the session file's LOG_DEVICE is the LAST session's tty;
# a cold start must keep the device it derived for THIS process, or log lines land in
# another terminal (or on stdout, b5183b3). A guard for Round 3b: green before and after.
test.this.coldStartKeepsLogDevice() {
  local fx bad="" out; fx=$(test.this.startFixture logdevice)
  printf '%s\n' 'export LOG_DEVICE="/dev/pts/999"' > "$fx/.config/oosh/log.session.env"
  out=$(env -i HOME="$fx" USER="$USER" PATH=/usr/bin:/bin bash -c \
    'source "$HOME/oosh/this" >/dev/null 2>&1; printf "%s" "$LOG_DEVICE"' 2>/dev/null)
  case "$out" in
    ""|/dev/pts/999) bad=" LOG_DEVICE=[$out]" ;;
  esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a cold start keeps its own LOG_DEVICE over the last session's" || create.result 1 "cold start:$bad"
  return $(result)
}
test.case $level "T-THIS-COLD-START-KEEPS-LOG-DEVICE: the last session's tty does not win over this process's" test.this.coldStartKeepsLogDevice
expect 0 "a cold start keeps its own LOG_DEVICE over the last session's" \
  "log.session.env holds the previous session's /dev/pts/N"


console.log "
Test: T-THIS-PATH-DEDUP
===================================================================="

# T-THIS-PATH-DEDUP: the PATH de-dup is a method, judged directly
# ============================================================================
# user.env's PATH prepend is data and cannot guard itself, so this.init
# de-duplicates PATH on every `source this` (T-THIS-PATH-NO-GROWTH is the
# whole-shell view; ported from recover/boot-removal). It must mutate THIS
# shell's PATH (no subshell), keep the first occurrence and the order, and
# drop empty segments (the CWD, CWE-426) — while leaving a literal `.` alone.
test.this.pathDedup() {
  local got bad=""
  got=$(PATH="/a:/b:/a::/c:/b:"; private.this.path.dedup; printf '%s' "$PATH")
  [ "$got" = "/a:/b:/c" ] || bad="$bad repeats/empties=>[$got]"
  got=$(PATH="/x:.:/y:."; private.this.path.dedup; printf '%s' "$PATH")
  [ "$got" = "/x:.:/y" ] || bad="$bad literal-dot=>[$got]"
  got=$(PATH="/only"; private.this.path.dedup; printf '%s' "$PATH")
  [ "$got" = "/only" ] || bad="$bad single=>[$got]"
  # no temporaries left behind in the calling shell (builtins only — PATH is
  # clobbered inside this subshell, so no external command can be found)
  got=$(PATH="/a:/a"; private.this.path.dedup; printf '%s' "${_oosh_new+_oosh_new }${_oosh_seen+_oosh_seen }${_oosh_seg+_oosh_seg }${_oosh_rest+_oosh_rest }${newPath+newPath }${seen+seen }${seg+seg }${rest+rest }")
  [ -z "$got" ] || bad="$bad leaked-temporaries=[$got]"
  if [ -n "$bad" ]; then
    create.result 1 "de-dup misbehaved:$bad"
  else
    create.result 0 "first occurrence and order kept, repeats and empty segments dropped, literal . untouched"
  fi
  return $(result)
}
test.case $level "T-THIS-PATH-DEDUP: repeats and empty segments go, order and first occurrence stay" \
  test.this.pathDedup
expect 0 "first occurrence and order kept, repeats and empty segments dropped, literal . untouched" \
  "the de-dup was anonymous file-scope code with snake_case temporaries"

# T-THIS-ENV-I-DERIVES-HOME: the clean boot — `env -i` wipes HOME, `this` derives it from the OS identity
# The boss's recovery (and every `user login`): `env -i` clears the environment,
# oosh constructs it again. Nothing can be read without HOME — CONFIG_PATH
# degrades to /config, `user login` found no config and ran `config save` into
# /config (the Tart VM, 2026-09-30). The MacStudio `this` derives HOME from the
# user's identity (bash ~user expansion reads the passwd DB on Linux and macOS).
test.this.envIDerivesHome() {
  local bad="" want out
  want=$(eval echo ~"$(id -un)")
  out=$(cd "$(private.this.path.canonical "$OOSH_DIR")" && env -i PATH=/usr/bin:/bin bash -c \
    'source ./this >/dev/null 2>&1; printf "RESULT %s|%s|%s\n" "$HOME" "$CONFIG_PATH" "$(type -t log.level)"' 2>/dev/null | sed -n 's/^RESULT //p')
  [ "$out" = "$want|$want/config|function" ] || bad=" got=[$out] want=[$want|$want/config|function]"
  [ -z "$bad" ] && create.result 0 "an env -i start derives HOME and stands the shell up" || create.result 1 "env -i:$bad"
  return $(result)
}
test.case $level "T-THIS-ENV-I-DERIVES-HOME: an env -i start derives HOME from the OS identity" test.this.envIDerivesHome
expect 0 "an env -i start derives HOME and stands the shell up" \
  "env -i sh, then user login — without HOME oosh wrote into /config"


# ============================================================================
# T-THIS-AS-USER-PREAMBLE: the preamble anchors on the TARGET home, not the caller
# ============================================================================
# config.init.user and user.oosh.install both hop into `private.as.user … bash -c`
# to work as another user. runuser keeps the caller's environment, so root's
# CONFIG/CONFIG_PATH/OOSH_DIR leaked through, and the string used to source
# "$OOSH_DIR/this" — expanded by the CALLER, i.e. /root/oosh/this, which the
# target user cannot read (/root is 0700). Every source then failed silently
# and the bashrc heal of another user never ran. This drives the preamble as
# the same user against a fixture home, with the caller's anchors deliberately
# poisoned, and reads back what the inner shell actually stood up.
test.this.asUserPreamble() {
  local shared home out expected bad=""
  shared=$(private.this.path.canonical "$OOSH_DIR")
  # (a) a user WITH a user.env — the anchors must be the target's, as data.
  home=$(test.suite.fixture.make asUserPreamble)
  mkdir -p "$home/config"
  # The fixture's user.env in the MacStudio layout config save writes (pure data;
  # T-CONFIG-SAVE-USER-ENV-LAYOUT pins it), without the chain lines: no oosh.env here.
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' 'export CONFIG_FILE="user.env"' \
    'export CONFIG="$HOME/config/user.env"' 'export PATH="$HOME/oosh:$HOME/oosh/ng:$PATH"' \
    'export BASH_FILE="/usr/bin/bash"' > "$home/config/user.env"
  out=$(CONFIG=/caller/config/user.env CONFIG_PATH=/caller/config OOSH_DIR=/caller/oosh USER=caller \
        bash -c "$(private.this.as.user.preamble.get target "$home" "$shared")
echo \"[\$HOME|\$USER|\$OOSH_DIR|\$CONFIG_PATH|\$CONFIG|\${PATH%%:*}]\"" 2>&1 | tail -1)
  expected="[$home|target|$home/oosh|$home/config|$home/config/user.env|$shared]"
  [ "$out" = "$expected" ] || bad="$bad with-user.env=>$out (want $expected)"
  rm -rf "$home"
  # (b) a user WITHOUT one yet (mid-install): the constants still hang off the
  # target's HOME, and the shared tree is first on PATH so `user`/`ossh` resolve.
  home=$(test.suite.fixture.make asUserPreambleBare)
  out=$(CONFIG=/caller/config/user.env CONFIG_PATH=/caller/config OOSH_DIR=/caller/oosh USER=caller \
        bash -c "$(private.this.as.user.preamble.get target "$home" "$shared")
echo \"[\$HOME|\$USER|\$OOSH_DIR|\$CONFIG_PATH|\$CONFIG|\${PATH%%:*}]\"" 2>&1 | tail -1)
  expected="[$home|target|$home/oosh|$home/config||$shared]"
  [ "$out" = "$expected" ] || bad="$bad without-user.env=>$out (want $expected)"
  rm -rf "$home"
  if [ -n "$bad" ]; then
    create.result 1 "the inner shell did not anchor on the target:$bad"
  else
    create.result 0 "the inner shell anchors on the target home and finds the shared tree first"
  fi
  return $(result)
}
test.case $level "T-THIS-AS-USER-PREAMBLE: the preamble anchors on the target home, not the caller" \
  test.this.asUserPreamble
expect 0 "the inner shell anchors on the target home and finds the shared tree first" \
  "config.init.user used to make the target source the CALLER's \$OOSH_DIR/this — unreadable under /root"

# T-THIS-AS-USER-PREAMBLE-UMASK: a hop starts with umask 022, whatever umask its caller has
# oo heal's clean process runs with umask 002 for the shared places
# (oo.heal); runuser and a same-user hop keep the caller's umask, and a file a
# hop wrote into the target's home came out group-writable (sshd StrictModes,
# a person's dotfiles). The stand-in `this` leaves the umask alone, so only
# the preamble decides it; the target's own `this` then applies their policy.
test.this.asUserPreambleUmask() {
  local fx m
  fx=$(test.suite.fixture.make asUserPreambleUmask); mkdir -p "$fx/home" "$fx/shared"; : > "$fx/shared/this"
  ( umask 002; bash -c "$(private.this.as.user.preamble.get target "$fx/home" "$fx/shared")"$'\n''echo x > "$HOME/hop.txt"' )
  m=$(private.this.path.stat.get "$fx/home/hop.txt" mode)
  rm -rf "$fx"
  [ "${m: -3}" = 644 ] && create.result 0 "the hop writes 644 under a caller's umask 002" || create.result 1 "hop file mode=[$m]"
  return $(result)
}
test.case $level "T-THIS-AS-USER-PREAMBLE-UMASK: an as-user hop starts with umask 022, not its caller's" test.this.asUserPreambleUmask
expect 0 "the hop writes 644 under a caller's umask 002" "oo heal's umask 002 reached the files a hop wrote into a home"

# T-THIS-UMASK-CONFIG-GROUP: the group-writable umask follows the config's group, not only the process's groups
# this's umask policy asked `id -nG` alone. A root heal on the macOS VM
# (2026-10-08) created group dev in its own system step; its process — and
# root's same-user hop (private.as.user runs it directly) — never had dev in
# its credentials, so that hop's `source this` kept the preamble's umask 022
# and line.init, the loggers and config save wrote setup.color.env, color.env,
# result.txt and error.txt of the sharedConfig -rw-r--r-- root dev: every other
# user of group dev failed the configLayout invariant. The shared install's
# signal is now also the shared config itself: a config directory (a link
# followed) of group dev means umask 002. `id -nG` answers `staff` here, so
# membership is never the reason. (a) a config of another group: the umask
# stays 0022; (b) $CONFIG_PATH of group dev; (c) no CONFIG_PATH, ~/config a
# link to a group-dev directory (the hop's case): 0002.
test.this.umask.id.staff() { # # in the calling subshell and its children: id -nG answers staff — not a member of dev
  id() { case "$1" in (-nG) echo staff ;; (*) command id "$@" ;; esac; }
  export -f id
}
test.this.umaskConfigGroup() {
  local fx bad="" got
  fx=$(test.suite.fixture.make umaskconfiggroup)
  if ! private.this.group.exists dev; then
    rm -rf "$fx"; create.result 0 "NOT CHECKED: no dev group on this host"; return 0
  fi
  mkdir -p "$fx/other" "$fx/shared" "$fx/home"; ln -s "$fx/shared" "$fx/home/config"
  private.this.folder.share "$fx/shared" >/dev/null 2>&1
  [ "$(private.this.path.stat.get "$fx/shared" group)" = dev ] || bad="$bad fixture-not-dev"
  [ "$(private.this.path.stat.get "$fx/other" group)" != dev ] || bad="$bad other-is-dev"
  got=$( umask 022; test.this.umask.id.staff; HOME="$fx/home"; CONFIG_PATH="$fx/other"; source "$OOSH_DIR/this" >/dev/null 2>&1; umask )
  [ "$got" = 0022 ] || bad="$bad other=[$got]"
  got=$( umask 022; test.this.umask.id.staff; HOME="$fx/home"; CONFIG_PATH="$fx/shared"; source "$OOSH_DIR/this" >/dev/null 2>&1; umask )
  [ "$got" = 0002 ] || bad="$bad config-path=[$got]"
  got=$( umask 022; test.this.umask.id.staff; HOME="$fx/home"; unset CONFIG_PATH; source "$OOSH_DIR/this" >/dev/null 2>&1; umask )
  [ "$got" = 0002 ] || bad="$bad home-config-link=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "not in dev: a config of another group keeps 0022, a group-dev config (path or ~/config link) gives 0002" || create.result 1 "umask config group:$bad"
  return $(result)
}
test.case $level "T-THIS-UMASK-CONFIG-GROUP: source this sets umask 002 when the config directory belongs to group dev, whatever id -nG says" test.this.umaskConfigGroup
expect 0 "not in dev: a config of another group keeps 0022, a group-dev config (path or ~/config link) gives 0002" "macOS VM: root's hop wrote the sharedConfig's colour files and loggers 644 before group dev reached its credentials"


# ============================================================================
# T-PRIVATE-CALLS-DEFINED: no script calls a private.* function that does not exist
# ============================================================================
# Task 17 (carried over 2026-10-01) made user.oosh.install call
# private.this.as.user.preamble.get, which the rolled-back tree no longer had.
# The call sat behind 2>/dev/null, so the git trust entry for every other user
# was silently never written — only the platform run (oosh-user, bash-user:
# "dubious ownership") showed it. This scans every tracked bash script (docs,
# test, templates, old, restore, sessions, .claude and the legacy init/once
# aside) for private.* names, comments stripped, names built at runtime
# (followed by $ or .$) skipped. A name is defined when a function of that
# name exists, or when it is the stem of a family (os.check private.x picks
# private.x.linux / private.x.darwin at runtime).
test.this.privateCallsUndefined() { # <treeRoot> # echo "<file> <name>" for every call to an undefined private.* function
  local root="$1" files f
  files=$(ogit.repo.files.list "$root" | grep -vE '^(docs|test|old|restore|templates|sessions|\.claude)/|^init/once$' \
    | while IFS= read -r f; do [ -f "$root/$f" ] && head -1 "$root/$f" | grep -qE '^#!.*(ba)?sh' && printf '%s\n' "$f"; done)
  local defined; defined=$(printf '%s\n' "$files" | while IFS= read -r f; do
    grep -oE '^[[:space:]]*private\.[A-Za-z0-9_.]+\(\)' "$root/$f"; done | sed -E 's/^[[:space:]]*//; s/\(\)$//' | sort -u)
  printf '%s\n' "$files" | while IFS= read -r f; do
    sed -E 's/^[[:space:]]*#.*$//; s/[[:space:]]#[[:space:]].*$//' "$root/$f" \
      | grep -oE 'private\.[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)*[.]?[$]?' | grep -vE '[.$]$' | sort -u \
      | while IFS= read -r name; do
          printf '%s\n' "$defined" | grep -qxF "$name" && continue
          printf '%s\n' "$defined" | grep -qF "$name." && continue
          echo "$f $name"
        done
  done
}
test.this.privateCallsDefined() {
  [ "$(type -t ogit.repo.files.list)" = function ] || private.this.script.load ogit ogit.branch.get
  local fx bad="" out
  # planted: one undefined call, one defined, one os.check family — only the first is reported
  fx=$(test.suite.fixture.make privcalls); ogit.repo.init "$fx" >/dev/null
  printf '%s\n' '#!/usr/bin/env bash' 'private.p.defined() { :; }' 'private.p.family.linux() { :; }' \
    'a() { private.p.defined; os.check private.p.family; private.p.missing; x=private.p.built.$y; }' \
    '# private.p.inAComment' > "$fx/probe"
  ogit.index.add - "$fx" probe >/dev/null; ogit.commit.create plant t@t t "$fx" >/dev/null
  out=$(test.this.privateCallsUndefined "$fx" | tr '\n' ' ')
  [ "$out" = "probe private.p.missing " ] || bad="$bad planted=[$out]"
  rm -rf "$fx"
  out=$(test.this.privateCallsUndefined "$OOSH_DIR" | tr '\n' ' ')
  [ -z "$out" ] || bad="$bad tree=[$out]"
  [ -z "$bad" ] && create.result 0 "every private.* call has a definition" || create.result 1 "undefined private calls:$bad"
  return $(result)
}
test.case $level "T-PRIVATE-CALLS-DEFINED: no script calls a private.* function that does not exist" test.this.privateCallsDefined
expect 0 "every private.* call has a definition" \
  "user.oosh.install called a missing helper behind 2>/dev/null; every other user lost git trust"
console.log "
Test: T-THIS-FOLDER-ENTRIES-COPY
===================================================================="

test.this.folderEntriesCopy() {
  local bad="" fx; fx=$(test.suite.fixture.make entriesCopy)
  mkdir -p "$fx/from/sub" "$fx/to"; chmod 2775 "$fx/to"
  printf 'a\n' > "$fx/from/a.txt"; printf 'd\n' > "$fx/from/.dot"; printf 's\n' > "$fx/from/sub/s.txt"
  chmod 700 "$fx/from"                      # the SOURCE dir's own mode must not land on <to>
  local modeBefore; modeBefore=$(ls -ld "$fx/to" | cut -c1-10)
  private.this.folder.entries.copy "$fx/from" "$fx/to" >/dev/null || bad="$bad rc=$?"
  [ "$(cat "$fx/to/a.txt" 2>/dev/null)" = a ]     || bad="$bad file"
  [ "$(cat "$fx/to/.dot" 2>/dev/null)" = d ]      || bad="$bad dotfile"
  [ "$(cat "$fx/to/sub/s.txt" 2>/dev/null)" = s ] || bad="$bad subdir"
  [ -e "$fx/to/from" ] && bad="$bad nested"
  [ "$(ls -ld "$fx/to" | cut -c1-10)" = "$modeBefore" ] || bad="$bad to-mode=[$(ls -ld "$fx/to" | cut -c1-10)]"
  private.this.folder.entries.copy "$fx/nosuch" "$fx/to" >/dev/null 2>&1 && bad="$bad missing-from-passed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "entries copied with dotfiles; <to> keeps its mode; a missing <from> is rc 1" || create.result 1 "entries.copy:$bad"
  return $(result)
}
test.case $level "T-THIS-FOLDER-ENTRIES-COPY: private.this.folder.entries.copy copies every entry, never the folder itself" test.this.folderEntriesCopy
expect 0 "entries copied with dotfiles; <to> keeps its mode; a missing <from> is rc 1" "copying <from>/. once put a private 700 dir mode on the host dev/ folder"


console.log "
Test: T-THIS-FOLDER-SHARE
===================================================================="

test.this.folderShare() {
  local bad="" fx; fx=$(test.suite.fixture.make folderShare)
  mkdir -p "$fx/tree/sub"; printf 'f\n' > "$fx/tree/sub/file"; chmod -R go-w "$fx/tree"
  private.this.folder.share "$fx/nosuch" >/dev/null 2>&1 && bad="$bad missing-dir-passed"
  if private.this.group.exists dev; then
    private.this.folder.share "$fx/tree" >/dev/null || bad="$bad rc=$?"
    [ "$(stat -c %G "$fx/tree/sub" 2>/dev/null || stat -f %Sg "$fx/tree/sub")" = dev ] || bad="$bad group"
    case "$(ls -l "$fx/tree/sub/file" | cut -c1-10)" in -???rw????) ;; *) bad="$bad file-not-g+w" ;; esac
    [ -g "$fx/tree" ] && [ -g "$fx/tree/sub" ] || bad="$bad not-setgid"
  else
    private.this.folder.share "$fx/tree" >/dev/null || bad="$bad no-dev-group-rc=$?"
  fi
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "folder shared: group dev, g+w, setgid dirs" || create.result 1 "folder.share:$bad"
  return $(result)
}
test.case $level "T-THIS-FOLDER-SHARE: private.this.folder.share makes a folder group dev, g+w, setgid" test.this.folderShare
expect 0 "folder shared: group dev, g+w, setgid dirs" "a new folder under /home/shared must be usable by every dev-group user"

# T-THIS-AS-USER-PREAMBLE-NO-MODE: the caller's OOSH_MODE does not reach the target
# runuser keeps the caller's environment: root's OOSH_MODE would become the new
# user's branch in their user.session.env. The target's branch is where THEIR
# ~/oosh points (private.config.session.file.ensure derives it in their hop).
test.this.asUserPreambleNoMode() {
  local shared home out
  shared=$(private.this.path.canonical "$OOSH_DIR")
  home=$(test.suite.fixture.make asUserPreambleNoMode)
  out=$(OOSH_MODE=callerBranch bash -c "$(private.this.as.user.preamble.get target "$home" "$shared")
echo \"[\$OOSH_MODE]\"" 2>&1 | tail -1)
  rm -rf "$home"
  [ "$out" = "[]" ] && create.result 0 "the caller's OOSH_MODE is dropped" || create.result 1 "the target saw OOSH_MODE $out"
  return $(result)
}
test.case $level "T-THIS-AS-USER-PREAMBLE-NO-MODE: the caller's OOSH_MODE does not reach the target" \
  test.this.asUserPreambleNoMode
expect 0 "the caller's OOSH_MODE is dropped" "root's branch would become the new user's branch"

# T-THIS-START-METHOD: `this <method>` runs the method and returns — no bash, no banner, no shared save
# Starting `this` with a method used to run it, then print the start banner to
# stdout and enter an interactive bash — `./this anchor.validate` hung in a
# child shell (2026-10-02). And a started `this` ran `config save`, which
# rewrote the SHARED env files of every user from one empty environment. Now
# a method call returns its rc, and starting saves only the user's own
# ~/.config/oosh/user.session.env.
test.this.startMethod() {
  local fx bad="" out rc before pid waited=0; fx=$(test.this.startFixture startmethod)
  before=$(cat "$fx/config/user.env" "$fx/config/oosh.env" "$fx/config/log.env" | cksum)
  # No GNU timeout (macOS has none): run in the background, give it 60 s.
  env -i HOME="$fx" USER="$USER" PATH=/usr/bin:/bin "$fx/oosh/this" anchor.validate \
    </dev/null >"$fx/out" 2>/dev/null &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 60 ]; do sleep 1; waited=$((waited + 1)); done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null; pkill -P "$pid" 2>/dev/null; bad="$bad hung"
  else
    wait "$pid"; rc=$?; [ "$rc" = 0 ] || bad="$bad rc=$rc"
  fi
  out=$(cat "$fx/out" 2>/dev/null)
  case "$out" in *"this was started as"*|*"running bash with"*) bad="$bad banner-on-stdout" ;; esac
  [ "$(cat "$fx/config/user.env" "$fx/config/oosh.env" "$fx/config/log.env" | cksum)" = "$before" ] || bad="$bad shared-files-rewritten"
  [ -s "$fx/.config/oosh/user.session.env" ] || bad="$bad own-session-not-saved"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "this <method> returns its rc, prints no banner, saves only the user's own file" || create.result 1 "started this:$bad"
  return $(result)
}
test.case $level "T-THIS-START-METHOD: this <method> returns, prints no banner, never rewrites the shared env files" test.this.startMethod
expect 0 "this <method> returns its rc, prints no banner, saves only the user's own file" \
  "a started this entered a bash after the method and rewrote every user's config"

# T-THIS-START-SESSION-PATH: starting this saves the login PATH, not the session-only directories
# A started `this` puts ~/oosh/init and ~/oosh/external on PATH for its own
# process, and saved user.session.env AFTER that — so one start from an empty
# shell froze both into every later login PATH. The save comes first now, and a
# second start leaves the file byte-identical.
test.this.startSessionPath() {
  local fx bad="" first second line
  fx=$(test.this.startFixture startsessionpath)
  env -i HOME="$fx" USER="$USER" PATH=/usr/bin:/bin "$fx/oosh/this" anchor.validate </dev/null >/dev/null 2>&1
  first=$(cksum < "$fx/.config/oosh/user.session.env" 2>/dev/null)
  line=$(grep '^export PATH=' "$fx/.config/oosh/user.session.env" 2>/dev/null)
  [ -n "$line" ] || bad="$bad no-PATH-line"
  case ":${line#export PATH=\"}" in
    *":$fx/oosh/init:"*|*":$fx/oosh/init\""*) bad="$bad init-saved" ;;
  esac
  case ":${line#export PATH=\"}" in
    *":$fx/oosh/external:"*|*":$fx/oosh/external\""*) bad="$bad external-saved" ;;
  esac
  env -i HOME="$fx" USER="$USER" PATH=/usr/bin:/bin "$fx/oosh/this" anchor.validate </dev/null >/dev/null 2>&1
  second=$(cksum < "$fx/.config/oosh/user.session.env" 2>/dev/null)
  [ "$first" = "$second" ] || bad="$bad second-start-changed-file"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the saved PATH has no ~/oosh/init or ~/oosh/external; a second start changes nothing" || create.result 1 "started this:$bad [$line]"
  return $(result)
}
test.case $level "T-THIS-START-SESSION-PATH: starting this saves the login PATH without the session-only ~/oosh/init and ~/oosh/external" test.this.startSessionPath
expect 0 "the saved PATH has no ~/oosh/init or ~/oosh/external; a second start changes nothing" \
  "the save ran after this.path.add of the session-only directories"

# T-THIS-START-NO-RM: starting this never deletes ~/oosh/init, and SHELL is the bash it starts
# A start used `rm -r $OOSH_DIR/init` when init/once was missing — destructive
# for a mere start — and `export SHELL=$BASH_FILES`, a variable nothing sets.
test.this.startNoRm() {
  local bad=""
  grep -n 'rm -r \$OOSH_DIR/init' "$OOSH_DIR/this" >/dev/null && bad="$bad rm-r-init"
  grep -n 'BASH_FILES' "$OOSH_DIR/this" >/dev/null && bad="$bad BASH_FILES"
  [ -z "$bad" ] && create.result 0 "no rm -r of ~/oosh/init, SHELL is BASH_FILE" || create.result 1 "start:$bad"
  return $(result)
}
test.case $level "T-THIS-START-NO-RM: starting this never deletes ~/oosh/init" test.this.startNoRm
expect 0 "no rm -r of ~/oosh/init, SHELL is BASH_FILE" "a start must not delete anything"


# Stand-ins for the programs that read and create groups, in <fx>/bin. They
# work on <fx>/group (name:x:gid: lines) and record every call in <fx>/log;
# sudo runs only programs of the fixture — never a real groupadd.
test.this.groupStubs() { # <fx>
  local fx="$1"; mkdir -p "$fx/bin"; : > "$fx/group"; : > "$fx/log"
  printf '%s\n' '#!/bin/sh' 'awk -F: -v k="$2" '"'"'$1 == k || $3 == k { print; f = 1 } END { exit !f }'"'"' "$FX/group"' > "$fx/bin/getent"
  printf '%s\n' '#!/bin/sh' 'echo "${0##*/} $*" >> "$FX/log"' 'for a; do n="$a"; done' 'echo "$n:x:$2:" >> "$FX/group"' > "$fx/bin/groupadd"
  cp "$fx/bin/groupadd" "$fx/bin/addgroup"; cp "$fx/bin/groupadd" "$fx/bin/dseditgroup"
  printf '%s\n' '#!/bin/sh' 'echo "sudo $*" >> "$FX/log"' 'case "$1" in "$FX"/*) exec "$@" ;; esac' > "$fx/bin/sudo"
  printf '%s\n' '#!/bin/sh' '[ "$5" = 4242 ] && printf "sockgrp\t\tPrimaryGroupID = (\n    4242\n)\n"' > "$fx/bin/dscl"
  chmod +x "$fx/bin/"*
}

# T-THIS-GROUP-NAME-GET: the name of the group with a number — getent, else /etc/group, dscl on macOS
# odocker needs the group that owns the docker socket's number; it asked a
# bare getent, which macOS lacks and a minimal image may lack (2026-10-06).
test.this.groupNameGet() {
  local fx bad="" got want="" n x g; fx=$(test.suite.fixture.make thisgroupname); test.this.groupStubs "$fx"
  echo "sockgrp:x:4242:" > "$fx/group"
  got=$(export FX="$fx" PATH="$fx/bin:$PATH"; OSTYPE=linux-gnu; private.this.group.name.get 4242); [ "$got" = sockgrp ] || bad="$bad getent=[$got]"
  got=$(export FX="$fx" PATH="$fx/bin:$PATH"; OSTYPE=linux-gnu; private.this.group.name.get 4343); [ -z "$got" ] || bad="$bad getent-none=[$got]"
  # No getent: /etc/group itself, read only.
  while IFS=: read -r n x g x; do [ "$g" = 0 ] && { want="$n"; break; }; done < /etc/group
  got=$(OSTYPE=linux-gnu; command() { [ "$1 $2" = "-v getent" ] && return 1; builtin command "$@"; }; private.this.group.name.get 0)
  [ -n "$want" ] && [ "$got" = "$want" ] || bad="$bad etc-group=[$got/$want]"
  got=$(OSTYPE=linux-gnu; command() { [ "$1 $2" = "-v getent" ] && return 1; builtin command "$@"; }; private.this.group.name.get 987654); [ -z "$got" ] || bad="$bad etc-group-none=[$got]"
  got=$(export FX="$fx" PATH="$fx/bin:$PATH"; OSTYPE=darwin23; private.this.group.name.get 4242); [ "$got" = sockgrp ] || bad="$bad dscl=[$got]"
  got=$(export FX="$fx" PATH="$fx/bin:$PATH"; OSTYPE=darwin23; private.this.group.name.get 4343); [ -z "$got" ] || bad="$bad dscl-none=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the group of a number by getent, /etc/group or dscl; nothing when there is none" || create.result 1 "group name:$bad"
  return $(result)
}
test.case $level "T-THIS-GROUP-NAME-GET: the name of the group with a number — getent, else /etc/group, dscl on macOS" test.this.groupNameGet
expect 0 "the group of a number by getent, /etc/group or dscl; nothing when there is none" \
  "odocker asked a bare getent for the socket's group — macOS has none"

# T-THIS-GROUP-CREATE-GID: a group is created with a given number — groupadd, addgroup or dseditgroup, through $SUDO, once
# The socket of a container carries the HOST's group number; odocker created
# its group with $OS_CMD_GROUP_ADD, which only `user` sets — a started odocker
# ran `sudo -g <gid> docker` (2026-10-06).
test.this.groupCreateGid() {
  local fx bad="" got; fx=$(test.suite.fixture.make thisgroupcreate); test.this.groupStubs "$fx"
  test.this.groupCreateGid.run() { # <programs hidden> <groupName> <?gid>
    : > "$fx/group"; : > "$fx/log"
    FX="$fx" HIDE="$1" PATH="$fx/bin:$PATH" SUDO="sudo " bash -c '
      OSTYPE=linux-gnu
      source "$OOSH_DIR/this" >/dev/null 2>&1
      command() { if [ "$1" = -v ]; then case " $HIDE " in *" $2 "*) return 1 ;; esac; fi; builtin command "$@"; }
      private.this.group.create "$0" "$1" >/dev/null 2>&1; echo "rc=$?"
      private.this.group.create "$0" "$1" >/dev/null 2>&1; echo "rc=$?"' "$2" "$3" 2>/dev/null | tr '\n' ' '
    grep -v '^sudo ' "$fx/log" | tr '\n' '|'
  }
  got=$(test.this.groupCreateGid.run "-" sockgrp 4242)
  [ "$got" = "rc=0 rc=0 groupadd -g 4242 sockgrp|" ] || bad="$bad groupadd=[$got]"
  grep -q "^sudo $fx/bin/groupadd -g 4242 sockgrp" "$fx/log" || bad="$bad no-SUDO"
  got=$(test.this.groupCreateGid.run "groupadd" sockgrp 4242)
  [ "$got" = "rc=0 rc=0 addgroup -g 4242 sockgrp|" ] || bad="$bad addgroup=[$got]"
  got=$(test.this.groupCreateGid.run "groupadd addgroup" sockgrp 4242)
  case "$got" in "rc=0 rc=0 dseditgroup -o create -i 4242 sockgrp|"*) ;; *) bad="$bad dseditgroup=[$got]" ;; esac
  got=$(test.this.groupCreateGid.run "-" dev)
  [ "$got" = "rc=0 rc=0 groupadd dev|" ] || bad="$bad no-gid=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "groupadd -g, addgroup -g or dseditgroup -i through SUDO, once" || create.result 1 "group create:$bad"
  return $(result)
}
test.case $level "T-THIS-GROUP-CREATE-GID: a group is created with a given number, through SUDO, once" test.this.groupCreateGid
expect 0 "groupadd -g, addgroup -g or dseditgroup -i through SUDO, once" \
  "a started odocker ran sudo -g <gid> docker"

# T-THIS-CONTAINER-IS: a container is known by its marker file — /.dockerenv (Docker), /run/.containerenv (Podman)
# Nothing in oosh answered "am I a container": the first `odocker list` in a
# platform container without the host's socket installed a Docker engine that
# cannot start there (2026-10-06).
test.this.containerIs() {
  local fx bad=""; fx=$(test.suite.fixture.make thiscontainer); mkdir -p "$fx/bare" "$fx/docker" "$fx/podman/run"
  : > "$fx/docker/.dockerenv"; : > "$fx/podman/run/.containerenv"
  private.this.container.is "$fx/bare" && bad="$bad bare-is-container"
  private.this.container.is "$fx/docker" || bad="$bad dockerenv-missed"
  private.this.container.is "$fx/podman/" || bad="$bad containerenv-missed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 ".dockerenv or run/.containerenv makes a container, nothing else" || create.result 1 "container:$bad"
  return $(result)
}
test.case $level "T-THIS-CONTAINER-IS: a container is known by its marker file" test.this.containerIs
expect 0 ".dockerenv or run/.containerenv makes a container, nothing else" \
  "odocker installed a Docker engine in a container, where none can start"

# T-THIS-OGIT-LOAD-PROBE: a lazy ogit load probes the function then called, and a failed load is an answer
# private.this.anchor.validate.one probed ogit.branch.get and ignored the rc:
# with ogit not loadable the validator called a missing ogit.repo.grep, saw no
# match and said OK — a validator that silently declines to validate.
# (this.git.commits.count, the other prober, was removed 2026-10-06.)
test.this.ogitLoadProbe() {
  local fx bad="" out rc
  fx=$(test.suite.fixture.make ogitloadprobe)
  out=$( for f in $(compgen -A function ogit.); do unset -f "$f"; done
         OOSH_DIR="$fx" private.this.anchor.validate.one OOSH_DIR oosh "$OOSH_DIR" 2>/dev/null ); rc=$?
  [ "$rc" = 1 ] || bad="$bad validate-rc=$rc"
  case "$out" in OK:*) bad="$bad validate-said-OK" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "an ogit that cannot be loaded is rc 1, never an OK" || create.result 1 "ogit load:$bad"
  return $(result)
}
test.case $level "T-THIS-OGIT-LOAD-PROBE: a lazy ogit load probes the function then called; a failed load is rc 1" test.this.ogitLoadProbe
expect 0 "an ogit that cannot be loaded is rc 1, never an OK" "the loader probed ogit.branch.get and its rc was ignored"


console.log "
Test: private.this.env.export.line.get
===================================================================="

# T-THIS-ENV-EXPORT-LINE: a value becomes one pure-data export line, or is refused
# config and log each wrote env lines; log wrote the raw value, so a log name
# holding a quote ran code in every shell of the user. One rule in the kernel:
# bash quotes, and what cannot be pure data is refused.
test.this.envExportLine() {
  local fx bad="" got v; fx=$(test.suite.fixture.make thisexportline)
  got=$(private.this.env.export.line.get LOG_NAME "me@box"); [ "$got" = 'export LOG_NAME="me@box"' ] || bad="$bad plain=[$got]"
  got=$(private.this.env.export.line.get X ""); [ "$got" = 'export X=""' ] || bad="$bad empty=[$got]"
  for v in "a\"; touch $fx/pwned; \"\\ \$HOME" "a'\${HOME}' (b) \\\\c"; do
    got=$(private.this.env.export.line.get X "$v") || bad="$bad refused=[$v]"
    printf '%s\n' "$got" > "$fx/x.env"
    [ "$(sh -c ". \"$fx/x.env\"; printf '%s' \"\$X\"" 2>/dev/null)" = "$v" ] || bad="$bad sh-read-back=[$v]"
    [ "$(bash -c ". \"$fx/x.env\"; printf '%s' \"\$X\"" 2>/dev/null)" = "$v" ] || bad="$bad bash-read-back=[$v]"
  done
  [ -e "$fx/pwned" ] && bad="$bad ran-code"
  # Refused: a control character (no single line holds it), and a command
  # substitution or backtick — config.validate rejects any line holding one,
  # and the validator gets no exception (T-CONFIG-WRITER-VALIDATOR-AGREE).
  for v in "a
b" "a	tab" "a$(printf '\r')b" "a\`touch $fx/pwned\`" "a\$(touch $fx/pwned)"; do
    got=$(private.this.env.export.line.get X "$v") && bad="$bad accepted=[$v]"
    [ -z "$got" ] || bad="$bad echoed=[$got]"
  done
  for v in "" 1X "A-B" "a b"; do
    private.this.env.export.line.get "$v" x >/dev/null && bad="$bad name-accepted=[$v]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "pure-data export lines" || create.result 1 "export line:$bad"
  return $(result)
}
test.case $level "T-THIS-ENV-EXPORT-LINE: a value becomes one pure-data export line, or is refused" test.this.envExportLine
expect 0 "pure-data export lines" "log wrote the raw value — a log name holding a quote ran code"


console.log "
Test: private.this.host.name.get
===================================================================="

# T-THIS-HOST-NAME-GET: the host name comes from hostname, else HOSTNAME
# config (container name, computer name, refresh) and log (default LOG_NAME)
# asked the hostname program, which AlmaLinux 9 minimal does not ship.
test.this.hostNameGet() {
  local bad="" got
  got=$(hostname() { echo web1.fritz.box; }; private.this.host.name.get); [ "$got" = web1.fritz.box ] || bad="$bad full=[$got]"
  got=$(hostname() { echo web1.fritz.box; }; private.this.host.name.get short); [ "$got" = web1 ] || bad="$bad short=[$got]"
  got=$(command() { [ "$1 $2" = "-v hostname" ] && return 1; builtin command "$@"; }; hostname() { return 127; }
        HOSTNAME=abc123def456; private.this.host.name.get); [ "$got" = abc123def456 ] || bad="$bad no-program=[$got]"
  got=$(command() { [ "$1 $2" = "-v hostname" ] && return 1; builtin command "$@"; }; hostname() { return 127; }
        HOSTNAME=mac.fritz.box; private.this.host.name.get short); [ "$got" = mac ] || bad="$bad no-program-short=[$got]"
  got=$(hostname() { :; }; HOSTNAME=fallback; private.this.host.name.get); [ "$got" = fallback ] || bad="$bad empty-answer=[$got]"
  private.this.host.name.get long >/dev/null && bad="$bad unknown-form-rc0"
  [ -z "$bad" ] && create.result 0 "the host name with and without the hostname program" || create.result 1 "host name:$bad"
  return $(result)
}
test.case $level "T-THIS-HOST-NAME-GET: the host name comes from hostname, else HOSTNAME" test.this.hostNameGet
expect 0 "the host name with and without the hostname program" "AlmaLinux minimal has no hostname program — a container was called localhost"


console.log "
Test: private.this.file.same
===================================================================="

# T-THIS-FILE-SAME: identical bytes are same, with and without cmp
# config, user and oo decided "differs" with cmp -s; without diffutils (AlmaLinux
# minimal) rc 127 meant "differs" and files were re-copied on every run.
test.this.fileSame() {
  local fx bad="" mode; fx=$(test.suite.fixture.make thisfilesame)
  printf 'a\nb\n' > "$fx/one"; printf 'a\nb\n' > "$fx/same"; printf 'a\nb' > "$fx/noNewline"
  printf 'a\nb\n\n' > "$fx/extraNewline"; printf 'a\nc\n' > "$fx/other"
  printf '\000\001\377x' > "$fx/bin1"; printf '\000\001\377x' > "$fx/bin2"; printf '\000\002\377x' > "$fx/bin3"
  for mode in cmp nocmp; do
    (
      if [ "$mode" = nocmp ]; then
        command() { [ "$1 $2" = "-v cmp" ] && return 1; builtin command "$@"; }
        cmp() { return 127; }   # the program is not there
      fi
      r=""
      private.this.file.same "$fx/one" "$fx/same"          || r="$r same-differs"
      private.this.file.same "$fx/bin1" "$fx/bin2"         || r="$r binary-same-differs"
      private.this.file.same "$fx/one" "$fx/noNewline"     && r="$r trailing-newline-ignored"
      private.this.file.same "$fx/one" "$fx/extraNewline"  && r="$r extra-newline-ignored"
      private.this.file.same "$fx/one" "$fx/other"         && r="$r other-same"
      private.this.file.same "$fx/bin1" "$fx/bin3"         && r="$r binary-other-same"
      private.this.file.same "$fx/one" "$fx/missing"       && r="$r missing-same"
      private.this.file.same "$fx/missing" "$fx/missing"   && r="$r both-missing-same"
      echo "$r"
    ) > "$fx/r.$mode"
    [ -s "$fx/r.$mode" ] && [ -n "$(tr -d ' \n' < "$fx/r.$mode")" ] && bad="$bad $mode:[$(cat "$fx/r.$mode")]"
  done
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "same bytes with and without cmp" || create.result 1 "file same:$bad"
  return $(result)
}
test.case $level "T-THIS-FILE-SAME: identical bytes are same, with and without cmp" test.this.fileSame
expect 0 "same bytes with and without cmp" "AlmaLinux minimal has no cmp — rc 127 read as differs"


console.log "
Test: private.this.path.stat.get
===================================================================="

# T-THIS-PATH-STAT-GET: each field agrees with ls and id, GNU or BSD stat
# The GNU/BSD stat pair was hand-written six times (config, odocker, user).
# Checked against portable answers: ls -ln columns, id and chmod. Names never
# from ls -l: busybox cuts its user and group columns to 8 characters
# (bash-user shows as bash-use), so on Alpine a right answer read as wrong.
# The owner is the runner (uid-not-mine); the group is the number ls -ln
# shows, named by private.this.group.name.get — a new file takes the folder
# group on macOS and under setgid, so it need not be the runner primary group.
test.this.pathStatGet() {
  local fx bad="" f got lsn ownerName groupName; fx=$(test.suite.fixture.make thispathstat); f="$fx/file"
  : > "$f"; chmod 640 "$f"; ln -s "$f" "$fx/link"
  lsn=$(ls -ln "$f")
  set -- $lsn; [ "$(private.this.path.stat.get "$f" uid)" = "$3" ] || bad="$bad uid"
  [ "$(private.this.path.stat.get "$f" uid)" = "$(id -u)" ] || bad="$bad uid-not-mine"
  [ "$(private.this.path.stat.get "$f" gid)" = "$4" ] || bad="$bad gid"
  ownerName=$(id -un); groupName=$(private.this.group.name.get "$4")
  [ -n "$ownerName" ] && [ "$(private.this.path.stat.get "$f" owner)" = "$ownerName" ] || bad="$bad owner"
  [ -n "$groupName" ] && [ "$(private.this.path.stat.get "$f" group)" = "$groupName" ] || bad="$bad group"
  [ "$(private.this.path.stat.get "$f" mode)" = 640 ] || bad="$bad mode=[$(private.this.path.stat.get "$f" mode)]"
  [ "$(private.this.path.stat.get "$fx/link" mode)" = 640 ] && bad="$bad link-followed"
  got=$(private.this.path.stat.get "$f" size); [ $? = 1 ] && [ -z "$got" ] || bad="$bad unknown-field"
  got=$(private.this.path.stat.get "$fx/missing" owner); [ $? = 1 ] && [ -z "$got" ] || bad="$bad missing-path"
  # A stat that refuses the GNU spelling (macOS): the BSD one is used.
  got=$(stat() { [ "$1" = -c ] && return 1; [ "$1" = -f ] && echo "bsd $2"; }; private.this.path.stat.get "$f" owner)
  [ "$got" = "bsd %Su" ] || bad="$bad bsd-owner=[$got]"
  got=$(stat() { [ "$1" = -c ] && return 1; [ "$1" = -f ] && echo "bsd $2"; }; private.this.path.stat.get "$f" mode)
  [ "$got" = "bsd %Lp" ] || bad="$bad bsd-mode=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "stat fields on GNU and BSD" || create.result 1 "path stat:$bad"
  return $(result)
}
test.case $level "T-THIS-PATH-STAT-GET: each field agrees with ls and id, GNU or BSD stat" test.this.pathStatGet
expect 0 "stat fields on GNU and BSD" "the GNU/BSD stat pair was hand-written six times"


console.log "
Test: private.this.device.is.terminal
===================================================================="

# T-THIS-DEVICE-IS-TERMINAL: the predicate is defined before info.log, and info.log works with `this` alone
# The list itself is pinned by test.log T-LOG-TERMINAL / T-LOG-TERMINAL-ONE-LIST.
# Here: the kernel logs before log is loaded, so the predicate must stand
# above info.log in the file, and a file device gets the info line.
test.this.deviceIsTerminal() {
  local bad="" pLine iLine f; f=$(test.suite.fixture.make thisdeviceterm)/dev.log
  pLine=$(grep -n '^private.this.device.is.terminal()' "$OOSH_DIR/this" | cut -d: -f1)
  iLine=$(grep -n '^info.log()' "$OOSH_DIR/this" | cut -d: -f1)
  [ -n "$pLine" ] && [ -n "$iLine" ] && [ "$pLine" -lt "$iLine" ] || bad="$bad defined-after-info.log($pLine/$iLine)"
  ( LOG_DEVICE="$f" LOG_LEVEL=4; info.log "to the file" ) 2>/dev/null
  grep -q 'to the file' "$f" 2>/dev/null || bad="$bad file-device-not-written"
  [ "$( ( LOG_DEVICE=/dev/stdout LOG_LEVEL=4; info.log "never stdout" ) 2>/dev/null )" = "" ] || bad="$bad stdout-written"
  rm -rf "${f%/dev.log}"
  [ -z "$bad" ] && create.result 0 "terminal-type devices" || create.result 1 "device terminal:$bad"
  return $(result)
}
test.case $level "T-THIS-DEVICE-IS-TERMINAL: the predicate stands above info.log; a file device gets the line, stdout never" test.this.deviceIsTerminal
expect 0 "terminal-type devices" "the kernel logs before log is loaded"


console.log "
Test: private.this.temp.dir.get
===================================================================="

# T-THIS-TEMP-DIR-GET: a new private temp dir, canonical, in TMPDIR
# c2, odocker and ossh called mktemp raw; the kernel had no temp-dir method.
test.this.tempDirGet() {
  local fx bad="" d1 d2 mode; fx=$(test.suite.fixture.make thistempdir); mkdir -p "$fx/real"; ln -s "$fx/real" "$fx/link"
  d1=$(TMPDIR="$fx/link/" private.this.temp.dir.get c2.signature) || bad="$bad rc=$?"
  d2=$(TMPDIR="$fx/link/" private.this.temp.dir.get c2.signature)
  case "$d1" in "$fx/real/c2.signature."*) ;; *) bad="$bad not-canonical-in-TMPDIR=[$d1]" ;; esac
  [ -d "$d1" ] && [ -d "$d2" ] && [ "$d1" != "$d2" ] || bad="$bad not-two-new-dirs"
  mode=$(ls -ld "$d1" | cut -c1-10); [ "$mode" = drwx------ ] || bad="$bad mode=$mode"
  d2=$(TMPDIR= private.this.temp.dir.get); case "$d2" in */oosh.*) rm -rf "$d2" ;; *) bad="$bad default=[$d2]" ;; esac
  d2=$(TMPDIR="$fx/real" private.this.temp.dir.get "../x") && bad="$bad bad-label-accepted=[$d2]"
  d2=$(TMPDIR="$fx/missing" private.this.temp.dir.get) && bad="$bad missing-tmpdir-rc0"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a new private canonical temp dir" || create.result 1 "temp dir:$bad"
  return $(result)
}
test.case $level "T-THIS-TEMP-DIR-GET: a new private temp dir, canonical, in TMPDIR" test.this.tempDirGet
expect 0 "a new private canonical temp dir" "c2, odocker and ossh called mktemp raw"


console.log "
Test: private.this.tree.tracked.check
===================================================================="

test.case - "T-THIS-TREE-TRACKED-CHECK: the oosh tree lists tracked files" \
   private.this.tree.tracked.check "$OOSH_DIR" test
expect 0 "tracked files visible under $OOSH_DIR"


console.log "
Test: private.this.marker.sweep
===================================================================="

# T-THIS-MARKER-SWEEP: the one sweep of the four tree validators classifies each
# hit — a comment line, a hit marked on the line, in the 5 lines above or file-wide,
# and an unmarked hit (a marker 6 lines above and a marker inside a string are
# too far / no comment); an excluded pathspec is not swept.
test.this.markerSweep() {
  local fx bad="" out want
  fx=$(test.suite.fixture.make test.this.marker.sweep)
  git -c init.defaultBranch=main init -q "$fx"
  printf '%s\n' '#!/usr/bin/env bash' '# FOO= named in prose' 'FOO=1 # demo-exception: on the line' \
    '# demo-exception: in the window' 'a=1' 'FOO=2' > "$fx/one"
  printf '%s\n' '#!/usr/bin/env bash' 'echo "demo-exception: a string"; FOO=3' > "$fx/str"
  printf '%s\n' '#!/usr/bin/env bash' '# demo-exception: six lines above' 'a=1' 'b=2' 'c=3' 'd=4' 'e=5' 'FOO=4' > "$fx/far"
  printf '%s\n' '#!/usr/bin/env bash' '# demo-exception-file: the whole file' 'FOO=5' > "$fx/whole"
  mkdir -p "$fx/skip"; printf '%s\n' 'FOO=6' > "$fx/skip/excluded"
  git -C "$fx" add one far str whole skip/excluded
  out=$(private.this.marker.sweep '(^|[^A-Za-z])FOO=' demo "$fx" ':!skip')
  want='unmarked far:8:FOO=4
comment one:2:# FOO= named in prose
marked one:3:FOO=1 # demo-exception: on the line
marked one:6:FOO=2
unmarked str:2:echo "demo-exception: a string"; FOO=3
marked whole:3:FOO=5'
  [ "$out" = "$want" ] || bad="$bad got=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "comment, marked and unmarked hits classified" || create.result 1 "marker.sweep:$bad"
  return $(result)
}
test.case $level "T-THIS-MARKER-SWEEP: each hit is classified comment, marked or unmarked" test.this.markerSweep
expect 0 "comment, marked and unmarked hits classified" "the four tree validators share one sweep"


console.log "
Test: private.this.group.file.get
===================================================================="

# T-THIS-GROUP-FILE-GET: the group file is /etc/group, none on macOS
# The last resort of private.this.group.create appended to /etc/group on macOS
# too, where Directory Services ignores the file, and answered 0.
test.this.groupFileGet() {
  local bad="" got
  got=$(OSTYPE=linux-gnu; private.this.group.file.get); [ "$got" = /etc/group ] || bad="$bad linux=[$got]"
  got=$(OSTYPE=linux-musl; private.this.group.file.get); [ "$got" = /etc/group ] || bad="$bad alpine=[$got]"
  got=$(OSTYPE=darwin23; private.this.group.file.get) && bad="$bad darwin-rc0"
  [ -z "$got" ] || bad="$bad darwin=[$got]"
  [ -z "$bad" ] && create.result 0 "/etc/group on Linux, no group file on macOS" || create.result 1 "group file:$bad"
  return $(result)
}
test.case $level "T-THIS-GROUP-FILE-GET: the group file is /etc/group, none on macOS" test.this.groupFileGet
expect 0 "/etc/group on Linux, no group file on macOS" "macOS got a line appended to /etc/group, which Directory Services ignores"

# T-THIS-GROUP-CREATE-FAIL: the first group tool that exists is used once; the last resort never takes a held number
# (a) a groupadd that failed (a wrong sudo password, no rights) was followed by
# Debian's perl addgroup with busybox syntax — a second password prompt and a
# misparsed command. (b) the /etc/group append with a given number never
# checked it was free: a duplicate GID line. (c) is T-THIS-GROUP-FILE-GET.
# The append writes the fixture file the group-file getter names.
test.this.groupCreateFail() {
  local fx bad="" got; fx=$(test.suite.fixture.make thisgroupcreatefail); test.this.groupStubs "$fx"
  printf '%s\n' '#!/bin/sh' 'echo "${0##*/} $*" >> "$FX/log"' 'exit 1' > "$fx/bin/groupadd"; chmod +x "$fx/bin/groupadd"
  test.this.groupCreateFail.run() { # <programs hidden> <os> <groupName> <?gid> — echo "rc=<n> <calls>|"
    : > "$fx/log"
    FX="$fx" HIDE="$1" OS="$2" PATH="$fx/bin:$PATH" SUDO="sudo " LOG_DEVICE=/dev/stderr LOG_LEVEL=1 bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1
      OSTYPE="$OS"
      command() { if [ "$1" = -v ]; then case " $HIDE " in *" $2 "*) return 1 ;; esac; fi; builtin command "$@"; }
      private.this.group.file.get() { echo "$FX/group"; }
      private.this.group.create "$0" "$1" 2>"$FX/stderr" >/dev/null; echo "rc=$?"' "$3" "$4" 2>/dev/null | tr '\n' ' '
    grep -v '^sudo ' "$fx/log" | tr '\n' '|'
  }
  # (a) groupadd exists and fails: addgroup is not called, the failure is the answer.
  : > "$fx/group"
  got=$(test.this.groupCreateFail.run "-" linux-gnu sockgrp 4242)
  [ "$got" = "rc=1 groupadd -g 4242 sockgrp|" ] || bad="$bad failed-groupadd=[$got]"
  [ -s "$fx/group" ] && bad="$bad appended-after-failure=[$(cat "$fx/group")]"
  # (b) no tool: the append refuses a number another group holds, and names it.
  echo "other:x:4242:" > "$fx/group"
  got=$(test.this.groupCreateFail.run "groupadd addgroup dseditgroup" linux-gnu sockgrp 4242)
  case "$got" in "rc=1 "*) ;; *) bad="$bad held-gid-rc=[$got]" ;; esac
  [ "$(cat "$fx/group")" = "other:x:4242:" ] || bad="$bad held-gid-appended=[$(tr '\n' '|' < "$fx/group")]"
  grep -q "other" "$fx/stderr" || bad="$bad holder-not-named=[$(cat "$fx/stderr")]"
  # …and appends a free one.
  got=$(test.this.groupCreateFail.run "groupadd addgroup dseditgroup" linux-gnu sockgrp 4343)
  case "$got" in "rc=0 "*) ;; *) bad="$bad free-gid-rc=[$got]" ;; esac
  grep -qx "sockgrp:x:4343:" "$fx/group" || bad="$bad free-gid-not-appended=[$(tr '\n' '|' < "$fx/group")]"
  # (c) macOS: a failing dseditgroup is the answer — no append (no group file there).
  printf '%s\n' '#!/bin/sh' 'echo "${0##*/} $*" >> "$FX/log"' 'exit 1' > "$fx/bin/dseditgroup"; chmod +x "$fx/bin/dseditgroup"
  : > "$fx/group"
  got=$(FX="$fx" HIDE="groupadd addgroup" PATH="$fx/bin:$PATH" SUDO="sudo " bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1
      OSTYPE=darwin23
      command() { if [ "$1" = -v ]; then case " $HIDE " in *" $2 "*) return 1 ;; esac; fi; builtin command "$@"; }
      private.this.group.create sockgrp 4242 >/dev/null 2>&1; echo "rc=$?"' 2>/dev/null)
  [ "$got" = "rc=1" ] || bad="$bad darwin-rc=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the first tool once; a held number is refused by name; no append on macOS" || create.result 1 "group create fail:$bad"
  return $(result)
}
test.case $level "T-THIS-GROUP-CREATE-FAIL: the first group tool that exists is used once; the last resort never takes a held number" test.this.groupCreateFail
expect 0 "the first tool once; a held number is refused by name; no append on macOS" \
  "a failed groupadd was followed by Debian's addgroup with busybox syntax"


console.log "
Test: this.recursive.validate
===================================================================="

# The heal is built on install code that changed ownership and modes of whole
# trees — on macOS the shared folder is /Users/Shared, the whole workspace. Every
# recursive chown/chgrp/chmod is declared on its own line, like a raw git call.
# The fixture is a small git repository: the sweep reads the TRACKED files.
test.this.recursiveValidate.fixture() { # <name> <fileContent...> # a git repo with ./planted tracked; echo its path
  local fx; fx=$(test.suite.fixture.make "$1") || return 1; shift
  private.this.script.load ogit ogit.repo.init || return 1
  ogit.repo.init "$fx" >/dev/null || return 1
  printf '%s\n' "$@" > "$fx/planted"
  ogit.index.add - "$fx" planted >/dev/null || return 1   # paths given: the scope is not read
  echo "$fx"
}

# T-THIS-RECURSIVE-VALIDATE: one unmarked chmod -R is INVALID rc 1; the marked
# one, the non-recursive one and a comment are not violations.
test.this.recursiveValidate() {
  local fx bad="" out rc
  fx=$(test.this.recursiveValidate.fixture thisrecursive '#!/usr/bin/env bash' \
    '# chmod -R g+w "$dir" only talks about it' \
    'chmod -R g+w "$dir"' \
    'chmod -R g+w "$mine" # recursive-exception: fixture — the folder this script created' \
    'chmod 755 "$dir"' \
    'chmod g+w "$dir"')
  out=$(this.recursive.validate "$fx" 2>/dev/null); rc=$?
  [ "$rc" -eq 1 ] || bad="$bad rc=$rc"
  case "$out" in *"INVALID:"*"1 violation"*"2 checked"*"1 exception"*) ;; *) bad="$bad out=[$out]" ;; esac
  # a marker with no reason, or one in the lines above, does not declare the line
  rm -rf "$fx"
  fx=$(test.this.recursiveValidate.fixture thisrecursivenoreason '#!/usr/bin/env bash' \
    'chgrp -R dev "$dir" # recursive-exception:' \
    '# recursive-exception: the line above is not the line' \
    'chown --recursive me "$dir"')
  out=$(this.recursive.validate "$fx" 2>/dev/null); rc=$?
  [ "$rc" -eq 1 ] || bad="$bad noreason-rc=$rc"
  case "$out" in *"INVALID:"*"2 violation"*) ;; *) bad="$bad noreason=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "unmarked recursive chmod rejected; marked, non-recursive and comment lines pass" || create.result 1 "recursive.validate:$bad"
  return $(result)
}
test.case $level "T-THIS-RECURSIVE-VALIDATE: a fixture tree with one unmarked chmod -R is INVALID rc 1, the marked one and the non-recursive one are not violations" \
  test.this.recursiveValidate
expect 0 "unmarked recursive chmod rejected; marked, non-recursive and comment lines pass" \
  "install state 31 changed owner and mode of the whole shared folder — /Users/Shared on macOS"

# T-THIS-RECURSIVE-VALIDATE-FLAGS: combined flags and a flag after the mode are recursive too
test.this.recursiveValidateFlags() {
  local fx bad="" out rc
  fx=$(test.this.recursiveValidate.fixture thisrecursiveflags '#!/usr/bin/env bash' \
    'sudo chown -Rf me:dev "$dir"' \
    'chown -fR me "$dir"' \
    '$SUDO chgrp -HR dev "$dir"' \
    'chmod 777 -R ./tools' \
    'chmod -Rv g+w "$dir" # recursive-exception: fixture — combined flags, marked' \
    'chmod -w "$file"' \
    'chown -h me "$link"')
  out=$(this.recursive.validate "$fx" 2>/dev/null); rc=$?
  [ "$rc" -eq 1 ] || bad="$bad rc=$rc"
  case "$out" in *"INVALID:"*"4 violation"*"5 checked"*"1 exception"*) ;; *) bad="$bad out=[$out]" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "-Rf, -fR, -HR and a trailing -R are recursive; -w and -h are not" || create.result 1 "recursive.validate flags:$bad"
  return $(result)
}
test.case $level "T-THIS-RECURSIVE-VALIDATE-FLAGS: chown -Rf, -fR, -HR and a trailing -R are recursive calls" \
  test.this.recursiveValidateFlags
expect 0 "-Rf, -fR, -HR and a trailing -R are recursive; -w and -h are not" \
  "a sweep for the bare -R misses the combined forms"

# T-THIS-RECURSIVE-VALIDATE-BLIND: a sweep that reads nothing is INVALID rc 2, never OK
test.this.recursiveValidateBlind() {
  local fx bad="" out rc
  fx=$(test.suite.fixture.make thisrecursiveblind)
  private.this.script.load ogit ogit.repo.init || return 1
  ogit.repo.init "$fx" >/dev/null || return 1
  printf '%s\n' 'chmod -R g+w "$dir"' > "$fx/untracked"
  out=$(this.recursive.validate "$fx" 2>/dev/null); rc=$?
  [ "$rc" -eq 2 ] || bad="$bad rc=$rc"
  case "$out" in *"OK:"*) bad="$bad said-OK" ;; esac
  case "$out" in *"INVALID:"*"no tracked files visible"*) ;; *) bad="$bad out=[$out]" ;; esac
  rm -rf "$fx"
  out=$(this.recursive.validate "$fx" 2>/dev/null); rc=$?
  [ "$rc" -eq 2 ] || bad="$bad missing-dir-rc=$rc"
  [ -z "$bad" ] && create.result 0 "an empty sweep and a missing tree are INVALID rc 2" || create.result 1 "recursive.validate blind:$bad"
  return $(result)
}
test.case $level "T-THIS-RECURSIVE-VALIDATE-BLIND: a tree with nothing tracked is INVALID rc 2, not a clean result" \
  test.this.recursiveValidateBlind
expect 0 "an empty sweep and a missing tree are INVALID rc 2" \
  "an empty git grep looks exactly like a tree without recursive calls"


console.log "
Test: private.this.orig.stamp.get, private.this.symlink.with.backup, private.this.dir.ensure
===================================================================="

# T-THIS-ORIG-STAMP-FREE-GET: the ONE bump loop — <base> as it is when free, taken →
# bumped with -<n>, and one stamp is free for every name at once (user.config.link
# moves config and oosh aside under the same stamp); a dangling link is taken too.
test.this.origStampFreeGet() {
  local fx bad="" got
  fx=$(test.suite.fixture.make thisorigstampfree)
  got=$(private.this.orig.stamp.free.get "$fx" 20260101-000000 a b); [ "$got" = 20260101-000000 ] || bad="$bad free=[$got]"
  : > "$fx/a.orig.20260101-000000"
  got=$(private.this.orig.stamp.free.get "$fx" 20260101-000000 a b); [ "$got" = 20260101-000000-1 ] || bad="$bad taken=[$got]"
  mkdir "$fx/b.orig.20260101-000000-1"
  got=$(private.this.orig.stamp.free.get "$fx" 20260101-000000 a b); [ "$got" = 20260101-000000-2 ] || bad="$bad shared=[$got]"
  ln -s "$fx/nowhere" "$fx/a.orig.20260101-000000-2"
  got=$(private.this.orig.stamp.free.get "$fx" 20260101-000000 a b); [ "$got" = 20260101-000000-3 ] || bad="$bad dangling-link=[$got]"
  got=$(private.this.orig.stamp.free.get "$fx" 20260101-000000) && bad="$bad no-names-rc0"
  [ -z "$got" ] || bad="$bad no-names=[$got]"
  got=$(private.this.orig.stamp.free.get "$fx" "" a) && bad="$bad no-base-rc0"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "free as it is, taken bumped, one stamp for every name" || create.result 1 "orig.stamp.free.get:$bad"
  return $(result)
}
test.case $level "T-THIS-ORIG-STAMP-FREE-GET: base as it is when free, bumped with -<n> when taken, one stamp free for every name" \
  test.this.origStampFreeGet
expect 0 "free as it is, taken bumped, one stamp for every name" \
  "a second run inside the same second reused the stamp of the first"

# T-THIS-ORIG-STAMP-GET: the clock stamp, made free by private.this.orig.stamp.free.get
# (whose test proves the bump); rc 1 and nothing without a name.
test.this.origStampGet() {
  local fx bad="" got
  fx=$(test.suite.fixture.make thisorigstamp)
  got=$(private.this.orig.stamp.get "$fx" a b)
  case "$got" in [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]*) ;; *) bad="$bad clock=[$got]" ;; esac
  : > "$fx/a.orig.$got"
  [ "$(private.this.orig.stamp.get "$fx" a b)" != "$got" ] || bad="$bad taken-reused"
  got=$(private.this.orig.stamp.get "$fx") && bad="$bad no-names-rc0"
  [ -z "$got" ] || bad="$bad no-names=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a clock stamp, free for every name" || create.result 1 "orig.stamp.get:$bad"
  return $(result)
}
test.case $level "T-THIS-ORIG-STAMP-GET: a clock stamp that is free for every name; rc 1 without names" test.this.origStampGet
expect 0 "a clock stamp, free for every name" \
  "a second run inside the same second reused the stamp of the first"

# T-THIS-SYMLINK-BACKUP-NEVER-NESTS: a real entry is never moved INTO an existing
# <link>.orig.<ts> — the D7 root cause. A second real dir with the same explicit
# ts lands in <link>.orig.<ts>-1; without a ts the stamp comes from
# private.this.orig.stamp.get.
test.this.symlinkBackupNeverNests() {
  local fx bad="" link n
  fx=$(test.suite.fixture.make thissymlinknest); link="$fx/home/config"
  mkdir -p "$fx/target" "$link"; : > "$link/first"
  private.this.symlink.with.backup "$link" "$fx/target" 20260101-000000 >/dev/null 2>&1 || bad="$bad first-rc"
  rm "$link"; mkdir "$link"; : > "$link/second"
  private.this.symlink.with.backup "$link" "$fx/target" 20260101-000000 >/dev/null 2>&1 || bad="$bad second-rc"
  [ -f "$link.orig.20260101-000000/first" ] || bad="$bad first-lost"
  [ -e "$link.orig.20260101-000000/config" ] && bad="$bad nested"
  [ -f "$link.orig.20260101-000000-1/second" ] || bad="$bad second-not-bumped"
  [ "$(readlink "$link")" = "$fx/target" ] || bad="$bad not-linked"
  rm "$link"; mkdir "$link"; : > "$link/third"
  private.this.symlink.with.backup "$link" "$fx/target" >/dev/null 2>&1 || bad="$bad no-ts-rc"
  n=$(ls -d "$link".orig.* | wc -l | tr -d ' '); [ "$n" = 3 ] || bad="$bad no-ts-count=$n"
  [ -L "$link" ] || bad="$bad no-ts-not-linked"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a second backup with the same ts is bumped, nothing nested" || create.result 1 "symlink.with.backup:$bad"
  return $(result)
}
test.case $level "T-THIS-SYMLINK-BACKUP-NEVER-NESTS: a second real dir with the same ts becomes .orig.<ts>-1, nothing nested" \
  test.this.symlinkBackupNeverNests
expect 0 "a second backup with the same ts is bumped, nothing nested" \
  "D7: the second real ~/config was moved INTO config.orig.<ts>"

# T-THIS-SYMLINK-BACKUP-RELINK-LOGGED: a symlink that points ELSEWHERE is replaced
# with an info.log trace naming its old target (the user package reads it); a
# correct symlink is left alone without a trace.
test.this.symlinkBackupRelinkLogged() {
  local fx bad="" link out
  fx=$(test.suite.fixture.make thissymlinkrelink); link="$fx/config"
  mkdir -p "$fx/old" "$fx/new"; ln -s "$fx/old" "$link"
  # The stub keeps only the relink trace: create.result logs through info.log too.
  out=$(info.log() { case "$1" in (relinked*) echo "$*" ;; esac; }; private.this.symlink.with.backup "$link" "$fx/new" 20260101-000000 2>/dev/null)
  [ "$out" = "relinked $link (was → $fx/old)" ] || bad="$bad trace=[$out]"
  [ "$(readlink "$link")" = "$fx/new" ] || bad="$bad not-relinked"
  out=$(info.log() { case "$1" in (relinked*) echo "$*" ;; esac; }; private.this.symlink.with.backup "$link" "$fx/new" 20260101-000000 2>/dev/null)
  [ -z "$out" ] || bad="$bad correct-traced=[$out]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a relink names the old target; a correct link is silent" || create.result 1 "symlink.with.backup relink:$bad"
  return $(result)
}
test.case $level "T-THIS-SYMLINK-BACKUP-RELINK-LOGGED: replacing a symlink that points elsewhere logs its old target" \
  test.this.symlinkBackupRelinkLogged
expect 0 "a relink names the old target; a correct link is silent" \
  "a stale ~/config symlink was replaced without a trace of where it pointed"

# T-THIS-SYMLINK-BACKUP-RESULT: every success path sets RESULT — a bare return 0
# left the RESULT of whatever ran before.
test.this.symlinkBackupResult() {
  local fx bad="" link
  fx=$(test.suite.fixture.make thissymlinkresult); link="$fx/config"
  mkdir -p "$fx/target"
  RESULT=stale; private.this.symlink.with.backup "$link" "$fx/target" >/dev/null 2>&1 || bad="$bad absent-rc"
  [ "$RESULT" = "linked $link → $fx/target" ] || bad="$bad absent=[$RESULT]"
  RESULT=stale; private.this.symlink.with.backup "$link" "$fx/target" >/dev/null 2>&1 || bad="$bad correct-rc"
  [ "$RESULT" = unchanged ] || bad="$bad correct=[$RESULT]"
  rm "$link"; mkdir "$link"
  RESULT=stale; private.this.symlink.with.backup "$link" "$fx/target" 20260101-000000 >/dev/null 2>&1 || bad="$bad real-rc"
  [ "$RESULT" = "linked $link → $fx/target" ] || bad="$bad real=[$RESULT]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "linked or unchanged, never a stale RESULT" || create.result 1 "symlink.with.backup result:$bad"
  return $(result)
}
test.case $level "T-THIS-SYMLINK-BACKUP-RESULT: a new link says linked, a correct one says unchanged" \
  test.this.symlinkBackupResult
expect 0 "linked or unchanged, never a stale RESULT" \
  "the success paths returned 0 with the RESULT of whatever ran before"

# T-THIS-DIR-ENSURE: only the missing segments are created, and only they get the
# owner, group and mode; the existing ancestor keeps its own. A second call creates
# and changes nothing; a file in the way is rc 1.
test.this.dirEnsure() {
  local fx bad="" group seg m got me
  me=$(id -un)
  fx=$(test.suite.fixture.make thisdirensure)
  mkdir "$fx/base"; chmod 750 "$fx/base"
  group=$(private.this.path.stat.get "$fx/base" group)
  private.this.dir.ensure "$fx/base/a/b/c" "$group" 2775 >/dev/null 2>&1 || bad="$bad rc=$?"
  [ "$RESULT" = "$fx/base/a $fx/base/a/b $fx/base/a/b/c" ] || bad="$bad result=[$RESULT]"
  for seg in a a/b a/b/c; do
    m=$(private.this.path.stat.get "$fx/base/$seg" mode)
    case "$m" in *775) ;; *) bad="$bad mode-$seg=$m" ;; esac
    [ "$(private.this.path.stat.get "$fx/base/$seg" group)" = "$group" ] || bad="$bad group-$seg"
  done
  [ "$(private.this.path.stat.get "$fx/base" mode)" = 750 ] || bad="$bad base-mode-changed"
  [ "$(private.this.path.stat.get "$fx/base" group)" = "$group" ] || bad="$bad base-group-changed"
  touch -t 202001010000 "$fx/base" "$fx/base/a" "$fx/base/a/b" "$fx/base/a/b/c"
  touch -t 202001010001 "$fx/ref"
  private.this.dir.ensure "$fx/base/a/b/c" "$group" 2775 >/dev/null 2>&1 || bad="$bad again-rc"
  [ "$RESULT" = exists ] || bad="$bad again=[$RESULT]"
  [ -z "$(find "$fx/base" -newer "$fx/ref")" ] || bad="$bad again-changed"
  # <owner> = the caller's own name, with USER unset (docker exec, su, cron): chown
  # without $SUDO, on the created segments only — a recording chown and a
  # recording sudo prove the calls, the stat proves the owner.
  mkdir "$fx/own"
  test.this.dirEnsure.rec() { echo "sudo $*" >> "$fx/sudo.log"; }
  got=$(chown() { echo "chown $*" >> "$fx/chown.log"; command chown "$@"; }
        USER= SUDO="test.this.dirEnsure.rec " private.this.dir.ensure "$fx/own/home/x" "" 700 "$me" >/dev/null 2>&1 && echo "$RESULT")
  [ "$got" = "$fx/own/home $fx/own/home/x" ] || bad="$bad owner-result=[$got]"
  [ "$(tr '\n' '|' < "$fx/chown.log" 2>/dev/null)" = "chown $me $fx/own/home|chown $me $fx/own/home/x|" ] \
    || bad="$bad chown-calls=[$(tr '\n' '|' < "$fx/chown.log" 2>/dev/null)]"
  [ -e "$fx/sudo.log" ] && bad="$bad own-name-took-sudo=[$(tr '\n' '|' < "$fx/sudo.log")]"
  for seg in home home/x; do
    [ "$(private.this.path.stat.get "$fx/own/$seg" owner)" = "$me" ] || bad="$bad owner-$seg"
    [ "$(private.this.path.stat.get "$fx/own/$seg" mode)" = 700 ] || bad="$bad owner-mode-$seg"
  done
  # another user as <owner>: the chown, chgrp and chmod of the segment go through
  # $SUDO (a recording stub — no prompt); the mkdir does not, the parent is writable.
  rm -f "$fx/sudo.log"
  got=$(SUDO="test.this.dirEnsure.rec " private.this.dir.ensure "$fx/other" "$group" 750 oosh-t-other >/dev/null 2>&1 && echo "$RESULT")
  [ "$got" = "$fx/other" ] || bad="$bad other-result=[$got]"
  [ "$(tr '\n' '|' < "$fx/sudo.log" 2>/dev/null)" = "sudo chown oosh-t-other $fx/other|sudo chgrp $group $fx/other|sudo chmod 750 $fx/other|" ] \
    || bad="$bad other-sudo=[$(tr '\n' '|' < "$fx/sudo.log" 2>/dev/null)]"
  # a <group> the caller is not in (yet — private.user.group.member.pending): only
  # the chgrp goes through $SUDO; the mkdir and the chmod do not.
  rm -f "$fx/sudo.log"
  got=$(SUDO="test.this.dirEnsure.rec " private.this.dir.ensure "$fx/notmine" oosh-t-notmine 2775 >/dev/null 2>&1; echo "$RESULT")
  [ "$(tr '\n' '|' < "$fx/sudo.log" 2>/dev/null)" = "sudo chgrp oosh-t-notmine $fx/notmine|" ] \
    || bad="$bad notmine-sudo=[$(tr '\n' '|' < "$fx/sudo.log" 2>/dev/null)] result=[$got]"
  # a group the caller is in: no $SUDO
  rm -f "$fx/sudo.log"
  SUDO="test.this.dirEnsure.rec " private.this.dir.ensure "$fx/mine" "$group" >/dev/null 2>&1 || bad="$bad mine-rc"
  [ -e "$fx/sudo.log" ] && bad="$bad mine-took-sudo=[$(tr '\n' '|' < "$fx/sudo.log")]"
  unset -f test.this.dirEnsure.rec
  # an owner that does not exist: rc 1, RESULT names the segment left behind
  got=$(SUDO= private.this.dir.ensure "$fx/nouser/x" "" "" oosh-no-such-user-x >/dev/null 2>&1; echo "rc=$? $RESULT")
  case "$got" in "rc=1 "*"$fx/nouser"*) ;; *) bad="$bad no-such-owner=[$got]" ;; esac
  # a relative <dir>, repeated and trailing slashes
  got=$(cd "$fx" && private.this.dir.ensure rel//a/ >/dev/null 2>&1 && echo "$RESULT")
  [ "$got" = "rel rel/a" ] || bad="$bad relative=[$got]"
  [ -d "$fx/rel/a" ] || bad="$bad relative-missing"
  got=$(private.this.dir.ensure "$fx//slashes///x/" >/dev/null 2>&1 && echo "$RESULT")
  [ "$got" = "$fx/slashes $fx/slashes/x" ] || bad="$bad slashes=[$got]"
  # . and .. segments are refused up front, nothing created
  private.this.dir.ensure "$fx/dots/../escape" >/dev/null 2>&1 && bad="$bad dotdot-rc0"
  private.this.dir.ensure "$fx/dot/./x" >/dev/null 2>&1 && bad="$bad dot-rc0"
  [ -e "$fx/dots" ] || [ -e "$fx/dot" ] || [ -e "$fx/escape" ] && bad="$bad dots-created"
  # an unwritable parent without SUDO names the reason (root writes anyway)
  if [ "$me" != root ]; then
    mkdir "$fx/locked"; chmod 555 "$fx/locked"
    got=$(SUDO= private.this.dir.ensure "$fx/locked/x" >/dev/null 2>&1; echo "rc=$? $RESULT")
    case "$got" in "rc=1 "*"(parent not writable, no SUDO)"*) ;; *) bad="$bad locked=[$got]" ;; esac
    chmod 755 "$fx/locked"
  fi
  : > "$fx/file"
  private.this.dir.ensure "$fx/file/x" >/dev/null 2>&1 && bad="$bad file-ancestor-rc0"
  private.this.dir.ensure "$fx/file" >/dev/null 2>&1 && bad="$bad file-itself-rc0"
  private.this.dir.ensure >/dev/null 2>&1 && bad="$bad no-dir-rc0"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "only the missing segments, with owner, group and mode; exists; a file in the way is rc 1" || create.result 1 "dir.ensure:$bad"
  return $(result)
}
test.case $level "T-THIS-DIR-ENSURE: three missing levels are created with the mode, the existing ancestor keeps its mode and group; a second call says exists; an owner is given to the created segments only; a file in the way is rc 1" \
  test.this.dirEnsure
expect 0 "only the missing segments, with owner, group and mode; exists; a file in the way is rc 1" \
  "state 31 changed owner and mode of the whole shared folder to create one directory in it"


console.log "
Test: private.this.entry.aside
===================================================================="

# T-THIS-ENTRY-ASIDE: the one move-aside of symlink.with.backup, oo deinstall and the
# heal. A real directory and a real file go to <path>.orig.<ts> whole; a taken ts is
# bumped, never nested; no ts is stamped by the clock; a symlink is removed (its
# target untouched); a missing path is nothing. Nothing is ever deleted.
test.this.entryAside() {
  local fx bad="" rc n
  fx=$(test.suite.fixture.make thisentryaside)
  mkdir "$fx/dir"; : > "$fx/dir/inside"; printf 'f\n' > "$fx/file"
  mkdir "$fx/target"; : > "$fx/target/kept"; ln -s "$fx/target" "$fx/link"
  private.this.entry.aside "$fx/dir" 20260101-000000 >/dev/null 2>&1 || bad="$bad dir-rc"
  [ "$RESULT" = "$fx/dir.orig.20260101-000000" ] || bad="$bad dir=[$RESULT]"
  [ -f "$fx/dir.orig.20260101-000000/inside" ] && [ ! -e "$fx/dir" ] || bad="$bad dir-not-moved"
  mkdir "$fx/dir"; : > "$fx/dir/second"
  private.this.entry.aside "$fx/dir" 20260101-000000 >/dev/null 2>&1 || bad="$bad taken-rc"
  [ "$RESULT" = "$fx/dir.orig.20260101-000000-1" ] || bad="$bad taken=[$RESULT]"
  [ -e "$fx/dir.orig.20260101-000000/dir" ] && bad="$bad nested"
  [ -f "$fx/dir.orig.20260101-000000-1/second" ] || bad="$bad taken-not-moved"
  private.this.entry.aside "$fx/file" >/dev/null 2>&1 || bad="$bad file-rc"
  case "$RESULT" in "$fx/file.orig."[0-9]*) ;; *) bad="$bad file=[$RESULT]" ;; esac
  [ "$(cat "$RESULT" 2>/dev/null)" = f ] && [ ! -e "$fx/file" ] || bad="$bad file-not-moved"
  private.this.entry.aside "$fx/link" 20260101-000000 >/dev/null 2>&1 || bad="$bad link-rc"
  [ "$RESULT" = "removed link" ] || bad="$bad link=[$RESULT]"
  [ ! -L "$fx/link" ] && [ -f "$fx/target/kept" ] || bad="$bad link-or-target"
  private.this.entry.aside "$fx/missing" >/dev/null 2>&1 || bad="$bad missing-rc"
  [ "$RESULT" = nothing ] || bad="$bad missing=[$RESULT]"
  private.this.entry.aside >/dev/null 2>&1; rc=$?
  [ "$rc" = 1 ] || bad="$bad no-path-rc=$rc"
  n=$(ls -d "$fx"/*.orig.* | wc -l | tr -d ' '); [ "$n" = 3 ] || bad="$bad orig-count=$n"
  # <asideDir> given: the entry lands THERE as <name>.orig.<ts>, the stamp is probed
  # and bumped there; a missing <asideDir> is rc 1 and nothing moves.
  mkdir -p "$fx/base/dev" "$fx/base.aside"; : > "$fx/base/dev/broken"
  private.this.entry.aside "$fx/base/dev" 20260101-000000 "$fx/base.aside" >/dev/null 2>&1 || bad="$bad aside-rc"
  [ "$RESULT" = "$fx/base.aside/dev.orig.20260101-000000" ] || bad="$bad aside=[$RESULT]"
  [ -f "$fx/base.aside/dev.orig.20260101-000000/broken" ] && [ ! -e "$fx/base/dev" ] || bad="$bad aside-not-moved"
  mkdir "$fx/base/dev"; : > "$fx/base/dev/again"
  private.this.entry.aside "$fx/base/dev" 20260101-000000 "$fx/base.aside" >/dev/null 2>&1 || bad="$bad aside-taken-rc"
  [ "$RESULT" = "$fx/base.aside/dev.orig.20260101-000000-1" ] || bad="$bad aside-taken=[$RESULT]"
  [ -e "$fx/base.aside/dev.orig.20260101-000000/dev" ] && bad="$bad aside-nested"
  mkdir "$fx/base/dev"
  private.this.entry.aside "$fx/base/dev" 20260101-000000 "$fx/nowhere" >/dev/null 2>&1; rc=$?
  [ "$rc" = 1 ] || bad="$bad aside-missing-dir-rc=$rc"
  [ -d "$fx/base/dev" ] && [ ! -e "$fx/nowhere" ] || bad="$bad aside-missing-dir-moved"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "dir and file moved to .orig.<ts>, taken bumped, link removed, missing is nothing" || create.result 1 "entry.aside:$bad"
  return $(result)
}
test.case $level "T-THIS-ENTRY-ASIDE: a real dir and a real file are moved to .orig.<ts>, a symlink is removed, a missing path is nothing, a taken stamp is bumped; with an aside directory the entry lands there" \
  test.this.entryAside
expect 0 "dir and file moved to .orig.<ts>, taken bumped, link removed, missing is nothing" \
  "the move-aside lived three times: symlink.with.backup, oo deinstall and the heal"


console.log "
Test: private.this.share.pending.list
===================================================================="

# T-THIS-SHARE-PENDING-LIST: the entries a share still has to change — nothing
# once shared; a file not group-writable and a directory without setgid are
# named; a symlink never is. The one list repo.share (ogit) and
# private.this.folder.share judge by.
test.this.sharePendingList() {
  local fx bad="" got; fx=$(test.suite.fixture.make sharepending)
  mkdir -p "$fx/tree/sub"; printf 'f\n' > "$fx/tree/file"
  private.this.folder.share "$fx/tree" >/dev/null 2>&1
  got=$(private.this.share.pending.list "$fx/tree")
  [ -z "$got" ] || bad="$bad shared=[$got]"
  chmod g-s "$fx/tree/sub"; ln -s file "$fx/tree/link.probe"
  private.this.group.exists dev && chmod g-w "$fx/tree/file"
  got=$(private.this.share.pending.list "$fx/tree" | sort | tr '\n' ' ')
  if private.this.group.exists dev; then
    [ "$got" = "$fx/tree/file $fx/tree/sub " ] || bad="$bad pending=[$got]"
  else
    [ "$got" = "$fx/tree/sub " ] || bad="$bad pending-nodev=[$got]"
  fi
  [ -z "$(private.this.share.pending.list "$fx/nosuch")" ] || bad="$bad nosuch-not-empty"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "nothing once shared; the unshared file and directory named, the link not" || create.result 1 "share pending:$bad"
  return $(result)
}
test.case $level "T-THIS-SHARE-PENDING-LIST: the entries of a folder that are not shared yet" test.this.sharePendingList
expect 0 "nothing once shared; the unshared file and directory named, the link not" "repo.share and folder.share touch only these"

# T-THIS-FOLDER-SHARE-NOT-OURS: root's heal fast-forwarded test's clone and
# wrote root-owned work-tree files into it — group dev, g+w, setgid dirs:
# right. test's pipe heal then ran ogit.folder.finish → folder.share, whose
# chgrp -R / chmod -R / setgid find failed (EPERM on another owner's file,
# changed or not): "could not share the working tree" (gate on 791efad1,
# 2026-10-08). Only what is pending is touched; an entry another user owns
# that is right is no error; one that is wrong and not ours is named. Another
# owner cannot be made here: a chmod and chgrp on PATH that fail as EPERM does
# stand for it.
test.this.folderShareNotOurs() {
  local fx bad="" got; fx=$(test.suite.fixture.make foldersharenotours)
  if ! private.this.group.exists dev; then
    rm -rf "$fx"; create.result 0 "NOT CHECKED: no dev group on this host"; return 0
  fi
  mkdir -p "$fx/tree/sub" "$fx/bin"; printf 'f\n' > "$fx/tree/sub/file"
  private.this.folder.share "$fx/tree" >/dev/null 2>&1 || bad="$bad first-rc=$?"
  printf '%s\n' '#!/bin/sh' 'echo "$0: Operation not permitted" >&2; exit 1' > "$fx/bin/chmod"
  cp "$fx/bin/chmod" "$fx/bin/chgrp"; command chmod +x "$fx/bin/chmod" "$fx/bin/chgrp"
  got=$( PATH="$fx/bin:$PATH"; LOG_DEVICE="$fx/log.out"; private.this.folder.share "$fx/tree" >/dev/null 2>&1; echo "$?|$RESULT" )
  [ "$got" = "0|$fx/tree shared with group dev (g+w, setgid)" ] || bad="$bad right-not-ours=[$got]"
  command chmod g-w "$fx/tree/sub/file"
  got=$( PATH="$fx/bin:$PATH"; LOG_DEVICE="$fx/log.out"; private.this.folder.share "$fx/tree" >/dev/null 2>&1; echo "$?|$RESULT" )
  case "$got" in "1|"*"$fx/tree/sub/file"*) ;; *) bad="$bad wrong-not-ours=[$got]" ;; esac
  got=$( LOG_DEVICE="$fx/log.out"; private.this.folder.share "$fx/tree" >/dev/null 2>&1; echo "$?|$RESULT" )
  [ "$got" = "0|$fx/tree shared with group dev (g+w, setgid)" ] || bad="$bad wrong-ours=[$got]"
  [ -n "$(find "$fx/tree/sub/file" -perm -020)" ] || bad="$bad not-fixed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "right and not ours: rc 0; wrong and not ours: rc 1 naming it; wrong and ours: fixed" || create.result 1 "folder share not ours:$bad"
  return $(result)
}
test.case $level "T-THIS-FOLDER-SHARE-NOT-OURS: folder.share touches only what is not shared yet; another owner's entry that is right is no error" test.this.folderShareNotOurs
expect 0 "right and not ours: rc 0; wrong and not ours: rc 1 naming it; wrong and ours: fixed" "test's pipe heal: could not share the working tree of its own clone after root's fast-forward"

# T-THIS-FOLDER-SHARE-PENDING-ONLY: the share touches the pending entries and nothing else
# "Only what is not shared yet is touched" was not true: once ONE entry was
# pending, chgrp -R / chmod -R / a setgid find ran over the whole tree, their
# failures silenced (private.ensure.sharedTree). The share now hands chgrp and
# chmod the entries private.this.share.pending.list names, never -R. A chmod
# and chgrp on PATH log every call and fail as EPERM on any path but the
# pending one — the others stand for right entries another user owns.
test.this.folderSharePendingOnly() {
  local fx bad="" got real; fx=$(test.suite.fixture.make foldersharepending)
  if ! private.this.group.exists dev; then
    rm -rf "$fx"; create.result 0 "NOT CHECKED: no dev group on this host"; return 0
  fi
  mkdir -p "$fx/tree/sub/deep" "$fx/bin"; printf 'f\n' > "$fx/tree/sub/file"; printf 'p\n' > "$fx/tree/sub/deep/pending"
  private.this.folder.share "$fx/tree" >/dev/null 2>&1 || bad="$bad first-rc=$?"
  command chmod g-w "$fx/tree/sub/deep/pending"
  for real in chmod chgrp; do
    printf '%s\n' '#!/bin/sh' "echo \"$real \$*\" >> '$fx/calls'" \
      "for a in \"\$@\"; do case \"\$a\" in /*) [ \"\$a\" = '$fx/tree/sub/deep/pending' ] || { echo \"$real: \$a: Operation not permitted\" >&2; exit 1; } ;; esac; done" \
      "exec '$(command -v $real)' \"\$@\"" > "$fx/bin/$real"
    command chmod +x "$fx/bin/$real"
  done
  got=$( PATH="$fx/bin:$PATH"; LOG_DEVICE="$fx/log.out"; private.this.folder.share "$fx/tree" >/dev/null 2>&1; echo "$?|$RESULT" )
  [ "$got" = "0|$fx/tree shared with group dev (g+w, setgid)" ] || bad="$bad share=[$got]"
  [ -s "$fx/calls" ] || bad="$bad no-call"
  grep -v " $fx/tree/sub/deep/pending\$" "$fx/calls" >/dev/null && bad="$bad touched-more=[$(grep -v " $fx/tree/sub/deep/pending\$" "$fx/calls" | tr '\n' '|')]"
  [ -n "$(find "$fx/tree/sub/deep/pending" -perm -020)" ] || bad="$bad not-fixed"
  # setgid no: a directory without setgid is not pending
  command chmod g-s "$fx/tree/sub"
  [ -z "$(private.this.share.pending.list "$fx/tree" no)" ] || bad="$bad setgid-no=[$(private.this.share.pending.list "$fx/tree" no)]"
  [ "$(private.this.share.pending.list "$fx/tree")" = "$fx/tree/sub" ] || bad="$bad setgid-yes=[$(private.this.share.pending.list "$fx/tree")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "only the pending entry handed to chgrp and chmod; the share is green" || create.result 1 "pending only:$bad"
  return $(result)
}
test.case $level "T-THIS-FOLDER-SHARE-PENDING-ONLY: folder.share hands chgrp and chmod only the pending entries — never the whole tree" test.this.folderSharePendingOnly
expect 0 "only the pending entry handed to chgrp and chmod; the share is green" "one pending entry ran chgrp -R and chmod -R over the whole tree, failures silenced"

# T-THIS-FOLDER-SHARE-NO-DEV-GROUP: without a dev group the directories still get setgid
# folder.share returned 0 before touching anything on a host without a dev
# group, while share.pending.list still named the directories without setgid
# and test.platform.shared.layout.invariant demands setgid=yes with the
# recovery `ogit repo.share` — a FAIL nothing could repair. Without a dev
# group only the group part is skipped: no chgrp, no g+w; setgid on the
# pending directories stays. The fixture: private.this.group.exists says there
# is no dev group, a chgrp on PATH records any call.
test.this.folderShareNoDevGroup() {
  local fx bad="" got m; fx=$(test.suite.fixture.make foldersharenodev)
  mkdir -p "$fx/tree/sub/deep" "$fx/bin"; printf 'f\n' > "$fx/tree/sub/file"
  command chmod g-s "$fx/tree" "$fx/tree/sub" "$fx/tree/sub/deep"; command chmod 644 "$fx/tree/sub/file"
  printf '%s\n' '#!/bin/sh' "echo \"chgrp \$*\" >> '$fx/chgrp.calls'" 'exit 1' > "$fx/bin/chgrp"; command chmod +x "$fx/bin/chgrp"
  got=$( PATH="$fx/bin:$PATH"; LOG_DEVICE="$fx/log.out"
         private.this.group.exists() { [ "$1" != dev ]; }
         private.this.folder.share "$fx/tree" no >/dev/null 2>&1; echo "no:$?|$RESULT"
         [ -g "$fx/tree/sub" ] && echo "setgid-under-no"
         private.this.folder.share "$fx/tree" >/dev/null 2>&1; echo "yes:$?|$RESULT"
         echo "pending=[$(private.this.share.pending.list "$fx/tree" | tr '\n' ' ')]" )
  echo "$got" | grep -qx "no:0|no dev group — $fx/tree left as it is" || bad="$bad setgid-no=[$(echo "$got" | grep '^no:')]"
  echo "$got" | grep -qx "setgid-under-no" && bad="$bad setgid-under-no"
  echo "$got" | grep -qx "yes:0|$fx/tree: setgid on its directories (no dev group)" || bad="$bad setgid-yes=[$(echo "$got" | grep '^yes:')]"
  echo "$got" | grep -qx "pending=\[\]" || bad="$bad $(echo "$got" | grep '^pending=')"
  [ -g "$fx/tree" ] && [ -g "$fx/tree/sub" ] && [ -g "$fx/tree/sub/deep" ] || bad="$bad not-setgid"
  m=$(private.this.path.stat.get "$fx/tree/sub/file" mode); [ "${m: -3}" = 644 ] || bad="$bad file-touched=[$m]"
  [ -e "$fx/chgrp.calls" ] && bad="$bad chgrp-called=[$(tr '\n' '|' < "$fx/chgrp.calls")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "no dev group: setgid on the directories, no chgrp, no g+w; setgid no leaves it" || create.result 1 "share without dev:$bad"
  return $(result)
}
test.case $level "T-THIS-FOLDER-SHARE-NO-DEV-GROUP: without a dev group folder.share still sets setgid on the pending directories, and only that" test.this.folderShareNoDevGroup
expect 0 "no dev group: setgid on the directories, no chgrp, no g+w; setgid no leaves it" "layout invariant FAIL setgid=no that ogit repo.share could not repair"


console.log "
Test: private.this.selfLoop.remove
===================================================================="

test.case - "T-THIS-SELFLOOP-REMOVE-NODIR: a missing <dir> is refused" \
   private.this.selfLoop.remove ""
expect 1 "private.this.selfLoop.remove requires an existing <dir>, got ''"

# T-THIS-SELFLOOP-REMOVE: the link back to the folder goes, every other entry stays
# The old `cp -r ~/config sharedConfig` of install state 31 left
# sharedConfig/sharedConfig → sharedConfig on tampered VMs. config init.shared
# and state 31 drop it; a link elsewhere, a file and a folder are kept.
test.this.selfLoopRemove() {
  local fx bad="" got; fx=$(test.suite.fixture.make selflooprm)
  mkdir -p "$fx/sc/sub" "$fx/other"; printf 'f\n' > "$fx/sc/file"
  ln -s "$fx/sc" "$fx/sc/sc"; ln -s . "$fx/sc/dot"; ln -s "$fx/other" "$fx/sc/away"
  got=$( LOG_DEVICE="$fx/log.out"; private.this.selfLoop.remove "$fx/sc" >/dev/null 2>&1; echo "$?|$RESULT" )
  [ "$got" = "0|2 self-loop(s) removed from $fx/sc" ] || bad="$bad first=[$got]"
  { [ -e "$fx/sc/sc" ] || [ -L "$fx/sc/sc" ] || [ -L "$fx/sc/dot" ]; } && bad="$bad loop-kept"
  [ -L "$fx/sc/away" ] && [ -f "$fx/sc/file" ] && [ -d "$fx/sc/sub" ] || bad="$bad other-entry-gone"
  got=$( LOG_DEVICE="$fx/log.out"; private.this.selfLoop.remove "$fx/sc" >/dev/null 2>&1; echo "$?|$RESULT" )
  [ "$got" = "0|no self-loop in $fx/sc" ] || bad="$bad second=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "both self-loops removed, the other entries kept; a second run finds none" || create.result 1 "selfLoop:$bad"
  return $(result)
}
test.case $level "T-THIS-SELFLOOP-REMOVE: a link back to the folder itself is removed, every other entry stays" test.this.selfLoopRemove
expect 0 "both self-loops removed, the other entries kept; a second run finds none" "sharedConfig/sharedConfig of an old install"

### test.method

test.suite.save.results
