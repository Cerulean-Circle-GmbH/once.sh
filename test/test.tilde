#!/usr/bin/env bash
# http://www.etalabs.net/sh_tricks.html
TEST_CATEGORY=core

# ═══════════════════════════════════════════════════════════════════════════
# CLEAN ENVIRONMENT — restored (the other half of what 075b4a3 dropped)
# ═══════════════════════════════════════════════════════════════════════════
# This file tests TILDE EXPANSION — behaviour that depends entirely on $HOME
# and on the surrounding environment. It was deliberately run from a clean
# slate: 815d14d ("Modify shebang for clean environment"), the sibling commit
# to 8c277f4 which did the same for init/oosh, gave it
#
#     #!/usr/bin/env -iS HOME=${HOME} bash
#
# 075b4a3 removed that shebang from BOTH files because BusyBox `env` has no
# -S. init/oosh got the guarantee back as an in-file re-exec; this file never
# did, and has been inheriting whatever the caller happened to have ever since.
# It passes that way — but "green because the caller's environment happened to
# be fine" is not the assertion it was written to make.
#
# THE LITERAL SHEBANG IS NOT COMING BACK. -S is exactly the flag BusyBox
# rejects; restoring it would re-break Alpine. The guarantee is re-established
# the way init/oosh:168-199 does it — and -S was only ever needed because a
# SHEBANG passes one argument. `env -i VAR=val cmd` is accepted everywhere,
# BusyBox included.
#
# WE NAME AN INTERPRETER, never a bare "$0" — same reasoning as init/oosh: a
# bare "$0" goes to the kernel, which requires the execute bit and re-reads the
# shebang (dropping a caller's -x). ${BASH:-bash} is bash's own ABSOLUTE path,
# so it survives the PATH reset below, and this file stays a BASH script — it
# uses `~` in `[ ]`, which is not POSIX, so it must not be downgraded to sh.
#
# ── WHAT THE SUITE NEEDS TO SURVIVE — CHECKED, NOT GUESSED ─────────────────
# test.suite runs this file as a SUBPROCESS (`$file $level $clear`, so $0 is
# an absolute path) and then reads `$CONFIG_PATH/testresult.env` to pick up
# counters. So the question is what THIS file touches. Verified by reading it
# end to end, and re-checkable in one command each:
#
#   * grep -cE '^[[:space:]]*(source|\.)[[:space:]]+(this|test\.suite)' -> 0
#     and
#     grep -cE '(^|[[:space:]])(test\.case|expect|create\.result|test\.suite\.save\.results)([[:space:]]|$)'
#     -> 0. It does not source `this` or `test.suite`, declares no test.case,
#     makes no `expect` assertion and never calls test.suite.save.results. It
#     therefore NEVER WRITES testresult.env, so carrying CONFIG_PATH would
#     change nothing the parent reads. (Grep for a bare `expect` and you get 6
#     hits — every one is the word "expected" inside an echo. Hence the
#     anchored patterns above; the loose one is what makes this look assertive
#     when it is not.)
#   * `grep -c 'LOG_' test/test.tilde` -> 0. No log function is ever called;
#     $1 (the level) is accepted and ignored. So LOG_LEVEL and LOG_DEVICE are
#     not needed either — and they are exactly the kind of inherited state a
#     clean-environment test should be rid of.
#   * `grep -cE 'OOSH_DIR|CONFIG' test/test.tilde` -> 0.
#
#   So the carry list is genuinely minimal, and every entry is justified:
#     HOME     — the subject under test. Everything here is `~` vs $HOME.
#     PATH     — SEEDED to a fixed list, not carried: `env -i` leaves PATH
#                unset and the file runs `touch` and `rm`. A fixed list makes
#                the value identical for every caller, which is the point of
#                the exercise; carrying the caller's would surrender it.
#                /opt/homebrew first for the same arm64-Mac reason as
#                init/oosh:120-128.
#     the sentinel — see below.
#     "$@"     — the level/clear arguments the suite passes.
#
#   Deliberately NOT carried, each for a reason: LOG_LEVEL / LOG_DEVICE and
#   CONFIG_PATH (unused — above; and the suite's own copies are in the PARENT
#   process, which this re-exec does not touch), TERM (nothing here writes
#   colour or calls tput; the suite's banners are printed by the parent), and
#   OOSH_* (nothing here is an oosh script).
#
# ── WHY THIS CANNOT LOOP ───────────────────────────────────────────────────
# The re-exec is guarded by a sentinel that is SET IN THE VERY env -i LIST it
# execs with, so the child cannot take the branch again — one re-exec, ever,
# exactly as init/oosh:168. The two file tests are a second, independent stop:
# if $0 is not a readable file we skip rather than exec. Both halves are
# pinned by test.config T69, which runs this file with the sentinel already
# set and asserts it terminates and does NOT re-exec.
#
# The clean-environment property is made OBSERVABLE below (the "Environment"
# line) precisely so T69 can assert it from outside: it plants
# OOSH_TILDE_CANARY in the environment and requires that it did not survive.
# A guarantee no test can see is a comment, not a guarantee.
if [ -z "${OOSH_TILDE_CLEAN_ENV:-}" ] && [ -f "$0" ] && [ -r "$0" ]; then
  # Forward xtrace. Unquoted on purpose: empty must expand to NO argument.
  _oosh_x=""
  case "$-" in *x*) _oosh_x="-x" ;; esac
  exec env -i \
    PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin" \
    HOME="$HOME" \
    OOSH_TILDE_CLEAN_ENV=1 \
    "${BASH:-bash}" $_oosh_x "$0" "$@"
fi

expand_tilde() {
    tilde_less="${1#\~/}"
    [ "$1" != "$tilde_less" ] && tilde_less="$HOME/$tilde_less"
    printf '%s' "$tilde_less"
}

test_start()
{
  # The clean-environment guarantee, made visible. T69 in test.config reads
  # these two facts back: the re-exec really happened, and a variable planted
  # by the caller really did not survive it.
  if [ -n "${OOSH_TILDE_CANARY:-}" ]; then
    echo "Environment                                : INHERITED (OOSH_TILDE_CANARY survived)"
  else
    echo "Environment                                : clean, canary absent"
  fi

  # home dir test
  if [ ~ != ${HOME} ]; then
    echo "Tilde expansion ('" ~ "') differs HOME ('${HOME}') .. exit"
    exit 1
  fi

  # tilde is not expanded in string as defined by POSIX https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html#tag_18_06_01
  echo "Tilde expansion in string                  : ~/.ssh"
  # tilde is expanded in string with custom function
  echo "Tilde expansion in string w/ expand_tilde():" $(expand_tilde "~/.ssh")
  # tilde is expanded when put before string
  echo "Tilde expansion before string              :" ~/".ssh"
  # do the same with $HOME
  echo "Content of home variable                   : ${HOME}/.ssh"

  # tilde expansion in tests
  touch ~/.tilde_expansion

  if [ -f "~/.tilde_expansion" ]; then
    echo "Unexpected success testing tilde expansion in string :O"
  else
    echo "Testing tilde expansion in string failed as expected ;)"
  fi

  if [ -f ~/".tilde_expansion" ]; then
    echo "Testing tilde expansion succeeds as expected ;)"
  else
    echo "Unexpected failure testing tilde expansion :O"
  fi

  if [ -f $(expand_tilde "~/.tilde_expansion") ]; then
    echo "Testing tilde expansion succeeds as expected ;)"
  else
    echo "Unexpected failure testing tilde expansion :O"
  fi

  rm ~/.tilde_expansion
}

test_start "$@"
