#!/usr/bin/env bash
# Tests for tilde expansion — http://www.etalabs.net/sh_tricks.html
# Everything here is `~` versus $HOME, so the file first re-execs itself into
# a CLEAN environment; test.config T69 asserts that from the outside.
TEST_CATEGORY=core

# ── Clean environment ──────────────────────────────────────────────────────
# 815d14d gave this file `#!/usr/bin/env -iS HOME=${HOME} bash` (the sibling
# of init/oosh's 8c277f4); 075b4a3 removed both because BusyBox env has no
# -S, and this file inherited the caller's environment ever since — green for
# a reason unrelated to what it asserts. Re-established the way init/oosh does
# it: a one-shot self-re-exec (`env -i VAR=val cmd` is accepted everywhere,
# BusyBox included), naming the interpreter (a bare "$0" would need the
# execute bit and re-read the shebang, dropping a caller's -x), guarded by a
# sentinel set in the very list it execs with, so it cannot loop.
#
# Carried, each for a reason:
#   HOME                  — the subject under test.
#   OOSH_DIR, CONFIG_PATH — `this` and test.suite.
#   TEST_SUITE_RESULT_PATH — where test.suite.save.results writes this file's
#                           score, and where the parent suite reads it back.
#                           Since 2026-09-16 the runner gives each run its own
#                           private directory instead of the shared config
#                           tier, so this can no longer be re-derived from
#                           CONFIG_PATH: drop it and the score lands somewhere
#                           the runner never looks, and the file is reported
#                           `NO RESULTS` — which now fails a core run.
#   TEST_SUITE_CONFIG_ORIGIN — the tier the runner snapshotted, so a restore
#                           in the child cannot aim at the wrong directory.
#   LOG_LEVEL, LOG_DEVICE — the framework's assertion output.
#   TERM                  — the framework's colours; `${TERM:-dumb}` because
#                           bash leaves an EMPTY TERM empty and tput rejects it.
#   PATH is SEEDED, not carried: `env -i` leaves it unset and the file runs
#   touch/rm; a fixed list makes the value identical for every caller.
#   Nothing else — that is the point.
if [ -z "${OOSH_TILDE_CLEAN_ENV:-}" ] && [ -f "$0" ] && [ -r "$0" ]; then
  # Forward xtrace. Unquoted on purpose: empty must expand to NO argument.
  xtraceFlag=""
  case "$-" in *x*) xtraceFlag="-x" ;; esac
  exec env -i \
    PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin" \
    HOME="$HOME" \
    OOSH_DIR="${OOSH_DIR:-$HOME/oosh}" \
    CONFIG_PATH="${CONFIG_PATH:-$HOME/config}" \
    TEST_SUITE_RESULT_PATH="${TEST_SUITE_RESULT_PATH:-${CONFIG_PATH:-$HOME/config}}" \
    TEST_SUITE_CONFIG_ORIGIN="${TEST_SUITE_CONFIG_ORIGIN:-${CONFIG_PATH:-$HOME/config}}" \
    LOG_LEVEL="${LOG_LEVEL:-1}" \
    LOG_DEVICE="${LOG_DEVICE:-/dev/tty}" \
    TERM="${TERM:-dumb}" \
    OOSH_TILDE_CLEAN_ENV=1 \
    OOSH_TILDE_REEXECED=1 \
    "${BASH:-bash}" $xtraceFlag "$0" "$@"
fi

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source "${OOSH_DIR:-$HOME/oosh}/this"
source "$OOSH_DIR/test.suite"

log.level $level

test.tilde.expand() # <path> # expand a leading ~/ the way the shell would, for a path that arrived as DATA (POSIX never expands ~ inside a string)
{
  local tildeLess="${1#\~/}"
  [ "$1" != "$tildeLess" ] && tildeLess="$HOME/$tildeLess"
  printf '%s' "$tildeLess"
}

# ── T-TILDE-CLEAN-ENV: the guarantee, made visible ─────────────────────────
# The Environment line is what T69 reads from outside: it plants
# OOSH_TILDE_CANARY and requires that it did not survive. Asserted only when
# THIS file did the re-exec — with the sentinel preset by a caller (T69's
# loop check) an inherited environment is the expected outcome.
if [ -n "${OOSH_TILDE_CANARY:-}" ]; then
  echo "Environment                                : INHERITED (OOSH_TILDE_CANARY survived)"
else
  echo "Environment                                : clean, canary absent"
fi
if [ -n "${OOSH_TILDE_REEXECED:-}" ]; then
  test.case $level "T-TILDE-CLEAN-ENV: the file runs from a clean environment" true
  if [ -z "${OOSH_TILDE_CANARY:-}" ]; then
    expect.pass "clean environment: no caller variable survived the re-exec"
  else
    expect.fail "OOSH_TILDE_CANARY survived — the env -i re-exec did not happen (the 075b4a3 regression)"
  fi
fi

# ── T-TILDE-HOME: bare ~ is $HOME ──────────────────────────────────────────
test.tilde.home() {
  if [ ~ = "$HOME" ]; then
    create.result 0 "bare ~ is \$HOME"
  else
    create.result 1 "bare ~ expands to '$(echo ~)' but HOME is '$HOME'"
  fi
  return $(result)
}
test.case $level "T-TILDE-HOME: bare ~ expands to \$HOME" \
  test.tilde.home
expect 0 "bare ~ is \$HOME" "every other assertion here assumes this one"

# ── T-TILDE-STRING: POSIX never expands ~ inside a string ──────────────────
# https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html#tag_18_06_01
test.tilde.string() {
  local quoted="~/.ssh" expanded
  expanded=$(test.tilde.expand "~/.ssh")
  if [ "$quoted" != "~/.ssh" ]; then
    create.result 1 "a quoted ~ was expanded to '$quoted'"
  elif [ "$expanded" != "$HOME/.ssh" ]; then
    create.result 1 "test.tilde.expand gave '$expanded', expected '$HOME/.ssh'"
  elif [ ~/".ssh" != "$HOME/.ssh" ]; then
    create.result 1 "~/\".ssh\" gave '$(echo ~/".ssh")', expected '$HOME/.ssh'"
  else
    create.result 0 "quoted ~ literal, ~/\"x\" and test.tilde.expand expanded"
  fi
  return $(result)
}
test.case $level "T-TILDE-STRING: quoted ~ stays literal; unquoted prefix and test.tilde.expand expand" \
  test.tilde.string
expect 0 "quoted ~ literal, ~/\"x\" and test.tilde.expand expanded" \
  "a path that arrives as data must go through test.tilde.expand"

# ── T-TILDE-FILE-TEST: the same three forms inside [ -f ] ──────────────────
test.tilde.fileTest() {
  local marker="$HOME/.tilde_expansion" bad=""
  touch "$marker" || { create.result 1 "cannot create $marker"; return $(result); }
  [ -f "~/.tilde_expansion" ] && bad="$bad quoted-literal-found-a-file"
  [ -f ~/".tilde_expansion" ] || bad="$bad unquoted-prefix-not-expanded"
  [ -f "$(test.tilde.expand "~/.tilde_expansion")" ] || bad="$bad expand-function-not-expanded"
  rm -f "$marker"
  if [ -z "$bad" ]; then
    create.result 0 "file tests: literal misses, expanded forms hit"
  else
    create.result 1 "file tests wrong:$bad"
  fi
  return $(result)
}
test.case $level "T-TILDE-FILE-TEST: [ -f ] sees ~ only when the shell expanded it" \
  test.tilde.fileTest
expect 0 "file tests: literal misses, expanded forms hit" \
  "the classic bug: [ -f \"~/x\" ] is always false"

test.suite.save.results
