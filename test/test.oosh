#!/usr/bin/env bash
# Tests for init/oosh bootstrap functions
# Tests: shell detection, status output
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# Source init/oosh safely (prevent set -x debug pollution)
export SH_OPT="+x"
source $OOSH_DIR/init/oosh

# ============================================================================
# T1: oosh_get_running_shell detects bash
# ============================================================================
test.case $level "oosh_get_running_shell detects bash" \
  oosh_get_running_shell

if [ "$SHELLNAME" = "bash" ]; then
  expect.pass "SHELLNAME is bash"
else
  expect.fail "SHELLNAME should be bash, got: $SHELLNAME"
fi

# ============================================================================
# T2: oosh_get_running_shell sets SHELL to executable path
# ============================================================================
test.case $level "oosh_get_running_shell sets SHELL path" \
  oosh_get_running_shell

if [ -x "$SHELL" ]; then
  expect.pass "SHELL is executable: $SHELL"
else
  expect.fail "SHELL should be executable, got: $SHELL"
fi

# ============================================================================
# T3: oosh_status runs without error
# ============================================================================
test.case $level "oosh_status runs without error" \
  oosh_status

expect 0 "*" "oosh_status returned 0"

test.suite.save.results
