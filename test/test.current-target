#!/usr/bin/env bash
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T-CURRENT-TARGET — FEATURE 8 (Tron 2026-06-28)
# ============================================================================
# CURRENT is a first-class pane target alongside U/D/L/R, resolved via
# private.otmux.pane.self (PID-walk). It must:
#   1. be recognized by the single resolver private.resolve.target
#   2. resolve to the caller's REAL pane (immune to stale TMUX_PANE)
#   3. appear in the shared pane-target completion list
#
# Static + structural guard (no live tmux required for CI).

OTMUX="$OOSH_DIR/otmux"

# 1. resolver has a CURRENT case
test.case $level "private.resolve.target handles CURRENT" echo "check"
if grep -qE 'CURRENT\|current\|\.\|self\)' "$OTMUX" 2>/dev/null; then
  expect.pass "resolver maps CURRENT/current/./self → pane.self"
else
  expect.fail "private.resolve.target missing CURRENT case"
fi

# 2. CURRENT resolves via the self-ID primitive (not stale TMUX_PANE)
test.case $level "CURRENT routes through pane.self" echo "check"
if grep -E 'CURRENT\|current' "$OTMUX" 2>/dev/null | grep -q 'private.otmux.pane.self'; then
  expect.pass "CURRENT resolves via private.otmux.pane.self (PID-walk)"
else
  expect.fail "CURRENT does not route through pane.self"
fi

# 3. shared completion helper lists CURRENT
test.case $level "completion lists CURRENT" echo "check"
if grep -A6 'private.complete.paneTargets()' "$OTMUX" 2>/dev/null | grep -q '"CURRENT"'; then
  expect.pass "private.complete.paneTargets includes CURRENT"
else
  expect.fail "shared pane-target completion missing CURRENT"
fi

# 4. both pane-target completions use the shared helper (DRY, item D)
test.case $level "pane-target completions funnel through one helper" echo "check"
usforms=$(grep -cE 'private.complete.paneTargets$' "$OTMUX" 2>/dev/null)
if [ "${usforms:-0}" -ge 2 ]; then
  expect.pass "≥2 completions call private.complete.paneTargets (single vocabulary)"
else
  expect.fail "expected both completions to call private.complete.paneTargets, found ${usforms}"
fi

# 5. live resolution (only when in tmux): pane.capture CURRENT must reach a real
# pane (rc 0). Uses the public CLI path — never sources otmux (BUG 4). Proves
# CURRENT flows through private.resolve.target → pane.self end to end.
if [ -n "$TMUX" ] && otmux pane.self >/dev/null 2>&1; then
  if otmux pane.capture CURRENT 1 >/dev/null 2>&1; then
    capOk="OK"
  else
    capOk="FAIL"
  fi
  test.case $level "pane.capture CURRENT reaches caller's pane" echo "$capOk"
  if [ "$capOk" = "OK" ]; then
    expect.pass "CURRENT resolves to a live pane via public CLI"
  else
    expect.fail "pane.capture CURRENT failed to resolve"
  fi
fi

test.suite.save.results
