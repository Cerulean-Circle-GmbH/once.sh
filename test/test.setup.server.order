#!/usr/bin/env bash
# T-STATE-ORDER — SETUP_SERVER mode branch precedes user.installation.done,
# and the XOR mode checks redirect (never hold) so `state next` crosses
# release⊕dev for BOTH OOSH_MODE values, converging on user.installation.done.
#
# Regression for sprint-setup-server-crossplatform.md D1+D2 (expert 566fed9),
# from tester diagnosis 703b817. All change lives in `oo` — ZERO `state`-engine
# edits (Tron hard constraint), so these asserts read `oo` (source-level, which
# is platform-independent and doesn't require driving the machine / sudo) plus a
# live index check when the SETUP_SERVER machine exists in new order.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

OO="$OOSH_DIR/oo"

# ============================================================================
# D1 — state-add order: mode branch BEFORE user.installation.done
# ============================================================================
# Capture the line numbers of the three state.add calls in oo.
relLine=$(grep -nE '^\s*state\.add\s+user\.mode\.release\b'      "$OO" | head -1 | cut -d: -f1)
devLine=$(grep -nE '^\s*state\.add\s+user\.mode\.dev\b'          "$OO" | head -1 | cut -d: -f1)
doneLine=$(grep -nE '^\s*state\.add\s+user\.installation\.done\b' "$OO" | head -1 | cut -d: -f1)

test.case $level "T-STATE-ORDER: oo declares all three user states" \
  echo "release=$relLine dev=$devLine done=$doneLine"
if [ -n "$relLine" ] && [ -n "$devLine" ] && [ -n "$doneLine" ]; then
  expect.pass "state.add for release($relLine) dev($devLine) done($doneLine) present"
else
  expect.fail "missing a state.add: release=$relLine dev=$devLine done=$doneLine"
fi

test.case $level "T-STATE-ORDER: user.mode.release added BEFORE user.installation.done" \
  echo "$relLine < $doneLine"
if [ -n "$relLine" ] && [ -n "$doneLine" ] && [ "$relLine" -lt "$doneLine" ]; then
  expect.pass "release ($relLine) precedes done ($doneLine)"
else
  expect.fail "release ($relLine) must precede done ($doneLine) — D1 reorder"
fi

test.case $level "T-STATE-ORDER: user.mode.dev added BEFORE user.installation.done" \
  echo "$devLine < $doneLine"
if [ -n "$devLine" ] && [ -n "$doneLine" ] && [ "$devLine" -lt "$doneLine" ]; then
  expect.pass "dev ($devLine) precedes done ($doneLine)"
else
  expect.fail "dev ($devLine) must precede done ($doneLine) — D1 reorder"
fi

# ============================================================================
# D2 — mode checks always-succeed (create.result 0) and redirect via state.find
#      (dynamic index, no hardcoded 21/22/23). Returning 1 = the old stall.
# ============================================================================
relBody=$(awk '/^private\.check\.user\.mode\.release\(\)/{f=1} f{print} f&&/^}/{exit}' "$OO")
devBody=$(awk '/^private\.check\.user\.mode\.dev\(\)/{f=1} f{print} f&&/^}/{exit}' "$OO")

test.case $level "T-STATE-ORDER: release-arm never HOLDS (no 'create.result 1'/'return 1')" \
  echo "$relBody"
if echo "$relBody" | grep -qE 'create\.result\s+1|return\s+1\b'; then
  expect.fail "release-arm still returns 1 — reintroduces the D2 stall"
else
  expect.pass "release-arm has no failing return (always steers via RESULT)"
fi

test.case $level "T-STATE-ORDER: dev-arm never HOLDS (no 'create.result 1'/'return 1')" \
  echo "$devBody"
if echo "$devBody" | grep -qE 'create\.result\s+1|return\s+1\b'; then
  expect.fail "dev-arm still returns 1 — reintroduces the D2 stall"
else
  expect.pass "dev-arm has no failing return (always steers via RESULT)"
fi

test.case $level "T-STATE-ORDER: release-arm redirects to user.mode.dev via state.find (no literal index)" \
  echo "$relBody"
if echo "$relBody" | grep -qE 'state\.find\s+SETUP_SERVER\s+user\.mode\.dev'; then
  expect.pass "release-arm redirects via state.find user.mode.dev"
else
  expect.fail "release-arm must redirect via state.find user.mode.dev (dynamic, DRY)"
fi

test.case $level "T-STATE-ORDER: dev-arm redirects to user.installation.done via state.find (no literal index)" \
  echo "$devBody"
if echo "$devBody" | grep -qE 'state\.find\s+SETUP_SERVER\s+user\.installation\.done'; then
  expect.pass "dev-arm redirects via state.find user.installation.done"
else
  expect.fail "dev-arm must redirect via state.find user.installation.done (dynamic, DRY)"
fi

# No hardcoded mode indices anywhere in the two arms (survives reorder).
test.case $level "T-STATE-ORDER: mode arms use NO hardcoded state indices (21/22/23)" \
  echo "checking literal indices"
if printf '%s\n%s\n' "$relBody" "$devBody" | grep -qE 'RESULT[^)]*\b2[123]\b|result\s+0\s+"2[123]"'; then
  expect.fail "mode arm hardcodes an index 21/22/23 — must use state.find"
else
  expect.pass "no hardcoded 21/22/23 in mode arms"
fi

# ============================================================================
# ZERO state-engine edits — the `state` script must be untouched by this sprint
# ============================================================================
test.case $level "T-STATE-ORDER: no mode-check LOGIC leaked into the state engine" \
  echo "grep state for the mode check functions / mode state-adds"
# The constraint is zero SETUP_SERVER *logic* in the engine. Ignore generic help
# examples (state:usage mentions "SETUP_SERVER" as a sample); assert the mode
# CHECK functions and mode state-adds live ONLY in oo, never in the engine.
if grep -qE 'private\.check\.user\.mode\.(release|dev)|state\.add[[:space:]]+user\.mode' "$OOSH_DIR/state"; then
  expect.fail "state engine contains mode-check logic — Tron constraint = zero engine edits"
else
  expect.pass "state engine free of mode-check logic (all in oo)"
fi

# ============================================================================
# LIVE (only where the machine was built, e.g. WODA.test): parse the states.env
# array directly (portable — no state.find/machine.exists, which are unreliable
# as guards). index(mode branch) < index(done).
# ============================================================================
statesFile="${CONFIG_PATH:-$HOME/config}/stateMachines/SETUP_SERVER.states.env"
# Require the machine to actually contain the mode band (skip stub/legacy files).
if [ -f "$statesFile" ] && grep -qE '"user\.mode\.dev"' "$statesFile"; then
  iRel=$(grep -oE '\[[0-9]+\]="user\.mode\.release"'      "$statesFile" | grep -oE '[0-9]+' | head -1)
  iDev=$(grep -oE '\[[0-9]+\]="user\.mode\.dev"'          "$statesFile" | grep -oE '[0-9]+' | head -1)
  iDone=$(grep -oE '\[[0-9]+\]="user\.installation\.done"' "$statesFile" | grep -oE '[0-9]+' | head -1)
  test.case $level "T-STATE-ORDER (live): index(release)<index(done) and index(dev)<index(done)" \
    echo "release=$iRel dev=$iDev done=$iDone"
  if [ -n "$iRel" ] && [ -n "$iDev" ] && [ -n "$iDone" ] \
     && [ "$iRel" -lt "$iDone" ] && [ "$iDev" -lt "$iDone" ]; then
    expect.pass "live indices ordered: release($iRel),dev($iDev) < done($iDone)"
  else
    expect.fail "live machine mis-ordered (or old-order not migrated): release=$iRel dev=$iDev done=$iDone"
  fi
else
  test.case $level "T-STATE-ORDER (live): skipped — no SETUP_SERVER machine on this box" echo "skip"
  expect.pass "skipped live index check (states.env absent — expected off WODA.test)"
fi

test.suite.save.results
