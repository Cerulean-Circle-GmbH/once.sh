# T-LOG-TERMINAL: one list of terminal-type devices — fd1/stdout, fd2/stderr,
# the tty, unset — shared by private.log.emit and log.device.
test.log.deviceIsTerminal() {
  local bad="" d
  for d in "" /dev/stdout /dev/stderr /proc/self/fd/1 /dev/fd/1 /proc/self/fd/2 /dev/fd/2 /dev/tty; do
    private.log.device.is.terminal "$d" || bad="$bad [$d]-not-terminal"
  done
  private.log.device.is.terminal "/tmp/some.log" && bad="$bad file-called-terminal"
  [ -z "$bad" ] && create.result 0 "terminal-type devices recognised, a file is not" || create.result 1 "terminal:$bad"
  return $(result)
}
test.case - "T-LOG-TERMINAL: private.log.device.is.terminal knows every terminal-type device and no file" test.log.deviceIsTerminal
expect 0 "terminal-type devices recognised, a file is not" "one list for the emitter and log.device"


console.log "
Test: T-LOG-EMIT
===================================================================="

# T-LOG-EMIT: a log line never lands on stdout (#41 / c0e6036, lost in the dev
# rebuild): a terminal-type LOG_DEVICE is written to fd2 by DUP (no reopen —
# the su- EACCES), a file LOG_DEVICE is appended to. So `$(anything)` captures
# only what a command prints on purpose (BUG5 — param-env contamination).
test.log.emitNeverStdout() {
  local bad="" out f="$TEST_LOG_DEVICE.emit"
  # portability-exception: same process — log classifies /proc/self/fd/1 by NAME as a capture and never opens it
  out=$( { LOG_DEVICE=/proc/self/fd/1; LOG_LEVEL=3
           console.log "emit-console"; warn.log "emit-warn"; important.log "emit-important"
           success.log "emit-success"; error.log "emit-error"; } 2>"$f.err" )
  [ -z "$out" ] || bad="$bad stdout=[$(printf '%s' "$out" | tr '\n' ' ')]"
  grep -q 'emit-console' "$f.err" 2>/dev/null || bad="$bad console-not-on-stderr"
  grep -q 'emit-warn' "$f.err" 2>/dev/null || bad="$bad warn-not-on-stderr"
  ( LOG_DEVICE="$f"; LOG_LEVEL=3; : > "$f"; console.log "emit-file" ) 2>/dev/null
  grep -q 'emit-file' "$f" 2>/dev/null || bad="$bad file-not-appended"
  rm -f "$f" "$f.err"
  [ -z "$bad" ] && create.result 0 "log lines go to stderr or the device file, never stdout" || create.result 1 "emit:$bad"
  return $(result)
}
test.case - "T-LOG-EMIT: console/warn/important/success/error.log never write to stdout" test.log.emitNeverStdout
expect 0 "log lines go to stderr or the device file, never stdout" "a log line inside \$(…) contaminated the captured value"


console.log "
Test: T-LOG-CAPTURE
===================================================================="

# T-LOG-CAPTURE: the fd1/fd2 spellings — never probed (a probe of fd1 is the
# #41 leak into $()); /dev/tty and files are probed by private.log.device.probe.
test.log.deviceIsCapture() {
  local bad="" d
  for d in /dev/stdout /proc/self/fd/1 /dev/fd/1 /dev/stderr /proc/self/fd/2 /dev/fd/2; do
    private.log.device.is.capture "$d" || bad="$bad [$d]-not-capture"
  done
  for d in "" /dev/tty /tmp/some.log; do
    private.log.device.is.capture "$d" && bad="$bad [$d]-called-capture"
  done
  [ -z "$bad" ] && create.result 0 "fd1/fd2 spellings are capture devices; tty, files and unset are not" || create.result 1 "capture:$bad"
  return $(result)
}
test.case - "T-LOG-CAPTURE: private.log.device.is.capture knows the fd1/fd2 spellings and nothing else" test.log.deviceIsCapture
expect 0 "fd1/fd2 spellings are capture devices; tty, files and unset are not" "the probe must skip exactly the devices whose probe would leak or cannot fail"


console.log "
Test: T-LOG-DEVICE-PROBE
===================================================================="

# T-LOG-DEVICE-PROBE: one probe for log.device and log.init — a device that
# cannot be opened (/dev/tty with no controlling terminal, an unwritable file)
# falls back to /dev/stderr; a capture spelling is left alone; a writable file
# is kept and gets NO probe line written into it.
test.log.deviceProbe() {
  local bad="" got f="$TEST_LOG_DEVICE.probe"
  # /dev/tty WITHOUT a controlling terminal needs a new session, and only
  # util-linux ships `setsid` — macOS has none, so there this case is covered
  # by the unopenable-file case below (the same branch of the probe).
  if command -v setsid >/dev/null 2>&1; then
    got=$(env -i PATH="$PATH" HOME="$HOME" OOSH_DIR="$OOSH_DIR" LOG_LEVEL=1 \
          setsid bash -c "source \"$OOSH_DIR/log\" >/dev/null 2>&1; LOG_DEVICE=/dev/tty; private.log.device.probe 2>/dev/null; echo \"\$LOG_DEVICE\"" </dev/null 2>/dev/null)
    [ "$got" = /dev/stderr ] || bad="$bad tty-without-terminal=[$got]"
  fi
  got=$( LOG_DEVICE="$TEST_LOG_DEVICE.nodir/x"; private.log.device.probe 2>/dev/null; echo "$LOG_DEVICE" )
  [ "$got" = /dev/stderr ] || bad="$bad unwritable-file=[$got]"
  # portability-exception: same process — log classifies /proc/self/fd/1 by NAME as a capture and never opens it
  got=$( LOG_DEVICE=/proc/self/fd/1; private.log.device.probe; echo "$LOG_DEVICE" )
  [ "$got" = /proc/self/fd/1 ] || bad="$bad capture-changed=[$got]"
  : > "$f"; ( LOG_DEVICE="$f"; private.log.device.probe )
  [ -s "$f" ] && bad="$bad probe-wrote-into-file"
  got=$( LOG_LEVEL= LOG_DEVICE=/proc/self/fd/1 log.init 3 2>/dev/null )
  [ -z "$got" ] || bad="$bad log.init-stdout=[$got]"
  rm -f "$f"
  [ -z "$bad" ] && create.result 0 "unopenable devices fall back to stderr; capture and file devices are kept, silently" || create.result 1 "probe:$bad"
  return $(result)
}
test.case - "T-LOG-DEVICE-PROBE: private.log.device.probe falls back to /dev/stderr only for a device that cannot be opened; log.init prints nothing to stdout" test.log.deviceProbe
expect 0 "unopenable devices fall back to stderr; capture and file devices are kept, silently" "log device kept /dev/tty off-tty, and log.init still probed fd1"

# T-LOG-DEVICE-ONE: exactly one log.device, and `log device <file>` sets it
# without persisting or recursing into config save.
test.log.deviceOne() {
  local bad="" n f="$TEST_LOG_DEVICE.one"
  n=$(grep -cE "^log\.device\(\)" "$OOSH_DIR/log"); [ "$n" = 1 ] || bad="$bad definitions=$n"
  ( config() { echo "CONFIG-CALLED $*"; }; this.call() { echo "THIS-CALL $*"; }
    log.device "$f" 2>/dev/null | grep -qE "CALLED|THIS-CALL" ) && bad="$bad recursed-into-config"
  rm -f "$f"
  [ -z "$bad" ] && create.result 0 "one log.device; no config save recursion" || create.result 1 "one:$bad"
  return $(result)
}
test.case - "T-LOG-DEVICE-ONE: log.device is defined once and no longer recurses into config save" test.log.deviceOne
expect 0 "one log.device; no config save recursion" "a second definition overrode the first on every source"


console.log "
Test: T-LOG-LIVE-FILE-SESSION
===================================================================="

# T-LOG-LIVE-FILE-SESSION: LOG_LIVE is a per-user session value (config save
# excludes it), so `log live.file <x>` persists it to the user's own
# log.session.env — like log.name — and leaves the SHARED log.env untouched:
# same content, not rewritten (its old mtime stays older than a marker).
test.log.liveFileSession() {
  local bad="" fixture home shared before
  fixture=$(test.suite.fixture.make test.log.liveFile) || { create.result 1 "no fixture"; return $(result); }
  home="$fixture/home"; shared="$fixture/config"
  mkdir -p "$home/.config/oosh" "$shared"
  printf '%s\n' 'export LOG_LEVEL="1"' '. $HOME/.config/oosh/log.session.env' > "$shared/log.env"
  printf '%s\n' 'export CONFIG_PATH="$HOME/config"' > "$shared/user.env"
  touch -t 200001010000 "$shared/log.env"
  touch -t 200001010001 "$fixture/marker"
  before=$(cat "$shared/log.env")
  ( export HOME="$home" CONFIG_PATH="$shared" CONFIG_FILE=user.env CONFIG="$shared/user.env"
    log.live.file "$fixture/live.out" >/dev/null 2>&1 )
  grep -qx "export LOG_LIVE=\"$fixture/live.out\"" "$home/.config/oosh/log.session.env" 2>/dev/null || bad="$bad session-not-saved=[$(cat "$home/.config/oosh/log.session.env" 2>/dev/null)]"
  [ "$(cat "$shared/log.env")" = "$before" ] || bad="$bad shared-content-changed"
  [ "$shared/log.env" -nt "$fixture/marker" ] && bad="$bad shared-rewritten"
  rm -rf "$fixture"
  [ -z "$bad" ] && create.result 0 "LOG_LIVE saved per user; shared log.env untouched" || create.result 1 "live.file:$bad"
  return $(result)
}
test.case - "T-LOG-LIVE-FILE-SESSION: log.live.file saves LOG_LIVE to the per-user log.session.env and never rewrites the shared log.env" test.log.liveFileSession
expect 0 "LOG_LIVE saved per user; shared log.env untouched" "log.live.file went through config save log LOG, which excludes LOG_LIVE"


console.log "
Test: T-LOG-SESSION-PURE-DATA
===================================================================="

# T-LOG-SESSION-PURE-DATA: log.session.env stays pure data whatever log name is given
# log.session.save wrote `export LOG_NAME="$LOG_NAME"` with the raw value, and
# the file is chained unguarded into every shell of the user: a name holding a
# quote ran code at the next login. A quote, $, backslash or backtick is
# written quoted (it reads back as given, nothing runs); a value that cannot be
# one line of data — a control character — is refused: rc 1, the file kept.
test.log.sessionPureData() {
  local fx bad="" f got rc before v
  fx=$(test.suite.fixture.make test.log.sessionPureData); f="$fx/.config/oosh/log.session.env"
  test.log.sessionPureData.run() { # <name> — log.name in a fixture home; echo its rc
    ( export HOME="$fx"; log.name "$1" >/dev/null 2>&1 ); echo $?
  }
  for v in "a\"; touch $fx/pwned; \"\\ \$HOME" "a\`touch $fx/pwned\`" "a\$(touch $fx/pwned)"; do
    rc=$(test.log.sessionPureData.run "$v")
    [ "$rc" = 0 ] || bad="$bad rc=$rc[$v]"
    # the platform invariant's pattern: export lines only
    grep -v -E '^[[:space:]]*($|#|export [A-Za-z_][A-Za-z0-9_]*=)' "$f" >/dev/null 2>&1 && bad="$bad not-export-lines[$v]"
    [ "$(grep -c '' "$f" 2>/dev/null)" = 3 ] || bad="$bad not-three-lines[$v]"
    got=$(HOME="$fx" sh -c ". \"$f\"; printf '%s' \"\$LOG_NAME\"" 2>/dev/null)
    [ "$got" = "$v" ] || bad="$bad read-back=[$got]"
  done
  [ -e "$fx/pwned" ] && bad="$bad sourcing-ran-code"
  before=$(cat "$f" 2>/dev/null)
  for v in "a
b" "a$(printf '\033')[31m"; do
    rc=$(test.log.sessionPureData.run "$v")
    [ "$rc" = 1 ] || bad="$bad refused-rc=$rc"
    [ "$(cat "$f" 2>/dev/null)" = "$before" ] || bad="$bad file-changed"
  done
  HOME="$fx" sh -c ". \"$f\"" >/dev/null 2>&1
  [ -e "$fx/pwned" ] && bad="$bad refused-value-ran-code"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "log.session.env stays pure data; a value that cannot be is refused" || create.result 1 "session pure data:$bad"
  return $(result)
}
test.case - "T-LOG-SESSION-PURE-DATA: log.session.env stays pure data whatever log name is given" test.log.sessionPureData
expect 0 "log.session.env stays pure data; a value that cannot be is refused" \
  "a log name holding a quote ran code in every shell of the user"


### test.method

test.suite.save.results
