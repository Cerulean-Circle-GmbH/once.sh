# ============================================================================
# T50: the LIVE terminal wins over a stale chained LOG_DEVICE (needs a pty)
# ============================================================================
# LOG_DEVICE is loaded from the chained log.session.env (a PREVIOUS session's
# tty, still writable because same-user). With a controlling terminal attached,
# log's top-level must re-derive LOG_DEVICE to the CURRENT tty, or every new
# shell would log onto the first terminal. Verified under a real pty via script.
test.log.liveTtyWinsOverStale() {
  # (1) a STALE terminal path (a previous session's pts) must be refreshed to the
  #     live tty; (2) an EXPLICIT non-terminal device (capture file) must be kept
  #     (this is what T31/T32's `LOG_DEVICE=/tmp/… log …` rely on under a tty).
  local capfile="/tmp/test.log.cap.$$"; : > "$capfile"
  local probe="/tmp/test.log.probe.$$"
  # The probe goes in a FILE, and `script` is told to run it with BASH.
  #
  # `script -qec <command>` does not guarantee which shell runs <command>, and
  # the command below MUST be bash: `log` uses dotted function names, so it can
  # only be sourced by bash, and `source` itself is a bashism. On a host where
  # `script` picked /bin/sh (dash) this failed with `sh: 1: source: not found`
  # — the probe never sourced `log` at all, LOG_DEVICE was never refreshed, and
  # the test reported the D4 guard broken WHILE THE GUARD WAS FINE. Measured in
  # an Ubuntu 24.04 container 2026-09-17; the same script version on the host
  # picked bash and passed, which is why it looked like a container bug.
  #
  # A file rather than a nested quoted string: this is three levels of quoting
  # (test → script → shell) and the previous one-liner was already at the limit.
  cat > "$probe" <<PROBE
export LOG_DEVICE=/dev/pts/999
source '$OOSH_DIR/log' >/dev/null 2>&1
[ "\$LOG_DEVICE" = "\$(tty)" ] && echo STALE_REFRESHED
export LOG_DEVICE='$capfile'
source '$OOSH_DIR/log' >/dev/null 2>&1
[ "\$LOG_DEVICE" = '$capfile' ] && echo FILE_KEPT
PROBE
  local out
  out=$(script -qec "bash $probe" /dev/null 2>/dev/null | tr -d '\r')
  rm -f "$probe"
  rm -f "$capfile"
  if echo "$out" | grep -q STALE_REFRESHED && echo "$out" | grep -q FILE_KEPT; then
    create.result 0 "stale terminal refreshed, explicit file kept"
  else
    create.result 1 "D4 guard wrong: $out"
  fi
}
# Skip-guard OUTSIDE the case (docs/python.md § Tests that exercise the Python
# paths): needs util-linux `script -qec` for a pty. Inside the function the
# skip returned a string the expect does not match, so it was scored as a
# FAIL on the alpine platform run (2026-09-15).
# portability-exception: this is the CAPABILITY PROBE for util-linux `script`,
# not a use of it to run test code — the command is the shell builtin `true`,
# so which shell runs it cannot matter. BSD/macOS `script` has no -e/-c, so the
# probe fails there and T50 skips, which is the portable outcome.
if command -v script >/dev/null 2>&1 && script -qec 'true' /dev/null >/dev/null 2>&1; then
test.case - "T50: live terminal wins over stale LOG_DEVICE, explicit file respected" \
  test.log.liveTtyWinsOverStale
expect 0 "stale terminal refreshed, explicit file kept" \
  "log refreshes a stale terminal device but respects an explicit non-terminal one"
else
  expect.pass "T50 skipped: no util-linux script / pty on this host"
fi

# ============================================================================
# Cleanup
# ============================================================================
cleanup.testFiles


