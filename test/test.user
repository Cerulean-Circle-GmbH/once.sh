#!/usr/bin/env bash
# Tests for user — OOSH user and SSH identity management
# Tests: id, list, list.all, list.groups, get.current.identity, ssh.status,
#        list.other.identities, ssh.backup / ssh.restore / ssh.backup.list
TEST_CATEGORY=core

level=$1
if [ -z "$level" ]; then
  level=1
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

# ============================================================================
# T1: user is callable
# ============================================================================
test.case $level "user is callable" \
  command -v user

if command -v user >/dev/null 2>&1; then
  expect.pass "user found on PATH"
else
  expect.fail "user should be on PATH"
fi

# ============================================================================
# T2: user.id returns current user id
# ============================================================================
test.case $level "user.id returns user id" \
  bash -c 'source this; source user; user.id -u -n'

ID_OUTPUT=$(bash -c 'source this; source user; user.id -u -n 2>/dev/null')
if [ "$ID_OUTPUT" = "$(id -u -n)" ]; then
  expect.pass "user.id -u -n returns $(id -u -n)"
else
  expect.fail "user.id -u -n should return $(id -u -n), got: $ID_OUTPUT"
fi

# ============================================================================
# T3: user.list returns users (filters _ prefixed)
# ============================================================================
test.case $level "user.list returns users" \
  bash -c 'source this; source user; user.list'

LIST_OUTPUT=$(bash -c 'source this; source user; user.list 2>/dev/null')
if [ -n "$LIST_OUTPUT" ]; then
  expect.pass "user.list returned users"
else
  expect.fail "user.list should return at least one user"
fi

# ============================================================================
# T4: user.list.all returns all users including system
# ============================================================================
test.case $level "user.list.all returns all users" \
  bash -c 'source this; source user; user.list.all'

ALL_OUTPUT=$(bash -c 'source this; source user; user.list.all 2>/dev/null')
if [ -n "$ALL_OUTPUT" ]; then
  # list.all should have >= list (includes _ prefixed)
  ALL_COUNT=$(echo "$ALL_OUTPUT" | wc -l | tr -d ' ')
  expect.pass "user.list.all returned $ALL_COUNT users"
else
  expect.fail "user.list.all should return users"
fi

# ============================================================================
# T5: user.list.groups returns groups
# ============================================================================
test.case $level "user.list.groups returns groups" \
  bash -c 'source this; source user; user.list.groups'

GROUPS_OUTPUT=$(bash -c 'source this; source user; user.list.groups 2>/dev/null')
if [ -n "$GROUPS_OUTPUT" ]; then
  expect.pass "user.list.groups returned groups"
else
  expect.fail "user.list.groups should return at least one group"
fi

# ============================================================================
# T6: user.get.current.identity returns SSH dir
# ============================================================================
test.case $level "user.get.current.identity returns SSH dir" \
  bash -c 'source this; source ossh; source user; user.get.current.identity'

IDENTITY_OUTPUT=$(bash -c 'source this; source ossh; source user; user.get.current.identity 2>/dev/null')
if [ -n "$IDENTITY_OUTPUT" ]; then
  if [ -d "$IDENTITY_OUTPUT" ]; then
    expect.pass "user.get.current.identity returned valid dir: $IDENTITY_OUTPUT"
  else
    expect.fail "user.get.current.identity returned non-existent dir: $IDENTITY_OUTPUT"
  fi
else
  expect.fail "user.get.current.identity should return a path"
fi

# ============================================================================
# T7: user.ssh.status returns 0 when SSH is configured
# ============================================================================
test.case $level "user.ssh.status returns 0 when SSH configured" \
  bash -c 'source this; source ossh; source user; user.ssh.status'

bash -c 'source this; source ossh; source user; user.ssh.status 2>/dev/null'
SSH_RC=$?
if [ -d "$HOME/.ssh" ]; then
  if [ $SSH_RC -eq 0 ]; then
    expect.pass "user.ssh.status returns 0 (SSH configured)"
  else
    expect.fail "user.ssh.status should return 0 when ~/.ssh exists (got $SSH_RC)"
  fi
else
  if [ $SSH_RC -ne 0 ]; then
    expect.pass "user.ssh.status returns non-zero (no ~/.ssh)"
  else
    expect.fail "user.ssh.status should return non-zero when ~/.ssh missing"
  fi
fi

# ============================================================================
# T8: user.id.completion returns valid options
# ============================================================================
test.case $level "user.id.completion returns options" \
  bash -c 'source this; source user; user.id.completion'

COMP_OUTPUT=$(bash -c 'source this; source user; user.id.completion 2>/dev/null')
if echo "$COMP_OUTPUT" | grep -q '\-u'; then
  expect.pass "user.id.completion includes -u flag"
else
  expect.fail "user.id.completion should include -u flag"
fi

# ============================================================================
# T9: user.list filters underscore-prefixed users
# ============================================================================
test.case $level "user.list filters _ prefixed system users" \
  bash -c 'source this; source user; user.list'

FILTERED=$(bash -c 'source this; source user; user.list 2>/dev/null' | grep '^_' || true)
if [ -z "$FILTERED" ]; then
  expect.pass "user.list correctly filters _ prefixed users"
else
  expect.fail "user.list should not contain _ prefixed users, found: $(echo "$FILTERED" | head -1)"
fi

echo ""
echo "test.user complete"

# ============================================================================
# Password-handling tests (user.create password keyword + user.password.set)
# Guarded: skipped if sudo -n is not available (no passwordless sudo).
# All created accounts are cleaned up with user.delete.linux (cross-platform).
# ============================================================================

if sudo -n true 2>/dev/null; then

  # Source the methods we're testing so we can invoke them directly in this shell
  source this
  source user
  os.check.env

  # Platform-specific helper: returns 0 if the given user has a password hash set
  user.test.hasPassword() {
    local u="$1"
    if [ "$OOSH_OS" = "darwin" ]; then
      sudo dscl . -read "/Users/$u" AuthenticationAuthority 2>/dev/null | grep -q ';ShadowHash;'
    else
      # GNU & BusyBox /etc/shadow: field 2 is the hash; '!' or '*' (or empty) means locked
      local field2
      field2=$(sudo grep -E "^$u:" /etc/shadow 2>/dev/null | cut -d: -f2)
      [ -n "$field2" ] && [ "$field2" != "!" ] && [ "$field2" != "*" ] && [ "$field2" != "!!" ]
    fi
  }

  # --------------------------------------------------------------------------
  # T-a: user.create with explicit password sets the password
  # --------------------------------------------------------------------------
  test.case $level "user.create ooshTestA password secretA sets password" \
    bash -c 'source this; source user; user.create ooshTestA password secretA >/dev/null 2>&1; id ooshTestA'

  user.delete.linux ooshTestA >/dev/null 2>&1  # ensure clean slate
  user.create ooshTestA password secretA >/dev/null 2>&1
  if id ooshTestA >/dev/null 2>&1 && user.test.hasPassword ooshTestA; then
    expect.pass "ooshTestA created and password is set"
  else
    expect.fail "ooshTestA should exist with a password hash"
  fi
  user.delete.linux ooshTestA >/dev/null 2>&1

  # --------------------------------------------------------------------------
  # T-b: user.create defaults password to username
  # --------------------------------------------------------------------------
  test.case $level "user.create ooshTestB defaults password to username" \
    bash -c 'source this; source user; user.create ooshTestB >/dev/null 2>&1; id ooshTestB'

  user.delete.linux ooshTestB >/dev/null 2>&1
  user.create ooshTestB >/dev/null 2>&1
  if id ooshTestB >/dev/null 2>&1 && user.test.hasPassword ooshTestB; then
    expect.pass "ooshTestB created and default password (username) is set"
  else
    expect.fail "ooshTestB should exist with a password hash"
  fi
  user.delete.linux ooshTestB >/dev/null 2>&1

  # --------------------------------------------------------------------------
  # T-c: explicit empty password is a no-op (account stays locked)
  # --------------------------------------------------------------------------
  test.case $level "user.create ooshTestC password '' leaves account locked" \
    bash -c 'source this; source user; user.create ooshTestC password "" >/dev/null 2>&1; id ooshTestC'

  user.delete.linux ooshTestC >/dev/null 2>&1
  user.create ooshTestC password "" >/dev/null 2>&1
  if id ooshTestC >/dev/null 2>&1 && ! user.test.hasPassword ooshTestC; then
    expect.pass "ooshTestC created with no password (locked) — back-compat preserved"
  else
    expect.fail "ooshTestC should exist with no password hash"
  fi
  user.delete.linux ooshTestC >/dev/null 2>&1

  # --------------------------------------------------------------------------
  # T-d: user.password.set resets an existing user's password
  # --------------------------------------------------------------------------
  test.case $level "user.password.set resets ooshTestD's password" \
    bash -c 'source this; source user; user.create ooshTestD password "" >/dev/null 2>&1; user.password.set ooshTestD freshPw >/dev/null 2>&1'

  user.delete.linux ooshTestD >/dev/null 2>&1
  user.create ooshTestD password "" >/dev/null 2>&1
  user.password.set ooshTestD freshPw >/dev/null 2>&1
  if user.test.hasPassword ooshTestD; then
    expect.pass "user.password.set populated ooshTestD's password hash"
  else
    expect.fail "user.password.set should populate the password hash"
  fi
  user.delete.linux ooshTestD >/dev/null 2>&1

  # --------------------------------------------------------------------------
  # T-e2: short username (≤3 chars) still produces a usable account
  # Exercises the darwin auto-pad branch; on Linux the short password passes
  # chpasswd directly. Either way the created user should have password metadata.
  # --------------------------------------------------------------------------
  test.case $level "user.create bo (short name) produces a user with password" \
    bash -c 'source this; source user; user.create bo >/dev/null 2>&1; id bo'

  user.delete.linux bo >/dev/null 2>&1
  user.create bo >/dev/null 2>&1
  if id bo >/dev/null 2>&1 && user.test.hasPassword bo; then
    expect.pass "short-username 'bo' created with a valid password"
  else
    expect.fail "short-username 'bo' should be creatable with the default-password auto-pad on darwin / chpasswd on Linux"
  fi
  user.delete.linux bo >/dev/null 2>&1

  unset -f user.test.hasPassword

else
  # Skipped path — keep the run green on envs without passwordless sudo
  test.case $level "password tests skipped (no passwordless sudo)" \
    true
  expect.pass "skipped — 'sudo -n' not available"
fi

# ============================================================================
# user.oosh.install — always-runnable negative paths (positive path is E2E)
# ============================================================================

source this
source user

# T-e: missing username → error + non-zero
test.case $level "user.oosh.install with no args returns non-zero" \
  bash -c 'source this; source user; user.oosh.install 2>/dev/null'

bash -c 'source this; source user; user.oosh.install 2>/dev/null'
if [ $? -ne 0 ]; then
  expect.pass "user.oosh.install returns non-zero when username missing"
else
  expect.fail "user.oosh.install should fail without a username"
fi

# T-f: nonexistent user → home-lookup fails → non-zero
test.case $level "user.oosh.install for unknown user returns non-zero" \
  bash -c 'source this; source user; user.oosh.install __ooshNoSuchUser__ dev 2>/dev/null'

bash -c 'source this; source user; user.oosh.install __ooshNoSuchUser__ dev 2>/dev/null'
if [ $? -ne 0 ]; then
  expect.pass "user.oosh.install fails on unknown user"
else
  expect.fail "user.oosh.install should fail for a non-existent user"
fi

# T-g: os.check dispatches the shell-change helper to a real function
test.case $level "os.check resolves user.oosh.install.shell to a defined function" \
  bash -c 'source this; source os; source user; os.check private.user.oosh.install.shell && type -t "$RESULT"'

RESOLVED=$(bash -c 'source this; source os; source user; if os.check private.user.oosh.install.shell; then echo "$RESULT"; fi' 2>/dev/null)
if [ "$RESOLVED" = "private.user.oosh.install.shell.darwin" ] || [ "$RESOLVED" = "private.user.oosh.install.shell.linux" ]; then
  expect.pass "os.check resolves to '$RESOLVED'"
else
  expect.fail "os.check should resolve to .darwin or .linux variant, got: '$RESOLVED'"
fi

# T-USER-INSTALL-NODE: every user who gets oosh gets nvm + node + npm (su/setup)
# State 50 runs once, at the machine install; oosh-user and bash-user came
# later and had no node (platform container, 2026-10-14). user.oosh.install is
# the step every user goes through. A failure there is a warning, never a
# failed install — the same rule as state 50.
test.user.installNode() {
  local fx bad="" out
  fx=$(test.suite.fixture.make usernode)
  test.user.installNode.run() { # <T_FAIL> <code before the call>
    : > "$fx/log"
    FX="$fx" T_FAIL="$1" bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
      setup.nodejs() { echo "setup.nodejs [$1] $2" >> "$FX/log"; [ "$T_FAIL" = nodejs ] && { create.result 1 "node broke"; return 1; }; create.result 0 ok; }
      setup.npm() { echo "setup.npm $1" >> "$FX/log"; create.result 0 ok; }
      '"$2"'
      private.user.oosh.install.node alice >/dev/null 2>&1; echo "rc=$?"' </dev/null 2>/dev/null | tail -1
  }
  out=$(test.user.installNode.run "" ":")
  [ "$out|$(tr '\n' '|' < "$fx/log")" = "rc=0|setup.nodejs [] alice|setup.npm alice|" ] || bad="$bad ok=[$out|$(tr '\n' '|' < "$fx/log")]"
  out=$(test.user.installNode.run nodejs ":")
  [ "$out" = "rc=0" ] || bad="$bad nodeFails=[$out]"
  out=$(test.user.installNode.run "" "unset -f setup.nodejs setup.npm; private.this.script.load() { return 1; }")
  [ "$out" = "rc=0" ] && [ ! -s "$fx/log" ] || bad="$bad noSetup=[$out|$(tr '\n' '|' < "$fx/log")]"
  bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1; type user.oosh.install' 2>/dev/null \
    | grep -q 'private.user.oosh.install.node' || bad="$bad notCalled"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "user oosh.install gives the user node + npm; a failure never fails the install" || create.result 1 "install node:$bad"
  return $(result)
}
test.case $level "T-USER-INSTALL-NODE: every user who gets oosh gets node + npm" test.user.installNode
expect 0 "user oosh.install gives the user node + npm; a failure never fails the install" \
  "oosh-user and bash-user had no node: state 50 runs once, before they exist"

# T-h: completion lists the current host's worktree branches (non-empty when OOSH_DIR is set)
test.case $level "user.oosh.install.completion.branch emits candidates" \
  bash -c 'source this; source user; user.oosh.install.completion.branch'

BRANCHES=$(bash -c 'source this; source user; user.oosh.install.completion.branch 2>/dev/null')
if [ -n "$BRANCHES" ]; then
  expect.pass "branch completion returned: $(echo "$BRANCHES" | head -1 | tr -d '\n')…"
else
  # Not a hard failure — on some envs OOSH_DIR may not sit in a worktree-style layout
  expect.pass "branch completion returned empty (acceptable on non-worktree layouts)"
fi

# ============================================================================
# T-USER-INIT-SELF-HEAL: private.user.init fills in missing OS_CMD_* vars
# when os.commands.env was saved incomplete (e.g. private.check.pm wrote it
# during install before USER_MOD / USER_DEL were computed). Reproduces the
# hetzsim bug where `user.group.add dev bob` silently degraded and bob
# never joined `dev`, breaking write access to log.live.out.
#
# CRITICAL: private.user.init transitively calls `config save`, which
# writes to $CONFIG (NOT just $CONFIG_PATH). If we only override
# CONFIG_PATH here, config save still hits the real user.env and can
# poison it with the temp path. Run the whole helper inside a bash -c
# subshell where BOTH CONFIG and CONFIG_PATH are redirected to the
# throw-away dir. Results are captured via files written to that dir,
# not via env vars that would leak back.
# ============================================================================
TUSR_SELF_HEAL=$(mktemp -d)
cat > "$TUSR_SELF_HEAL/os.commands.env" <<'EOF'
export declare OS_CMD_GROUP_ADD="groupadd -f"
export declare OS_CMD_USER_ADD="useradd -g dev"
EOF

# Run in a fully-isolated subshell: fresh CONFIG + CONFIG_PATH pointing at
# the temp dir, private.user.init fires, we capture the resulting
# OS_CMD_USER_MOD / OS_CMD_USER_DEL values into files we can grep from
# the outer shell. No exports leak back to the caller's env.
bash -c '
  export CONFIG_PATH="'"$TUSR_SELF_HEAL"'"
  export CONFIG="'"$TUSR_SELF_HEAL"'/user.env"
  : > "$CONFIG"
  unset OS_CMD_USER_MOD OS_CMD_USER_DEL OS_CMD_USER_ADD OS_CMD_GROUP_ADD
  # OOSH_PM_UPDATED is the mechanism oo itself uses to say "the package index
  # has already been refreshed" (oo.cmd). Discovery only records the package
  # manager; the refresh belongs to oo.cmd, once before its first real install.
  # Without the variable, a real install here would run `$SUDO apt-get update`,
  # which reads the TTY directly: the >/dev/null 2>&1 below cannot suppress a
  # password prompt, so the whole file blocked forever on any host without
  # passwordless sudo. That is why test.user could never join `core`.
  export OOSH_PM_UPDATED="test fixture — no package index refresh here"
  source "'"$OOSH_DIR"'/user" >/dev/null 2>&1 || true
  private.user.init >/dev/null 2>&1 || true
  printf "%s" "$OS_CMD_USER_MOD" > "'"$TUSR_SELF_HEAL"'/.result.USER_MOD"
  printf "%s" "$OS_CMD_USER_DEL" > "'"$TUSR_SELF_HEAL"'/.result.USER_DEL"
' >/dev/null 2>&1 || true

_HEAL_USER_MOD=$(cat "$TUSR_SELF_HEAL/.result.USER_MOD" 2>/dev/null)
_HEAL_USER_DEL=$(cat "$TUSR_SELF_HEAL/.result.USER_DEL" 2>/dev/null)

test.case $level "T-USER-INIT-SELF-HEAL: fills missing OS_CMD_USER_MOD" \
  echo "OS_CMD_USER_MOD=$_HEAL_USER_MOD"
if [ -n "$_HEAL_USER_MOD" ]; then
  expect.pass "OS_CMD_USER_MOD filled in: $_HEAL_USER_MOD"
else
  expect.fail "OS_CMD_USER_MOD still empty after private.user.init (self-heal broken)"
fi

test.case $level "T-USER-INIT-SELF-HEAL: fills missing OS_CMD_USER_DEL" \
  echo "OS_CMD_USER_DEL=$_HEAL_USER_DEL"
if [ -n "$_HEAL_USER_DEL" ]; then
  expect.pass "OS_CMD_USER_DEL filled in: $_HEAL_USER_DEL"
else
  expect.fail "OS_CMD_USER_DEL still empty after private.user.init"
fi

test.case $level "T-USER-INIT-SELF-HEAL: re-saves os.commands.env with complete set" \
  echo "(grep re-saved file)"
if grep -q 'OS_CMD_USER_MOD' "$TUSR_SELF_HEAL/os.commands.env" \
   && grep -q 'OS_CMD_USER_DEL' "$TUSR_SELF_HEAL/os.commands.env"; then
  expect.pass "os.commands.env re-saved with all four OS_CMD_* vars"
else
  expect.fail "os.commands.env not re-saved with complete set — future sessions still broken"
fi

test.case $level "T-USER-INIT-SELF-HEAL-ISOLATION: outer CONFIG_PATH unchanged" \
  echo "CONFIG_PATH=$CONFIG_PATH"
if [ "$CONFIG_PATH" != "$TUSR_SELF_HEAL" ] \
   && ! grep -qE 'CONFIG_PATH="/tmp/tmp\.' "$CONFIG" 2>/dev/null; then
  expect.pass "subshell isolation worked — outer CONFIG and user.env untouched"
else
  expect.fail "test poisoned outer config — CONFIG_PATH or user.env now references the temp dir"
fi

rm -rf "$TUSR_SELF_HEAL"

# ============================================================================
# T-PRIVATE-AS-USER-DISPATCH: private.as.user must try runuser FIRST (works
# without sudo when caller is root), then sudo -H -u (most distros), then
# su -s /bin/bash - … -c (root + no sudo, e.g. minimal containers). The
# dispatch order matters: runuser is the only path that doesn't need sudo
# at all, so it must precede sudo. su is last-resort. Reversing this would
# silently break sudo-less containers like naked alpine before sudo install.
# ============================================================================
source "$OOSH_DIR/user" >/dev/null 2>&1 || true

test.case $level "T-PRIVATE-AS-USER-DISPATCH: runuser → sudo → su fallback chain in correct order" \
  echo "(grep)"
PAU_BODY=$(declare -f private.as.user 2>/dev/null)
if printf "%s" "$PAU_BODY" | grep -qE 'runuser.*-u' \
   && printf "%s" "$PAU_BODY" | grep -qE 'sudo.*-H.*-u' \
   && printf "%s" "$PAU_BODY" | grep -qE 'su.*-s.*/bin/bash'; then
  # Verify ORDER: runuser line must appear before sudo, sudo before su.
  # Use word boundaries (\b) so 'command -v su' doesn't match 'command -v sudo'.
  _runLn=$(printf "%s" "$PAU_BODY" | grep -nE 'command -v runuser\b' | head -1 | cut -d: -f1)
  _sudoLn=$(printf "%s" "$PAU_BODY" | grep -nE 'command -v sudo\b' | head -1 | cut -d: -f1)
  _suLn=$(printf "%s" "$PAU_BODY" | grep -nE 'command -v su\b' | head -1 | cut -d: -f1)
  if [ -n "$_runLn" ] && [ -n "$_sudoLn" ] && [ -n "$_suLn" ] \
     && [ "$_runLn" -lt "$_sudoLn" ] && [ "$_sudoLn" -lt "$_suLn" ]; then
    expect.pass "private.as.user dispatch chain order: runuser → sudo → su"
  else
    expect.fail "private.as.user dispatch order wrong — runuser must precede sudo, sudo must precede su"
  fi
else
  expect.fail "private.as.user missing one of runuser/sudo/su dispatches — sudo-less containers will break"
fi

# ============================================================================
# T-SSH-BACKUP-* : the archive is $HOME-anchored, and cannot nest
# ============================================================================
# The old body was `cp -R $sshDir ssh.$name` — a CWD-RELATIVE destination —
# while its callers guarded on the ABSOLUTE $HOME/ssh.<name>. Nothing tested
# either method, which is how three root-owned copies of root's ~/.ssh ended
# up in a normal user's home on the dev box.
#
# Every case below runs in a `bash -c` with its OWN $HOME and its cwd
# deliberately somewhere else, because cwd is the whole point.
TUSR_SSH_TMP=$(test.suite.fixture.make test.user.ssh)
trap 'rm -rf "$TUSR_SSH_TMP" 2>/dev/null' EXIT

private.test.user.ssh.run() { # <command...> # run <command> with a fresh $HOME and cwd elsewhere; echo its stdout
  cd "$TUSR_SSH_TMP/elsewhere" 2>/dev/null || return 1
  HOME="$TUSR_SSH_TMP/home" CURRENT_SSH_DIR="" bash -c '
    source "'"$OOSH_DIR"'/this" >/dev/null 2>&1
    source "'"$OOSH_DIR"'/user" >/dev/null 2>&1
    unset CURRENT_SSH_DIR
    '"$*"'
  ' 2>/dev/null
  local rc=$?
  cd "$OOSH_DIR" || true
  return $rc
}

private.test.user.ssh.fixture() { # # rebuild a fresh fixture home + an empty cwd
  rm -rf "$TUSR_SSH_TMP/home" "$TUSR_SSH_TMP/elsewhere"
  mkdir -p "$TUSR_SSH_TMP/home/.ssh" "$TUSR_SSH_TMP/elsewhere"
  echo "original-key" > "$TUSR_SSH_TMP/home/.ssh/id_probe"
}

# --- the card's own "Done when" -------------------------------------------
test.user.sshBackupIsHomeAnchored() {
  private.test.user.ssh.fixture
  private.test.user.ssh.run 'user.ssh.backup probe >/dev/null' >/dev/null
  local inCwd inHome
  inCwd=$(ls -A "$TUSR_SSH_TMP/elsewhere" 2>/dev/null | grep -c .)
  inHome=$(ls -1d "$TUSR_SSH_TMP/home/.ssh.backups"/*-probe 2>/dev/null | grep -c .)
  if [ "$inCwd" != "0" ]; then
    create.result 1 "it wrote $inCwd entr(ies) into the current directory"
  elif [ "$inHome" != "1" ]; then
    create.result 1 "expected exactly 1 archive under \$HOME/.ssh.backups, found $inHome"
  else
    create.result 0 "archived under \$HOME"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-ANCHORED: the archive lands under \$HOME, never in the current directory" \
  test.user.sshBackupIsHomeAnchored
expect 0 "archived under \$HOME" "cwd-relative is how root's keys ended up in a user's home"

# --- repeat runs must not nest ---------------------------------------------
test.user.sshBackupDoesNotNest() {
  private.test.user.ssh.fixture
  private.test.user.ssh.run 'user.ssh.backup probe >/dev/null; user.ssh.backup probe >/dev/null' >/dev/null
  local archives nested
  archives=$(ls -1d "$TUSR_SSH_TMP/home/.ssh.backups"/*-probe* 2>/dev/null | grep -c .)
  nested=$(find "$TUSR_SSH_TMP/home/.ssh.backups" -name .ssh -type d 2>/dev/null | grep -c .)
  if [ "$nested" != "0" ]; then
    create.result 1 "the second run nested inside the first ($nested nested .ssh)"
  elif [ "$archives" != "2" ]; then
    create.result 1 "expected 2 distinct archives, found $archives"
  else
    create.result 0 "two archives, neither nested"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-NO-NEST: a second backup makes a second archive, not a nested copy" \
  test.user.sshBackupDoesNotNest
expect 0 "two archives, neither nested" "cp -R into an existing directory copies INTO it — each install nested one level deeper"

# --- nothing to archive is a refusal, not a silent success ------------------
test.user.sshBackupRefusesMissingDir() {
  private.test.user.ssh.fixture
  rm -rf "$TUSR_SSH_TMP/home/.ssh"
  private.test.user.ssh.run 'user.ssh.backup probe >/dev/null' >/dev/null
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success with no ~/.ssh to archive"
  elif [ -d "$TUSR_SSH_TMP/home/.ssh.backups" ]; then
    create.result 1 "it created an archive root for an archive it could not make"
  else
    create.result 0 "refused"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-NO-SOURCE: no ~/.ssh is a refusal, not an empty archive" \
  test.user.sshBackupRefusesMissingDir
expect 0 "refused" "a backup that silently archives nothing is worse than no backup"

# --- restore must never destroy first ---------------------------------------
test.user.sshRestoreKeepsSshOnMissingArchive() {
  private.test.user.ssh.fixture
  private.test.user.ssh.run 'user.ssh.restore doesNotExist >/dev/null' >/dev/null
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success for an archive that does not exist"
  elif [ ! -f "$TUSR_SSH_TMP/home/.ssh/id_probe" ]; then
    create.result 1 "it destroyed ~/.ssh before discovering it had nothing to restore"
  else
    create.result 0 "~/.ssh untouched"
  fi
  return $(result)
}
test.case $level "T-SSH-RESTORE-SAFE: a missing archive leaves ~/.ssh intact" \
  test.user.sshRestoreKeepsSshOnMissingArchive
expect 0 "~/.ssh untouched" "the old body ran rm -Rf \$sshDir BEFORE a cwd-relative cp — from the wrong directory it destroyed ~/.ssh"

# --- and it must actually restore ------------------------------------------
test.user.sshRestoreRoundTrip() {
  private.test.user.ssh.fixture
  private.test.user.ssh.run 'user.ssh.backup probe >/dev/null' >/dev/null
  echo "corrupted" > "$TUSR_SSH_TMP/home/.ssh/id_probe"
  private.test.user.ssh.run 'user.ssh.restore latest >/dev/null' >/dev/null
  local content
  content=$(cat "$TUSR_SSH_TMP/home/.ssh/id_probe" 2>/dev/null)
  if [ "$content" = "original-key" ]; then
    create.result 0 "restored"
  else
    create.result 1 "got '$content', expected 'original-key'"
  fi
  return $(result)
}
test.case $level "T-SSH-RESTORE-ROUNDTRIP: backup then restore latest brings the content back" \
  test.user.sshRestoreRoundTrip
expect 0 "restored" "an archive nobody can restore is not a backup"

# --- the archives are discoverable -----------------------------------------
test.user.sshBackupList() {
  private.test.user.ssh.fixture
  private.test.user.ssh.run 'user.ssh.backup one >/dev/null; user.ssh.backup two >/dev/null' >/dev/null
  local out
  out=$(private.test.user.ssh.run 'user.ssh.backup.list')
  local lines
  # grep -cE, not a BRE with \| — GNU treats \| as alternation, BSD grep does NOT
  # (it is a GNU extension), so on macOS this counted 0 and the test failed while
  # user.ssh.backup.list was working perfectly. POSIX ERE alternation is portable.
  lines=$(printf '%s\n' "$out" | grep -cE -- '-(one|two)$')
  if [ "$lines" = "2" ]; then
    create.result 0 "both listed"
  else
    create.result 1 "expected 2 archives listed, got: $out"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-LIST: the archives can be found again" \
  test.user.sshBackupList
expect 0 "both listed" "ssh.backup.list is how a human reaches an archive without knowing the timestamp"

# ============================================================================
# T-SSH-BACKUP-LEGACY-*: finding and moving what the old code already left
# ============================================================================
# The real subject is three root-owned 0700 directories in /home/hannesn. The
# fixture plants the same shapes, plus the two things the sweep must NOT take:
# the new archive root, and ~/.ssh/ids/ssh.* which osshLayout owns under the
# same prefix.
private.test.user.ssh.legacy.fixture() { # # plant legacy artefacts and two decoys
  private.test.user.ssh.fixture
  mkdir -p "$TUSR_SSH_TMP/home/ssh.original"
  mkdir -p "$TUSR_SSH_TMP/home/ssh.root.hostA.for.hostB"
  mkdir -p "$TUSR_SSH_TMP/home/.ssh.backups/20260101T000000Z-manual"   # decoy: the new root
  mkdir -p "$TUSR_SSH_TMP/home/.ssh/ids/ssh.developking"               # decoy: osshLayout's
}

test.user.sshBackupStatusFindsLegacy() {
  private.test.user.ssh.legacy.fixture
  local out
  out=$(private.test.user.ssh.run 'user.ssh.backup.status "$HOME"' 2>/dev/null)
  local rc=$?
  case "$out" in
    *"INVALID: 2 legacy"*) : ;;
    *) create.result 1 "expected 2 legacy artefacts, got: $out"; return $(result) ;;
  esac
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it found artefacts but returned 0"
  else
    create.result 0 "2 found, rc 1"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-LEGACY-FINDS: the legacy ssh.* directories are reported, and the decoys are not" \
  test.user.sshBackupStatusFindsLegacy
expect 0 "2 found, rc 1" ".ssh.backups and .ssh/ids/ssh.* share the prefix and must survive the sweep"

test.user.sshBackupStatusCleanIsQuiet() {
  private.test.user.ssh.fixture
  local out
  out=$(private.test.user.ssh.run 'user.ssh.backup.status "$HOME"' 2>/dev/null)
  local rc=$?
  case "$out" in
    *"OK: no legacy"*) [ "$rc" -eq 0 ] && create.result 0 "clean" || create.result 1 "clean verdict but rc=$rc" ;;
    *)                 create.result 1 "expected a clean verdict, got: $out" ;;
  esac
  return $(result)
}
test.case $level "T-SSH-BACKUP-LEGACY-CLEAN: a home with no legacy artefacts reports clean and rc 0" \
  test.user.sshBackupStatusCleanIsQuiet
expect 0 "clean" "a guard that always fires is as useless as one that never does"

test.user.sshBackupMigrateMoves() {
  private.test.user.ssh.legacy.fixture
  private.test.user.ssh.run 'user.ssh.backup.migrate "$HOME" >/dev/null' >/dev/null
  local left movedOriginal decoyArchive decoyIds
  left=$(ls -1d "$TUSR_SSH_TMP/home"/ssh.* 2>/dev/null | grep -c .)
  movedOriginal=$([ -d "$TUSR_SSH_TMP/home/.ssh.backups/legacy/ssh.original" ] && echo yes || echo no)
  decoyArchive=$([ -d "$TUSR_SSH_TMP/home/.ssh.backups/20260101T000000Z-manual" ] && echo yes || echo no)
  decoyIds=$([ -d "$TUSR_SSH_TMP/home/.ssh/ids/ssh.developking" ] && echo yes || echo no)
  if [ "$left" != "0" ]; then
    create.result 1 "$left legacy director(ies) still in \$HOME"
  elif [ "$movedOriginal" != "yes" ]; then
    create.result 1 "ssh.original did not arrive under .ssh.backups/legacy"
  elif [ "$decoyArchive" != "yes" ] || [ "$decoyIds" != "yes" ]; then
    create.result 1 "a decoy was taken: archive=$decoyArchive ids=$decoyIds"
  else
    create.result 0 "migrated"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-LEGACY-MIGRATE: the artefacts move under .ssh.backups/legacy, the decoys stay" \
  test.user.sshBackupMigrateMoves
expect 0 "migrated" "they hold private keys — migrate MOVES, it never deletes"

test.user.sshBackupMigrateRefusesOverwrite() {
  private.test.user.ssh.legacy.fixture
  mkdir -p "$TUSR_SSH_TMP/home/.ssh.backups/legacy/ssh.original"
  echo "already here" > "$TUSR_SSH_TMP/home/.ssh.backups/legacy/ssh.original/marker"
  private.test.user.ssh.run 'user.ssh.backup.migrate "$HOME" >/dev/null' >/dev/null
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    create.result 1 "it reported success while refusing to move one"
  elif [ ! -f "$TUSR_SSH_TMP/home/.ssh.backups/legacy/ssh.original/marker" ]; then
    create.result 1 "it overwrote an existing legacy archive"
  else
    create.result 0 "refused to overwrite"
  fi
  return $(result)
}
test.case $level "T-SSH-BACKUP-LEGACY-NO-CLOBBER: an existing legacy archive is never overwritten" \
  test.user.sshBackupMigrateRefusesOverwrite
expect 0 "refused to overwrite" "these directories hold private keys; losing one silently is the worst outcome"



console.log "
Test: T-USER-DEL-CMD
===================================================================="

# ============================================================================
# T-USER-DEL-CMD: the user-delete command is found on shadow AND on busybox
# ============================================================================
# alpine has `deluser` and NO `userdel`. Both private.user.init's OS_CMD heal
# and private.user.delete.linux probed `userdel` alone, so on alpine the cache
# could never complete (two red assertions in every alpine platform run since
# the heal was written on 2026-04-24) and every delete ran
# `/usr/sbin/userdel -rf` and died with ENOENT 127.
#
# The command is stubbed rather than trusted, so this runs the SAME on a
# shadow host and a busybox one — a test that only asserts "something was
# found" passes on the dev box for the wrong reason and says nothing about
# alpine, which is precisely how this survived.
TUSR_DEL_STUB=$(test.suite.fixture.make test.user.delcmd)

private.test.user.delcmd.with() { # <name...> # echo the getter's answer with ONLY these commands on PATH
  rm -f "$TUSR_DEL_STUB"/* 2>/dev/null
  local name
  for name in "$@"; do
    printf '#!/bin/sh\nexit 0\n' > "$TUSR_DEL_STUB/$name"
    chmod +x "$TUSR_DEL_STUB/$name"
  done
  # A PATH with only the stubs on it, AND <sbinDir> pointed at the same empty
  # fixture — both routes have to be controlled or the real /usr/sbin/userdel
  # answers and the busybox branch is never reached on a shadow host.
  ( PATH="$TUSR_DEL_STUB"; private.user.delete.command.get "$TUSR_DEL_STUB" )
}

TUSR_DEL_SHADOW=$(private.test.user.delcmd.with userdel)
test.case $level "T-USER-DEL-CMD: shadow userdel is found, with its remove-home flag" \
  echo "$TUSR_DEL_SHADOW"
case "$TUSR_DEL_SHADOW" in
  *userdel\ -rf) expect.pass "shadow: $TUSR_DEL_SHADOW" ;;
  *)             expect.fail "expected '<path>/userdel -rf', got [$TUSR_DEL_SHADOW]" ;;
esac

TUSR_DEL_BUSYBOX=$(private.test.user.delcmd.with deluser)
test.case $level "T-USER-DEL-CMD: busybox deluser is found when there is no userdel" \
  echo "$TUSR_DEL_BUSYBOX"
case "$TUSR_DEL_BUSYBOX" in
  *deluser\ --remove-home) expect.pass "busybox: $TUSR_DEL_BUSYBOX" ;;
  *)                       expect.fail "expected '<path>/deluser --remove-home', got [$TUSR_DEL_BUSYBOX] — this is the alpine failure" ;;
esac

TUSR_DEL_BOTH=$(private.test.user.delcmd.with userdel deluser)
test.case $level "T-USER-DEL-CMD: shadow wins when both are present" \
  echo "$TUSR_DEL_BOTH"
case "$TUSR_DEL_BOTH" in
  *userdel\ -rf) expect.pass "shadow preferred: $TUSR_DEL_BOTH" ;;
  *)             expect.fail "expected userdel to win, got [$TUSR_DEL_BOTH]" ;;
esac

TUSR_DEL_NONE=$(private.test.user.delcmd.with)
test.case $level "T-USER-DEL-CMD: neither present is an empty answer, not a guess" \
  echo "[$TUSR_DEL_NONE]"
if [ -z "$TUSR_DEL_NONE" ]; then
  expect.pass "no delete command: the caller fails loud instead of running a path that is not there"
else
  expect.fail "expected nothing, got [$TUSR_DEL_NONE]"
fi

rm -rf "$TUSR_DEL_STUB"

# ============================================================================
# T-USER-BASHRC-INSTALL: one .bashrc installer
# ============================================================================
# The oosh .bashrc used to be written by three hand copies (user.oosh.install,
# config.init.user, oo root.installation.done), each with its own condition.
# private.user.bashrc.install <targetHome> <?ooshDir> is the one writer: it
# copies templates/user/bashrcTemplate when ~/.bashrc differs from it, keeps
# the first original as ~/.bashrc.pre-oosh, and creates a .bash_profile that
# sources .bashrc. Idempotent.
test.user.bashrcInstall() {
  local fx bad="" template="$OOSH_DIR/templates/user/bashrcTemplate"; fx=$(test.suite.fixture.make bashrcinstall)
  printf 'mine\n' > "$fx/.bashrc"
  private.user.bashrc.install "$fx" "$OOSH_DIR" >/dev/null 2>&1 || bad="$bad rc=$?"
  cmp -s "$template" "$fx/.bashrc" || bad="$bad not-installed"
  [ "$(cat "$fx/.bashrc.pre-oosh" 2>/dev/null)" = mine ] || bad="$bad no-backup"
  grep -q '\.bashrc' "$fx/.bash_profile" 2>/dev/null || bad="$bad no-bash_profile"
  private.user.bashrc.install "$fx" "$OOSH_DIR" >/dev/null 2>&1 || bad="$bad second-rc=$?"
  cmp -s "$template" "$fx/.bashrc" || bad="$bad second-changed"
  printf 'regressed\n' > "$fx/.bashrc"
  private.user.bashrc.install "$fx" "$OOSH_DIR" >/dev/null 2>&1
  cmp -s "$template" "$fx/.bashrc" || bad="$bad differing-not-repaired"
  [ "$(cat "$fx/.bashrc.pre-oosh" 2>/dev/null)" = mine ] || bad="$bad first-backup-overwritten"
  private.user.bashrc.install "" "$OOSH_DIR" >/dev/null 2>&1 && bad="$bad empty-home-passed"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "bashrc.install: template when different, first original kept, .bash_profile, idempotent" || create.result 1 "bashrc.install:$bad"
  return $(result)
}
test.case $level "T-USER-BASHRC-INSTALL: private.user.bashrc.install is the one .bashrc writer" test.user.bashrcInstall
expect 0 "bashrc.install: template when different, first original kept, .bash_profile, idempotent" \
  "three hand copies with three conditions left boot-sourcing bashrcs behind"

# T-USER-LOGIN-KEEPS-TERM: user login hands the target a clean environment —
# env -i — with ONE exception, TERM, which describes the terminal and not the
# caller. `env -i su - <user>` left TERM=dumb: no colour (git status printed
# plain), and less / vi / clear / tmux degraded. user.login is interactive, so
# the probe runs the method's own `env -i …` line with `env` in place of `su`
# and reads the environment that would be handed over.
test.user.loginKeepsTerm() {
  local bad="" line handed
  line=$(declare -f user.login | grep "env -i")
  [ -n "$line" ] || bad="$bad no-env-i"
  case "$line" in *"su - "*) ;; *) bad="$bad no-login-shell" ;; esac
  case "$line" in *'TERM="$(private.user.login.term.get)"'*) ;; *) bad="$bad term-not-from-the-getter" ;; esac
  handed=$( set -- someUser; TERM=screen-256color; export TERM; export CALLER_LEAK=1
            eval "${line%%su - *} env" 2>/dev/null )
  [ "$handed" = "TERM=screen-256color" ] || bad="$bad handed=[$(printf "%s" "$handed" | tr "\n" " ")]"
  [ "$(TERM=dumb private.user.login.term.get 2>/dev/null)" = xterm-256color ] || bad="$bad dumb"
  [ "$( unset TERM; private.user.login.term.get 2>/dev/null)" = xterm-256color ] || bad="$bad unset"
  [ -z "$bad" ] && create.result 0 "user login hands over TERM and nothing else; dumb or unset becomes xterm-256color" || create.result 1 "login:$bad"
  return $(result)
}
test.case $level "T-USER-LOGIN-KEEPS-TERM: user login passes TERM through env -i and no other caller variable" test.user.loginKeepsTerm
expect 0 "user login hands over TERM and nothing else; dumb or unset becomes xterm-256color" \
  "env -i sh, then user login: the caller's TERM is already dumb — the shell had no colour"


console.log "
Test: T-USER-LOGIN-TERM-GET
===================================================================="

test.user.loginTermGet() {
  local bad=""
  [ "$(TERM=screen-256color private.user.login.term.get)" = screen-256color ] || bad="$bad real-term-changed"
  [ "$(TERM=dumb private.user.login.term.get)" = xterm-256color ] || bad="$bad dumb"
  [ "$(TERM= private.user.login.term.get)" = xterm-256color ] || bad="$bad empty"
  [ -z "$bad" ] && create.result 0 "the caller's TERM, or xterm-256color for dumb/empty" || create.result 1 "term.get:$bad"
  return $(result)
}
test.case $level "T-USER-LOGIN-TERM-GET: private.user.login.term.get keeps a real TERM, replaces dumb and empty" test.user.loginTermGet
expect 0 "the caller's TERM, or xterm-256color for dumb/empty" "env -i sh leaves TERM=dumb for user login to pass on"

# T-PRIVATE-AS-USER-SELF: switching to YOURSELF needs no switch at all. It went
# through `sudo -H -u <me>`, so `config init.user` for the caller's own user
# asked for the sudo password (found on a real host, 2026-09-30). A fake sudo
# first on PATH records any call and fails: the command must still run, as the
# caller, and sudo must never be asked.
test.user.asUserSelf() {
  local fx got; fx=$(test.suite.fixture.make asuserself)
  printf '%s\n' '#!/bin/sh' "echo called > \"$fx/sudo.called\"" 'exit 1' > "$fx/sudo"
  chmod +x "$fx/sudo"
  got=$(PATH="$fx:$PATH" private.as.user "$(id -un)" sh -c 'echo "ran as $(id -un)"' 2>/dev/null)
  if [ "$got" = "ran as $(id -un)" ] && [ ! -e "$fx/sudo.called" ]; then
    create.result 0 "private.as.user: self runs directly, no sudo"
  else
    create.result 1 "private.as.user: got [$got] sudo-called=[$([ -e "$fx/sudo.called" ] && echo yes || echo no)]"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-PRIVATE-AS-USER-SELF: private.as.user for the caller's own user runs directly, never sudo" test.user.asUserSelf
expect 0 "private.as.user: self runs directly, no sudo" \
  "config init.user for yourself asked for the sudo password"

# ============================================================================
# T-USER-OOSH-INSTALL-TRUST: one safeDirectory.ensure hop, no safeDirectory.add
# ============================================================================
# Clone layout (ogit plan, spec § 4): every folder under the base is its own
# repository, so trusting the one $sharedOosh folder (plus its case-canonical
# twin — two safeDirectory.add hops) left main/ and every other folder
# untrusted for the new user. ONE hop through the preamble runs `ogit
# safeDirectory.ensure` on the base. ogit folds the letter case itself (the
# macOS string-match fix the second hop existed for), so user folds nothing by
# hand. Structural: the positive path needs a new user.
TUSR_TRUST_BODY=$(bash -c 'source this; source user; declare -f user.oosh.install' 2>/dev/null)
TUSR_TRUST_ENSURE=$(printf '%s\n' "$TUSR_TRUST_BODY" | grep -c 'safeDirectory.ensure')
TUSR_TRUST_ADD=$(printf '%s\n' "$TUSR_TRUST_BODY" | grep -c 'safeDirectory.add')
TUSR_TRUST_FOLD=$(printf '%s\n' "$TUSR_TRUST_BODY" | grep -c 'private.this.path.case.get')
# declare -f prints the hop's $'\n' as a real newline: the command is on the
# line right after the preamble getter's.
TUSR_TRUST_HOP=$(printf '%s\n' "$TUSR_TRUST_BODY" \
  | grep -F -A1 'private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh"' \
  | grep -cF "'\$sharedOosh/ogit' safeDirectory.ensure '\$(dirname \"\$sharedOosh\")'")
test.case $level "T-USER-OOSH-INSTALL-TRUST: user.oosh.install trusts the base with one ensure hop" \
  echo "ensure=$TUSR_TRUST_ENSURE add=$TUSR_TRUST_ADD hop=$TUSR_TRUST_HOP fold=$TUSR_TRUST_FOLD"
if [ "$TUSR_TRUST_ENSURE" = 1 ] && [ "$TUSR_TRUST_ADD" = 0 ] && [ "$TUSR_TRUST_HOP" = 1 ] && [ "$TUSR_TRUST_FOLD" = 0 ]; then
  expect.pass "one preamble hop runs ogit safeDirectory.ensure on the base; no safeDirectory.add, no hand-folded case left"
else
  expect.fail "expected 1 ensure hop through the preamble on the base, 0 safeDirectory.add and 0 private.this.path.case.get, got ensure=$TUSR_TRUST_ENSURE add=$TUSR_TRUST_ADD hop=$TUSR_TRUST_HOP fold=$TUSR_TRUST_FOLD"
fi

# T-USER-PROMPT-HOST-NAME: the prompt shows the oosh name of the computer after @ too
# [oosh jolly_gagarin] bash-user@jolly_gagarin — a running container's system
# host name is its ID and cannot change; the oosh name can (\h when it is empty).
test.user.promptHostName() {
  local t="$OOSH_DIR/templates/user/bashrcTemplate" bad=""
  [ "$(grep -cF '@\[\e[32m\]\${OOSH_SSH_CONFIG_HOST:-\h}:' "$t")" = 2 ] || bad="$bad oosh-name-after-@"
  grep -qF '@\[\e[32m\]\h:' "$t" && bad="$bad raw-\\h"
  [ -z "$bad" ] && create.result 0 "both prompts show the oosh name after @" || create.result 1 "prompt:$bad"
  return $(result)
}
test.case $level "T-USER-PROMPT-HOST-NAME: the prompt shows the oosh name of the computer after @ too" test.user.promptHostName
expect 0 "both prompts show the oosh name after @" "bash-user@2a1023f6d45b showed the container's ID"

# T-USER-INSTALL-SOCKET-GROUP: the install adds every user to the docker socket's group
# A platform container has the host's socket but no docker program at install
# time, so `command -v docker` skipped the group; the first odocker call then
# needed a new membership — and Alpine has no sg to apply it (2026-10-06).
test.user.installSocketGroup() {
  local fx bad=""; fx=$(test.suite.fixture.make usersocketgroup); : > "$fx/docker.sock"
  FX="$fx" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
    command() { if [ "$1" = -v ] && [ "$2" = docker ]; then return 1; fi; builtin command "$@"; }
    private.odocker.socket.get() { echo "$FX/docker.sock"; }
    private.odocker.socket.group.ensure() { create.result 0 "docker"; return 0; }
    user.group.add() { echo "group.add $*" >> "$FX/log"; }
    private.user.oosh.install.groups.linux someuser >/dev/null 2>&1' >/dev/null 2>&1
  grep -qx 'group.add docker someuser' "$fx/log" 2>/dev/null || bad="$bad not-added=[$(cat "$fx/log" 2>/dev/null)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a user joins the socket's group at install" || create.result 1 "install socket group:$bad"
  return $(result)
}
test.case $level "T-USER-INSTALL-SOCKET-GROUP: the install adds every user to the docker socket's group" test.user.installSocketGroup
expect 0 "a user joins the socket's group at install" "the first odocker call needed a new membership, Alpine has no sg"

# T-USER-INSTALL-SOCKET-GROUP-OVER-DOCKER: with a socket the install joins the socket's group, also when a docker program is there
# An image that ships a docker CLI, with the host's socket mounted under
# another number: the install put every user in the local group docker, which
# does not own the socket (2026-10-06). docker only when there is no socket.
test.user.installSocketGroupOverDocker() {
  local fx bad=""; fx=$(test.suite.fixture.make usersocketoverdocker)
  test.user.installSocketGroupOverDocker.run() { # <socket present: yes|no>
    rm -f "$fx/docker.sock" "$fx/log"; [ "$1" = yes ] && : > "$fx/docker.sock"
    FX="$fx" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
      command() { if [ "$1" = -v ] && [ "$2" = docker ]; then return 0; fi; builtin command "$@"; }
      private.odocker.socket.get() { echo "$FX/docker.sock"; }
      private.odocker.socket.group.ensure() { echo "socket.group.ensure" >> "$FX/log"; create.result 0 "dockerhost"; return 0; }
      user.group.add() { echo "group.add $*" >> "$FX/log"; }
      private.user.oosh.install.groups.linux someuser >/dev/null 2>&1' >/dev/null 2>&1
    grep '^group.add ' "$fx/log" 2>/dev/null | tr '\n' '|'
  }
  [ "$(test.user.installSocketGroupOverDocker.run yes)" = "group.add dockerhost someuser|" ] || bad="$bad socket=[$(test.user.installSocketGroupOverDocker.run yes)]"
  [ "$(test.user.installSocketGroupOverDocker.run no)" = "group.add docker someuser|" ] || bad="$bad no-socket=[$(test.user.installSocketGroupOverDocker.run no)]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the socket's group when a socket is there, docker only without one" || create.result 1 "install socket group over docker:$bad"
  return $(result)
}
test.case $level "T-USER-INSTALL-SOCKET-GROUP-OVER-DOCKER: with a socket the install joins the socket's group, also when docker is installed" test.user.installSocketGroupOverDocker
expect 0 "the socket's group when a socket is there, docker only without one" \
  "an image with a docker CLI put every user in the local docker group, which does not own the socket"

# T-USER-INSTALL-SOCKET-GROUP-ROOT: a docker socket of root's group (number 0) — the install adds the user to no group
# Docker Desktop's socket seen inside a container, a rootful podman or snap
# socket: root:root. odocker's socket.group.ensure answered root and the
# install added the oosh user to it (review, 2026-10-06). The real
# socket.group.ensure decides here; stat and getent answer from the fixture.
test.user.installSocketGroupRoot() {
  local fx bad="" realStat; fx=$(test.suite.fixture.make usersocketroot); : > "$fx/docker.sock"; mkdir -p "$fx/bin"
  realStat=$(command -v stat)
  printf '%s\n' '#!/bin/sh' 'case "$*" in *"$FX/docker.sock") echo 0; exit 0 ;; esac' "exec $realStat \"\$@\"" > "$fx/bin/stat"
  printf '%s\n' '#!/bin/sh' 'case "$2" in 0|root) echo "root:x:0:" ;; *) exit 2 ;; esac' > "$fx/bin/getent"
  chmod +x "$fx/bin/stat" "$fx/bin/getent"
  FX="$fx" ODOCKER_SOCKET="$fx/docker.sock" PATH="$fx/bin:$PATH" bash -c '
    OSTYPE=linux-gnu
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
    command() { if [ "$1" = -v ] && [ "$2" = docker ]; then return 0; fi; builtin command "$@"; }
    user.group.add() { echo "group.add $*" >> "$FX/log"; }
    private.user.oosh.install.groups.linux someuser >/dev/null 2>&1' >/dev/null 2>&1
  [ -s "$fx/log" ] && bad="$bad added=[$(tr '\n' '|' < "$fx/log")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a socket of root's group: the install adds the user to no group" || create.result 1 "install socket of root's group:$bad"
  return $(result)
}
test.case $level "T-USER-INSTALL-SOCKET-GROUP-ROOT: a docker socket of root's group (number 0) — the install adds the user to no group" test.user.installSocketGroupRoot
expect 0 "a socket of root's group: the install adds the user to no group" \
  "a socket owned by root:root made the install add the oosh user to group root"

# T-USER-GROUP-MEMBER-PENDING: a membership this process does not have yet
# odocker re-ran a call under sg whenever the group DATABASE listed the group —
# also when this shell had it already and docker failed for another reason;
# without sg (Alpine) it then said "log out and back in" on every call. $USER
# can be unset under `docker exec`: the user is `id -un` (2026-10-06).
test.user.groupMemberPending() {
  local bad=""
  test.user.groupMemberPending.run() { # <database groups of tester> <groups of this process> <?user>
    ( DB="$1"; PROC="$2"; unset USER
      id() { case "$*" in -un) echo tester ;; -nG) echo "$PROC" ;; "-nG tester") echo "$DB" ;; *) return 1 ;; esac; }
      private.user.group.member.pending docker ${3:+"$3"} ); echo $?
  }
  [ "$(test.user.groupMemberPending.run "tester" "tester")" = 1 ] || bad="$bad not-a-member"
  [ "$(test.user.groupMemberPending.run "tester docker" "tester")" = 0 ] || bad="$bad pending-missed"
  [ "$(test.user.groupMemberPending.run "tester docker" "tester docker")" = 1 ] || bad="$bad effective-is-pending"
  [ "$(test.user.groupMemberPending.run "tester docker" "tester" tester)" = 0 ] || bad="$bad named-user"
  [ "$(test.user.groupMemberPending.run "tester dockerx" "tester")" = 1 ] || bad="$bad partial-name"
  [ -z "$bad" ] && create.result 0 "pending only when the database has the group and this process does not" || create.result 1 "member pending:$bad"
  return $(result)
}
test.case $level "T-USER-GROUP-MEMBER-PENDING: a membership this process does not have yet" test.user.groupMemberPending
expect 0 "pending only when the database has the group and this process does not" \
  "odocker said log out and back in on every call when docker failed for another reason"

# T-USER-GROUP-ADD-IDEMPOTENT: an existing member is left alone — no sudo, no membership command
# user.group.add ran `$SUDO usermod` (Alpine: addgroup, macOS: dseditgroup) also
# for a user who was a member already. config.init.user adds every user to dev
# on every oo update and oo user.fix: a user without passwordless sudo was asked
# for a password each time, for nothing (2026-10-06). Every program it may call
# is a recording stub on a fixture PATH; the group database is a fixture file.
test.user.groupAdd.run() { # <fx> <OS_CMD_USER_MOD> <groups of tester> <existing groups>
  local fx="$1" b="$1/bin" name
  rm -rf "$b" "$fx/calls"; mkdir -p "$b"
  printf '%s\n' "$3" > "$fx/db"; printf '%s\n' $4 > "$fx/groups"
  printf '#!/bin/sh\ncase "$*" in -un) echo tester ;; "-nG tester") cat "$FX/db" ;; *) exec /usr/bin/id "$@" ;; esac\n' > "$b/id"
  printf '#!/bin/sh\nc="${1##*/}"; shift; echo "sudo $c $*" >> "$FX/calls"; exec "$c" "$@"\n' > "$b/sudo"
  printf '#!/bin/sh\necho "usermod $*" >> "$FX/calls"; [ "$1 $2" = "-a -G" ] && echo "$(cat "$FX/db") $3" > "$FX/db"; exit 0\n' > "$b/usermod"
  printf '#!/bin/sh\necho "addgroup $*" >> "$FX/calls"; [ $# = 2 ] && echo "$(cat "$FX/db") $2" > "$FX/db"; exit 0\n' > "$b/addgroup"
  printf '#!/bin/sh\necho "groupadd $*" >> "$FX/calls"; echo "$1" >> "$FX/groups"; exit 0\n' > "$b/groupadd"
  printf '#!/bin/sh\necho "dseditgroup $*" >> "$FX/calls"; exit 0\n' > "$b/dseditgroup"
  printf '#!/bin/sh\n[ "$1" = group ] && grep -qx "$2" "$FX/groups"\n' > "$b/getent"
  printf '#!/bin/sh\ngrep -qx "${3#/Groups/}" "$FX/groups"\n' > "$b/dscl"
  for name in id sudo usermod addgroup groupadd dseditgroup getent dscl; do chmod +x "$b/$name"; done
  FX="$fx" USERMOD="$2" PATH="$b:$PATH" bash -c '
    source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
    export SUDO="sudo " OOSH_OS=linux-gnu OS_CMD_USER_MOD="$USERMOD" OS_CMD_GROUP_ADD=groupadd
    user.group.add ooshtestgrp tester >/dev/null 2>&1; echo "rc=$?" >> "$FX/calls"
    user.group.add ooshtestgrp tester >/dev/null 2>&1; echo "rc=$?" >> "$FX/calls"' >/dev/null 2>&1
  tr '\n' '|' < "$fx/calls" 2>/dev/null
}
test.user.groupAddIdempotent() {
  local fx bad="" got; fx=$(test.suite.fixture.make usergroupadd)
  got=$(test.user.groupAdd.run "$fx" "usermod -a -G" "tester ooshtestgrp" "ooshtestgrp")
  [ "$got" = "rc=0|rc=0|" ] || bad="$bad member=[$got]"
  got=$(test.user.groupAdd.run "$fx" "usermod -a -G" "tester" "ooshtestgrp")
  [ "$got" = "sudo usermod -a -G ooshtestgrp tester|usermod -a -G ooshtestgrp tester|rc=0|rc=0|" ] || bad="$bad usermod=[$got]"
  got=$(test.user.groupAdd.run "$fx" "addgroup" "tester" "ooshtestgrp")
  [ "$got" = "sudo addgroup tester ooshtestgrp|addgroup tester ooshtestgrp|rc=0|rc=0|" ] || bad="$bad alpine=[$got]"
  got=$(test.user.groupAdd.run "$fx" "usermod -a -G" "tester" "")
  [ "$got" = "sudo groupadd ooshtestgrp|groupadd ooshtestgrp|sudo usermod -a -G ooshtestgrp tester|usermod -a -G ooshtestgrp tester|rc=0|rc=0|" ] || bad="$bad new-group=[$got]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a member is left alone, a non-member is added once" || create.result 1 "group.add:$bad"
  return $(result)
}
test.case $level "T-USER-GROUP-ADD-IDEMPOTENT: an existing member is left alone — no sudo, no membership command" test.user.groupAddIdempotent
expect 0 "a member is left alone, a non-member is added once" \
  "config.init.user ran sudo usermod for dev on every oo update — a password prompt for nothing"

# T-USER-GROUP-MEMBER-IS: membership per the group database, whole names only
test.user.groupMemberIs() {
  local bad=""
  test.user.groupMemberIs.run() { # <database groups of tester> <?user>
    ( DB="$1"; unset USER
      id() { case "$*" in -un) echo tester ;; "-nG tester") echo "$DB" ;; *) return 1 ;; esac; }
      private.user.group.member.is docker ${2:+"$2"} ); echo $?
  }
  [ "$(test.user.groupMemberIs.run "tester docker")" = 0 ] || bad="$bad member-missed"
  [ "$(test.user.groupMemberIs.run "tester docker" tester)" = 0 ] || bad="$bad named-user"
  [ "$(test.user.groupMemberIs.run "tester")" = 1 ] || bad="$bad not-a-member"
  [ "$(test.user.groupMemberIs.run "tester dockerx")" = 1 ] || bad="$bad partial-name"
  [ "$(test.user.groupMemberIs.run "tester docker" nobodyelse)" = 1 ] || bad="$bad unknown-user"
  [ -z "$bad" ] && create.result 0 "a member only when the database lists the whole group name" || create.result 1 "member is:$bad"
  return $(result)
}
test.case $level "T-USER-GROUP-MEMBER-IS: membership per the group database, whole names only" test.user.groupMemberIs
expect 0 "a member only when the database lists the whole group name" "user.group.add asked nobody and ran usermod every time"

# T-USER-BASHRC-NO-CMP: without cmp an identical .bashrc is left alone
# cmp is diffutils, which AlmaLinux minimal does not ship: its rc 127 read as
# "differs", and every oo update copied the template over an identical
# .bashrc. The comparison is the kernel's private.this.file.same.
test.user.bashrcNoCmp() {
  local fx bad="" inode out; fx=$(test.suite.fixture.make userbashrcnocmp)
  cp "$OOSH_DIR/templates/user/bashrcTemplate" "$fx/.bashrc"; : > "$fx/.bash_profile"
  touch -t 202001010000 "$fx/.bashrc"; touch -t 202001010100 "$fx/stamp"; inode=$(ls -i "$fx/.bashrc" | cut -d' ' -f1)
  out=$(
    command() { [ "$1 $2" = "-v cmp" ] && return 1; builtin command "$@"; }
    cmp() { return 127; }   # the program is not there
    private.user.bashrc.install "$fx" "$OOSH_DIR" >/dev/null 2>&1; echo "rc=$? $RESULT")
  case "$out" in "rc=0 "*"is the oosh template"*) ;; *) bad="$bad result=[$out]" ;; esac
  [ "$fx/.bashrc" -nt "$fx/stamp" ] && bad="$bad rewritten"
  [ "$(ls -i "$fx/.bashrc" | cut -d' ' -f1)" = "$inode" ] || bad="$bad new-inode"
  [ -e "$fx/.bashrc.pre-oosh" ] && bad="$bad backup-made"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "an identical .bashrc is left alone without cmp" || create.result 1 "bashrc no cmp:$bad"
  return $(result)
}
test.case $level "T-USER-BASHRC-NO-CMP: without cmp an identical .bashrc is left alone" test.user.bashrcNoCmp
expect 0 "an identical .bashrc is left alone without cmp" \
  "AlmaLinux minimal has no cmp — every oo update copied the template over an identical .bashrc"

# T-USER-SOURCE-NO-SUDO: sourcing user without an os.commands.env heals it and calls no sudo
# private.user.init runs oo pm.discover when $CONFIG_PATH/os.commands.env is
# missing or incomplete, and discovery ran "$SUDO apt-get update": merely
# sourcing user asked for a sudo password on an apt host — a new user's first
# shell, every test with an isolated config (2026-10-06). The fixture host has
# a recording apt-get and sudo and no other package manager.
test.user.sourceNoSudo() {
  local fx bad="" name
  fx=$(test.suite.fixture.make usersourcenosudo)
  mkdir -p "$fx/bin" "$fx/config/stateMachines" "$fx/home"
  : > "$fx/calls"; : > "$fx/config/user.env"; : > "$fx/config/result.env"; : > "$fx/config/error.txt"
  printf '#!/bin/sh\necho "sudo $*" >> "$FX/calls"; exec "$@"\n' > "$fx/bin/sudo"
  printf '#!/bin/sh\necho "apt-get $*" >> "$FX/calls"; exit 0\n' > "$fx/bin/apt-get"
  chmod +x "$fx/bin/sudo" "$fx/bin/apt-get"
  test.user.sourceNoSudo.run() {
    FX="$fx" env -u OOSH_NO_INSTALL -u OOSH_PM -u OOSH_PM_UPDATED -u OOSH_APT_UPDATED \
      -u OS_CMD_USER_ADD -u OS_CMD_USER_DEL -u OS_CMD_USER_MOD -u OS_CMD_GROUP_ADD \
      PATH="$fx/bin:$PATH" HOME="$fx/home" SUDO="sudo " CONFIG_PATH="$fx/config" CONFIG_FILE=user.env CONFIG="$fx/config/user.env" bash -c '
        command() {
          if [ "$1" = -v ]; then
            case "$2" in brew|apt-get|dnf|yum|apk|dpkg|pkg|pacman) [ -x "$FX/bin/$2" ] && echo "$FX/bin/$2"; return ;; esac
          fi
          builtin command "$@"
        }
        export -f command
        source "$OOSH_DIR/this" >/dev/null 2>&1; export SUDO="sudo "; source "$OOSH_DIR/user" >/dev/null 2>&1' </dev/null >/dev/null 2>&1
  }
  test.user.sourceNoSudo.run
  [ -s "$fx/calls" ] && bad="$bad first=[$(tr '\n' '|' < "$fx/calls")]"
  for name in OS_CMD_USER_ADD OS_CMD_USER_DEL OS_CMD_USER_MOD OS_CMD_GROUP_ADD; do
    grep -q "$name=" "$fx/config/os.commands.env" 2>/dev/null || bad="$bad no-$name"
  done
  touch -t 202001010000 "$fx/config/os.commands.env" 2>/dev/null; touch -t 202001010100 "$fx/stamp"; : > "$fx/calls"
  test.user.sourceNoSudo.run
  [ -s "$fx/calls" ] && bad="$bad second=[$(tr '\n' '|' < "$fx/calls")]"
  [ "$fx/config/os.commands.env" -nt "$fx/stamp" ] && bad="$bad discovered-again"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the cache is healed, no sudo, a second source discovers nothing" || create.result 1 "source user:$bad"
  return $(result)
}
test.case $level "T-USER-SOURCE-NO-SUDO: sourcing user without an os.commands.env heals it and calls no sudo" test.user.sourceNoSudo
expect 0 "the cache is healed, no sudo, a second source discovers nothing" \
  "sourcing user on an apt host ran sudo apt-get update — a password prompt in a new shell"

console.log "
Test: user.get basehome
===================================================================="

# T-USER-BASEHOME-ROOT: root's base is the system's user-home base, never the
# parent of developking's home. developking is an ordinary user; nothing may
# find the shared tree through it. Every home lookup is stubbed to a decoy, so
# an answer under the decoy means a home was asked.
test.user.basehomeRoot() {
  local fx want got
  fx=$(test.suite.fixture.make basehomeroot)
  case "$OSTYPE" in darwin*) want=/Users ;; *) want=/home ;; esac
  got=$(
    unset OOSH_USERS_BASEHOME
    private.get.home.linux()  { echo "$fx/decoy/$1"; }
    private.get.home.darwin() { echo "$fx/decoy/$1"; }
    user.get basehome root 2>/dev/null
  )
  rm -rf "$fx"
  if [ "$got" = "$want" ]; then
    create.result 0 "basehome root: $want"
  else
    create.result 1 "basehome root: got [$got], want [$want]"
  fi
  return $(result)
}
test.case $level "T-USER-BASEHOME-ROOT: user.get basehome root is the system base, no home is asked" test.user.basehomeRoot
expect 0 "basehome root: $(case "$OSTYPE" in darwin*) echo /Users ;; *) echo /home ;; esac)" \
  "root's base came from developking's home"

# T-USER-BASEHOME-OVERRIDE: $OOSH_USERS_BASEHOME is honoured for root — the one
# override ossh's private.ossh.users.basehome always had.
test.user.basehomeOverride() {
  local fx got
  fx=$(test.suite.fixture.make basehomeoverride)
  got=$(OOSH_USERS_BASEHOME="$fx/base" user.get basehome root 2>/dev/null)
  if [ "$got" = "$fx/base" ]; then
    create.result 0 "OOSH_USERS_BASEHOME honoured"
  else
    create.result 1 "OOSH_USERS_BASEHOME: got [$got], want [$fx/base]"
  fi
  rm -rf "$fx"
  return $(result)
}
test.case $level "T-USER-BASEHOME-OVERRIDE: user.get basehome root honours \$OOSH_USERS_BASEHOME" test.user.basehomeOverride
expect 0 "OOSH_USERS_BASEHOME honoured" "the override of the system base was lost"

# T-USER-BASEHOME-USER: an ordinary user's base stays the parent of their own home.
# A fixture user whose home the stubs answer — independent of who runs the
# suite (root's base is the system base, T-USER-BASEHOME-ROOT).
test.user.basehomeUser() {
  local fx want got
  fx=$(test.suite.fixture.make basehomeuser); mkdir -p "$fx/base/alice"
  want="$fx/base"
  got=$(
    private.get.home.linux()  { echo "$fx/base/$1"; }
    private.get.home.darwin() { echo "$fx/base/$1"; }
    user.get basehome alice 2>/dev/null
  )
  rm -rf "$fx"
  if [ "$got" = "$want" ]; then
    create.result 0 "basehome of a user: the parent of their home"
  else
    create.result 1 "basehome alice: got [$got], want [$want]"
  fi
  return $(result)
}
test.case $level "T-USER-BASEHOME-USER: user.get basehome <user> is the parent of the user's home" test.user.basehomeUser
expect 0 "basehome of a user: the parent of their home" "a non-root user's base changed"

# T-OSSH-USERS-BASEHOME-DELEGATES: ossh keeps its name for the system base but
# asks user — one source, no second copy of the rule.
test.user.osshBasehomeDelegates() {
  local fx got body
  fx=$(test.suite.fixture.make osshbasehome)
  got=$(source "$OOSH_DIR/ossh" >/dev/null 2>&1; OOSH_USERS_BASEHOME="$fx/base" private.ossh.users.basehome 2>/dev/null)
  body=$(source "$OOSH_DIR/ossh" >/dev/null 2>&1; declare -f private.ossh.users.basehome)
  rm -rf "$fx"
  if [ "$got" = "$fx/base" ] && printf '%s\n' "$body" | grep -q 'user.get basehome root' \
     && ! printf '%s\n' "$body" | grep -q 'OSTYPE'; then
    create.result 0 "private.ossh.users.basehome delegates to user.get basehome root"
  else
    create.result 1 "private.ossh.users.basehome: got [$got], body delegates=[$(printf '%s\n' "$body" | grep -c 'user.get basehome root')]"
  fi
  return $(result)
}
test.case $level "T-OSSH-USERS-BASEHOME-DELEGATES: private.ossh.users.basehome asks user.get basehome root" test.user.osshBasehomeDelegates
expect 0 "private.ossh.users.basehome delegates to user.get basehome root" "ossh keeps a second copy of the system base rule"

# T-USER-OOSH-INSTALL-NO-DEVELOPKING: user.oosh.install finds the shared tree
# under `user.get basehome root`. The fixture base has no developking and the
# stub answers no home for it — unless developking runs the test and is the
# user under test; any other home asked for is a failure. No tree: rc 1 naming where it is missing, at
# info level — state 31 step 1's `user create developking` reaches it on every
# fresh install, before the tree exists, and is retried in step 5. A tree
# without the branch folder: the single-shot "not yet available" skip, on the
# fixture's path — the step before anything is linked or copied.
test.user.ooshInstallNoDevelopking() {
  local fx bad="" got
  fx=$(test.suite.fixture.make ooshinstallnodk)
  mkdir -p "$fx/home/$(id -un)"
  test.user.ooshInstallNoDevelopking.run() { # — user.oosh.install <me> dev in a child shell; echo its log, then "rc <n>"
    FX="$fx" U="$(id -un)" bash -c '
      source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
      user.get() { case "$1" in home) [ "$2" = "$U" ] || echo "asked-home $2" >&2; [ "$2" = developking ] && [ "$2" != "$U" ] || echo "$FX/home/$2" ;; basehome) [ "$2" = root ] && echo "$FX/home" ;; esac; }
      export LOG_LEVEL=4 LOG_DEVICE=/dev/stderr LOG_LIVE= LOG_INSTALL=
      user.oosh.install "$U" dev >/dev/null; echo "rc $?" >&2' 2>&1 >/dev/null | sed "s|$fx|FX|g"
  }
  got=$(test.user.ooshInstallNoDevelopking.run)
  case "$got" in *"shared tree missing at FX/home/shared — skipping"*"ossh install"*) ;; *) bad="$bad no-tree-message" ;; esac
  case "$got" in *"INFO> user.oosh.install: shared tree missing at FX/home/shared"*) ;; *) bad="$bad no-tree-not-info" ;; esac
  case "$got" in *"ERROR>"*) bad="$bad no-tree-error" ;; esac
  [ "$(printf '%s\n' "$got" | tail -n 1)" = "rc 1" ] || bad="$bad no-tree-rc"
  mkdir -p "$fx/home/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"
  got=$(test.user.ooshInstallNoDevelopking.run)
  case "$got" in *"FX/home/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh/dev not yet available"*) ;; *) bad="$bad tree-not-reached" ;; esac
  case "$got" in *asked-home*) bad="$bad asked-home=[$(printf '%s\n' "$got" | grep -o 'asked-home [^ ]*' | tr '\n' '|')]" ;; esac
  [ "$(id -un)" = developking ] || case "$got" in *developking*) bad="$bad names-developking" ;; esac
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "user.oosh.install: the shared tree under basehome root, no developking" || create.result 1 "oosh.install:$bad"
  return $(result)
}
test.case $level "T-USER-OOSH-INSTALL-NO-DEVELOPKING: user.oosh.install finds the shared tree without developking" test.user.ooshInstallNoDevelopking
expect 0 "user.oosh.install: the shared tree under basehome root, no developking" \
  "user.oosh.install refused a base without developking's home"

# T-USER-CREATE-SKIP-WORDING: user.create's skip warning points at what came
# before it. A missing shared tree is an INFO from user.oosh.install (above),
# so "see errors above" sent the reader looking for errors that are not there.
# Structural — user.create makes a real account.
test.user.createSkipWording() {
  local body
  body=$(declare -f user.create)
  if printf '%s\n' "$body" | grep -q 'skipped for .* — see messages above' \
     && ! printf '%s\n' "$body" | grep -q 'see errors above'; then
    create.result 0 "the skip warning points at the messages above"
  else
    create.result 1 "user.create still says: $(printf '%s\n' "$body" | grep -o 'skipped for .*above')"
  fi
  return $(result)
}
test.case $level "T-USER-CREATE-SKIP-WORDING: user.create's oosh.install skip points at messages, not errors" test.user.createSkipWording
expect 0 "the skip warning points at the messages above" \
  "user.create pointed at errors that were only an info"

# T-USER-AUTHORIZED-KEYS-ADOPT: the rebuild keeps keys that only lived in
# authorized_keys. public_keys/ is the list authorized_keys is built from
# (Marcel's design; revoke = move the file to deactive.public_keys/). A key
# put into authorized_keys by hand or by the hoster had no file there, and the
# first ossh key.push deleted it: POL.dev, 2026-10-15 — the Mac Studio's RSA
# key was gone and root's login asked for a password. Now such a key gets a
# file in public_keys/ first; a revoked key (file in deactive.public_keys/)
# stays out. Compared by the key itself, never by file name. The fixture is
# the sshDir; the child bash has HOME=<fx>/home, CURRENT_SSH_DIR=<fx> and
# ssh/scp/rsync/sudo backstops, like T-USER-AUTHORIZED-KEYS-UPDATE-RC.
test.user.authorizedKeysAdopt() {
  local fx bad="" ak files
  fx=$(test.suite.fixture.make userauthkeys)
  mkdir -p "$fx/public_keys" "$fx/deactive.public_keys"
  echo "ssh-ed25519 AAAAKEYA owner@here" > "$fx/id_ed25519.pub"; : > "$fx/id_ed25519"
  echo "ssh-ed25519 AAAAKEYA owner@here" > "$fx/public_keys/ssh.owner.public_key"
  echo "ssh-ed25519 AAAAKEYR revoked@there" > "$fx/deactive.public_keys/old.public_key"
  printf '%s\n' "ssh-ed25519 AAAAKEYA owner@here" "# a comment line" "" \
    "ssh-rsa AAAAKEYB donges@mcdonges.fritz.box" "ssh-ed25519 AAAAKEYR revoked@there" \
    'from="10.0.0.1" ssh-ed25519 AAAAKEYC' > "$fx/authorized_keys"
  mkdir -p "$fx/home"
  test.user.authorizedKeysAdopt.run() { # <sshDir> # user authorized.keys.update <sshDir> in a child bash with HOME=<fx>/home and CURRENT_SSH_DIR=<sshDir>; ssh, scp, rsync, sudo are backstops (REAL lines in <fx>/real); its rc #
    HOME="$fx/home" CURRENT_SSH_DIR="$1" FX_REAL="$fx/real" bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/ossh" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
      ssh() { echo "REAL ssh $*" >> "$FX_REAL"; return 255; }; scp() { echo "REAL scp $*" >> "$FX_REAL"; return 255; }
      rsync() { echo "REAL rsync $*" >> "$FX_REAL"; return 255; }; sudo() { echo "REAL sudo $*" >> "$FX_REAL"; return 1; }
      user.authorized.keys.update "$1" >/dev/null 2>&1' _ "$1" </dev/null 2>/dev/null
  }
  test.user.authorizedKeysAdopt.run "$fx"
  test.user.authorizedKeysAdopt.run "$fx"
  # An adopted key that cannot be written: a public_keys/ without write
  # permission (root writes there anyway: not tried as root). The adopt wrote
  # unchecked, the key was dropped, and the rebuild swapped in an
  # authorized_keys WITHOUT it — the POL.dev lockout once more (fresh review
  # 2026-10-16). Now rc 1, and authorized_keys stays byte for byte.
  if [ "$(id -u)" != 0 ]; then
    mkdir -p "$fx/ro/public_keys"; : > "$fx/ro/id_ed25519"
    echo "ssh-ed25519 AAAAKEYA owner@here" > "$fx/ro/public_keys/ssh.owner.public_key"
    printf '%s\n' "ssh-ed25519 AAAAKEYA owner@here" "ssh-rsa AAAAKEYB donges@mcdonges.fritz.box" > "$fx/ro/authorized_keys"
    cp "$fx/ro/authorized_keys" "$fx/ro.before"; chmod 500 "$fx/ro/public_keys"
    test.user.authorizedKeysAdopt.run "$fx/ro" && bad="$bad unwritableRc0"
    cmp -s "$fx/ro.before" "$fx/ro/authorized_keys" || bad="$bad unwritableChanged=[$(tr '\n' '|' < "$fx/ro/authorized_keys")]"
    chmod 700 "$fx/ro/public_keys"
  fi
  unset -f test.user.authorizedKeysAdopt.run
  [ -s "$fx/real" ] && bad="$bad real=[$(tr '\n' '|' < "$fx/real")]"
  ak=$(cat "$fx/authorized_keys" 2>/dev/null)
  files=$(cd "$fx/public_keys" && ls | tr '\n' ' ')
  case "$ak" in *"AAAAKEYA owner@here"*) ;; *) bad="$bad lostOwner" ;; esac
  case "$ak" in *"ssh-rsa AAAAKEYB donges@mcdonges.fritz.box"*) ;; *) bad="$bad lostHandAdded" ;; esac
  case "$ak" in *'from="10.0.0.1" ssh-ed25519 AAAAKEYC'*) ;; *) bad="$bad lostWithOptions" ;; esac
  case "$ak" in *AAAAKEYR*) bad="$bad revokedBack" ;; esac
  [ "$(grep -c AAAAKEYB "$fx/authorized_keys")" = 1 ] || bad="$bad twice=[$(grep -c AAAAKEYB "$fx/authorized_keys")]"
  [ "$(grep -l AAAAKEYB "$fx/public_keys"/* 2>/dev/null | wc -l)" = 1 ] || bad="$bad noFileB=[$files]"
  [ "$(grep -l AAAAKEYC "$fx/public_keys"/* 2>/dev/null | wc -l)" = 1 ] || bad="$bad noFileC=[$files]"
  [ "$(ls "$fx/public_keys" | wc -l)" = 3 ] || bad="$bad files=[$files]"
  [ ! -e "$fx/public_keys/AAAAKEYR" ] && ! grep -q AAAAKEYR "$fx/public_keys"/* || bad="$bad revokedFile"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the rebuild keeps hand-added keys, leaves revoked ones out, twice the same" || create.result 1 "adopt:$bad"
  return $(result)
}
test.case $level "T-USER-AUTHORIZED-KEYS-ADOPT: authorized.keys.update keeps keys that had no file in public_keys/" test.user.authorizedKeysAdopt
expect 0 "the rebuild keeps hand-added keys, leaves revoked ones out, twice the same" \
  "POL.dev: key.push rebuilt authorized_keys and the Mac Studio's RSA key was gone"

# T-USER-AUTHORIZED-KEYS-UPDATE-RC: the rebuild's return code tells the truth.
# Without a private key in the sshDir the user has no ssh set up; the rebuild
# used to return 0 anyway (and looked at ~/.ssh instead of the given sshDir),
# so ossh key.push never ran its add-only fallback and the pushed key stayed
# unauthorized. Now: no key -> rc 1 and authorized_keys untouched; with a key
# -> rc 0 and rebuilt from public_keys/. Runs in a fixture with HOME pointing
# into it and CURRENT_SSH_DIR the sshDir under test (an inherited one would
# be the real ~/.ssh); ssh/rsync/sudo/scp are backstops in the child shell
# (REAL lines).
# The private key is an empty file: private.detect.ssh.key only asks -f, the
# same as T-USER-AUTHORIZED-KEYS-ADOPT — no ssh-keygen.
test.user.authorizedKeysUpdateRc() {
  local fx bad="" rc1 rc2
  fx=$(test.suite.fixture.make userauthrc)
  mkdir -p "$fx/home" "$fx/nokey/public_keys" "$fx/withkey/public_keys"
  echo "ssh-ed25519 AAAAKEYN nokey@here" > "$fx/nokey/public_keys/a.public_key"
  echo "ssh-ed25519 AAAAOLD old@here" > "$fx/nokey/authorized_keys"
  echo "ssh-ed25519 AAAAKEYW withkey@here" > "$fx/withkey/public_keys/a.public_key"
  : > "$fx/withkey/id_ed25519"
  test.user.authorizedKeysUpdateRc.run() { # <sshDir> # user authorized.keys.update <sshDir> in a child bash with HOME=<fx>/home; its rc #
    HOME="$fx/home" CURRENT_SSH_DIR="$1" FX_REAL="$fx/real" bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/ossh" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
      ssh() { echo "REAL ssh $*" >> "$FX_REAL"; return 255; }; scp() { echo "REAL scp $*" >> "$FX_REAL"; return 255; }
      rsync() { echo "REAL rsync $*" >> "$FX_REAL"; return 255; }; sudo() { echo "REAL sudo $*" >> "$FX_REAL"; return 1; }
      user.authorized.keys.update "$1" >/dev/null 2>&1' _ "$1" </dev/null 2>/dev/null
  }
  test.user.authorizedKeysUpdateRc.run "$fx/nokey"; rc1=$?
  test.user.authorizedKeysUpdateRc.run "$fx/withkey"; rc2=$?
  unset -f test.user.authorizedKeysUpdateRc.run
  [ -s "$fx/real" ] && bad="$bad real=[$(tr '\n' '|' < "$fx/real")]"
  [ "$rc1" = 1 ] || bad="$bad noKeyRc=$rc1"
  [ "$(cat "$fx/nokey/authorized_keys")" = "ssh-ed25519 AAAAOLD old@here" ] || bad="$bad touched"
  [ "$rc2" = 0 ] || bad="$bad withKeyRc=$rc2"
  grep -q AAAAKEYW "$fx/withkey/authorized_keys" 2>/dev/null || bad="$bad notRebuilt"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "no key: rc 1 and untouched; with a key: rc 0 and rebuilt" || create.result 1 "updateRc:$bad"
  return $(result)
}
test.case $level "T-USER-AUTHORIZED-KEYS-UPDATE-RC: authorized.keys.update returns 1 when the sshDir has no private key" test.user.authorizedKeysUpdateRc
expect 0 "no key: rc 1 and untouched; with a key: rc 0 and rebuilt" \
  "key.push's add-only fallback never ran because the rebuild returned 0 without ssh set up"

# T-USER-AUTHORIZED-KEYS-REBUILD-ATOMIC: the rebuild never leaves the user without authorized_keys
# It was `rm -f authorized_keys` and then `cat public_keys/* >> authorized_keys`:
# between the two — and for good when the cat failed — sshd let nobody in by
# key, and a key file without its last newline was glued to the next key. Now
# the content is built first and swapped in with private.this.file.write
# (<file>.new, then mv): a failed write or an unreadable key file is rc 1 and
# the old file stays byte for byte, no .new and no .bak are left, 700/600 kept.
# The write is wrapped to record that authorized_keys still exists when it
# runs (never deleted first). A child bash with HOME=<fx>/home and
# CURRENT_SSH_DIR=<fx>/ssh; ssh, scp, rsync, sudo are backstops (REAL lines).
# The private key is an empty file: private.detect.ssh.key only asks -f.
# test.user.authorizedKeysRebuildAtomic.write is the kernel's write saved under
# a test name for the wrapper; both live only in the child bash.
test.user.authorizedKeysRebuildAtomic() {
  local fx bad="" rc ak
  fx=$(test.suite.fixture.make userakatomic)
  mkdir -p "$fx/home" "$fx/ssh/public_keys"
  : > "$fx/ssh/id_ed25519"
  printf '%s' "ssh-ed25519 AAAANONL a@here" > "$fx/ssh/public_keys/a.public_key"   # no newline at the end
  echo "ssh-ed25519 AAAAB b@here" > "$fx/ssh/public_keys/b.public_key"
  printf '%s\n' "ssh-ed25519 AAAANONL a@here" > "$fx/ssh/authorized_keys"
  test.user.authorizedKeysRebuildAtomic.run() { # <sshDir> # user authorized.keys.update <sshDir> in a child bash, the checked write wrapped; its rc #
    HOME="$fx/home" CURRENT_SSH_DIR="$fx/ssh" FX="$fx" bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/ossh" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
      ssh() { echo "REAL ssh $*" >> "$FX/real"; return 255; }; scp() { echo "REAL scp $*" >> "$FX/real"; return 255; }
      rsync() { echo "REAL rsync $*" >> "$FX/real"; return 255; }; sudo() { echo "REAL sudo $*" >> "$FX/real"; return 1; }
      eval "test.user.authorizedKeysRebuildAtomic.write() # <file> <content> # private.this.file.write under a test name, for the wrapper below #
$(declare -f private.this.file.write | tail -n +2)"
      private.this.file.write() { [ -f "$1" ] && echo "present $1" >> "$FX/writes" || echo "absent $1" >> "$FX/writes"; test.user.authorizedKeysRebuildAtomic.write "$@"; }
      user.authorized.keys.update "$1" >/dev/null 2>&1' _ "$1" </dev/null 2>/dev/null
  }
  # a rebuild: each key on its own line, the file there when it is swapped
  test.user.authorizedKeysRebuildAtomic.run "$fx/ssh"; rc=$?
  ak=$(cat "$fx/ssh/authorized_keys")
  [ "$rc" = 0 ] || bad="$bad rc=$rc"
  [ "$ak" = "ssh-ed25519 AAAANONL a@here
ssh-ed25519 AAAAB b@here" ] || bad="$bad content=[$(echo "$ak" | tr '\n' '|')]"
  grep -qx "present $fx/ssh/authorized_keys" "$fx/writes" 2>/dev/null || bad="$bad notSwapped=[$(tr '\n' '|' < "$fx/writes" 2>/dev/null)]"
  [ "$(stat -c %a "$fx/ssh" 2>/dev/null || stat -f %Lp "$fx/ssh")" = 700 ] || bad="$bad dirMode"
  [ "$(stat -c %a "$fx/ssh/authorized_keys" 2>/dev/null || stat -f %Lp "$fx/ssh/authorized_keys")" = 600 ] || bad="$bad fileMode"
  cp "$fx/ssh/authorized_keys" "$fx/before"
  # the write fails (a folder where the .new goes): rc 1, the old file stays
  mkdir "$fx/ssh/authorized_keys.new"
  echo "ssh-ed25519 AAAAC c@here" > "$fx/ssh/public_keys/c.public_key"
  test.user.authorizedKeysRebuildAtomic.run "$fx/ssh"; rc=$?
  [ "$rc" = 1 ] || bad="$bad writeFailRc=$rc"
  cmp -s "$fx/before" "$fx/ssh/authorized_keys" || bad="$bad writeFailChanged"
  rmdir "$fx/ssh/authorized_keys.new"
  # a key file that cannot be read (root reads everything: not tried as root)
  if [ "$(id -u)" != 0 ]; then
    chmod 000 "$fx/ssh/public_keys/c.public_key"
    test.user.authorizedKeysRebuildAtomic.run "$fx/ssh"; rc=$?
    [ "$rc" = 1 ] || bad="$bad unreadableRc=$rc"
    cmp -s "$fx/before" "$fx/ssh/authorized_keys" || bad="$bad unreadableChanged"
    chmod 600 "$fx/ssh/public_keys/c.public_key"
  fi
  [ -n "$(find "$fx/ssh" -maxdepth 1 \( -name '*.new' -o -name '*.bak' \))" ] && bad="$bad leftOver=[$(cd "$fx/ssh" && ls -a | tr '\n' ' ')]"
  [ -s "$fx/real" ] && bad="$bad real=[$(tr '\n' '|' < "$fx/real")]"
  unset -f test.user.authorizedKeysRebuildAtomic.run
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "the rebuild swaps a complete authorized_keys in; a failure leaves the old one" || create.result 1 "rebuild atomic:$bad"
  return $(result)
}
test.case $level "T-USER-AUTHORIZED-KEYS-REBUILD-ATOMIC: authorized.keys.update swaps a complete file in and never deletes first" test.user.authorizedKeysRebuildAtomic
expect 0 "the rebuild swaps a complete authorized_keys in; a failure leaves the old one" \
  "rm -f authorized_keys + cat >>: a failed step left the user without authorized_keys"

# T-USER-AUTHORIZED-KEYS-ADOPT-NO-NEWLINE: a key file without its last newline is still known
# adopt read `cat public_keys/* | while read`: the last line of a file without
# a newline was glued to the next file or lost, its key counted as unknown, and
# every rebuild adopted it again (adopted.<comment>.public_key, a second line
# in authorized_keys). Same child bash and backstops as above.
test.user.authorizedKeysAdoptNoNewline() {
  local fx bad=""
  fx=$(test.suite.fixture.make userakadoptnl)
  mkdir -p "$fx/home" "$fx/ssh/public_keys"
  : > "$fx/ssh/id_ed25519"
  echo "ssh-ed25519 AAAAFIRST first@here" > "$fx/ssh/public_keys/a.public_key"
  printf '%s' "ssh-ed25519 AAAANONL nonl@here" > "$fx/ssh/public_keys/z.public_key"   # the last file, no newline
  printf '%s\n' "ssh-ed25519 AAAAFIRST first@here" "ssh-ed25519 AAAANONL nonl@here" > "$fx/ssh/authorized_keys"
  HOME="$fx/home" CURRENT_SSH_DIR="$fx/ssh" FX="$fx" bash -c 'source "$OOSH_DIR/this" >/dev/null 2>&1; source "$OOSH_DIR/ossh" >/dev/null 2>&1; source "$OOSH_DIR/user" >/dev/null 2>&1
    ssh() { echo "REAL ssh $*" >> "$FX/real"; return 255; }; scp() { echo "REAL scp $*" >> "$FX/real"; return 255; }
    rsync() { echo "REAL rsync $*" >> "$FX/real"; return 255; }; sudo() { echo "REAL sudo $*" >> "$FX/real"; return 1; }
    user.authorized.keys.update "$1" >/dev/null 2>&1; user.authorized.keys.update "$1" >/dev/null 2>&1' _ "$fx/ssh" </dev/null 2>/dev/null
  [ -n "$(ls "$fx/ssh/public_keys" | grep '^adopted\.')" ] && bad="$bad adopted=[$(ls "$fx/ssh/public_keys" | tr '\n' ' ')]"
  [ "$(grep -c AAAANONL "$fx/ssh/authorized_keys")" = 1 ] || bad="$bad twice=$(grep -c AAAANONL "$fx/ssh/authorized_keys")"
  [ -s "$fx/real" ] && bad="$bad real=[$(tr '\n' '|' < "$fx/real")]"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "a key file without its last newline is known; nothing adopted twice" || create.result 1 "adopt newline:$bad"
  return $(result)
}
test.case $level "T-USER-AUTHORIZED-KEYS-ADOPT-NO-NEWLINE: adopt knows a key whose file has no last newline" test.user.authorizedKeysAdoptNoNewline
expect 0 "a key file without its last newline is known; nothing adopted twice" \
  "cat public_keys/* | while read lost the last line of a file without a newline"

# T-USER-INIT-CONFIG-600: user.init leaves ~/.ssh/config 600, whatever the umask
# ~/.ssh/config used to start as a copy of <basehome>/shared/.ssh/config, 600.
# Since GitHub lives in /etc/ssh (dev.sharedSshRemove) user.init creates it,
# and under umask 002 it was 664: ssh accepts a group-writable config only
# when the group is the user alone, so `test` (gid 0, root) got "Bad owner or
# permissions" on every ssh (platform.test ubuntu_24_04, 2026-10-19).
test.user.initConfig600() {
  local fx bad="" m
  fx=$(test.suite.fixture.make userinitconfig600); mkdir -p "$fx/.ssh"
  for m in new existing; do
    [ "$m" = existing ] && { printf '%s\n' "Host x" " User y" > "$fx/.ssh/config"; chmod 664 "$fx/.ssh/config"; }
    [ "$m" = new ] && rm -f "$fx/.ssh/config"
    ( umask 002; HOME="$fx"; LOG_DEVICE=/dev/null; LOG_LIVE=
      user.ssh.status() { return 0; }; tree() { :; }
      user.init "$fx/.ssh" ) </dev/null >/dev/null 2>&1
    [ "$(ls -l "$fx/.ssh/config" 2>/dev/null | cut -c1-10)" = "-rw-------" ] || bad="$bad $m=$(ls -l "$fx/.ssh/config" 2>/dev/null | cut -c1-10)"
    grep -q '^Host WODA.test$' "$fx/.ssh/config" || bad="$bad $m-noWoda"
  done
  grep -q '^Host x$' "$fx/.ssh/config" || bad="$bad ownLost"
  rm -rf "$fx"
  [ -z "$bad" ] && create.result 0 "user.init leaves ~/.ssh/config 600" || create.result 1 "user.init config mode:$bad"
  return $(result)
}
test.case $level "T-USER-INIT-CONFIG-600: user.init leaves ~/.ssh/config 600 under umask 002" test.user.initConfig600
expect 0 "user.init leaves ~/.ssh/config 600" \
  "a 664 ~/.ssh/config with a shared group made ssh refuse every login of the user"

### test.method

test.suite.save.results
