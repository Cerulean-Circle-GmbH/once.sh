#!/usr/bin/env bash
# T-PANEGET-CLEAN — g.6 (bcd8f84): otmux pane.get must be BYTE-CLEAN (no stray
# newline) regardless of LOG_DEVICE. Root cause: log.init.colors' writability
# probe wrote a blank line to LOG_DEVICE (`echo "" > $LOG_DEVICE`); with
# LOG_DEVICE=/dev/stdout that blank line contaminated pane.get's stdout → a
# `\n/dev/pts/N` value that failed downstream `ps $2==tty` matches → the g.4
# misclassification + reconcile/tty bugs. Fixed to a NON-EMITTING probe
# (`: >> $LOG_DEVICE`). This is the SOURCE guard so the scar can't return.

level=$1
if [ -z "$level" ]; then
  level=1
else
  shift
fi
echo "starting: ${BASH_SOURCE[@]##*/} <LOG_LEVEL=$level>"

source this
source test.suite

log.level $level

LOG_SRC="$OOSH_DIR/log"

# ── T-PANEGET-CLEAN-BYTES [B]: pane.get tty is byte-clean under LOG_DEVICE
# =/dev/stdout (the contaminating case) — exactly the tty, no newline/blank. ──
if [ -n "$(command -v tmux)" ] && tmux new-session -d -s "__pgc_$$" -x 100 -y 30 2>/dev/null; then
  PGC_P="__pgc_$$:0.0"; sleep 0.3
  TTYVAL=$(LOG_DEVICE=/dev/stdout otmux pane.get "$PGC_P" '#{pane_tty}' 2>/dev/null)
  HAS_NL=no; case "$TTYVAL" in *"
"*) HAS_NL=yes ;; esac
  CLEAN=no; printf '%s' "$TTYVAL" | grep -qxE '/dev/(pts|tty)[/0-9]+' && CLEAN=yes
  test.case $level "T-PANEGET-CLEAN-BYTES: pane.get tty byte-clean (LOG_DEVICE=/dev/stdout)" \
    echo "val='$TTYVAL' newline=$HAS_NL clean=$CLEAN"
  if [ "$HAS_NL" = "no" ] && [ "$CLEAN" = "yes" ]; then
    expect.pass "tty is a single clean value ('$TTYVAL') — no stray newline"
  else
    expect.fail "pane.get tty NOT byte-clean: val='$TTYVAL' newline=$HAS_NL clean=$CLEAN [g.6 regression]"
  fi

  # ── T-PANEGET-CLEAN-PS-MATCH [B]: the clean tty actually matches in ps
  # (`$2==tty`) — the downstream effect a stray newline broke. ──────────────
  TTYSHORT="${TTYVAL#/dev/}"
  PSHIT=$(ps -eo pid,tty,args 2>/dev/null | awk -v t="$TTYSHORT" '$2==t {print $1; exit}')
  test.case $level "T-PANEGET-CLEAN-PS-MATCH: clean tty matches ps \$2==tty" \
    echo "ttyShort=$TTYSHORT pid=$PSHIT"
  if [ -n "$PSHIT" ]; then
    expect.pass "clean tty matched a live process (pid $PSHIT) — ps join works"
  else
    expect.fail "clean tty did NOT match in ps (a stray newline would cause this)"
  fi

  tmux kill-session -t "__pgc_$$" 2>/dev/null
else
  test.case $level "T-PANEGET-CLEAN-BYTES: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
  test.case $level "T-PANEGET-CLEAN-PS-MATCH: (skipped — no tmux)" echo "skip"; expect.pass "skipped"
fi

# ── T-PANEGET-PROBE-NONEMIT [S]: the LOG_DEVICE writability probe is
# NON-EMITTING (`: … >> $LOG_DEVICE`), NEVER `echo "" > $LOG_DEVICE`. ─────────
NONEMIT=$(grep -cE ':[[:space:]].*>>[[:space:]]*"?\$?\{?LOG_DEVICE' "$LOG_SRC")
EMIT=$(grep -cE 'echo[[:space:]]+""[[:space:]]*>[[:space:]]*"?\$?\{?LOG_DEVICE' "$LOG_SRC")
test.case $level "T-PANEGET-PROBE-NONEMIT: LOG_DEVICE writability probe emits nothing" \
  echo "nonEmit=$NONEMIT emit=$EMIT"
if [ "${NONEMIT:-0}" -ge 1 ] && [ "${EMIT:-0}" -eq 0 ]; then
  expect.pass "probe uses non-emitting ': >> \$LOG_DEVICE' — no blank-line contamination"
else
  expect.fail "emitting LOG_DEVICE probe present (emit=$EMIT) or non-emitting form missing (nonEmit=$NONEMIT) [g.6]"
fi

echo ""
echo "=== T-PANEGET-CLEAN tests complete ==="
echo ""

test.suite.save.results
