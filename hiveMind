hiveMind.team.setup.extended() # <session> # bootstrap full 8-agent team: 2 windows (core + extended)
{
  local session="${1:-projectTeam}"

  info.log "Setting up extended 8-agent team in session: $session"

  # Check if session already exists
  if tmux has-session -t "$session" 2>/dev/null; then
    warn.log "Session '$session' already exists"
    echo "  Kill it first:  tmux kill-session -t $session"
    echo "  Or attach to it: tmux attach -t $session"
    return 1
  fi

  # ── Window 1: "core" ────────────────────────────────────────────────────
  # ┌─────────────────────────────────────────┐
  # │ Pane 1.1 - ORCHESTRATOR                 │
  # ├───────────────────────┬─────────────────┤
  # │ Pane 1.3 - EXPERT     │ Pane 1.4 - TEST │
  # ├───────────────────────┴─────────────────┤
  # │ Pane 1.2 - SCRUMMASTER                  │
  # └─────────────────────────────────────────┘

  info.log "Creating tmux session: $session (window 1: core)"
  $OOSH_DIR/otmux new "$session" -d

  # Rename first window to "core"
  tmux rename-window -t "${session}:1" "core"

  # Split pane 1 vertically → pane 1 (top) + pane 2 (bottom)
  $OOSH_DIR/otmux split.v -t "${session}:1.1"

  # Split pane 1 vertically again → pane 1 (top) + pane 3 (middle), pane 2 stays bottom
  $OOSH_DIR/otmux split.v -t "${session}:1.1"

  # Split pane 3 (middle) horizontally → pane 3 (mid-left) + pane 4 (mid-right)
  $OOSH_DIR/otmux split.h -t "${session}:1.3"

  # Pane layout: 1.1=top, 1.3=mid-left, 1.4=mid-right, 1.2=bottom (full-width)
  private.hiveMind.pane.identify "${session}:1.1" "orchestrator"
  private.hiveMind.pane.identify "${session}:1.2" "scrum-master"
  private.hiveMind.pane.identify "${session}:1.3" "oosh-expert"
  private.hiveMind.pane.identify "${session}:1.4" "oosh-tester"

  # ── Window 2: "extended" ────────────────────────────────────────────────
  # ┌───────────────────────┬─────────────────┐
  # │ Pane 2.1 - PO         │ Pane 2.2 - TASK │
  # ├───────────────────────┼─────────────────┤
  # │ Pane 2.3 - TRAINER    │ Pane 2.4 - DEV  │
  # └───────────────────────┴─────────────────┘

  info.log "Creating window 2: extended"
  tmux new-window -t "${session}" -n "extended"

  # Split pane 1 horizontally → pane 1 (left) + pane 2 (right)
  $OOSH_DIR/otmux split.h -t "${session}:2.1"

  # Split pane 1 vertically → pane 1 (top-left) + pane 3 (bottom-left)
  $OOSH_DIR/otmux split.v -t "${session}:2.1"

  # Split pane 2 vertically → pane 2 (top-right) + pane 4 (bottom-right)
  $OOSH_DIR/otmux split.v -t "${session}:2.2"

  # Register roles for window 2
  private.hiveMind.pane.identify "${session}:2.1" "product-owner"
  private.hiveMind.pane.identify "${session}:2.2" "task-agent"
  private.hiveMind.pane.identify "${session}:2.3" "agent-trainer"
  private.hiveMind.pane.identify "${session}:2.4" "developer"

  # ── Start Claude Code in all 8 panes ────────────────────────────────────
  info.log "Starting Claude Code in all 8 panes..."

  local pane
  for pane in 1.1 1.2 1.3 1.4; do
    $OOSH_DIR/otmux send.enter "${session}:${pane}" "claude"
    sleep 2
  done
  for pane in 2.1 2.2 2.3 2.4; do
    $OOSH_DIR/otmux send.enter "${session}:${pane}" "claude"
    sleep 2
  done

  # Wait for Claude Code to initialize
  info.log "Waiting for Claude Code agents to initialize..."
  sleep 10

  # ── Send bootstrap prompts from files ───────────────────────────────────
  info.log "Sending bootstrap prompts to agents..."

  $OOSH_DIR/otmux send.enter "${session}:1.1" "Read session/tasks/bootstrap-orchestrator.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:1.2" "Read session/tasks/bootstrap-scrum-master.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:1.3" "Read session/tasks/bootstrap-oosh-expert.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:1.4" "Read session/tasks/bootstrap-oosh-tester.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:2.1" "Read session/tasks/bootstrap-product-owner.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:2.2" "Read session/tasks/bootstrap-task-agent.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:2.3" "Read session/tasks/bootstrap-agent-trainer.md"
  sleep 1
  $OOSH_DIR/otmux send.enter "${session}:2.4" "Read session/tasks/bootstrap-developer.md"

  # ── Done ─────────────────────────────────────────────────────────────────
  success.log "Extended 8-agent team created in session: $session"
  echo ""
  echo "Window 1: core"
  echo "┌─────────────────────────────────────────┐"
  echo "│ Pane 1.1 - ORCHESTRATOR                 │"
  echo "├───────────────────────┬─────────────────┤"
  echo "│ Pane 1.3 - EXPERT     │ Pane 1.4 - TEST │"
  echo "├───────────────────────┴─────────────────┤"
  echo "│ Pane 1.2 - SCRUMMASTER                  │"
  echo "└─────────────────────────────────────────┘"
  echo ""
  echo "Window 2: extended"
  echo "┌───────────────────────┬─────────────────┐"
  echo "│ Pane 2.1 - PO         │ Pane 2.2 - TASK │"
  echo "├───────────────────────┼─────────────────┤"
  echo "│ Pane 2.3 - TRAINER    │ Pane 2.4 - DEV  │"
  echo "└───────────────────────┴─────────────────┘"
  echo ""
  echo "Attach with: tmux attach -t $session"
}

