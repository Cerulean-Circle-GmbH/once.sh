  local session
  session="$(private.hiveMind.active.team)"
  local target
  target=$(hiveMind.resolve "$name" "$session" 2>/dev/null)
  if [ -z "$target" ]; then
    error.log "Cannot resolve '$name' to a pane target"
    return 1
  fi

  # Delegate all tmux logic to otmux (DRY — accept-edits, C-u, verify all in one place)
  "$OOSH_DIR/otmux" send "$target" "$message"
  local rc=$?

  if [ $rc -eq 0 ]; then
    info.log "Message delivered to $name ($target)"
    create.result 0 "DELIVERED"
  else
    warn.log "Message delivery uncertain for $name ($target)"
    create.result 0 "UNCERTAIN"
  fi
  return $rc
}
