hiveMind.consistency.audit() # <?session> # cross-compare all identity sources and show mismatches
{
  local filterSession="$1"

  # Load registry file
  local reg="$HIVEMIND_REGISTRY"
  # Load sessions.env (role|uuid)
  local sessFile="$HIVEMIND_SESSIONS"

  echo -e "${BOLD_CYAN}Identity Consistency Audit${NORMAL}"
  echo -e "${GRAY}$(printf '%.0s═' {1..85})${NORMAL}"
  printf "${BOLD_WHITE}%-28s %-16s %-16s %-13s %-16s %s${NORMAL}\n" "PANE" "TITLE" "REGISTRY" "SESS.ENV" "LIVE UUID" "MATCH"
  echo -e "${GRAY}$(printf '%.0s─' {1..85})${NORMAL}"

  local consistent=0 inconsistent=0
  local -A seenUuids

  while IFS='|' read -r pid tty paneTarget title rest; do
    [ -z "$pid" ] && continue

    # Filter by session
    if [ -n "$filterSession" ] && [[ "$paneTarget" != "${filterSession}:"* ]]; then
      continue
    fi

    local titleShort="${title:0:14}"
    [ ${#title} -gt 14 ] && titleShort="${titleShort}.."

    # Registry role
    local regRole=""
    [ -f "$reg" ] && regRole=$(grep "^${paneTarget}|" "$reg" 2>/dev/null | head -1 | cut -d'|' -f2)
    local regDisplay="${regRole:-${BOLD_YELLOW}MISSING${NORMAL}}"

    # Sessions.env UUID (look up by registry role or title-derived role)
    local sessUuid=""
    local lookupRole="${regRole}"
    if [ -z "$lookupRole" ]; then
      lookupRole="${title}"; lookupRole="${lookupRole#✳ }"; lookupRole="${lookupRole#⠐ }"
      lookupRole="${lookupRole#⠂ }"; lookupRole="${lookupRole#✻ }"; lookupRole="${lookupRole#✢ }"; lookupRole="${lookupRole#✶ }"
      lookupRole="${lookupRole%%@*}"; lookupRole=$(echo "$lookupRole" | tr -d '[:space:]')
    fi
    if [ -n "$lookupRole" ] && [ -f "$sessFile" ]; then
      sessUuid=$(grep "^${lookupRole}|" "$sessFile" 2>/dev/null | head -1 | cut -d'|' -f2)
    fi
    local sessShort="${sessUuid:0:8}"

    # Live UUID from ps args → session.id
    local liveUuid
    liveUuid=$(echo "$rest" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1)
    if [ -z "$liveUuid" ]; then
      liveUuid=$("$OOSH_DIR/claudeCode" session.id "$paneTarget" 2>/dev/null)
    fi
    local liveShort="${liveUuid:0:8}"

    # Consistency checks
    local issues=()
    [ -z "$regRole" ] && issues+=("no registry")
    if [ -n "$regRole" ] && [ -n "$title" ]; then
      echo "$title" | grep -qi "$regRole" 2>/dev/null || issues+=("title≠reg")
    fi
    if [ -n "$sessUuid" ] && [ -n "$liveUuid" ] && [ "$sessUuid" != "$liveUuid" ]; then
      issues+=("UUID stale")
    fi
    if [ -n "$liveUuid" ]; then
      if [ -n "${seenUuids[$liveUuid]:-}" ]; then
        issues+=("dup UUID")
      fi
      seenUuids["$liveUuid"]="$paneTarget"
    fi
    if [ -n "$regRole" ]; then
      [[ ${#regRole} -gt 30 ]] && issues+=("role>30")
      [[ "$regRole" == *" "* ]] && issues+=("role has space")
    fi

    local match="${BOLD_GREEN}✓${NORMAL}"
    local issueStr=""
    if [ ${#issues[@]} -gt 0 ]; then
      match="${BOLD_RED}✗${NORMAL}"
      issueStr="${BOLD_RED}$(IFS=', '; echo "${issues[*]}")${NORMAL}"
      inconsistent=$((inconsistent + 1))
    else
      consistent=$((consistent + 1))
    fi

    printf "%-28s %-16s %-16b %-13s %-16s %b %b\n" \
      "$paneTarget" "$titleShort" "$regDisplay" "${sessShort:--}" "${liveShort:--}" "$match" "$issueStr"

  done < <(private.hiveMind.claude.processes)

  echo -e "${GRAY}$(printf '%.0s─' {1..85})${NORMAL}"
  echo -e "Summary: ${BOLD_GREEN}$consistent consistent${NORMAL}, ${BOLD_RED}$inconsistent inconsistent${NORMAL}"
  return 0
}

hiveMind.consistency.audit.completion.session() {
  private.hiveMind.teams.complete
}

hiveMind.consistency.fix() # <?session> # auto-repair identity mismatches from live truth
{
  local filterSession="$1"

  local reg="$HIVEMIND_REGISTRY"
  local sessFile="$HIVEMIND_SESSIONS"

  # Ensure files exist
  [ -f "$reg" ] || touch "$reg"
  [ -f "$sessFile" ] || touch "$sessFile"

  echo -e "${BOLD_CYAN}Fixing identity consistency...${NORMAL}"
  echo

  local fixedReg=0 fixedSess=0 fixedTitle=0 skipped=0 dupResolved=0
  local -A seenUuids roleForUuid

  while IFS='|' read -r pid tty paneTarget title rest; do
    [ -z "$pid" ] && continue

    # Filter by session
    if [ -n "$filterSession" ] && [[ "$paneTarget" != "${filterSession}:"* ]]; then
      continue
    fi

    # --- 1. Get LIVE UUID (ground truth) ---
    local liveUuid
    liveUuid=$(echo "$rest" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1)
    if [ -z "$liveUuid" ]; then
      liveUuid=$("$OOSH_DIR/claudeCode" session.id "$paneTarget" 2>/dev/null)
    fi
    if [ -z "$liveUuid" ]; then
      liveUuid=$("$OOSH_DIR/claudeCode" session.probe "$paneTarget" 2>/dev/null)
    fi

    # --- 2. Get role name (ground truth) ---
    local role=""
    # Try registry first
    [ -f "$reg" ] && role=$(grep "^${paneTarget}|" "$reg" 2>/dev/null | head -1 | cut -d'|' -f2)

    # Try pane title fallback
    if [ -z "$role" ] || [ "$role" = "unknown" ]; then
      role="${title}"
      role="${role#✳ }"; role="${role#⠐ }"; role="${role#⠂ }"
      role="${role#✻ }"; role="${role#✢ }"; role="${role#✶ }"
      role="${role%%@*}"
      role=$(echo "$role" | tr -d '[:space:]' | head -c 30)
    fi

    # Try live.discover
    if [ -z "$role" ] || [ "$role" = "unknown" ]; then
      local discoverResult
      discoverResult=$(private.hiveMind.live.discover "$paneTarget" 2>/dev/null)
      if [ -n "$discoverResult" ]; then
        role=$(echo "$discoverResult" | cut -d'|' -f4)
        role="${role%%@*}"
      fi
    fi

    # Can't determine role — skip
    if [ -z "$role" ] || [ "$role" = "unknown" ]; then
      printf "${BOLD_YELLOW}%-28s %-16s SKIPPED (can't determine role)${NORMAL}\n" "$paneTarget" "${title:0:14}"
      skipped=$((skipped + 1))
      continue
    fi

    local lineParts=()

    # --- 3a. Fix missing/stale registry ---
    local existingReg=""
    existingReg=$(grep "^${paneTarget}|" "$reg" 2>/dev/null | head -1 | cut -d'|' -f2)
    if [ -z "$existingReg" ]; then
      private.hiveMind.registry.set "$paneTarget" "$role"
      lineParts+=("${BOLD_GREEN}registry.set ✓${NORMAL}")
      fixedReg=$((fixedReg + 1))
    else
      lineParts+=("${GREEN}registry ✓${NORMAL}")
    fi

    # --- 3b. Fix sessions.env UUID ---
    if [ -n "$liveUuid" ]; then
      # Check for duplicate UUID
      if [ -n "${seenUuids[$liveUuid]:-}" ]; then
        local dupRole="${roleForUuid[$liveUuid]:-}"
        echo -e "${BOLD_RED}⚠ DUPLICATE UUID: $dupRole and $role both have ${liveUuid:0:8}${NORMAL}"
        dupResolved=$((dupResolved + 1))
      fi
      seenUuids["$liveUuid"]="$paneTarget"
      roleForUuid["$liveUuid"]="$role"

      local oldUuid=""
      oldUuid=$(grep "^${role}|" "$sessFile" 2>/dev/null | head -1 | cut -d'|' -f2)
      if [ -z "$oldUuid" ]; then
        # Add new entry
        echo "${role}|${liveUuid}" >> "$sessFile"
        lineParts+=("${BOLD_GREEN}sessions.env → ${liveUuid:0:8} ✓${NORMAL}")
        fixedSess=$((fixedSess + 1))
      elif [ "$oldUuid" != "$liveUuid" ]; then
        # Replace stale UUID
        sed -i '' "s#^${role}|${oldUuid}\$#${role}|${liveUuid}#" "$sessFile"
        lineParts+=("${BOLD_GREEN}sessions.env → ${liveUuid:0:8} ✓${NORMAL}  ${BOLD_YELLOW}(was ${oldUuid:0:8} STALE)${NORMAL}")
        fixedSess=$((fixedSess + 1))
      else
        lineParts+=("${GREEN}sessions.env ✓${NORMAL}")
      fi
    else
      lineParts+=("${BOLD_YELLOW}sessions.env — (no live UUID)${NORMAL}")
    fi

    # --- 3c. Fix pane title if it doesn't match role ---
    if ! echo "$title" | grep -qi "$role" 2>/dev/null; then
      otmux pane.lock "$paneTarget" "$role"
      lineParts+=("${BOLD_GREEN}title → $role ✓ (locked)${NORMAL}")
      fixedTitle=$((fixedTitle + 1))
    fi

    printf "%-28s %-16s %b\n" "$paneTarget" "$role" "$(IFS='  '; echo "${lineParts[*]}")"

  done < <(private.hiveMind.claude.processes)

  echo
  echo -e "Fixed: ${BOLD_GREEN}$fixedReg${NORMAL} registry, ${BOLD_GREEN}$fixedSess${NORMAL} sessions, ${BOLD_GREEN}$fixedTitle${NORMAL} titles, ${BOLD_RED}$dupResolved${NORMAL} duplicates"
  [ $skipped -gt 0 ] && echo -e "${BOLD_YELLOW}Skipped: $skipped (unknown role)${NORMAL}"
  echo "Run hiveMind consistency.audit to verify."
  return 0
}

hiveMind.consistency.fix.completion.session() {
  private.hiveMind.teams.complete
}

