hiveMind.team.state.set() # <session> <STATE> # set operator override for ALL agents in a session
{
  local session="$1" state="$2"
  if [ -z "$session" ] || [ -z "$state" ]; then
    error.log "Usage: hiveMind team.state.set <session> <STATE>"
    return 1
  fi
  if ! this.isSessionName "$session"; then
    error.log "team.state.set: invalid session '$session'"
    return 1
  fi
  local callerRole=""
  [ -n "$TMUX_PANE" ] && callerRole=$(grep "^$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)|" "$HIVEMIND_REGISTRY" 2>/dev/null | cut -d'|' -f2)
  local count=0
  local pane
  while IFS= read -r pane; do
    [ -z "$pane" ] && continue
    private.hiveMind.state.set "$pane" "$state" "${callerRole:-operator}"
    count=$((count + 1))
  done < <(grep "^${session}:" "$HIVEMIND_REGISTRY" 2>/dev/null | cut -d'|' -f1)
  success.log "Set $count agents in $session → $state"
}
