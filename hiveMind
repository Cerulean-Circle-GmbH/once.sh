      "$pane" "${role:-unknown}" "$state" "${uuid:--}"
    count=$((count + 1))
  done < <(private.hiveMind.agents.discover)

  echo -e "${GRAY}$(printf '%.0s─' {1..105})${NORMAL}"
  echo -e "${BOLD_WHITE}$count${NORMAL} active agents"
}

