# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

: ${HIVEMIND_SESSION:=hivemind}
: ${HIVEMIND_MAIN_PANE_SIZE:=60}
: ${HIVEMIND_BASE_PORT:=11080}

# Default agent roles
HIVEMIND_DEFAULT_AGENTS=(
  "orchestrator"
  "coder"
  "tester"
  "reviewer"
)

# OOSH specialized agent roles
HIVEMIND_OOSH_AGENTS=(
  "oosh-expert"
  "oosh-tester"
)

# Agent role descriptions (used for system prompts)
declare -A HIVEMIND_ROLE_PROMPTS
HIVEMIND_ROLE_PROMPTS["orchestrator"]="You coordinate tasks between agents and manage workflow."
HIVEMIND_ROLE_PROMPTS["coder"]="You implement features and write code."
HIVEMIND_ROLE_PROMPTS["tester"]="You write and run tests."
HIVEMIND_ROLE_PROMPTS["reviewer"]="You review code for quality and best practices."
HIVEMIND_ROLE_PROMPTS["oosh-expert"]="You are an OOSH framework expert. Read .cursor/skills/oosh-expert/SKILL.md to learn your role. Specialize in architecture, method patterns, completion system (c2), and framework development."
HIVEMIND_ROLE_PROMPTS["oosh-tester"]="You are an OOSH testing specialist. Read .cursor/skills/oosh-tester/SKILL.md to learn your role. Specialize in test.suite, writing tests, and validating oosh scripts."
HIVEMIND_ROLE_PROMPTS["oosh-orchestrator"]="You are the hiveMind orchestrator. Read .cursor/skills/oosh-orchestrator/SKILL.md to learn your role. You coordinate expert and tester agents, delegate tasks, and maintain context in sessions/agent.context.md. Always update context before /compact."

# ─────────────────────────────────────────────────────────────────────────────
# PRIVATE HELPERS
# ─────────────────────────────────────────────────────────────────────────────

private.hiveMind.get.agents() {
  # Get all agent IDs from agentRoom
  agentRoom list.ids 2>/dev/null
}

private.hiveMind.get.agent.port() {
  local agent_id="$1"
  agentRoom list 2>/dev/null | grep "^$agent_id " | awk '{print $2}'
}

private.hiveMind.pane.for.agent() {
  local agent_id="$1"
  tmux list-panes -a -F "#{pane_id} #{pane_title}" 2>/dev/null | grep "$agent_id" | awk '{print $1}' | head -1
}

private.hiveMind.create.agent.pane() {
  local agent_id="$1"
  local port="$2"
  local workdir="${3:-$(pwd)}"
  local window="${4:-agents}"

  # Select or create agents window
  if ! tmux list-windows -F "#{window_name}" 2>/dev/null | grep -q "^${window}$"; then
    tmux new-window -n "$window"
  else
    tmux select-window -t "$window"
  fi

  # Create new pane
  tmux split-window -h
  tmux select-layout tiled

  # Get the new pane
  local pane_id=$(tmux display-message -p "#{pane_id}")

  # Set pane title
  tmux select-pane -t "$pane_id" -T "$agent_id"

  # Start Claude Code in the pane with agent role
  tmux send-keys -t "$pane_id" "cd '$workdir' && claude --dangerously-skip-permissions" Enter

  echo "$pane_id"
}

