private.config.orig.import()     # <origDir> <sharedConfig> # carry an allow-listed few values from a kept-aside ~/config (origDir) into the shared config, read as data and never sourced, only into empty values: LOG_LEVEL when a valid level, the computer name OOSH_SSH_CONFIG_HOST through private.config.host.name.get; never PATH HOME LOG_DEVICE OOSH_DIR OOSH_MODE CONFIG_CHAIN_*; every other variable is reported; RESULT imported: <names or none> | skipped: <count>; rc 1 for a missing argument, rc 2 and RESULT cannot write <file> when a write fails #
{
 # Why: a heal links ~/config to the shared config; a REAL ~/config (the
 # boss's Mac: 95 files in an old format) is kept aside as config.orig.<ts> by
 # private.this.symlink.with.backup, and a few of its values belong in the
 # shared config (T-CONFIG-ORIG-IMPORT-ALLOWLIST). Owner decision 2026-10-07:
 #   allow-list  LOG_LEVEL (a level log.level offers, log.level.completion.levelno)
 #               OOSH_SSH_CONFIG_HOST (the router domain taken off, through
 #               private.config.host.name.get, shape by private.config.host.name.valid)
 #               — there is no e-mail variable in the config model, none is carried
 #   never-list  PATH HOME LOG_DEVICE OOSH_DIR OOSH_MODE CONFIG_CHAIN_* — skipped
 #               silently, one summary line
 #   any other   one info line each: "orig.import: skipped NAME (not carried over)"
 # Only into an EMPTY shared value (a missing line is empty): a value the
 # shared config already has is kept. Every file is read as DATA through
 # private.config.env.names.read / env.value.read — nothing is sourced (the old
 # files may hold code), nothing in <origDir> is written, the last assignment
 # of a name wins (user.env, oosh.env, log.env), as in a shell. The line is
 # rendered by private.this.env.export.line.get (the renderer config save
 # uses) and written by private.config.env.line.set — in place, one write, the
 # chain block kept last.
 # RESULT: "imported: <names or none> | skipped: <count of the other names>".
 # rc 1 for a missing argument; rc 2 and RESULT "cannot write <file> …" for a
 # write that failed, the convention of the migrates (docs/config.md).
 local origDir="$1" sharedConfig="$2"
 if [ -z "$origDir" ] || [ -z "$sharedConfig" ]; then
   create.result 1 "private.config.orig.import requires <origDir> <sharedConfig>"
   error.log "$RESULT"
   return $(result)
 fi
 local f name seen=" " total=0
 for f in user.env oosh.env log.env; do
   while IFS= read -r name; do
     [ -n "$name" ] || continue
     case "$seen" in *" $name "*) continue ;; esac
     seen="$seen$name "; total=$((total + 1))
   done <<NAMES
$(private.config.env.names.read "$origDir/$f")
NAMES
 done

 local never="" imported="" count=0 writeFailed="" file value v current line
 for name in $seen; do
   case "$name" in
     PATH|HOME|LOG_DEVICE|OOSH_DIR|OOSH_MODE|CONFIG_CHAIN_*)
       never="$never $name"; continue ;;
     LOG_LEVEL)            file="$sharedConfig/log.env" ;;
     OOSH_SSH_CONFIG_HOST) file="$sharedConfig/oosh.env" ;;
     *)
       info.log "orig.import: skipped $name (not carried over)"; continue ;;
   esac
   value=""
   for f in user.env oosh.env log.env; do
     v=$(private.config.env.value.read "$origDir/$f" "$name") && value="$v"
   done
   [ -n "$value" ] || { info.log "orig.import: skipped $name (empty)"; continue; }
   case "$name" in
     LOG_LEVEL)
       case " $(log.level.completion.levelno) " in *" $value "*) v="$value" ;; *) v="" ;; esac ;;
     OOSH_SSH_CONFIG_HOST)
       v=$(private.config.host.name.get "${value%%.*}")
       private.config.host.name.valid "$v" || v="" ;;
   esac
   [ -n "$v" ] || { info.log "orig.import: skipped $name (not a valid value: $value)"; continue; }
   if [ ! -f "$file" ]; then
     info.log "orig.import: skipped $name (no shared $file)"; continue
   fi
   current=$(private.config.env.value.read "$file" "$name")
   if [ -n "$current" ]; then
     info.log "orig.import: kept $name=$current (the shared config has one)"; continue
   fi
   line=$(private.this.env.export.line.get "$name" "$v") || { info.log "orig.import: skipped $name (not a valid value: $value)"; continue; }
   if ! private.config.env.line.set "$file" "$name" "$line"; then
     writeFailed="$writeFailed $file"; continue
   fi
   imported="$imported $name"; count=$((count + 1))
   info.log "orig.import: carried $name=$v into $file"
 done
 [ -n "$never" ] && info.log "orig.import: never carried over:$never"

 if [ -n "$writeFailed" ]; then
   create.result 2 "cannot write${writeFailed} — orig.import carried${imported:- nothing}"
   return $(result)
 fi
 imported="${imported# }"
 create.result 0 "imported: ${imported:-none} | skipped: $((total - count))"
 return $(result)
}


