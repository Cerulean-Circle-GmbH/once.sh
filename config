config.anchors.init()     #  # set CONFIG_PATH (kept when given, else ~/config), CONFIG_FILE and CONFIG in this shell and create CONFIG_PATH when absent — no check, no repair: the cheap path config.start, config file reset and the this bootstrap use #
{
  # The CHEAP half of what config.init used to be, unchanged: config.start,
  # `config file reset` / `config location reset` and the `this` bootstrap
  # need the anchors on every call, never a repair (init/oosh runs `this`
  # during install, as root). `config init` is the user-facing check + repair.
  #
  # HONOUR an anchor already set; default to the constant when there is none —
  # an unconditional export here undid test fixtures from inside the file under
  # test (T72). private.this.anchor.validate.one counts this shape CONFORMING.
  # CONFIG_FILE is not an anchor: `config file reset` means "back to user.env".
  : ${CONFIG_PATH:=~/config}
  export CONFIG_PATH
  export CONFIG_FILE=user.env

  if [ ! -d $CONFIG_PATH ]; then
    mkdir $CONFIG_PATH
  fi
  touch $CONFIG_PATH/error.txt

  export CONFIG=$CONFIG_PATH/$CONFIG_FILE
  debug.log "$CONFIG"
}


config.anchors.init.completion() { :; }
private.config.healthy()     #  # rc 0 when the config is usable: CONFIG_PATH and user.env exist, ~/config and ~/oosh resolve, and private.config.required.missing.get reports nothing but a version: stamp (reported, never auto-repaired); no writes #
{
 # A predicate: rc only, no create.result worth keeping, NO writes — it runs on
 # every `config init`, so a healthy config stays fast and untouched (T106).
 [ -d "$CONFIG_PATH" ] || return 1
 [ -f "$CONFIG_PATH/user.env" ] || return 1
 [ -d "${OOSH_DIR:-$HOME/oosh}" ] || return 1              # a dangling ~/oosh is not -d
 [ ! -L "$HOME/config" ] || [ -d "$HOME/config" ] || return 1   # a dangling ~/config
 # Every reason but version: — a stamp of another branch version is reported
 # by config validate required and rewritten only by an explicit config
 # init.env. Acting on it here made two users on different branch versions
 # rewrite the SHARED user.env into their own format on every config init and
 # oo mode (F3); which format the shared tier carries is an operator decision.
 [ -z "$(private.config.required.missing.get | grep -v '^version:')" ]
}


private.config.variable.persistable()     # <variableName> # rc 0 when <variableName> may be persisted to a shared env file — not an anchor, not per user, not install input; the ONE never-persist list, used by config save and by init.env refuse-to-worsen guard #
{
 # A predicate: rc only. The ONE never-persist list — it was inline in
 # private.config.variables.list, so the refuse-to-worsen guard in
 # config.init.env could not ask it and mistook a migration for damage (T108).
 # Anchors and per-session/per-user values, install input, the version stamp
 # the user.env head writes, and OOSH_MODE, which is per user (T100).
 # docs/config.md's exclusion table and T29's leaker list mirror it.
 case "$1" in
   *INSTALL*|LOG_NAME|LOG_LIVE|LOG_DEVICE|CONFIG_PATH|OOSH_USER_CONFIG_PATH|CONFIG|OOSH_DIR|OOSH_COMPONENTS_DIR|OOSH_BRANCH|OOSH_CONFIG_VERSION|OOSH_MODE|OOSH_WORKTREE_BASE|SUDO_*|_) return 1 ;;
 esac
 return 0
}


private.config.required.carry()     # <fileKey> <path> # export every required variable of the manifest file <fileKey> that this shell lacks, with the value <path> already holds (evaluated as the pure-data line it is, escapes intact) — the one carry-forward rule of config save and config user.save #
{
 # One rule, two writers (config.save, config.user.save): a required variable
 # the shell lacks keeps the value its file already had — nothing that was
 # there is thrown away by a shell that simply does not hold it. The line is
 # pure data (config.validate), so it is evaluated in a subshell: the old
 # cut/sed strip kept backslash escapes and changed a quoted value every save.
 local fileKey="$1" path="$2" variable file rest value
 [ -f "$path" ] || return 0
 while read -r variable file rest; do
   [ "$file" = "$fileKey" ] || continue
   [ -n "${!variable}" ] && continue
   value=$(private.config.file.value.get "$path" "$variable")
   [ -n "$value" ] && export "$variable=$value"
 done <<REQUIRED
$(private.config.required.variables.get)
REQUIRED
 return 0
}


private.config.manifest.files.get()     #  # the manifest env files required NOW, one name per line without .env: a file with a derived row always; a file with only kept rows when it exists, a value is set, or one of its derivers answers — so ODOCKER_WORKSPACES does not make a Docker-less host unhealthy #
{
 # A getter consumed as $(…): no create.result. Used by config.save (which
 # files to write), private.config.chain.files.get (which files user.env must
 # load) and config.validate.required (which rows are required) — one answer.
 # A `derived` row: the host or the checkout is its truth, always required. A
 # file whose rows are all `kept` is a user's choice: required when the file
 # exists, a value is set in this shell, or a deriver answers (F2: on a host
 # with no components base, ODOCKER_WORKSPACES derives nothing — Docker is
 # optional, the shared config is healthy without it).
 local variable file deriver authority name seen=" " required v f d a
 while read -r variable file deriver authority; do
   [ -z "$variable" ] && continue
   case "$file" in user.env|"~"*) continue ;; esac
   name="${file%.env}"
   case "$seen" in *" $name "*) continue ;; esac
   seen="$seen$name "
   required=""
   [ -f "$CONFIG_PATH/$file" ] && required=1
   if [ -z "$required" ]; then
     while read -r v f d a; do
       [ "$f" = "$file" ] || continue
       [ "$a" = derived ] && { required=1; break; }
       [ -n "${!v}" ] && { required=1; break; }
       [ "$(type -t "$d")" = function ] && [ -n "$("$d" 2>/dev/null)" ] && { required=1; break; }
     done <<MANIFEST
$(private.config.required.variables.get)
MANIFEST
   fi
   [ -n "$required" ] && echo "$name"
 done <<MANIFEST
$(private.config.required.variables.get)
MANIFEST
 return 0
}


private.config.required.missing.get()     #  # every reason the persisted config is not the one this branch needs, one token per line: <variable>, file:<name>, load:<name>, stale:<v>@<file>, version:<got>(expected:<want>), anchor:<line>, drift:<persisted>|<actual> — empty when complete; the one list config validate required reports and private.config.healthy acts on #
{
 # A getter consumed as $(…): no create.result. The computation that lived in
 # config.validate.required, moved out so that the report (validate.required)
 # and the decision to REPAIR (private.config.healthy) read one list and can
 # weigh its tokens differently: a version: token is a report for the
 # operator, never a reason to rewrite the shared boot file by itself (F3).
  local missing="" variable file rest manifestFiles
  manifestFiles=" $(private.config.manifest.files.get | tr '\n' ' ') "
  while read -r variable file rest; do
    [ -z "$variable" ] && continue
    # A row of an OPTIONAL manifest file (all rows kept, file absent, nothing
    # to derive — private.config.manifest.files.get) is not missing (F2).
    case "$file" in user.env|"~"*) ;; *) case "$manifestFiles" in *" ${file%.env} "*) ;; *) continue ;; esac ;; esac
    local requiredPath="$CONFIG_PATH/$file"
    case "$file" in "~"*) requiredPath="${OOSH_USER_CONFIG_PATH:-$HOME/.config/oosh}/${file#\~}" ;; esac
    grep -qE "^[[:space:]]*(export[[:space:]]+)?${variable}=" "$requiredPath" 2>/dev/null \
      || missing="$missing $variable"
  done <<REQUIRED
$(private.config.required.variables.get)
REQUIRED

  # Every env file user.env must load exists and is loaded — a missing
  # odocker.env or a lost load line is a broken config too.
  local chainName
  for chainName in $(private.config.chain.files.get "$CONFIG_PATH/user.env"); do
    [ -f "$CONFIG_PATH/$chainName.env" ] || missing="$missing file:$chainName.env"
    grep -qxF ". \$CONFIG_PATH/$chainName.env" "$CONFIG_PATH/user.env" 2>/dev/null || missing="$missing load:$chainName.env"
    # A never-persist variable left in a shared file (the legacy OOSH_MODE in
    # oosh.env, T100) makes the config unhealthy, so config init migrates it.
    local staleName
    for staleName in $(sed -n 's/^[[:space:]]*export[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$CONFIG_PATH/$chainName.env" 2>/dev/null); do
      private.config.variable.persistable "$staleName" || missing="$missing stale:$staleName@$chainName.env"
    done
  done

  # Logic in an env file makes the config unhealthy, so config init rewrites
  # it: the guarded per-user load line of 2026-09-28 (either form) is the case
  # in the field. config.validate is the one judge; rc 2 is a missing file,
  # which the file: tokens above already name.
  local logicName logicRc
  for logicName in user $(private.config.chain.files.get "$CONFIG_PATH/user.env"); do
    config.validate "$CONFIG_PATH/$logicName.env" >/dev/null 2>&1; logicRc=$?
    [ "$logicRc" -eq 1 ] && missing="$missing logic:$logicName.env"
  done

  # The config-format stamp: a config written by another branch version is
  # foreign, not merely incomplete (a missing stamp is caught by the table).
  local persistedVersion expectedVersion
  expectedVersion=$(private.config.version.get)
  persistedVersion=$(grep -m1 -E '^export OOSH_CONFIG_VERSION=' "$CONFIG_PATH/user.env" 2>/dev/null | cut -d= -f2- | tr -d '"')
  [ -n "$persistedVersion" ] && [ "$persistedVersion" != "$expectedVersion" ] \
    && missing="$missing version:OOSH_CONFIG_VERSION=$persistedVersion(expected:$expectedVersion)"

  # The boot data: every anchor line the emitter writes must be present verbatim.
  local anchorLine
  while IFS= read -r anchorLine; do
    # path-exception: a READ pattern that matches the emitter's line, not a PATH
    # assignment — the two host-specific lines are skipped by this check.
    case "$anchorLine" in 'export BASH_FILE='*|'export PATH="'/*|'export OOSH_CONFIG_VERSION='*) continue ;; esac
    grep -Fxq "$anchorLine" "$CONFIG_PATH/user.env" 2>/dev/null || missing="$missing anchor:${anchorLine#export }"
  done <<< "$(private.config.anchor.lines.get "${BASH_FILE:-/bin/bash}")"

  # Branch drift: the persisted OOSH_MODE against the branch ~/oosh actually
  # points at. This is the T7 bug — persisted prod/released on a dev box, with
  # nothing in the tree ever comparing the two.
  local drift="" persistedMode actualMode
  persistedMode=$(grep -m1 -E "^[[:space:]]*(export[[:space:]]+)?OOSH_MODE=" "${OOSH_USER_CONFIG_PATH:-$HOME/.config/oosh}/oosh.user.env" 2>/dev/null \
                  | cut -d= -f2- | tr -d '"')
  # The SAME accessor the repair uses. This was two inline steps here and two
  # more at oo:2631-2633; three answers to "which branch is this host on" could
  # drift apart, and the drift check disagreeing with the repair is the one
  # disagreement that would be hardest to see.
  actualMode=$(private.config.derive.oosh.mode 2>/dev/null)
  if [ -n "$persistedMode" ] && [ -n "$actualMode" ] && [ "$persistedMode" != "$actualMode" ]; then
    drift="OOSH_MODE=$persistedMode but ~/oosh is on $actualMode"
  fi
  local token
  for token in $missing; do echo "$token"; done
  [ -n "$persistedMode" ] && [ -n "$actualMode" ] && [ "$persistedMode" != "$actualMode" ] && echo "drift:$persistedMode|$actualMode"
  return 0
}


private.config.user.mode.save()     #  # write the per-user data file of the user this runs as, from where ~/oosh points: derive OOSH_MODE (private.config.derive.oosh.mode), then config user.save — the step an as-user hop runs for a user who never ran config save #
{
 # ONE definition for both as-user hops (config.init.user, user.oosh.install).
 # config save writes oosh.user.env only for whoever runs it; the install runs
 # as root, so every other installed user had no file and an empty OOSH_MODE.
 # DERIVED, never the caller's: the hop preamble unsets the caller's OOSH_MODE
 # and OOSH_USER_CONFIG_PATH, and the branch is read from THIS user's ~/oosh.
 local mode
 mode=$(private.config.derive.oosh.mode 2>/dev/null)
 if [ -z "$mode" ]; then
   create.result 1 "no branch derivable from $HOME/oosh — per-user file not written"
   return $(result)
 fi
 export OOSH_MODE="$mode"
 config.user.save >/dev/null || return $(result)
 create.result 0 "OOSH_MODE=$mode written for ${USER:-$(id -un)}"
 return $(result)
}


private.config.file.value.get()     # <path> <variable> # echo the value the env file <path> holds for <variable>, evaluated as the pure-data line it is (escapes intact); empty when the file has no such line #
{
 # A getter consumed as $(…): no create.result. ONE reader for both carry
 # rules. The line is pure data (config.validate), so it is evaluated — in the
 # $( ) subshell, nothing reaches the caller — instead of stripped with
 # cut/sed, which kept backslash escapes and changed a quoted value every save.
 local path="$1" variable="$2" line
 [ -f "$path" ] || return 0
 line=$(grep -m1 -E "^[[:space:]]*(export[[:space:]]+)?${variable}=" "$path" 2>/dev/null)
 [ -n "$line" ] || return 0
 eval "$line" 2>/dev/null
 printf "%s" "${!variable}"
 return 0
}


private.config.file.carry()     # <path> <?envPrefix> # export every persistable variable the env file <path> holds and this shell lacks — of the family <envPrefix> when given — so a save never drops a value only because the saving shell does not hold it; config unset is how a variable is removed #
{
 # The GENERAL carry-forward (private.config.required.carry is the manifest
 # one). config save writes what the shell holds; a shell that lacks a
 # variable used to rewrite the file without it, and only MANIFEST variables
 # were protected. So the install shell, which has no LOG_LEVEL_RESET, dropped
 # it from log.env, and config init.env answered "REFUSING — log.env went from
 # 2 to 1 export lines" on every fresh install (tart sequoia VM, 2026-09-29).
 # A never-persist variable is NOT carried: leaving the shared tier is how a
 # migration works (OOSH_MODE, T108). Only the family the save writes is
 # carried, so nothing foreign is exported into the shell. No create.result:
 # it runs inside config.save.
 local path="$1" envPrefix="${2%_}" variable value
 [ -f "$path" ] || return 0
 for variable in $(sed -n "s/^[[:space:]]*export[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p" "$path" 2>/dev/null); do
   [ -n "${!variable}" ] && continue
   private.config.variable.persistable "$variable" || continue
   if [ -n "$envPrefix" ]; then
     case "$variable" in ${envPrefix}|${envPrefix}_*) ;; *) continue ;; esac
   fi
   value=$(private.config.file.value.get "$path" "$variable")
   [ -n "$value" ] && export "$variable=$value"
 done
 return 0
}


