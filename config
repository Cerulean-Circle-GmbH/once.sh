private.config.file.resolve() # # echo the effective file for the current $CONFIG_FILE — shared $CONFIG_PATH if present, else per-user $OOSH_USER_CONFIG_PATH
{
  # Two-tier config: the shared $CONFIG_PATH holds site-wide data (user.env,
  # oosh.env, log.env); the per-user $OOSH_USER_CONFIG_PATH holds private
  # per-user / per-session files (log.session.env). A name that exists only in
  # the per-user tier (e.g. `log.session`) resolves THERE. Callers pass through
  # config.file.check first, which sets $CONFIG_FILE. Pure echo — no global
  # mutation, so `config list log.session` never leaves $CONFIG repointed.
  local _shared="$CONFIG_PATH/$CONFIG_FILE"
  local _peruser="${OOSH_USER_CONFIG_PATH:-$HOME/.config/oosh}/$CONFIG_FILE"
  if [ ! -f "$_shared" ] && [ -f "$_peruser" ]; then
    echo "$_peruser"
  else
    echo "$_shared"
  fi
}

config.list() # <name:$CONFIG> # lists the content of the config with <name>
{
  # Listing is READ-ONLY: snapshot and restore the current-file globals so
  # `config list <name>` (which runs config.file.check, and which config.info.log
  # calls after save/clean) never leaves $CONFIG/$CONFIG_FILE repointed for the
  # rest of the shell — a later config.add/clean would otherwise write to / rm
  # the wrong file. Resolve the tier (shared, else per-user) for the view only.
  local _savedConfig="$CONFIG" _savedFile="$CONFIG_FILE"
  config.file.check $1
  cat "$(private.config.file.resolve)"
  CONFIG="$_savedConfig"; CONFIG_FILE="$_savedFile"
}

config.delete() # <name:$CONFIG> # deletes the config with <name>
{
  config.file.check $1
  # Tier-aware so `config delete log.session` removes the real per-user file
  # rather than a non-existent shared one (symmetry with config.list).
  rm "$(private.config.file.resolve)"
}

config.update() { # <?name:$CONFIG> <?ENV_PREFIX> # saves and adds the config 
  config.save $1 $2
  config.add $1 $2
  config.info.log
}

config.info.log() # # logs the config when on LOG_LEVEL info or higher
{
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.edit() # <name:$CONFIG> # edits the config with <name> in vim
{
  #check.debug.level 6
  oo cmd vim
  # Tier-aware (shared, else per-user) so editing `log.session` opens the real
  # per-user file instead of creating a SHARED shadow that then masks it for
  # every user in `config list log.session`. Symmetry with list/delete.
  local _f
  if config.file.check $1; then
    _f="$(private.config.file.resolve)"
    vim "$_f"
  else
    _f="$(private.config.file.resolve)"
    vim "$_f"
    exit $ERROR_CODE_RECONFIG
  fi
}

config.clean() #  # reinitalises a clean config and removes any custom addons
{
  config.file.check $1
  # Order-preserving de-dup (drop duplicate lines, keep first occurrence).
  # Kept order-preserving rather than `sort -u` as a matter of hygiene — env
  # files are now pure `export K="V"` data (no bootstrap header to protect;
  # config.save emits the anchor header into user.env), so order is no
  # longer load-bearing,
  # but there's no reason to alphabetically shuffle a user's config either.
  awk '!seen[$0]++' "$CONFIG" >"$CONFIG_PATH/$CONFIG_FILE.clean"
  rm $CONFIG_PATH/$CONFIG_FILE
  mv $CONFIG_PATH/$CONFIG_FILE.clean $CONFIG_PATH/$CONFIG_FILE
  private.ensure.groupWrite "$CONFIG_PATH/$CONFIG_FILE"
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.add() # <name:$CONFIG> # adds the config <name> into the user.env permanently
{
  local file=$1
  shift
  local name=$1

  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    # NOT `${file^^}` below. That is bash 4+, and on macOS /bin/bash 3.2 it is
    # not a warning but a FATAL "bad substitution" — the shell EXITS (measured
    # on a sequoia VM; the commands after it never ran). This branch is the
    # DOCUMENTED single-argument form — `config add oosh`, `config save myapp`
    # (docs/config.md) — so on macOS a documented command killed the user's
    # shell. The `warn.log "BASH 5 support only"` that stood here was never a
    # mitigation: the line under it had already ended the shell.
    name=$(private.config.string.upper "$file")
  else
    shift
  fi

  if [ -z "$file" ]; then
    name="CONFIG"
  fi
  
  console.log "
  config.add [file:$file] [name:$name] to $CONFIG"
  {
    # POSIX `.` not bash `source` — env files are sourced directly by every
    # shell, which must parse under dash/ash (/bin/sh login shells, `ossh exec`
    # on Debian). `source` is a bashism (dash: "source: not found").
    echo . \$CONFIG_PATH/$file.env
  } >>$CONFIG
  config.clean
}

config.file.check() # <name:$CONFIG> # sets the default config file to <name> if it exists
{
  if [ -n "$1" ]; then
    config.file $1.env
    shift
    RETURN=$1
    RETURN_VALUE=0
  else
    RETURN_VALUE=1
  fi
  info.log "config file: $CONFIG"
  create.result $RETURN_VALUE $CONFIG
  return "$(result)"

}

config.file() # <configfile> # sets the default config file to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.anchors.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        export FILE=$1
        CONFIG_FILE=$FILE

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
    esac
  fi
}

config.location() # <configfile> # sets the default config location to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.anchors.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        local oldConfig="$CONFIG"

        # config-path-exception: `config file <path>` deliberately points the
        # session at an ARBITRARY config file, so CONFIG_PATH must come from
        # that path — this is the one method whose job is to leave ~/config.
        export FILE=$(basename $1)
        CONFIG_PATH=$(dirname $1)
        CONFIG_FILE=$FILE

        info.log "old config     : $oldConfig"
        info.log "new config path: $CONFIG_PATH"
        info.log "new config file: $CONFIG_FILE"

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
        config.save
        bash
    esac
  fi
}

