 id=$(private.this.host.name.get)
 [ -n "$id" ] || return 1
 line=$(docker container inspect -f '{{.Id}} {{.Name}}' "$id" 2>/dev/null) || return 1 # kernel-exception: pre-existing on dev, out of the heal scope
 case "${line%% *}" in "$id"*) ;; *) return 1 ;; esac
