private.config.variables.list()     # <envPrefix> # echo one variable NAME per line for every set, scalar, persistable variable matching envPrefix #
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell,
  # so RESULT could never reach the caller. Same reasoning as
  # private.config.required.variables.get and private.config.file.resolve.
  #
  # SILENT BY CONTRACT. The only caller runs inside `{ … } >$CONFIG`, and
  # log:35 sets LOG_DEVICE=/proc/self/fd/1 — inside that block fd 1 IS the
  # generated env file. One debug.log here would be written into it.
  #
  # compgen -v, NOT `declare -p` with no names. On bash 3.2 the no-argument
  # form behaves like bare `declare`: `set`-style output AND every function
  # body, verbatim and multi-line, in the same stream. That is how rows of
  # private.config.required.variables.get's heredoc became lines in
  # ~/config/oosh.env — docs/research/2026-09-17-config-save-bash32.md § 2.
  # `compgen -v` emits variable NAMES ONLY, on 3.2 and 5 alike (measured).
  #
  # ${1%_}: `backup config.save global` passes BACKUP_ (backup:262). With the
  # underscore already there the prefix gate read `BACKUP_|BACKUP__*`, which
  # BACKUP_TARGET matches neither, so backup.env was always written empty.
  local envPrefix="${1%_}"
  local variableName
  # These two locals are themselves listed by `compgen -v`, exactly as they
  # were by `declare -p`. camelCase cannot match an OOSH_/LOG_/CONFIG/OS_CMD_
  # prefix, so the harvest set is unchanged.
  # Read LINE BY LINE, never `for … in $(compgen -v)`. Unquoted command
  # substitution word-splits, which would SHRED a malformed row into its words
  # and let the first one through as if it were a name — the shape gate would
  # then be passing by accident. A line is the unit being validated.
  compgen -v 2>/dev/null | while IFS= read -r variableName; do
    # SHAPE GATE. The old filter derived a name with three string-strips
    # (`${_line#declare }`, `${_vn#-* }`, `${_vn%%=*}`) and never checked the
    # result was a name at all: a line with no `=` survived the last strip
    # whole, and a `case` glob spans spaces, so the row
    # `OOSH_MODE oosh.env basename of the canonical ~/oosh` matched `OOSH_*`
    # and was written out as if it were a variable.
    case "$variableName" in
      [A-Za-z_]*) ;;
      *) continue ;;
    esac
    case "$variableName" in *[!A-Za-z0-9_]*) continue ;; esac
    # Prefix as a whole name or a `name_…` family — never `${envPrefix}*`,
    # which for LOG would also grab LOGNAME.
    case "$variableName" in ${envPrefix}|${envPrefix}_*) ;; *) continue ;; esac
    private.config.variable.persistable "$variableName" || continue
    echo "$variableName"
  done
}

private.config.variable.export.line()     # <variableName> # echo ONE export line for a set scalar variable; rc 1 for unset, array, or a value bash renders with ANSI-C quoting #
{
  # NO create.result — a getter consumed as $(...); it also runs in a loop and
  # would clobber the caller's RESULT on every iteration (config.save sets
  # RESULT="" before the block on purpose). SILENT BY CONTRACT, same fd-1
  # reason as private.config.variables.list.
  local variableName="$1"
  local declaration assignment
  # `declare -p` WITH AN EXPLICIT NAME — measured correct on bash 3.2.57
  # (`declare -- FOO="bar"`, `declare -a A='([0]="x")'`), unlike the
  # no-argument form. Bash does the quoting, so we hand-roll no escaper: the
  # same precedent, and the same reason, as result.into (this:719-728), whose
  # comment records what a bare `echo "$1=$value"` did to values with spaces.
  declaration=$(declare -p "$variableName" 2>/dev/null) || return 1
  case "$declaration" in
    'declare -a'*|'declare -A'*|'typeset -a'*|'typeset -A'*) return 1 ;;
  esac
  assignment="${declaration#declare -* }"
  # Output-side shape gate: refuse anything that is not `NAME=…` rather than
  # guess. `declare -- X` — declared, never assigned — lands here.
  case "$assignment" in "${variableName}="*) ;; *) return 1 ;; esac
  # TWO gates, and the first one is the one that matters.
  #
  # (1) THE VALUE. These files are LINE-ORIENTED — config.validate and
  # test.platform.shared.config.env.invariant both read them one line at a time
  # — so a value carrying a newline cannot be written at all, whatever quoting
  # bash chooses for it. Nothing in the OOSH_/LOG_/CONFIG_ families is designed
  # to hold one, so a value that does is an upstream bug, and
  # `config validate required` is the detector that names it as missing.
  #
  # Testing the RENDERING instead of the value was a real defect, caught by T77
  # on almalinux 9 during `oo stage testing` on 2026-09-18. `$'…'` is what bash
  # >= 5.2 emits; bash 5.1 emits a DOUBLE-QUOTED string with a literal newline
  # inside it — measured identically on almalinux 9 (5.1.8), ubuntu 22.04
  # (5.1.16) and debian 11 (5.1.4). So gate (2) below matched nothing on any of
  # them, and a two-line assignment was written into oosh.env. The comment that
  # used to sit here claimed ANSI-C quoting happened "on 3.2 as well as 5";
  # that was never measured and is false for every 5.1.
  local value="${!variableName}"
  # EVERY control character, not only newline and carriage return: a tab or an
  # ESC is rendered $'…' by bash >= 5.2 and 3.2 (refused by gate 2) but as a
  # plain double-quoted string with the raw character inside by bash 5.1 — so
  # on AlmaLinux 9 the same value was WRITTEN that every other platform refused
  # and reported (T116 red on bash 5.1.8, 2026-09-29). Judged by the value, the
  # answer no longer depends on the bash that happens to run the save.
  case "$value" in *[[:cntrl:]]*) return 1 ;; esac
  # (2) THE RENDERING, still worth keeping: if bash reaches for $'…' for any
  # other reason, that is a BASHISM, and every shell — including dash/ash
  # /bin/sh login shells — sources these files directly, and dash/ash read
  # $'…' literally (review-2026-09-09 § D1).
  case "$assignment" in "${variableName}=\$'"*) return 1 ;; esac
  # PREPEND `export`. The old code sed-patched a `declare -` prefix into it,
  # which bash 3.2's no-argument form never prints — so on macOS the
  # substitution silently did nothing and no generated env file has ever
  # carried `export`.
  echo "export $assignment"
}

private.config.variables.export()     # <envPrefix> # echo the complete body of an env file: one export line per persistable variable matching envPrefix #
{
  # NO create.result — its stdout IS the file. SILENT BY CONTRACT.
  #
  # review-2026-09-09 § M3 named this before it existed: "config.save's
  # `declare -p | while read` harvesting loop is a 12-line inline block that
  # reads as private.config.vars.export <prefix>". Spelled with the full word
  # `variables` to match private.config.required.variables.get in this file.
  local envPrefix="$1"
  local variableName
  # Line by line, for the same reason as private.config.variables.list.
  private.config.variables.list "$envPrefix" | while IFS= read -r variableName; do
    private.config.variable.export.line "$variableName"
  done
}

private.config.string.upper()     # <string> # echo string upper-cased, without the bash-4 parameter expansion operator #
{
  # NO create.result — a getter consumed as $(...).
  #
  # `${string^^}` is bash 4+. On macOS /bin/bash 3.2 it is not a warning but a
  # FATAL "bad substitution" — the shell EXITS, measured on a sequoia VM. Both
  # config.save and config.add reached it from their DOCUMENTED single-argument
  # form (`config add oosh`, docs/config.md), so on macOS a documented command
  # killed the user's shell.
  #
  # printf | tr, not `tr <<< "$1"`: a here-string creates a temp file in
  # $TMPDIR, and this runs as root during install.
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

# ── The required-variable derivers ───────────────────────────────────────────
# One per row of private.config.required.variables.get, whose third column now
# names the function instead of describing it in prose. Before this, that column
# was documentation of a repair that did not exist (F6), which is why
# config.init.env could only re-persist the gap it was asked to fix (F5).
#
# All six are GETTERS consumed as $(...), which runs in a subshell — so none
# calls create.result, the same exemption every other private.config.* getter
# carries. They DERIVE ONLY: none assigns, none persists, none writes a file.
# That separation is deliberate. `oo pm.discover` reaches `config save`
# internally (oo:3045-3053 → config:740's log.device HACK → a recursive
# `config save log LOG`), so derivation belongs in the REPAIR and never in the
# WRITER. See docs/research/2026-09-17-config-save-bash32.md § 2.

private.config.derive.oosh.mode()     # # the branch $HOME/oosh actually points at: its path relative to the components base (test/macos for a slash branch), the basename when no base is detectable #
{
  # The same two steps config.validate.required's drift check used inline
  # (and oo:2631-2633 a third time). Now one accessor, so the check and the
  # repair cannot disagree about what "the branch this host is on" means.
  # private.this.path.canonical, not `readlink -f` — the latter is GNU-only.
  local ooshTarget
  ooshTarget=$(private.this.path.canonical "$HOME/oosh" 2>/dev/null) || return 1
  [ -n "$ooshTarget" ] || return 1
  # A ~/oosh that is not there canonicalises to itself; that is not a branch.
  [ -d "$ooshTarget" ] || return 1
  # RELATIVE to the components base, not the basename: `oo mode test/macos`
  # clones to <base>/test/macos and writes OOSH_MODE="test/macos" — the
  # basename `macos` never agreed with it, so the drift check failed on every
  # switch and init.env rewrote the per-user file to `macos` (F5). oo is
  # loaded the documented way; no base → the basename, as before.
  local base
  private.this.script.load oo oo.mode.base.get
  base=$(oo.mode.base.get 2>/dev/null)
  [ -n "$base" ] && base=$(private.this.path.canonical "$base" 2>/dev/null || echo "$base")
  case "$base" in
    "") echo "${ooshTarget##*/}" ;;
    *)  case "$ooshTarget" in
          "$base"/*) echo "${ooshTarget#"$base"/}" ;;
          *) echo "${ooshTarget##*/}" ;;
        esac ;;
  esac
}

private.config.derive.oosh.os()     # # the OS family for this host, via os.check.env #
{
  # os.check.env owns the $OSTYPE mapping and already sets OOSH_OS only when it
  # is empty, so calling it is safe whether or not the value is known. `config`
  # does not source `os`; the on-demand guard is the established route here
  # (config:215, config:235, oo:472).
  [ "$(type -t os.check.env)" = "function" ] || source "$OOSH_DIR/os" >/dev/null 2>&1
  [ "$(type -t os.check.env)" = "function" ] || return 1
  os.check.env >/dev/null 2>&1
  [ -n "$OOSH_OS" ] || return 1
  echo "$OOSH_OS"
}

private.config.derive.oosh.pm()     # # the package-manager install command for this host #
{
  # Already known? That IS the answer.
  [ -n "$OOSH_PM" ] && { echo "$OOSH_PM"; return 0; }
  # Second best: the binary survived even though the command did not.
  [ -n "$OOSH_PM_BIN" ] && { private.config.pm.command.get "$OOSH_PM_BIN"; return $?; }

  # NOT `oo pm.discover`. That verb is not a detector — it runs the platform's
  # package manager for real (`$SUDO apt-get update`, private.check.all.pm) and then
  # `config save`, so calling it from here hung a test run on a sudo password
  # prompt and would have re-entered the writer this card deliberately keeps
  # pure. test.suite:895-905 records the same trap being sprung once before.
  #
  # A DERIVER MUST HAVE NO SIDE EFFECTS. This is detection only: which package
  # manager exists, and what its install command is.
  local pmBin
  for pmBin in brew apt-get dnf yum apk pacman pkg; do
    command -v "$pmBin" >/dev/null 2>&1 || continue
    private.config.pm.command.get "$pmBin"
    return $?
  done
  return 1
}

private.config.pm.command.get()     # <packageManagerBinary> # the install command for a package-manager binary #
{
  # THE THIRD COPY of this table — init/oosh:214-222 has it in POSIX sh for the
  # bootstrap, and private.check.all.pm has it as arguments to private.check.pm. A
  # fourth would be indefensible; even this one is only justified because the
  # other two are unreachable from here (init/oosh self-installs when sourced,
  # and oo's copy is fused to the installer that runs sudo). Carded: one
  # side-effect-free `oo pm.detect` that all three call.
  case "$1" in
    brew)    echo "brew install" ;;
    apt-get) echo "apt-get -y install" ;;
    dnf)     echo "dnf -y install" ;;
    yum)     echo "yum -y install" ;;
    apk)     echo "apk add" ;;
    pacman)  echo "pacman -S --noconfirm" ;;
    pkg)     echo "pkg install -y" ;;
    *)       return 1 ;;
  esac
}

private.config.derive.bash.file()     # # the bash interpreter this host should use #
{
  # What config.save has always done inline (and this:1190, this:1322). On
  # macOS `command -v bash` can answer /bin/bash 3.2 while brew bash 5 is the
  # one the install chose, so an already-set value wins — user:696-700 picks
  # the interpreter and it is not this function's business to second-guess it.
  [ -n "$BASH_FILE" ] && { echo "$BASH_FILE"; return 0; }
  local found
  found=$(command -v bash 2>/dev/null) || return 1
  [ -n "$found" ] || return 1
  echo "$found"
}

private.config.derive.config.file()     # # the name of the config file a shell starts from #
{
  # A constant, and deliberately so: config.init and the anchor
  # header user.env carries both hard-set it, and `config file reset` means "go back to user.env". It is a
  # row in the required table because a config without it is broken, not
  # because it is ever in doubt.
  echo "user.env"
}

private.config.derive.log.level()     # # the default log level #
{
  # An already-set level wins — a host that has chosen one keeps it. The
  # fallback is 3, which is what this:16 and log:125 both actually use. The
  # table used to say "defaults to 1" and no code anywhere agreed with it.
  [ -n "$LOG_LEVEL" ] && { echo "$LOG_LEVEL"; return 0; }
  echo "3"
}
private.config.bashrc.ensure()     # <targetHome> <sharedOosh> <?stamp:now> # install bashrcTemplate into targetHome unless its .bashrc already sources ~/config/user.env on a live line; backs up whatever it replaces; ensures .bash_profile; run as the target user #
{
 # The hook is a LIVE line that sources user.env — `. "$HOME/config/user.env"`
 # (bashrcTemplate) or `… && . ~/config/user.env` (the appended fallback).
 # NOT the bare string config/user.env: every template era carries
 # `CONFIG=~/config/user.env` on line 9, so that guard matched a boot-era
 # .bashrc and the heal never replaced its dead `. "$HOME/oosh/boot"` (T86).
 # Same stamp format as config.init.user's `_ts`, so a run that converged the
 # symlinks and re-templated .bashrc leaves ONE timestamp behind, not two.
 local targetHome="$1" sharedOosh="$2" stamp="${3:-$(date +%Y%m%d-%H%M%S)}"
 local bashrc="$targetHome/.bashrc"
 local hook='(^|&&|;)[[:space:]]*(\.|source)[[:space:]]+"?(\$HOME|~)/config/user\.env'
 if ! grep -Eq "$hook" "$bashrc" 2>/dev/null; then
   # Back up whatever is replaced: the first ever to the one-shot
   # .bashrc.pre-oosh (the one-shot convention user.oosh.install started), any later one stamped, so a
   # second re-template cannot silently lose a hand-edited file.
   if [ -f "$bashrc" ]; then
     if [ ! -f "$targetHome/.bashrc.pre-oosh" ]; then
       cp "$bashrc" "$targetHome/.bashrc.pre-oosh"
     else
       cp "$bashrc" "$targetHome/.bashrc.orig.$stamp"
     fi
   fi
   if [ -f "$sharedOosh/templates/user/bashrcTemplate" ]; then
     cp "$sharedOosh/templates/user/bashrcTemplate" "$bashrc"
   else
     printf '\n# oosh environment\n[ -f ~/config/user.env ] && . ~/config/user.env\n' >> "$bashrc"
   fi
   create.result 0 "re-templated $bashrc"
 else
   create.result 0 "$bashrc already sources ~/config/user.env"
 fi
 [ -f "$targetHome/.bash_profile" ] || echo '[ -f ~/.bashrc ] && source ~/.bashrc' > "$targetHome/.bash_profile"
 return $(result)
}


private.config.log.env.migrate()     # <?logEnv:$CONFIG_PATH/log.env> # strip the boot-era `. $OOSH_USER_CONFIG_PATH/log.session.env` chain line from the shared log.env (log owns that file now); idempotent; rc 0 when nothing to do #
{
 # 2e2e6a6 stopped config.save from chaining the PER-USER session file from
 # the SHARED log.env (a missing per-user file in a shared chain line aborts
 # dash outright); `log` creates and sources it itself. Every host installed
 # before that kept the line until its next `config save log LOG`, which
 # nothing routine runs — so the touch-guard in `this` had no exit. This is
 # the exit: config.init.user (which `oo update` runs) calls it. log.env is
 # shared, so one strip per host is enough. T88.
 #
 # `cat > "$f"`, not mv: the shared file keeps its owner/group/mode.
 local f="${1:-$CONFIG_PATH/log.env}" tmp
 if [ ! -f "$f" ]; then
   create.result 0 "no $f — nothing to migrate"
   return $(result)
 fi
 if ! grep -qE '^[[:space:]]*(\.|source)[[:space:]]+[^[:space:]]*/log\.session\.env[[:space:]]*$' "$f"; then
   create.result 0 "$f carries no log.session.env chain line"
   return $(result)
 fi
 tmp="$f.migrate.$$"
 grep -vE '^[[:space:]]*(\.|source)[[:space:]]+[^[:space:]]*/log\.session\.env[[:space:]]*$' "$f" > "$tmp"
 if [ $? -gt 1 ] || ! cat "$tmp" > "$f"; then
   rm -f "$tmp"
   create.result 1 "could not rewrite $f"
   error.log "private.config.log.env.migrate: $RESULT"
   return $(result)
 fi
 rm -f "$tmp"
 create.result 0 "stripped the log.session.env chain line from $f"
 return $(result)
}


private.config.chain.files.get()     # <?userEnv:$CONFIG_PATH/user.env> # the env files user.env must load, in order: the files the required manifest names, then every other <name>.env the given user.env already loads whose file exists; one name per line #
{
 # A getter consumed as $(…): no create.result. config.save used to hard-code
 # `config.add oosh` / `config.add log`, so every full save — and so every
 # config.init.env — silently dropped any file registered with `config add`
 # (odocker.env, from odocker workspace.set), and ODOCKER_WORKSPACES with it.
 # The manifest's files come first and always (config.save writes them); an
 # extra load line survives only when its file exists — a load of a missing
 # file is how a POSIX login shell dies on `. $CONFIG_PATH/<gone>.env`.
 # The manifest list ONCE (it was re-read per candidate), and BOTH spellings
 # config.validate accepts for a load line — `. $CONFIG_PATH/x.env` and the
 # legacy `source $CONFIG_PATH/x.env` — so a file registered the old way is
 # not dropped on the next save (the guard counted 0 → 0 and saw nothing).
 local userEnv="${1:-$CONFIG_PATH/user.env}" name seen=" " manifestFiles
 manifestFiles=" $(private.config.manifest.files.get | tr '\n' ' ') "
 for name in $manifestFiles \
             $(grep -E '^(source|\.)[[:space:]]+\$CONFIG_PATH/[A-Za-z0-9_.-]+\.env[[:space:]]*$' "$userEnv" 2>/dev/null | sed -E 's|^(source\|\.)[[:space:]]+\$CONFIG_PATH/||; s/[[:space:]]*$//'); do
   name="${name%.env}"
   [ "$name" = user ] && continue
   case "$name" in "~"*) continue ;; esac   # per-user: loaded by the kernel (private.this.user.env.load)
   case "$seen" in *" $name "*) continue ;; esac
   seen="$seen$name "
   case "$manifestFiles" in *" $name "*) echo "$name"; continue ;; esac
   [ -f "$CONFIG_PATH/$name.env" ] && echo "$name"
 done
}


private.config.version.get()     #  # the config-format version this branch writes into user.env as OOSH_CONFIG_VERSION; bump it whenever the required manifest or the user.env format changes #
{
 # A getter consumed as $(…): no create.result. The format of the config THIS
 # branch writes — the required manifest plus the user.env head. Another branch
 # version writes another format (testing/prod: no anchors, a boot file; main:
 # absolute paths), and nothing recorded which one a file came from, so a
 # foreign config could not be told from a broken one. Bump this on every
 # change to private.config.required.variables.get or
 # private.config.anchor.lines.get.
 echo 2
}


private.config.derive.odocker.workspaces()     #  # the Docker workspaces root for this host: the value already set, else DockerWorkspaces beside the Once.sh components base (odocker) #
{
 # One row of private.config.required.variables.get, authority `kept`: a root
 # the user chose (odocker workspace.set / seed) wins, only a missing one is
 # derived — from odocker's own getter, loaded the documented way, so config
 # and odocker cannot disagree about the default.
 [ -n "$ODOCKER_WORKSPACES" ] && { echo "$ODOCKER_WORKSPACES"; return 0; }
 private.this.script.load odocker private.odocker.workspaces.default.get || return 1
 private.odocker.workspaces.default.get
}


config.user.save()     #  # write the per-user env file of the required manifest ($OOSH_USER_CONFIG_PATH/oosh.user.env: OOSH_MODE) from this shell; the shared tier never carries it #
{
 # The per-user half of config save: every `~<file>` row of the required
 # manifest (today OOSH_MODE), from this shell, into
 # $OOSH_USER_CONFIG_PATH/<file> — pure data, one export line per set value
 # (private.config.variable.export.line). oo mode calls it on every switch.
 local dir="${OOSH_USER_CONFIG_PATH:-$HOME/.config/oosh}" variable file rest userFile
 if ! mkdir -p "$dir" 2>/dev/null; then
   create.result 1 "config.user.save: cannot create $dir"
   error.log "$RESULT"
   return $(result)
 fi
 # Probe BEFORE writing, like config.save: the heredoc redirect below was
 # unchecked, so a per-user file another user owns (root's after
 # `sudo -E config init.full`) failed with a bare "Permission denied" while
 # this method still said 0 — and the stale OOSH_MODE stayed (F6).
 for userFile in $(private.config.required.variables.get | awk '$2 ~ /^~/ && !seen[$2]++ {print $2}'); do
   if ! { : >> "$dir/${userFile#\~}"; } 2>/dev/null; then
     create.result 1 "config.user.save: cannot write $dir/${userFile#\~} — check its owner"
     error.log "$RESULT"
     return $(result)
   fi
 done
 for userFile in $(private.config.required.variables.get | awk '$2 ~ /^~/ && !seen[$2]++ {print $2}'); do
   # Carry forward first: a shell without OOSH_MODE must not empty the file.
   private.config.required.carry "$userFile" "$dir/${userFile#\~}"
   while read -r variable file rest; do
     [ "$file" = "$userFile" ] || continue
     [ -n "${!variable}" ] && private.config.variable.export.line "$variable"
   done <<REQUIRED > "$dir/${userFile#\~}"
$(private.config.required.variables.get)
REQUIRED
 done
 create.result 0 "per-user config written to $dir"
 return $(result)
}


