private.config.anchor.lines.get() # <?bashFile:$BASH_FILE> # emit the head of user.env: the $HOME-relative anchors, the PATH prepend and BASH_FILE — pure data, one line each
{
  # THE boot. Every shell sources these lines (bashrcTemplate, ossh exec, the
  # platform runners, `this` on a cold start). They are DATA: $HOME expands when
  # sourced, so one shared user.env is right for every user on the host.
  # init/oosh duplicates this verbatim (BEGIN/END userEnvSeed) because POSIX sh
  # cannot call this — the two copies are pinned together by test.install
  # T-INIT-SEEDS-USER-ENV.
  local bashFile="${1:-$BASH_FILE}" bashDir=""
  # oosh-dir-exception: the persisted DATA form of the constant — the value IS
  # "$HOME/oosh", written unexpanded for the sourcing shell to expand.
  echo 'export OOSH_DIR="$HOME/oosh"'
  # config-path-exception: same, for CONFIG_PATH.
  echo 'export CONFIG_PATH="$HOME/config"'
  echo 'export CONFIG_FILE="user.env"'
  echo 'export CONFIG="$CONFIG_PATH/$CONFIG_FILE"'
  echo 'export OOSH_USER_CONFIG_PATH="$HOME/.config/oosh"'
  echo "export OOSH_CONFIG_VERSION=\"$(private.config.version.get)\""
  # path-writer: the ONE sanctioned PATH builder in the tree (path.validate).
  # Grows by one segment per re-source, because a data line cannot guard
  # itself; `this` de-duplicates PATH by whole segment on load, so the growth
  # never reaches a command.
  echo 'export PATH="$HOME/oosh:$HOME/oosh/ng:$PATH"'
  # Brew bash must beat the /bin/bash that macOS path_helper appends. Host-wide,
  # so safe in shared config; skipped where bash lives in a default directory.
  #
  # Gated on the INPUT, not on dirname's output: dirname NEVER returns empty —
  # it answers "." for a slash-less or empty argument — so a bad $BASH_FILE
  # ("bash", "") would emit `export PATH=".:$PATH"` and put the working
  # directory on the PATH of every login shell on the host (CWE-426, the hole
  # ticket T8 removed). config.save runs as root during install, so this is the
  # one arm that must not be permissive. Only an ABSOLUTE path yields a dir.
  case "$bashFile" in /*) bashDir=$(dirname "$bashFile") ;; esac
  case "$bashDir" in
    /bin|/usr/bin|"") ;;
    # path-writer: the same builder, brew-bash half.
    *) echo "export PATH=\"$bashDir:\$PATH\"" ;;
  esac
  # No BASH_FILE line at all when there is no value: `export BASH_FILE=""`
  # would satisfy config.validate.required's presence grep and report OK,
  # hiding the problem. Omitting the line makes it report BASH_FILE missing.
  [ -n "$bashFile" ] && echo "export BASH_FILE=\"$bashFile\""
  return 0
}

config.save() # <?name> <?ENV_PREFIX> # creates an "<name>.env" config file in $CONFIG_PATH containing all env variables that match <ENV_PREFIX>
# without parameters it inititlises the $CONFIG_PATH/user.env
{
  #set -x
  console.log "config.save (CONFIG=$CONFIG)"

  # config.save had no deliberate exit status at all — it fell off the end
  # through config.info.log, whose rc is a `[ … -gt … ]` test. It now reports
  # whether the files it wrote passed their own validation (see the guard at
  # the end of the no-arg branch).
  local configSaveRc=0

  local file=$1
  shift
  local name=$1
  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    # NOT `${file^^}` below. That is bash 4+, and on macOS /bin/bash 3.2 it is
    # not a warning but a FATAL "bad substitution" — the shell EXITS (measured
    # on a sequoia VM; the commands after it never ran). This branch is the
    # DOCUMENTED single-argument form — `config add oosh`, `config save myapp`
    # (docs/config.md) — so on macOS a documented command killed the user's
    # shell. The `warn.log "BASH 5 support only"` that stood here was never a
    # mitigation: the line under it had already ended the shell.
    name=$(private.config.string.upper "$file")
  else
    shift
  fi


  # `config save user` would take the prefix USER — the system variable — and
  # replace the SHARED user.env, every user's boot, with one line.
  if [ "$file" = "user" ]; then
    error.log "config.save: user.env is written by a plain ${YELLOW}config save${NORMAL} only (anchors + load lines) — not by config save user"
    create.result 2 "config save user refused"
    return $(result)
  fi
  if [ -n "$file" ]; then
    config.file $file.env
  else
    name="CONFIG"
    # A plain save writes user.env, whatever file `config file` selected — it
    # used to truncate that custom file (config file myapp.env; config save).
    config.file user.env
  fi
  
  stop.log "
  config.save [file:$file] [name:$name] to $CONFIG"
  # CARRY FORWARD what this shell has lost but the file still holds.
  #
  # `{ … } >$CONFIG` below TRUNCATES, and what it writes is whatever is in the
  # CURRENT ENVIRONMENT. So a shell missing a required variable rewrites the
  # file without it. `oo mode <branch>` is the live example (oo:938-940): it
  # sets OOSH_MODE and immediately saves oosh.env from that shell — which has
  # OOSH_MODE and, because nothing re-derives OOSH_OS at shell init, no
  # OOSH_OS. The file loses it. That is the oscillation measured on the macOS
  # VM: OOSH_OS present and OOSH_MODE missing at one point, the exact reverse
  # an hour later.
  #
  # This is NOT derivation, deliberately. Deriving belongs in config.init.env
  # (card 2), which can source `os` and afford to be slow. A writer only has to
  # refrain from throwing away what it was already holding — no new dependency,
  # no re-entrancy, and nothing to go wrong during an install.
  #
  # Read BEFORE the redirect: by the time `>$CONFIG` has run the old values are
  # gone, which is exactly how config.init.env lost OOSH_PM before card 2.
  private.config.required.carry "$CONFIG_FILE" "$CONFIG"
  # …and every OTHER variable of this file's family the shell lacks: a save
  # never drops a value only because the saving shell does not hold it.
  private.config.file.carry "$CONFIG" "$name"

  # The env files user.env loads, read NOW: the export block below truncates
  # $CONFIG, and for a no-argument save that is user.env itself.
  local chainFiles=""
  [ -z "$file" ] && chainFiles=$(private.config.chain.files.get "$CONFIG_PATH/user.env")
  # A file config save cannot write fails HERE, naming it — the redirect below
  # used to fail with a bare "Permission denied" and config save still said 0.
  if ! { : >> "$CONFIG"; } 2>/dev/null; then
    error.log "config.save: cannot write $CONFIG — check its owner and group-write"
    create.result 1 "cannot write $CONFIG"
    return $(result)
  fi
  RESULT=""
  {
    # The harvesting loop that used to live here is now
    # private.config.variables.export, and the exclusion list moved with it, to
    # sit beside the comment that explains it. review-2026-09-09 § M3 named the
    # extraction before it existed.
    #
    # It enumerates NAMES with `compgen -v` and renders each one with
    # `declare -p <name>`. It never parses the NO-ARGUMENT `declare -p` stream,
    # which on bash 3.2 is `set`-style AND contains every function body — the
    # two facts that between them wrote rows of the required-variables table
    # into ~/config/oosh.env on every macOS install.
    # See docs/research/2026-09-17-config-save-bash32.md.
    #
    # NOTHING inside this block may log. log:35 sets
    # LOG_DEVICE=/proc/self/fd/1, and inside this redirect fd 1 IS $CONFIG, so
    # a single debug.log would be written into the generated env file.
    private.config.variables.export "$name"
  } >$CONFIG
  # Reported AFTER the redirect (inside it, a log line would land in the file):
  # a value bash can only render as $'…' — tab, newline, control characters —
  # is not pure data, so it was skipped, and nobody was told.
  if [ -n "$file" ]; then
    local droppedName dropped=""
    for droppedName in $(private.config.variables.list "$name"); do
      private.config.variable.export.line "$droppedName" >/dev/null 2>&1 || dropped="$dropped $droppedName"
    done
    # error.log, not warn.log: a value that goes missing is data loss, and warn.log
    # is silent at LOG_LEVEL 1 — the level most shells and the test suite run at.
    [ -n "$dropped" ] && error.log "config.save: not persisted (a newline or control character in the value):$dropped"
  fi
  private.ensure.groupWrite "$CONFIG"

  if [ -z "$file" ]; then
    #problem.log "regenerate config"

    important.log "generating $CONFIG"
    # user.env IS the boot: private.config.anchor.lines.get writes the anchors,
    # the PATH prepend and BASH_FILE as data, then config.add appends the source
    # chain. No loader stands between a shell and this file.
    #
    # $CONFIG_PATH/user.env, NOT $CONFIG. With a non-default CONFIG_FILE (say
    # `config file myapp.env` then `config save`) $CONFIG points elsewhere,
    # while `config.file user.env` below resets it before config.add appends
    # the chain — so the anchors landed in myapp.env and user.env was left
    # holding two source lines and nothing to anchor them. Once boot is gone
    # that file is unbootable. The anchors belong to user.env by definition.
    [ -z "$BASH_FILE" ] && BASH_FILE=$(command -v bash)
    private.config.anchor.lines.get "$BASH_FILE" > "$CONFIG_PATH/user.env"


    ### HACK should be in log.init only. but is needed for ssh remote logging
      log.device $LOG_DEVICE
    ###


    # Every env file the required manifest names (oosh, log, odocker, …), each
    # with its own prefix — no longer a hard-coded oosh + log.
    local manifestFile
    for manifestFile in $(private.config.manifest.files.get); do
      config.save "$manifestFile" "$(private.config.string.upper "$manifestFile")"
    done
    config.file user.env
    # One load line per env file user.env must load — the manifest's, then the
    # ones it already loaded (private.config.chain.files.get, read before this
    # save truncated user.env). No longer a hard-coded oosh + log.
    local chainFile
    for chainFile in $chainFiles; do
      config.add "$chainFile"
    done
    # The per-user file (OOSH_MODE) is WRITTEN here and LOADED by the kernel
    # (private.this.user.env.load) — user.env gets no line for it: a guarded
    # load is logic, and an env file is pure data.
    config.user.save >/dev/null

    # Guard: user.env may hold export/comment/blank + `source *.env` chaining
    # (composition, NOT logic); oosh.env / log.env must be pure. config.validate
    # allows the source lines but rejects real logic (self-anchors, if-blocks).
    #
    # THE VERDICT IS NO LONGER THROWN AWAY. This used to be
    # `config.validate … >/dev/null 2>&1 || warn.log …`, and that is why card
    # 1's corruption reached a user: config.validate caught it correctly on the
    # FIRST macOS install and the verdict went to /dev/null, with the only
    # signal a warn.log inside a 1 MB install log at a level that was not
    # printing. A guard whose verdict is discarded is not a guard.
    #
    # STDERR, not stdout, and the reason is load-bearing: user:1702-1708 records
    # that `$(user get basehome)` CAPTURES this function's stdout, and a stray
    # line there once propagated a garbage IdentityFile into a generated
    # 2cuGitHub config block and failed the downstream git clone. stderr
    # survives every LOG_LEVEL and LOG_DEVICE exactly as stdout would — which is
    # the whole point of the status-output idiom — and `$( )` does not capture
    # it. This is the one place in the tree where the idiom must use stderr, and
    # test/test.config T83 pins BOTH halves: the verdict on stderr, and stdout
    # staying clean.
    #
    # It REPORTS, it does not halt: config.save runs as root during install and
    # a non-zero rc here is already more than any caller acts on today (audited
    # 2026-09-17 — nothing branches on it; private.check.pm is the only place it
    # could propagate and oo.pm.discover masks it with `RETURN=$1`).
    # EVERY file user.env loads (odocker.env, any `config add` file), not only
    # user/oosh/log. rc 2 from config.validate is a missing file, not logic.
    local _envName _invalid="" _missing="" _rc
    for _envName in user $(private.config.chain.files.get "$CONFIG_PATH/user.env"); do
      config.validate "$_envName" >/dev/null 2>&1; _rc=$?
      [ "$_rc" -eq 1 ] && _invalid="$_invalid $_envName"
      [ "$_rc" -eq 2 ] && _missing="$_missing $_envName"
    done
    if [ -n "$_invalid" ]; then
      echo "INVALID: config.save wrote$_invalid with logic in it — run 'config validate <name>' to see why" >&2
      configSaveRc=1
    fi
    if [ -n "$_missing" ]; then
      echo "INVALID: user.env loads$_missing but the file does not exist" >&2
      configSaveRc=1
    fi
    # if [ -x "$(command -v once)" ]; then
    #   once v
    # fi
  fi
  config.info.log
  # A named save validates the file it wrote — it used to always return 0.
  if [ -n "$file" ] && ! config.validate "$CONFIG" >/dev/null 2>&1; then
    echo "INVALID: config.save wrote $CONFIG with logic in it — run 'config validate $file' to see why" >&2
    configSaveRc=1
  fi
  return $configSaveRc
}

config.validate() # <?name:user> # verify an env file is PURE DATA (only export/comment/blank lines); rc 1 + report on any logic line. <name> is a bare name (user/oosh/log), a filename (x.env), or a path.
{
  local f="${1:-user}"
  case "$f" in
    */*)   : ;;                       # already a path
    *.env) f="$CONFIG_PATH/$f" ;;     # a filename in CONFIG_PATH
    *)     f="$CONFIG_PATH/$f.env" ;; # a bare name → CONFIG_PATH/<name>.env
  esac
  if [ ! -f "$f" ]; then
    error.log "config.validate: no such env file: $f"
    echo "INVALID: no such env file: $f"   # status-output idiom — verdict to stdout
    return 2
  fi
  local violations=0 lineNum=0 line trimmed
  while IFS= read -r line || [ -n "$line" ]; do
    lineNum=$((lineNum + 1))
    # Strip leading whitespace so ONLY a true blank/comment line is skipped. The
    # old `[[:space:]]*'#'*` case pattern treated any INDENTED line that merely
    # contained a '#' as a comment — e.g. `  : ${OOSH_DIR:=/x} # guarded` sailed
    # through. Trim first, then test the first real character.
    trimmed="${line#"${line%%[![:space:]]*}"}"
    case "$trimmed" in '' | '#'*) continue ;; esac
    # Reject command substitution / backticks ANYWHERE (even inside a value):
    # they EXECUTE when the file is sourced, so they are logic, never pure data.
    # `export FOO="$(echo hi)"` used to pass (the export regex only anchored to `=`).
    # Only a LIVE substitution: `\$(` is data (config save writes `$(` that way);
    # an EVEN number of backslashes before `$(` or a backtick leaves it live.
    if printf '%s\n' "$line" | grep -qE '(^|[^\\])(\\\\)*(\$\(|`)'; then
      error.log "config.validate: $f:$lineNum contains command substitution (not pure data): $line"
      violations=$((violations + 1)); continue
    fi
    # allow: `export IDENT=…`, `export declare IDENT=…` (legacy), bare `IDENT=…`
    if echo "$trimmed" | grep -qE '^(export[[:space:]]+(declare[[:space:]]+)?)?[A-Za-z_][A-Za-z0-9_]*='; then
      continue
    fi
    # allow: config-file chaining `source X.env` / `. X.env` (composition, not
    # logic). Anything else — self-anchors `: ${…}`, `if`/`{ } &&` — is logic.
    if echo "$trimmed" | grep -qE '^(source|\.)[[:space:]]+[^[:space:]]*\.env[[:space:]]*$'; then
      continue
    fi
    # NO exception. A guarded per-user load was allowed here for a day
    # (2026-09-28) — and so a test plus a conditional source sat in the shared
    # user.env with the validator's blessing.
    error.log "config.validate: $f:$lineNum is not pure data: $line"
    violations=$((violations + 1))
  done < "$f"
  if [ "$violations" -gt 0 ]; then
    error.log "config.validate: $f has $violations violation(s) — env files must contain only export/comment/blank lines; the bootstrap anchors are emitted into user.env by config.save, they are not hand-written logic"
    echo "INVALID: $f — $violations violation(s) (logic in an env file)"
    return 1
  fi
  echo "OK: $f is pure data"
  return 0
}

config.validate.completion.name() { echo user; private.config.chain.files.get; }

private.config.required.variables.get() # # the variables a config must carry for a branch version: "<variable> <file> <deriverFunction> <authority>", one per line; authority derived = always re-derived, kept = re-derived only when missing
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell.
  # Same reasoning as private.config.file.resolve.
  #
  # This is the POSITIVE list the tree never had. config.save has always had a
  # negative one (what must never persist) and config.validate checks line
  # SHAPE while knowing no variable name at all, so nothing asserted that a
  # config contains what a branch version needs. Mirrored in docs/config.md
  # § Required variables — change both together.
  #
  # OOSH_BRANCH is deliberately absent: it is install INPUT, excluded from
  # persistence since T7, and a config that carried it would be the bug.
  cat <<'REQUIRED'
BASH_FILE user.env private.config.derive.bash.file derived
CONFIG_FILE user.env private.config.derive.config.file derived
OOSH_CONFIG_VERSION user.env private.config.version.get derived
OOSH_MODE ~oosh.user.env private.config.derive.oosh.mode derived
OOSH_OS oosh.env private.config.derive.oosh.os derived
OOSH_PM oosh.env private.config.derive.oosh.pm kept
LOG_LEVEL log.env private.config.derive.log.level kept
ODOCKER_WORKSPACES odocker.env private.config.derive.odocker.workspaces kept
REQUIRED
}

config.validate.required() # # verify the persisted config carries every variable a branch version needs and that OOSH_MODE agrees with the checkout; rc 1 naming each problem
{
  # A SUB-METHOD of config.validate, not a mode argument: this.call prefers
  # $caller.$method.$1 when that function exists, so `config validate required`
  # resolves here and config.validate's own `${1:-user}` default and its
  # internal caller in config.save are untouched. (Before this existed,
  # `config validate required` silently resolved to a non-existent
  # required.env and returned 2.)
  # The reasons come from private.config.required.missing.get — the one list
  # this report and private.config.healthy share; this method only formats it.
  local tokens missing="" drift="" token
  tokens=$(private.config.required.missing.get)
  for token in $tokens; do
    case "$token" in
      drift:*) token="${token#drift:}"; drift="OOSH_MODE=${token%%|*} but ~/oosh is on ${token#*|}" ;;
      *) missing="$missing $token" ;;
    esac
  done

  # Status-output idiom: the verdict goes to stdout so it survives any
  # LOG_LEVEL or LOG_DEVICE, exactly as config.validate does.
  if [ -n "$missing" ] || [ -n "$drift" ]; then
    local reason=""
    [ -n "$missing" ] && reason="missing:$missing"
    [ -n "$drift" ] && reason="${reason:+$reason; }$drift"
    create.result 1 "INCOMPLETE: $CONFIG_PATH — $reason"
    echo "$RESULT"
    echo "  repair with: config init   (checks, then repairs with config init.full)"
    return $(result)
  fi
  create.result 0 "OK: $CONFIG_PATH carries every required variable and agrees with the checkout"
  echo "$RESULT"
  return $(result)
}

config.validate.required.completion() { :; }

config.bash.minimal.version() { # <bash.minimal.version:5> # sets the BASH_MINIMUM_MAJOR_VERSION
