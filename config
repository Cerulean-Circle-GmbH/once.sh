private.config.session.split.is()     # <?configPath:$CONFIG_PATH> # rc 0 when the shared user.env already chains the per-user user.session.env #
{
 # Silent predicate. Once switched, a shared config stays switched: config save
 # keeps the layout it finds (private.config.session.chain.ready decides only
 # the switch itself).
 grep -qxF '. $HOME/.config/oosh/user.session.env' "${1:-$CONFIG_PATH}/user.env" 2>/dev/null
}


private.config.session.chain.ready()     # <?configPath:$CONFIG_PATH> <?family:user> # rc 0 when every other user linked to this shared config has their <family>.session.env (user: filled), so the shared <family>.env may chain it; rc 1 when one has none or a home cannot be looked into #
{
 # Silent predicate — the GATE of the split. The shared user.env chains
 # ~/.config/oosh/user.session.env unguarded (env files are pure data), and a
 # plain sh ends on `.` of a missing file: switching while another user of the
 # same sharedConfig has none would break their shell. A home the caller cannot
 # look into (0750 homes, a non-root caller) is NOT proven, so the switch waits
 # for root (sudo oo update → config.init.user). The caller's own file is
 # written by the save itself. A shared config that cannot be resolved, or a
 # home that cannot be looked into, makes private.config.linked.homes.get
 # answer rc 1: the gate stays closed.
 local homes h owner family="${2:-user}"
 homes=$(private.config.linked.homes.get "${1:-$CONFIG_PATH}") || return 1
 while read -r h owner; do
   [ -z "$h" ] && continue
   [ "${h%/}" = "${HOME%/}" ] && continue
   if [ "$family" = "user" ]; then
     [ -s "$h/.config/oosh/user.session.env" ] || return 1
   else
     # oosh.session.env may be empty (no branch derivable): it must exist.
     [ -f "$h/.config/oosh/$family.session.env" ] || return 1
   fi
 done <<HOMES
$homes
HOMES
 return 0
}


private.config.user.session.migrate()     # <?configPath:$CONFIG_PATH> # switch a shared config to the forked user.env in place: PATH out of user.env, OOSH_MODE out of oosh.env, the per-user user.session.env chained last; only when every linked user has one; idempotent, silent #
{
 # The forked user.env (boss, 2026-10-02) for a host whose shared files were
 # written before the split. Each user's PATH and OOSH_MODE are in their own
 # user.session.env by then (private.config.session.files.ensure.all, the
 # gate checks it). In place (owner, group and mode of the shared files
 # kept), as private.config.log.chain.migrate: the chain goes on last first,
 # then PATH leaves — a shell started in between still has a PATH. rc 1 when
 # the gate is closed; rc 2 when a shared file cannot be written (RESULT
 # "cannot write <file>"), as private.config.log.chain.migrate.
 # T-CONFIG-USER-SESSION-MIGRATE, T-CONFIG-MIGRATE-WRITE-FAIL.
 local configPath="${1:-$CONFIG_PATH}" f
 local chain='. $HOME/.config/oosh/user.session.env'
 f="$configPath/user.env"
 [ -f "$f" ] || return 0
 private.config.session.split.is "$configPath" && return 0
 private.config.session.chain.ready "$configPath" || return 1
 private.config.env.line.append "$f" "$chain" || return 2
 # path-exception: the prefixes of the line being moved out, not an assignment.
 private.config.env.lines.drop "$f" "export PATH=" "PATH=" || return 2
 private.config.env.lines.drop "$configPath/oosh.env" "export OOSH_MODE=" "OOSH_MODE=" || return 2
}


private.config.session.files.ensure.all()     # <sharedConfig> <sharedOosh> # as root, give every user linked to <sharedConfig> who has no filled user.session.env their session files, each in their own hop #
{
 # The other half of the gate: only root can look into every home and act as
 # every user. Each user's file is written AS them (the shared preamble), so it
 # holds THEIR real PATH and THEIR branch. No create.result: config.init.user's
 # RESULT must stand.
 local sharedConfig="$1" sharedOosh="$2" h owner
 [ "$(id -u)" = "0" ] || return 0
 while read -r h owner; do
   [ -z "$h" ] && continue
   [ -s "$h/.config/oosh/user.session.env" ] && [ -f "$h/.config/oosh/oosh.session.env" ] && continue
   private.as.user "$owner" bash -c "$(private.this.as.user.preamble.get "$owner" "$h" "$sharedOosh")
     private.this.script.load config private.config.session.file.ensure || exit 1
     private.config.session.file.ensure \"$h\" >/dev/null" >/dev/null 2>&1
 done <<HOMES
$(private.config.linked.homes.get "$sharedConfig")
HOMES
 return 0
}


private.config.oosh.session.file.get()     # <?home:$HOME> # echo the path of the per-user oosh.session.env under <home> #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 local home="${1:-$HOME}"
 echo "${home%/}/.config/oosh/oosh.session.env"
}


private.config.oosh.session.split.is()     # <?configPath:$CONFIG_PATH> # rc 0 when the shared oosh.env already chains the per-user oosh.session.env #
{
 # Silent predicate, the twin of private.config.session.split.is.
 grep -qxF '. $HOME/.config/oosh/oosh.session.env' "${1:-$CONFIG_PATH}/oosh.env" 2>/dev/null
}


private.config.oosh.session.migrate()     # <?configPath:$CONFIG_PATH> # chain the per-user oosh.session.env as the last line of the shared oosh.env, in place, OOSH_MODE out of it; only when every linked user has one; then OOSH_MODE leaves the user.session.env files the caller may write; idempotent, silent #
{
 # OOSH_MODE belongs to the oosh family (boss, 2026-10-02): the shared
 # oosh.env chains each user's ~/.config/oosh/oosh.session.env, as log.env
 # chains log.session.env. In place (owner, group and mode kept), only
 # through the gate (a plain sh ends on a missing file): the chain goes on
 # last first, then OOSH_MODE leaves. After the switch the transition copy of
 # OOSH_MODE in user.session.env goes — root reaches every linked user's; a
 # file the caller may not write is left to its owner. rc 1 when the gate is
 # closed; rc 2 when a file cannot be written (RESULT "cannot write <file>"),
 # as private.config.log.chain.migrate.
 # T-CONFIG-OOSH-SESSION-MIGRATE, T-CONFIG-MIGRATE-WRITE-FAIL.
 local configPath="${1:-$CONFIG_PATH}" f h owner rc=0
 local chain='. $HOME/.config/oosh/oosh.session.env'
 f="$configPath/oosh.env"
 [ -f "$f" ] || return 0
 if ! private.config.oosh.session.split.is "$configPath"; then
   private.config.session.chain.ready "$configPath" oosh || return 1
   private.config.env.line.append "$f" "$chain" || return 2
   private.config.env.lines.drop "$f" "export OOSH_MODE=" "OOSH_MODE=" || return 2
 fi
 while read -r h owner; do
   [ -z "$h" ] && continue
   f="$h/.config/oosh/user.session.env"
   [ -w "$f" ] || continue
   private.config.env.lines.drop "$f" "export OOSH_MODE=" || rc=2
 done <<HOMES
$(private.config.linked.homes.get "$configPath")
HOMES
 return $rc
}


private.config.host.container.name.get()     #  # echo the Docker name of this container, read through the mounted docker socket; nothing outside a container or without access #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # A container's host name is the start of its ID; the container that owns
 # that ID has the name. `container inspect` (not images), and the ID must
 # start with this host name — a computer named like some container is no
 # container.
