config.get() # <envVariable>  # gets an environment variable from the user.env
{
  local envVariable="$1"
  if [ -n "$envVariable" ]; then
    shift
  else
    error.log "no envVariable specified"
    return 1
  fi

  # Matches both "export X=..." and the legacy malformed "export declare X=..." form.
  local currentDefinition="$( grep -E "^export( declare)? ${envVariable}=" "$CONFIG" 2>/dev/null )"
  info.log "declaration: $currentDefinition"
  if [ -n "$currentDefinition" ]; then
    local val="${currentDefinition#*=}"
    val="${val#\"}"
    val="${val%\"}"
    echo "$val"
  fi
}

config.set() # <envVariable> <value> # adds or sets an environment variable to the user.env 
{
  local envVariable="$1"
  if [ -n "$envVariable" ]; then
    shift
  else
    error.log "no envVariable specified"
    return 1
  fi

  local value="$1"
  if [ -n "$value" ]; then
      shift
  fi
  # The line is rendered by private.config.variable.export.line — the quoting
  # config save uses — and swapped in by awk (ENVIRON, the whole line by name):
  # sed broke on | & \ and never escaped " $ `. Also normalises the legacy
  # "export declare X=" form, and leaves one line per variable.
  local newLine
  if ! newLine=$(export "$envVariable=$value"; private.config.variable.export.line "$envVariable"); then
    error.log "config.set: $envVariable cannot be written as pure data (a newline or control character in the value)"
    return 1
  fi
  local currentDefinition="$( grep -E "^export( declare)? ${envVariable}=" "$CONFIG" 2>/dev/null )"
  if [ -n "$currentDefinition" ] && [ -z "$value" ]; then
    warn.log "set blank value on
      $currentDefinition

      "
  fi
  [ -f "$CONFIG" ] || : > "$CONFIG"
  local tmpFile="${CONFIG}.tmp.$$"
  if ! CONFIG_SET_NAME="$envVariable" CONFIG_SET_LINE="$newLine" awk '
         BEGIN { n = ENVIRON["CONFIG_SET_NAME"]; l = ENVIRON["CONFIG_SET_LINE"]; done = 0 }
         $0 ~ ("^export( declare)? " n "=") { if (!done) print l; done = 1; next }
         { print }
         END { if (!done) print l }' "$CONFIG" > "$tmpFile"; then
    rm -f "$tmpFile"
    error.log "config.set: could not rewrite $CONFIG"
    return 1
  fi
  # In place: a shared or symlinked file keeps its identity and group-write.
  cat "$tmpFile" > "$CONFIG"
  rm -f "$tmpFile"
  private.ensure.groupWrite "$CONFIG"
}


config.unset() # <envVariable> # removes <envVariable> from the current $CONFIG file (idempotent)
{
  local envVariable="$1"
  if [ -n "$envVariable" ]; then
    shift
  else
    error.log "no envVariable specified"
    return 1
  fi

  [ ! -f "$CONFIG" ] && return 0

  if grep -qE "^export( declare)? $envVariable=" "$CONFIG" 2>/dev/null; then
    local tmpFile="${CONFIG}.tmp.$$" rc
    # grep -v exits 1 when it removed EVERY line — a success here; only rc 2 is
    # an error. Written back IN PLACE, so a shared or symlinked file keeps its
    # identity and group-write.
    grep -vE "^export( declare)? $envVariable=" "$CONFIG" > "$tmpFile"; rc=$?
    if [ "$rc" -le 1 ]; then
      cat "$tmpFile" > "$CONFIG"
      private.ensure.groupWrite "$CONFIG"
      debug.log "config.unset: removed $envVariable from $CONFIG"
    else
      error.log "config.unset: could not rewrite $CONFIG"
    fi
    rm -f "$tmpFile"
  fi
}


config.discover() # # lists the existing config files and where they are
{
