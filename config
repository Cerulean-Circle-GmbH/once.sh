config.string.quote() { # <string> # quote the string to be used as a command line argument
  RESULT=$(printf %s\\n "$1" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/'/")
  echo $RESULT
}

config.init() # # inititalizes the $CONFIG environment if $CONFIG is empty
{
  private.this.resolve.fundamentals
  export CONFIG_FILE=user.env

  if [ ! -d "$CONFIG_PATH" ]; then
    mkdir -p "$CONFIG_PATH"
  fi
  touch "$CONFIG_PATH/error.txt"

  export CONFIG=$CONFIG_PATH/$CONFIG_FILE
  debug.log "$CONFIG"

  # D3: cross-platform install locations — the SINGLE platform-derived seam.
  # Keyed on the OS discriminator, single-sourced from `os` (S7): `os os` echoes
  # OOSH_OS via os.check.env's mapping — no duplicated $OSTYPE case, no sourcing of
  # the auto-dispatching `os` script. Everything is exported as pure state;
  # OOSH_-prefixed vars persist via `config save oosh OOSH` → oosh.env, so both
  # consumers (oo.mode.base.get, odocker) read platform-correct paths on every
  # platform. `${VAR:-…}` preserves an operator/CI override. Drops the macOS literals
  # hardcoded at oo.mode.base.get and odocker.
  [ -z "$OOSH_OS" ] && export OOSH_OS="$(os os 2>/dev/null)"
  case "$OOSH_OS" in
    darwin) export OOSH_SHARED_BASE="${OOSH_SHARED_BASE:-/Users/Shared}" ;;
    *)      export OOSH_SHARED_BASE="${OOSH_SHARED_BASE:-/home/shared}" ;;
  esac
  export OOSH_COMPONENTS_DIR="${OOSH_COMPONENTS_DIR:-$OOSH_SHARED_BASE/Workspaces/AI/Claude/components/OOSH}"
  export ODOCKER_WORKSPACES="${ODOCKER_WORKSPACES:-$OOSH_SHARED_BASE/Workspaces/AI/Claude.All/DockerWorkspaces}"
}

