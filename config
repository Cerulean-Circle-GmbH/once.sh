config.save() # <?name> <?ENV_PREFIX> # creates an "<name>.env" config file in $CONFIG_PATH containing all env variables that match <ENV_PREFIX>
# without parameters it inititlises the $CONFIG_PATH/user.env
{
  #set -x
  console.log "config.save (CONFIG=$CONFIG)"

  local file=$1
  shift
  local name=$1
  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    warn.log "BASH 5 support only" # on bash 3 this would help: $(tr '[:lower:]' '[:upper:]' <<< "$file")
    name=${file^^}
  else
    shift
  fi


  if [ -n "$file" ]; then
    config.file $file.env
  else
    name="CONFIG"
  fi
  
  stop.log "
  config.save [file:$file] [name:$name] to $CONFIG"
    #declare -px | grep "^\(declare .* \)*\(.*$name\)\(.*\)=" | sed 's/^\(declare .* \)*\(.*'$name'\)\(.*\)=\(\"\)*\([^\"]*\)\(\"\)*/export \2\3=\"\5\"/'
    #declare -p | grep "^\(declare -.* \)*\(.*$name\)\(.*\)=" | sed 's/^\(declare -.* \)*\(.*'$name'\)\(.*\)=\(.*\)/export \2\3=\4/'
  RESULT=""
  # declare -p 
  # important.log "now filter"
  # declare -p | grep "^\(declare -[^aA]* \)*\([^ ]*$name\)\(.*\)=" 
  # important.log "now replace"
  # declare -p | grep "^\(declare -[^aA]* \)*\([^ ]*$name\)\(.*\)=" | sed 's/\([^-]*\)\(-x *\)\(.*'$name'\)\(.*\)=\(.*\)/export \1\3\4=\5/'
  {    
    #declare -p | grep "^\(declare -[^a]* \)*\([^ ]*$name\)\(.*\)=" | sed 's/^\(declare -.* \)*\((.*'$name'\)\(.*\)=\(.*\)/export \2\3=\4/'
    #declare -p | grep "^\(declare -[^aA]* \)*\([^ ]*$name\)\(.*\)=" | sed 's/^\(declare -.* \)\(.*'$name'\)\(.*\)=\(.*\)/export \2\3=\4/'
    
    # on mac without -x
    # Match vars where name is a PREFIX (e.g. OOSH matches OOSH_DIR but not SOME_OOSH_VAR)
    # Exclude install-only vars (LOG_INSTALL, INSTALL_LOG) — they must not persist into user sessions.
    # Exclude derived per-user paths — these are dynamically rebuilt from $HOME at every
    # shell init (this:209 sets CONFIG_PATH; this:40-49 sets OOSH_DIR), so persisting their
    # ABSOLUTE expanded value into shared config (the saving user's $HOME) only causes
    # EACCES leaks when a different user later sources it. Same reasoning as LOG_LIVE
    # below — log:22 already re-anchors LOG_LIVE for the current user at bashrc time;
    # OOSH_DIR is re-anchored by this; CONFIG_PATH/CONFIG by config.init (config:173).
    # OOSH_COMPONENTS_DIR is a transient /tmp/test.oo.* path from test runs — never share.
    # Match on the VARIABLE NAME only, never the value. The old `grep " ${name}[_=]"`
    # matched the prefix ANYWHERE in the declare line — so a var whose VALUE
    # contained e.g. " OOSH_DIR" (SUDO_COMMAND holding a bash -c script that
    # mentions OOSH_DIR) was wrongly harvested into oosh.env. Extract the varname
    # (anchored: `declare -flags NAME=…` → NAME; the value after `=` is
    # structurally unreachable) and test the prefix against that.
    declare -p 2>/dev/null | while IFS= read -r _line; do
      _vn=${_line#declare }; _vn=${_vn#-* }; _vn=${_vn%%=*}
      # match the varname as `name` exactly or `name_…` — the old ` ${name}[_=]`
      # boundary. Bare `${name}*` would be too broad (name=LOG would grab LOGNAME).
      case "$_vn" in ${name}|${name}_*) ;; *) continue ;; esac
      case "$_line" in "declare -a"*|"declare -A"*) continue ;; esac  # skip arrays
      case "$_vn" in
        # per-user / volatile / install-only / sudo-injected — never persist
        *INSTALL*|LOG_NAME|LOG_LIVE|LOG_DEVICE|CONFIG_PATH|CONFIG|OOSH_DIR|OOSH_COMPONENTS_DIR|SUDO_*|_) continue ;;
      esac
      echo "$_line" | sed 's/^declare -[^ ]* /export /'
    done
  } >$CONFIG
  private.ensure.groupWrite "$CONFIG"

  if [ -z "$file" ]; then
    #problem.log "regenerate config"

    important.log "generating $CONFIG"
    # user.env holds only PORTABLE config values (BASH_FILE = per-host bash;
    # CONFIG_FILE) followed by the source chain, so `config list` (cat user.env)
    # shows a meaningful config and sourcing user.env stands up the whole
    # environment. The per-user / volatile anchors (OOSH_DIR, CONFIG_PATH,
    # CONFIG, PATH) are deliberately NOT persisted — $OOSH_DIR/boot computes them
    # fresh at every shell init (correct per-user, robust to a moved config, no
    # cross-user leak). boot sets CONFIG_PATH BEFORE sourcing user.env, so the
    # appended `source $CONFIG_PATH/*.env` chain resolves. oosh.env / log.env
    # stay single-purpose (OOSH_* / LOG_*), no chaining of their own.
    [ -z "$BASH_FILE" ] && BASH_FILE=$(command -v bash)
    {
      echo "export BASH_FILE=\"$BASH_FILE\""
      echo "export CONFIG_FILE=\"$CONFIG_FILE\""
    } >$CONFIG


    ### HACK should be in log.init only. but is needed for ssh remote logging
      log.device $LOG_DEVICE
    ###


    config.save oosh OOSH   # pure `export OOSH_*` lines
    config.save log LOG     # pure `export LOG_*` lines
    config.file user.env
    config.add oosh OOSH    # appends: source $CONFIG_PATH/oosh.env
    config.add log LOG      # appends: source $CONFIG_PATH/log.env

    # Guard: user.env may hold export/comment/blank + `source *.env` chaining
    # (composition, NOT logic); oosh.env / log.env must be pure. config.validate
    # allows the source lines but rejects real logic (self-anchors, if-blocks).
    local _envName
    for _envName in user oosh log; do
      config.validate "$_envName" >/dev/null 2>&1 \
        || warn.log "config.save: $_envName.env has logic — run 'config validate $_envName' to see why"
    done
    # if [ -x "$(command -v once)" ]; then
    #   once v
    # fi
  fi
  config.info.log
}

config.validate() # <?name:user> # verify an env file is PURE DATA (only export/comment/blank lines); rc 1 + report on any logic line. <name> is a bare name (user/oosh/log), a filename (x.env), or a path.
{
  local f="${1:-user}"
  case "$f" in
    */*)   : ;;                       # already a path
    *.env) f="$CONFIG_PATH/$f" ;;     # a filename in CONFIG_PATH
    *)     f="$CONFIG_PATH/$f.env" ;; # a bare name → CONFIG_PATH/<name>.env
  esac
  if [ ! -f "$f" ]; then
    error.log "config.validate: no such env file: $f"
    return 2
  fi
  local violations=0 lineNum=0 line
  while IFS= read -r line || [ -n "$line" ]; do
    lineNum=$((lineNum + 1))
    # allow: blank lines and comments
    case "$line" in
      '' | [[:space:]]*'#'* | '#'*) continue ;;
    esac
    # allow: `export IDENT=…`, `export declare IDENT=…` (legacy), bare `IDENT=…`
    if echo "$line" | grep -qE '^[[:space:]]*(export[[:space:]]+(declare[[:space:]]+)?)?[A-Za-z_][A-Za-z0-9_]*='; then
      continue
    fi
    # allow: config-file chaining `source X.env` / `. X.env` (composition, not
    # logic). Anything else — self-anchors `: ${…}`, `if`/`{ } &&` — is logic.
    if echo "$line" | grep -qE '^[[:space:]]*(source|\.)[[:space:]]+[^[:space:]]*\.env[[:space:]]*$'; then
      continue
    fi
    error.log "config.validate: $f:$lineNum is not pure data: $line"
    violations=$((violations + 1))
  done < "$f"
  if [ "$violations" -gt 0 ]; then
    error.log "config.validate: $f has $violations violation(s) — env files must contain only export/comment/blank lines (logic belongs in $OOSH_DIR/boot)"
    return 1
  fi
  return 0
}

config.validate.completion.name() { echo "user oosh log"; }

config.bash.minimal.version() { # <bash.minimal.version:5> # sets the BASH_MINIMUM_MAJOR_VERSION
  echo "export BASH_MINIMUM_MAJOR_VERSION=$1" >>$CONFIG
}

config.list() # <name:$CONFIG> # lists the content of the config with <name>
{
  config.file.check $1
  cat $CONFIG
}

config.delete() # <name:$CONFIG> # deletes the config with <name>
{
  config.file.check $1
  rm $CONFIG_PATH/$CONFIG_FILE
}

config.update() { # <?name:$CONFIG> <?ENV_PREFIX> # saves and adds the config 
  config.save $1 $2
  config.add $1 $2
  config.info.log
}

config.info.log() # # logs the config when on LOG_LEVEL info or higher
{
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.edit() # <name:$CONFIG> # edits the config with <name> in vim
{
  #check.debug.level 6
  oo cmd vim
  if config.file.check $1; then
    vim $CONFIG
  else
    vim $CONFIG
    exit $ERROR_CODE_RECONFIG
  fi
}

config.clean() #  # reinitalises a clean config and removes any custom addons
{
  config.file.check $1
  # Order-preserving de-dup (drop duplicate lines, keep first occurrence).
  # Kept order-preserving rather than `sort -u` as a matter of hygiene — env
  # files are now pure `export K="V"` data (no bootstrap header to protect;
  # that logic moved to $OOSH_DIR/boot), so order is no longer load-bearing,
  # but there's no reason to alphabetically shuffle a user's config either.
  awk '!seen[$0]++' "$CONFIG" >"$CONFIG_PATH/$CONFIG_FILE.clean"
  rm $CONFIG_PATH/$CONFIG_FILE
  mv $CONFIG_PATH/$CONFIG_FILE.clean $CONFIG_PATH/$CONFIG_FILE
  private.ensure.groupWrite "$CONFIG_PATH/$CONFIG_FILE"
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.add() # <name:$CONFIG> # adds the config <name> into the user.env permanently
{
  local file=$1
  shift
  local name=$1

  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    warn.log "BASH 5 support only" # on bash 3 this would help: $(tr '[:lower:]' '[:upper:]' <<< "$file")
    name=${file^^}
  else
    shift
  fi

  if [ -z "$file" ]; then
    name="CONFIG"
  fi
  
  console.log "
  config.add [file:$file] [name:$name] to $CONFIG"
  {
    echo source \$CONFIG_PATH/$file.env
  } >>$CONFIG
  config.clean
}

config.file.check() # <name:$CONFIG> # sets the default config file to <name> if it exists
{
  if [ -n "$1" ]; then
    config.file $1.env
    shift
    RETURN=$1
    RETURN_VALUE=0
  else
    RETURN_VALUE=1
  fi
  info.log "config file: $CONFIG"
  create.result $RETURN_VALUE $CONFIG
  return "$(result)"

}

config.file() # <configfile> # sets the default config file to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        export FILE=$1
        CONFIG_FILE=$FILE

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
    esac
  fi
}

config.location() # <configfile> # sets the default config location to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        local oldConfig="$CONFIG"

        export FILE=$(basename $1)
        CONFIG_PATH=$(dirname $1)
        CONFIG_FILE=$FILE

        info.log "old config     : $oldConfig"
        info.log "new config path: $CONFIG_PATH"
        info.log "new config file: $CONFIG_FILE"

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
        config.save
        bash
    esac
  fi
}

