 [ -n "${line#/}" ] || return 1
 echo "${line#/}"
}


private.config.host.name.get()     # <?name> # echo the name of this computer for oosh (prompt, logs, ssh): <name> when given, else a container's Docker name, the macOS LocalHostName, else the short host name #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # $HOSTNAME is a container's ID ([oosh 2a1023f6d45b], 2026-10-05) and on a Mac
 # often carries the router's domain (.fritz.box).
 if [ -n "$1" ]; then echo "$1"; return 0; fi
 local name
