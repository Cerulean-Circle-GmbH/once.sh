private.config.host.name.refresh()     #  # correct the saved computer name (OOSH_SSH_CONFIG_HOST in oosh.env) when it was guessed and is wrong now — empty, a container ID, the raw host name, another container's name (a cloned image); a name chosen with config ssh.host.set is kept #
{
  # A chosen name is anything else: the alias `ossh install <alias>` gave, or
  # what `config ssh.host.set` set — never overwritten.
  local file="$CONFIG_PATH/oosh.env" saved name host stale=""
  if [ ! -w "$file" ]; then
    create.result 0 "not writable here: $file"; return $(result)
  fi
  saved=$(CONFIG="$file" config.get OOSH_SSH_CONFIG_HOST 2>/dev/null)
  name=$(private.config.host.name.get)
  if [ "$saved" = "$name" ]; then
    create.result 0 "$name"; return $(result)
  fi
  host=$(private.this.host.name.get)
  if [ -z "$saved" ] || [ "$saved" = "$host" ] || [ "$saved" = "${HOSTNAME:-}" ]; then
    stale="guessed"
  elif [[ "$saved" =~ ^[0-9a-f]{12}$ ]]; then
    stale="a container ID"
  elif command -v docker >/dev/null 2>&1 && docker container inspect -f '{{.Id}}' "$saved" >/dev/null 2>&1; then # kernel-exception: pre-existing on dev, out of the heal scope
    stale="another container's name"
  fi
  if [ -z "$stale" ]; then
    create.result 0 "kept: $saved"; return $(result)
  fi
  CONFIG="$file" config.set OOSH_SSH_CONFIG_HOST "$name"
  export OOSH_SSH_CONFIG_HOST="$name"
  info.log "computer name: ${saved:-<none>} ($stale) → $name"
  create.result 0 "$name"
  return $(result)
}


private.config.linked.homes.get()     # <sharedConfig> # echo "<home> <owner>" for every home whose ~/config links to <sharedConfig>, one per line; rc 1 when <sharedConfig> cannot be resolved or a home cannot be looked into #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. The
 # users of one shared config: whom root's hops in config.init.user serve
 # (session files, .bashrc), whom the gate of the split asks
 # (private.config.session.chain.ready) and whose user.session.env the oosh
 # migrate cleans. The one place that decides "linked". A home the caller
 # cannot search (0750 homes, a non-root caller) hides its link: it is left
 # out and the rc says so — the gate treats that as not proven.
 local target h link owner rc=0
 target=$(private.this.path.canonical "$1" 2>/dev/null)
 [ -n "$target" ] || return 1
 while IFS= read -r h; do
   [ -z "$h" ] && continue
   if [ ! -x "$h" ]; then rc=1; continue; fi
   [ -L "$h/config" ] || continue
   link=$(private.this.path.canonical "$h/config" 2>/dev/null)
   [ "$link" = "$target" ] || continue
   owner=$(private.this.path.stat.get "$h" owner)
   [ -n "$owner" ] && echo "$h $owner"
 done <<HOMES
$(private.config.homes.list)
HOMES
 return $rc
}


private.config.bashrc.ensure.all()     # <sharedConfig> <sharedOosh> # as root, give every user linked to <sharedConfig> the oosh .bashrc of the branch their own ~/oosh points at (<sharedOosh> for a user without one) when theirs differs, each in their own hop #
{
 # `oo update` renewed only the .bashrc of the user running it: a new prompt
 # ([oosh jolly_gagarin] bash-user@jolly_gagarin, 2026-10-05) needed an
 # `oo update` by every user. Root reaches them all, AS each user (their file
 # stays theirs); private.user.bashrc.install is the one writer. No
 # create.result: config.init.user's RESULT must stand.
 # The template is that of THEIR branch — the canonical target of their own
 # ~/oosh: root's branch for everyone made a user on testing ping-pong with
 # their own next oo update (T-CONFIG-BASHRC-ALL-OWN-BRANCH).
 local sharedConfig="$1" sharedOosh="$2" h owner userOosh
 [ "$(id -u)" = "0" ] || return 0
 while read -r h owner; do
   [ -z "$h" ] && continue
   userOosh=$(private.this.path.canonical "$h/oosh" 2>/dev/null)
   [ -n "$userOosh" ] && [ -r "$userOosh/templates/user/bashrcTemplate" ] || userOosh="$sharedOosh"
