# Never persist these to user.env — terminal/VSCode/git/locale/test leakage that
# pollutes the env file and breaks portability across machines (BUG A).
private.config.var.denied() { # <varName> # rc 0 if the var must NEVER be persisted
  case "$1" in
    TERM|COLORTERM|TERM_PROGRAM|TERM_PROGRAM_VERSION|COLUMNS|LINES) return 0 ;;
    LANG|BROWSER|EXPECTED_RETURN_VALUE|GET_TEST_VAR|_) return 0 ;;
    LC_*|GIT_*|LESS*|VSCODE_*|LS_COLORS) return 0 ;;
  esac
  return 1
}

# Live-env harvest allow-list: only OOSH-owned vars may be captured fresh from
# the shell env (which is full of leakage). Curated file vars bypass this — they
# went through config.set or a prior good save (BUG A: allow-list not deny-list).
private.config.var.allowed() { # <varName> # rc 0 if the var may be harvested from live env
  private.config.var.denied "$1" && return 1
  case "$1" in
    OOSH_*|LOG_*|CONFIG_*|HIVEMIND_*) return 0 ;;
    USER|HOME|PATH|BASH_FILE|TMPDIR) return 0 ;;
  esac
  return 1
}

private.config.declare.varname() # <declare-or-export-line> # THE canonical varname extractor (config-save-greedy-varname-drop contract A). Anchored, NEVER greedy: strip the exact prefix, then take the identifier up to the FIRST '='. The value (after '=') is structurally UNREACHABLE — a value containing ' x=' CANNOT corrupt the name. Prints varname+rc0, else empty+rc1.
{
  local line="$1" vn=""
  case "$line" in *=*) ;; *) return 1 ;; esac      # must be an assignment
  case "$line" in
    "declare -"*) vn="${line#declare }"; vn="${vn#-* }"; vn="${vn%%=*}" ;;  # `declare -flags IDENT=…` → IDENT
    "export "*)   vn="${line#export }";  vn="${vn%%=*}" ;;                   # `export IDENT=…`         → IDENT
    *) return 1 ;;
  esac
  # Pinned identifier only — reject anything with a non-identifier char (proves the
  # capture didn't run into a value).
  case "$vn" in
    ""|[!A-Za-z_]*|*[!A-Za-z0-9_]*) return 1 ;;
  esac
  echo "$vn"
}

private.config.commit.checked() # <tmpfile> <realfile> <intended-newline-list> # contract B: FAIL-LOUD round-trip. Re-parse tmp → persisted; if any intended var is missing → error+rc1 and KEEP the original (atomic mv only on match) = no silent loss for ANY drop cause.
{
  local tmp="$1" real="$2" intended="$3"
  local persisted dropped="" vn
  persisted=$(while IFS= read -r line; do private.config.declare.varname "$line"; done < "$tmp" 2>/dev/null)
  while IFS= read -r vn; do
    [ -z "$vn" ] && continue
    printf '%s\n' "$persisted" | grep -qxF "$vn" || dropped="$dropped $vn"
  done <<< "$intended"
  if [ -n "$dropped" ]; then
    error.log "config.save: round-trip DROPPED:${dropped} — refusing silent data loss (kept original $real)"
    rm -f "$tmp" 2>/dev/null
    return 1
  fi
  mv "$tmp" "$real"
}

config.save() # <?name> <?ENV_PREFIX> <?silent:silent># creates an "<name>.env" config file in $CONFIG_PATH containing all env variables that match <ENV_PREFIX>
# without parameters it inititlises the $CONFIG_PATH/user.env
{
  #set -x


  local file=$1
  shift
  local name=$1
  local silent=$3

  if [ -n "$silent" ]; then
    console.log "config.save (CONFIG=$CONFIG)"
  fi

  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    warn.log "BASH 5 support only" # on bash 3 this would help: $(tr '[:lower:]' '[:upper:]' <<< "$file")
    name=${file^^}
  else
    shift
  fi


  if [ -n "$file" ]; then
    config.file $file.env
  else
    name="CONFIG"
  fi
  
  stop.log "
  config.save [file:$file] [name:$name] to $CONFIG"
  RESULT=""

  if [ -n "$file" ]; then
    # Single-file save (e.g. oosh.env, log.env): dump from declare -px → TMP, then
    # fail-loud round-trip commit (contract B) so no matching var is silently lost.
    local tmp="${CONFIG}.tmp.$$"
    {
      declare -px 2>/dev/null | while IFS= read -r line; do
        local varname
        varname=$(private.config.declare.varname "$line") || continue
        case "$varname" in ${name}*) ;; *) continue ;; esac
        case "$line" in "declare -a"*|"declare -A"*) continue ;; esac
        echo "$line" | sed 's/^declare -[^ ]* /export /'
      done
    } >"$tmp"
    # intended = EXPORTED varnames matching the prefix, from compgen -e (NAME-direct,
    # does NOT go through the extractor, so a broken/greedy extractor drop is DETECTED
    # not hidden). compgen -e (EXPORTED only) mirrors the `declare -px` source above —
    # `compgen -v` would over-include non-exported shell vars → false "dropped".
    local intended
    intended=$(compgen -e 2>/dev/null | while IFS= read -r vn; do
        case "$vn" in ${name}*) ;; *) continue ;; esac
        case "$(declare -p "$vn" 2>/dev/null)" in "declare -a"*|"declare -A"*) continue ;; esac
        echo "$vn"
      done)
    private.config.commit.checked "$tmp" "$CONFIG" "$intended" || { RESULT="config.save round-trip failed"; return 1; }
  else
    # No-args path: regenerate user.env via harvest-resolve-merge
    info.log "generating $CONFIG"

    # PHASE 1 — HARVEST: valid exports from FILE + live env
    # File first (preserves user state from born-broken boxes), then live (captures newly exported vars)
    local harvestFile="${TMPDIR:-/tmp}/config.harvest.$$"
    : > "$harvestFile"
    # From file: keep curated exports (config set / prior good save) UNLESS in the
    # never-persist deny-set — cleans leakage a prior buggy save already wrote.
    if [ -f "$CONFIG" ]; then
      while IFS= read -r line; do
        [[ "$line" =~ ^export[[:space:]] ]] || continue
        local vn; vn=$(private.config.declare.varname "$line") || continue
        private.config.var.denied "$vn" && continue
        echo "$line" >> "$harvestFile"
      done < "$CONFIG"
    fi
    # From live env: STRICT allow-list. The shell env is full of terminal/VSCode/
    # git/test leakage; only OOSH-owned vars may be newly captured from it.
    declare -px 2>/dev/null | while IFS= read -r line; do
      local vn; vn=$(private.config.declare.varname "$line") || continue
      case "$line" in "declare -a"*|"declare -A"*) continue ;; esac
      grep -q "^export ${vn}=" "$harvestFile" 2>/dev/null && continue
      private.config.var.allowed "$vn" || continue
      echo "$line" | sed 's/^declare -[^ ]* /export /' >> "$harvestFile"
    done

    # PHASE 2 — RESOLVE: canonical fundamentals from BASH_SOURCE
    private.this.resolve.fundamentals

    # PHASE 3 — MERGE + WRITE (to TMP, then fail-loud round-trip commit — contract B)
    [ -z "$BASH_FILE" ] && BASH_FILE=$(which bash 2>/dev/null)
    local tmp="${CONFIG}.tmp.$$"
    {
      # Fundamentals (canonical — always correct, override stale)
      echo "export CONFIG_PATH=\"$CONFIG_PATH\""
      echo "export CONFIG_FILE=\"$CONFIG_FILE\""
      echo "export CONFIG=\"$CONFIG_PATH/$CONFIG_FILE\""
      echo "export OOSH_DIR=\"$OOSH_DIR\""
      echo "export OOSH_MODE=\"$OOSH_MODE\""
      echo "export BASH_FILE=\"$BASH_FILE\""
      echo "export PATH=\"$PATH\""

      # Harvested user vars (skip fundamentals — already written)
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        [[ "$line" =~ ^export[[:space:]] ]] || continue
        local vn; vn=$(private.config.declare.varname "$line") || continue
        case "$vn" in
          CONFIG_PATH|CONFIG_FILE|CONFIG|OOSH_DIR|OOSH_MODE|BASH_FILE|PATH) continue ;;
        esac
        echo "$line"
      done < "$harvestFile"

    } > "$tmp"

    # intended = fundamentals + every harvested varname (extracted robustly from the
    # harvestFile, which is the already-curated set to persist). A drop between the
    # harvest and the written tmp → detected, original user.env preserved.
    local intended
    intended=$(printf 'CONFIG_PATH\nCONFIG_FILE\nCONFIG\nOOSH_DIR\nOOSH_MODE\nBASH_FILE\nPATH\n'
      while IFS= read -r line; do
        private.config.declare.varname "$line"
      done < "$harvestFile" 2>/dev/null)
    rm -f "$harvestFile" 2>/dev/null
    private.config.commit.checked "$tmp" "$CONFIG" "$intended" || { RESULT="config.save round-trip failed"; return 1; }

    if [ -n "$OOSH_DIR" ]; then
      config.save oosh OOSH
      config.save log LOG
    fi
    config.file user.env
    config.validate
  fi
  config.info.log
}

config.bash.minimal.version() { # <bash.minimal.version:5> # sets the BASH_MINIMUM_MAJOR_VERSION
  echo "export BASH_MINIMUM_MAJOR_VERSION=$1" >>$CONFIG
}

config.list() # <name:$CONFIG> # lists the content of the config with <name>
{
  config.file.check $1
  cat $CONFIG
}

config.delete() # <name:$CONFIG> # deletes the config with <name>
{
  config.file.check $1
  rm $CONFIG_PATH/$CONFIG_FILE
}

config.update() { # <?name:$CONFIG> <?ENV_PREFIX> # saves and adds the config 
  config.save $1 $2
  config.add $1 $2
  config.info.log
}

config.info.log() # # logs the config when on LOG_LEVEL info or higher
{
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.edit() # <name:$CONFIG> # edits the config with <name> in vim
{
  #check.debug.level 6
  oo cmd vim
  if config.file.check $1; then
    vim $CONFIG
  else
    vim $CONFIG
    exit $ERROR_CODE_RECONFIG
  fi
}

config.clean() #  # reinitalises a clean config and removes any custom addons
{
  config.file.check $1
  awk '!seen[$0]++' $CONFIG >$CONFIG_PATH/$CONFIG_FILE.clean
  mv $CONFIG_PATH/$CONFIG_FILE.clean $CONFIG_PATH/$CONFIG_FILE
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.validate() # <?file> # verify env file contains only pure state (export/declare lines, comments, blanks)
{
  config.file.check $1
  local violations=0
  local lineNum=0
  while IFS= read -r line; do
    lineNum=$((lineNum + 1))
    [ -z "$line" ] && continue
    [[ "$line" == "#"* ]] && continue
    # Allow: export/declare, bare VAR=, source *.env (Rule A: legit env-file chaining)
    if [[ "$line" =~ ^(export|declare)[[:space:]] ]] || [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      continue
    fi
    if [[ "$line" =~ ^source[[:space:]].*\.env ]] || [[ "$line" =~ ^\.[[:space:]].*\.env ]]; then
      continue
    fi
    error.log "config.validate: line $lineNum is not pure state: $line"
    violations=$((violations + 1))
  done < "$CONFIG"
  if [ "$violations" -gt 0 ]; then
    error.log "config.validate: $CONFIG has $violations violation(s)"
    return 1
  fi
  return 0
}

config.repair() # # repair IS init — regenerate user.env via harvest-resolve-merge (alias for config.save)
{
  config.save
}

config.add() # <name:$CONFIG> # adds source line for <name>.env into user.env (config composition via Rule A)
{
  local file=$1
  grep -q "^source.*${file}.env" "$CONFIG" 2>/dev/null && return 0
  shift
  local name=$1

  if [ -n "$file" ] &&  [ -z "$name" ]; then
    warn.log "BASH 5 support only"
    name=${file^^}
  else
    shift
  fi

  if [ -z "$file" ]; then
    name="CONFIG"
  fi

  console.log "
  config.add [file:$file] [name:$name] to $CONFIG"
  {
    echo "source \$CONFIG_PATH/$file.env"
  } >>$CONFIG
  config.clean
}

config.file.check() # <name:$CONFIG> # sets the default config file to <name> if it exists
{
  if [ -n "$1" ]; then
    config.file $1.env
    shift
    RETURN=$1
    RETURN_VALUE=0
  else 
    RETURN_VALUE=1
  fi
  info.log "config file: $CONFIG"
  create.result $RETURN_VALUE $CONFIG
  return "$(result)"

}

config.file() # <configfile> # sets the default config file to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        export FILE=$1
        CONFIG_FILE=$FILE

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
    esac
  fi
}

config.location() # <configfile> # sets the default config location to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        local oldConfig="$CONFIG"

        export FILE=$(basename $1)
        CONFIG_PATH=$(dirname $1)
        CONFIG_FILE=$FILE

        info.log "old config     : $oldConfig"
        info.log "new config path: $CONFIG_PATH"
        info.log "new config file: $CONFIG_FILE"

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
        config.save
        bash
    esac
  fi
}

config.parameter.completion.configfile() {
  echo "reset"
  c2 file.completion "$1"
}

config.parameter.completion.envVariable() {
  cat $CONFIG | line replace "export " | line replace "=.*$" | line filter "source"
}

function config.path.create() # <pathString> # (internal deprecated) creates respective paths
{
    debug.log " function ${FUNCNAME[0]}($1) $@"

    if [[ "$1" = /* ]]; then
        cd "/"
    fi

    path=""
    info.log "creating path in $(pwd): $1"

    for current in ${1//// }; do

        if [ -z "$path" ]; then
            path=$current
        else
            path=$path/$current
        fi
        debug.log "checking path: $path"

        config.folder.create $path
    done
}

function config.folder.create() # <folderName> # (internal deprecated) creates respective directory requested in parameter 
{

    local current=$1
    if [ ! -d $current ]; then
        debug.log "$current does not exist: creating it..."
        mkdir -p $current
    fi
}

