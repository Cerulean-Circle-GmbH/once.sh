private.config.env.lines.drop()     # <file> <prefix> <?morePrefixes> # drop every line of the env <file> that starts with one of the prefixes, in place (owner, group and mode kept); an unchanged file is not rewritten; rc 1 and RESULT when the file cannot be written #
{
 # The one owner of "these lines leave a shared env file": the migrates of
 # user.env, oosh.env, log.env and the users' user.session.env. Rewritten in
 # place — `>` keeps the owner, group and mode of a file every dev-group user
 # may write (replace commit puts a new file under the name: the writer
 # becomes its owner). Nothing is written when no line matches. The write is
 # checked: a caller not in group dev, or a full disk, is rc 1, never a
 # silent success. Silent otherwise: no logging (LOG_DEVICE can be fd1).
 local file="$1" line out="" prefix dropped=0
 if [ -z "$file" ] || [ -z "$2" ]; then
   create.result 1 "private.config.env.lines.drop requires <file> <prefix>"
   return $(result)
 fi
 shift
 if [ ! -f "$file" ]; then
   create.result 0 "$file does not exist — nothing to drop"
   return $(result)
 fi
 while IFS= read -r line || [ -n "$line" ]; do
   for prefix in "$@"; do
     case "$line" in "$prefix"*) dropped=$((dropped + 1)); continue 2 ;; esac
   done
   out="$out$line"$'\n'
 done < "$file"
 if [ "$dropped" = 0 ]; then
   create.result 0 "$file unchanged"
   return $(result)
 fi
 if ! { printf '%s' "$out" > "$file"; } 2>/dev/null; then
   create.result 1 "cannot write $file — $dropped line(s) not dropped"
   return $(result)
 fi
 create.result 0 "$file: $dropped line(s) dropped"
 return $(result)
}


private.config.env.line.append()     # <file> <line> # append <line> to the env <file> unless the file already holds it as a whole line, in place (owner, group and mode kept); rc 1 and RESULT when the file cannot be written #
{
 # The twin of private.config.env.lines.drop: a chain line onto a shared env
 # file, once. `>>` keeps owner, group and mode; the write is checked. Silent
 # (LOG_DEVICE can be fd1).
 local file="$1" line="$2"
 if [ -z "$file" ] || [ -z "$line" ]; then
   create.result 1 "private.config.env.line.append requires <file> <line>"
   return $(result)
 fi
 if grep -qxF -- "$line" "$file" 2>/dev/null; then
   create.result 0 "$file already holds the line"
   return $(result)
 fi
 # A last line without its newline would swallow the appended one.
 local lead=""
 [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ] && lead=$'\n'
 if ! { printf '%s%s\n' "$lead" "$line" >> "$file"; } 2>/dev/null; then
   create.result 1 "cannot write $file — line not appended"
   return $(result)
 fi
 create.result 0 "$file: line appended"
 return $(result)
}


