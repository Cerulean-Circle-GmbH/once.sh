config.completion.discover() {
  #set -x
  #info.log "completion.discover $*"
  local command=$1
  shift
  local ac=$(command -v $command)
  case "${command}" in
    "init"|"oosh"|"this")
      command="this"
      ac=$OOSH_DIR/this
    ;;
    "oo")
      if [ -n "$1" ]; then
        #set -x
        command=$1
        shift
        ac=$(command -v $command)
        if [ -n "$ac" ]; then
          config.completion.discover $ac
          return 0
        else
          cd $OOSH_DIR
          compgen -f $command
          return 0
        fi
      fi
    ;;    
    "once.sh")
      command="once"
    ;;
    "config")
      debug.log "in config"
      ac=$OOSH_DIR/config
    ;;
    *)
      debug.log "$command not found in completion"
    ;;
  esac
  
  local method=""
  local previous=""
  local last=""
  while [ -n "$1" ]; do
   previous=$method
   if [ -z "$method" ]; then
    method=$1
   else
    method=$method.$1
   fi
   last=$1
   shift
  done

  # if [ -n "$command" ]; then
  #   if [ -x "$(command -v $command)" ]; then
  #     info.log "sourcing $command"
  #     #source "$command"
  #   else
  #     return 1
  #   fi
  # else
  #   return 1
  # fi


  if (config.check.completion $command $previous); then
      $ac $previous.completion $last $command $previous
  fi

  if (config.check.completion $command $last); then
    if [ "$ac" = "$OOSH_DIR/config" ]; then
      if (this.functionExists $command.$last.completion); then
        $command.$last.completion '' $command $previous
        return 0
      fi
      if (this.functionExists $command.$previous.completion); then
        $command.$previous.completion $last $command $previous
        return 0
      fi
    else

      $ac $last.completion '' $command $previous
      return 0
    fi
  fi
  # if (this.functionExists $command.$previous.completion); then
  #   $command.$previous.completion $last $command $previous
  #   return 0
  # fi

  if [[ $method == *[\\/\(\)]* ]]; then
    create.result 1 "$method contains special characters"
    #echo $RESULT
    return "$(result)" 
  fi

  #echo method:$method
  local find="^\(function \)*\($command\.\)\($method[^(#\"]*\)\(.*\)"

  grep "$find" $ac | sed 's/'"$find"'/\3/' | sed 's/\(.*\)\(\.completion.*\)/\1/'
  #echo "$@"
}

config.check.completion() {
  local command=$1
  local ac=$(command -v $command)
  local method="$2.completion"
  local find="^\(function \)*\($command\.\)\($method[^(#\"]*\)\(.*\)"
  if [[ $method == *[\\/\(\)]* ]]; then
    create.result 1 "$method contains special characters"
    #echo $RESULT
    return "$(result)"
  fi
  RESULT=$(grep "$find" $ac | sed 's/'"$find"'/\3/')
  if [ "$RESULT" = "$method" ]; then
    create.result 0 "$RESULT"
  else
    create.result 1 "$method not found"
  fi
  debug.log "$RESULT"
  return "$(result)"
}


config.edit.completion() {
  config.list.completion "$@"
}

config.delete.completion() {
  config.list.completion "$@"
}



config.list.completion.name() {
  #echo "$@"
  export FILTER=$1
  # Offer names from BOTH config tiers: shared $CONFIG_PATH (log, oosh, user) and
  # per-user $HOME/.config/oosh (log.session). Guard each glob so an
  # unmatched pattern isn't emitted literally.
  for file in ${CONFIG_PATH}/*.env "$HOME/.config/oosh"/*.env
    do
      [ -e "$file" ] || continue
      echo "$(basename $file)" | line replace ".env"
    done
}

config.string.quote() { # <string> # quote the string to be used as a command line argument
  RESULT=$(printf %s\\n "$1" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/'/")
  echo $RESULT
}

config.init() # # inititalizes the $CONFIG environment if $CONFIG is empty
{
  # HONOUR an anchor already set; default to the constant when there is none.
  # This used to be an unconditional `export CONFIG_PATH=~/config`, and
  # config.start re-runs config.init whenever $CONFIG is not a file — so
  # sourcing `config` silently moved the anchor back and undid any fixture
  # FROM INSIDE the file under test. That is why test/test.config and
  # test/test.completion.audit had to declare TEST_SHARED_TIER_WRITER instead
  # of isolating.
  #
  # The conditional form is not a bend of the anchor rule, it IS the rule:
  # private.this.anchor.validate.one counts `: ${CONFIG_PATH:=~/config}` as
  # CONFORMING, and `this`, `log` and `ossh` already use exactly this shape for
  # exactly this variable. A cold shell still lands on the constant.
  # CONFIG_PATH only. CONFIG_FILE is NOT an anchor — it is the currently
  # selected file, and `config file reset` means "go back to user.env" and
  # reaches that through here (config.file's reset branch). Making it
  # conditional too broke T16, which is exactly the assertion that pins it.
  : ${CONFIG_PATH:=~/config}
  export CONFIG_PATH
  export CONFIG_FILE=user.env

  if [ ! -d $CONFIG_PATH ]; then
    mkdir $CONFIG_PATH # kernel-exception: pre-existing on dev, out of the heal scope
  #else
  #  source $CONFIG
  fi
  touch $CONFIG_PATH/error.txt

  export CONFIG=$CONFIG_PATH/$CONFIG_FILE
  debug.log "$CONFIG"
}

# ---------------------------------------------------------------------------
# Repair primitives — bring a tampered/corrupted OOSH layout back to the
# canonical install state (matches what init/oosh produces). NOT called by
# the bashrc-startup `config.init` above; that path stays cheap.
# Reference state: ~/config and ~/oosh symlinks owned <user>:<user>;
# sharedConfig directories 2775 (setgid) and files g+w, group dev; no self-referential symlinks.
# ---------------------------------------------------------------------------

config.init.shared() # # share the sharedConfig with group dev: its directories 2775 with setgid, its files group-writable — only the entries not shared yet (private.this.folder.share); remove self-loops; idempotent
{
  # `user` script provides user.get, private.as.user, user.group.add — not
  # auto-loaded by `source this`. Source on demand so `./config init.*` works
  # in standalone invocations (the c2 dispatch path in interactive shells
  # already pulls it in).
  [ "$(type -t user.get)" = "function" ] || source "$OOSH_DIR/user" >/dev/null 2>&1
  local devHome
  devHome=$(user.get home developking 2>/dev/null)
  if [ -z "$devHome" ]; then
    error.log "config.init.shared: cannot resolve developking's home — run ${YELLOW}ossh install${NORMAL} first"
    return 1
  fi
  local sharedConfig
  sharedConfig=$(private.config.shared.config.get)
  if [ ! -d "$sharedConfig" ]; then
    error.log "config.init.shared: sharedConfig missing: ${RED}$sharedConfig${NORMAL} — install not completed"
    return 1
  fi
  important.log "config.init.shared: normalising ${YELLOW}$sharedConfig${NORMAL} (group dev: directories 2775 with setgid, files g+w)"
  private.this.selfLoop.remove "$sharedConfig" >/dev/null || error.log "config.init.shared: $RESULT"
  # The kernel's one share primitive: only the entries not shared yet, setgid
  # on the directories so a file root creates there is group dev.
  if ! private.this.folder.share "$sharedConfig" yes >/dev/null; then
    error.log "config.init.shared: $RESULT"
    return 1
  fi
  return 0
}

config.init.user()     # <?username:$USER> <?sharedOosh> # ensure the ~/config + ~/oosh symlinks of <username> match canonical install; <sharedOosh>, a branch folder directly under the components base, is the ~/oosh target and wins over the link that is there; rc 1 with the reason in RESULT (a failed symlink hop names its own) #
{
  [ "$(type -t user.get)" = "function" ] || source "$OOSH_DIR/user" >/dev/null 2>&1
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  if [ -z "$username" ]; then username="$USER"; fi
  local givenOosh=""
  [ -n "$1" ] && givenOosh=$(private.this.path.case.get "${1%/}")

  local targetHome
  targetHome=$(user.get home "$username" 2>/dev/null)
  if [ -z "$targetHome" ]; then
    create.result 1 "config.init.user: cannot resolve the home of $username"
    error.log "$RESULT"; return $(result)
  fi
  local devHome
  devHome=$(user.get home developking 2>/dev/null)
  if [ -z "$devHome" ]; then
    create.result 1 "config.init.user: developking missing — run ossh install first"
    error.log "$RESULT"; return $(result)
  fi
  local sharedConfig
  sharedConfig=$(private.config.shared.config.get)
  # Resolve the canonical shared oosh dir. Preference order, picking the
  # first that resolves to an existing dir under the shared tree:
  #   0. The <sharedOosh> the caller names — `oo heal <branch>` heals to
  #      <base>/<branch>, and the link that is there must not win over it
  #      (T-CONFIG-INIT-USER-SHARED-OOSH-PARAM). Only a folder the base lists:
  #      private.ogit.base.folders.list owns "a branch folder" (a clone directly
  #      under the base, no symlink) and is what the completion offers; base
  #      and path both in the file system letter case.
  #   1. The current $OOSH_DIR (we're running from it — trustworthy).
  #   2. The existing target of <user>'s ~/oosh symlink (if already aligned).
  #   3. The branch named by $OOSH_MODE / git fallback / "dev".
  # Avoids the case where $OOSH_MODE is set to a stale value like "released"
  # that doesn't have a corresponding worktree on disk.
  local sharedOoshBase
  sharedOoshBase=$(private.config.shared.oosh.base.get)
  local sharedOosh=""
  # OOSH_DIR is ~/oosh (a symlink), so the prefix test needs its PHYSICAL
  # target — the literal never starts with $sharedOoshBase. See docs/config.md § The anchor rule.
  if [ -n "$givenOosh" ]; then
    private.this.script.load ogit private.ogit.base.folders.list || {
      create.result 1 "config.init.user: cannot load ogit from $OOSH_DIR/ogit"; error.log "$RESULT"; return $(result); }
    if ! private.ogit.base.folders.list "$sharedOoshBase" | grep -qxF -- "$givenOosh"; then
      create.result 1 "config.init.user: $givenOosh is not a branch folder under $sharedOoshBase — nothing changed"
      error.log "$RESULT"
      return $(result)
    fi
    sharedOosh="$givenOosh"
  fi
  local ooshPhysical
  ooshPhysical=$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null || echo "$OOSH_DIR")
  if [ -n "$sharedOosh" ]; then
    :   # 0. named by the caller
  elif [ -d "$ooshPhysical" ] && [ "${ooshPhysical#$sharedOoshBase/}" != "$ooshPhysical" ]; then
    sharedOosh="$ooshPhysical"
  elif [ -L "$targetHome/oosh" ]; then
    local _existing
    _existing=$(readlink "$targetHome/oosh") # kernel-exception: pre-existing on dev, out of the heal scope
    if [ -d "$_existing" ] && [ "${_existing#$sharedOoshBase/}" != "$_existing" ]; then
      sharedOosh="$_existing"
    fi
  fi
  if [ -z "$sharedOosh" ]; then
    local branch="$OOSH_MODE"
    [ -z "$branch" ] && private.this.script.load ogit ogit.branch.get
    [ -z "$branch" ] && branch=$(ogit.branch.get "$OOSH_DIR" 2>/dev/null)
    [ -z "$branch" ] && branch="dev"
    sharedOosh="$sharedOoshBase/$branch"
  fi
  if [ ! -d "$sharedOosh" ]; then
    create.result 1 "config.init.user: $sharedOosh missing — install not completed"
    error.log "$RESULT"; return $(result)
  fi

  important.log "config.init.user: aligning ${YELLOW}$username${NORMAL}'s ~/config and ~/oosh to canonical state"

  # Symlink reconciliation in two phases.
  #
  # Phase 1 — recreate (only if needed): dispatch through private.as.user so
  # newly-created symlinks inherit <user>:<user> ownership naturally. This is
  # the same trick user.oosh.install uses (its symlink hop) — and the reason
  # fresh installs produce hannesn:hannesn while a tampered install path can
  # leave hannesn:dev. Skip the dispatch entirely when both symlinks already
  # point at the canonical targets — avoids the runuser PAM-session overhead
  # and an observed silent-failure mode under sudo when env is sanitised.
  #
  # Phase 2 — force ownership: chown -h is run by THIS shell (not via
  # private.as.user). When the caller is root (the typical sudo path) chown
  # works for any target. When the caller is the target user, chown to their
  # own primary group works without sudo. Other combinations are skipped
  # quietly (e.g. sudoer alice repairing bob — the recreate path already
  # gave bob:bob).
  local _needsRecreate=0
  # kernel-exception: pre-existing on dev, out of the heal scope
  if [ ! -L "$targetHome/config" ] || [ "$(readlink "$targetHome/config")" != "$sharedConfig" ] \
  || [ ! -L "$targetHome/oosh"   ] || [ "$(readlink "$targetHome/oosh")"   != "$sharedOosh"   ] \
  || [ -d "$targetHome/config" -a ! -L "$targetHome/config" ] \
  || [ -d "$targetHome/oosh"   -a ! -L "$targetHome/oosh"   ]; then
    _needsRecreate=1
  fi
  if [ "$_needsRecreate" = "1" ]; then
    # Delegate symlink convergence to the shared primitive
    # private.this.symlink.with.backup (in this). private.as.user runs
    # the operations AS the target user, so the symlinks naturally inherit
    # <user>:<user> ownership — the canonical install layout.
    #
    # The shared preamble (private.this.as.user.preamble.get, as in the later
    # hops) brings the primitive into scope from the SHARED tree's `this`, for
    # the TARGET — never the caller's $OOSH_DIR, which the caller expands: root's
    # 0700 /root/oosh or a heal's temp clone the target cannot read
    # (T-CONFIG-INIT-USER-SYMLINK-HOP-PREAMBLE). No `set -e`: explicit
    # `|| exit 1` after each primitive call is the fail-fast.
    #
    # The primitive is the one of <sharedOosh> — under `oo heal all` the
    # branch a user keeps, an older tree than this one, whose version required
    # a <ts>: '' failed it (T-CONFIG-INIT-USER-HOP-OLD-TREE). One stamp, free
    # for config and oosh, taken here and handed to both calls — every version
    # takes it. On a failure the hop echoes the primitive's RESULT: the reason
    # lands in this method's RESULT, not only on the hop's log device
    # (T-CONFIG-INIT-USER-FAIL-REASON).
    local ts hopOut
    ts=$(private.this.orig.stamp.get "$targetHome" config oosh)
    if ! hopOut=$(private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")
      cd \"$targetHome\" || { echo \"cannot cd to $targetHome\"; exit 1; }
      private.this.symlink.with.backup config '$sharedConfig' '$ts' || { echo \"\$RESULT\"; exit 1; }
      private.this.symlink.with.backup oosh   '$sharedOosh'   '$ts' || { echo \"\$RESULT\"; exit 1; }
    " 2>&1); then
      create.result 1 "config.init.user: failed to create the ~/config and ~/oosh symlinks of $username — $(printf '%s' "$hopOut" | grep . | tail -3 | tr '\n' ' ')"
      error.log "$RESULT"
      return $(result)
    fi
  fi
  # Phase 2 — force canonical owner on the symlinks. Only when this shell has
  # the privilege to do so (root, or self).
  if [ "$(id -u)" = "0" ] || [ "$username" = "$USER" ]; then
    chown -h "$username:$username" "$targetHome/config" "$targetHome/oosh" 2>/dev/null || true # kernel-exception: pre-existing on dev, out of the heal scope
  fi

  # The oosh .bashrc and the per-user session files the shared env files
  # chain UNGUARDED (log.session.env, user.session.env) — through the one
  # writers, AS the target user so all are <user>:<user>. The shared preamble
  # stands the TARGET up: their HOME (so user.session.env gets THEIR real PATH
  # and the branch THEIR ~/oosh points at), no leaked anchors or OOSH_MODE of
  # the caller, `this` from the SHARED tree (the caller's may be /root/oosh).
  private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")
    private.this.script.load user private.user.bashrc.install || exit 1
    private.this.script.load config private.config.session.file.ensure || exit 1
    private.user.bashrc.install \"$targetHome\" \"$sharedOosh\" >/dev/null || exit 1
    private.config.session.file.ensure \"$targetHome\" >/dev/null || exit 1
  " || error.log "config.init.user: could not install the .bashrc / session files for ${RED}$username${NORMAL}"

  # The shared log.env's OLD chain line becomes . $HOME/.config/oosh/…: oo
  # update and oo user.fix reach here, which is how an installed host leaves
  # it (T-CONFIG-LOG-CHAIN-MIGRATE).
  # A migrate answers rc 2 + RESULT "cannot write <file>" for a failed write —
  # warned, visible, and named in this method's own result — and rc 1 for a
  # closed gate, which keeps its info line (T-CONFIG-INIT-USER-WRITE-FAIL).
  local writeFailed="" migrateRc
  private.config.log.chain.migrate "$sharedConfig" \
    || { warn.log "config.init.user: $RESULT"; writeFailed="$writeFailed; $RESULT"; }

  # The forked user.env (boss, 2026-10-02): as root, every user linked to the
  # shared config first gets their own user.session.env (each in their own
  # hop), then the shared files switch — only once nobody would be left without
  # one (the gate). A non-root caller cannot look into the other homes, so the
  # switch waits for `sudo oo update` (T-CONFIG-USER-SESSION-MIGRATE).
  private.config.session.files.ensure.all "$sharedConfig" "$sharedOosh"
  # …and every one of them the oosh .bashrc this tree carries — one
  # `sudo oo update` brings a new prompt to all (T-CONFIG-BASHRC-ALL).
  private.config.bashrc.ensure.all "$sharedConfig" "$sharedOosh"
  private.config.user.session.migrate "$sharedConfig"; migrateRc=$?
  case "$migrateRc" in
    0) ;;
    1) info.log "config.init.user: the shared user.env keeps its PATH line until every user of it has ~/.config/oosh/user.session.env — run: sudo oo update" ;;
    *) warn.log "config.init.user: $RESULT"; writeFailed="$writeFailed; $RESULT" ;;
  esac
  private.config.oosh.session.migrate "$sharedConfig"; migrateRc=$?
  case "$migrateRc" in
    0) ;;
    1) info.log "config.init.user: the shared oosh.env chains oosh.session.env once every user of it has one — run: sudo oo update" ;;
    *) warn.log "config.init.user: $RESULT"; writeFailed="$writeFailed; $RESULT" ;;
  esac

  # Git trust of every folder under the base (clone layout, spec § 4): each
  # folder is its own repository with its own safe.directory entry, and
  # `oo update` / `oo user.fix` reach here, which makes this the repair (T-CONFIG-INIT-USER-CALLS).
  # The CALLER — function form, loaded on demand (the probe is the function
  # called; a failed load is said, not stepped over):
  if private.this.script.load ogit ogit.safeDirectory.ensure; then
    ogit.safeDirectory.ensure "$(dirname "$sharedOosh")" >/dev/null \
      || warn.log "config.init.user: could not ensure safe.directory — $RESULT"
  else
    warn.log "config.init.user: cannot load ogit.safeDirectory.ensure from $OOSH_DIR/ogit — safe.directory not ensured for $(id -un)"
  fi
  # The TARGET — as them, so it lands in THEIR --global config: through the
  # as-user preamble (their HOME; runuser keeps the caller's) and ogit as a
  # command, the same hop user.oosh.install uses.
  private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")"$'\n'"'$sharedOosh/ogit' safeDirectory.ensure '$(dirname "$sharedOosh")' >/dev/null" 2>/dev/null \
    || warn.log "config.init.user: could not ensure safe.directory for ${YELLOW}$username${NORMAL}"

  # Ensure dev group membership (idempotent; user.group.add no-ops if already a member).
  if private.user.check.group dev >/dev/null 2>&1; then
    user.group.add dev "$username" >/dev/null 2>&1
  fi

  if [ -n "$writeFailed" ]; then
    create.result 1 "config.init.user: $username aligned, but the shared config could not be written${writeFailed}"
    return $(result)
  fi
  success.log "config.init.user: ${GREEN}$username${NORMAL} aligned"
  create.result 0 "config.init.user: $username aligned"
  return $(result)
}

config.init.check() # <username:$USER> # diagnostics: report symlink state, dev-group health (no fixes)
{
  [ "$(type -t user.get)" = "function" ] || source "$OOSH_DIR/user" >/dev/null 2>&1
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  if [ -z "$username" ]; then username="$USER"; fi

  local targetHome
  targetHome=$(user.get home "$username" 2>/dev/null)
  if [ -z "$targetHome" ]; then
    error.log "config.init.check: cannot resolve home for ${YELLOW}$username${NORMAL}"
    return 0  # diagnostic — never block
  fi

  important.log "config.init.check: ${YELLOW}$username${NORMAL} (home: $targetHome)"

  # ~/config — owner, target, target's mode/group
  if [ -L "$targetHome/config" ]; then
    local cOwner cTarget tMode tGroup
    cOwner="$(private.this.path.stat.get "$targetHome/config" owner):$(private.this.path.stat.get "$targetHome/config" group)"
    cTarget=$(readlink "$targetHome/config") # kernel-exception: pre-existing on dev, out of the heal scope
    info.log "  ~/config: owner=$cOwner target=$cTarget"
    if [ -d "$cTarget" ]; then
      tMode=$(private.this.path.stat.get "$cTarget" mode)
      tGroup=$(private.this.path.stat.get "$cTarget" group)
      info.log "  sharedConfig: mode=$tMode group=$tGroup"
      if [ "$tGroup" != "dev" ]; then
        warn.log "  sharedConfig group ${RED}$tGroup${NORMAL} drifted from canonical ${GREEN}dev${NORMAL} — run ${YELLOW}config init.shared${NORMAL}"
      fi
      if [ -L "$cTarget/sharedConfig" ]; then
        warn.log "  self-referential symlink present at $cTarget/sharedConfig — run ${YELLOW}config init.shared${NORMAL}"
      fi
    fi
    # Symlink owner should be <user>:<user>, not <user>:dev
    case "$cOwner" in
      "$username:$username") : ;;
      *) warn.log "  ~/config owner ${RED}$cOwner${NORMAL} drifted from canonical ${GREEN}$username:$username${NORMAL} — run ${YELLOW}config init.user${NORMAL}" ;;
    esac
  else
    warn.log "  ~/config is not a symlink — run ${YELLOW}config init.user${NORMAL}"
  fi

  # Stale-dev-group warning: in /etc/group but not in active group set.
  # We can only check the *running* shell's group set when the username is
  # the caller; for other users we just check static membership.
  if getent group dev 2>/dev/null | grep -qE "(:|,)$username(,|$)"; then # kernel-exception: pre-existing on dev, out of the heal scope
    if [ "$username" = "$USER" ]; then
      if ! id -nG | grep -qw dev; then # kernel-exception: pre-existing on dev, out of the heal scope
        important.log "${YELLOW}$username${NORMAL} is in group ${GREEN}dev${NORMAL} per /etc/group, but the current shell's active groups don't include it. Log out of the desktop session ${RED}fully${NORMAL} (not just the terminal) and log back in — the active group set is captured at login time. Until then, writes to ~/config/* will hit Permission denied."
      fi
    fi
  else
    warn.log "  ${YELLOW}$username${NORMAL} not in group dev — run ${YELLOW}config init.user${NORMAL} to add"
  fi

  # Required-variable and branch-drift report. Diagnostic ONLY: the rc is
  # swallowed on purpose, because this function is documented as never failing
  # its caller and T34 pins that. The rc-1 channel is the user-invoked
  # `config validate required`, which is what a script should branch on.
  if [ "$username" = "$USER" ]; then
    config.validate.required || :
  fi
  return 0
}

config.init.env() # # regenerate user.env + oosh.env + log.env via config.save (mirrors install at oo:1456)
{
  if [ -z "$OOSH_DIR" ]; then
    error.log "config.init.env: \$OOSH_DIR is empty — re-source ${YELLOW}this${NORMAL} or rerun under ${YELLOW}sudo -E${NORMAL}"
    return 1
  fi
  # CONFIG_PATH must point at the shared sharedConfig dir we want to write
  # into. Trust the calling context: bashrc/this set it to ~/config (the
  # symlink), which `config init.user` ensures points at sharedConfig.
  if [ -z "$CONFIG_PATH" ] || [ ! -d "$CONFIG_PATH" ]; then
    error.log "config.init.env: \$CONFIG_PATH ${RED}$CONFIG_PATH${NORMAL} missing — run ${YELLOW}config init.user${NORMAL} first"
    return 1
  fi
  # Back up ALL THREE, not just user.env. Only user.env was copied before, and
  # that is exactly how OOSH_PM was lost on the macOS VM: `config save oosh
  # OOSH` truncates oosh.env with `{ … } >$CONFIG` before anything can read the
  # surviving value out of it, so by the time the save fails there is nothing
  # left to restore from. The refuse-to-worsen guard below restores from these.
  local _ts _envName
  _ts=$(date +%Y%m%d-%H%M%S)
  for _envName in user oosh log; do
    [ -f "$CONFIG_PATH/$_envName.env" ] || continue
    cp -p "$CONFIG_PATH/$_envName.env" "$CONFIG_PATH/$_envName.env.bak.$_ts" 2>/dev/null \
      || warn.log "config.init.env: failed to back up $_envName.env (continuing)"
  done
  important.log "config.init.env: backed up user/oosh/log .env → ${GREEN}*.env.bak.$_ts${NORMAL}"

  # WHAT WAS MISSING BEFORE THIS TICKET. config.save persists the ENVIRONMENT,
  # and the environment is populated FROM the config — a closed loop with no
  # source of truth. So regenerating a config that had lost a variable simply
  # wrote the gap back, and on the macOS VM the report went from two missing
  # variables to three with oosh.env emptied.
  #
  # Derive here, in the REPAIR, and never in config.save: `oo pm.discover`
  # reaches `config save` internally (oo.pm.discover → config.save's former log.device HACK → a
  # recursive `config save log LOG`), and that cascade is what wrote a shared
  # config tier on macOS. The writer stays a pure persister.
  #
  # Per-variable emptiness guard, exactly as private.user.init's OS_CMD heal
  # does it: a value that survived is NEVER overwritten by a
  # derived one. The verdicts go to stdout — nothing captures config.init.env,
  # unlike config.save — so an operator running the advertised repair can see
  # what was reconstructed and what could not be.
  local _variable _file _deriver _derived _repaired="" _unrecoverable=""
  while read -r _variable _file _deriver; do
    [ -z "$_variable" ] && continue
    [ -n "${!_variable}" ] && continue          # it survived; leave it alone
    [ "$(type -t "$_deriver")" = "function" ] || { _unrecoverable="$_unrecoverable $_variable"; continue; }
    _derived=$("$_deriver" 2>/dev/null)
    if [ -n "$_derived" ]; then
      export "$_variable=$_derived"
      _repaired="$_repaired $_variable"
    else
      _unrecoverable="$_unrecoverable $_variable"
    fi
  done <<REQUIRED
$(private.config.required.variables.get)
REQUIRED
  [ -n "$_repaired" ]      && echo "config.init.env: re-derived:$_repaired"
  [ -n "$_unrecoverable" ] && echo "config.init.env: could NOT derive:$_unrecoverable — the regenerated config will still be missing these"

  important.log "config.init.env: regenerating ${YELLOW}user.env${NORMAL} + ${YELLOW}oosh.env${NORMAL} + ${YELLOW}log.env${NORMAL} via ${YELLOW}config save${NORMAL} (mirrors install)"
  # `config save` (no args) cascades internally: writes user.env, then calls
  # itself with (oosh OOSH) and (log LOG).
  config.save || warn.log "config.init.env: config.save returned non-zero — env files may be partial"

  # REFUSE TO WORSEN. The command `config validate required` advertises as the
  # repair must never again be able to make its own report worse — which is
  # precisely what it did on the VM. A LOSS is judged by variable NAME across
  # the three files: a variable exported in any backup and in NONE of the
  # regenerated files. A per-file count called the migration a loss — the
  # 26d15a4-era user.env held OOSH_DIR, which the model keeps in oosh.env, and
  # the per-file 7 → 4 restored the old user.env (ubuntu_24_04 heal gate,
  # T-CONFIG-INIT-ENV-OLD-USER-ENV). On a loss all three backups go back.
  # Not losses: PATH and OOSH_MODE moved to the per-user session files
  # (T-CONFIG-USER-SESSION-INIT-ENV); the per-user dir variable was removed
  # 2026-10-01 (docs/config.md, the dir is spelled $HOME/.config/oosh, T44)
  # and the OOSH_CONFIG_VERSION stamp left with the revert to e6b454d; nor is
  # a name config save never persists (private.config.variable.persisted.is).
  local _envRc=0 _was="" _now="" _name _lost=""
  for _envName in user oosh log; do
    [ -f "$CONFIG_PATH/$_envName.env.bak.$_ts" ] && _was="$_was $(private.config.env.export.names.get "$CONFIG_PATH/$_envName.env.bak.$_ts" | tr '\n' ' ')"
    _now="$_now $(private.config.env.export.names.get "$CONFIG_PATH/$_envName.env" | tr '\n' ' ')"
  done
  for _name in $_was; do
    case "$_name" in PATH|OOSH_MODE|OOSH_USER_CONFIG_PATH|OOSH_CONFIG_VERSION) continue ;; esac   # legacy-chain: retired names of an old file, migrated away, never read
    private.config.variable.persisted.is "$_name" || continue   # never written by config save, so never lost by it
    case " $_now $_lost " in *" $_name "*) continue ;; esac
    _lost="$_lost $_name"
  done
  if [ -n "$_lost" ]; then
    echo "config.init.env: REFUSING — the regenerated files lost:$_lost; restoring the user/oosh/log backups *.env.bak.$_ts"
    for _envName in user oosh log; do
      [ -f "$CONFIG_PATH/$_envName.env.bak.$_ts" ] && cp -p "$CONFIG_PATH/$_envName.env.bak.$_ts" "$CONFIG_PATH/$_envName.env" 2>/dev/null
    done
    _envRc=1
  fi
  return $_envRc
}

config.init.full() # <username:$USER> # repair end-to-end: shared dir + user symlinks + env files + diagnostics
{
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  if [ -z "$username" ]; then username="$USER"; fi

  local rc=0
  config.init.shared || rc=$?
  config.init.user "$username" || rc=$?
  # init.env runs AFTER init.user so the ~/config symlink is canonical
  # before we write into the target. Only run for self-repair — regenerating
  # other users' env files from the caller's shell would write THIS shell's
  # OOSH_*/LOG_* state into THEIR config (likely wrong values).
  if [ "$username" = "$USER" ] || [ "$(id -u)" = "0" -a "$username" = "root" ]; then
    config.init.env || rc=$?
  fi
  config.init.check "$username" || rc=$?
  return $rc
}

config.init.shared.completion() { :; }
config.init.env.completion()    { :; }
config.init.user.completion.username()  { user.list; }
config.init.user.completion.sharedOosh() {
  # The branch folders of the components base — exactly what <sharedOosh>
  # accepts: the same base (private.config.shared.oosh.base.get) and the same
  # rule owner (private.ogit.base.folders.list, T-BASE-FOLDERS-ONE-LOOP); no
  # create.result in either, so c2's completion subprocess stays clean.
  private.this.script.load ogit private.ogit.base.folders.list || return 0
  private.ogit.base.folders.list "$(private.config.shared.oosh.base.get)"
}
config.init.check.completion.username() { user.list; }
config.init.full.completion.username()  { user.list; }

private.config.variables.list()     # <envPrefix> <?sessionSplit> # echo one variable NAME per line for every set, scalar, persistable variable matching envPrefix; sessionSplit yes or no is the layout a full save decided, empty reads it off user.env #
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell,
  # so RESULT could never reach the caller. Same reasoning as
  # private.config.required.variables.get and private.config.file.resolve.
  #
  # SILENT BY CONTRACT. The only caller runs inside `{ … } >$CONFIG`, and
  # log's file-scope LOG_DEVICE block sets LOG_DEVICE=/proc/self/fd/1 — inside that block fd 1 IS the
  # generated env file. One debug.log here would be written into it.
  #
  # compgen -v, NOT `declare -p` with no names. On bash 3.2 the no-argument
  # form behaves like bare `declare`: `set`-style output AND every function
  # body, verbatim and multi-line, in the same stream. That is how rows of
  # private.config.required.variables.get's heredoc became lines in
  # ~/config/oosh.env — docs/research/2026-09-17-config-save-bash32.md § 2.
  # `compgen -v` emits variable NAMES ONLY, on 3.2 and 5 alike (measured).
  #
  # ${1%_}: `backup config.save global` passes BACKUP_ (backup.config.save). With the
  # underscore already there the prefix gate read `BACKUP_|BACKUP__*`, which
  # BACKUP_TARGET matches neither, so backup.env was always written empty.
  local envPrefix="${1%_}" sessionSplit="$2"
  local variableName
  # These locals are themselves listed by `compgen -v`, exactly as they
  # were by `declare -p`. camelCase cannot match an OOSH_/LOG_/CONFIG/OS_CMD_
  # prefix, so the harvest set is unchanged.
  # Read LINE BY LINE, never `for … in $(compgen -v)`. Unquoted command
  # substitution word-splits, which would SHRED a malformed row into its words
  # and let the first one through as if it were a name — the shape gate would
  # then be passing by accident. A line is the unit being validated.
  compgen -v 2>/dev/null | while IFS= read -r variableName; do
    # SHAPE GATE. The old filter derived a name with three string-strips
    # (`${_line#declare }`, `${_vn#-* }`, `${_vn%%=*}`) and never checked the
    # result was a name at all: a line with no `=` survived the last strip
    # whole, and a `case` glob spans spaces, so the row
    # `OOSH_MODE oosh.env basename of the canonical ~/oosh` matched `OOSH_*`
    # and was written out as if it were a variable.
    case "$variableName" in
      [A-Za-z_]*) ;;
      *) continue ;;
    esac
    case "$variableName" in *[!A-Za-z0-9_]*) continue ;; esac
    # Prefix as a whole name or a `name_…` family — never `${envPrefix}*`,
    # which for LOG would also grab LOGNAME.
    case "$variableName" in ${envPrefix}|${envPrefix}_*) ;; *) continue ;; esac
    # Never persisted — three kinds, one list.
    #
    # 1. Install-only / sudo-injected (LOG_INSTALL, INSTALL_LOG, SUDO_*) must
    #    not persist into user sessions. So must init/oosh's one-run gates,
    #    which the install exports: OOSH_CLEAN_ENV (the "already restarted
    #    under env -i" sentinel — saved, every later init/oosh run from a
    #    normal shell skipped its clean-environment restart) and
    #    OOSH_APT_UPDATED (saved, every later run skipped apt-get update).
    #    Found in a fresh platform container, 2026-10-01; T-CONFIG-CMD-SAVE-OOSH.
    #    And the removed per-user dir variable (always $HOME/.config/oosh, T44,
    #    2026-10-01): an old shell still exports it, and it must not come back.
    #
    # 2. RUNTIME READINGS of the one shell that ran the save: OOSH_SHLVL (the
    #    shell level `this` counts), OOSH_STATUS, OOSH_PROMPT and
    #    OOSH_CONFIG_NEEDS_SAVE. Saved, they come back into every new shell
    #    and are saved again — a loop that remembers what must be measured.
    #    (T-CONFIG-CMD-SAVE-OOSH, typed as a command: a child process sees
    #    exactly what the parent exported, and these are all exported.)
    #
    # 3. The PER-USER SESSION values LOG_NAME, LOG_DEVICE, LOG_LIVE. They
    #    belong only in each user's private
    #    $HOME/.config/oosh/log.session.env — written by log.session.save,
    #    chained as log.env's last line — never in the SHARED log.env, where a
    #    new user would inherit the saver's values (T-CONFIG-CMD-SAVE-LOG).
    #    And OOSH_MODE, the branch the user's OWN ~/oosh points at: once the
    #    shared config is switched to the forked user.env it lives in their
    #    ~/.config/oosh/user.session.env (config.session.save), never in the
    #    SHARED oosh.env, where the last saver's branch won for every user
    #    (boss, 2026-10-02). Decided below the case, by the layout.
    #
    # Every other OOSH_* / LOG_* / CONFIG* variable IS persisted: the
    # MacStudio model (test/mcdonges.latest), `config save oosh` saves all
    # OOSH_ settings. The per-user paths among them — OOSH_DIR, CONFIG_PATH,
    # OOSH_COMPONENTS_DIR — no longer leak the saving
    # user's home into the SHARED ~/config:
    # private.config.variable.export.line writes a value under $HOME as
    # "$HOME/…", which every reader expands to their own home.
    #
    # OOSH_BRANCH is the install INPUT: the branch the OPERATOR ASKED FOR,
    # meaningful for the length of one install and meaningless afterwards. It
    # is not an absolute path, so it is here for the other reason this list
    # exists — state that must be DERIVED, never remembered. Persisting it
    # closed a loop (oosh.env seeds a shell, the shell reaches a config save,
    # the save writes it back) in which nothing ever consults the checkout,
    # and it left private.oo.install.branch.get answering "prod" on a dev box
    # for weeks. The branch a host is ON is derived from the canonical
    # ~/oosh; see private.config.derive.oosh.mode. That is T7.
    #
    # ODOCKER_SG is odocker's marker for its one `sg` re-run (a runtime
    # reading, kind 2): `config save odocker ODOCKER` inside that run must
    # not store it (T-CONFIG-ODOCKER-SG-NOT-SAVED). ODOCKER_SOCKET is the
    # test/override knob of private.odocker.socket.get: exported by one
    # user, `odocker workspace.set` would have written it into the SHARED
    # odocker.env for everyone (same test).
    #
    # Documented at docs/config.md § Excluded variables and pinned by
    # test/test.config T29 — change all three together.
    # The list itself is private.config.variable.persisted.is — one place for this
    # writer and config.init.env's refuse-to-worsen.
    private.config.variable.persisted.is "$variableName" || continue
    # OOSH_MODE leaves the shared oosh.env only with the switch: until then the
    # shared user.env does not chain the user's own file, and other users'
    # shells still read their branch from here. A full config save decides the
    # layout up front and passes it as <sessionSplit>; a named save reads it
    # off user.env.
    if [ "$variableName" = "OOSH_MODE" ]; then
      case "${sessionSplit:-}" in
        yes) continue ;;
        no)  ;;
        *)   private.config.session.split.is "$CONFIG_PATH" && continue ;;
      esac
    fi
    echo "$variableName"
  done
}

private.config.variable.export.line()     # <variableName> # echo ONE export line for a set scalar variable; rc 1 for unset, array, or a value that cannot be pure data (private.this.env.export.line.get: a control character, a command substitution or backtick, or ANSI-C quoting) #
{
  # NO create.result — a getter consumed as $(...); it also runs in a loop and
  # would clobber the caller's RESULT on every iteration (config.save sets
  # RESULT="" before the block on purpose). SILENT BY CONTRACT, same fd-1
  # reason as private.config.variables.list.
  local variableName="$1"
  local declaration assignment
  # `declare -p` WITH AN EXPLICIT NAME — measured correct on bash 3.2.57
  # (`declare -- FOO="bar"`, `declare -a A='([0]="x")'`), unlike the
  # no-argument form. Bash does the quoting, so we hand-roll no escaper: the
  # same precedent, and the same reason, as result.into (in this), whose
  # comment records what a bare `echo "$1=$value"` did to values with spaces.
  declaration=$(declare -p "$variableName" 2>/dev/null) || return 1
  case "$declaration" in
    'declare -a'*|'declare -A'*|'typeset -a'*|'typeset -A'*) return 1 ;;
  esac
  assignment="${declaration#declare -* }"
  # Output-side shape gate: refuse anything that is not `NAME=…` rather than
  # guess. `declare -- X` — declared, never assigned — lands here.
  case "$assignment" in "${variableName}="*) ;; *) return 1 ;; esac
  # TWO gates (applied by the kernel, below), and the first one is the one that matters.
  #
  # (1) THE VALUE. These files are LINE-ORIENTED — config.validate and
  # test.platform.shared.config.env.invariant both read them one line at a time
  # — so a value carrying a newline cannot be written at all, whatever quoting
  # bash chooses for it. Nothing in the OOSH_/LOG_/CONFIG_ families is designed
  # to hold one, so a value that does is an upstream bug, and
  # `config validate required` is the detector that names it as missing.
  #
  # Testing the RENDERING instead of the value was a real defect, caught by T77
  # on almalinux 9 during `oo stage testing` on 2026-09-18. `$'…'` is what bash
  # >= 5.2 emits; bash 5.1 emits a DOUBLE-QUOTED string with a literal newline
  # inside it — measured identically on almalinux 9 (5.1.8), ubuntu 22.04
  # (5.1.16) and debian 11 (5.1.4). So gate (2) below matched nothing on any of
  # them, and a two-line assignment was written into oosh.env. The comment that
  # used to sit here claimed ANSI-C quoting happened "on 3.2 as well as 5";
  # that was never measured and is false for every 5.1.
  # THE ANCHORS are constants, never the saving shell's value: CONFIG_PATH is
  # always the ~/config symlink itself and OOSH_DIR always ~/oosh (T31,
  # T-CONFIG-PATH-IS-HOME-CONFIG). The installer's shell holds the RESOLVED
  # sharedConfig, which is not under $HOME and so was written literally for
  # every user (T-CONFIG-SAVE-ANCHORS-CONSTANT).
  # config-path-exception: the constants as DATA for the env file.
  # oosh-dir-exception: the constants as DATA for the env file.
  case "$variableName" in
    CONFIG_PATH)           echo 'export CONFIG_PATH="$HOME/config"'; return 0 ;;
    CONFIG)                echo 'export CONFIG="$HOME/config/user.env"'; return 0 ;;
    OOSH_DIR)              echo 'export OOSH_DIR="$HOME/oosh"'; return 0 ;;
  esac
  local value="${!variableName}" line
  # EVERY control character, not only newline and carriage return: a tab or an
  # ESC is rendered $'…' by bash >= 5.2 and 3.2 but as a plain double-quoted
  # string with the raw character inside by bash 5.1 — so on AlmaLinux 9 the
  # same value was WRITTEN that every other platform refused and reported (T116
  # red on bash 5.1.8, 2026-09-29). Judged by the value, the answer no longer
  # depends on the bash that happens to run the save. (2) THE RENDERING: a
  # $'…' is a BASHISM that dash/ash shells (/bin/sh logins, the remote prelude)
  # read literally (review-2026-09-09 § D1). Both rules, and the quoting,
  # are the kernel's private.this.env.export.line.get, which log.session.save uses too; it also
  # PREPENDS `export` (the old sed-patch of a `declare -` prefix never matched
  # bash 3.2's output, so no macOS env file carried `export`).
  # SHARED CONFIG. ~/config is one directory for every user of the host, so a
  # value under the SAVING user's home is not written as that user's absolute
  # path: it is written "$HOME/…", and each user's shell expands it to their
  # own home (T29, T-CONFIG-SAVE-PREFIX-OOSH). Only the prefix is rewritten —
  # the rest keeps the quoting bash chose for it.
  if [ -n "$HOME" ] && [ "$HOME" != "/" ]; then
    case "$value" in
      "$HOME"|"$HOME"/*)
        line=$(private.this.env.export.line.get "$variableName" "${value#"$HOME"}") || return 1
        echo "export ${variableName}=\"\$HOME${line#"export ${variableName}=\""}"
        return 0
        ;;
    esac
  fi
  private.this.env.export.line.get "$variableName" "$value"
}

private.config.variables.export()     # <envPrefix> <?sessionSplit> # echo the complete body of an env file: one export line per persistable variable matching envPrefix; sessionSplit as in private.config.variables.list #
{
  # NO create.result — its stdout IS the file. SILENT BY CONTRACT.
  #
  # review-2026-09-09 § M3 named this before it existed: "config.save's
  # `declare -p | while read` harvesting loop is a 12-line inline block that
  # reads as private.config.vars.export <prefix>". Spelled with the full word
  # `variables` to match private.config.required.variables.get in this file.
  local envPrefix="$1" sessionSplit="$2"
  local variableName
  # Line by line, for the same reason as private.config.variables.list.
  # A refused value is said, not dropped silently: error.log goes through
  # private.log.emit, which never writes stdout — this file's body
  # (T-CONFIG-WRITER-VALIDATOR-AGREE). The line is built first and written
  # after, so a write that fails (a full disk) is not mistaken for a refusal.
  local line
  private.config.variables.list "$envPrefix" "$sessionSplit" | while IFS= read -r variableName; do
    if line=$(private.config.variable.export.line "$variableName"); then
      printf '%s\n' "$line"
    else
      error.log "config save: $variableName is not saved — its value cannot be one line of pure data (a control character, \$( or a backtick)"
    fi
  done
}

private.config.string.upper()     # <string> # echo string upper-cased, without the bash-4 parameter expansion operator #
{
  # NO create.result — a getter consumed as $(...).
  #
  # `${string^^}` is bash 4+. On macOS /bin/bash 3.2 it is not a warning but a
  # FATAL "bad substitution" — the shell EXITS, measured on a sequoia VM. Both
  # config.save and config.add reached it from their DOCUMENTED single-argument
  # form (`config add oosh`, docs/config.md), so on macOS a documented command
  # killed the user's shell.
  #
  # printf | tr, not `tr <<< "$1"`: a here-string creates a temp file in
  # $TMPDIR, and this runs as root during install.
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

# ── The required-variable derivers ───────────────────────────────────────────
# One per row of private.config.required.variables.get, whose third column now
# names the function instead of describing it in prose. Before this, that column
# was documentation of a repair that did not exist (F6), which is why
# config.init.env could only re-persist the gap it was asked to fix (F5).
#
# All six are GETTERS consumed as $(...), which runs in a subshell — so none
# calls create.result, the same exemption every other private.config.* getter
# carries. They DERIVE ONLY: none assigns, none persists, none writes a file.
# That separation is deliberate. `oo pm.discover` reaches `config save`
# internally (oo.pm.discover → config.save's former log.device HACK → a recursive
# `config save log LOG`), so derivation belongs in the REPAIR and never in the
# WRITER. See docs/research/2026-09-17-config-save-bash32.md § 2.

private.config.derive.oosh.mode()     # # the branch $HOME/oosh actually points at, its canonical basename #
{
  # The same two steps config.validate.required's drift check used inline
  # (and private.check.user.shared.dev.folder.linked in oo a third time). Now one accessor, so the check and the
  # repair cannot disagree about what "the branch this host is on" means.
  # private.this.path.canonical, not `readlink -f` — the latter is GNU-only.
  local ooshTarget
  ooshTarget=$(private.this.path.canonical "$HOME/oosh" 2>/dev/null) || return 1
  [ -n "$ooshTarget" ] || return 1
  # A ~/oosh that is not there canonicalises to itself; that is not a branch.
  [ -d "$ooshTarget" ] || return 1
  echo "${ooshTarget##*/}"
}

private.config.derive.oosh.os()     # # the OS family for this host, via os.check.env #
{
  # os.check.env owns the $OSTYPE mapping and already sets OOSH_OS only when it
  # is empty, so calling it is safe whether or not the value is known. `config`
  # does not source `os`; the on-demand guard is the established route here
  # (the user guards of config.init.shared and config.init.user, the config guard of oo.user.fix).
  [ "$(type -t os.check.env)" = "function" ] || source "$OOSH_DIR/os" >/dev/null 2>&1
  [ "$(type -t os.check.env)" = "function" ] || return 1
  os.check.env >/dev/null 2>&1
  [ -n "$OOSH_OS" ] || return 1
  echo "$OOSH_OS"
}

private.config.derive.oosh.pm()     # # the package-manager install command for this host #
{
  # Already known? That IS the answer.
  [ -n "$OOSH_PM" ] && { echo "$OOSH_PM"; return 0; }
  # Second best: the binary survived even though the command did not.
  [ -n "$OOSH_PM_BIN" ] && { private.config.pm.command.get "$OOSH_PM_BIN"; return $?; }

  # NOT `oo pm.discover`. That verb is not a detector — it records what it
  # finds with `config save` (it used to run `$SUDO apt-get update` as well;
  # today the refresh is oo.cmd's, once, before its first real install), so
  # calling it from here would re-enter the writer this card deliberately keeps
  # pure. The SEED comment in test.suite.config.isolate records the same trap (a discovery asking for a sudo password) sprung once before.
  #
  # A DERIVER MUST HAVE NO SIDE EFFECTS. This is detection only: which package
  # manager exists, and what its install command is.
  local pmBin
  for pmBin in brew apt-get dnf yum apk pacman pkg; do
    command -v "$pmBin" >/dev/null 2>&1 || continue
    private.config.pm.command.get "$pmBin"
    return $?
  done
  return 1
}

private.config.pm.command.get()     # <packageManagerBinary> # the install command for a package-manager binary #
{
  # THE THIRD COPY of this table — oosh_pm_detect in init/oosh has it in POSIX sh for the
  # bootstrap, and private.check.all.pm in oo has it as arguments to private.check.pm. A
  # fourth would be indefensible; even this one is only justified because the
  # other two are unreachable from here (init/oosh self-installs when sourced,
  # and oo's copy is fused to the installer that runs sudo). Carded: one
  # side-effect-free `oo pm.detect` that all three call.
  case "$1" in
    brew)    echo "brew install" ;;
    apt-get) echo "apt-get -y install" ;;
    dnf)     echo "dnf -y install" ;;
    yum)     echo "yum -y install" ;;
    apk)     echo "apk add" ;;
    pacman)  echo "pacman -S --noconfirm" ;;
    pkg)     echo "pkg install -y" ;;
    *)       return 1 ;;
  esac
}

private.config.derive.bash.file()     # # the bash interpreter this host should use #
{
  # What config.save has always done inline (and this.start, twice). On
  # macOS `command -v bash` can answer /bin/bash 3.2 while brew bash 5 is the
  # one the install chose, so an already-set value wins — user.create picks
  # the interpreter and it is not this function's business to second-guess it.
  [ -n "$BASH_FILE" ] && { echo "$BASH_FILE"; return 0; }
  local found
  found=$(command -v bash 2>/dev/null) || return 1
  [ -n "$found" ] || return 1
  echo "$found"
}

private.config.derive.config.file()     # # the name of the config file a shell starts from #
{
  # A constant, and deliberately so: config.init and config save both
  # hard-set it, and `config file reset` means "go back to user.env". It is a
  # row in the required table because a config without it is broken, not
  # because it is ever in doubt.
  echo "user.env"
}

private.config.derive.log.level()     # # the default log level #
{
  # An already-set level wins — a host that has chosen one keeps it. The
  # fallback is 3, which is what this (its file-scope default) and log.init both actually use. The
  # table used to say "defaults to 1" and no code anywhere agreed with it.
  [ -n "$LOG_LEVEL" ] && { echo "$LOG_LEVEL"; return 0; }
  echo "3"
}
private.config.session.file.ensure()     # <targetHome> # create log.session.env, user.session.env and oosh.session.env under <targetHome>/.config/oosh when missing, never overwrite them; the shared env files chain them unguarded, so every user must have all three #
{
 # log.env's last line is `. $HOME/.config/oosh/log.session.env`, and user.env
 # chains user.session.env the same way, with no guard — env files are pure
 # data. So both files must exist for every user before their first shell:
 # boot used to touch log.session.env on every start; without boot, config
 # init.user and the install call this. log.session.env's content (LOG_NAME/
 # LOG_DEVICE/LOG_LIVE of the last session) is log.session.save's, never ours;
 # user.session.env's is config.session.save's — in the user's OWN hop it is
 # FIRST filled right away: their real PATH and the branch their ~/oosh points
 # at. Only a first fill: an empty user.session.env or a missing
 # oosh.session.env. An empty oosh.session.env is legal (no branch derivable),
 # so it triggers nothing — else every ensure rewrote user.session.env
 # (T-CONFIG-SESSION-WRITES-ONCE).
 local targetHome="$1"
 if [ -z "$targetHome" ]; then
   create.result 1 "private.config.session.file.ensure requires <targetHome>"; error.log "$RESULT"; return $(result)
 fi
 local sessionDir="$targetHome/.config/oosh"
 check dir "$sessionDir" not exists call mkdir -p "$sessionDir"
 check file "$sessionDir/log.session.env" not exists call touch "$sessionDir/log.session.env"
 if { [ ! -s "$sessionDir/user.session.env" ] || [ ! -f "$sessionDir/oosh.session.env" ]; } && [ "${targetHome%/}" = "${HOME%/}" ]; then
   ( [ -n "$OOSH_MODE" ] || export OOSH_MODE="$(private.config.derive.oosh.mode)"
     config.session.save >/dev/null 2>&1 )
 fi
 # Not the caller's home: only created — nobody writes another user's file.
 check file "$sessionDir/user.session.env" not exists call touch "$sessionDir/user.session.env"
 check file "$sessionDir/oosh.session.env" not exists call touch "$sessionDir/oosh.session.env"
 if [ -f "$sessionDir/log.session.env" ] && [ -f "$sessionDir/user.session.env" ] && [ -f "$sessionDir/oosh.session.env" ]; then
   create.result 0 "$sessionDir/log.session.env, user.session.env and oosh.session.env present"
 else
   create.result 1 "could not create the session files in $sessionDir"
 fi
 return $(result)
}


private.config.path.line.get()     #  # echo the PATH line of user.env: a snapshot of this shell's PATH made safe for a shared config — ~/oosh and ~/oosh/ng first, a bash outside /bin and /usr/bin next, every segment under $HOME written "$HOME/…", no empty, ".", relative or transient segment, each once, then :$PATH #
{
 # NO create.result — its stdout IS the line, written inside config.save's
 # `{ … } >$CONFIG`: SILENT BY CONTRACT.
 # The MacStudio model (test/mcdonges.latest) writes the whole PATH. ~/config
 # is shared between users, so the snapshot is made safe for every one of them
 # (T-CONFIG-PATH-LINE): the saver's home becomes "$HOME/…" per segment, and
 # ":$PATH" closes the line so what the system adds after the save still
 # reaches the shell (`this` drops the repeats on a re-source). The segment
 # rules live in private.config.path.segments.get, shared with the per-user
 # absolute line (private.config.path.line.absolute.get).
 # path-exception: a command TEXT for user.env, not an assignment in this shell.
 echo "export PATH=\"$(private.config.path.segments.get home):\$PATH\""
}


private.config.chain.names.get()     # <file:$CONFIG> # echo the name of every env file <file> chains with a '. $CONFIG_PATH/<name>.env' (or 'source …') line, in order, one per line; silent #
{
  # NO create.result, NO logging — a getter consumed as $(...) by config.save,
  # which reads the chains BEFORE `>$CONFIG` truncates the file (the same
  # reasoning as private.config.required.variables.get). Pure bash, no
  # subprocess: the read loop of config.validate. A legacy `source` line counts
  # like `.` — config.add writes it back as `.`.
  local file="${1:-$CONFIG}" line trimmed chainName
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    case "$trimmed" in
      '. $CONFIG_PATH/'*.env) chainName="${trimmed#'. $CONFIG_PATH/'}" ;;
      'source $CONFIG_PATH/'*.env) chainName="${trimmed#'source $CONFIG_PATH/'}" ;;
      *) continue ;;
    esac
    chainName="${chainName%.env}"
    case "$chainName" in ''|*[!A-Za-z0-9_.]*) continue ;; esac
    echo "$chainName"
  done < "$file"
}


private.config.log.chain.migrate()     # <?configPath:$CONFIG_PATH> # rewrite log.env's old session chain line to . $HOME/.config/oosh/log.session.env, in place; idempotent, silent #
{
 # The per-user dir variable was removed 2026-10-01 (always $HOME/.config/oosh,
 # T44). A host's shared log.env still ends with the old line until it is
 # rewritten, and once oosh.env no longer exports the variable that line loads
 # `/log.session.env` — a plain sh stops there. config save (before it writes)
 # and config.init.user (oo update, oo user.fix) run this. In place (owner,
 # group and mode kept): the new chain goes on as the LAST line — where log.env
 # keeps it — then the old one leaves, so no moment is without a chain. The
 # migrates share one answer: rc 2 + RESULT "cannot write <file>" when a file
 # cannot be written, rc 1 only for a closed gate (this one has none) — so a
 # caller warns about the one and keeps its gate message for the other.
 # T-CONFIG-LOG-CHAIN-MIGRATE, T-CONFIG-MIGRATE-WRITE-FAIL.
 local configPath="${1:-$CONFIG_PATH}" f
 local old='. $OOSH_USER_CONFIG_PATH/log.session.env'   # legacy-chain: the line being migrated away
 local new='. $HOME/.config/oosh/log.session.env'
 f="$configPath/log.env"
 [ -f "$f" ] || return 0
 grep -qxF "$old" "$f" 2>/dev/null || return 0
 private.config.env.line.append "$f" "$new" || return 2
 private.config.env.lines.drop "$f" "$old" || return 2
}


private.config.path.segments.get()     # <?form:home> # echo the PATH of this shell made safe for a saved PATH line, colon-joined — ~/oosh and ~/oosh/ng first, a bash outside /bin and /usr/bin next, no empty, dot, relative or transient segment, no segment holding a dollar, double quote, backslash or backtick, each once; form home writes a segment under the home as $HOME/…, form absolute keeps real paths and also drops an active VIRTUAL_ENV or CONDA_PREFIX and a directory that is not searchable #
{
 # NO create.result — a getter consumed as $(...) inside a `{ … } >file`
 # block: SILENT BY CONTRACT. One set of segment rules for both saved PATH
 # lines: the shared one (private.config.path.line.get, form home) and the
 # per-user one in user.session.env (private.config.path.line.absolute.get,
 # form absolute — boss, 2026-10-02: the user's own file holds the REAL path).
 # Trailing slashes go; an empty or "." segment (the CWD, CWE-426) and a
 # relative one go; so do transient ones — /tmp (test fixtures) and a
 # .vscode-server CLI — unless under $HOME; each segment appears once.
 # Pure parameter expansion, as private.this.path.dedup: no read, no subshell.
 local form="${1:-home}" home="${HOME%/}" out="" seen=":" seg rest ooshPhys="" ooshLink="" p
 # The PHYSICAL folder of ~/oosh is ~/oosh: root saves the shared user.env at
 # install time with the shared tree on PATH under its physical name, and a
 # literal copy would keep the old branch's su/init/external first after
 # `oo mode` (T-CONFIG-PATH-LINE-PHYSICAL-OOSH).
 [ -n "$home" ] && [ -e "$home/oosh" ] && ooshPhys=$(private.this.path.canonical "$home/oosh" 2>/dev/null)
 [ "$ooshPhys" = "$home/oosh" ] && ooshPhys=""
 # The link's OWN spelling of the folder too: on macOS the link and the
 # installer's PATH say /Users/shared/…, the canonical path /Users/Shared/…
 # (case-insensitive file system) — T-CONFIG-PATH-LINE-LINK-SPELLING.
 ooshLink=$(readlink "$home/oosh" 2>/dev/null); ooshLink="${ooshLink%/}" # kernel-exception: pre-existing on dev, out of the heal scope
 case "$ooshLink" in /*) ;; *) ooshLink="" ;; esac
 [ "$ooshLink" = "$ooshPhys" ] && ooshLink=""
 local bashDir="${BASH_FILE%/*}"
 case "$bashDir" in ""|/bin|/usr/bin) bashDir="" ;; esac
 # ~/oosh/su holds root's tools; `this` puts it on PATH for root only. A
 # user's save drops it — root's PATH reaches the as-user hops (sudo keeps it).
 local rootOnly=""
 [ "$(id -u)" = "0" ] || rootOnly="$home/oosh/su"
 rest="$home/oosh:$home/oosh/ng:${bashDir:+$bashDir:}$PATH:"
 while [ -n "$rest" ]; do
   seg=${rest%%:*}; rest=${rest#*:}
   while [ "$seg" != "/" ] && [ "${seg%/}" != "$seg" ]; do seg=${seg%/}; done
   # Both lines are executed by a shell, so a segment must be pure data in
   # either form: one holding $ " \ or a backtick goes — checked on the raw
   # segment, before the home form adds its own $HOME (T-CONFIG-PATH-LINE-NO-CODE).
   case "$seg" in *'$'*|*'"'*|*'\'*|*'`'*) continue ;; esac
   for p in "$ooshPhys" "$ooshLink"; do
     if [ -n "$p" ] && { [ "$seg" = "$p" ] || [ "${seg#"$p"/}" != "$seg" ]; }; then
       seg="$home/oosh${seg#"$p"}"; break
     fi
   done
   case "$seg" in
     ""|.|[!/]*) continue ;;
     */.vscode-server/*) continue ;;
   esac
   if [ -n "$rootOnly" ] && { [ "$seg" = "$rootOnly" ] || [ "${seg#"$rootOnly"/}" != "$seg" ]; }; then continue; fi
   if [ "$form" = "absolute" ]; then
     # The per-user line is written as it stands, so a polluted session must
     # not be frozen into the user's PATH: an active virtualenv / conda env, a
     # directory that does not exist or is not searchable (root's dirs seen
     # from an as-user hop).
     if [ -n "$VIRTUAL_ENV" ]; then case "$seg" in "$VIRTUAL_ENV"|"$VIRTUAL_ENV"/*) continue ;; esac; fi
     if [ -n "$CONDA_PREFIX" ]; then case "$seg" in "$CONDA_PREFIX"|"$CONDA_PREFIX"/*) continue ;; esac; fi
     [ -d "$seg" ] && [ -x "$seg" ] || continue
   fi
   if [ -n "$home" ] && [ "$home" != "/" ] && { [ "$seg" = "$home" ] || [ "${seg#"$home"/}" != "$seg" ]; }; then
     [ "$form" = "home" ] && seg="\$HOME${seg#"$home"}"
   else
     case "$seg" in /tmp|/tmp/*|/private/tmp/*) continue ;; esac
   fi
   case "$seen" in *":$seg:"*) continue ;; esac
   seen="$seen$seg:"
   out="${out:+$out:}$seg"
 done
 echo "$out"
}


private.config.path.line.absolute.get()     #  # echo the PATH line of the per-user user.session.env: the PATH of this shell as real absolute directories, ~/oosh and ~/oosh/ng first, no $ at all and no :$PATH #
{
 # NO create.result — its stdout IS the line, written inside a `{ … } >file`
 # block: SILENT BY CONTRACT. The file belongs to ONE user, so the path is
 # written out in full (boss, 2026-10-02) — no $HOME, and no trailing :$PATH:
 # the line IS the user's PATH (T-CONFIG-USER-SESSION-PATH-ABSOLUTE).
 # path-exception: a command TEXT for user.session.env, not an assignment in this shell.
 echo "export PATH=\"$(private.config.path.segments.get absolute)\""
}


private.config.user.session.file.get()     # <?home:$HOME> # echo the path of the per-user user.session.env under <home> #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 # The per-user tier lives in ~/.config/oosh, next to log.session.env — never
 # in the shared ~/config (every user links it to one sharedConfig).
 local home="${1:-$HOME}"
 echo "${home%/}/.config/oosh/user.session.env"
}


config.session.save()     #  # write the own session files of this user under ~/.config/oosh: the real absolute PATH into user.session.env, OOSH_MODE into oosh.session.env; refuses a HOME the caller does not own #
{
  # The per-user halves of the forked env files (boss, 2026-10-02), the twin
  # of log.session.save, one file per family: the user's PATH (real
  # directories, no $ — private.config.path.line.absolute.get) in
  # user.session.env, which the shared user.env chains last; OOSH_MODE (the
  # branch THEIR ~/oosh points at) in oosh.session.env, which the shared
  # oosh.env chains last. One user's save never reaches another user's shell.
  # Until the shared oosh.env chains oosh.session.env (the switch waits for
  # every user's file), OOSH_MODE goes into user.session.env too, so no shell
  # loses its branch in between.
  if [ -z "$HOME" ] || [ ! -O "$HOME" ]; then
    # sudo on macOS keeps the invoking user's HOME: root would leave a
    # root-owned file in somebody else's ~/.config/oosh.
    warn.log "config.session.save: HOME ($HOME) is not owned by $(id -un) — nothing written"
    create.result 1 "HOME ($HOME) is not owned by $(id -un)"
    return $(result)
  fi
  local f o mode="$OOSH_MODE" f2
  f=$(private.config.user.session.file.get)
  o=$(private.config.oosh.session.file.get)
  mkdir -p "${f%/*}" 2>/dev/null # kernel-exception: pre-existing on dev, out of the heal scope
  # A writer does not throw away what it held: no OOSH_MODE in this shell →
  # the user's oosh.session.env, else their user.session.env, else the one a
  # host still keeps in the shared oosh.env from before the split. Sourced in
  # a subshell: all are pure data.
  for f2 in "$o" "$f" "$CONFIG_PATH/oosh.env"; do
    [ -n "$mode" ] && break
    [ -f "$f2" ] && mode=$( unset OOSH_MODE; . "$f2" 2>/dev/null; echo "$OOSH_MODE" )
  done
  for f2 in "$f" "$o"; do
    if ! { : >>"$f2"; } 2>/dev/null; then
      error.log "config.session.save: cannot write $f2"
      create.result 1 "cannot write $f2"
      return $(result)
    fi
  done
  # Nothing inside the redirects may log: LOG_DEVICE can be fd1.
  {
    private.config.path.line.absolute.get
    private.config.oosh.session.split.is "$CONFIG_PATH" || { [ -n "$mode" ] && echo "export OOSH_MODE=\"$mode\""; }
  } >"$f"
  {
    [ -n "$mode" ] && echo "export OOSH_MODE=\"$mode\""
  } >"$o"
  create.result 0 "$f $o"
  return $(result)
}
config.session.save.completion() { :; }


private.config.required.file.path.get()     # <file> # echo where a row of the required table lives: user.session.env and oosh.session.env are the per-user files of this user, every other file is under CONFIG_PATH #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT.
 case "$1" in
   user.session.env) private.config.user.session.file.get ;;
   oosh.session.env) private.config.oosh.session.file.get ;;
   *)                echo "$CONFIG_PATH/$1" ;;
 esac
}


private.config.homes.list()     #  # echo every directory a home of this host can be, one per line: /home/*, /Users/*, /root, /var/root #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. The gate
 # of the user.env split asks every one of them
 # (private.config.session.chain.ready); tests replace it with fixture homes.
 local h
 for h in /home/* /Users/* /root /var/root; do
