  ls $CONFIG_PATH
}


config.start() # <method> <parameter> # default start and parameter processing
{
  #echo "sourcing init"
  COMMANDS="$@"
  source this
  #check.debug.level 6

  if [ -z "$CONFIG_PATH" ] || ! [ -f "$CONFIG" ]; then
      config.anchors.init
  fi
  if [ "$(type -t this.start)" = "function" ]; then
    this.start "$@"
  else
    echo "config.start: this.start not yet there"
  fi
}

