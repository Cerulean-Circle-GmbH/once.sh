private.config.save()     # <?name> <?ENV_PREFIX> <?sessionSplit> <?ooshSplit> # the work of config.save; sessionSplit and ooshSplit (yes or no) are the layout a full save hands its nested oosh save, empty reads it off the files #
{
  #set -x
  console.log "config.save (CONFIG=$CONFIG)"

  # config.save had no deliberate exit status at all — it fell off the end
  # through config.info.log, whose rc is a `[ … -gt … ]` test. It now reports
  # whether the files it wrote passed their own validation (see the guard at
  # the end of the no-arg branch).
  local configSaveRc=0
  # A host's OLD log.env chain line first: this save may drop the removed
  # per-user dir variable from oosh.env (T-CONFIG-LOG-CHAIN-MIGRATE). A
  # log.env that cannot be written is said, not stepped over
  # (T-CONFIG-SAVE-MIGRATE-WRITE-FAIL); the save goes on.
  private.config.log.chain.migrate "$CONFIG_PATH" || warn.log "config.save: $RESULT"

  local file=$1
  shift
  local name=$1
  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    # NOT `${file^^}` below. That is bash 4+, and on macOS /bin/bash 3.2 it is
    # not a warning but a FATAL "bad substitution" — the shell EXITS (measured
    # on a sequoia VM; the commands after it never ran). This branch is the
    # DOCUMENTED single-argument form — `config add oosh`, `config save myapp`
    # (docs/config.md) — so on macOS a documented command killed the user's
    # shell. The `warn.log "BASH 5 support only"` that stood here was never a
    # mitigation: the line under it had already ended the shell.
    name=$(private.config.string.upper "$file")
  else
    shift
  fi
  # The layout a full save decided (below), handed to its nested saves.
  local sessionSplit="$1" ooshSplit="$2"


  if [ -n "$file" ]; then
    config.file $file.env
  else
    name="CONFIG"
  fi
  
  stop.log "
  config.save [file:$file] [name:$name] to $CONFIG"
  # CARRY FORWARD what this shell has lost but the file still holds.
  #
  # `{ … } >$CONFIG` below TRUNCATES, and what it writes is whatever is in the
  # CURRENT ENVIRONMENT. So a shell missing a required variable rewrites the
  # file without it. `oo mode <branch>` is the live example (oo.mode): it
  # sets OOSH_MODE and immediately saves oosh.env from that shell — which has
  # OOSH_MODE and, because nothing re-derives OOSH_OS at shell init, no
  # OOSH_OS. The file loses it. That is the oscillation measured on the macOS
  # VM: OOSH_OS present and OOSH_MODE missing at one point, the exact reverse
  # an hour later.
  #
  # This is NOT derivation, deliberately. Deriving belongs in config.init.env
  # (card 2), which can source `os` and afford to be slow. A writer only has to
  # refrain from throwing away what it was already holding — no new dependency,
  # no re-entrancy, and nothing to go wrong during an install.
  #
  # Read BEFORE the redirect: by the time `>$CONFIG` has run the old values are
  # gone, which is exactly how config.init.env lost OOSH_PM before card 2.
  local requiredVariable requiredFile requiredDeriver carriedValue
  while read -r requiredVariable requiredFile requiredDeriver; do
    [ -z "$requiredVariable" ] && continue
    [ "$requiredFile" = "$CONFIG_FILE" ] || continue   # only rows for the file being written
    [ -n "${!requiredVariable}" ] && continue          # the shell has it; it will be persisted
    carriedValue=$(grep -m1 -E "^[[:space:]]*(export[[:space:]]+)?${requiredVariable}=" "$CONFIG" 2>/dev/null \
                   | cut -d= -f2- | sed 's/^"//; s/"$//')
    [ -n "$carriedValue" ] && export "$requiredVariable=$carriedValue"
  done <<REQUIRED
$(private.config.required.variables.get)
REQUIRED

  # The CHAINS user.env holds beyond oosh.env and log.env — `. $CONFIG_PATH/
  # odocker.env`, whatever `config add myapp` appended — read BEFORE the
  # no-argument branch below truncates user.env, and added back after the
  # oosh/log chains. Kept even when the file is missing; a legacy `source`
  # line comes back as `.` (T-CONFIG-CMD-SAVE-USER-KEEPS-CHAINS).
  local chainNames=""
  [ -z "$file" ] && chainNames=$(private.config.chain.names.get "$CONFIG")

  # A named oosh save keeps the oosh.session.env chain the file had — read
  # before the harvest below truncates it.
  local ooshChainHad=""
  [ "$file" = oosh ] && private.config.oosh.session.split.is "$CONFIG_PATH" && ooshChainHad=yes

  RESULT=""
  # The harvest writes a NAMED file (`config save oosh`). Without a name the
  # no-argument branch below writes user.env itself — harvesting into it first
  # was a dead write, overwritten a few lines later.
  if [ -n "$file" ]; then
    {
      # The harvesting loop that used to live here is now
      # private.config.variables.export, and the exclusion list moved with it, to
      # sit beside the comment that explains it. review-2026-09-09 § M3 named the
      # extraction before it existed.
      #
      # It enumerates NAMES with `compgen -v` and renders each one with
      # `declare -p <name>`. It never parses the NO-ARGUMENT `declare -p` stream,
      # which on bash 3.2 is `set`-style AND contains every function body — the
      # two facts that between them wrote rows of the required-variables table
      # into ~/config/oosh.env on every macOS install.
      # See docs/research/2026-09-17-config-save-bash32.md.
      #
      # NOTHING inside this block may log. log's file-scope LOG_DEVICE block sets
      # LOG_DEVICE=/proc/self/fd/1, and inside this redirect fd 1 IS $CONFIG, so
      # a single debug.log would be written into the generated env file.
      private.config.variables.export "$name" "$sessionSplit"
    } >$CONFIG
  fi
  if [ "$file" = oosh ]; then
    # oosh.env chains the user's own oosh.session.env (OOSH_MODE) as its LAST
    # line, the twin of log.env below — once the shared config is switched:
    # a full save decides it up front (<ooshSplit>), a named save keeps
    # what the file had (T-CONFIG-OOSH-CHAIN-KEPT). Unguarded: every user has
    # the file (private.config.session.file.ensure).
    local ooshChain="${ooshSplit:-}"
    [ -z "$ooshChain" ] && [ -n "$ooshChainHad" ] && ooshChain=yes
    [ "$ooshChain" = "yes" ] && echo '. $HOME/.config/oosh/oosh.session.env' >> "$CONFIG"
  fi
  if [ "$file" = log ]; then
    # log.env chains the PER-USER session file as its LAST line, every time it
    # is written — by `config save log` as much as by the full `config save`
    # (T-CONFIG-SAVE-PREFIX-LOG). LOG_NAME/LOG_DEVICE/LOG_LIVE of the last
    # session live there and override log.env's values per user. UNEXPANDED
    # (single quotes), like user.env's `. $CONFIG_PATH/*.env`, so each user
    # loads their OWN file; POSIX `.` so it parses under dash/ash. Unguarded:
    # install and config init.user create the file for every user
    # (private.config.session.file.ensure).
    echo '. $HOME/.config/oosh/log.session.env' >> "$CONFIG"
    # Whoever writes the chain line makes sure the SAVING user's target exists:
    # the installing user and root get their config through `config save` only
    # (T-CONFIG-SAVE-LOG-ENSURES-SESSION).
    private.config.session.file.ensure "$HOME" >/dev/null
  fi
  private.ensure.groupWrite "$CONFIG"

  if [ -z "$file" ]; then
    #problem.log "regenerate config"

    important.log "generating $CONFIG"
    # user.env is what a shell starts from — .bashrc and `source this` read it,
    # there is no boot (the MacStudio model, test/mcdonges.latest): the
    # CONFIG_* anchors and BASH_FILE — NOT PATH: it is per user, in the user's
    # own user.session.env, chained as user.env's LAST line (boss, 2026-10-02:
    # user.env forks like log.env) — and NOT ODOCKER_WORKSPACES: it lives in
    # odocker.env (odocker workspace.set), which user.env chains; written here
    # too it was saved twice, and odocker's `config unset` undone by every save
    # (T-CONFIG-SAVE-USER-ENV-LAYOUT) — then the chain, oosh.env and log.env. A value under $HOME
    # is written "$HOME/…" by private.config.variable.export.line, because
    # ~/config is shared between users (T-CONFIG-SAVE-USER-ENV-LAYOUT).
    [ -z "$BASH_FILE" ] && BASH_FILE=$(command -v bash)
    # The layout, decided BEFORE `>$CONFIG` truncates user.env: a config that is
    # switched stays switched; an old one switches only when every user linked
    # to it has their own user.session.env (the gate). Until then the shared
    # user.env keeps its PATH line and OOSH_MODE stays in oosh.env.
    sessionSplit=no ooshSplit=no
    if private.config.session.split.is "$CONFIG_PATH" || private.config.session.chain.ready "$CONFIG_PATH"; then
      sessionSplit=yes
    fi
    # The same for oosh.env's chain to the user's own oosh.session.env.
    if private.config.oosh.session.split.is "$CONFIG_PATH" || private.config.session.chain.ready "$CONFIG_PATH" oosh; then
      ooshSplit=yes
    fi
    {
      private.config.variable.export.line CONFIG_PATH
      private.config.variable.export.line CONFIG_FILE
      private.config.variable.export.line CONFIG
      # Before the switch only: the shared PATH line (private.config.path.line.get).
      [ "$sessionSplit" = "yes" ] || private.config.path.line.get
      private.config.variable.export.line BASH_FILE
    } >$CONFIG

    private.config.save oosh OOSH "$sessionSplit" "$ooshSplit"   # pure `export OOSH_*` lines
    # The SAVING user's own session files (T-CONFIG-USER-SESSION-SPLIT): after
    # oosh.env (whether it chains oosh.session.env decides where OOSH_MODE
    # goes), before `config save log`, whose ensure then finds them filled — one
    # write each per save (T-CONFIG-SESSION-WRITES-ONCE).
    config.session.save >/dev/null
    config.save log LOG     # pure `export LOG_*` lines
    config.file user.env
    config.add oosh OOSH    # appends: source $CONFIG_PATH/oosh.env
    config.add log LOG      # appends: source $CONFIG_PATH/log.env
    # Every other chain user.env held, in its order; config.add de-dups.
    local chainName
    for chainName in $chainNames; do
      case "$chainName" in oosh|log) continue ;; esac
      config.add "$chainName"
    done
    # LAST: the user's own user.session.env — their real PATH and OOSH_MODE —
    # after every shared chain, so the personal values win. UNEXPANDED (single
    # quotes) so each user loads their OWN file; unguarded, like log.env's
    # chain: install and config init.user create it for every user
    # (private.config.session.file.ensure). The SAVING user's file was written
    # above, after oosh.env.
    if [ "$sessionSplit" = "yes" ]; then
      echo '. $HOME/.config/oosh/user.session.env' >> "$CONFIG"
    else
      info.log "config.save: the shared user.env keeps its PATH line until every user of it has ~/.config/oosh/user.session.env — run: sudo oo update"
    fi

    # Guard: user.env may hold export/comment/blank + `source *.env` chaining
    # (composition, NOT logic); oosh.env / log.env must be pure. config.validate
    # allows the source lines but rejects real logic (self-anchors, if-blocks).
    #
    # THE VERDICT IS NO LONGER THROWN AWAY. This used to be
    # `config.validate … >/dev/null 2>&1 || warn.log …`, and that is why card
    # 1's corruption reached a user: config.validate caught it correctly on the
    # FIRST macOS install and the verdict went to /dev/null, with the only
    # signal a warn.log inside a 1 MB install log at a level that was not
    # printing. A guard whose verdict is discarded is not a guard.
    #
    # STDERR, not stdout, and the reason is load-bearing: private.user.init's cache write records
    # that `$(user get basehome)` CAPTURES this function's stdout, and a stray
    # line there once propagated a garbage IdentityFile into a generated
    # 2cuGitHub config block and failed the downstream git clone. stderr
    # survives every LOG_LEVEL and LOG_DEVICE exactly as stdout would — which is
    # the whole point of the status-output idiom — and `$( )` does not capture
    # it. This is the one place in the tree where the idiom must use stderr, and
    # test/test.config T83 pins BOTH halves: the verdict on stderr, and stdout
    # staying clean.
    #
    # It REPORTS, it does not halt: config.save runs as root during install and
    # a non-zero rc here is already more than any caller acts on today (audited
    # 2026-09-17 — nothing branches on it; private.check.pm is the only place it
    # could propagate and oo.pm.discover masks it with `RETURN=$1`).
    local _envName _invalid=""
    for _envName in user oosh log; do
      config.validate "$_envName" >/dev/null 2>&1 || _invalid="$_invalid $_envName"
    done
    if [ -n "$_invalid" ]; then
      echo "INVALID: config.save wrote$_invalid with logic in it — run 'config validate <name>' to see why" >&2
      configSaveRc=1
    fi
    # if [ -x "$(command -v once)" ]; then
    #   once v
    # fi
  fi
  config.info.log
  return $configSaveRc
}

config.validate() # <?name:user> # verify an env file is PURE DATA (only export/comment/blank lines); rc 1 + report on any logic line. <name> is a bare name (user/oosh/log), a filename (x.env), or a path.
{
  local f="${1:-user}"
  case "$f" in
    */*)   : ;;                       # already a path
    *.env) f="$CONFIG_PATH/$f" ;;     # a filename in CONFIG_PATH
    *)     f="$CONFIG_PATH/$f.env" ;; # a bare name → CONFIG_PATH/<name>.env
  esac
  if [ ! -f "$f" ]; then
    error.log "config.validate: no such env file: $f"
    echo "INVALID: no such env file: $f"   # status-output idiom — verdict to stdout
    return 2
  fi
  local violations=0 lineNum=0 line trimmed
  while IFS= read -r line || [ -n "$line" ]; do
    lineNum=$((lineNum + 1))
    # Strip leading whitespace so ONLY a true blank/comment line is skipped. The
    # old `[[:space:]]*'#'*` case pattern treated any INDENTED line that merely
    # contained a '#' as a comment — e.g. `  : ${OOSH_DIR:=/x} # guarded` sailed
    # through. Trim first, then test the first real character.
    trimmed="${line#"${line%%[![:space:]]*}"}"
    case "$trimmed" in '' | '#'*) continue ;; esac
    # Reject command substitution / backticks ANYWHERE (even inside a value):
    # they EXECUTE when the file is sourced, so they are logic, never pure data.
    # `export FOO="$(echo hi)"` used to pass (the export regex only anchored to `=`).
    case "$line" in
      *'$('* | *'`'*)
        error.log "config.validate: $f:$lineNum contains command substitution (not pure data): $line"
        violations=$((violations + 1)); continue ;;
    esac
    # allow: `export IDENT=…`, `export declare IDENT=…` (legacy), bare `IDENT=…`
    if echo "$trimmed" | grep -qE '^(export[[:space:]]+(declare[[:space:]]+)?)?[A-Za-z_][A-Za-z0-9_]*='; then
      continue
    fi
    # allow: config-file chaining `source X.env` / `. X.env` (composition, not
    # logic). Anything else — self-anchors `: ${…}`, `if`/`{ } &&` — is logic.
    if echo "$trimmed" | grep -qE '^(source|\.)[[:space:]]+[^[:space:]]*\.env[[:space:]]*$'; then
      continue
    fi
    error.log "config.validate: $f:$lineNum is not pure data: $line"
    violations=$((violations + 1))
  done < "$f"
  if [ "$violations" -gt 0 ]; then
    error.log "config.validate: $f has $violations violation(s) — env files must contain only export/comment/blank lines (logic belongs in code, never in an env file)"
    echo "INVALID: $f — $violations violation(s) (logic in an env file)"
    return 1
  fi
  echo "OK: $f is pure data"
  return 0
}

config.validate.completion.name() { echo "user oosh log"; }

private.config.required.variables.get() # # the variables a config must carry for a branch version: "<variable> <file> <deriverFunction>", one per line
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell.
  # Same reasoning as private.config.file.resolve.
  #
  # This is the POSITIVE list the tree never had. config.save has always had a
  # negative one (what must never persist) and config.validate checks line
  # SHAPE while knowing no variable name at all, so nothing asserted that a
  # config contains what a branch version needs. Mirrored in docs/config.md
  # § Required variables — change both together.
  #
  # OOSH_BRANCH is deliberately absent: it is install INPUT, excluded from
  # persistence since T7, and a config that carried it would be the bug.
  cat <<'REQUIRED'
BASH_FILE user.env private.config.derive.bash.file
CONFIG_FILE user.env private.config.derive.config.file
OOSH_MODE oosh.session.env private.config.derive.oosh.mode
OOSH_OS oosh.env private.config.derive.oosh.os
OOSH_PM oosh.env private.config.derive.oosh.pm
LOG_LEVEL log.env private.config.derive.log.level
REQUIRED
}

config.validate.required() # # verify the persisted config carries every variable a branch version needs and that OOSH_MODE agrees with the checkout; rc 1 naming each problem
{
  # A SUB-METHOD of config.validate, not a mode argument: this.call prefers
  # $caller.$method.$1 when that function exists, so `config validate required`
  # resolves here and config.validate's own `${1:-user}` default and its
  # internal caller in config.save are untouched. (Before this existed,
  # `config validate required` silently resolved to a non-existent
  # required.env and returned 2.)
  local missing="" variable file rest
  while read -r variable file rest; do
    [ -z "$variable" ] && continue
    grep -qE "^[[:space:]]*(export[[:space:]]+)?${variable}=" "$(private.config.required.file.path.get "$file")" 2>/dev/null \
      || missing="$missing $variable"
  done <<REQUIRED
$(private.config.required.variables.get)
REQUIRED

  # Branch drift: the persisted OOSH_MODE against the branch ~/oosh actually
  # points at. This is the T7 bug — persisted prod/released on a dev box, with
  # nothing in the tree ever comparing the two.
  local drift="" persistedMode actualMode
  # The user's own session file; a host from before the split still has it in
  # the shared oosh.env.
  persistedMode=$(grep -m1 -E "^[[:space:]]*(export[[:space:]]+)?OOSH_MODE=" "$(private.config.required.file.path.get oosh.session.env)" "$(private.config.required.file.path.get user.session.env)" 2>/dev/null \
                  | cut -d= -f2- | tr -d '"')
  [ -z "$persistedMode" ] && persistedMode=$(grep -m1 -E "^[[:space:]]*(export[[:space:]]+)?OOSH_MODE=" "$CONFIG_PATH/oosh.env" 2>/dev/null \
                  | cut -d= -f2- | tr -d '"')
  # The SAME accessor the repair uses. This was two inline steps here and two
  # more in oo (private.check.user.shared.dev.folder.linked); three answers to "which branch is this host on" could
  # drift apart, and the drift check disagreeing with the repair is the one
  # disagreement that would be hardest to see.
  actualMode=$(private.config.derive.oosh.mode 2>/dev/null)
  if [ -n "$persistedMode" ] && [ -n "$actualMode" ] && [ "$persistedMode" != "$actualMode" ]; then
    drift="OOSH_MODE=$persistedMode but ~/oosh is on $actualMode"
  fi

  # Status-output idiom: the verdict goes to stdout so it survives any
  # LOG_LEVEL or LOG_DEVICE, exactly as config.validate does.
  if [ -n "$missing" ] || [ -n "$drift" ]; then
    local reason=""
    [ -n "$missing" ] && reason="missing:$missing"
    [ -n "$drift" ] && reason="${reason:+$reason; }$drift"
    create.result 1 "INCOMPLETE: $CONFIG_PATH — $reason"
    echo "$RESULT"
    echo "  repair with: config init.env   (regenerates user.env + oosh.env + log.env)"
    return $(result)
  fi
  create.result 0 "OK: $CONFIG_PATH carries every required variable and agrees with the checkout"
  echo "$RESULT"
  return $(result)
}

config.validate.required.completion() { :; }

config.bash.minimal.version() { # <bash.minimal.version:5> # sets the BASH_MINIMUM_MAJOR_VERSION
  echo "export BASH_MINIMUM_MAJOR_VERSION=$1" >>$CONFIG
}

private.config.file.resolve() # # echo the effective file for the current $CONFIG_FILE — shared $CONFIG_PATH if present, else per-user $HOME/.config/oosh
{
  # Two-tier config: the shared $CONFIG_PATH holds site-wide data (user.env,
  # oosh.env, log.env); the per-user $HOME/.config/oosh holds private
  # per-user / per-session files (log.session.env). A name that exists only in
  # the per-user tier (e.g. `log.session`) resolves THERE. Callers pass through
  # config.file.check first, which sets $CONFIG_FILE. Pure echo — no global
  # mutation, so `config list log.session` never leaves $CONFIG repointed.
  local _shared="$CONFIG_PATH/$CONFIG_FILE"
  local _peruser="$HOME/.config/oosh/$CONFIG_FILE"
  if [ ! -f "$_shared" ] && [ -f "$_peruser" ]; then
    echo "$_peruser"
  else
    echo "$_shared"
  fi
}

config.list() # <name:$CONFIG> # lists the content of the config with <name>
{
  # Listing is READ-ONLY: snapshot and restore the current-file globals so
  # `config list <name>` (which runs config.file.check, and which config.info.log
  # calls after save/clean) never leaves $CONFIG/$CONFIG_FILE repointed for the
  # rest of the shell — a later config.add/clean would otherwise write to / rm
  # the wrong file. Resolve the tier (shared, else per-user) for the view only.
  local _savedConfig="$CONFIG" _savedFile="$CONFIG_FILE"
  config.file.check $1
  cat "$(private.config.file.resolve)"
  CONFIG="$_savedConfig"; CONFIG_FILE="$_savedFile"
}

config.delete() # <name:$CONFIG> # deletes the config with <name>
{
  config.file.check $1
  # Tier-aware so `config delete log.session` removes the real per-user file
  # rather than a non-existent shared one (symmetry with config.list).
  rm "$(private.config.file.resolve)"
}

config.update() { # <?name:$CONFIG> <?ENV_PREFIX> # saves and adds the config 
  config.save $1 $2
  config.add $1 $2
  config.info.log
}

config.info.log() # # logs the config when on LOG_LEVEL info or higher
{
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.edit() # <name:$CONFIG> # edits the config with <name> in vim
{
  #check.debug.level 6
  oo cmd vim
  # Tier-aware (shared, else per-user) so editing `log.session` opens the real
  # per-user file instead of creating a SHARED shadow that then masks it for
  # every user in `config list log.session`. Symmetry with list/delete.
  local _f
  if config.file.check $1; then
    _f="$(private.config.file.resolve)"
    vim "$_f"
  else
    _f="$(private.config.file.resolve)"
    vim "$_f"
    exit $ERROR_CODE_RECONFIG
  fi
}

config.clean() #  # reinitalises a clean config and removes any custom addons
{
  config.file.check $1
  # Order-preserving de-dup (drop duplicate lines, keep first occurrence).
  # Kept order-preserving rather than `sort -u` as a matter of hygiene — env
  # files are now pure `export K="V"` data (no bootstrap header to protect;
  # that logic moved into code), so order is no longer load-bearing,
  # but there's no reason to alphabetically shuffle a user's config either.
  awk '!seen[$0]++' "$CONFIG" >"$CONFIG_PATH/$CONFIG_FILE.clean"
  rm $CONFIG_PATH/$CONFIG_FILE
  mv $CONFIG_PATH/$CONFIG_FILE.clean $CONFIG_PATH/$CONFIG_FILE
  private.ensure.groupWrite "$CONFIG_PATH/$CONFIG_FILE"
  if [ "$LOG_LEVEL" -gt "3" ]; then
    config.list $1
  fi
}

config.add() # <name:$CONFIG> # adds the config <name> into the user.env permanently
{
  local file=$1
  shift
  local name=$1

  if [ -n "$file" ] &&  [ -z "$name" ]; then
    #set -x
    # NOT `${file^^}` below. That is bash 4+, and on macOS /bin/bash 3.2 it is
    # not a warning but a FATAL "bad substitution" — the shell EXITS (measured
    # on a sequoia VM; the commands after it never ran). This branch is the
    # DOCUMENTED single-argument form — `config add oosh`, `config save myapp`
    # (docs/config.md) — so on macOS a documented command killed the user's
    # shell. The `warn.log "BASH 5 support only"` that stood here was never a
    # mitigation: the line under it had already ended the shell.
    name=$(private.config.string.upper "$file")
  else
    shift
  fi

  if [ -z "$file" ]; then
    name="CONFIG"
  fi
  
  console.log "
  config.add [file:$file] [name:$name] to $CONFIG"
  {
    # POSIX `.` not bash `source` — env files are sourced by dash/ash shells
    # too (/bin/sh login shells, the remote prelude of `ossh exec` on
    # Debian). `source` is a bashism (dash: "source: not found").
    echo . \$CONFIG_PATH/$file.env
  } >>$CONFIG
  config.clean
}

config.file.check() # <name:$CONFIG> # sets the default config file to <name> if it exists
{
  if [ -n "$1" ]; then
    config.file $1.env
    shift
    RETURN=$1
    RETURN_VALUE=0
  else
    RETURN_VALUE=1
  fi
  info.log "config file: $CONFIG"
  create.result $RETURN_VALUE $CONFIG
  return "$(result)"

}

config.file() # <configfile> # sets the default config file to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        export FILE=$1
        CONFIG_FILE=$FILE

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
    esac
  fi
}

config.location() # <configfile> # sets the default config location to <configfile> if it exists
# if <?option> is "reset", it sets the $CONFIG_FILE backi to user.env
{
  if [ -z "$1" ]; then
    echo "$CONFIG_FILE"
  else
    case "$1" in
      reset)
        config.init
        echo "CONFIG_PATH=$CONFIG_PATH"
        echo "CONFIG_FILE=$CONFIG_FILE"
        echo
        echo "CONFIG=$CONFIG"
        ;;
      *)
        local oldConfig="$CONFIG"

        # config-path-exception: `config file <path>` deliberately points the
        # session at an ARBITRARY config file, so CONFIG_PATH must come from
        # that path — this is the one method whose job is to leave ~/config.
        export FILE=$(basename $1)
        CONFIG_PATH=$(dirname $1)
        CONFIG_FILE=$FILE

        info.log "old config     : $oldConfig"
        info.log "new config path: $CONFIG_PATH"
        info.log "new config file: $CONFIG_FILE"

        export CONFIG=$CONFIG_PATH/$CONFIG_FILE
        config.save
        bash
    esac
  fi
}

config.parameter.completion.configfile() {
  echo "reset"
  c2 file.completion "$1"
}

config.parameter.completion.envVariable() {
  cat $CONFIG | line replace "export " | line replace "=.*$" | line filter "source"
}

config.parameter.completion.name() {
  ls "$CONFIG_PATH"/*.env 2>/dev/null | xargs -I{} basename {} .env
}

