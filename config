config.completion.discover() {
  #set -x
  #info.log "completion.discover $*"
  local command=$1
  shift
  local ac=$(command -v $command)
  case "${command}" in
    "init"|"oosh"|"this")
      command="this"
      ac=$OOSH_DIR/this
    ;;
    "oo")
      if [ -n "$1" ]; then
        #set -x
        command=$1
        shift
        ac=$(command -v $command)
        if [ -n "$ac" ]; then
          config.completion.discover $ac
          return 0
        else
          cd $OOSH_DIR
          compgen -f $command
          return 0
        fi
      fi
    ;;    
    "once.sh")
      command="once"
    ;;
    "config")
      debug.log "in config"
      ac=$OOSH_DIR/config
    ;;
    *)
      debug.log "$command not found in completion"
    ;;
  esac
  
  local method=""
  local previous=""
  local last=""
  while [ -n "$1" ]; do
   previous=$method
   if [ -z "$method" ]; then
    method=$1
   else
    method=$method.$1
   fi
   last=$1
   shift
  done

  # if [ -n "$command" ]; then
  #   if [ -x "$(command -v $command)" ]; then
  #     info.log "sourcing $command"
  #     #source "$command"
  #   else
  #     return 1
  #   fi
  # else
  #   return 1
  # fi


  if (config.check.completion $command $previous); then
      $ac $previous.completion $last $command $previous
  fi

  if (config.check.completion $command $last); then
    if [ "$ac" = "$OOSH_DIR/config" ]; then
      if (this.functionExists $command.$last.completion); then
        $command.$last.completion '' $command $previous
        return 0
      fi
      if (this.functionExists $command.$previous.completion); then
        $command.$previous.completion $last $command $previous
        return 0
      fi
    else

      $ac $last.completion '' $command $previous
      return 0
    fi
  fi
  # if (this.functionExists $command.$previous.completion); then
  #   $command.$previous.completion $last $command $previous
  #   return 0
  # fi

  if [[ $method == *[\\/\(\)]* ]]; then
    create.result 1 "$method contains special characters"
    #echo $RESULT
    return "$(result)" 
  fi

  #echo method:$method
  local find="^\(function \)*\($command\.\)\($method[^(#\"]*\)\(.*\)"

  grep "$find" $ac | sed 's/'"$find"'/\3/' | sed 's/\(.*\)\(\.completion.*\)/\1/'
  #echo "$@"
}

config.check.completion() {
  local command=$1
  local ac=$(command -v $command)
  local method="$2.completion"
  local find="^\(function \)*\($command\.\)\($method[^(#\"]*\)\(.*\)"
  if [[ $method == *[\\/\(\)]* ]]; then
    create.result 1 "$method contains special characters"
    #echo $RESULT
    return "$(result)"
  fi
  RESULT=$(grep "$find" $ac | sed 's/'"$find"'/\3/')
  if [ "$RESULT" = "$method" ]; then
    create.result 0 "$RESULT"
  else
    create.result 1 "$method not found"
  fi
  debug.log "$RESULT"
  return "$(result)"
}


config.edit.completion() {
  config.list.completion "$@"
}

config.delete.completion() {
  config.list.completion "$@"
}



config.list.completion.name() {
  #echo "$@"
  export FILTER=$1
  # Offer names from BOTH config tiers: shared $CONFIG_PATH (log, oosh, user) and
  # per-user $OOSH_USER_CONFIG_PATH (log.session). Guard each glob so an
  # unmatched pattern isn't emitted literally.
  for file in ${CONFIG_PATH}/*.env "${OOSH_USER_CONFIG_PATH:-$HOME/.config/oosh}"/*.env
    do
      [ -e "$file" ] || continue
      echo "$(basename $file)" | line replace ".env"
    done
}

config.string.quote() { # <string> # quote the string to be used as a command line argument
  RESULT=$(printf %s\\n "$1" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/'/")
  echo $RESULT
}

config.init() # # set the config anchors, then check the config; when it is missing or broken, repair it with config init.full
{
  # It used to only set the anchors and make a directory — a missing user.env,
  # a dangling ~/config, a foreign branch version all passed `config init`
  # untouched. Now: the anchors (config.anchors.init), a cheap no-write check
  # (private.config.healthy), and only on failure the repair family.
  config.anchors.init
  if private.config.healthy; then
    create.result 0 "config healthy: $CONFIG_PATH"
    return $(result)
  fi
  important.log "config init: ${YELLOW}$CONFIG_PATH${NORMAL} is missing or broken — repairing with ${YELLOW}config init.full${NORMAL}"
  config.init.full "$USER"
  if private.config.healthy; then
    create.result 0 "config repaired: $CONFIG_PATH"
  else
    create.result 1 "config init: still broken after config init.full — $(config.validate.required 2>/dev/null | head -1)"
    error.log "$RESULT"
  fi
  return $(result)
}

# ---------------------------------------------------------------------------
# Repair primitives — bring a tampered/corrupted OOSH layout back to the
# canonical install state (matches what init/oosh produces). NOT called by
# the bashrc-startup `config.init` above; that path stays cheap.
# Reference state: ~/config and ~/oosh symlinks owned <user>:<user>;
# sharedConfig dir mode 2775 group dev; no self-referential symlinks.
# ---------------------------------------------------------------------------

config.init.shared() # # ensure sharedConfig exists, group dev, g+w (no SGID — see private.ensure.sharedTree); remove self-loops; idempotent
{
  # `user` script provides user.get, private.as.user, user.group.add — not
  # auto-loaded by `source this`. Source on demand so `./config init.*` works
  # in standalone invocations (the c2 dispatch path in interactive shells
  # already pulls it in).
  [ "$(type -t user.get)" = "function" ] || source "$OOSH_DIR/user" >/dev/null 2>&1
  local devHome
  devHome=$(user.get home developking 2>/dev/null)
  if [ -z "$devHome" ]; then
    error.log "config.init.shared: cannot resolve developking's home — run ${YELLOW}ossh install${NORMAL} first"
    return 1
  fi
  local baseDir
  baseDir=$(dirname "$devHome")
  local sharedConfig="$baseDir/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  if [ ! -d "$sharedConfig" ]; then
    # A NONEXISTING config is repaired too: create it when the caller may
    # (its parent is group dev, g+w); otherwise say exactly what to run.
    if ! mkdir -p "$sharedConfig" 2>/dev/null; then
      error.log "config.init.shared: cannot create ${RED}$sharedConfig${NORMAL} — run ${YELLOW}sudo -E ./config init.shared${NORMAL}"
      return 1
    fi
    important.log "config.init.shared: created ${YELLOW}$sharedConfig${NORMAL}"
  fi
  important.log "config.init.shared: normalising ${YELLOW}$sharedConfig${NORMAL} (group dev, g+w)"
  private.ensure.sharedTree "$sharedConfig"
}

config.init.user() # <username:$USER> # ensure the user's ~/config + ~/oosh symlinks match canonical install
{
  private.this.script.load ogit ogit.branch.get
  [ "$(type -t user.get)" = "function" ] || source "$OOSH_DIR/user" >/dev/null 2>&1
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  if [ -z "$username" ]; then username="$USER"; fi

  local targetHome
  targetHome=$(user.get home "$username" 2>/dev/null)
  if [ -z "$targetHome" ]; then
    error.log "config.init.user: cannot resolve home for ${YELLOW}$username${NORMAL}"
    return 1
  fi
  local devHome
  devHome=$(user.get home developking 2>/dev/null)
  if [ -z "$devHome" ]; then
    error.log "config.init.user: developking missing — run ${YELLOW}ossh install${NORMAL} first"
    return 1
  fi
  local baseDir
  baseDir=$(dirname "$devHome")
  local sharedConfig="$baseDir/shared/EAMD.ucp/Scenarios/localhost/EAM/1_infrastructure/Once.sh/sharedConfig"
  # Resolve the canonical shared oosh dir. Preference order, picking the
  # first that resolves to an existing dir under the shared tree:
  #   1. The current $OOSH_DIR (we're running from it — trustworthy).
  #   2. The existing target of <user>'s ~/oosh symlink (if already aligned).
  #   3. The branch named by $OOSH_MODE / git fallback / "dev".
  # Avoids the case where $OOSH_MODE is set to a stale value like "released"
  # that doesn't have a corresponding worktree on disk.
  local sharedOoshBase="$baseDir/shared/EAMD.ucp/Components/com/ceruleanCircle/EAM/1_infrastructure/Once.sh"
  if [ ! -d "$sharedConfig" ]; then
    error.log "config.init.user: ${RED}$sharedConfig${NORMAL} does not exist — run ${YELLOW}config init.shared${NORMAL} first"
    return 1
  fi
  local sharedOosh=""
  # OOSH_DIR is ~/oosh (a symlink), so the prefix test needs its PHYSICAL
  # target — the literal never starts with $sharedOoshBase. See
  # docs/oosh-architecture.md § The anchors are data.
  local ooshPhysical
  ooshPhysical=$(private.this.path.canonical "$OOSH_DIR" 2>/dev/null || echo "$OOSH_DIR")
  if [ -d "$ooshPhysical" ] && [ "${ooshPhysical#$sharedOoshBase/}" != "$ooshPhysical" ]; then
    sharedOosh="$ooshPhysical"
  elif [ -L "$targetHome/oosh" ]; then
    local _existing
    _existing=$(readlink "$targetHome/oosh")
    if [ -d "$_existing" ] && [ "${_existing#$sharedOoshBase/}" != "$_existing" ]; then
      sharedOosh="$_existing"
    fi
  fi
  if [ -z "$sharedOosh" ]; then
    local branch="$OOSH_MODE"
    [ -z "$branch" ] && branch=$(this.git.branch.short "$OOSH_DIR" 2>/dev/null)
    [ -z "$branch" ] && branch="dev"
    sharedOosh="$sharedOoshBase/$branch"
  fi
  if [ ! -d "$sharedOosh" ]; then
    error.log "config.init.user: ${RED}$sharedOosh${NORMAL} missing — install not completed"
    return 1
  fi

  important.log "config.init.user: aligning ${YELLOW}$username${NORMAL}'s ~/config and ~/oosh to canonical state"

  # Symlink reconciliation in two phases.
  #
  # Phase 1 — recreate (only if needed): dispatch through private.as.user so
  # newly-created symlinks inherit <user>:<user> ownership naturally. This is
  # the same trick user.oosh.install uses at user:787-794 — and the reason
  # fresh installs produce hannesn:hannesn while a tampered install path can
  # leave hannesn:dev. Skip the dispatch entirely when both symlinks already
  # point at the canonical targets — avoids the runuser PAM-session overhead
  # and an observed silent-failure mode under sudo when env is sanitised.
  #
  # Phase 2 — force ownership: chown -h is run by THIS shell (not via
  # private.as.user). When the caller is root (the typical sudo path) chown
  # works for any target. When the caller is the target user, chown to their
  # own primary group works without sudo. Other combinations are skipped
  # quietly (e.g. sudoer alice repairing bob — the recreate path already
  # gave bob:bob).
  local _ts
  _ts=$(date +%Y%m%d-%H%M%S)
  local _needsRecreate=0
  if [ ! -L "$targetHome/config" ] || [ "$(readlink "$targetHome/config")" != "$sharedConfig" ] \
  || [ ! -L "$targetHome/oosh"   ] || [ "$(readlink "$targetHome/oosh")"   != "$sharedOosh"   ] \
  || [ -d "$targetHome/config" -a ! -L "$targetHome/config" ] \
  || [ -d "$targetHome/oosh"   -a ! -L "$targetHome/oosh"   ]; then
    _needsRecreate=1
  fi
  # ONE hop as the target user: symlink convergence (only when needed) via the
  # shared primitive private.this.symlink.with.backup — run AS the target so
  # new symlinks inherit <user>:<user> — then the .bashrc heal, which always
  # runs (idempotent, T86). The preamble comes from
  # private.this.as.user.preamble.get: it exports the TARGET's HOME/USER,
  # drops the caller's leaked anchors and sources `this` from the SHARED tree.
  # The string used to source "$OOSH_DIR/this", expanded by the CALLER — root
  # healing another user made them source /root/oosh/this, unreadable under a
  # 0700 /root, so every step failed silently (T87).
  #
  # Deliberately no `set -e`: `this` returns non-zero at load-time as part of
  # its dispatch protocol, so `set -e` + source would exit before anything
  # ran. Explicit `|| exit 1` on the symlink steps gives the same fail-fast.
  # The heal's RESULT is echoed on the last line so this shell can report a
  # re-template (a create.result inside the hop never reaches us).
  local bashrcOutcome
  bashrcOutcome=$(private.as.user "$username" bash -c "$(private.this.as.user.preamble.get "$username" "$targetHome" "$sharedOosh")
    if [ '$_needsRecreate' = 1 ]; then
      private.this.symlink.with.backup config '$sharedConfig' '$_ts' || exit 1
      private.this.symlink.with.backup oosh   '$sharedOosh'   '$_ts' || exit 1
    fi
    # config AFTER the symlinks: config.start runs config.init when CONFIG is
    # unset, and that mkdirs a REAL ~/config the symlink step would then have
    # to move aside as config.orig.<ts>.
    source '$sharedOosh/config' >/dev/null 2>&1
    private.config.bashrc.ensure '$targetHome' '$sharedOosh' '$_ts' >/dev/null
    _bashrcResult=\"\$RESULT\"
    # The TARGET's git trust of every folder under the base (clone layout,
    # spec § 4) — their --global config, so it runs here, as them.
    '$sharedOosh/ogit' safeDirectory.ensure '$(dirname "$sharedOosh")' >/dev/null
    # The TARGET's per-user data file (OOSH_MODE), written here, AS them, from
    # where THEIR ~/oosh points. config save writes it only for whoever runs
    # it — the install runs as root, so every other installed user had none
    # and an empty OOSH_MODE (ubuntu_24_04 platform container, 2026-09-29).
    # oo update and oo user.fix reach here, which heals installed users.
    private.config.user.mode.save >/dev/null
    echo \"\$_bashrcResult\"
  ")
  local hopRc=$?
  if [ "$hopRc" -ne 0 ]; then
    if [ "$(readlink "$targetHome/config" 2>/dev/null)" != "$sharedConfig" ] \
    || [ "$(readlink "$targetHome/oosh"   2>/dev/null)" != "$sharedOosh"   ]; then
      error.log "config.init.user: failed to create symlinks for ${RED}$username${NORMAL}"
      return 1
    fi
    warn.log "config.init.user: could not ensure ${YELLOW}$targetHome/.bashrc${NORMAL}"
  fi
  case "$bashrcOutcome" in
    re-templated*) important.log "config.init.user: $bashrcOutcome (previous file kept as .bashrc.pre-oosh / .bashrc.orig.$_ts)" ;;
  esac

  # The shared log.env: strip the boot-era log.session.env chain line (one
  # file per host, so the caller's copy is everyone's). `oo update` reaches
  # here, which is how already-installed hosts leave the migration window the
  # guard in `this` covers. T88.
  private.config.log.env.migrate >/dev/null
  case "$RESULT" in
    stripped*) important.log "config.init.user: $RESULT (log owns the per-user session file now)" ;;
  esac
  # The CALLER's git trust of every folder under the base (clone layout, spec
  # § 4): each folder is its own repository with its own safe.directory entry.
  # `oo update` and `oo user.fix` reach here, which makes them the repair.
  ogit.safeDirectory.ensure "$(dirname "$sharedOosh")" >/dev/null \
    || warn.log "config.init.user: could not ensure safe.directory — $RESULT"
  # Phase 2 — force canonical owner on the symlinks. Only when this shell has
  # the privilege to do so (root, or self).
  if [ "$(id -u)" = "0" ] || [ "$username" = "$USER" ]; then
    chown -h "$username:$username" "$targetHome/config" "$targetHome/oosh" 2>/dev/null || true
  fi

  # Ensure dev group membership (idempotent; user.group.add no-ops if already a member).
  if private.user.check.group dev >/dev/null 2>&1; then
    user.group.add dev "$username" >/dev/null 2>&1
  fi

  success.log "config.init.user: ${GREEN}$username${NORMAL} aligned"
}

config.init.check() # <username:$USER> # diagnostics: report symlink state, dev-group health (no fixes)
{
  [ "$(type -t user.get)" = "function" ] || source "$OOSH_DIR/user" >/dev/null 2>&1
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  if [ -z "$username" ]; then username="$USER"; fi

  local targetHome
  targetHome=$(user.get home "$username" 2>/dev/null)
  if [ -z "$targetHome" ]; then
    error.log "config.init.check: cannot resolve home for ${YELLOW}$username${NORMAL}"
    return 0  # diagnostic — never block
  fi

  important.log "config.init.check: ${YELLOW}$username${NORMAL} (home: $targetHome)"

  # ~/config — owner, target, target's mode/group
  if [ -L "$targetHome/config" ]; then
    local cOwner cTarget tMode tGroup
    cOwner=$(stat -c "%U:%G" "$targetHome/config" 2>/dev/null || stat -f "%Su:%Sg" "$targetHome/config" 2>/dev/null)
    cTarget=$(readlink "$targetHome/config")
    info.log "  ~/config: owner=$cOwner target=$cTarget"
    if [ -d "$cTarget" ]; then
      tMode=$(stat -c "%a" "$cTarget" 2>/dev/null || stat -f "%Lp" "$cTarget" 2>/dev/null)
      tGroup=$(stat -c "%G" "$cTarget" 2>/dev/null || stat -f "%Sg" "$cTarget" 2>/dev/null)
      info.log "  sharedConfig: mode=$tMode group=$tGroup"
      if [ "$tGroup" != "dev" ]; then
        warn.log "  sharedConfig group ${RED}$tGroup${NORMAL} drifted from canonical ${GREEN}dev${NORMAL} — run ${YELLOW}config init.shared${NORMAL}"
      fi
      if [ -L "$cTarget/sharedConfig" ]; then
        warn.log "  self-referential symlink present at $cTarget/sharedConfig — run ${YELLOW}config init.shared${NORMAL}"
      fi
    fi
    # Symlink owner should be <user>:<user>, not <user>:dev
    [ -d "$cTarget" ] || warn.log "  ~/config points at nothing ($cTarget) — run ${YELLOW}config init${NORMAL}"
    case "$cOwner" in
      "$username:$username") : ;;
      *) warn.log "  ~/config owner ${RED}$cOwner${NORMAL} drifted from canonical ${GREEN}$username:$username${NORMAL} — run ${YELLOW}config init.user${NORMAL}" ;;
    esac
  else
    warn.log "  ~/config is not a symlink — run ${YELLOW}config init.user${NORMAL}"
  fi

  # Stale-dev-group warning: in /etc/group but not in active group set.
  # We can only check the *running* shell's group set when the username is
  # the caller; for other users we just check static membership.
  if [ ! -d "$targetHome/oosh" ]; then
    warn.log "  ~/oosh is missing or points at nothing — run ${YELLOW}config init${NORMAL}"
  fi

  if getent group dev 2>/dev/null | grep -qE "(:|,)$username(,|$)"; then
    if [ "$username" = "$USER" ]; then
      if ! id -nG | grep -qw dev; then
        important.log "${YELLOW}$username${NORMAL} is in group ${GREEN}dev${NORMAL} per /etc/group, but the current shell's active groups don't include it. Log out of the desktop session ${RED}fully${NORMAL} (not just the terminal) and log back in — the active group set is captured at login time. Until then, writes to ~/config/* will hit Permission denied."
      fi
    fi
  else
    warn.log "  ${YELLOW}$username${NORMAL} not in group dev — run ${YELLOW}config init.user${NORMAL} to add"
  fi

  # Required-variable and branch-drift report. Diagnostic ONLY: the rc is
  # swallowed on purpose, because this function is documented as never failing
  # its caller and T34 pins that. The rc-1 channel is the user-invoked
  # `config validate required`, which is what a script should branch on.
  if [ "$username" = "$USER" ]; then
    config.validate.required || :
  fi
  return 0
}

config.init.env() # # regenerate user.env and every manifest / loaded env file via config.save (mirrors install at oo:1456); backs them up first and refuses to worsen any of them
{
  if [ -z "$OOSH_DIR" ]; then
    error.log "config.init.env: \$OOSH_DIR is empty — re-source ${YELLOW}this${NORMAL} or rerun under ${YELLOW}sudo -E${NORMAL}"
    return 1
  fi
  # CONFIG_PATH must point at the shared sharedConfig dir we want to write
  # into. Trust the calling context: bashrc/this set it to ~/config (the
  # symlink), which `config init.user` ensures points at sharedConfig.
  if [ -z "$CONFIG_PATH" ] || [ ! -d "$CONFIG_PATH" ]; then
    error.log "config.init.env: \$CONFIG_PATH ${RED}$CONFIG_PATH${NORMAL} missing — run ${YELLOW}config init.user${NORMAL} first"
    return 1
  fi
  # Back up ALL THREE, not just user.env. Only user.env was copied before, and
  # that is exactly how OOSH_PM was lost on the macOS VM: `config save oosh
  # OOSH` truncates oosh.env with `{ … } >$CONFIG` before anything can read the
  # surviving value out of it, so by the time the save fails there is nothing
  # left to restore from. The refuse-to-worsen guard below restores from these.
  local _ts _envName
  _ts=$(date +%Y%m%d-%H%M%S)
  # EVERY file the save will rewrite — user.env, each manifest file, each
  # loaded file — not a hard-coded user/oosh/log: the cascade truncates
  # odocker.env and any `config add` file too, and those had no backup (F7).
  local _envFiles
  _envFiles="user $(private.config.chain.files.get "$CONFIG_PATH/user.env" | tr '\n' ' ')"
  for _envName in $_envFiles; do
    [ -f "$CONFIG_PATH/$_envName.env" ] || continue
    cp -p "$CONFIG_PATH/$_envName.env" "$CONFIG_PATH/$_envName.env.bak.$_ts" 2>/dev/null \
      || warn.log "config.init.env: failed to back up $_envName.env (continuing)"
  done
  important.log "config.init.env: backed up${_envFiles:+ $(echo $_envFiles | sed 's/ /.env, /g').env} → ${GREEN}*.env.bak.$_ts${NORMAL}"

  # WHAT WAS MISSING BEFORE THIS TICKET. config.save persists the ENVIRONMENT,
  # and the environment is populated FROM the config — a closed loop with no
  # source of truth. So regenerating a config that had lost a variable simply
  # wrote the gap back, and on the macOS VM the report went from two missing
  # variables to three with oosh.env emptied.
  #
  # Derive here, in the REPAIR, and never in config.save: `oo pm.discover`
  # reaches `config save` internally (oo:3045 → config's log.device HACK → a
  # recursive `config save log LOG`), and that cascade is what wrote a shared
  # config tier on macOS. The writer stays a pure persister.
  #
  # Per-variable emptiness guard, exactly as private.user.init's OS_CMD heal
  # does it (user:1655-1699): a value that survived is NEVER overwritten by a
  # derived one. The verdicts go to stdout — nothing captures config.init.env,
  # unlike config.save — so an operator running the advertised repair can see
  # what was reconstructed and what could not be.
  local _variable _file _deriver _derived _repaired="" _unrecoverable="" _optional=""
  while read -r _variable _file _deriver _authority; do
    [ -z "$_variable" ] && continue
    # `kept`: a user's choice (LOG_LEVEL, OOSH_PM, ODOCKER_WORKSPACES) — only a
    # missing one is derived. `derived`: the host or the checkout is the truth,
    # so a STALE value is replaced too; skipping every set variable is how the
    # OOSH_MODE drift survived this very repair (T98).
    [ "$_authority" = derived ] || { [ -n "${!_variable}" ] && continue; }
    [ "$(type -t "$_deriver")" = "function" ] || { [ -n "${!_variable}" ] || _unrecoverable="$_unrecoverable $_variable"; continue; }
    _derived=$("$_deriver" 2>/dev/null)
    if [ -n "$_derived" ]; then
      [ "$_derived" = "${!_variable}" ] || _repaired="$_repaired $_variable"
      export "$_variable=$_derived"
    elif [ -z "${!_variable}" ] && [ "$_authority" = derived ]; then
      _unrecoverable="$_unrecoverable $_variable"
    elif [ -z "${!_variable}" ]; then
      # A kept row nothing derives is OPTIONAL, not unrecoverable (F2):
      # ODOCKER_WORKSPACES without a components base. Its file is simply not
      # written — private.config.manifest.files.get leaves it out.
      _optional="$_optional $_variable"
    fi
  done <<REQUIRED
$(private.config.required.variables.get)
REQUIRED
  [ -n "$_repaired" ]      && echo "config.init.env: re-derived:$_repaired"
  [ -n "$_unrecoverable" ] && echo "config.init.env: could NOT derive:$_unrecoverable — the regenerated config will still be missing these"
  [ -n "$_optional" ]      && echo "config.init.env: optional, nothing to derive:$_optional — its env file is not written"

  important.log "config.init.env: regenerating ${YELLOW}user.env${NORMAL} + every manifest / loaded env file via ${YELLOW}config save${NORMAL} (mirrors install)"
  # `config save` (no args) cascades internally: writes user.env, then calls
  # itself with (oosh OOSH) and (log LOG).
  config.save || warn.log "config.init.env: config.save returned non-zero — env files may be partial"

  # REFUSE TO WORSEN. The command `config validate required` advertises as the
  # repair must never again be able to make its own report worse — which is
  # precisely what it did on the VM. Count what is missing afterwards; if the
  # tier came out with FEWER export lines than it went in with, put the backups
  # back and say so.
  local _envRc=0
  for _envName in $_envFiles; do
    local _bak="$CONFIG_PATH/$_envName.env.bak.$_ts"
    [ -f "$_bak" ] || continue
    local _wasCount _nowCount
    # Count only exports that may still be persisted: a variable that moved out
    # of the shared tier (OOSH_MODE, T100) is a migration, not damage (T108).
    _wasCount=$(sed -n 's/^[[:space:]]*export[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$_bak" 2>/dev/null \
                | while read -r _n; do private.config.variable.persistable "$_n" && echo "$_n"; done | grep -c .)
    _nowCount=$(sed -n 's/^[[:space:]]*export[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$CONFIG_PATH/$_envName.env" 2>/dev/null \
                | while read -r _n; do private.config.variable.persistable "$_n" && echo "$_n"; done | grep -c .)
    if [ "${_nowCount:-0}" -lt "${_wasCount:-0}" ]; then
      echo "config.init.env: REFUSING — $_envName.env went from ${_wasCount:-0} to ${_nowCount:-0} export lines; restoring $_bak"
      cp -p "$_bak" "$CONFIG_PATH/$_envName.env" 2>/dev/null
      _envRc=1
    fi
  done
  # …and the LOAD LINES. The export counts above cannot see a lost
  # `. $CONFIG_PATH/odocker.env` — the hole config.save had until T96. Count
  # the env files user.env loads (existing ones only) before and after.
  local _bakUser="$CONFIG_PATH/user.env.bak.$_ts" _wasChain _nowChain
  if [ -f "$_bakUser" ]; then
    _wasChain=$(private.config.chain.files.get "$_bakUser" | grep -c .)
    _nowChain=$(private.config.chain.files.get "$CONFIG_PATH/user.env" | grep -c .)
    if [ "${_nowChain:-0}" -lt "${_wasChain:-0}" ]; then
      echo "config.init.env: REFUSING — user.env went from ${_wasChain:-0} to ${_nowChain:-0} loaded env files; restoring $_bakUser"
      cp -p "$_bakUser" "$CONFIG_PATH/user.env" 2>/dev/null
      _envRc=1
    fi
  fi
  return $_envRc
}

config.init.full() # <username:$USER> # repair end-to-end: shared dir + user symlinks + env files + diagnostics
{
  local username="$1"
  if [ -n "$1" ]; then shift; fi
  if [ -z "$username" ]; then username="$USER"; fi

  local rc=0
  config.init.shared || rc=$?
  config.init.user "$username" || rc=$?
  # init.env runs AFTER init.user so the ~/config symlink is canonical
  # before we write into the target. Only run for self-repair — regenerating
  # other users' env files from the caller's shell would write THIS shell's
  # OOSH_*/LOG_* state into THEIR config (likely wrong values).
  if [ "$username" = "$USER" ] || [ "$(id -u)" = "0" -a "$username" = "root" ]; then
    config.init.env || rc=$?
  fi
  config.init.check "$username" || rc=$?
  return $rc
}

