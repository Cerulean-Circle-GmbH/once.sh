private.config.env.line.set()     # <file> <name> <line> # set the definition of <name> in the env <file> to <line>, in place: every export NAME= and export declare NAME= line leaves, <line> goes in before the trailing chain block (the . and source lines at the end), one read and one write (owner, group and mode kept); an unchanged file is not rewritten; rc 1 and RESULT when the file cannot be written #
{
 # The writer of ONE definition in a shared env file (private.config.orig.import).
 # One read, one write: the chain lines at the end (`. file` / `source file`,
 # a tab after the dot too, blank lines among them) stay where they are and
 # the line goes in before them — never a moment without the chain, which a
 # drop-then-append had when the append failed (every user's session chain
 # gone). In place, as private.config.env.lines.drop: `>` keeps owner, group
 # and mode (config.set renames a temp file over it — the writer would become
 # the owner of a shared file). The write is checked; silent otherwise
 # (LOG_DEVICE can be fd1). T-CONFIG-ENV-LINE-SET.
 local file="$1" name="$2" line="$3"
 if [ -z "$file" ] || [ -z "$name" ] || [ -z "$line" ]; then
   create.result 1 "private.config.env.line.set requires <file> <name> <line>"
   return $(result)
 fi
 case "$name" in [0-9]*|*[!A-Za-z0-9_]*)
   create.result 1 "private.config.env.line.set: $name is no variable name"; return $(result) ;; esac
 local body="" tail="" current old=""
 local chainShape='^(\.|source)[[:space:]]'
 # The definition shapes of private.config.env.value.read: what it reads, this drops.
 local defShape="^(export[[:space:]]+(declare[[:space:]]+)?|declare[[:space:]]+-x[[:space:]]+)${name}="
 if [ -f "$file" ]; then
   old=$(cat "$file"; printf x); old="${old%x}"
   while IFS= read -r current || [ -n "$current" ]; do
     [[ "$current" =~ $defShape ]] && continue
     if [[ "$current" =~ $chainShape ]] || { [ -z "$current" ] && [ -n "$tail" ]; }; then
       tail="$tail$current"$'\n'
     else
       body="$body$tail$current"$'\n'; tail=""
     fi
   done < "$file"
 fi
 local new="$body$line"$'\n'"$tail"
 if [ "$new" = "$old" ]; then
   create.result 0 "$file unchanged"
   return $(result)
 fi
 if ! { printf '%s' "$new" > "$file"; } 2>/dev/null; then
   create.result 1 "cannot write $file — $name not set"
   return $(result)
 fi
 create.result 0 "$file: $name set"
 return $(result)
}


private.config.env.value.read()     # <file> <name> # echo the value of the last export NAME= or declare -x NAME= line of the env <file>, read as data and never sourced, one pair of enclosing quotes taken off; rc 1 when the file has no such line; silent #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. config.get
 # logs its declaration with info.log: inside $(…), with the log device on fd1
 # and LOG_LEVEL 4, that line became part of the value (T-CONFIG-ENV-VALUE-READ).
 # The file may hold code (a kept-aside ~/config): it is matched line by line,
 # never sourced. A definition is a line that STARTS with `export NAME=`, the
 # legacy `export declare NAME=` (config.get reads it too) or `declare -x
 # NAME=`; the last one wins, as in a shell. One pair of enclosing quotes goes;
 # anything after a closing quote stays, so `"3"; touch x` is not 3.
 local file="$1" name="$2" current value="" found=1
 case "$name" in ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;; esac
 [ -r "$file" ] || return 1
 local shape="^(export[[:space:]]+(declare[[:space:]]+)?|declare[[:space:]]+-x[[:space:]]+)${name}=(.*)$"
 while IFS= read -r current || [ -n "$current" ]; do
   [[ "$current" =~ $shape ]] || continue
   value="${BASH_REMATCH[3]}"; found=0
 done < "$file"
 [ "$found" = 0 ] || return 1
 case "$value" in
   \"*\") value="${value#\"}"; value="${value%\"}" ;;
   \'*\') value="${value#\'}"; value="${value%\'}" ;;
 esac
 printf '%s\n' "$value"
}


private.config.env.names.read()     # <file> # echo the name of every variable an export NAME= or declare -x NAME= line of the env <file> assigns, once each, in order, read as data and never sourced; silent #
{
 # NO create.result — a getter consumed as $(...): SILENT BY CONTRACT. The
 # sibling of private.config.env.value.read, by the same line shapes: which
 # names a kept-aside ~/config assigns. Never sourced. T-CONFIG-ENV-NAMES-READ.
 local file="$1" current seen=" "
 [ -r "$file" ] || return 0
 local shape='^(export[[:space:]]+(declare[[:space:]]+)?|declare[[:space:]]+-x[[:space:]]+)([A-Za-z_][A-Za-z0-9_]*)='
 while IFS= read -r current || [ -n "$current" ]; do
   [[ "$current" =~ $shape ]] || continue
   case "$seen" in *" ${BASH_REMATCH[3]} "*) continue ;; esac
   seen="$seen${BASH_REMATCH[3]} "
   printf '%s\n' "${BASH_REMATCH[3]}"
 done < "$file"
 return 0
}


private.config.host.name.valid()     # <name> # rc 0 when <name> can be the computer name of oosh: letters, digits, - and _, starting with a letter or digit, no dot, at most 63 characters #
{
