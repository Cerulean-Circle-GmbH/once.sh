otmux.send.zoomed() # <target> <key1> [<key2>...] # zoom pane, send keys, unzoom — for narrow-pane TUI interaction
{
  local target=$(private.resolve.target "$1")
  shift
  if ! private.otmux.target.isPane "$target"; then
    error.log "otmux.send.zoomed: invalid pane target '$target'"
    return 1
  fi
  [ $# -eq 0 ] && { error.log "Usage: otmux send.zoomed <target> <key1> [<key2>...]"; return 1; }

  $TMUX_CMD resize-pane -Z -t "$target"
  sleep 0.3

  for key in "$@"; do
    $TMUX_CMD send-keys -t "$target" "$key"
    sleep 0.1
  done

  sleep 0.5
  $TMUX_CMD resize-pane -Z -t "$target"
}
