  else
    $TMUX_CMD split-window -h "$@"
  fi
}

otmux.split.v() # <?target> <?command> # split pane vertically (top-bottom)
{
  if [[ "$1" == *[:.]*  ]] && [ -n "$1" ]; then
    local target="$1"; shift
    $TMUX_CMD split-window -v -t "$target" "$@"
  else
