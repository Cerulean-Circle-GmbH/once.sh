#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

test.suite.level()
{
  level=$1
  case $1 in
      ''|*[!0-9]*) 
        level=$3
        ;;
      *) echo test.suite level=$level ;;
  esac
  if [ -z "$level" ]; then
    level=$LOG_LEVEL
  fi
  if [ -z "$level" ]; then
    level=3
  fi
}

test.suite.level $*

echo -e "[96m test.suite starting: $0 <LOG_LEVEL=$level>[0m"
# if [ "$level" -gt "5" ]; then
#     set -x
# fi

test.suite.discover() # # discovers all tests
{
  test.suite.run.completion
}

test.suite.run.completion() # # returns list of available tests for completion
{
  ls $OOSH_DIR/test/* | sed 's/\/.*\/oosh\/test\/\(interactive.\)*test\.//' | grep "^$1"
}

test.suite.parameter.completion.test() {
  test.suite.run.completion
}

test.suite.parameter.completion.logLevel() {
  echo "1"
  echo "2"
  echo "3"
  echo "4"
  echo "5"
}

private.test.suite.category() # <file> # reads TEST_CATEGORY from a test file, defaults to extended
{
  local file="$1"
  local category
  category=$(grep -m1 '^TEST_CATEGORY=' "$file" 2>/dev/null | cut -d= -f2)
  if [ -z "$category" ]; then
    category="extended"
  fi
  create.result 0 "$category"
}

private.test.suite.shared.waiver.get() # <file> # the recorded reason <file> is a KNOWN shared-tier writer, or empty; answers on stdout
{
  # NO create.result — a getter consumed as $(...), same subshell reasoning as
  # private.test.suite.category.
  #
  # A waiver is a confession, not an exemption. The guard still reports the
  # file and still restores the tier; it only stops the run going red for a
  # writer that CANNOT be fixed yet. Every waiver must name the ticket that
  # will remove it, and the list must reach zero.
  grep -m1 '^TEST_SHARED_TIER_WRITER=' "$1" 2>/dev/null | cut -d= -f2- | tr -d '"'
}

private.test.suite.results.file.get() # # absolute path of the per-file handoff the child writes and the runner reads back as that file's score
{
  # NO create.result here, deliberately. This is a getter consumed as $(...),
  # and a command substitution runs in a SUBSHELL — RESULT and RETURN_VALUE
  # set inside it never reach the caller, so the contract would silently break
  # the value channel. Same reasoning as private.oo.path.sudo.get,
  # test.suite.home.passwd and test.suite.anchors.check, which all answer
  # on stdout for exactly this reason.
  #
  # A default SUBSTITUTION, not an assignment — this.anchor.validate matches
  # `${CONFIG_PATH:=` and plain assignments, and this is neither, so no
  # exception marker is warranted here.
  echo "${TEST_SUITE_RESULT_PATH:-${CONFIG_PATH:-$HOME/config}}/testresult.env"
}

private.test.suite.results.clear() # # remove the handoff file, so the next file cannot be scored with the previous file's numbers
{
  # Runner-only, called between files. It removes the FILE and deliberately
  # does NOT zero the counters — the two were one primitive at first, and
  # calling it wiped the calling file's own running score. Zeroing lives in
  # private.test.suite.counters.reset.
  local resultsFile; resultsFile=$(private.test.suite.results.file.get)
  rm -f "$resultsFile" 2>/dev/null
  if [ -e "$resultsFile" ]; then
    # $CONFIG_PATH is a SHARED sharedConfig (2775, group dev). Another user's
    # file is unlinkable unless the DIRECTORY lost its group-write bit — the
    # state private.os.platform.shared.config.repair exists to fix. Silent
    # failure here silently restores the inheritance bug, so: loud, and via
    # bare echo so the instruction survives any LOG_DEVICE.
    create.result 1 "cannot remove $resultsFile — every score from here on would be inherited"
    echo -e "\e[1;31m  ✗ test.suite: $RESULT\e[0m"
    return $(result)
  fi
  create.result 0 "handoff cleared"
  return $(result)
}

private.test.suite.counters.reset() # # zero the exported per-file counters between files; runner-only, never call this from inside a test file
{
  # Exported, so each child inherits them. The `declare -i` in test.suite.init
  # is function-local and evaporates on return, which is why the file-scope
  # counters in every test file come from the environment rather than from there.
  TEST_SUITE_TEST_COUNTER=0
  TEST_SUITE_EXPECT_COUNTER=0
  TEST_SUITE_SUCCESS_COUNTER=0
  export TEST_SUITE_TEST_COUNTER TEST_SUITE_EXPECT_COUNTER TEST_SUITE_SUCCESS_COUNTER
  create.result 0 "per-file counters reset"
  return $(result)
}

test.suite.save.results() # # writes this file's counters to the handoff the runner reads, then prints the summary
{
  # NOT `source $OOSH_DIR/config; config.save testresult TEST_SUITE`.
  # config.file re-points $CONFIG under whatever CONFIG_PATH is current, so a
  # file that isolated its config would have written its score into its own
  # fixture and the runner would have re-read the PREVIOUS file's numbers.
  # Three literal lines, one destination, and no config.start — which used to
  # run at the tail of every test file and could re-fire config.init.
  # Isolation self-check, BEFORE the counters are written so it is scored.
  # Only files that called test.suite.config.isolate carry a stamp.
  if [ -n "$TEST_SUITE_CONFIG_STAMP" ]; then
    local nowStamp; nowStamp=$(private.test.suite.config.stamp.get "$TEST_SUITE_CONFIG_ORIGIN")
    if [ "$nowStamp" = "$TEST_SUITE_CONFIG_STAMP" ]; then
      expect.pass "shared config tier untouched ($TEST_SUITE_CONFIG_ORIGIN)"
    else
      expect.fail "this file WROTE the shared config tier — before[$TEST_SUITE_CONFIG_STAMP] after[$nowStamp]"
    fi
  fi

  local resultsFile; resultsFile=$(private.test.suite.results.file.get)
  {
    echo "export TEST_SUITE_TEST_COUNTER=\"${TEST_SUITE_TEST_COUNTER:-0}\""
    echo "export TEST_SUITE_EXPECT_COUNTER=\"${TEST_SUITE_EXPECT_COUNTER:-0}\""
    echo "export TEST_SUITE_SUCCESS_COUNTER=\"${TEST_SUITE_SUCCESS_COUNTER:-0}\""
  } > "$resultsFile"

  # Print final summary
  test.suite.summary
}

test.suite.summary() # # prints test summary with pass/fail counts
{
  local total=${TEST_SUITE_EXPECT_COUNTER:-0}
  local passed=${TEST_SUITE_SUCCESS_COUNTER:-0}
  local failed=$((total - passed))

  echo ""
  echo -e "\e[1;37m════════════════════════════════════════════════════════════════════\e[0m"
  echo -e "\e[1;37m                         TEST SUMMARY                               \e[0m"
  echo -e "\e[1;37m════════════════════════════════════════════════════════════════════\e[0m"
  echo ""
  echo -e "  Test Cases:  \e[1;37m$TEST_SUITE_TEST_COUNTER\e[0m"
  echo -e "  Assertions:  \e[1;37m$total\e[0m"
  echo -e "  Passed:      \e[1;32m$passed\e[0m"
  if [ "$failed" -gt 0 ]; then
    echo -e "  Failed:      \e[1;31m$failed\e[0m"
  else
    echo -e "  Failed:      \e[1;32m0\e[0m"
  fi
  echo ""

  if [ "$passed" -eq "$total" ] && [ "$total" -gt 0 ]; then
    echo -e "  \e[1;32m✓ ALL TESTS PASSED\e[0m"
  elif [ "$total" -eq 0 ]; then
    echo -e "  \e[1;33m⚠ NO TESTS RUN\e[0m"
  else
    echo -e "  \e[1;31m✗ SOME TESTS FAILED\e[0m"
  fi
  echo ""
  echo -e "\e[1;37m════════════════════════════════════════════════════════════════════\e[0m"
}

test.suite.init() # # initializes test suite counters and environment
{
  source this
  source log
  log.init.colors


  if [ -z "$TEST_COUNTER" ]; then
    if [ -t 1 ] && [ -w "$(tty 2>/dev/null)" ]; then
      export LOG_DEVICE="$(tty)"
    elif [ -w /proc/self/fd/1 ]; then
      export LOG_DEVICE=/proc/self/fd/1
    else
      export LOG_DEVICE=/dev/null
    fi
    declare -i TEST_SUITE_TEST_COUNTER=0
    declare -i TEST_SUITE_EXPECT_COUNTER=0
    declare -i TEST_SUITE_SUCCESS_COUNTER=0
    export SUITE_RESULT="Suite Result: "
  fi

  # Pin the CONFIG_PATH this process INHERITED, before anything can move it.
  # Two distinct jobs used to share one variable: test.suite.config.restore put
  # TEST_SUITE_RESULT_PATH back into CONFIG_PATH, which was only correct while
  # the score happened to live in the config tier. They are separate now —
  # ORIGIN is "the tier I inherited", RESULT_PATH is "where my score goes".
  : ${TEST_SUITE_CONFIG_ORIGIN:=${CONFIG_PATH:-$HOME/config}}
  export TEST_SUITE_CONFIG_ORIGIN

  # Where this file's score goes. `:=` on an exported variable means the
  # runner's value wins in every child (test files are exec'd, not sourced), so
  # parent and child resolve the same handoff path by construction rather than
  # by convention — even when a file isolates its config.
  # The flag records that nobody chose this value, so the runner may replace it
  # with a private per-run directory (private.test.suite.results.dir.open). A
  # caller that pins TEST_SUITE_RESULT_PATH itself is never overridden.
  if [ -z "$TEST_SUITE_RESULT_PATH" ]; then
    TEST_SUITE_RESULT_PATH="${CONFIG_PATH:-$HOME/config}"
    TEST_SUITE_RESULT_PATH_DEFAULTED=1
    export TEST_SUITE_RESULT_PATH_DEFAULTED
  fi
  export TEST_SUITE_RESULT_PATH

  # Initialize expected error tracking
  export TEST_EXPECTING_ERROR=0
  export TEST_EXPECTED_ERROR_CODE=0

  if (this.isSourced); then
    debug.log "test.suite sourced"
    if [ "$2" = "clear" ]; then
      clear
    fi
    export PS4='\e[90m  ${BASH_SOURCE[0]##*/} -> ${BASH_SOURCE[1]##*/}: ${FUNCNAME[0]}:${LINENO}   - ${BASH_SOURCE[@]##*/} \e[0m'
    if [ "$LOG_LEVEL" -gt "5" ]; then
        set -x
    fi
  else
    #important.log "test.suite started"
    this.start "$@"
  fi
}

test.suite.run() # <test> <?logLevel:1> # runs a test from the test folder
{
  local command=$1
  shift
  local level=$1
  shift
  local clear=$1
  shift

  if [ -z "$level" ]; then
    level=1
  fi

  # Print test header
  echo ""
  echo -e "\e[1;36m╔════════════════════════════════════════════════════════════════════╗\e[0m"
  echo -e "\e[1;36m║  RUNNING TEST: test.$command\e[0m"
  echo -e "\e[1;36m╚════════════════════════════════════════════════════════════════════╝\e[0m"
  echo ""

  private.test.suite.results.dir.open >/dev/null
  private.test.suite.shared.snapshot >/dev/null

  # Same pre-clear as the filtered runner: after this line the handoff exists
  # if and only if THIS file wrote it.
  private.test.suite.results.clear
  private.test.suite.counters.reset

  if [ "$level" -gt 0 ]; then
    important.log "starting test: $OOSH_DIR/test/test.$command -level:$level- -clear:$clear-"
    $OOSH_DIR/test/test.$command $level $clear
  else
    $OOSH_DIR/test/test.$command $level $clear >/dev/null
  fi

  local sharedWrites=0
  if ! private.test.suite.shared.verify "test.$command"; then
    local sharedReason="$RESULT"
    local sharedWaiver; sharedWaiver=$(private.test.suite.shared.waiver.get "$OOSH_DIR/test/test.$command")
    [ -z "$sharedWaiver" ] && sharedWrites=1
    private.test.suite.shared.report "$sharedReason" "test.$command" "$sharedWaiver"
  fi

  local resultsFile; resultsFile=$(private.test.suite.results.file.get)
  if check file "$resultsFile" exists; then
    source "$resultsFile"
  else
    # Previously this left the counters EMPTY (the reset sat inside the `if`),
    # so the comparison below became `[ "" -eq "" ]` → "integer expression
    # expected" on a clean box, or the previous file's numbers otherwise.
    private.test.suite.counters.reset
    echo -e "\e[1;33m  ⚠ NO RESULTS: test.$command produced no score of its own — 0 / 0\e[0m"
  fi

  # Print results
  echo ""
  echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"
  echo -e "  Completed: \e[1;37mtest.$command\e[0m"
  echo -e "  Results:   \e[1;32m$TEST_SUITE_SUCCESS_COUNTER\e[0m / $TEST_SUITE_EXPECT_COUNTER assertions passed"
  echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"

  local rc=0
  if [ "$sharedWrites" -gt 0 ]; then
    echo -e "\e[1;31m  ✗ the shared config tier was written\e[0m"
    rc=1
  elif [ "$TEST_SUITE_SUCCESS_COUNTER" -eq "$TEST_SUITE_EXPECT_COUNTER" ]; then
    echo -e "\e[1;32m  ✓ All tests successful\e[0m"
  else
    echo -e "\e[1;31m  ✗ Some tests failed\e[0m"
    rc=1
  fi
  private.test.suite.results.dir.close >/dev/null
  return $rc
}

private.test.suite.shared.report() # <reason> <testFile> <?waiver> # print the shared-tier verdict and put the tier back; runner-only
{
  # Bare echo, not error.log: this says the site-wide config every user sources
  # at login was just rewritten, and it has to survive a non-tty CI run.
  if [ -n "$3" ]; then
    echo -e "\e[1;33m  ⚠ SHARED CONFIG WRITTEN (known): $1\e[0m" >&2
    echo -e "\e[1;33m    waived: $3\e[0m" >&2
  else
    echo -e "\e[1;31m  ✗ SHARED CONFIG WRITTEN: $1\e[0m" >&2
    echo -e "\e[1;31m    fix: add  test.suite.config.isolate ${2}  before the 'source' of the script under test\e[0m" >&2
  fi
  if private.test.suite.shared.restore; then
    echo -e "\e[1;33m    the tier has been restored from this run's snapshot\e[0m" >&2
  else
    echo -e "\e[1;31m    COULD NOT RESTORE: $RESULT\e[0m" >&2
  fi
  create.result 0 "reported"
  return $(result)
}

private.test.suite.run.filtered() # <level> <clear> <?category> # runs tests matching category filter
{
  local level=$1
  local clear=$2
  local categoryFilter=$3

  # Initialize cumulative counters
  local -i CUMULATIVE_TEST_COUNTER=0
  local -i CUMULATIVE_EXPECT_COUNTER=0
  local -i CUMULATIVE_SUCCESS_COUNTER=0
  local -i FILE_COUNT=0
  # Files that produced no score of their own. Tracked separately from
  # TOTAL_FAILED on purpose: that number is assertion arithmetic and feeds
  # GITHUB_OUTPUT failed=, where a workflow reads it as "assertions that
  # failed". A file with 0 expects has 0 failures.
  local -i NO_RESULT_COUNT=0
  local NO_RESULT_FILES=""
  # Files caught rewriting the site-wide config tier. Unlike NO_RESULT_COUNT
  # this fails every category, because the damage is to other users, not to
  # this run's arithmetic.
  local -i SHARED_WRITE_COUNT=0
  local SHARED_WRITE_FILES=""
  # Files that declare TEST_SHARED_TIER_WRITER — reported and restored, but not
  # failed, because the write is blocked on another ticket. Counted separately
  # so the number is visible and has to come down.
  local -i SHARED_WAIVED_COUNT=0
  local SHARED_WAIVED_FILES=""

  private.test.suite.results.dir.open >/dev/null
  private.test.suite.shared.snapshot >/dev/null

  # Count total files matching filter
  local -i TOTAL_FILES=0
  for file in $OOSH_DIR/test/test.*; do
    [ -d "$file" ] && continue
    if [ -n "$categoryFilter" ]; then
      private.test.suite.category "$file"
      [ "$RESULT" != "$categoryFilter" ] && continue
    fi
    ((TOTAL_FILES++))
  done

  # Track intentional failures from meta-test (test.test.suite)
  local -i META_TEST_FAILURES=0
  local META_TEST_RAN=0

  # Print suite header
  local headerLabel="ALL TESTS"
  if [ -n "$categoryFilter" ]; then
    headerLabel="${categoryFilter^^} TESTS"
  fi

  echo ""
  echo -e "\e[1;35m╔════════════════════════════════════════════════════════════════════╗\e[0m"
  echo -e "\e[1;35m║                    RUNNING $headerLabel\e[0m"
  echo -e "\e[1;35m║                    Log Level: $level                                       ║\e[0m"
  echo -e "\e[1;35m╚════════════════════════════════════════════════════════════════════╝\e[0m"

  for file in $OOSH_DIR/test/test.*
  do
    # Skip test.data directory
    if [ -d "$file" ]; then
      continue
    fi

    # Ask for the category ALWAYS, not only when filtering: the shared-tier
    # guard below has to know whether this is a platform test, and `test.suite
    # all 1` passes no filter yet still runs them.
    private.test.suite.category "$file"
    local fileCategory="$RESULT"
    if [ -n "$categoryFilter" ] && [ "$fileCategory" != "$categoryFilter" ]; then
      continue
    fi

    ((FILE_COUNT++))
    local filename=$(basename "$file")

    # Print test file header
    echo ""
    echo -e "\e[1;36m╔════════════════════════════════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;36m║  [$FILE_COUNT/$TOTAL_FILES] $filename\e[0m"
    echo -e "\e[1;36m╚════════════════════════════════════════════════════════════════════╝\e[0m"

    # Clear the handoff BEFORE the run: after this line the file exists if and
    # only if THIS file wrote it. The old code cleared only the shell VARIABLES
    # and left the file behind, so a file that never called
    # test.suite.save.results was silently scored with the previous file's
    # numbers — test.tilde reporting test.this's 31 assertions was the instance
    # that exposed it.
    private.test.suite.results.clear
    private.test.suite.counters.reset

    # Run the test file (subprocess — counters don't propagate back)
    if [ "$level" -gt 0 ]; then
      $file $level $clear
    else
      $file $level $clear >/dev/null
    fi

    # Did this file rewrite the site-wide tier? A platform test is exempt by
    # design — it asserts on the REAL installed machine, which is the whole
    # reason TEST_CATEGORY=platform exists.
    if [ "$fileCategory" != "platform" ]; then
      if ! private.test.suite.shared.verify "$filename"; then
        local sharedReason="$RESULT"
        local sharedWaiver; sharedWaiver=$(private.test.suite.shared.waiver.get "$file")
        if [ -z "$sharedWaiver" ]; then
          ((SHARED_WRITE_COUNT++))
          SHARED_WRITE_FILES="$SHARED_WRITE_FILES $filename"
        else
          ((SHARED_WAIVED_COUNT++))
          SHARED_WAIVED_FILES="$SHARED_WAIVED_FILES $filename"
        fi
        private.test.suite.shared.report "$sharedReason" "$filename" "$sharedWaiver"
      fi
    fi

    # Load per-file results saved by test.suite.save.results in the subprocess
    local FILE_TESTS=0 FILE_EXPECTS=0 FILE_SUCCESS=0
    local resultsFile; resultsFile=$(private.test.suite.results.file.get)
    if check file "$resultsFile" exists; then
      source "$resultsFile"
      FILE_TESTS=${TEST_SUITE_TEST_COUNTER:-0}
      FILE_EXPECTS=${TEST_SUITE_EXPECT_COUNTER:-0}
      FILE_SUCCESS=${TEST_SUITE_SUCCESS_COUNTER:-0}
    else
      ((NO_RESULT_COUNT++))
      NO_RESULT_FILES="$NO_RESULT_FILES $filename"
      echo -e "\e[1;33m  ⚠ NO RESULTS: $filename produced no score of its own — reported 0 / 0, NOT the previous file's numbers\e[0m"
    fi
    # Clear again so the suite never leaves a stale score in the shared dir
    # between invocations.
    private.test.suite.results.clear
    private.test.suite.counters.reset
    local FILE_FAILED=$((FILE_EXPECTS - FILE_SUCCESS))

    # Track meta-test (test.test.suite) failures separately
    # This test has 1 INTENTIONAL failure to verify counter logic works
    if [ "$filename" = "test.test.suite" ]; then
      META_TEST_RAN=1
      META_TEST_FAILURES=$FILE_FAILED
    fi

    # Accumulate cumulative counters from per-file results
    ((CUMULATIVE_TEST_COUNTER += FILE_TESTS))
    ((CUMULATIVE_EXPECT_COUNTER += FILE_EXPECTS))
    ((CUMULATIVE_SUCCESS_COUNTER += FILE_SUCCESS))

    # Show per-file summary only if LOG_LEVEL > 1
    if [ "$level" -gt 1 ]; then
      echo ""
      echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"
      echo -e "  File: \e[1;37m$filename\e[0m"
      echo -e "  Results: \e[1;32m$FILE_SUCCESS\e[0m / $FILE_EXPECTS assertions"
      if [ "$FILE_SUCCESS" -eq "$FILE_EXPECTS" ] && [ "$FILE_EXPECTS" -gt 0 ]; then
        echo -e "  \e[1;32m✓ PASS\e[0m"
      elif [ "$FILE_EXPECTS" -eq 0 ]; then
        echo -e "  \e[1;33m⚠ NO ASSERTIONS\e[0m"
      elif [ "$filename" = "test.test.suite" ] && [ "$FILE_FAILED" -eq 1 ]; then
        echo -e "  \e[1;32m✓ PASS (1 intentional failure - meta-test working correctly)\e[0m"
      else
        echo -e "  \e[1;31m✗ FAIL ($FILE_FAILED failed)\e[0m"
      fi
      echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"
    fi
  done

  # Print final overall summary (always shown)
  local TOTAL_FAILED=$((CUMULATIVE_EXPECT_COUNTER - CUMULATIVE_SUCCESS_COUNTER))

  # Check if the ONLY failure is the intentional one from test.test.suite
  local ONLY_INTENTIONAL_FAILURE=0
  if [ "$META_TEST_RAN" -eq 1 ] && [ "$META_TEST_FAILURES" -eq 1 ] && [ "$TOTAL_FAILED" -eq 1 ]; then
    ONLY_INTENTIONAL_FAILURE=1
  fi

  echo ""
  echo -e "\e[1;35m╔════════════════════════════════════════════════════════════════════╗\e[0m"
  echo -e "\e[1;35m║                    FINAL ${headerLabel} SUMMARY\e[0m"
  echo -e "\e[1;35m╚════════════════════════════════════════════════════════════════════╝\e[0m"
  echo ""
  echo -e "  Test Files:  \e[1;37m$FILE_COUNT\e[0m"
  echo -e "  Test Cases:  \e[1;37m$CUMULATIVE_TEST_COUNTER\e[0m"
  echo -e "  Assertions:  \e[1;37m$CUMULATIVE_EXPECT_COUNTER\e[0m"
  echo -e "  Passed:      \e[1;32m$CUMULATIVE_SUCCESS_COUNTER\e[0m"
  if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
    echo -e "  Failed:      \e[1;32m1 (intentional meta-test)\e[0m"
  elif [ "$TOTAL_FAILED" -gt 0 ]; then
    echo -e "  Failed:      \e[1;31m$TOTAL_FAILED\e[0m"
  else
    echo -e "  Failed:      \e[1;32m0\e[0m"
  fi
  if [ "$NO_RESULT_COUNT" -gt 0 ]; then
    echo -e "  \e[1;33mNo results:  $NO_RESULT_COUNT file(s) never called test.suite.save.results:\e[0m$NO_RESULT_FILES"
  fi
  if [ "$SHARED_WRITE_COUNT" -gt 0 ]; then
    echo -e "  \e[1;31mShared tier: $SHARED_WRITE_COUNT file(s) rewrote $TEST_SUITE_CONFIG_ORIGIN:\e[0m$SHARED_WRITE_FILES"
  fi
  if [ "$SHARED_WAIVED_COUNT" -gt 0 ]; then
    echo -e "  \e[1;33mShared tier: $SHARED_WAIVED_COUNT known writer(s), waived and restored:\e[0m$SHARED_WAIVED_FILES"
  fi
  echo ""

  # GitHub Actions Job Summary (only when running in GHA)
  if [ -n "$GITHUB_STEP_SUMMARY" ]; then
    local ghaWho="User"
    [ "$(id -u)" = "0" ] && ghaWho="Root"
    local ghaFailed="$TOTAL_FAILED"
    local ghaStatus="✅ ALL TESTS PASSED"
    if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
      ghaStatus="✅ ALL TESTS PASSED (1 intentional meta-test)"
    elif [ "$TOTAL_FAILED" -gt 0 ]; then
      ghaStatus="❌ $TOTAL_FAILED TESTS FAILED"
    fi
    {
      echo "### ${ghaWho} Tests"
      echo ""
      echo "| Metric | Count |"
      echo "|--------|------:|"
      echo "| Test Files | $FILE_COUNT |"
      echo "| Test Cases | $CUMULATIVE_TEST_COUNTER |"
      echo "| Assertions | $CUMULATIVE_EXPECT_COUNTER |"
      echo "| Passed | $CUMULATIVE_SUCCESS_COUNTER |"
      echo "| Failed | $ghaFailed |"
      echo ""
      echo "> $ghaStatus"
      echo ""
    } >> "$GITHUB_STEP_SUMMARY"
  fi

  # Write fail count for workflow-level summary
  if [ -n "$GITHUB_OUTPUT" ]; then
    if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
      echo "failed=0" >> "$GITHUB_OUTPUT"
    else
      echo "failed=$TOTAL_FAILED" >> "$GITHUB_OUTPUT"
    fi
  fi

  # One rule, one place, testable — see private.test.suite.verdict. The chain
  # that used to live here was unreachable by any test, which is how a written
  # shared tier and a score-less core file came to be printed and then dropped
  # before the return code the CI gate reads.
  local rc=0
  if private.test.suite.verdict \
       "$SHARED_WRITE_COUNT" "$NO_RESULT_COUNT" "$categoryFilter" \
       "$CUMULATIVE_EXPECT_COUNTER" "$CUMULATIVE_SUCCESS_COUNTER" "$META_TEST_FAILURES"; then
    if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
      echo -e "  \e[1;32m╔══════════════════════════════════════════════════════════════════╗\e[0m"
      echo -e "  \e[1;32m║  ✓ ALL TESTS PASSED                                              ║\e[0m"
      echo -e "  \e[1;32m║    (1 intentional failure in test.test.suite verifies counters)  ║\e[0m"
      echo -e "  \e[1;32m╚══════════════════════════════════════════════════════════════════╝\e[0m"
    else
      echo -e "  \e[1;32m✓ ALL TESTS PASSED\e[0m"
    fi
  else
    echo -e "  \e[1;31m✗ $RESULT\e[0m"
    rc=1
  fi
  private.test.suite.results.dir.close >/dev/null
  return $rc
}

test.suite.all() # <?logLevel:1> # runs all tests from the test folder
{
  local level=$1
  if [ -z "$level" ]; then
    level=1
  fi
  shift
  local clear=$1
  shift

  private.test.suite.run.filtered "$level" "$clear" ""
}

test.suite.core() # <?logLevel:1> # runs core infrastructure tests
{
  local level=$1
  if [ -z "$level" ]; then
    level=1
  fi
  shift
  local clear=$1
  shift

  private.test.suite.run.filtered "$level" "$clear" "core"
}

test.suite.extended() # <?logLevel:1> # runs extended feature tests
{
  local level=$1
  if [ -z "$level" ]; then
    level=1
  fi
  shift
  local clear=$1
  shift

  private.test.suite.run.filtered "$level" "$clear" "extended"
}

test.case() # <logLevel:-> <testName> <testFunction> <testArguments> # runs a test case and captures result
{
  ((TEST_SUITE_TEST_COUNTER++))

  local level=$1
  shift
  export testName=$1
  shift
  local testFunction="$1"
  shift
  local testArguments="$@"

  if ! [ "$level" = "-" ]; then
    log.level $level
  fi
  if [ "$LOG_LEVEL" -gt "5" ]; then
      set -x
  fi

  # Print test case header
  echo ""
  echo -e "\e[1;37m┌──────────────────────────────────────────────────────────────────┐\e[0m"
  echo -e "\e[1;37m│ Test $TEST_SUITE_TEST_COUNTER: $testName\e[0m"
  echo -e "\e[1;37m└──────────────────────────────────────────────────────────────────┘\e[0m"

  if [ "$LOG_LEVEL" -gt "2" ]; then
    echo -e "\e[90m  → $testFunction $testArguments\e[0m"
  fi

  # Check if we're expecting an error
  if [ "$TEST_EXPECTING_ERROR" -eq 1 ]; then
    # Capture stderr and suppress error output for expected errors
    {
      $testFunction $testArguments
      RETURN_VALUE=$?
    } 2>/dev/null

    if [ "$RETURN_VALUE" -eq "$TEST_EXPECTED_ERROR_CODE" ]; then
      echo -e "\e[1;32m  ✓ EXPECTED ERROR (code $RETURN_VALUE) - OK\e[0m"
    else
      echo -e "\e[1;33m  ⚠ Expected error code $TEST_EXPECTED_ERROR_CODE but got $RETURN_VALUE\e[0m"
    fi

    # Reset expected error state
    TEST_EXPECTING_ERROR=0
    TEST_EXPECTED_ERROR_CODE=0
  else
    # Normal test execution - suppress stderr to hide internal errors
    # Errors will be shown in assertions
    if [ "$LOG_LEVEL" -gt "2" ]; then
      $testFunction $testArguments
      RETURN_VALUE=$?
    else
      {
        $testFunction $testArguments
        RETURN_VALUE=$?
      } 2>/dev/null
    fi

    # Don't call onError here - let the assertions handle pass/fail reporting
  fi

  if [ "$LOG_LEVEL" -gt "2" ]; then
    echo -e "\e[90m  ← RETURN: $RETURN_VALUE  Result: $RESULT\e[0m"
  fi
}

test.case.expect.error() # <errorCode> <testName> <testFunction> <testArguments> # runs test case expecting specific error
{
  local errorCode=$1
  shift

  # Set expected error state
  export TEST_EXPECTING_ERROR=1
  export TEST_EXPECTED_ERROR_CODE=$errorCode
  export EXPECTED_RETURN_VALUE=$errorCode

  # Run test case with remaining args (level is "-" to preserve log level)
  test.case "-" "$@"
}

expect() # <returnValue> <expectedResult> <?message> # asserts test result matches expected
{
  ((TEST_SUITE_EXPECT_COUNTER++))

  local -i EXPECT_RETURN_CODE=$1
  shift
  local expectedresult="$1"
  shift
  local message="$1"
  shift

  declare -i rv=$RETURN_VALUE
  #console.log "${BOLD_CYAN}starting on testcase: \#$TEST_COUNTER - $testcase${NORMAL}"

  if [ -z "$message" ]; then
    message=$testName
  fi

  if [ "$expectedresult" = "*" ]; then
    expectedresult=$RESULT
  fi

  if [ "$EXPECT_RETURN_CODE" = "*" ]; then
    EXPECT_RETURN_CODE=$RETURN_VALUE
  fi

  if [ "$EXPECT_RETURN_CODE" -eq $rv ] && [ "$RESULT" = "$expectedresult" ]; then
    ((TEST_SUITE_SUCCESS_COUNTER++))
    echo -e "\e[1;32m  ✓ PASS:\e[0m $message"
  else
    echo -e "\e[1;31m  ✗ FAIL:\e[0m $message"
    echo -e "\e[90m    Expected return: $EXPECT_RETURN_CODE, got: $RETURN_VALUE\e[0m"
    if [ "$expectedresult" != "$RESULT" ]; then
      echo -e "\e[90m    Expected result: $expectedresult\e[0m"
      echo -e "\e[90m    Got result:      $RESULT\e[0m"
    fi
  fi

  TEST_SUITE_RESULT="\e[1;32m$TEST_SUITE_SUCCESS_COUNTER\e[0m / $TEST_SUITE_EXPECT_COUNTER expects on $TEST_SUITE_TEST_COUNTER Tests"
}

expect.pass() # <?message> # simple pass assertion with optional message
{
  ((TEST_SUITE_EXPECT_COUNTER++))
  ((TEST_SUITE_SUCCESS_COUNTER++))

  local message="$1"
  if [ -z "$message" ]; then
    message="assertion passed"
  fi
  echo -e "\e[1;32m  ✓ PASS:\e[0m $message"
}

expect.fail() # <?message> # simple fail assertion with optional message
{
  ((TEST_SUITE_EXPECT_COUNTER++))

  local message="$1"
  if [ -z "$message" ]; then
    message="assertion failed"
  fi
  echo -e "\e[1;31m  ✗ FAIL:\e[0m $message"
}

test.suite.home.passwd() # # print this user's home the way boot derives it under env -i: getent -> dscl -> /etc/passwd, first line, field 6
{
  # The expectation for every boot-under-env-i test. NOT $HOME: under `sudo`
  # without -H, or a HOME-overriding CI runner, the runner's $HOME and the
  # password-database home differ, and boot (correctly) yields the latter.
  local user home=""
  user=$(id -un 2>/dev/null)
  if command -v getent >/dev/null 2>&1; then
    home=$(getent passwd "$user" 2>/dev/null | head -1 | cut -d: -f6)
  fi
  if [ -z "$home" ] && command -v dscl >/dev/null 2>&1; then
    home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  fi
  if [ -z "$home" ] && [ -r /etc/passwd ]; then
    home=$(awk -F: -v u="$user" '$1 == u { print $6; exit }' /etc/passwd)
  fi
  echo "$home"
}

test.suite.anchors.check() # <sourceCommand> # run <sourceCommand> (e.g. `. "$HOME/config/user.env"`) under env -i with HOME set from the password database, in sh, dash, ash, bash and busybox ash; print nothing when every shell yields this user's anchors and the caller survives, else one `shell=>output` per failure
{
  # The one harness behind every "stand the environment up from user.env"
  # assertion (test.config T65, test.platform.profile.dropin.invariant). HOME is
  # PASSED: the data route cannot derive it — that is the login drop-in's job,
  # asserted separately through `env -i sh -l`.
  local sourceCommand="$1"
  local home expected bad="" shell out
  home=$(test.suite.home.passwd)
  expected="[$home|$home/oosh|$home/config]"
  for shell in sh dash ash bash; do
    command -v "$shell" >/dev/null 2>&1 || continue
    out=$(cd /tmp && env -i HOME="$home" "$shell" -c "$sourceCommand; echo \"[\$HOME|\$OOSH_DIR|\$CONFIG_PATH]\"" 2>&1 | tail -1)
    [ "$out" = "$expected" ] || bad="$bad $shell=>$out"
  done
  if command -v busybox >/dev/null 2>&1; then
    out=$(cd /tmp && env -i HOME="$home" busybox ash -c "$sourceCommand; echo \"[\$HOME|\$OOSH_DIR|\$CONFIG_PATH]\"" 2>&1 | tail -1)
    [ "$out" = "$expected" ] || bad="$bad busybox-ash=>$out"
  fi
  # SOURCED, never executed: the calling shell must survive it.
  out=$(cd /tmp && env -i HOME="$home" sh -c "$sourceCommand; echo STILL-HERE" 2>&1 | tail -1)
  [ "$out" = "STILL-HERE" ] || bad="$bad shell-did-not-survive=>$out"
  echo "$bad"
}

test.suite.anchors.check.completion.sourceCommand() {
  # The two source commands every caller uses; a fixture path is typed freely.
  echo ". \"\$HOME/config/user.env\""
  echo ". /etc/profile.d/oosh.sh"
}

test.suite.fixture.make() # <?label:caller> # a fresh temp directory, CANONICALISED so a resolved path compares equal on macOS too; echoes the directory
{
  # NO create.result — a getter consumed as $(...), which runs in a subshell,
  # so RESULT could never reach the caller. Same exemption as the other getters
  # in this file.
  #
  # WHY canonicalise. On macOS /tmp is a symlink to /private/tmp, and $TMPDIR
  # lives under /var/folders which is reached the same way. A fixture path
  # handed to code that RESOLVES it — private.this.path.canonical, `git
  # worktree`, `cd … && pwd -P` — comes back carrying the /private prefix, so a
  # comparison against the raw mktemp path can never succeed. EIGHT assertions
  # on a clean Sequoia install failed for that reason and no other.
  #
  # $TMPDIR on macOS also ends in a slash, so "${TMPDIR}/x" yields "…//x" —
  # which is what made ssh.backup.list report paths its own caller could not
  # match. Canonicalising collapses that too: one cause, two symptoms.
  #
  # On Linux this is a NO-OP (/tmp is a real directory), so converting a test
  # cannot change how it behaves here — measured before converting any.
  #
  # private.this.path.canonical, not `readlink -f`: GNU readlink's -f is absent
  # on BSD. templates/code/newPlatformInvariantTest names this helper for
  # exactly this reason.
  local label="${1:-${0##*/}}"
  local dir
  dir=$(mktemp -d "${TMPDIR:-/tmp}/${label}.XXXXXX") || return 1
  private.this.path.canonical "$dir"
}

test.suite.fixture.make.completion.label() { echo "${0##*/}"; }
test.suite.config.isolate() # <?label:caller> # point the config anchors at a fresh temp dir so a production `config save` in this file cannot rewrite the shared tier; prints the fixture dir
{
  # $CONFIG_PATH is normally ~/config, a SITE-WIDE sharedConfig that every user
  # sources at login. A test that reaches `config save` rewrites it for
  # everybody. Call this before sourcing the script under test.
  #
  # All FOUR moves are required, and the last one is not tidiness:
  # config.start re-runs config.init whenever $CONFIG is not a FILE, and
  # config.init then does an unconditional `export CONFIG_PATH=~/config`. So
  # setting the path alone is not isolation — the next `source $OOSH_DIR/config`
  # silently snaps back to the shared dir while this file believes it is safe.
  local label="${1:-${0##*/}}"
  # Consumed. create.result's third argument below must be the NEXT command's
  # token for this.start's chaining protocol — passing the label there would
  # make `test.suite config.isolate test.log` re-dispatch "test.log" as a command.
  [ -n "$1" ] && shift
  local fixture
  if ! fixture=$(mktemp -d "${TMPDIR:-/tmp}/${label}.config.XXXXXX"); then
    create.result 1 "mktemp -d failed under ${TMPDIR:-/tmp} — cannot isolate, refusing to run against the shared tier"
    error.log "$RESULT"
    return $(result)
  fi

  # Both pinned before the move and never re-derived, so an early exit or a
  # missing teardown cannot send the score into the fixture where the runner
  # would never find it, nor leave CONFIG_PATH pointing at the fixture.
  : ${TEST_SUITE_RESULT_PATH:=${CONFIG_PATH:-$HOME/config}}
  : ${TEST_SUITE_CONFIG_ORIGIN:=${CONFIG_PATH:-$HOME/config}}
  export TEST_SUITE_RESULT_PATH TEST_SUITE_CONFIG_ORIGIN
  TEST_SUITE_CONFIG_FIXTURE="$fixture"
  export TEST_SUITE_CONFIG_FIXTURE
  # Fingerprint the inherited tier now, so test.suite.save.results can prove
  # this file did not write it.
  #
  # What this catches: a write that ESCAPES the fixture — a hardcoded
  # ~/config path, or $HOME/config, which moving CONFIG_PATH does not
  # redirect. That is exactly the shape test.log's T23 and T31 had.
  # What it does NOT catch: removal of the isolate call itself, since the
  # stamp is set by the same call. The canary in test.test.suite covers that
  # case and is the authoritative proof.
  TEST_SUITE_CONFIG_STAMP=$(private.test.suite.config.stamp.get "$TEST_SUITE_CONFIG_ORIGIN")
  export TEST_SUITE_CONFIG_STAMP

  export CONFIG_PATH="$fixture"   # config-path-exception: a test fixture, not a shell anchor — the point is that this file's production calls land here instead of the site-wide ~/config. Restored by test.suite.config.restore.
  export CONFIG_FILE="user.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  : > "$CONFIG"                   # config.start's `-f $CONFIG` guard; see above
  : > "$CONFIG_PATH/result.env"   # `result save` / path:private.update.config read it
  : > "$CONFIG_PATH/error.txt"    # what config.init would have touched
  mkdir -p "$CONFIG_PATH/stateMachines"

  # SEED the fixture from the tier this file inherited, so READS still answer
  # what they answered before and only WRITES are diverted. An empty fixture is
  # not isolation, it is a different machine: test.config went looking for
  # $OOSH_PM, found nothing, and reached oo.pm.discover — which runs a real
  # `sudo apt-get update` and sat on a password prompt. Overwrites $CONFIG,
  # which is fine: user.env is the chain header, and the `: >` above exists
  # only to satisfy config.start's `-f` guard before this point.
  # EVERY .env, not just the three the guard fingerprints. Seeding only
  # user/oosh/log left test.config without os.commands.env, so sourcing `user`
  # ran private.user.init's cache-miss branch → `oo pm.discover` → a real
  # `sudo apt-get update`, sitting on a password prompt. The tier's other
  # files — os.commands.env, the colour set, lineFormat.env, the hivemind
  # registries — are read by production code the same way.
  local seedFile
  for seedFile in "$TEST_SUITE_CONFIG_ORIGIN"/*.env; do
    [ -f "$seedFile" ] && cp "$seedFile" "$CONFIG_PATH/" 2>/dev/null
  done

  # Chain, never clobber, an EXIT trap the caller already installed.
  local priorTrap; priorTrap=$(trap -p EXIT | sed "s/^trap -- '//;s/' EXIT$//")
  if [ -n "$priorTrap" ]; then
    trap "test.suite.config.restore; $priorTrap" EXIT
  else
    trap 'test.suite.config.restore' EXIT
  fi

  # Loud postcondition. A half-isolated file is worse than an un-isolated one:
  # it writes the shared tier and nobody is watching any more.
  if [ "$CONFIG_PATH" = "$TEST_SUITE_CONFIG_ORIGIN" ] || [ ! -f "$CONFIG" ]; then
    create.result 1 "isolation FAILED (CONFIG_PATH=$CONFIG_PATH CONFIG=$CONFIG)"
    # Bare echo, not error.log: this tells the caller its file is about to
    # write the site-wide tier, and error.log routes to $LOG_DEVICE, which in
    # a capture or a non-tty CI run swallows it. Bare-echo doctrine.
    echo -e "\e[1;31m  ✗ test.suite.config.isolate: $RESULT\e[0m" >&2
    return $(result)
  fi
  # Both channels, as private.ossh.get.key.name does: $RESULT for a sourced
  # caller, stdout for $(...) — the docstring promises the path either way.
  create.result 0 "$fixture" "$1"
  echo "$fixture"
  return $(result)
}

private.test.suite.config.stamp.get() # <configPath> # fingerprint of exactly the three files a no-arg `config save` rewrites, for the isolation self-check
{
  # NO create.result — a getter consumed as $(...), same subshell reasoning as
  # private.test.suite.results.file.get.
  #
  # Scoped to user.env/oosh.env/log.env: those are what the no-arg config.save
  # cascade rewrites. result.env, testresult.env and result.txt are written by
  # the framework itself and would make this fire on every run.
  local dir="$1" f
  for f in user.env oosh.env log.env; do
    if [ ! -f "$dir/$f" ]; then
      echo "$f ABSENT"
      continue
    fi
    # CONTENT ONLY — cksum, which already reports the byte count, read from
    # stdin so no filename appears in the output.
    #
    # Deliberately NOT mtime. The tier is owned by developking and only
    # group-writable, so a test user can rewrite a file's CONTENT but cannot
    # set its mtime back: `cp -p` needs ownership for utimensat. Stamping the
    # mtime meant one genuine write left every later file permanently
    # mismatched, and the alpine platform run reported fourteen consecutive
    # "offenders" that had touched nothing. Content is also the only thing
    # that can harm another user: a byte-identical rewrite changes nothing.
    echo "$f $(cksum < "$dir/$f" 2>/dev/null)"
  done
}

private.test.suite.results.dir.open() # # give this run a private directory for the handoff and the shared-tier snapshot, so two users running tests at once cannot clobber each other; runner-only
{
  # The handoff used to land in $CONFIG_PATH — a SHARED sharedConfig. Two runs
  # by different users overwrote each other's scores, and
  # private.test.suite.results.clear still carries the branch for "another
  # user's file is unlinkable" that this makes unreachable.
  if [ -z "$TEST_SUITE_RESULT_PATH_DEFAULTED" ]; then
    # Somebody chose the value on purpose (the meta-test pins its own fixture).
    create.result 0 "using the caller's $TEST_SUITE_RESULT_PATH"
    return $(result)
  fi
  local dir
  if ! dir=$(mktemp -d "${TMPDIR:-/tmp}/oosh.test.suite.XXXXXX"); then
    create.result 1 "mktemp -d failed under ${TMPDIR:-/tmp} — refusing to put the score back in the shared tier"
    # Bare echo: this decides where every score for the rest of the run goes,
    # and error.log routes to $LOG_DEVICE, which a capture or a non-tty CI run
    # swallows. Same doctrine as private.test.suite.results.clear.
    echo -e "\e[1;31m  ✗ test.suite: $RESULT\e[0m" >&2
    return $(result)
  fi
  TEST_SUITE_RESULT_PATH="$dir"
  unset TEST_SUITE_RESULT_PATH_DEFAULTED
  export TEST_SUITE_RESULT_PATH
  # NOT exported, deliberately. This says "THIS process created the directory",
  # so it must not reach a child. A nested runner — test.test.suite drives
  # `test.suite run` as a subprocess — would otherwise inherit the flag and
  # delete its parent's directory on close, taking the parent's whole score
  # with it. Caught by T-SHARED-CANARY-RUNNER reporting 0 / 0 for this file.
  TEST_SUITE_RESULT_PATH_OWNED="$dir"
  create.result 0 "$dir"
  return $(result)
}

private.test.suite.results.dir.close() # # remove the per-run directory, but only if this process created it; runner-only
{
  if [ -z "$TEST_SUITE_RESULT_PATH_OWNED" ]; then
    # Nothing to undo is a legitimate outcome, not a failure — the caller may
    # have pinned its own directory, which is theirs to remove.
    create.result 0 "nothing to remove"
    return $(result)
  fi
  rm -rf "$TEST_SUITE_RESULT_PATH_OWNED" 2>/dev/null
  create.result 0 "removed $TEST_SUITE_RESULT_PATH_OWNED"
  unset TEST_SUITE_RESULT_PATH_OWNED
  return $(result)
}

private.test.suite.shared.snapshot() # # copy the inherited config tier aside and pin its fingerprint, so a test file that rewrites it can be named and the damage undone; runner-only
{
  # This is the guard test.suite.config.isolate cannot be: isolation is opt-in,
  # so it never sees a file that forgot the line, and it only redirects writes
  # addressed through $CONFIG_PATH. test/test.log's T31 wrote the real shared
  # log.env through a hardcoded $HOME/config path while the file believed
  # itself isolated (f9c3802). A fingerprint catches the write whatever route
  # it took.
  local snap="$TEST_SUITE_RESULT_PATH/sharedTier"
  if ! mkdir -p "$snap" 2>/dev/null; then
    create.result 1 "cannot create $snap — the shared tier would be unguarded for this whole run"
    echo -e "\e[1;31m  ✗ test.suite: $RESULT\e[0m" >&2
    return $(result)
  fi
  local f
  for f in user.env oosh.env log.env; do
    [ -f "$TEST_SUITE_CONFIG_ORIGIN/$f" ] && cp "$TEST_SUITE_CONFIG_ORIGIN/$f" "$snap/$f" 2>/dev/null
  done
  TEST_SUITE_SHARED_SNAPSHOT="$snap"
  TEST_SUITE_SHARED_STAMP=$(private.test.suite.config.stamp.get "$TEST_SUITE_CONFIG_ORIGIN")
  export TEST_SUITE_SHARED_SNAPSHOT TEST_SUITE_SHARED_STAMP
  create.result 0 "snapshotted $TEST_SUITE_CONFIG_ORIGIN to $snap"
  return $(result)
}

private.test.suite.shared.verify() # <testFile> # rc 1 and $RESULT naming which shared file <testFile> rewrote; runner-only, call it after every child
{
  local testFile="${1:-an unnamed test file}"
  if [ -z "$TEST_SUITE_SHARED_STAMP" ]; then
    # No snapshot pinned means no claim to make. Not a failure — test.suite.run
    # is also reachable before the runner has opened its directory.
    create.result 0 "no snapshot pinned"
    return $(result)
  fi
  local nowStamp; nowStamp=$(private.test.suite.config.stamp.get "$TEST_SUITE_CONFIG_ORIGIN")
  if [ "$nowStamp" = "$TEST_SUITE_SHARED_STAMP" ]; then
    create.result 0 "shared tier untouched"
    return $(result)
  fi
  # Name the files, not just the fact. awk with an exact first-field match —
  # `grep "^user.env "` would treat the dot as a wildcard.
  local changed="" f before after
  for f in user.env oosh.env log.env; do
    before=$(printf '%s\n' "$TEST_SUITE_SHARED_STAMP" | awk -v k="$f" '$1==k')
    after=$(printf '%s\n' "$nowStamp" | awk -v k="$f" '$1==k')
    [ "$before" != "$after" ] && changed="$changed $f"
  done
  create.result 1 "$testFile wrote the shared config tier:$changed"
  return $(result)
}

private.test.suite.shared.restore() # # put the snapshotted config tier back, byte for byte; runner-only, call it after private.test.suite.shared.verify reports a write
{
  # Not suppression: the run has already been failed by the caller. The tier is
  # site-wide, so leaving one test file's damage in place would break every
  # other user on the box until someone noticed.
  local snap="$TEST_SUITE_SHARED_SNAPSHOT"
  if [ -z "$snap" ] || [ ! -d "$snap" ]; then
    create.result 1 "no snapshot to restore from"
    return $(result)
  fi
  local f rc=0
  for f in user.env oosh.env log.env; do
    if [ -f "$snap/$f" ]; then
      # Plain cp, not -p. The tier is owned by developking and merely
      # group-writable, so a test user can restore the CONTENT but not the
      # timestamps; `cp -p` would fail on utimensat and report the whole
      # restore as broken. The fingerprint is content-only for the same reason.
      cp "$snap/$f" "$TEST_SUITE_CONFIG_ORIGIN/$f" 2>/dev/null || rc=1
    elif [ -f "$TEST_SUITE_CONFIG_ORIGIN/$f" ]; then
      # It was absent when we snapshotted, so the test file created it.
      rm -f "$TEST_SUITE_CONFIG_ORIGIN/$f" 2>/dev/null || rc=1
    fi
  done
  if [ "$rc" -ne 0 ]; then
    create.result 1 "could not put $TEST_SUITE_CONFIG_ORIGIN back — it is left as the test file wrote it"
    return $(result)
  fi
  create.result 0 "$TEST_SUITE_CONFIG_ORIGIN restored"
  return $(result)
}

private.test.suite.verdict() # <sharedWrites> <noResults> <category> <expects> <passed> <?metaFailures:-> # the suite's pass/fail rule as one decision; rc 0 pass, rc 1 fail, $RESULT is the reason
{
  # Extracted from the tail of private.test.suite.run.filtered, where it was a
  # twenty-line if/elif chain no test could reach — which is how two failure
  # causes came to be displayed and then dropped on the floor before the
  # return code. The macOS workflow and `os platform.test` gate on that return
  # code (macos-test.yml Test Summary; os.platform.test's four rcs), so a
  # cause that does not reach it does not exist.
  local sharedWrites="${1:-0}" noResults="${2:-0}" category="$3"
  local expects="${4:-0}" passed="${5:-0}" metaFailures="$6"
  local failed=$((expects - passed))

  if [ "$sharedWrites" -gt 0 ]; then
    create.result 1 "the shared config tier was written during this run"
    return $(result)
  fi
  # core only: the twelve known score-less files are all extended, and giving
  # them a score is content work, not runner work. See tests-that-cannot-fail.
  if [ "$noResults" -gt 0 ] && [ "$category" = "core" ]; then
    create.result 1 "a core test file produced no score of its own"
    return $(result)
  fi
  if [ "$expects" -eq 0 ]; then
    create.result 1 "no tests run"
    return $(result)
  fi
  if [ "$failed" -eq 0 ]; then
    create.result 0 "all tests passed"
    return $(result)
  fi
  # The meta-test asserts one failure on purpose, to prove the counters count.
  if [ "$failed" -eq 1 ] && [ "$metaFailures" = "1" ]; then
    create.result 0 "all tests passed (1 intentional meta-test failure)"
    return $(result)
  fi
  create.result 1 "$failed assertion(s) failed"
  return $(result)
}

test.suite.config.isolate.completion.label() {
  # A free-form mktemp label; callers pass their own basename.
  echo "test.path"
  echo "test.oo"
}

test.suite.config.restore() # # restore the config anchors saved by test.suite.config.isolate and remove the fixture; installed as its EXIT trap, safe to call twice
{
  if [ -z "$TEST_SUITE_CONFIG_FIXTURE" ]; then
    # Nothing to undo is a legitimate outcome, not a failure — the trap fires
    # on every exit, including files that never isolated. Same distinction
    # private.oo.profile.dropin.ensure draws for a host with no /etc/profile.d.
    create.result 0 "nothing to restore"
    return $(result)
  fi
  rm -rf "$TEST_SUITE_CONFIG_FIXTURE" 2>/dev/null
  unset TEST_SUITE_CONFIG_FIXTURE
  # ORIGIN, not RESULT_PATH. They were one variable until 2026-09-16, which was
  # only correct while the score happened to live in the config tier; the
  # moment the handoff moved to its own directory, this line would have left
  # CONFIG_PATH pointing at the handoff.
  export CONFIG_PATH="$TEST_SUITE_CONFIG_ORIGIN"   # config-path-exception: restoring the value this file inherited, captured by test.suite.config.isolate before it moved it.
  export CONFIG_FILE="user.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  create.result 0 "config anchors restored to $CONFIG_PATH"
  return $(result)
}

test.suite.usage() # # displays usage information for test.suite
{
  local this=${0##*/}
  echo "You started
$0

  current log level: $LOG_LEVEL

  current file: $CONFIG
   CONFIG_PATH=$CONFIG_PATH
   CONFIG_FILE=$CONFIG_FILE


  Usage:
  $this: command   description and Parameter
      all       tests all tests in $OOSH_DIR/test
                $this all <log level>  <?clear>
      core      tests core infrastructure tests only
                $this core <log level>  <?clear>
      extended  tests extended feature tests only
                $this extended <log level>  <?clear>
      run       runs a single test: $OOSH_DIR/test/test.<command>
                $this run <command> <log level>  <?clear>

  Categories:
      Tests declare TEST_CATEGORY=core at the top of the file.
      Tests without a category marker default to extended.

  Examples
    $this run loop 5
    $this core 1
    $this extended 1 clear
    $this all 1 clear
  "

  #loop.list PATH print '---------------------: '
}

test.suite.portability.validate()     # <?treeRoot:$OOSH_DIR/test> # verify test-harness code makes no GNU-only or Linux-only assumption; rc 1 and a report on any violation #
{
  # THE RULE: a test may not assume GNU coreutils or a Linux filesystem. When it
  # does, it does not fail honestly — it reports the CODE UNDER TEST as broken
  # while that code is fine, with a confident and specific message that sends
  # you to debug the wrong thing. Three of those on 2026-09-17 alone:
  #
  #   grep '…$\|…$'   `\|` is a GNU BRE extension. BSD grep counted 0 and the
  #                   test blamed user.ssh.backup.list.
  #   raw mktemp path macOS /tmp is a symlink to /private/tmp, so a path the
  #                   code RESOLVES never equals the fixture literal. Eight
  #                   assertions blamed oo.mode, base.get and workspace.init.
  #   script -qec     does not guarantee which shell runs the command. Under
  #                   dash the probe died on `source: not found`, never sourced
  #                   `log`, and blamed log's D4 guard in every container.
  #
  # Sibling of path.validate and this.anchor.validate, and the same shape: ONE
  # scan of the tree, a verdict echoed to stdout so it survives any LOG_LEVEL
  # (the status-output idiom), create.result / return $(result), and a
  # `# portability-exception: <reason>` marker on the line or in the few lines
  # above it for a construct that is deliberate.
  #
  # It differs from its siblings in ONE way, on purpose: it scans TEST code, not
  # production code. Production portability is enforced by running the thing on
  # the platforms (the macOS and container gates). Nothing ran the test harness
  # anywhere new often enough to catch these.
  local treeRoot="${1:-$OOSH_DIR/test}"
  if [ ! -d "$treeRoot" ]; then
    error.log "test.suite.portability.validate: no such directory: $treeRoot"
    echo "INVALID: no such directory: $treeRoot"
    create.result 2 "no such directory: $treeRoot"
    return $(result)
  fi

  # `git grep` sees TRACKED files only, and it can fail to see ANY — an unpacked
  # tarball with no repository, or the "detected dubious ownership" refusal that
  # fires whenever the checkout is owned by a different user than the one
  # running (root in a container against an oosh-user tree, which is exactly the
  # shape `os platform.test` runs in). Both come back as an empty result, and an
  # empty result is indistinguishable from a clean tree: the gate would report
  # OK while having read nothing at all. Prove the sweep can see the files
  # BEFORE trusting that it found no violations in them.
  if [ -z "$(git -C "$treeRoot" ls-files 2>/dev/null | head -1)" ]; then
    error.log "test.suite.portability.validate: git cannot list tracked files under $treeRoot — no repository, or ownership refused. A sweep that reads nothing reports OK, so this is a failure, not a pass."
    echo "INVALID: cannot read $treeRoot through git — no tracked files visible"
    create.result 2 "git sees no tracked files under $treeRoot"
    return $(result)
  fi

  # Each rule is <ERE>@@<severity>@@<why>, severity `violation` or `advisory`.
  #
  # The separator is @@ and not | because several of the patterns contain a
  # pipe, which makes | unusable as a field separator — the first version of
  # this table used | and matched nothing at all, silently.
  #
  # TWO SEVERITIES, because the surface is two different sizes. A `violation` is
  # a construct that is wrong wherever it stands and whose total count in the
  # tree is small enough to fix in one sitting — this sweep ships with all of
  # them at zero, and rc 1 keeps them there. An `advisory` is a construct that
  # is only LATENT: correct today, and wrong the day someone compares its result
  # against a canonicalised path. `mktemp` is the whole of that class, at 82
  # sites. Converting 82 fixtures in the same commit that introduces the guard
  # would be churn with no test behind it, so the sweep MARKS them and the gate
  # stays actionable. Convert one whenever you are in the file anyway:
  # `test.suite.fixture.make <label>` is mktemp + private.this.path.canonical.
  #
  # portability-exception: this is the RULE TABLE, not a use of the constructs
  # it names. A sweep necessarily contains the text it looks for.
  local rules='grep[^@]*\\\|@@violation@@GNU-only backslash-pipe alternation in a BRE; BSD grep has no such thing — use grep -E
readlink -f@@violation@@readlink -f is absent on BSD before macOS 12.3 (it works on Sequoia, measured); use private.this.path.canonical, which carries the fallback
script -qec @@violation@@script does not guarantee which shell runs the command; run it as: bash <file>
(^|[^A-Za-z])grep -P@@violation@@grep -P is GNU-only; use grep -E
stat -c@@violation@@stat -c is GNU-only; pair it with a stat -f fallback
date -d @@violation@@date -d is GNU-only; BSD date uses -v/-j
(^|[|;&(]|\$\()[[:space:]]*sed -i [[:alnum:]]@@violation@@sed -i needs an explicit suffix on BSD; write a temp file and mv, or use replace
(^|[|;&(`]|\$\()[[:space:]]*mktemp@@advisory@@raw mktemp; on macOS /tmp is a symlink to /private/tmp, so the literal never equals a path the code under test resolves — use test.suite.fixture.make'

  local violations=0 advisories=0 checked=0 exceptions=0 advisoryFiles=""
  local rule pattern severity why rest matches match file lineNo content joined trimmed prevLine windowFrom
  while IFS= read -r rule; do
    [ -z "$rule" ] && continue
    pattern="${rule%%@@*}"; rest="${rule#*@@}"; severity="${rest%%@@*}"
    why="${rest#*@@}"
    matches=$(git -C "$treeRoot" grep -nE "$pattern" 2>/dev/null) || matches=""
    while IFS= read -r match; do
      [ -z "$match" ] && continue
      file="${match%%:*}"
      content="${match#*:}"
      lineNo="${content%%:*}"
      content="${content#*:}"
      checked=$((checked + 1))

      # A line that only TALKS about a construct is not a use of it.
      trimmed="${content#"${content%%[![:space:]]*}"}"
      case "$trimmed" in '#'*) exceptions=$((exceptions + 1)); continue ;; esac

      # A GNU/BSD pair is normally written across a continued line:
      #   x=$(stat -c %U f 2>/dev/null \
      #       || stat -f %Su f 2>/dev/null)
      # That is ONE command, so judge it as one — a trailing backslash pulls the
      # next line in. Six correct sites in test.oo, test.osshLayout and
      # test.platform.shared.config.invariant were flagged before this existed.
      joined="$content"
      case "$content" in
        *'\') joined="$content $(sed -n "$((lineNo + 1))p" "$treeRoot/$file" 2>/dev/null)" ;;
      esac

      # Four constructs are correct in a shape the ERE alone cannot express, so
      # they are excused here rather than by a marker in every file:
      #
      #   `grep -E ... \| ...`  under -E a backslash-pipe is an ESCAPED LITERAL
      #                         pipe, which is portable and usually the point.
      #                         Only a BRE grep — no -E — is the fault.
      #   `script -qec "bash …"`  naming the shell IS the fix; only a bare
      #                         command left for `script` to dispatch is the fault.
      #   `stat -c … || stat -f …`   the GNU form with its BSD fallback already
      #   `date -r … || date -d …`   present is the fix, not the fault. Note
      #                         date puts the BSD form FIRST: -r is the portable
      #                         spelling and -d only the GNU fallback.
      case "$pattern" in
        'grep'*) if printf '%s' "$content" | grep -qE 'grep [^|]*-[A-Za-z]*E'; then
                   exceptions=$((exceptions + 1)); continue
                 fi ;;
        'script -qec '*) case "$content" in *'bash '*|*'sh '*) exceptions=$((exceptions + 1)); continue ;; esac ;;
        'stat -c') case "$joined" in *'stat -f'*) exceptions=$((exceptions + 1)); continue ;; esac ;;
        'date -d '*) case "$joined" in *'date -r'*|*'date -v'*|*'date -j'*) exceptions=$((exceptions + 1)); continue ;; esac ;;
      esac

      # Sanctioned: on the line, or in the few lines just above it (these often
      # sit inside a heredoc or a quoted probe where the marker cannot go on the
      # line itself). Anchored to a COMMENT so only a human-written marker
      # counts — otherwise the rule table above would exempt this very function.
      if printf '%s' "$content" | grep -qE '#[[:space:]]*portability-exception:'; then
        exceptions=$((exceptions + 1)); continue
      fi
      prevLine=""
      if [ "$lineNo" -gt 1 ]; then
        windowFrom=$((lineNo - 5))
        [ "$windowFrom" -lt 1 ] && windowFrom=1
        prevLine=$(sed -n "${windowFrom},$((lineNo - 1))p" "$treeRoot/$file" 2>/dev/null)
      fi
      if printf '%s' "$prevLine" | grep -qE '#[[:space:]]*portability-exception:'; then
        exceptions=$((exceptions + 1)); continue
      fi

      if [ "$severity" = "advisory" ]; then
        advisories=$((advisories + 1))
        advisoryFiles="$advisoryFiles$file
"
        continue
      fi
      error.log "test.suite.portability.validate: $file:$lineNo — $why"
      violations=$((violations + 1))
    done <<< "$matches"
  done <<< "$rules"

  # Advisories are reported ONCE, as a per-file tally. One line per site would
  # be 82 lines of noise every run, and noise is how the three faults in the
  # header comment survived in the first place.
  if [ "$advisories" -gt 0 ]; then
    warn.log "test.suite.portability.validate: $advisories latent construct(s) — correct today, wrong the day the value is compared against a resolved path. Convert with test.suite.fixture.make when you are in the file anyway:
$(printf '%s' "$advisoryFiles" | sort | uniq -c | sort -rn)"
  fi

  if [ "$violations" -gt 0 ]; then
    error.log "test.suite.portability.validate: $violations violation(s). A test that assumes GNU or Linux reports the CODE UNDER TEST as broken when it is fine. Fix it, or mark a deliberate one with '# portability-exception: <reason>'"
    echo "INVALID: test portability in $treeRoot — $violations violation(s), $advisories advisory(s), $exceptions exception(s)"
    create.result 1 "test portability: violations found"
    return $(result)
  fi
  echo "OK: test portability in $treeRoot — $checked construct(s) checked, $advisories advisory(s), $exceptions exception(s), 0 violations"
  create.result 0 "test portability: 0 violations"
  return $(result)
}

test.suite.portability.validate.completion.treeRoot() { echo "$OOSH_DIR/test"; }


### new.method

test.suite.init "$@"
