#!/usr/bin/env bash
#clear
#export PS4='\e[90m+${LINENO} in ${#BASH_SOURCE[@]}>${FUNCNAME[0]}:${BASH_SOURCE[@]##*/} \e[0m'
#set -x

test.suite.level()
{
  level=$1
  case $1 in
      ''|*[!0-9]*) 
        level=$3
        ;;
      *) echo test.suite level=$level ;;
  esac
  if [ -z "$level" ]; then
    level=$LOG_LEVEL
  fi
  if [ -z "$level" ]; then
    level=3
  fi
}

test.suite.level $*

echo -e "[96m test.suite starting: $0 <LOG_LEVEL=$level>[0m"
# if [ "$level" -gt "5" ]; then
#     set -x
# fi

test.suite.discover() # # discovers all tests
{
  test.suite.run.completion
}

test.suite.run.completion() # # returns list of available tests for completion
{
  ls $OOSH_DIR/test/* | sed 's/\/.*\/oosh\/test\/\(interactive.\)*test\.//' | grep "^$1"
}

test.suite.parameter.completion.test() {
  test.suite.run.completion
}

test.suite.parameter.completion.logLevel() {
  echo "1"
  echo "2"
  echo "3"
  echo "4"
  echo "5"
}

private.test.suite.category() # <file> # reads TEST_CATEGORY from a test file, defaults to extended
{
  local file="$1"
  local category
  category=$(grep -m1 '^TEST_CATEGORY=' "$file" 2>/dev/null | cut -d= -f2)
  if [ -z "$category" ]; then
    category="extended"
  fi
  create.result 0 "$category"
}

private.test.suite.results.file.get() # # absolute path of the per-file handoff the child writes and the runner reads back as that file's score
{
  # NO create.result here, deliberately. This is a getter consumed as $(...),
  # and a command substitution runs in a SUBSHELL — RESULT and RETURN_VALUE
  # set inside it never reach the caller, so the contract would silently break
  # the value channel. Same reasoning as private.oo.path.sudo.get,
  # test.suite.home.passwd and test.suite.boot.anchors.check, which all answer
  # on stdout for exactly this reason.
  #
  # A default SUBSTITUTION, not an assignment — this.anchor.validate matches
  # `${CONFIG_PATH:=` and plain assignments, and this is neither, so no
  # exception marker is warranted here.
  echo "${TEST_SUITE_RESULT_PATH:-${CONFIG_PATH:-$HOME/config}}/testresult.env"
}

private.test.suite.results.clear() # # remove the handoff file, so the next file cannot be scored with the previous file's numbers
{
  # Runner-only, called between files. It removes the FILE and deliberately
  # does NOT zero the counters — the two were one primitive at first, and
  # calling it wiped the calling file's own running score. Zeroing lives in
  # private.test.suite.counters.reset.
  local resultsFile; resultsFile=$(private.test.suite.results.file.get)
  rm -f "$resultsFile" 2>/dev/null
  if [ -e "$resultsFile" ]; then
    # $CONFIG_PATH is a SHARED sharedConfig (2775, group dev). Another user's
    # file is unlinkable unless the DIRECTORY lost its group-write bit — the
    # state private.os.platform.shared.config.repair exists to fix. Silent
    # failure here silently restores the inheritance bug, so: loud, and via
    # bare echo so the instruction survives any LOG_DEVICE.
    create.result 1 "cannot remove $resultsFile — every score from here on would be inherited"
    echo -e "\e[1;31m  ✗ test.suite: $RESULT\e[0m"
    return $(result)
  fi
  create.result 0 "handoff cleared"
  return $(result)
}

private.test.suite.counters.reset() # # zero the exported per-file counters between files; runner-only, never call this from inside a test file
{
  # Exported, so each child inherits them. The `declare -i` in test.suite.init
  # is function-local and evaporates on return, which is why the file-scope
  # counters in every test file come from the environment rather than from there.
  TEST_SUITE_TEST_COUNTER=0
  TEST_SUITE_EXPECT_COUNTER=0
  TEST_SUITE_SUCCESS_COUNTER=0
  export TEST_SUITE_TEST_COUNTER TEST_SUITE_EXPECT_COUNTER TEST_SUITE_SUCCESS_COUNTER
  create.result 0 "per-file counters reset"
  return $(result)
}

test.suite.save.results() # # writes this file's counters to the handoff the runner reads, then prints the summary
{
  # NOT `source $OOSH_DIR/config; config.save testresult TEST_SUITE`.
  # config.file re-points $CONFIG under whatever CONFIG_PATH is current, so a
  # file that isolated its config would have written its score into its own
  # fixture and the runner would have re-read the PREVIOUS file's numbers.
  # Three literal lines, one destination, and no config.start — which used to
  # run at the tail of every test file and could re-fire config.init.
  # Isolation self-check, BEFORE the counters are written so it is scored.
  # Only files that called test.suite.config.isolate carry a stamp.
  if [ -n "$TEST_SUITE_CONFIG_STAMP" ]; then
    local nowStamp; nowStamp=$(private.test.suite.config.stamp.get "$TEST_SUITE_RESULT_PATH")
    if [ "$nowStamp" = "$TEST_SUITE_CONFIG_STAMP" ]; then
      expect.pass "shared config tier untouched ($TEST_SUITE_RESULT_PATH)"
    else
      expect.fail "this file WROTE the shared config tier — before[$TEST_SUITE_CONFIG_STAMP] after[$nowStamp]"
    fi
  fi

  local resultsFile; resultsFile=$(private.test.suite.results.file.get)
  {
    echo "export TEST_SUITE_TEST_COUNTER=\"${TEST_SUITE_TEST_COUNTER:-0}\""
    echo "export TEST_SUITE_EXPECT_COUNTER=\"${TEST_SUITE_EXPECT_COUNTER:-0}\""
    echo "export TEST_SUITE_SUCCESS_COUNTER=\"${TEST_SUITE_SUCCESS_COUNTER:-0}\""
  } > "$resultsFile"

  # Print final summary
  test.suite.summary
}

test.suite.summary() # # prints test summary with pass/fail counts
{
  local total=${TEST_SUITE_EXPECT_COUNTER:-0}
  local passed=${TEST_SUITE_SUCCESS_COUNTER:-0}
  local failed=$((total - passed))

  echo ""
  echo -e "\e[1;37m════════════════════════════════════════════════════════════════════\e[0m"
  echo -e "\e[1;37m                         TEST SUMMARY                               \e[0m"
  echo -e "\e[1;37m════════════════════════════════════════════════════════════════════\e[0m"
  echo ""
  echo -e "  Test Cases:  \e[1;37m$TEST_SUITE_TEST_COUNTER\e[0m"
  echo -e "  Assertions:  \e[1;37m$total\e[0m"
  echo -e "  Passed:      \e[1;32m$passed\e[0m"
  if [ "$failed" -gt 0 ]; then
    echo -e "  Failed:      \e[1;31m$failed\e[0m"
  else
    echo -e "  Failed:      \e[1;32m0\e[0m"
  fi
  echo ""

  if [ "$passed" -eq "$total" ] && [ "$total" -gt 0 ]; then
    echo -e "  \e[1;32m✓ ALL TESTS PASSED\e[0m"
  elif [ "$total" -eq 0 ]; then
    echo -e "  \e[1;33m⚠ NO TESTS RUN\e[0m"
  else
    echo -e "  \e[1;31m✗ SOME TESTS FAILED\e[0m"
  fi
  echo ""
  echo -e "\e[1;37m════════════════════════════════════════════════════════════════════\e[0m"
}

test.suite.init() # # initializes test suite counters and environment
{
  source this
  source log
  log.init.colors


  if [ -z "$TEST_COUNTER" ]; then
    if [ -t 1 ] && [ -w "$(tty 2>/dev/null)" ]; then
      export LOG_DEVICE="$(tty)"
    elif [ -w /proc/self/fd/1 ]; then
      export LOG_DEVICE=/proc/self/fd/1
    else
      export LOG_DEVICE=/dev/null
    fi
    declare -i TEST_SUITE_TEST_COUNTER=0
    declare -i TEST_SUITE_EXPECT_COUNTER=0
    declare -i TEST_SUITE_SUCCESS_COUNTER=0
    export SUITE_RESULT="Suite Result: "
  fi

  # Pin where this file's score goes, BEFORE anything can move the anchors.
  # `:=` on an exported variable means the runner's value wins in every child
  # (test files are exec'd, not sourced), so parent and child resolve the same
  # handoff path by construction rather than by convention — even when a file
  # isolates its config with test.suite.config.isolate.
  : ${TEST_SUITE_RESULT_PATH:=${CONFIG_PATH:-$HOME/config}}
  export TEST_SUITE_RESULT_PATH

  # Initialize expected error tracking
  export TEST_EXPECTING_ERROR=0
  export TEST_EXPECTED_ERROR_CODE=0

  if (this.isSourced); then
    debug.log "test.suite sourced"
    if [ "$2" = "clear" ]; then
      clear
    fi
    export PS4='\e[90m  ${BASH_SOURCE[0]##*/} -> ${BASH_SOURCE[1]##*/}: ${FUNCNAME[0]}:${LINENO}   - ${BASH_SOURCE[@]##*/} \e[0m'
    if [ "$LOG_LEVEL" -gt "5" ]; then
        set -x
    fi
  else
    #important.log "test.suite started"
    this.start "$@"
  fi
}

test.suite.run() # <test> <?logLevel:1> # runs a test from the test folder
{
  local command=$1
  shift
  local level=$1
  shift
  local clear=$1
  shift

  if [ -z "$level" ]; then
    level=1
  fi

  # Print test header
  echo ""
  echo -e "\e[1;36m╔════════════════════════════════════════════════════════════════════╗\e[0m"
  echo -e "\e[1;36m║  RUNNING TEST: test.$command\e[0m"
  echo -e "\e[1;36m╚════════════════════════════════════════════════════════════════════╝\e[0m"
  echo ""

  # Same pre-clear as the filtered runner: after this line the handoff exists
  # if and only if THIS file wrote it.
  private.test.suite.results.clear
  private.test.suite.counters.reset

  if [ "$level" -gt 0 ]; then
    important.log "starting test: $OOSH_DIR/test/test.$command -level:$level- -clear:$clear-"
    $OOSH_DIR/test/test.$command $level $clear
  else
    $OOSH_DIR/test/test.$command $level $clear >/dev/null
  fi

  local resultsFile; resultsFile=$(private.test.suite.results.file.get)
  if check file "$resultsFile" exists; then
    source "$resultsFile"
  else
    # Previously this left the counters EMPTY (the reset sat inside the `if`),
    # so the comparison below became `[ "" -eq "" ]` → "integer expression
    # expected" on a clean box, or the previous file's numbers otherwise.
    private.test.suite.counters.reset
    echo -e "\e[1;33m  ⚠ NO RESULTS: test.$command produced no score of its own — 0 / 0\e[0m"
  fi

  # Print results
  echo ""
  echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"
  echo -e "  Completed: \e[1;37mtest.$command\e[0m"
  echo -e "  Results:   \e[1;32m$TEST_SUITE_SUCCESS_COUNTER\e[0m / $TEST_SUITE_EXPECT_COUNTER assertions passed"
  echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"

  if [ "$TEST_SUITE_SUCCESS_COUNTER" -eq "$TEST_SUITE_EXPECT_COUNTER" ]; then
    echo -e "\e[1;32m  ✓ All tests successful\e[0m"
    return 0
  else
    echo -e "\e[1;31m  ✗ Some tests failed\e[0m"
    return 1
  fi
}

private.test.suite.run.filtered() # <level> <clear> <?category> # runs tests matching category filter
{
  local level=$1
  local clear=$2
  local categoryFilter=$3

  # Initialize cumulative counters
  local -i CUMULATIVE_TEST_COUNTER=0
  local -i CUMULATIVE_EXPECT_COUNTER=0
  local -i CUMULATIVE_SUCCESS_COUNTER=0
  local -i FILE_COUNT=0
  # Files that produced no score of their own. Tracked separately from
  # TOTAL_FAILED on purpose: that number is assertion arithmetic and feeds
  # GITHUB_OUTPUT failed=, where a workflow reads it as "assertions that
  # failed". A file with 0 expects has 0 failures.
  local -i NO_RESULT_COUNT=0
  local NO_RESULT_FILES=""

  # Count total files matching filter
  local -i TOTAL_FILES=0
  for file in $OOSH_DIR/test/test.*; do
    [ -d "$file" ] && continue
    if [ -n "$categoryFilter" ]; then
      private.test.suite.category "$file"
      [ "$RESULT" != "$categoryFilter" ] && continue
    fi
    ((TOTAL_FILES++))
  done

  # Track intentional failures from meta-test (test.test.suite)
  local -i META_TEST_FAILURES=0
  local META_TEST_RAN=0

  # Print suite header
  local headerLabel="ALL TESTS"
  if [ -n "$categoryFilter" ]; then
    headerLabel="${categoryFilter^^} TESTS"
  fi

  echo ""
  echo -e "\e[1;35m╔════════════════════════════════════════════════════════════════════╗\e[0m"
  echo -e "\e[1;35m║                    RUNNING $headerLabel\e[0m"
  echo -e "\e[1;35m║                    Log Level: $level                                       ║\e[0m"
  echo -e "\e[1;35m╚════════════════════════════════════════════════════════════════════╝\e[0m"

  for file in $OOSH_DIR/test/test.*
  do
    # Skip test.data directory
    if [ -d "$file" ]; then
      continue
    fi

    # Apply category filter
    if [ -n "$categoryFilter" ]; then
      private.test.suite.category "$file"
      [ "$RESULT" != "$categoryFilter" ] && continue
    fi

    ((FILE_COUNT++))
    local filename=$(basename "$file")

    # Print test file header
    echo ""
    echo -e "\e[1;36m╔════════════════════════════════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;36m║  [$FILE_COUNT/$TOTAL_FILES] $filename\e[0m"
    echo -e "\e[1;36m╚════════════════════════════════════════════════════════════════════╝\e[0m"

    # Clear the handoff BEFORE the run: after this line the file exists if and
    # only if THIS file wrote it. The old code cleared only the shell VARIABLES
    # and left the file behind, so a file that never called
    # test.suite.save.results was silently scored with the previous file's
    # numbers — test.tilde reporting test.this's 31 assertions was the instance
    # that exposed it.
    private.test.suite.results.clear
    private.test.suite.counters.reset

    # Run the test file (subprocess — counters don't propagate back)
    if [ "$level" -gt 0 ]; then
      $file $level $clear
    else
      $file $level $clear >/dev/null
    fi

    # Load per-file results saved by test.suite.save.results in the subprocess
    local FILE_TESTS=0 FILE_EXPECTS=0 FILE_SUCCESS=0
    local resultsFile; resultsFile=$(private.test.suite.results.file.get)
    if check file "$resultsFile" exists; then
      source "$resultsFile"
      FILE_TESTS=${TEST_SUITE_TEST_COUNTER:-0}
      FILE_EXPECTS=${TEST_SUITE_EXPECT_COUNTER:-0}
      FILE_SUCCESS=${TEST_SUITE_SUCCESS_COUNTER:-0}
    else
      ((NO_RESULT_COUNT++))
      NO_RESULT_FILES="$NO_RESULT_FILES $filename"
      echo -e "\e[1;33m  ⚠ NO RESULTS: $filename produced no score of its own — reported 0 / 0, NOT the previous file's numbers\e[0m"
    fi
    # Clear again so the suite never leaves a stale score in the shared dir
    # between invocations.
    private.test.suite.results.clear
    private.test.suite.counters.reset
    local FILE_FAILED=$((FILE_EXPECTS - FILE_SUCCESS))

    # Track meta-test (test.test.suite) failures separately
    # This test has 1 INTENTIONAL failure to verify counter logic works
    if [ "$filename" = "test.test.suite" ]; then
      META_TEST_RAN=1
      META_TEST_FAILURES=$FILE_FAILED
    fi

    # Accumulate cumulative counters from per-file results
    ((CUMULATIVE_TEST_COUNTER += FILE_TESTS))
    ((CUMULATIVE_EXPECT_COUNTER += FILE_EXPECTS))
    ((CUMULATIVE_SUCCESS_COUNTER += FILE_SUCCESS))

    # Show per-file summary only if LOG_LEVEL > 1
    if [ "$level" -gt 1 ]; then
      echo ""
      echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"
      echo -e "  File: \e[1;37m$filename\e[0m"
      echo -e "  Results: \e[1;32m$FILE_SUCCESS\e[0m / $FILE_EXPECTS assertions"
      if [ "$FILE_SUCCESS" -eq "$FILE_EXPECTS" ] && [ "$FILE_EXPECTS" -gt 0 ]; then
        echo -e "  \e[1;32m✓ PASS\e[0m"
      elif [ "$FILE_EXPECTS" -eq 0 ]; then
        echo -e "  \e[1;33m⚠ NO ASSERTIONS\e[0m"
      elif [ "$filename" = "test.test.suite" ] && [ "$FILE_FAILED" -eq 1 ]; then
        echo -e "  \e[1;32m✓ PASS (1 intentional failure - meta-test working correctly)\e[0m"
      else
        echo -e "  \e[1;31m✗ FAIL ($FILE_FAILED failed)\e[0m"
      fi
      echo -e "\e[1;37m────────────────────────────────────────────────────────────────────\e[0m"
    fi
  done

  # Print final overall summary (always shown)
  local TOTAL_FAILED=$((CUMULATIVE_EXPECT_COUNTER - CUMULATIVE_SUCCESS_COUNTER))

  # Check if the ONLY failure is the intentional one from test.test.suite
  local ONLY_INTENTIONAL_FAILURE=0
  if [ "$META_TEST_RAN" -eq 1 ] && [ "$META_TEST_FAILURES" -eq 1 ] && [ "$TOTAL_FAILED" -eq 1 ]; then
    ONLY_INTENTIONAL_FAILURE=1
  fi

  echo ""
  echo -e "\e[1;35m╔════════════════════════════════════════════════════════════════════╗\e[0m"
  echo -e "\e[1;35m║                    FINAL ${headerLabel} SUMMARY\e[0m"
  echo -e "\e[1;35m╚════════════════════════════════════════════════════════════════════╝\e[0m"
  echo ""
  echo -e "  Test Files:  \e[1;37m$FILE_COUNT\e[0m"
  echo -e "  Test Cases:  \e[1;37m$CUMULATIVE_TEST_COUNTER\e[0m"
  echo -e "  Assertions:  \e[1;37m$CUMULATIVE_EXPECT_COUNTER\e[0m"
  echo -e "  Passed:      \e[1;32m$CUMULATIVE_SUCCESS_COUNTER\e[0m"
  if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
    echo -e "  Failed:      \e[1;32m1 (intentional meta-test)\e[0m"
  elif [ "$TOTAL_FAILED" -gt 0 ]; then
    echo -e "  Failed:      \e[1;31m$TOTAL_FAILED\e[0m"
  else
    echo -e "  Failed:      \e[1;32m0\e[0m"
  fi
  if [ "$NO_RESULT_COUNT" -gt 0 ]; then
    echo -e "  \e[1;33mNo results:  $NO_RESULT_COUNT file(s) never called test.suite.save.results:\e[0m$NO_RESULT_FILES"
  fi
  echo ""

  # GitHub Actions Job Summary (only when running in GHA)
  if [ -n "$GITHUB_STEP_SUMMARY" ]; then
    local ghaWho="User"
    [ "$(id -u)" = "0" ] && ghaWho="Root"
    local ghaFailed="$TOTAL_FAILED"
    local ghaStatus="✅ ALL TESTS PASSED"
    if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
      ghaStatus="✅ ALL TESTS PASSED (1 intentional meta-test)"
    elif [ "$TOTAL_FAILED" -gt 0 ]; then
      ghaStatus="❌ $TOTAL_FAILED TESTS FAILED"
    fi
    {
      echo "### ${ghaWho} Tests"
      echo ""
      echo "| Metric | Count |"
      echo "|--------|------:|"
      echo "| Test Files | $FILE_COUNT |"
      echo "| Test Cases | $CUMULATIVE_TEST_COUNTER |"
      echo "| Assertions | $CUMULATIVE_EXPECT_COUNTER |"
      echo "| Passed | $CUMULATIVE_SUCCESS_COUNTER |"
      echo "| Failed | $ghaFailed |"
      echo ""
      echo "> $ghaStatus"
      echo ""
    } >> "$GITHUB_STEP_SUMMARY"
  fi

  # Write fail count for workflow-level summary
  if [ -n "$GITHUB_OUTPUT" ]; then
    if [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
      echo "failed=0" >> "$GITHUB_OUTPUT"
    else
      echo "failed=$TOTAL_FAILED" >> "$GITHUB_OUTPUT"
    fi
  fi

  if [ "$CUMULATIVE_SUCCESS_COUNTER" -eq "$CUMULATIVE_EXPECT_COUNTER" ] && [ "$CUMULATIVE_EXPECT_COUNTER" -gt 0 ]; then
    echo -e "  \e[1;32m✓ ALL TESTS PASSED\e[0m"
    return 0
  elif [ "$CUMULATIVE_EXPECT_COUNTER" -eq 0 ]; then
    echo -e "  \e[1;33m⚠ NO TESTS RUN\e[0m"
    return 1
  elif [ "$ONLY_INTENTIONAL_FAILURE" -eq 1 ]; then
    echo -e "  \e[1;32m╔══════════════════════════════════════════════════════════════════╗\e[0m"
    echo -e "  \e[1;32m║  ✓ ALL TESTS PASSED                                              ║\e[0m"
    echo -e "  \e[1;32m║    (1 intentional failure in test.test.suite verifies counters)  ║\e[0m"
    echo -e "  \e[1;32m╚══════════════════════════════════════════════════════════════════╝\e[0m"
    return 0
  else
    echo -e "  \e[1;31m✗ SOME TESTS FAILED\e[0m"
    return 1
  fi
}

test.suite.all() # <?logLevel:1> # runs all tests from the test folder
{
  local level=$1
  if [ -z "$level" ]; then
    level=1
  fi
  shift
  local clear=$1
  shift

  private.test.suite.run.filtered "$level" "$clear" ""
}

test.suite.core() # <?logLevel:1> # runs core infrastructure tests
{
  local level=$1
  if [ -z "$level" ]; then
    level=1
  fi
  shift
  local clear=$1
  shift

  private.test.suite.run.filtered "$level" "$clear" "core"
}

test.suite.extended() # <?logLevel:1> # runs extended feature tests
{
  local level=$1
  if [ -z "$level" ]; then
    level=1
  fi
  shift
  local clear=$1
  shift

  private.test.suite.run.filtered "$level" "$clear" "extended"
}

test.case() # <logLevel:-> <testName> <testFunction> <testArguments> # runs a test case and captures result
{
  ((TEST_SUITE_TEST_COUNTER++))

  local level=$1
  shift
  export testName=$1
  shift
  local testFunction="$1"
  shift
  local testArguments="$@"

  if ! [ "$level" = "-" ]; then
    log.level $level
  fi
  if [ "$LOG_LEVEL" -gt "5" ]; then
      set -x
  fi

  # Print test case header
  echo ""
  echo -e "\e[1;37m┌──────────────────────────────────────────────────────────────────┐\e[0m"
  echo -e "\e[1;37m│ Test $TEST_SUITE_TEST_COUNTER: $testName\e[0m"
  echo -e "\e[1;37m└──────────────────────────────────────────────────────────────────┘\e[0m"

  if [ "$LOG_LEVEL" -gt "2" ]; then
    echo -e "\e[90m  → $testFunction $testArguments\e[0m"
  fi

  # Check if we're expecting an error
  if [ "$TEST_EXPECTING_ERROR" -eq 1 ]; then
    # Capture stderr and suppress error output for expected errors
    {
      $testFunction $testArguments
      RETURN_VALUE=$?
    } 2>/dev/null

    if [ "$RETURN_VALUE" -eq "$TEST_EXPECTED_ERROR_CODE" ]; then
      echo -e "\e[1;32m  ✓ EXPECTED ERROR (code $RETURN_VALUE) - OK\e[0m"
    else
      echo -e "\e[1;33m  ⚠ Expected error code $TEST_EXPECTED_ERROR_CODE but got $RETURN_VALUE\e[0m"
    fi

    # Reset expected error state
    TEST_EXPECTING_ERROR=0
    TEST_EXPECTED_ERROR_CODE=0
  else
    # Normal test execution - suppress stderr to hide internal errors
    # Errors will be shown in assertions
    if [ "$LOG_LEVEL" -gt "2" ]; then
      $testFunction $testArguments
      RETURN_VALUE=$?
    else
      {
        $testFunction $testArguments
        RETURN_VALUE=$?
      } 2>/dev/null
    fi

    # Don't call onError here - let the assertions handle pass/fail reporting
  fi

  if [ "$LOG_LEVEL" -gt "2" ]; then
    echo -e "\e[90m  ← RETURN: $RETURN_VALUE  Result: $RESULT\e[0m"
  fi
}

test.case.expect.error() # <errorCode> <testName> <testFunction> <testArguments> # runs test case expecting specific error
{
  local errorCode=$1
  shift

  # Set expected error state
  export TEST_EXPECTING_ERROR=1
  export TEST_EXPECTED_ERROR_CODE=$errorCode
  export EXPECTED_RETURN_VALUE=$errorCode

  # Run test case with remaining args (level is "-" to preserve log level)
  test.case "-" "$@"
}

expect() # <returnValue> <expectedResult> <?message> # asserts test result matches expected
{
  ((TEST_SUITE_EXPECT_COUNTER++))

  local -i EXPECT_RETURN_CODE=$1
  shift
  local expectedresult="$1"
  shift
  local message="$1"
  shift

  declare -i rv=$RETURN_VALUE
  #console.log "${BOLD_CYAN}starting on testcase: \#$TEST_COUNTER - $testcase${NORMAL}"

  if [ -z "$message" ]; then
    message=$testName
  fi

  if [ "$expectedresult" = "*" ]; then
    expectedresult=$RESULT
  fi

  if [ "$EXPECT_RETURN_CODE" = "*" ]; then
    EXPECT_RETURN_CODE=$RETURN_VALUE
  fi

  if [ "$EXPECT_RETURN_CODE" -eq $rv ] && [ "$RESULT" = "$expectedresult" ]; then
    ((TEST_SUITE_SUCCESS_COUNTER++))
    echo -e "\e[1;32m  ✓ PASS:\e[0m $message"
  else
    echo -e "\e[1;31m  ✗ FAIL:\e[0m $message"
    echo -e "\e[90m    Expected return: $EXPECT_RETURN_CODE, got: $RETURN_VALUE\e[0m"
    if [ "$expectedresult" != "$RESULT" ]; then
      echo -e "\e[90m    Expected result: $expectedresult\e[0m"
      echo -e "\e[90m    Got result:      $RESULT\e[0m"
    fi
  fi

  TEST_SUITE_RESULT="\e[1;32m$TEST_SUITE_SUCCESS_COUNTER\e[0m / $TEST_SUITE_EXPECT_COUNTER expects on $TEST_SUITE_TEST_COUNTER Tests"
}

expect.pass() # <?message> # simple pass assertion with optional message
{
  ((TEST_SUITE_EXPECT_COUNTER++))
  ((TEST_SUITE_SUCCESS_COUNTER++))

  local message="$1"
  if [ -z "$message" ]; then
    message="assertion passed"
  fi
  echo -e "\e[1;32m  ✓ PASS:\e[0m $message"
}

expect.fail() # <?message> # simple fail assertion with optional message
{
  ((TEST_SUITE_EXPECT_COUNTER++))

  local message="$1"
  if [ -z "$message" ]; then
    message="assertion failed"
  fi
  echo -e "\e[1;31m  ✗ FAIL:\e[0m $message"
}

test.suite.home.passwd() # # print this user's home the way boot derives it under env -i: getent -> dscl -> /etc/passwd, first line, field 6
{
  # The expectation for every boot-under-env-i test. NOT $HOME: under `sudo`
  # without -H, or a HOME-overriding CI runner, the runner's $HOME and the
  # password-database home differ, and boot (correctly) yields the latter.
  local user home=""
  user=$(id -un 2>/dev/null)
  if command -v getent >/dev/null 2>&1; then
    home=$(getent passwd "$user" 2>/dev/null | head -1 | cut -d: -f6)
  fi
  if [ -z "$home" ] && command -v dscl >/dev/null 2>&1; then
    home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  fi
  if [ -z "$home" ] && [ -r /etc/passwd ]; then
    home=$(awk -F: -v u="$user" '$1 == u { print $6; exit }' /etc/passwd)
  fi
  echo "$home"
}

test.suite.boot.anchors.check() # <sourceCommand> # run <sourceCommand> (e.g. `. /etc/oosh/boot`) under env -i in sh, dash, ash, bash and busybox ash; print nothing when every shell yields this user's passwd-home anchors and the caller survives, else one `shell=>output` per failure
{
  # The one harness behind every "boot from an empty environment" assertion
  # (test.config T65/T66/T67, test.platform.boot.system.path.invariant).
  # dash/ash are where `~` fails, busybox is Alpine, bash is where everyone
  # tests — all of them, or the caveat tests prove nothing.
  local sourceCommand="$1"
  local home expected bad="" shell out
  home=$(test.suite.home.passwd)
  expected="[$home|$home/oosh|$home/config]"
  for shell in sh dash ash bash; do
    command -v "$shell" >/dev/null 2>&1 || continue
    out=$(cd /tmp && env -i "$shell" -c "$sourceCommand; echo \"[\$HOME|\$OOSH_DIR|\$CONFIG_PATH]\"" 2>&1 | tail -1)
    [ "$out" = "$expected" ] || bad="$bad $shell=>$out"
  done
  if command -v busybox >/dev/null 2>&1; then
    out=$(cd /tmp && env -i busybox ash -c "$sourceCommand; echo \"[\$HOME|\$OOSH_DIR|\$CONFIG_PATH]\"" 2>&1 | tail -1)
    [ "$out" = "$expected" ] || bad="$bad busybox-ash=>$out"
  fi
  # boot is SOURCED, never executed: the calling shell must survive it.
  out=$(cd /tmp && env -i sh -c "$sourceCommand; echo STILL-HERE" 2>&1 | tail -1)
  [ "$out" = "STILL-HERE" ] || bad="$bad shell-did-not-survive=>$out"
  echo "$bad"
}

test.suite.boot.anchors.check.completion.sourceCommand() {
  # The two source commands every caller uses; a fixture path is typed freely.
  echo ". /etc/oosh/boot"
  echo ". \$OOSH_DIR/boot"
}

test.suite.config.isolate() # <?label:caller> # point the config anchors at a fresh temp dir so a production `config save` in this file cannot rewrite the shared tier; prints the fixture dir
{
  # $CONFIG_PATH is normally ~/config, a SITE-WIDE sharedConfig that every user
  # sources at login. A test that reaches `config save` rewrites it for
  # everybody. Call this before sourcing the script under test.
  #
  # All FOUR moves are required, and the last one is not tidiness:
  # config.start re-runs config.init whenever $CONFIG is not a FILE, and
  # config.init then does an unconditional `export CONFIG_PATH=~/config`. So
  # setting the path alone is not isolation — the next `source $OOSH_DIR/config`
  # silently snaps back to the shared dir while this file believes it is safe.
  local label="${1:-${0##*/}}"
  # Consumed. create.result's third argument below must be the NEXT command's
  # token for this.start's chaining protocol — passing the label there would
  # make `test.suite config.isolate test.log` re-dispatch "test.log" as a command.
  [ -n "$1" ] && shift
  local fixture
  if ! fixture=$(mktemp -d "${TMPDIR:-/tmp}/${label}.config.XXXXXX"); then
    create.result 1 "mktemp -d failed under ${TMPDIR:-/tmp} — cannot isolate, refusing to run against the shared tier"
    error.log "$RESULT"
    return $(result)
  fi

  # The score belongs to the CONFIG_PATH this file INHERITED. Pinned before the
  # move and never re-derived, so an early exit or a missing teardown cannot
  # send it into the fixture where the runner would never find it.
  : ${TEST_SUITE_RESULT_PATH:=${CONFIG_PATH:-$HOME/config}}
  export TEST_SUITE_RESULT_PATH
  TEST_SUITE_CONFIG_FIXTURE="$fixture"
  export TEST_SUITE_CONFIG_FIXTURE
  # Fingerprint the inherited tier now, so test.suite.save.results can prove
  # this file did not write it.
  #
  # What this catches: a write that ESCAPES the fixture — a hardcoded
  # ~/config path, or $HOME/config, which moving CONFIG_PATH does not
  # redirect. That is exactly the shape test.log's T23 and T31 had.
  # What it does NOT catch: removal of the isolate call itself, since the
  # stamp is set by the same call. The canary in test.test.suite covers that
  # case and is the authoritative proof.
  TEST_SUITE_CONFIG_STAMP=$(private.test.suite.config.stamp.get "$TEST_SUITE_RESULT_PATH")
  export TEST_SUITE_CONFIG_STAMP

  export CONFIG_PATH="$fixture"   # config-path-exception: a test fixture, not a shell anchor — the point is that this file's production calls land here instead of the site-wide ~/config. Restored by test.suite.config.restore.
  export CONFIG_FILE="user.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  : > "$CONFIG"                   # config.start's `-f $CONFIG` guard; see above
  : > "$CONFIG_PATH/result.env"   # `result save` / path:private.update.config read it
  : > "$CONFIG_PATH/error.txt"    # what config.init would have touched
  mkdir -p "$CONFIG_PATH/stateMachines"

  # Chain, never clobber, an EXIT trap the caller already installed.
  local priorTrap; priorTrap=$(trap -p EXIT | sed "s/^trap -- '//;s/' EXIT$//")
  if [ -n "$priorTrap" ]; then
    trap "test.suite.config.restore; $priorTrap" EXIT
  else
    trap 'test.suite.config.restore' EXIT
  fi

  # Loud postcondition. A half-isolated file is worse than an un-isolated one:
  # it writes the shared tier and nobody is watching any more.
  if [ "$CONFIG_PATH" = "$TEST_SUITE_RESULT_PATH" ] || [ ! -f "$CONFIG" ]; then
    create.result 1 "isolation FAILED (CONFIG_PATH=$CONFIG_PATH CONFIG=$CONFIG)"
    # Bare echo, not error.log: this tells the caller its file is about to
    # write the site-wide tier, and error.log routes to $LOG_DEVICE, which in
    # a capture or a non-tty CI run swallows it. Bare-echo doctrine.
    echo -e "\e[1;31m  ✗ test.suite.config.isolate: $RESULT\e[0m" >&2
    return $(result)
  fi
  # Both channels, as private.ossh.get.key.name does: $RESULT for a sourced
  # caller, stdout for $(...) — the docstring promises the path either way.
  create.result 0 "$fixture" "$1"
  echo "$fixture"
  return $(result)
}

private.test.suite.config.stamp.get() # <configPath> # fingerprint of exactly the three files a no-arg `config save` rewrites, for the isolation self-check
{
  # NO create.result — a getter consumed as $(...), same subshell reasoning as
  # private.test.suite.results.file.get.
  #
  # Scoped to user.env/oosh.env/log.env: those are what the no-arg config.save
  # cascade rewrites. result.env, testresult.env and result.txt are written by
  # the framework itself and would make this fire on every run.
  local dir="$1" f
  for f in user.env oosh.env log.env; do
    if [ ! -f "$dir/$f" ]; then
      echo "$f ABSENT"
      continue
    fi
    echo "$f $(stat -c '%s %y' "$dir/$f" 2>/dev/null || stat -f '%z %m' "$dir/$f" 2>/dev/null)"
  done
}

test.suite.config.isolate.completion.label() {
  # A free-form mktemp label; callers pass their own basename.
  echo "test.path"
  echo "test.oo"
}

test.suite.config.restore() # # restore the config anchors saved by test.suite.config.isolate and remove the fixture; installed as its EXIT trap, safe to call twice
{
  if [ -z "$TEST_SUITE_CONFIG_FIXTURE" ]; then
    # Nothing to undo is a legitimate outcome, not a failure — the trap fires
    # on every exit, including files that never isolated. Same distinction
    # private.oo.boot.path.ensure draws for a branch with no `boot` to link.
    create.result 0 "nothing to restore"
    return $(result)
  fi
  rm -rf "$TEST_SUITE_CONFIG_FIXTURE" 2>/dev/null
  unset TEST_SUITE_CONFIG_FIXTURE
  export CONFIG_PATH="$TEST_SUITE_RESULT_PATH"   # config-path-exception: restoring the value this file inherited, captured by test.suite.config.isolate before it moved it.
  export CONFIG_FILE="user.env"
  export CONFIG="$CONFIG_PATH/$CONFIG_FILE"
  create.result 0 "config anchors restored to $CONFIG_PATH"
  return $(result)
}

test.suite.usage() # # displays usage information for test.suite
{
  local this=${0##*/}
  echo "You started
$0

  current log level: $LOG_LEVEL

  current file: $CONFIG
   CONFIG_PATH=$CONFIG_PATH
   CONFIG_FILE=$CONFIG_FILE


  Usage:
  $this: command   description and Parameter
      all       tests all tests in $OOSH_DIR/test
                $this all <log level>  <?clear>
      core      tests core infrastructure tests only
                $this core <log level>  <?clear>
      extended  tests extended feature tests only
                $this extended <log level>  <?clear>
      run       runs a single test: $OOSH_DIR/test/test.<command>
                $this run <command> <log level>  <?clear>

  Categories:
      Tests declare TEST_CATEGORY=core at the top of the file.
      Tests without a category marker default to extended.

  Examples
    $this run loop 5
    $this core 1
    $this extended 1 clear
    $this all 1 clear
  "

  #loop.list PATH print '---------------------: '
}

test.suite.init "$@"
