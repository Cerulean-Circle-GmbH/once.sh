ogit.remote.url.configured.get()     # <?remote:origin> <?dir:$OOSH_DIR> # echo the URL of <remote> as the git config of <dir> holds it, no url.insteadOf rewriting applied — what a heal compares and sets; empty when there is none #
{
 # NO create.result — a getter consumed as $(...). `git remote get-url`
 # (ogit.remote.url.get) answers the URL git will use, after url.<base>.insteadOf:
 # on a host that rewrites git@github.com: to https://github.com/ the heal read
 # its own SSH origin back as HTTPS and set it again on every run. What is
 # configured is remote.<remote>.url (T-OGIT-REMOTE-URL-CONFIGURED-GET).
 local dir="${2:-${OOSH_DIR:-.}}"
 git -C "$dir" config --get "remote.${1:-origin}.url" 2>/dev/null
}
