private.ogit.git.run()     # <dir> <args...> # run git -C <dir> <args...>: stdout passes through, git stderr is kept in OGIT_GIT_ERROR (one line) instead of the terminal; rc is the git rc #
{
 # The mutators runner (decided 2026-09-24): git's own reason for a failure
 # reaches RESULT instead of /dev/null. fd 3 carries stdout past the $( ),
 # which captures stderr only; no subshell around the assignment, so
 # OGIT_GIT_ERROR is set in the calling shell. bash 3.2 safe.
 # Getters do NOT use it — they stay silent (2>/dev/null) for completion.
 local dir="$1"
 shift
 local rc mask
 # A shared repository: git runs with umask 002 (private.ogit.umask.get),
 # inside the $( ) subshell — the caller keeps its own. A --global write is a
 # person's own ~/.gitconfig: umask 022, whatever the caller has (oo heal's
 # clean process runs with 002, T-OO-HEAL-UMASK-HOME).
 case " $* " in
   *" --global "*) mask=022 ;;
   *) mask=$(private.ogit.umask.get "$dir") ;;
 esac
 { OGIT_GIT_ERROR=$( [ -n "$mask" ] && umask "$mask"; git -C "$dir" "$@" 2>&1 1>&3 3>&-); rc=$?; } 3>&1
 OGIT_GIT_ERROR=$(printf '%s' "$OGIT_GIT_ERROR" | tr '\n' ' ' | sed 's/[[:space:]]*$//')
 return $rc
}


private.ogit.git.reason.get()     #  # echo the suffix — git: plus OGIT_GIT_ERROR when git left an error text, else nothing; a mutator appends it to its failure RESULT #
{
 # A getter: stdout only, no create.result (it is called inside the message).
 [ -n "$OGIT_GIT_ERROR" ] && printf ' — git: %s' "$OGIT_GIT_ERROR"
 return 0
}


