ogit.file.show()     # <ref> <path> <?dir:$OOSH_DIR> # echo the content of <path> at <ref> in <dir>; rc 1 and nothing when the ref or the path does not exist, or the path is a directory #
{
 # <ref> completes through the shared ogit.parameter.completion.ref below the marker.
 # An echo getter that still goes through private.ogit.git.run: git's own
 # reason (unknown revision, path not in the tree) must reach RESULT, which a
 # silent 2>/dev/null getter would lose. cat-file blob, not show: show prints a
 # listing for a directory and is porcelain; cat-file refuses anything but a blob.
 private.ogit.require || return $(result)
 local ref="$1"
 local path="$2"
 local dir="${3:-${OOSH_DIR:-.}}"
 if [ -z "$ref" ] || [ -z "$path" ]; then
   create.result 1 "ogit.file.show requires <ref> <path>"
   error.log "$RESULT"
   return $(result)
 fi
 if private.ogit.git.run "$dir" cat-file blob "$ref:$path"; then create.result 0 "$path at $ref"
 else create.result 1 "no file $path at $ref in $dir$(private.ogit.git.reason.get)"; fi
 return $(result)
}


