ogit.safeDirectory.prune()     #  # drop global safe.directory entries whose paths no longer exist (moved from oo.safeDirectory.prune) #
{
 # A long list with stale /tmp/* paths makes the VS Code / Cursor git extension
 # hang validating each entry, leaving Source Control empty.
 # In place: one --unset-all per stale value, never an empty list in between
 # (it used to clear everything and re-add the kept ones — an interrupt there
 # left no trust at all). The value pattern is the entry itself, anchored, every
 # regex character escaped: old git has no --fixed-value. rc 5 = no such entry
 # any more (a duplicate already went with its twin): not a failure.
 local entry pattern pruned=0 kept=0 failed=""; local -a entries=()
 while IFS= read -r entry; do
   [ -n "$entry" ] && entries+=("$entry")
 done < <(ogit.safeDirectory.list)
 for entry in "${entries[@]}"; do
   if [ -e "$entry" ]; then kept=$((kept + 1)); continue; fi
   pattern="^$(printf '%s' "$entry" | sed 's/[][\.*^$+?(){}|]/\\&/g')\$"
   private.ogit.git.run / config --global --unset-all safe.directory "$pattern"
   case $? in
     0|5) pruned=$((pruned + 1)) ;;
     *)   failed="$failed $entry$(private.ogit.git.reason.get)" ;;
   esac
 done
 if [ -n "$failed" ]; then create.result 1 "could not remove stale safe.directory:$failed"; error.log "$RESULT"; return $(result); fi
 if [ "$pruned" -gt 0 ]; then console.log "Pruned $pruned stale safe.directory entries; $kept preserved"
 else info.log "No stale safe.directory entries to prune ($kept present)"; fi
 create.result 0 "pruned=$pruned kept=$kept"; return $(result)
}
