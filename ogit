ogit.remote.branch.delete()     # <branch> <?remote:origin> <?dir:$OOSH_DIR> # delete <branch> on <remote> (push --delete); refuses dev, testing, prod and main; rc 1 and the reason when git refuses #
{
 private.ogit.require || return $(result)
 local branch="$1"
 local remote="${2:-origin}"
 local dir="${3:-${OOSH_DIR:-.}}"
 if [ -z "$branch" ]; then
   create.result 1 "ogit.remote.branch.delete requires <branch>"
   error.log "$RESULT"
   return $(result)
 fi
 # The long-lived branches are never deleted by a method; the remote is not asked.
 # git takes many spellings of one branch (main, heads/main, refs/heads/main,
 # :main), so the name is reduced to its short form before the comparison, and
 # anything with a colon or HEAD is no plain branch name and is refused too.
 local short="${branch#:}"
 short="${short#refs/}"; short="${short#heads/}"; short="${short#:}"
 case "$short" in
   dev|testing|prod|main|HEAD|*:*|"")
     create.result 1 "refusing to delete the protected or unclear branch $branch on $remote"
     error.log "$RESULT"
     return $(result) ;;
 esac
 # git answers rc 0 for --delete of a full ref the remote does not have, so ask first.
 if ! ogit.remote.branch.list "$remote" "$dir" | grep -qFx "$short"; then
   create.result 1 "$remote has no branch $short"
   error.log "$RESULT"
   return $(result)
 fi
 if private.ogit.git.run "$dir" push "$remote" --delete "refs/heads/$short" >/dev/null; then create.result 0 "deleted $short on $remote"
 else create.result 1 "could not delete $short on $remote$(private.ogit.git.reason.get)"; fi
 return $(result)
}


