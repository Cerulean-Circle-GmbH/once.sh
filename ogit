ogit.layout.status()     # <?base:$(oo mode.base.get)> # one line per folder under <base>: shape (worktree|clone), dirty/ahead/behind counts, shared/setgid/trusted; rc 1 when the folders are not all the same shape #
{
 # Status idiom: the answer is plain echo, never behind console.log.
 local base
 base=$(private.ogit.base.get "$1")
 if [ -z "$base" ] || [ ! -d "$base" ]; then echo "no base"; create.result 1 "ogit.layout.status: no base"; return $(result); fi
 local d name shape dirty ahead behind shared setgid trusted shapes="" rc=0
 while IFS= read -r d; do
   name="${d##*/}"
   shape=$(private.ogit.folder.shape "$d")
   shapes="$shapes $shape"
   dirty=$(ogit.status.show porcelain "$d" | grep -c .)
   if ogit.branch.check '@{u}' "$d"; then
     ogit.commit.count '@{u}' HEAD "$d" >/dev/null; ahead="$RESULT"
     ogit.commit.count HEAD '@{u}' "$d" >/dev/null; behind="$RESULT"
   else ahead='?'; behind='?'; fi
   # the folder's OWN repository value, not the global one (scope local, Task 10)
   [ "$(ogit.config.get core.sharedRepository local "$d")" = group ] && shared=group || shared=no
   [ -g "$(private.ogit.gitdir "$d")" ] && setgid=yes || setgid=no
   ogit.safeDirectory.list | grep -qFx "$(private.this.path.case.get "$d")" && trusted=yes || trusted=no   # the spelling ogit.safeDirectory.add stores
   printf '%-14s %-9s dirty %-3s ahead %-3s behind %-3s shared=%s setgid=%s trusted=%s\n' "$name" "$shape" "$dirty" "$ahead" "$behind" "$shared" "$setgid" "$trusted"
 done < <(private.ogit.base.folders.list "$base")
 # main is always a clone; the OTHER folders must all share one shape.
 case "$shapes" in *worktree*clone*|*clone*worktree*) [ "$(printf '%s\n' $shapes | grep -c clone)" = 1 ] || rc=1 ;; esac
 if [ "$rc" = 0 ]; then create.result 0 "layout under $base is consistent"
 else create.result 1 "mixed layout under $base — finish ogit worktree.remove or worktree.restore"; fi
 return $(result)
}


private.ogit.folder.ignored.save()     # <folder> <stashDir> # copy every gitignored path of <folder> into <stashDir>, keeping relative paths; RESULT = the number carried; rc 1 when a copy fails (RESULT names <stashDir>) #
{
 local folder="$1" stash="$2"
 local p n=0
 local -a paths=()
 # Rule 3: a failing status must not read as "nothing ignored" and let the
 # conversion delete the folder with its ignored files. Checked once through
 # the runner (the -z stream itself needs a process substitution).
 if ! private.ogit.git.run "$folder" status --porcelain --ignored -z >/dev/null; then
   create.result 1 "ogit: cannot list the ignored files of $folder — nothing in $folder was touched$(private.ogit.git.reason.get)"; return $(result)
 fi
 # `!! <path>` entries are the ignored ones; -z keeps odd names whole. A fully
 # ignored directory is one entry ending in /.
 while IFS= read -r -d '' p; do
   case "$p" in '!! '*) paths+=("${p#!! }") ;; esac
 done < <(private.ogit.git.run "$folder" status --porcelain --ignored -z)
 if [ ${#paths[@]} = 0 ]; then create.result 0 "0"; return $(result); fi
 if ! mkdir -p "$stash" || ! chmod 700 "$stash"; then # kernel-exception: pre-existing on dev, out of the heal scope
   create.result 1 "ogit: cannot create the backup $stash — nothing in $folder was touched"; return $(result)
 fi
 for p in "${paths[@]}"; do
   p="${p%/}"
   if mkdir -p "$stash/$(dirname "$p")" && cp -Rp "$folder/$p" "$stash/$(dirname "$p")/"; then # kernel-exception: pre-existing on dev, out of the heal scope
     success.log "carrying ignored ${folder##*/}/$p"
     n=$((n + 1))
   else
     create.result 1 "ogit: could not back up $folder/$p — nothing in $folder was touched; the partial backup is in $stash"; return $(result)
   fi
 done
 create.result 0 "$n"
 return $(result)
}


private.ogit.folder.ignored.restore()     # <stashDir> <folder> # copy everything saved in <stashDir> back into <folder>, keeping relative paths; the backup itself is kept #
{
 local stash="$1" folder="$2"
 if [ ! -d "$stash" ]; then create.result 0 "no ignored files to carry"; return $(result); fi
 # Each ENTRY, never the backup dir itself — see private.this.folder.entries.copy.
 if private.this.folder.entries.copy "$stash" "$folder" >/dev/null; then
   success.log "ignored files carried into $folder (backup kept: $stash)"
   create.result 0 "restored from $stash"
 else
   create.result 1 "ogit: could not copy the ignored files back into $folder — they are safe in $stash; copy each entry by hand (not the dir itself):${RESULT#entries not copied:} → cp -Rp '$stash'/<entry> '$folder/'"
 fi
 return $(result)
}


private.ogit.folder.gate()     # <folder> # rc 0 when <folder> is clean, has an upstream and is not ahead of it; RESULT names the folder and the fix otherwise #
{
 local d="$1" name="${1##*/}" n
 n=$(ogit.status.show porcelain "$d" | grep -c .)
 if [ "$n" != 0 ]; then create.result 1 "$name has $n uncommitted change(s) — commit or stash them in $d first"; return $(result); fi
 if ! ogit.branch.check '@{u}' "$d"; then create.result 1 "$name tracks no upstream — set it with: ogit branch.upstream.set origin/<branch> $d, then ogit remote.push <branch> no $d"; return $(result); fi
 ogit.commit.count '@{u}' HEAD "$d" >/dev/null; n="$RESULT"
 if [ "${n:-0}" != 0 ]; then create.result 1 "$name is $n commit(s) ahead of its upstream — push it first"; return $(result); fi
 create.result 0 "$name is clean and pushed"
 return $(result)
}


ogit.folder.finish()     # <folder> # after a clone/worktree lands under the base: shared group mode (ogit repo.share and the work tree; setgid is set also without a dev group), trust for the caller and — under sudo — for the person who typed the command; no ownership change #
{
 # No chown: the policy is chgrp dev + g+w + setgid, never a recursive chown
 # (T-STATE-31-CHOWN-NOT-RECURSIVE in test/test.install). Both shares are safe
 # without a dev group — setgid on the directories, group and g+w left as they
 # are — so a clone made on such a host is shared too
 # (T-OGIT-FOLDER-FINISH-NO-DEV-GROUP).
 ogit.repo.share "$1" >/dev/null || return $(result)
 # …and the WORKING TREE, not only .git: every dev-group user must be able to
 # update the checked-out files (the host prod/ clone made under sudo came out
 # root:root). chgrp dev + g+w via the kernel's share primitive, setgid dirs so
 # new files inherit the group. Still no chown.
 if ! private.this.folder.share "$1" yes >/dev/null; then
   create.result 1 "ogit: could not share the working tree of $1 with group dev — $RESULT — run: sudo -H $OOSH_DIR/ogit folder.finish $1"; return $(result)
 fi
 ogit.safeDirectory.add "$1" >/dev/null || return $(result)
 # Under sudo the entry above is ROOT's; the person who typed the command needs
 # one too. Through the as-user preamble (private.this.as.user.preamble.get in this), and with the PHYSICAL
 # shared tree: root's $OOSH_DIR is /root/oosh, unreadable to that user.
 if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then
   local sharedOosh
   sharedOosh=$(private.this.path.canonical "$OOSH_DIR")
   if private.this.script.load user private.as.user; then
     private.as.user "$SUDO_USER" bash -c "$(private.this.as.user.preamble.get "$SUDO_USER" "$(user.get home "$SUDO_USER")" "$sharedOosh")"$'\n'"'$sharedOosh/ogit' safeDirectory.add '$1'" >/dev/null 2>&1 \
       || warn.log "ogit: could not add $1 to $SUDO_USER's safe.directory — they run: ogit safeDirectory.ensure"
   else
     warn.log "ogit: user script not loadable — $SUDO_USER runs: ogit safeDirectory.ensure"
   fi
 fi
 create.result 0 "finished: $1"
 return $(result)
}


ogit.worktree.remove()     # <?base:$(oo mode.base.get)> # turn every linked worktree of <base>/main into an independent clone of the same branch, carrying its gitignored files across; refuses on a dirty or unpushed folder; idempotent; run with sudo on a shared tree #
{
 private.ogit.require || return $(result)
 local base
 base=$(private.ogit.base.get "$1")
 if [ ! -d "$base/main/.git" ]; then create.result 1 "ogit.worktree.remove: no repository at $base/main"; error.log "$RESULT"; return $(result); fi
 # A shared tree is not the caller's to change: ask for sudo here, so
 # `ogit worktree.remove` works as typed (sudo's PATH has no ogit).
 if private.ogit.root.check "$base"; then private.ogit.sudo.rerun worktree.remove "$base"; return $(result); fi
 # A worktree that lost its upstream is given it back before the gate looks (a
 # re-run through sudo repairs too, by running this same method): the gate
 # refuses "tracks no upstream", and only a branch origin has is tracked.
 private.ogit.worktree.upstream.ensure "$base" >/dev/null || return $(result)
 local url
 url=$(ogit.remote.url.get origin "$base/main")
 if [ -z "$url" ]; then create.result 1 "ogit.worktree.remove: $base/main has no origin"; error.log "$RESULT"; return $(result); fi
 # Gate EVERY folder before touching ANY: main, then each linked worktree.
 local -a folders=() branches=()
 local wt branch mainPhys
 mainPhys=$(private.this.path.canonical "$base/main")
 while IFS= read -r wt; do
   [ "$wt" = "$mainPhys" ] && continue
   folders+=("$wt")
 done < <(private.ogit.worktree.paths.get "$base/main")
 private.ogit.folder.gate "$base/main" || { error.log "$RESULT"; return $(result); }
 for wt in "${folders[@]}"; do
   private.ogit.folder.gate "$wt" || { error.log "$RESULT"; return $(result); }
   branch=$(ogit.branch.get "$wt")
   [ -n "$branch" ] || { create.result 1 "${wt##*/} is detached — check a branch out first"; error.log "$RESULT"; return $(result); }
   branches+=("$branch")
 done
 if [ ${#folders[@]} = 0 ]; then create.result 0 "no linked worktrees under $base — nothing to remove"; success.log "$RESULT"; return $(result); fi
 local i stash keep tmp
 for i in "${!folders[@]}"; do
   wt="${folders[$i]}"; branch="${branches[$i]}"
   # Build the clone BESIDE the worktree first, from main/ — offline and without
   # credentials (root has no GitHub key on a real host: the 2026-09-25 host
   # migration lost dev/ that way). A worktree's branch is a local branch of
   # main, and the gate proved it clean and pushed, so main holds exactly the
   # pushed commit. Only when the clone exists is the worktree removed.
   tmp="$(dirname "$wt")/.ogit-${wt##*/}.new"
   if [ -e "$tmp" ]; then
     create.result 1 "${wt##*/}: $tmp is in the way (left by an earlier run?) — remove it and re-run; nothing was changed"; error.log "$RESULT"; return $(result)
   fi
   ogit.repo.clone "$base/main" "$branch" "$tmp" >/dev/null 2>&1 \
     || { create.result 1 "${wt##*/}: clone of $branch from $base/main failed — nothing was changed$(private.ogit.git.reason.get)"; error.log "$RESULT"; return $(result); }
   ogit.remote.url.set "$url" origin "$tmp" >/dev/null \
     || { rm -rf "$tmp"; create.result 1 "${wt##*/}: could not point the new clone at $url — nothing was changed$(private.ogit.git.reason.get)"; error.log "$RESULT"; return $(result); }
   stash="$HOME/.oosh.backups/$(date -u +%Y%m%dT%H%M%SZ)-ogit-${wt##*/}"
   [ -e "$stash" ] && stash="$stash.$$"
   private.ogit.folder.ignored.save "$wt" "$stash" || { rm -rf "$tmp"; error.log "$RESULT"; return $(result); }
   keep=""; [ -d "$stash" ] && keep=" — its ignored files are kept in $stash"
   ogit.worktree.delete "$wt" "$base/main" >/dev/null \
     || { rm -rf "$tmp"; create.result 1 "worktree delete of $wt failed — stop; nothing after this folder was touched$keep$(private.ogit.git.reason.get)"; error.log "$RESULT"; return $(result); }
   mv "$tmp" "$wt" \
     || { create.result 1 "${wt##*/}: worktree removed but the new clone could not be moved into place — recover with: mv $tmp $wt$keep"; error.log "$RESULT"; return $(result); }
   ogit.folder.finish "$wt" || { error.log "$RESULT$keep"; return $(result); }
   private.ogit.folder.ignored.restore "$stash" "$wt" || { error.log "$RESULT"; return $(result); }
   success.log "${wt##*/}: worktree → clone ($branch)"
 done
 ogit.worktree.prune "$base/main" >/dev/null
 create.result 0 "${#folders[@]} folder(s) converted to clones under $base"
 return $(result)
}


ogit.worktree.restore()     # <?base:$(oo mode.base.get)> # turn every sibling clone of <base>/main (same origin) back into a linked worktree of main, carrying its gitignored files across; refuses on a dirty or unpushed folder and on a clone holding a stash, an unpushed branch or a tag main lacks; idempotent; run with sudo on a shared tree #
{
 private.ogit.require || return $(result)
 local base
 base=$(private.ogit.base.get "$1")
 if [ ! -d "$base/main/.git" ]; then create.result 1 "ogit.worktree.restore: no repository at $base/main"; error.log "$RESULT"; return $(result); fi
 if private.ogit.root.check "$base"; then private.ogit.sudo.rerun worktree.restore "$base"; return $(result); fi
 local url
 url=$(ogit.remote.url.get origin "$base/main")
 local d branch
 local -a folders=() branches=()
 while IFS= read -r d; do
   [ "${d##*/}" = main ] && continue
   [ -d "$d/.git" ] || continue                                   # worktrees (.git file) are already done
   [ "$(ogit.remote.url.get origin "$d")" = "$url" ] || continue   # a foreign clone is not ours
   private.ogit.folder.gate "$d" || { error.log "$RESULT"; return $(result); }
   private.ogit.clone.gate "$d" "$base/main" || { error.log "$RESULT"; return $(result); }   # the clone is deleted: its own refs go with it
   branch=$(ogit.branch.get "$d")
   [ -n "$branch" ] || { create.result 1 "${d##*/} is detached — check a branch out first"; error.log "$RESULT"; return $(result); }
   folders+=("$d"); branches+=("$branch")
 done < <(private.ogit.base.folders.list "$base")
 private.ogit.folder.gate "$base/main" || { error.log "$RESULT"; return $(result); }
 if [ ${#folders[@]} = 0 ]; then create.result 0 "no sibling clones under $base — nothing to restore"; success.log "$RESULT"; return $(result); fi
 local i stash keep
 # No fetch from origin: under sudo root has no GitHub key. Import each clone's
 # branch into main/ locally (the gate proved it clean and pushed), so
 # origin/<branch> in main is exactly the commit the new worktree gets.
 for i in "${!folders[@]}"; do
   private.ogit.branch.import "${folders[$i]}" "${branches[$i]}" "$base/main" >/dev/null \
     || { error.log "$RESULT — nothing was changed"; return $(result); }
 done
 # main/ keeps its own local copy of every branch, and `worktree add -B <branch> …
 # origin/<branch>` below RESETS it. Commits there that origin does not have would
 # survive only in the reflog, so refuse before anything is deleted.
 for i in "${!branches[@]}"; do
   branch="${branches[$i]}"
   ogit.branch.check "refs/heads/$branch" "$base/main" || continue
   ogit.commit.count "origin/$branch" "refs/heads/$branch" "$base/main" >/dev/null
   if [ "${RESULT:-0}" != 0 ]; then
     create.result 1 "main/ has $RESULT unpushed commit(s) on its local $branch branch, which restore would reset — push it or delete it in $base/main first"
     error.log "$RESULT"; return $(result)
   fi
 done
 for i in "${!folders[@]}"; do
   d="${folders[$i]}"; branch="${branches[$i]}"
   stash="$HOME/.oosh.backups/$(date -u +%Y%m%dT%H%M%SZ)-ogit-${d##*/}"
   [ -e "$stash" ] && stash="$stash.$$"
   private.ogit.folder.ignored.save "$d" "$stash" || { error.log "$RESULT"; return $(result); }
   keep=""; [ -d "$stash" ] && keep=" — its ignored files are kept in $stash"
   rm -rf "$d" || { create.result 1 "could not remove $d$keep"; error.log "$RESULT"; return $(result); }
   ogit.worktree.add "$branch" "$d" "origin/$branch" "$base/main" >/dev/null \
     || { create.result 1 "${d##*/}: clone removed but worktree add failed — recover with: ogit worktree.add $branch $d origin/$branch $base/main$keep$(private.ogit.git.reason.get)"; error.log "$RESULT"; return $(result); }
   ogit.branch.upstream.set "origin/$branch" "$d" >/dev/null
   ogit.folder.finish "$d" || { error.log "$RESULT$keep"; return $(result); }
   private.ogit.folder.ignored.restore "$stash" "$d" || { error.log "$RESULT"; return $(result); }
   success.log "${d##*/}: clone → worktree ($branch)"
 done
 ogit.repo.share "$base/main" >/dev/null
 create.result 0 "${#folders[@]} folder(s) restored as worktrees of $base/main"
 return $(result)
}


private.ogit.fetchhead.share()     # <?dir:$OOSH_DIR> # make the FETCH_HEAD of <dir> group-writable when its repository is shared (core.sharedRepository) and this user owns the file; silent #
{
 # NO create.result — called after a fetch or pull, whose RESULT must stand.
 # git applies core.sharedRepository to what it creates through its shared-
 # permission path, but writes FETCH_HEAD with the caller's umask: after root
 # fetched in a shared folder, no other dev user could fetch there again
 # (platform container, 2026-10-01; T-OGIT-FETCHHEAD-SHARED). Only the owner
 # can chmod it — which is exactly the user who just wrote it. An unshared
 # repository is left alone: never widen permissions nobody asked for.
 local dir="${1:-${OOSH_DIR:-.}}" shared gitDir
 shared=$(ogit.config.get core.sharedRepository local "$dir")
 case "$shared" in ''|umask|false|0) return 0 ;; esac
 gitDir=$(private.ogit.gitdir "$dir")
 [ -n "$gitDir" ] && [ -O "$gitDir/FETCH_HEAD" ] && chmod g+w "$gitDir/FETCH_HEAD" 2>/dev/null # kernel-exception: pre-existing on dev, out of the heal scope
 return 0
}


private.ogit.root.check()     # <base> # rc 0 when a converter must run as root on <base>: the caller is not root and does not own <base>, a folder under it or its .git #
{
 # A predicate (rc only). The framework contract: $SUDO is "" for root and
 # "sudo " otherwise (see private.oo.path.sudo.get) — root never re-runs. A tree
 # the caller owns (fixtures, a single-user host) needs no root: chgrp/chmod
 # need ownership, so the test is -O on the base, every folder and its .git.
 [ -n "$SUDO" ] || return 1
 local base="$1" d
 [ -O "$base" ] || return 0
 while IFS= read -r d; do
   [ -O "$d" ] || return 0
   [ -e "$d/.git" ] && { [ -O "$d/.git" ] || return 0; }
 done < <(private.ogit.base.folders.list "$base")
 return 1
}


private.ogit.sudo.rerun()     # <method> <base> # run ogit <method> <base> again through sudo, by the canonical path of ogit (the PATH of sudo has no oosh); RESULT and rc are those of that run #
{
 # sudo resets PATH (no oosh on it) and root's own oo mode.base.get is not
 # ours: run THIS ogit by its canonical path with the base already resolved.
 # Output and the password prompt pass straight through.
 local method="$1" base="$2" self rc
 if ! command -v sudo >/dev/null 2>&1 && [ "$(type -t sudo)" != function ]; then
   create.result 1 "ogit $method: $base belongs to other users and sudo is missing — run it as root"; error.log "$RESULT"; return $(result)
 fi
 self=$(private.this.path.canonical "$OOSH_DIR/ogit")
 # A run that may not prompt (oo heal without a terminal: SUDO="sudo -n ", and
 # sudo itself adds -n) says so — no password hint it cannot honour.
 if private.this.sudo.prompt.is; then
   important.log "ogit $method: $base is shared with other users — running as root via sudo (enter your password if asked)"
 else
   important.log "ogit $method: $base is shared with other users — running as root via sudo -n (no password prompt)"
 fi
 sudo "$self" "$method" "$base"; rc=$? # kernel-exception: pre-existing on dev, out of the heal scope
 [ "$rc" = 0 ] && create.result 0 "ogit $method ran as root via sudo" || create.result "$rc" "ogit $method as root via sudo failed (rc=$rc)"
 return $(result)
}


private.ogit.branch.import()     # <srcDir> <branch> <?dir:$OOSH_DIR> # make refs/remotes/origin/<branch> of <dir> point at the <branch> of the repository in <srcDir> (a local fetch, no network, no credentials) #
{
 # A LOCAL fetch: restore runs under sudo, and root has no GitHub key. The gate
 # proved <srcDir> clean and not ahead of origin, so its <branch> is a pushed commit.
 # Forced (+): origin/<branch> in <dir> may be older than, or diverge from, it.
 private.ogit.require || return $(result)
 local src="$1" branch="$2"
 local dir="${3:-${OOSH_DIR:-.}}"
 if private.ogit.git.run "$dir" fetch -q "$src" "+refs/heads/$branch:refs/remotes/origin/$branch"; then
   create.result 0 "origin/$branch of $dir now at the $branch of $src"
 else
   create.result 1 "could not import $branch from $src into $dir$(private.ogit.git.reason.get)"
 fi
 return $(result)
}


private.ogit.umask.get()     # <?dir:$OOSH_DIR> # echo 002 when the repository of <dir> is shared (core.sharedRepository set), else nothing: the umask every mutator runs git with #
{
 # A getter (stdout, no create.result). git does not apply core.sharedRepository
 # to every file it writes — FETCH_HEAD came out -rw-r--r-- after root pulled
 # in the shared dev/ clone and locked every other dev-group user out of
 # `fetch`; a picked or restored work-tree file and COMMIT_EDITMSG the same.
 # The one decision for private.ogit.git.run and the editor commit.
 local dir="${1:-${OOSH_DIR:-.}}"
 case "$(git -C "$dir" config --get core.sharedRepository 2>/dev/null)" in ''|false|umask|0) ;; *) echo 002 ;; esac
 return 0
}


private.ogit.clone.gate()     # <folder> <mainDir> # rc 0 when deleting the clone <folder> loses no ref of its own: no stash, every other local branch on its origin, every tag also in <mainDir>; RESULT names the folder and what would be lost otherwise #
{
 # private.ogit.folder.gate checks the checked-out branch; a CLONE owns every
 # ref in it, and worktree.restore deletes the folder. A linked worktree shares
 # its refs with main/, so worktree.remove needs only the folder gate.
 # Offline (restore runs under sudo, root has no GitHub key): the cached
 # origin/* refs of the clone and the tags of <mainDir> are the measure.
 local d="$1" main="$2" name="${1##*/}" current b t
 if [ -z "$d" ] || [ -z "$main" ]; then
   create.result 1 "private.ogit.clone.gate requires <folder> <mainDir>"; error.log "$RESULT"; return $(result)
 fi
 if [ -n "$(ogit.stash.top.get "$d")" ]; then
   create.result 1 "$name holds a stash ($(ogit.stash.top.get "$d")) that restore would delete — pop or drop it in $d first"; return $(result)
 fi
 current=$(ogit.branch.get "$d")
 while IFS= read -r b; do
   [ -z "$b" ] || [ "$b" = "$current" ] && continue
   if ! ogit.branch.check "refs/remotes/origin/$b" "$d"; then
     create.result 1 "$name has a local branch $b that origin does not have — push it (ogit remote.push $b no $d) or delete it first"; return $(result)
   fi
   ogit.commit.count "origin/$b" "refs/heads/$b" "$d" >/dev/null
   if [ "${RESULT:-0}" != 0 ]; then
     create.result 1 "$name has $RESULT unpushed commit(s) on its local branch $b — push it (ogit remote.push $b no $d) or delete it first"; return $(result)
   fi
 done < <(ogit.branch.list local "$d")
 while IFS= read -r t; do
   [ -z "$t" ] && continue
   if ! ogit.tag.check "$t" "$main"; then
     create.result 1 "$name has a tag $t that ${main##*/}/ does not — push it (ogit remote.push \"\" yes $d) and fetch it into $main (ogit remote.fetch no $main), or delete it first"; return $(result)
   fi
 done < <(ogit.tag.list "" "$d")
 create.result 0 "$name holds no ref of its own"
 return $(result)
}


ogit.stash.drop()     # <?dir:$OOSH_DIR> # drop the top stash of <dir>: after the conflicts of a failed stash.pop are resolved, the stash still holds the change that is now in the work tree #
{
 # The follow-up to a stash.pop that conflicted: git wrote the markers into
 # the work tree and KEPT the stash; once they are resolved, popping again
 # would re-apply the same change. <dir> completes through the shared
 # ogit.parameter.completion.dir below the marker.
 private.ogit.require || return $(result)
 local dir="${1:-${OOSH_DIR:-.}}"
 if [ -z "$(ogit.stash.top.get "$dir")" ]; then create.result 1 "no stash to drop in $dir"; return $(result); fi
 if private.ogit.git.run "$dir" stash drop -q; then create.result 0 "stash dropped"; else create.result 1 "stash drop failed in $dir$(private.ogit.git.reason.get)"; fi
 return $(result)
}


ogit.branch.adopt()     # <ref> <?message> <?asEmail> <?asName> <?dir:$OOSH_DIR> # make the current branch of <dir> a merge of itself and <ref> whose content is exactly the tree of <ref> (commit-tree, then branch.fastForward); for a promotion after tree-reset rollbacks, where a 3-way merge cannot apply; refuses a dirty tree and a ref that does not resolve; nothing to do when the branch already contains <ref>; <asEmail>/<asName> give a bot identity without gpg signing #
{
 # Why it exists: on 30 Sep 2026 prod and testing were rolled back with
 # tree-reset commits (a new commit whose tree is an older one). Their merge
 # base stayed the regression both had left, so a 3-way merge of testing into
 # prod conflicted in every file both resets touched, although the intent was
 # plain: prod becomes the content of testing. Plumbing, no working-tree merge:
 # commit-tree makes the merge commit (parents HEAD and <ref>, tree of <ref>),
 # branch.fastForward moves the branch, so work tree and index follow safely.
 private.ogit.require || return $(result)
 local ref="$1" msg="$2"
 local dir="${5:-${OOSH_DIR:-.}}"
 local branch out
 branch=$(ogit.branch.get "$dir")
 if [ -z "$ref" ] || [ -z "$branch" ]; then
   create.result 1 "ogit.branch.adopt needs <ref> and a checked-out branch in $dir"
   return $(result)
 fi
 if ! ogit.status.check "$dir"; then
   create.result 1 "$dir has uncommitted changes — commit or stash them before adopting $ref"
   return $(result)
 fi
 if ! ogit.branch.check "$ref^{commit}" "$dir"; then
   create.result 1 "$ref does not resolve in $dir — nothing to adopt"
   return $(result)
 fi
 # Contained already: the adoption (or a merge) happened; what the branch
 # changed since is its own, as with a merge that is already up to date.
 if git -C "$dir" merge-base --is-ancestor "$ref" HEAD 2>/dev/null; then
   create.result 0 "$branch already contains $ref — nothing to adopt"
   return $(result)
 fi
 private.ogit.identity "$3" "$4"
 # stdout of git.run is the new commit; on failure the subshell hands back
 # the reason of git instead, since OGIT_GIT_ERROR does not leave $( ).
 if out=$(private.ogit.git.run "$dir" "${OGIT_IDENTITY[@]}" commit-tree "$ref^{tree}" -p HEAD -p "$ref" \
            -m "${msg:-Merge $ref into $branch — content of $ref (adopt)}" || { printf '%s' "$OGIT_GIT_ERROR"; exit 1; }); then
   if ogit.branch.fastForward "$out" "$dir" >/dev/null; then
     create.result 0 "$branch adopted the content of $ref: merge commit $out"
   else
     create.result 1 "the merge commit $out for $ref was made, but $branch did not move to it: $RESULT"
   fi
 else
   OGIT_GIT_ERROR="$out"
   create.result 1 "no merge commit for $ref in $dir$(private.ogit.git.reason.get)"
 fi
 return $(result)
}


ogit.merge.check()     # <?dir:$OOSH_DIR> # RESULT = none when no merge, rebase or cherry-pick is in progress in <dir>; otherwise merge, rebase or pick and rc 1; rc 2 when <dir> is not a repository #
{
 # <dir> completes through the shared ogit.parameter.completion.dir below the marker.
 private.ogit.require || return $(result)
 local dir="${1:-${OOSH_DIR:-.}}"
 local name marker kind="" path
 if ! private.ogit.git.run "$dir" rev-parse --git-dir >/dev/null; then
   create.result 2 "$dir is not a repository$(private.ogit.git.reason.get)"
   return $(result)
 fi
 # git names the files itself (--git-path), so a worktree or a separate git dir is found too.
 # Outer operation first: a rebase -r stopped on a merge commit has MERGE_HEAD inside rebase-merge.
 for name in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge CHERRY_PICK_HEAD:pick sequencer:pick; do
   marker="${name%%:*}"
   path=$(private.ogit.git.run "$dir" rev-parse --git-path "$marker")
   case "$path" in /*) ;; *) path="$dir/$path" ;; esac
   if [ -e "$path" ]; then kind="${name##*:}"; break; fi
 done
 if [ -z "$kind" ]; then create.result 0 "none"; else create.result 1 "$kind"; fi
 return $(result)
}




ogit.remote.fetch.url()     # <url> <branch> <?dir:$OOSH_DIR> # fetch <branch> from <url> into FETCH_HEAD of <dir> without adding a remote or merging; RESULT = the fetched commit sha; rc from git #
{
 # <dir> completes through the shared ogit.parameter.completion.dir below the marker.
 private.ogit.require || return $(result)
 local url="$1"
 local branch="$2"
 local dir="${3:-${OOSH_DIR:-.}}"
 local rc sha
 if [ -z "$url" ] || [ -z "$branch" ]; then
   create.result 1 "ogit.remote.fetch.url requires <url> <branch>"
   error.log "$RESULT"
   return $(result)
 fi
 private.ogit.git.run "$dir" fetch "$url" "$branch" >/dev/null; rc=$?
 private.ogit.fetchhead.share "$dir"   # T-OGIT-FETCHHEAD-SHARED
 if [ "$rc" = 0 ]; then
   sha=$(private.ogit.git.run "$dir" rev-parse --verify -q FETCH_HEAD)
   if [ -n "$sha" ]; then create.result 0 "$sha"; else create.result 1 "fetched, but FETCH_HEAD unreadable in $dir$(private.ogit.git.reason.get)"; fi
 else
   create.result "$rc" "fetch of $branch from $url failed in $dir (rc=$rc)$(private.ogit.git.reason.get)"
 fi
 return $(result)
}


