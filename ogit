ogit.file.history.blobs.get()     # <path> <?count:200> <?dir:$OOSH_DIR> # echo the blob ids of <path> over the last <count> commits that changed it, one per line, one git call; nothing and rc 1 on a tree git refuses #
{
 # A getter: no create.result. One git log with --raw names the blob each
 # commit left at <path>; a deletion (all-zero id) is no blob and is skipped.
 local path="$1"
 local count="${2:-200}"
 local dir="${3:-${OOSH_DIR:-.}}"
 local out
 [ -n "$path" ] || return 1
 case "$count" in ''|*[!0-9]*) return 1 ;; esac
 out=$(git -C "$dir" log -n "$count" --format= --raw --no-abbrev --no-renames -- "$path" 2>/dev/null) || return 1
 printf '%s\n' "$out" | awk 'NF >= 5 && $4 !~ /^0+$/ { print $4 }'
 return 0
}


