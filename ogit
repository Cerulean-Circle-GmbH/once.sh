ogit.parameter.completion.base()       {
  # <base> has one real value: the components base. Empty word → that (not the
  # folders of wherever the user stands); a typed path → the base when it
  # matches, plus folder completion. private.ogit.base.get is a plain getter —
  # no create.result on a completion path.
  local base; base=$(private.ogit.base.get "" 2>/dev/null)
  if [ -z "$1" ]; then [ -n "$base" ] && printf '%s\n' "$base" || compgen -d "$1"; return 0; fi
  case "$base" in "$1"*) printf '%s\n' "$base" ;; esac
  compgen -d "$1"
}
