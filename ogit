ogit.bundle.heads.create()     # <out> <dir> <heads...> # write ONE bundle to <out> (- = stdout) whose refs/heads/<name> point at <ref> (a local branch, origin/<b> or a sha) of <dir>; rc 1 and the reason when a ref is unknown #
{
 # A per-branch clone has no local main, only origin/main; git bundle keeps ref
 # names and git clone -b main reads only refs/heads/*, so the heads are first
 # fetched under their new names into a private bare repository, which is then
 # bundled with --branches. Nothing but the bundle may reach stdout when <out> is -.
 private.ogit.require || return $(result)
 local out="$1"
 local dir="$2"
 shift 2 2>/dev/null || shift $#
 local pair tmp rc=0
 local -a specs=()
 if [ -z "$out" ] || [ -z "$dir" ] || [ $# -eq 0 ]; then
   create.result 1 "ogit.bundle.heads.create requires <out> <dir> <heads...>"
   error.log "$RESULT"
   return $(result)
 fi
 for pair in "$@"; do
   case "$pair" in
     ?*=?*) specs+=("${pair#*=}:refs/heads/${pair%%=*}") ;;
     *) create.result 1 "ogit.bundle.heads.create: $pair is no <name>=<ref>"; error.log "$RESULT"; return $(result) ;;
   esac
 done
 # An absolute <out>: the bundle is written from inside the temporary repository.
 case "$out" in -|/*) ;; *) out="$PWD/$out" ;; esac
 tmp=$(private.this.temp.dir.get ogit.heads) || { create.result 1 "ogit.bundle.heads.create: no temporary directory"; error.log "$RESULT"; return $(result); }
 ogit.repo.init "$tmp/heads.git" yes >/dev/null 2>&1 || rc=1
 if [ "$rc" = 0 ]; then private.ogit.git.run "$tmp/heads.git" fetch -q "$(private.this.path.canonical "$dir")" "${specs[@]}" >/dev/null || rc=1; fi
 if [ "$rc" = 0 ]; then private.ogit.git.run "$tmp/heads.git" bundle create -q "$out" --branches || rc=1; fi
 if [ "$rc" = 0 ]; then create.result 0 "bundle of $* written to $out"
 else create.result 1 "no bundle of $* from $dir$(private.ogit.git.reason.get)"; error.log "$RESULT"; fi
 # The temporary directory is ours: removed whole, best effort, after RESULT is set.
 rm -rf "$tmp" 2>/dev/null
 return $(result)
}


ogit.bundle.heads.create.completion.out() { echo -; compgen -f "$1"; }
