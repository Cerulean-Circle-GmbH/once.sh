ogit.diff.files.list()     # <?from:dev> <?to:HEAD> <?dir:$OOSH_DIR> <?only:changed> # echo the paths changed between from and to (merge-base to to), one per line, renames as the new path, deleted files left out (only=deleted lists just those); to=worktree compares the merge-base with the working tree and adds untracked files that are not ignored; nothing and rc 1 on a ref git does not know, rc 2 when git fails otherwise #
{
 local from="${1:-dev}" to="${2:-HEAD}" dir="${3:-${OOSH_DIR:-.}}" only="${4:-changed}"
 local filter=d
 case "$only" in
   changed) ;;
   deleted) filter=D ;;
   *) create.result 2 "only $only is not changed or deleted"; return $(result) ;;
 esac
 local ref
 for ref in "$from" "$to"; do
   [ "$ref" = worktree ] && continue
   git -C "$dir" rev-parse --verify --quiet "$ref^{commit}" >/dev/null 2>&1 \
     || { create.result 1 "$ref is not a commit git knows in $dir"; return $(result); }
 done
 local listing base
 if [ "$to" = worktree ]; then
   base=$(git -C "$dir" merge-base "$from" HEAD 2>/dev/null) \
     || { create.result 2 "no merge-base of $from and HEAD in $dir"; return $(result); }
   listing=$(git -C "$dir" diff -z --name-only --diff-filter=$filter "$base" -- 2>/dev/null | tr '\0' '\n'; \
             [ "$only" = changed ] && git -C "$dir" ls-files -z --others --exclude-standard 2>/dev/null | tr '\0' '\n'; true)
 else
   listing=$(git -C "$dir" diff -z --name-only --diff-filter=$filter "$from...$to" -- 2>/dev/null | tr '\0' '\n'; \
             [ "${PIPESTATUS[0]}" = 0 ] || echo "@@ogit-diff-failed@@")
   case "$listing" in *"@@ogit-diff-failed@@"*) create.result 2 "git diff $from...$to failed in $dir"; return $(result) ;; esac
 fi
 [ -n "$listing" ] && echo "$listing"
 create.result 0 "paths changed between $from and $to"
 return $(result)
}
