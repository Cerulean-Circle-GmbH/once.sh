private.ogit.worktree.upstream.ensure()     # <?base:$(oo mode.base.get)> # give every linked worktree of <base>/main that is on a branch, tracks nothing and whose branch origin has (refs/remotes/origin/<branch> in main) that upstream, so ogit worktree.remove can convert it; a branch origin lacks keeps none and its gate names it; RESULT names what was set; rc 1 when <base>/main is no repository #
{
 # The old install's worktrees tracked origin; one that lost its upstream (or
 # never had one) is refused by private.ogit.folder.gate ("tracks no
 # upstream"). oo heal calls this before ogit.worktree.remove (gate 3,
 # 2026-10-07). Only a branch origin HAS is tracked — a local-only branch keeps
 # none and stays for its owner to push. Commits ahead are the gate's to refuse.
 private.ogit.require || return $(result)
 local base wt mainPhys branch set="" failed=""
 base=$(private.ogit.base.get "$1")
 if [ ! -d "$base/main/.git" ]; then
   create.result 1 "private.ogit.worktree.upstream.ensure: no repository at $base/main"; error.log "$RESULT"; return $(result)
 fi
 mainPhys=$(private.this.path.canonical "$base/main")
 while IFS= read -r wt; do
   [ "$wt" = "$mainPhys" ] && continue
   branch=$(ogit.branch.get "$wt")
   [ -n "$branch" ] || continue
   ogit.branch.check '@{u}' "$wt" && continue
   ogit.branch.check "refs/remotes/origin/$branch" "$base/main" || continue
   if ogit.branch.upstream.set "origin/$branch" "$wt" >/dev/null; then
     set="$set ${wt##*/}"
   else
     failed="$failed; $RESULT"
   fi
 done < <(private.ogit.worktree.paths.get "$base/main")
 if [ -n "$failed" ]; then
   create.result 1 "upstream not set:${failed#;}"; error.log "$RESULT"
 elif [ -n "$set" ]; then
   create.result 0 "upstream origin/<branch> set for:$set"; info.log "$RESULT"
 else
   create.result 0 "every linked worktree under $base tracks its branch, or origin lacks it"
 fi
 return $(result)
}


