ogit.repo.init()     # <dir> <?bare:no> <?branch:main> # initialise a repository in <dir> (bare=yes for a bare one) with <branch> as its initial branch; git creates a missing parent; rc 1 with the reason from git when it cannot #
{
 private.ogit.require || return $(result)
 local dir="$1"
 local bare=""
 [ "$2" = yes ] && bare="--bare"
 local branch="${3:-main}"
 local rc
 if [ -z "$dir" ]; then
   create.result 1 "ogit.repo.init requires <dir>"
   error.log "$RESULT"
   return $(result)
 fi
 # The branch name is checked first: git init leaves an empty .git behind when
 # it rejects the name, and "no repository left behind" is the contract.
 if ! private.ogit.git.run . check-ref-format --branch "$branch" >/dev/null; then
   create.result 1 "could not initialise a repository in $dir: invalid branch name $branch$(private.ogit.git.reason.get)"
   return $(result)
 fi
 # Whether git knows -b is decided BEFORE init runs, so a real failure (bad
 # branch name, unwritable parent) never triggers the fallback or a second run.
 # git's usage text goes to stdout or stderr, by version: look at both.
 local usage
 usage=$(private.ogit.git.run . init -h; printf '%s' "$OGIT_GIT_ERROR")
 case "$usage" in
   *initial-branch*) private.ogit.git.run . init -q $bare -b "$branch" "$dir" >/dev/null; rc=$? ;;
   *)
     # a git older than 2.28: plain init, then name the initial branch through HEAD
     private.ogit.git.run . init -q $bare "$dir" >/dev/null; rc=$?
     [ "$rc" = 0 ] && { private.ogit.git.run "$dir" symbolic-ref HEAD "refs/heads/$branch"; rc=$?; }
     ;;
 esac
 if [ "$rc" = 0 ]; then create.result 0 "initialised $dir on $branch"
 else create.result 1 "could not initialise a repository in $dir$(private.ogit.git.reason.get)"; fi
 return $(result)
}


