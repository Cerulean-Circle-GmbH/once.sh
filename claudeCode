  private.claudeCode.resolve.projectDir "$uuid" 2>/dev/null
  "$CLAUDE_CMD" --resume "$uuid" --fork-session --model "claude-opus-4-6[1m]" "$@"
}
claudeCode.fork.byPane.completion.pane() {
