promote.stage() # <?reset> # promote dev branch to stage, gated by tests
{
  local arg1="$1"
  source state

  private.promote.config.load
  PROMOTE_TARGET=stage

  if [ "$arg1" = "reset" ]; then
    if state.machine.exists PROMOTE 2>/dev/null; then
      state.machine.delete PROMOTE 2>/dev/null
    fi
    private.init.promote.state.machine
    private.promote.config.save
  elif [ "$arg1" = "yes" ]; then
    PROMOTE_FORCE=yes
    private.promote.config.save
  else
    private.promote.config.save
  fi

  if ! state.machine.exists PROMOTE 2>/dev/null; then
    private.init.promote.state.machine
  fi

  state of PROMOTE
  source $CONFIG_PATH/current.state.machine.env

  # If finished or on prod path (state >= 21): reset to [11]
  if [ $state -ge 99 ] || [ $state -ge 21 ]; then
    state set - 11
    source $CONFIG_PATH/current.state.machine.env
  fi

  # Advancement loop
  local i=0
  while [ $state -lt 99 ] && [ $i -lt 30 ]; do
    local prevState=$state
    state next
    source $CONFIG_PATH/current.state.machine.env
    if [ $state -le $prevState ]; then
      error.log "State machine stuck at [$state]"
      break
    fi
    ((i++))
  done

  if [ $state -ge 99 ]; then
    success.log "Promotion to stage complete"
  fi
}

promote.prod() # <?reset> # promote stage branch to prod
{
  local arg1="$1"
  source state

  private.promote.config.load
  PROMOTE_TARGET=prod

  if [ "$arg1" = "reset" ]; then
    if state.machine.exists PROMOTE 2>/dev/null; then
      state.machine.delete PROMOTE 2>/dev/null
    fi
    private.init.promote.state.machine
    private.promote.config.save
  elif [ "$arg1" = "yes" ]; then
    PROMOTE_FORCE=yes
    private.promote.config.save
  else
    private.promote.config.save
  fi

  if ! state.machine.exists PROMOTE 2>/dev/null; then
    private.init.promote.state.machine
  fi

  state of PROMOTE
  source $CONFIG_PATH/current.state.machine.env

  # If finished or on stage path (13 <= state <= 19): reset to [11]
  if [ $state -ge 99 ] || { [ $state -ge 13 ] && [ $state -le 19 ]; }; then
    state set - 11
    source $CONFIG_PATH/current.state.machine.env
  fi

  # Advancement loop
  local i=0
  while [ $state -lt 99 ] && [ $i -lt 30 ]; do
    local prevState=$state
    state next
    source $CONFIG_PATH/current.state.machine.env
    if [ $state -le $prevState ]; then
      error.log "State machine stuck at [$state]"
      break
    fi
    ((i++))
  done

  if [ $state -ge 99 ]; then
    success.log "Promotion to prod complete"
  fi
}

promote.status() # # show PROMOTE pipeline state and branch diffs
{
  source state

  if state.machine.exists PROMOTE 2>/dev/null; then
    state of PROMOTE list all
  else
    important.log "No PROMOTE state machine exists yet"
    [ "${LOG_LEVEL:-3}" -lt 2 ] 2>/dev/null && echo "No active promotion"
  fi

  echo
  important.log "Branch Status"
  echo "============="

  local devHead stageHead prodHead
  devHead=$(git -C "$OOSH_DIR" log -1 --format='%h  %ci' dev 2>/dev/null || echo "not found")
  stageHead=$(git -C "$OOSH_DIR" log -1 --format='%h  %ci' stage 2>/dev/null || echo "not found")
  prodHead=$(git -C "$OOSH_DIR" log -1 --format='%h  %ci' prod 2>/dev/null || echo "not found")

  local devAheadOfStage stageAheadOfProd
  devAheadOfStage=$(git -C "$OOSH_DIR" rev-list --count stage..dev 2>/dev/null || echo "?")
  stageAheadOfProd=$(git -C "$OOSH_DIR" rev-list --count prod..stage 2>/dev/null || echo "?")

  echo "dev    $devHead"
  echo "stage  $stageHead  ($devAheadOfStage commits behind dev)"
  echo "prod   $prodHead  ($stageAheadOfProd commits behind stage)"
}

promote.report() # # show promotion history from git tags
{
  important.log "Stage promotions (stage-* tags):"
  git -C "$OOSH_DIR" tag -l 'stage-*' --sort=-creatordate --format='  %(creatordate:short)  %(refname:short)' 2>/dev/null || echo "  (none)"

  echo
  important.log "Prod releases (v* tags):"
  git -C "$OOSH_DIR" tag -l 'v*' --sort=-creatordate --format='  %(creatordate:short)  %(refname:short)' 2>/dev/null || echo "  (none)"
}

